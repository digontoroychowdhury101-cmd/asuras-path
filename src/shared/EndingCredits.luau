-- Made for the project, in the record's own words (each phrase appears in CREDITS.md).
Credits.Project = table.freeze({
	"Veiled Ascetic: base sculpt generated by the creator",
	"Wind, bronze bell, droplets, bass impulse and bowed-harmonic drone were synthesized for this project",
	"Custom ember, ribbon, blood, smoke, ash, flame, shockwave, seal masks and six seamless charcoal sky faces",
})

-- Short display lines, one per entry: "Work — By · License".
function Credits.lines(): { string }
	local out: { string } = {}
	for _, entry in Credits.ThirdParty do
		table.insert(out, entry.Work .. " — " .. entry.By .. " · " .. entry.License)
	end
	for _, line in Credits.Project do
		table.insert(out, line)
	end
	return out
end

return table.freeze(Credits)
