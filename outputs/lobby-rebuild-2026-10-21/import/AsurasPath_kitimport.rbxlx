						<ProtectedString name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/EndingCredits
-- Concise credits for the crossing (batch 22), transcribed from the project's own record,
-- assets/CREDITS.md. Every third-party row there appears here with its source and licence, and
-- nothing here is absent there (tools/test_progression_runtime.py compares the two). Work made for
-- the project is credited as the record words it; no names are added that the record lacks.
local Credits = {}

export type Entry = { Work: string, By: string, License: string, Source: string }

Credits.Title = "ASURA'S PATH"
Credits.Closing = "Thank you for walking the path."

Credits.ThirdParty = table.freeze({
	{ Work = "Gothic Statue · the Sanctuary colossus", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/gothic_statue" },
	{ Work = "Large Iron Gate · the Ascension Gateway", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/large_iron_gate" },
	{ Work = "Dead Tree Trunk 02 · the sacred tree", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/dead_tree_trunk_02" },
	{ Work = "Pine Roots", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/pine_roots" },
	{ Work = "Rock Face 03 texture", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/rock_face_03" },
	{ Work = "Bark Platanus texture", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/bark_platanus" },
	{ Work = "Leaf Set 024 texture", By = "ambientCG", License = "CC0", Source = "https://ambientcg.com/view?id=LeafSet024" },
	{ Work = "Stone 01", By = "Poly Haven", License = "CC0-1.0", Source = "https://polyhaven.com/a/stone_01" },
	{ Work = "Stone Fire Pit", By = "Poly Haven", License = "CC0-1.0", Source = "https://polyhaven.com/a/stone_fire_pit" },
	{ Work = "Brass Diya Lantern", By = "Poly Haven", License = "CC0-1.0", Source = "https://polyhaven.com/a/brass_diya_lantern" },
	{ Work = "Fantasy Ruins", By = "Ron Kapaun / 3TD Studios", License = "CC0-1.0", Source = "https://opengameart.org/content/3td-fantasy-ruins-pack" },
	{ Work = "Impact Sounds", By = "Kenney", License = "CC0-1.0", Source = "https://kenney.nl/assets/impact-sounds" },
	{ Work = "RPG Audio", By = "Kenney", License = "CC0-1.0", Source = "https://kenney.nl/assets/rpg-audio" },
} :: { Entry })

-- Made for the project, in the record's own words (each phrase appears in CREDITS.md).
Credits.Project = table.freeze({
	"Veiled Ascetic: base sculpt generated by the creator",
	"Wind, bronze bell, droplets, bass impulse and bowed-harmonic drone were synthesized for this project",
	"Custom ember, ribbon, blood, smoke, ash, flame, shockwave, seal masks and six seamless charcoal sky faces",
})

-- Short display lines, one per entry: "Work — By · License".
function Credits.lines(): { string }
	local out: { string } = {}
	for _, entry in Credits.ThirdParty do
		table.insert(out, entry.Work .. " — " .. entry.By .. " · " .. entry.License)
	end
	for _, line in Credits.Project do
		table.insert(out, line)
	end
	return out
end

return table.freeze(Credits)
]]></ProtectedString>
