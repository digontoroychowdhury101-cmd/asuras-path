local S=game.ServerScriptService.AsurasPath.Services local C=require(S.CharacterService) local A=require(S.AIService) local W=require(S.WorldService) local P=require(S.PersistenceService) local D=require(game.ReplicatedStorage.AsurasPath.Shared.WorldDefinitions) local G=require(game.ReplicatedStorage.AsurasPath.Shared.CampaignZones) local M=require(game.ReplicatedStorage.AsurasPath.Shared.MonasteryZones) local H=game.HttpService assert(game:GetService('RunService'):IsStudio() and P.IsMock,'Mock Studio only') assert(not game.ServerStorage:FindFirstChild('AsuraVisualAudit'),'Already installed') local p=game.Players:GetPlayers()[1] local e=C.GetEntity(p.UserId) local s=W.GetSession(p.UserId) assert(e and s and not s.Fight,'Neutral session required') local old={frame=e.Root.CFrame,inv=e.Fighter.InvulnerableUntil,bosses=table.clone(s.Bosses),seed=p:GetAttribute('AsuraVisualAuditSeeded')} local f=Instance.new('Folder') f.Name='AsuraVisualAudit' f.Parent=game.ServerStorage local cmd=Instance.new('StringValue') cmd.Name='Command' cmd.Parent=f local res=Instance.new('StringValue') res.Name='Result' res.Parent=f local function save(name,value) local text=H:JSONEncode(value) local g=Instance.new('Folder') g.Name=name g.Parent=f for i=1,#text,60000 do local v=Instance.new('StringValue') v.Name=string.format('%04d',math.ceil(i/60000)) v.Value=text:sub(i,i+59999) v.Parent=g end end local ls={} for _,l in G.Layouts do table.insert(ls,{region=l.Region,marks=l.Marks,zones=l.Zones,doors=l.Doors}) end local bs={} for id,b in D.Bosses do bs[id]={name=b.Name,region=b.Region,spawn=b.Spawn,arena=b.Arena} end save('World',{regions=D.Regions,altars=D.Altars,layouts=ls,monastery=M.List,bosses=bs,mock=P.IsMock}) local owned={} local function actors() local t={} for id,v in C.Entities() do table.insert(t,{id=id,kind=v.Kind,name=v.Model.Name,path=v.Model:GetFullName(),position={v.Root.Position.X,v.Root.Position.Y,v.Root.Position.Z},skin=v.Model:GetAttribute('AsuraSkinStatus'),look=v.Model:GetAttribute('AsuraLookKey')}) end return t end p:SetAttribute('AsuraVisualAuditSeeded',true) for id in D.Bosses do s.Bosses[id]=true end e.Fighter.InvulnerableUntil=math.huge cmd.Changed:Connect(function(text) local ok,r=pcall(function() local o=H:JSONDecode(text) if o.action=='teleport' then C.Teleport(p.UserId,CFrame.new(o.x,o.y,o.z)*CFrame.Angles(0,math.rad(o.yaw or 0),0)) elseif o.action=='boss' then local id=A.SpawnBoss(o.id,{}) assert(id,'No boss') A.Hold(o.id,math.huge) owned[o.id]=true return actors() elseif o.action=='actors' then return actors() elseif o.action=='removeBosses' then for id in owned do A.DespawnBoss(id) end table.clear(owned) elseif o.action=='restore' then for id in owned do A.DespawnBoss(id) end C.Teleport(p.UserId,old.frame) e.Fighter.InvulnerableUntil=old.inv table.clear(s.Bosses) for id,v in old.bosses do s.Bosses[id]=v end p:SetAttribute('AsuraVisualAuditSeeded',old.seed) f:SetAttribute('Restored',true) return {restored=true} else error('Unknown command') end return {position={e.Root.Position.X,e.Root.Position.Y,e.Root.Position.Z},state=e.Fighter.State} end) res.Value=H:JSONEncode({ok=ok,result=ok and r or tostring(r)}) end) f:SetAttribute('Ready',true) res.Value=H:JSONEncode({ready=true,mock=P.IsMock,bossesBypassed=true}) print('VISUAL AUDIT READY: runtime only; Stop restores the entire test')