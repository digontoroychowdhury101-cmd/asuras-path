					<Item class="ModuleScript" referent="957">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Stateless, frame-rate-independent movement tuning. Tested separately from Roblox physics.
local Settings = require(game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath"):WaitForChild("Shared"):WaitForChild("CombatSettings") :: ModuleScript).Movement
local Motion = {}

function Motion.flat(value: Vector3, fallback: Vector3): Vector3
	local flat = Vector3.new(value.X, 0, value.Z)
	return if flat.Magnitude > 0.001 then flat.Unit else fallback
end

function Motion.bullet(look: Vector3): Vector3
	return (look * 1.35 + Vector3.new(0, 0.75, 0)).Unit * Settings.BulletSpeed
end

function Motion.doubleJump(move: Vector3): Vector3
	return Vector3.new(0, Settings.DoubleJumpUp, 0) + move * Settings.DoubleJumpForward
end

function Motion.slide(direction: Vector3, speed: number, normal: Vector3, move: Vector3, gravity: number, dt: number): (Vector3, number, Vector3)
	local steered = direction:Lerp(Motion.flat(move, direction), 1 - math.exp(-3 * dt))
	direction = Motion.flat(steered, direction)
	local tangent = direction - normal * direction:Dot(normal)
	tangent = if tangent.Magnitude > 0.001 then tangent.Unit else direction
	local slope = Vector3.new(0, -gravity, 0):Dot(tangent)
	speed = math.clamp(speed + (slope - Settings.SlideFriction) * dt, 0, Settings.SlideMaxSpeed)
	return direction, speed, tangent * speed
end

function Motion.glide(velocity: Vector3, look: Vector3, dt: number): Vector3
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
	local direction = Motion.flat(look, Motion.flat(horizontal, Vector3.zAxis))
	local target = direction * math.max(horizontal.Magnitude, Settings.WalkSpeed)
	local steered = horizontal:Lerp(target, 1 - math.exp(-Settings.GlideSteering * dt))
	return Vector3.new(steered.X, math.max(velocity.Y, -Settings.GlideFallSpeed), steered.Z)
end

return Motion
]]></ProtectedString>
							<string name="ScriptGuid">{459680B7-19FE-4D83-86D3-74F21FAD0142}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">MovementMath</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">093f15255fc470bf0af8dc8800000537</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="958">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- The Supernova's three ink frames, back to back after the detonation: the black frame with a white
-- hatched dome over a two-lobed ink core, the inverted white frame with a hatched black blob and a
-- white radial burst, and the white frame torn by black ink streaks. Lines re-cut every frame like
-- smear animation. Caster only; reduced flashes shortens every beat.
local Kit = require(script.Parent.SkillKit)
local Manga = require(script.Parent.MangaFx)
local Ink = require(script.Parent.InkFrames)
local Nova = {}

local rgb = Color3.fromRGB
local WHITE, INK = Color3.new(1, 1, 1), rgb(6, 6, 8)

-- Black frame: a thick white dome of vertical ink hatching arching over a two-lobed black core that
-- sits on a hatched white ground line, white rain from the top edge, needle sparkles.
function Nova.dome(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	local back = Manga.box(gui, INK)
	back.Position, back.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	local hatch: { Frame } = {}
	for n = 1, 320 do hatch[n] = Manga.box(back, WHITE) end
	local inner: { Frame } = {}
	for n = 1, 70 do
		inner[n] = Manga.box(back, INK)
		inner[n].ZIndex = 4
	end
	local arch = Manga.blob(back, WHITE) -- solid white under the hatching: the dome reads as one bright mass
	arch.ZIndex = 1
	local lobes = { Manga.blob(back, INK), Manga.blob(back, INK) }
	for _, l in lobes do l.ZIndex = 3 end
	local ground = Manga.box(back, WHITE)
	ground.AnchorPoint, ground.ZIndex = Vector2.new(0.5, 0), 2
	for n, at in { Vector2.new(0.24, 0.24), Vector2.new(0.66, 0.16), Vector2.new(0.86, 0.42), Vector2.new(0.12, 0.6) } do
		Manga.sparkle(back, at * size, size.Y * (0.22 + 0.06 * n))
	end
	Manga.animate(trove, gui, seconds, function(t: number)
		local grow = 1 + t * 1.5
		local c = Vector2.new(size.X * 0.5, size.Y * 0.6)
		local rx, ry = size.X * 0.23 * grow, size.Y * 0.4 * grow
		arch.Position, arch.Size = UDim2.fromOffset(c.X, c.Y), UDim2.fromOffset(rx * 2.15, ry * 1.75)
		for i, l in lobes do
			l.Position = UDim2.fromOffset(c.X + (if i == 1 then -1 else 1) * rx * 0.36, c.Y + ry * 0.08)
			l.Size = UDim2.fromOffset(rx * 0.95, ry * 1.05)
		end
		ground.Position, ground.Size = UDim2.fromOffset(c.X, c.Y + ry * 0.5), UDim2.fromOffset(size.X, size.Y)
		for n, f in inner do -- the core's edge hatched up into the white, so the two read as one ink mass
			local i = if n % 2 == 0 then 1 else -1
			local a = math.pi + (math.random() * 0.9 + 0.05) * math.pi
			local len = size.Y * (0.03 + math.random() * 0.08)
			f.Position = UDim2.fromOffset(c.X + i * rx * 0.36 + math.cos(a) * rx * 0.47, c.Y + ry * 0.08 + math.sin(a) * ry * 0.52 - len * 0.4)
			f.Size = UDim2.fromOffset(1 + math.random() * 3, len)
		end
		for n, f in hatch do
			if n <= 240 then -- the arch's fuzzy rim: strokes poking out of it, longest at the crown
				local a = math.pi * 0.92 + n / 240 * math.pi * 1.16
				local crown = math.max(0, -math.sin(a))
				local len = size.Y * (0.05 + math.random() * 0.1 + crown * 0.1)
				f.Position = UDim2.fromOffset(c.X + math.cos(a) * rx * 1.06 + (math.random() - 0.5) * 12, c.Y + math.sin(a) * ry * 0.86 - len * 0.2)
				f.Size = UDim2.fromOffset(2 + math.random() * 5, len)
			elseif n <= 280 then -- rain from the top edge
				f.Position, f.Size = UDim2.fromOffset(math.random() * size.X, math.random() * size.Y * 0.25), UDim2.fromOffset(1 + math.random() * 2, size.Y * (0.08 + math.random() * 0.35))
			else -- hatching up from the ground line
				f.Position, f.Size = UDim2.fromOffset(math.random() * size.X, c.Y + ry * 0.5 - size.Y * 0.03), UDim2.fromOffset(1 + math.random() * 3, size.Y * (0.03 + math.random() * 0.09))
			end
		end
	end)
end

-- White frame torn by black vertical ink streaks (the column's first instant).
function Nova.streaks(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	local back = Manga.box(gui, WHITE)
	back.Position, back.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	-- Each tear is three stacked strokes of different widths and lengths: a ragged ink edge.
	local streaks: { Frame } = {}
	for n = 1, 96 do streaks[n] = Manga.box(back, if n % 7 == 0 then Color3.fromRGB(110, 110, 115) else INK) end
	Manga.animate(trove, gui, seconds, function()
		for n = 1, #streaks, 3 do
			local x = size.X * (0.5 + (math.random() - 0.5) * (if math.random() < 0.65 then 0.32 else 0.95))
			local y, width, tilt = size.Y * (0.25 + math.random() * 0.55), 4 + math.random() ^ 1.6 * 70, (math.random() - 0.5) * 14
			for k = 0, 2 do
				local f = streaks[n + k]
				f.Position = UDim2.fromOffset(x + (math.random() - 0.5) * width * 0.6, y + (math.random() - 0.5) * size.Y * 0.3)
				f.Size, f.Rotation = UDim2.fromOffset(width * (0.35 + math.random() * 0.65), size.Y * (0.2 + math.random() * 0.7)), tilt + (math.random() - 0.5) * 6
			end
		end
	end)
end

-- White frame: a black hatched blob on hatched ground with white rays bursting from its heart.
function Nova.burst(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	local back = Ink.full(gui, WHITE)
	local core = Manga.blob(back, INK)
	core.ZIndex = 2
	local fringe: { Frame } = {}
	for n = 1, 230 do
		fringe[n] = Manga.box(back, INK)
		fringe[n].ZIndex = 2
	end
	local rays: { Frame } = {}
	for n = 1, 44 do
		rays[n] = Manga.box(back, WHITE)
		rays[n].ZIndex = 4
	end
	for n = 1, 3 do Manga.sparkle(back, Vector2.new(size.X * (0.1 + 0.3 * n), size.Y * (0.1 + 0.12 * (n % 2))), size.Y * 0.4, rgb(70, 70, 75)) end
	Manga.animate(trove, gui, seconds, function()
		local c = Vector2.new(size.X * 0.5, size.Y * 0.5)
		local rx, ry = size.Y * 0.44, size.Y * 0.4 -- a round blob, not a pill
		core.Position, core.Size = UDim2.fromOffset(c.X, c.Y), UDim2.fromOffset(rx * 2, ry * 2)
		for n, f in fringe do
			if n <= 150 then -- hatched rim of the blob
				local a = n / 150 * math.pi * 2
				f.Position = UDim2.fromOffset(c.X + math.cos(a) * rx * 0.97 + (math.random() - 0.5) * 8, c.Y + math.sin(a) * ry * 0.97)
				f.Size = UDim2.fromOffset(2 + math.random() * 4, size.Y * (0.05 + math.random() * 0.14))
			else -- hatched ground band
				f.Position, f.Size = UDim2.fromOffset(math.random() * size.X, size.Y * 0.92), UDim2.fromOffset(2 + math.random() * 4, size.Y * (0.06 + math.random() * 0.16))
			end
		end
		local hub = c + Vector2.new(size.X * 0.03, size.Y * 0.16)
		for n, f in rays do
			Ink.stroke(f, hub, n / #rays * math.pi * 2 + (math.random() - 0.5) * 0.25, size.Y * (0.1 + math.random() * 0.36), 1 + math.random() * 4)
		end
	end)
end

return table.freeze(Nova)
]]></ProtectedString>
							<string name="ScriptGuid">{F08C49BC-651D-4203-9C88-051C6DC184DE}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">NovaInk</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">093f15255fc470bf0af8dc8800000538</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="959">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Celestial Supernova scenery around the planet: a vortex of translucent teal smoke ribbons whipping
-- round the caster, floating black rocks and glowing cubes, gold sparkles, the hollow gold stars by
-- the planet and the gold flame crescents that tear across it before the detonation.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Kit = require(script.Parent.SkillKit)
local Bb = require(script.Parent.BillboardFx)
local Shapes = require(script.Parent.BillboardShapes)
local Planet = require(script.Parent.PlanetForms)
local Scenery = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)

-- Curved smoke ribbons orbiting `center()`; returns a setter for their radius (to widen the storm).
function Scenery.vortex(trove: Kit.Trove, folder: Instance, center: () -> Vector3, count: number): (number) -> ()
	local hub = Kit.part(folder, "VortexHub", WHITE, Vector3.one * 0.1, CFrame.new(center()))
	hub.Transparency = 1
	local radius = 6
	local ribbons = {}
	for n = 1, count do
		local a0, a1 = Kit.attach(trove, hub, Vector3.zero, "RibbonA"), Kit.attach(trove, hub, Vector3.zero, "RibbonB")
		local beam = Instance.new("Beam")
		beam.Attachment0, beam.Attachment1, beam.Segments, beam.FaceCamera = a0, a1, 24, true
		beam.Texture, beam.TextureSpeed, beam.TextureLength = Assets.Textures.Smoke, 0.6, 6
		beam.Color = ColorSequence.new(if n % 3 == 0 then rgb(200, 255, 255) else rgb(70, 205, 215))
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(0.7, 0.5), NumberSequenceKeypoint.new(1, 1) })
		beam.LightEmission, beam.LightInfluence, beam.Width0, beam.Width1 = 1, 0, 3 + math.random() * 4, 4 + math.random() * 6
		beam.Parent = hub
		ribbons[n] = { A = a0, B = a1, Beam = beam, Phase = math.random() * 6, Tilt = (math.random() - 0.5) * 1.6, Speed = 1.6 + math.random() * 1.8 }
	end
	-- A soft teal cloud boiling round the caster under the ribbons.
	Kit.emitter(hub, { Texture = Assets.Textures.Smoke, Color = ColorSequence.new(rgb(90, 220, 230), rgb(20, 90, 110)), Size = NumberSequence.new(5, 12),
		Rate = 7, Lifetime = NumberRange.new(2, 3), Speed = NumberRange.new(1, 3), Spread = 180, Light = 0.4, Spin = NumberRange.new(-40, 40),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.75), NumberSequenceKeypoint.new(1, 1) }) })
	local clock = 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		hub.Position = center()
		for _, r in ribbons do
			local a = r.Phase + clock * r.Speed
			local rr = radius * (0.7 + 0.3 * math.sin(clock + r.Phase))
			local function at(off: number): Vector3
				local yaw = a + off
				return Vector3.new(math.cos(yaw) * rr, math.sin(yaw * 0.5 + r.Tilt) * rr * 0.35 + r.Tilt * 2, math.sin(yaw) * rr)
			end
			r.A.Position, r.B.Position = at(0), at(1.9)
			r.Beam.CurveSize0, r.Beam.CurveSize1 = rr * 0.9, -rr * 0.9
		end
	end))
	return function(r: number) radius = r end
end

-- Dark rocks (and a few glowing cubes) hanging in the void around `center`, tumbling slowly.
function Scenery.rocks(trove: Kit.Trove, folder: Instance, center: Vector3, count: number, spread: number)
	local parts: { BasePart } = {}
	local spins: { CFrame } = {}
	for n = 1, count do
		local cube = n % 5 == 0
		local size = if cube then Vector3.one * (0.5 + math.random() * 0.6) else Vector3.new(1 + math.random() * 2.5, 0.8 + math.random() * 2, 1 + math.random() * 2)
		local offset = Vector3.new(math.random() - 0.5, (math.random() - 0.5) * 0.6, math.random() - 0.5) * spread
		local p = Kit.part(folder, if cube then "GlowCube" else "VoidRock", if cube then Planet.Cyan else rgb(14, 18, 22), size, CFrame.new(center + offset))
		p.Material = if cube then Enum.Material.Neon else Enum.Material.Slate
		parts[n], spins[n] = p, CFrame.Angles(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
	end
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		local frames: { CFrame } = {}
		for n, p in parts do frames[n] = p.CFrame * spins[n]:Lerp(CFrame.identity, 1 - dt) + Vector3.new(0, dt * 0.6, 0) end
		Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end))
end

-- `count` gold sparkles twinkling in one by one around `at`.
function Scenery.sparkles(trove: Kit.Trove, folder: Instance, at: Vector3, count: number, spread: number, size: number, life: number)
	for n = 1, count do
		Kit.after(trove, (n - 1) * 0.12, function()
			local p = Bb.anchor(folder, at + Vector3.new(math.random() - 0.5, math.random() - 0.3, math.random() - 0.5) * spread)
			Bb.sparkle(trove, p, Planet.Gold, size * (0.6 + math.random() * 0.8), life, (math.random() - 0.5) * 20)
		end)
	end
end

-- Hollow gold stars hanging off the planet's upper shoulder on this viewer's screen.
function Scenery.stars(trove: Kit.Trove, folder: Instance, at: Vector3, radius: number, seconds: number)
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local right, up = camera.CFrame.RightVector, camera.CFrame.UpVector
	for n, spot in { { -1.15, 0.7, 0.62 }, { -0.6, 1.15, 0.48 }, { 0.15, 1.3, 0.34 } } do
		Kit.after(trove, (n - 1) * 0.12, function()
			local hold = Bb.anchor(folder, at + right * radius * spot[1] + up * radius * spot[2])
			Shapes.star(trove, hold, rgb(215, 160, 70), radius * spot[3], seconds)
		end)
	end
end

-- Gold flame crescents on this viewer's side of the planet, so they tear across its face; returns
-- their anchors so the detonation can burn them out.
function Scenery.crescents(trove: Kit.Trove, folder: Instance, at: Vector3, radius: number): { BasePart }
	local camera = Workspace.CurrentCamera
	local toward = if camera then (camera.CFrame.Position - at).Unit else Vector3.zAxis
	local anchors: { BasePart } = {}
	for n = 1, 6 do
		local p = Bb.anchor(folder, at + toward * radius * 1.25 + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * radius * 1.3)
		table.insert(anchors, p)
		Bb.arc(trove, p, Planet.Gold, radius * (1.3 + math.random() * 0.9), 0.3 + math.random() * 0.2, (if n % 2 == 0 then 1 else -1) * (160 + math.random() * 120), 2.4)
	end
	return anchors
end

return table.freeze(Scenery)
]]></ProtectedString>
							<string name="ScriptGuid">{1F0CE406-0722-4797-B32E-D93488DBBF88}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">NovaScenery</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">093f15255fc470bf0af8dc8800000539</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="960">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ObjectiveController
-- HUD objective tracker: a top-right "next step" card plus a WaypointMarker, both derived from
-- replicated player attributes via the pure Shared.Objectives resolver.
-- Presentation only — it never sends intents.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Objectives = require(ReplicatedStorage:WaitForChild("AsurasPath"):WaitForChild("Shared"):WaitForChild("Objectives") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local WaypointMarker = require(script.Parent:WaitForChild("WaypointMarker") :: ModuleScript)
local Visibility = require(script.Parent:WaitForChild("HudVisibility") :: ModuleScript)
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local RouteGuide = require(ReplicatedStorage.AsurasPath.Shared.RouteGuide)

local P = HudKit.Palette
local REFRESH = 0.2

local Controller = {}
Controller.__index = Controller

export type ObjectiveController = typeof(setmetatable({} :: {
	Player: Player,
	Ui: any,
	Panel: Frame,
	Header: TextLabel,
	Title: TextLabel,
	Detail: TextLabel,
	Distance: TextLabel,
	Marker: WaypointMarker.WaypointMarker,
	Current: Objectives.Objective?,
	Rested: boolean,
	BossFelled: boolean,
	PendingRegion: string?,
	Elapsed: number,
	Cleanup: { () -> () },
}, Controller))

function Controller.new(state: WorldState.WorldState, ui: any): ObjectiveController
	local player = Players.LocalPlayer
	local panel = HudKit.panel(ui.Gui, "ObjectiveTracker", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 64), Size = UDim2.fromOffset(360, 92), Visible = false })
	HudKit.make("UIPadding", panel, { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 8) })
	local header = HudKit.label(panel, "OBJECTIVE", 14, HudKit.TitleFont, P.Ember, { Size = UDim2.new(1, -60, 0, 18), TextXAlignment = Enum.TextXAlignment.Left })
	local distance = HudKit.label(panel, "", 14, Enum.Font.GothamMedium, P.Muted, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(60, 18), TextXAlignment = Enum.TextXAlignment.Right })
	local title = HudKit.label(panel, "", 22, HudKit.TitleFont, P.Ivory, { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = true })
	HudKit.make("UITextSizeConstraint", title, { MaxTextSize = 22, MinTextSize = 12 })
	local detail = HudKit.label(panel, "", 16, HudKit.BodyFont, P.Muted, { Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true })

	local self = setmetatable({
		Player = player, Ui = ui, Panel = panel, Header = header, Title = title, Detail = detail, Distance = distance,
		Marker = WaypointMarker.new(ui.Gui), Current = nil, Rested = false, BossFelled = false, PendingRegion = nil,
		Elapsed = REFRESH, Cleanup = {},
	}, Controller)
	table.insert(self.Cleanup, HudKit.bindScale(panel, 0.8))
	local regionConnection = player:GetAttributeChangedSignal("AsuraRegion"):Connect(function()
		self.PendingRegion = nil
	end)
	table.insert(self.Cleanup, function()
		regionConnection:Disconnect()
	end)
	table.insert(self.Cleanup, state:OnCue(function(cue: WorldState.Cue)
		-- Resting, or leaving the Sanctuary, ends the first-rest step.
		if cue.Source == state.LocalId and (cue.Kind == "AltarRest" or cue.Kind == "PortalTransit" or cue.Kind == "AltarTravel") then
			self.Rested = true
			-- AsuraRegion lags a teleport; trust the cue's destination until it catches up.
			local destination = Objectives.regionOf(tostring(cue.Data.to or ""))
			if cue.Kind ~= "AltarRest" and destination then
				self.PendingRegion = destination
			end
		elseif cue.Kind == "BossDefeated" and cue.Data.boss == "GrandmasterShen" then
			self.BossFelled = true
		end
		self.Elapsed = REFRESH
	end))
	return self
end

function Controller.Facts(self: ObjectiveController): Objectives.Facts
	local player = self.Player
	local region = player:GetAttribute("AsuraRegion")
	local stain = player:GetAttribute("AsuraBloodstain")
	local bosses = Objectives.parseAltars(player:GetAttribute("AsuraBosses"))
	return {
		Bosses = bosses,
		Region = self.PendingRegion or (if type(region) == "string" then region else nil),
		Altars = Objectives.parseAltars(player:GetAttribute("AsuraAltars")),
		Bloodstain = if typeof(stain) == "Vector3" then stain else nil,
		StainRegion = if typeof(stain) == "Vector3" then RouteGuide.regionOf(stain) else nil,
		InBoss = self.Ui.BossEntity ~= nil,
		InColosseum = type(player:GetAttribute("AsuraColosseum")) == "string",
		BossFelled = self.BossFelled or bosses.GrandmasterShen == true,
		Rested = self.Rested,
		Story = Objectives.parseAltars(player:GetAttribute("AsuraStory")),
	}
end

function Controller.Show(self: ObjectiveController, objective: Objectives.Objective?)
	local previous = self.Current
	self.Current = objective
	self.Panel.Visible = objective ~= nil
	if not objective then
		return
	end
	self.Title.Text = objective.Title
	self.Detail.Text = objective.Detail
	if previous and previous.Key ~= objective.Key then
		self.Header.Text = "NEW OBJECTIVE"
		self.Panel.BackgroundTransparency = 0
		TweenService:Create(self.Panel, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { BackgroundTransparency = 0.25 }):Play()
		HudKit.cue(HudKit.Sounds.Objective, 0.5, 1.2)
		task.delay(3, function()
			if self.Current == objective then
				self.Header.Text = "OBJECTIVE"
			end
		end)
	end
end

function Controller.Update(self: ObjectiveController, dt: number)
	local guidance = Visibility.of(self.Ui).Guidance
	self.Panel.Visible = self.Current ~= nil and guidance
	self.Elapsed += dt
	if self.Elapsed < REFRESH then
		return
	end
	self.Elapsed = 0
	local objective = Objectives.resolve(self:Facts())
	if Objectives.changed(self.Current, objective) then
		self:Show(objective)
	end
	local character = self.Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local goal = if objective then self.Marker:Locate(objective.Target) else nil
	-- Staged route (#28): the next doorway or portal on the walked route, with the walked distance.
	local stage = if goal and root then RouteGuide.next(root.Position, goal) else nil
	if stage then goal = if stage.Kind == "Portal" then self.Marker:Locate({ Kind = "Portal" }) else stage.Position end
	-- The minimap draws the same walked route (follow-up 14); the northern gate is the placed portal.
	local route: any = nil
	if stage and guidance then
		local points = stage.Route.Points
		if stage.Route.Exit == "Northern gate" then points = if goal then { goal } else {} end
		route = { Points = points, Names = stage.Route.Names, Exit = stage.Route.Exit, Stain = objective ~= nil and objective.Key == "Bloodstain" }
	end
	self.Ui.Route = route
	local meters = self.Marker:Point(goal, if root then root.Position else nil, not guidance, stage and stage.Label, stage and stage.Remaining)
	self.Distance.Text = if meters then string.format("%dm", meters) else ""
end

function Controller.Destroy(self: ObjectiveController)
	for _, cleanup in self.Cleanup do
		cleanup()
	end
	self.Marker:Destroy()
	self.Panel:Destroy()
end

return Controller
]]></ProtectedString>
							<string name="ScriptGuid">{9083787A-6E1C-4E9A-87B0-BFDC7280B59B}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">ObjectiveController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">093f15255fc470bf0af8dc880000053a</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="961">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/PauseMenu
-- Respite menu (P, or the ≡ blossom button beside the minimap): Resume, Settings (field of view and
-- camera sensitivity steppers, comfort/readability toggles, previewed live, saved through ShopIntent
-- SaveSettings), Controls and the Codex. Pages scroll so phones never clip an entry (batch 25).
-- The world keeps running (online Souls), so opening only releases held inputs; it never pauses.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local InputMap = require(Shared:WaitForChild("Shared"):WaitForChild("InputMap") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)
local UiWindow = require(script.Parent:WaitForChild("UiWindow") :: ModuleScript)
local Comfort = require(script.Parent:WaitForChild("ComfortSettings") :: ModuleScript)
local Effects = require(Shared:WaitForChild("Shared"):WaitForChild("EffectsPreference") :: ModuleScript) :: any

local Menu = {}
Menu.__index = Menu
local T = UiKit.Theme
local C = Config.Camera

-- Customization ------------------------------------------------------------------------------
local WINDOW_SIZE = Vector2.new(460, 470)
local TOGGLE_KEYS: { Enum.KeyCode } = {}
for _, name in (InputMap.get("Pause") :: any).Keys do
	table.insert(TOGGLE_KEYS, (Enum.KeyCode :: any)[name])
end
local BACK_KEYS = { Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace } -- only bound while open
local FOOTNOTE = "The world does not wait. Foes still hunt while you linger here."

export type Saved = { fov: number, sensitivity: number, leftHanded: boolean, comfort: any }
export type PauseMenu = typeof(setmetatable({} :: {
	Window: UiWindow.Window, Camera: any, Input: any, Ui: any, Remote: RemoteEvent, Controls: any,
	Arsenal: GuiObject, Pages: { [string]: Frame }, First: { [string]: TextButton }, Saved: Saved,
	Refresh: () -> (), Bin: UiKit.Bin,
}, Menu))

local function page(self: any, name: string): Frame
	local frame = HudKit.make("ScrollingFrame", self.Window.Body, { Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false,
		BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = T.Edge, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y }) :: Frame
	HudKit.make("UIListLayout", frame, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	self.Pages[name] = frame
	return frame
end

-- [label .......... (−) value (+)] ; `step` returns the new display text.
local function stepper(parent: Frame, order: number, text: string, step: (direction: number) -> string): () -> ()
	local row = HudKit.make("Frame", parent, { Name = text, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1 }) :: Frame
	HudKit.label(row, text, 19, T.BodyFont, T.Ivory, { Size = UDim2.new(1, -170, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
	local value = HudKit.label(row, "", 20, Enum.Font.GothamMedium, T.Gold, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0), Size = UDim2.fromOffset(66, 30) })
	for _, direction in { -1, 1 } do
		local b = UiKit.button(row, if direction < 0 then "−" else "+", "Secondary", function()
			value.Text = step(direction)
		end)
		b.AnchorPoint, b.Size, b.TextSize = Vector2.new(1, 0.5), UDim2.fromOffset(44, 44), 24
		b.Position = UDim2.new(1, if direction < 0 then -122 else 0, 0.5, 0)
	end
	return function() value.Text = step(0) end
end

function Menu.new(camera: any, input: any, ui: any, remote: RemoteEvent, controls: any, arsenal: GuiObject): PauseMenu
	local self: any = setmetatable({ Camera = camera, Input = input, Ui = ui, Remote = remote, Controls = controls, Arsenal = arsenal, Pages = {}, First = {}, Bin = {},
		Saved = { fov = camera.Fov, sensitivity = camera.Sensitivity, leftHanded = false, comfort = Effects.get() } }, Menu)
	self.Window = UiWindow.new(ui.Gui, "RespiteMenu", "Respite", "A breath between battles", WINDOW_SIZE, function() self:Close() end)

	local main = page(self, "Main")
	local entries: { { Text: string, Variant: UiKit.Variant, Fn: () -> () } } = {
		{ Text = "Resume", Variant = "Primary", Fn = function() self:Close() end },
		{ Text = "Settings", Variant = "Secondary", Fn = function() self:Show("Settings") end },
		{ Text = "Controls", Variant = "Secondary", Fn = function() self:Close(); controls:SetOpen(true) end },
		{ Text = "Codex", Variant = "Secondary", Fn = function() self:Close(); if ui.OpenCodex then ui.OpenCodex() end end },
		{ Text = "Replay training", Variant = "Secondary", Fn = function() self:Close(); if ui.OnTraining then ui.OnTraining("Replay") end end },
		{ Text = "Replay opening", Variant = "Secondary", Fn = function() self:Close(); if ui.OnPrologue then ui.OnPrologue() end end },
	}
	for order, entry in entries do
		local b = UiKit.button(main, entry.Text, entry.Variant, entry.Fn)
		b.LayoutOrder, b.Size = order, UDim2.new(1, 0, 0, 50)
		self.First.Main = self.First.Main or b
	end
	HudKit.label(main, FOOTNOTE, 15, T.BodyFont, T.Muted, { LayoutOrder = 9, Size = UDim2.new(1, 0, 0, 44), TextWrapped = true })

	local settings = page(self, "Settings")
	local fov = stepper(settings, 1, "Field of view", function(d: number)
		camera.Fov = math.clamp(camera.Fov + d * C.FOVStep, C.MinFOV, C.MaxFOV)
		return string.format("%d°", math.floor(camera.Fov + 0.5))
	end)
	local sens = stepper(settings, 2, "Camera sensitivity", function(d: number)
		camera.Sensitivity = math.clamp(camera.Sensitivity + d * C.SensitivityStep, C.SensitivityMin, C.SensitivityMax)
		return string.format("%.2f×", camera.Sensitivity)
	end)
	local comfort = Comfort.build(settings, 3)
	self.Refresh = function() fov(); sens(); comfort() end
	local apply = UiKit.button(settings, "Apply", "Primary", function()
		remote:FireServer({ action = "SaveSettings", settings = { fov = camera.Fov, sensitivity = camera.Sensitivity, leftHanded = self.Saved.leftHanded, comfort = Effects.get() } })
	end)
	apply.LayoutOrder, apply.Size = 8, UDim2.new(1, 0, 0, 48)
	self.First.Settings = apply
	local back = UiKit.button(settings, "Back", "Secondary", function() self:Revert(); self:Show("Main") end)
	back.LayoutOrder, back.Size = 9, UDim2.new(1, 0, 0, 44)

	-- Profile syncs and save results arrive on ShopIntent; the bootstrap applies them to the camera.
	table.insert(self.Bin, remote.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then return end
		local s = type(payload.profile) == "table" and payload.profile.settings
		if type(s) == "table" and type(s.fov) == "number" and type(s.sensitivity) == "number" then
			self.Saved = { fov = s.fov, sensitivity = s.sensitivity, leftHanded = s.leftHanded == true, comfort = Effects.sanitize(s.comfort) }
		end
		if payload.action == "SettingsResult" then
			if payload.ok then UiKit.play("Click"); ui:ShowToast("Settings inscribed.") else UiKit.play("Error"); ui:ShowToast(tostring(payload.err or "The settings would not hold.")) end
			self.Refresh()
		end
	end))
	table.insert(self.Bin, arsenal:GetPropertyChangedSignal("Visible"):Connect(function()
		if arsenal.Visible then self:Close() end
	end))
	ContextActionService:BindAction("AsuraRespite", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then self:Toggle() end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(TOGGLE_KEYS))
	return self
end

function Menu.Blocked(self: PauseMenu): boolean
	local ui = self.Ui
	-- One window at a time: Respite opened over Lin or the Codex stacked two translucent panels (F03).
	return ui.DeathShown or ui.PrologueActive == true or ui.EndingActive == true or ui.DialogueOpen == true or ui.Altar.Visible or self.Arsenal.Visible
end

function Menu.Show(self: PauseMenu, name: string)
	for key, frame in self.Pages do frame.Visible = key == name end
	self.Refresh()
	if UserInputService.GamepadEnabled then GuiService.SelectedObject = self.First[name] end
end

function Menu.Revert(self: PauseMenu)
	self.Camera.Fov, self.Camera.Sensitivity = self.Saved.fov, self.Saved.sensitivity
	Effects.set(self.Saved.comfort)
end

function Menu.Toggle(self: PauseMenu)
	if UiWindow.isOpen(self.Window) then self:Close() elseif not self:Blocked() then self:Open() end
end

function Menu.Open(self: PauseMenu)
	self.Input:SetMenu(true, "Pause")
	UiWindow.open(self.Window)
	self:Show("Main")
	ContextActionService:BindActionAtPriority("AsuraRespiteBack", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			if self.Pages.Settings.Visible then self:Revert(); self:Show("Main") else self:Close() end
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 2, table.unpack(BACK_KEYS))
end

function Menu.Close(self: PauseMenu)
	if not UiWindow.isOpen(self.Window) then return end
	ContextActionService:UnbindAction("AsuraRespiteBack")
	self:Revert()
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(self.Window.Root) then GuiService.SelectedObject = nil end
	UiWindow.close(self.Window, function()
		self.Input:SetMenu(false, "Pause")
	end)
end

function Menu.Destroy(self: PauseMenu)
	ContextActionService:UnbindAction("AsuraRespite")
	ContextActionService:UnbindAction("AsuraRespiteBack")
	UiKit.clean(self.Bin)
	self.Window.Root:Destroy()
end

return Menu
]]></ProtectedString>
							<string name="ScriptGuid">{5D4F3009-53C8-49C1-ABEA-1C60765BCB5E}</string>
