		GloveColor = { 45, 45, 45 }, ShortsColor = { 55, 55, 55 },
		StrideRate = 7, LegSwing = 0.28, GuardShoulder = 0.85, GuardElbow = 1.5, LowGuardShoulder = 0.2, LowGuardElbow = 1.2,
		HeadSize = { 0.9, 1.0, 0.9 }, UpperTorsoSize = { 1.6, 1.25, 0.75 },
