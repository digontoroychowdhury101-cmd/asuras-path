local sources=game:GetService("HttpService"):JSONDecode("{\"SanguineRuntime\": \"--!strict\\n-- Bounded client-only rendering for the user's VFX place. No world, actor or camera ownership.\\nlocal Tween = game:GetService(\\\"TweenService\\\")\\nlocal Shared = game:GetService(\\\"ReplicatedStorage\\\").AsurasPath.Shared\\nlocal Assets = require(Shared.PresentationAssets) :: any\\nlocal Comfort = require(Shared.EffectsPreference) :: any\\nlocal Runtime = {}\\nRuntime.__index = Runtime\\nRuntime.Limits = table.freeze({ Groups = 8, Parts = 192, PartsPerGroup = 32, ParticlesPerSecond = 120 })\\nfunction Runtime.new(parent: Instance): any\\n\\tlocal folder = Instance.new(\\\"Folder\\\")\\n\\tfolder.Name, folder.Archivable, folder.Parent = \\\"AsuraSanguineVFX\\\", false, parent\\n\\treturn setmetatable({ Folder = folder, Groups = {}, Parts = 0, Tokens = 60, Alive = true }, Runtime)\\nend\\nfunction Runtime.Drop(self: any, group: Folder)\\n\\tlocal record = self.Groups[group]\\n\\tif not record then return end\\n\\tself.Groups[group] = nil\\n\\tself.Parts -= record.Parts\\n\\tgroup:Destroy()\\nend\\nfunction Runtime.Group(self: any, name: string, lifetime: number): Folder?\\n\\tif not self.Alive then return nil end\\n\\tlocal count = 0\\n\\tfor _ in self.Groups do count += 1 end\\n\\tif count >= (if Comfort.reduced() then 4 else Runtime.Limits.Groups) then return nil end\\n\\tlocal group = Instance.new(\\\"Folder\\\")\\n\\tgroup.Name, group.Archivable, group.Parent = name, false, self.Folder\\n\\tself.Groups[group] = { Parts = 0, Until = os.clock() + math.clamp(lifetime, 0.1, 2.5), Emitters = 0 }\\n\\treturn group\\nend\\nfunction Runtime.Part(self: any, group: Folder, name: string, size: Vector3, cf: CFrame, color: Color3, alpha: number?): Part?\\n\\tlocal record = self.Groups[group]\\n\\tif not record or not group.Parent or self.Parts >= Runtime.Limits.Parts then return nil end\\n\\tif record.Parts >= (if Comfort.reduced() then 12 else Runtime.Limits.PartsPerGroup) then return nil end\\n\\tlocal p = Instance.new(\\\"Part\\\")\\n\\tp.Name, p.Size, p.CFrame, p.Color = name, size, cf, color\\n\\tp.Anchored, p.Massless, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, true, false, false, false, false\\n\\tp.Archivable, p.Material = false, Enum.Material.Neon\\n\\tp.Transparency = 1 - Comfort.flash(1 - (alpha or 0.35))\\n\\tp.Parent = group\\n\\trecord.Parts += 1; self.Parts += 1\\n\\treturn p\\nend\\nfunction Runtime.Tween(_self: any, item: Instance?, duration: number, goal: any)\\n\\tif item and item.Parent then Tween:Create(item, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play() end\\nend\\nfunction Runtime.Emit(self: any, group: Folder, position: Vector3, color: Color3, count: number)\\n\\tlocal record = self.Groups[group]\\n\\tif not record or record.Emitters >= 2 then return end\\n\\tlocal amount = math.min(math.floor(self.Tokens), math.floor(count * (if Comfort.reduced() then 0.25 else 0.6)), 24)\\n\\tif amount < 1 or Assets.Textures.Ember == \\\"\\\" then return end\\n\\tlocal anchor = self:Part(group, \\\"SanguineBurstAnchor\\\", Vector3.one * 0.1, CFrame.new(position), color, 1)\\n\\tif not anchor then return end\\n\\tlocal e = Instance.new(\\\"ParticleEmitter\\\")\\n\\te.Texture, e.Enabled, e.Rate = Assets.Textures.Ember, false, 0\\n\\te.Color, e.Lifetime, e.Speed = ColorSequence.new(color), NumberRange.new(0.1, 0.35), NumberRange.new(4, 16)\\n\\te.SpreadAngle, e.Acceleration, e.Drag = Vector2.new(150, 150), Vector3.new(0, -10, 0), 2\\n\\te.Size, e.Transparency = NumberSequence.new(0.22, 0), NumberSequence.new(0.25, 1)\\n\\te.LightEmission, e.LightInfluence, e.Parent = Comfort.flash(0.6), 0, anchor\\n\\trecord.Emitters += 1; self.Tokens -= amount\\n\\te:Emit(amount)\\nend\\nfunction Runtime.Update(self: any, dt: number)\\n\\tself.Tokens = math.min(60, self.Tokens + math.clamp(dt, 0, 0.1) * Runtime.Limits.ParticlesPerSecond)\\n\\tlocal now = os.clock()\\n\\tfor group, record in self.Groups do\\n\\t\\tif not group.Parent or now >= record.Until then self:Drop(group) end\\n\\tend\\nend\\nfunction Runtime.Clear(self: any)\\n\\tfor group in self.Groups do self:Drop(group) end\\nend\\nfunction Runtime.Stats(self: any): any\\n\\tlocal groups = 0\\n\\tfor _ in self.Groups do groups += 1 end\\n\\treturn { Groups = groups, Parts = self.Parts, Tokens = self.Tokens }\\nend\\nfunction Runtime.Destroy(self: any)\\n\\tif not self.Alive then return end\\n\\tself.Alive = false; self:Clear(); self.Folder:Destroy()\\nend\\nreturn Runtime\\n\", \"SanguineGeometry\": \"--!strict\\n-- Adapted from SanguineVFX_Overhaul's ring, pulse and branching energy shapes.\\nlocal Geometry = {}\\nlocal rng = Random.new()\\nfunction Geometry.line(ctx: any, group: Folder, a: Vector3, b: Vector3, width: number, color: Color3, duration: number)\\n\\tlocal delta = b - a\\n\\tif delta.Magnitude < 0.03 then return end\\n\\tlocal p = ctx:Part(group, \\\"SanguineEnergyLine\\\", Vector3.new(width, width, delta.Magnitude), CFrame.lookAt((a + b) / 2, b), color)\\n\\tctx:Tween(p, duration, { Transparency = 1, Size = Vector3.new(0.01, 0.01, delta.Magnitude) })\\nend\\nfunction Geometry.pulse(ctx: any, group: Folder, position: Vector3, radius: number, color: Color3, duration: number)\\n\\tlocal p = ctx:Part(group, \\\"SanguinePulse\\\", Vector3.one * 0.25, CFrame.new(position), color, 0.8)\\n\\tif p then p.Shape = Enum.PartType.Ball end\\n\\tctx:Tween(p, duration, { Transparency = 1, Size = Vector3.one * math.clamp(radius * 2, 0.5, 12) })\\nend\\nfunction Geometry.ring(ctx: any, group: Folder, cf: CFrame, radius: number, color: Color3, duration: number)\\n\\t-- Segmented rings preserve the demo's broken-energy silhouette without large opaque floors.\\n\\tlocal segments = 10\\n\\tfor i = 1, segments do\\n\\t\\tlocal angle = i * math.pi * 2 / segments\\n\\t\\tlocal localPoint = Vector3.new(math.cos(angle), 0, math.sin(angle))\\n\\t\\tlocal from = cf * CFrame.new(localPoint * 0.4) * CFrame.Angles(0, -angle, 0)\\n\\t\\tlocal p = ctx:Part(group, \\\"SanguineRing\\\", Vector3.new(0.12, 0.05, 0.15), from, color, 0.55)\\n\\t\\tctx:Tween(p, duration, { CFrame = cf * CFrame.new(localPoint * radius) * CFrame.Angles(0, -angle, 0),\\n\\t\\t\\tSize = Vector3.new(0.02, 0.02, math.max(0.15, radius * 0.4)), Transparency = 1 })\\n\\tend\\nend\\nfunction Geometry.lightning(ctx: any, group: Folder, a: Vector3, b: Vector3, color: Color3, duration: number)\\n\\tlocal previous = a\\n\\tfor i = 1, 4 do\\n\\t\\tlocal point = a:Lerp(b, i / 4)\\n\\t\\tif i < 4 then point += Vector3.new(rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3)) end\\n\\t\\tGeometry.line(ctx, group, previous, point, 0.06, color, duration)\\n\\t\\tprevious = point\\n\\tend\\nend\\nfunction Geometry.forks(ctx: any, group: Folder, position: Vector3, radius: number, first: Color3, second: Color3)\\n\\tfor i = 1, 3 do\\n\\t\\tlocal angle = i * math.pi * 2 / 3\\n\\t\\tlocal target = position + Vector3.new(math.cos(angle), 0.3, math.sin(angle)) * radius\\n\\t\\tGeometry.lightning(ctx, group, position, target, if i % 2 == 0 then first else second, 0.22)\\n\\tend\\nend\\nreturn table.freeze(Geometry)\\n\", \"SanguineCombat\": \"--!strict\\n-- The VFX demo's crimson/cobalt clash and layered sword wake, sized to real attack reach.\\nlocal G = require(script.Parent.SanguineGeometry)\\nlocal Combat = {}\\nlocal WHITE, GOLD = Color3.fromRGB(255, 245, 229), Color3.fromRGB(255, 195, 86)\\nlocal RED, BLUE = Color3.fromRGB(218, 22, 42), Color3.fromRGB(60, 135, 245)\\nfunction Combat.slash(ctx: any, root: BasePart, move: any)\\n\\tlocal group = ctx:Group(\\\"SanguineWeaponCrescent\\\", 0.45)\\n\\tif not group then return end\\n\\tlocal heavy = move.Kind ~= \\\"Light\\\"\\n\\tlocal reach = math.clamp(move.Reach, 1, 16)\\n\\tlocal half = math.rad(math.clamp(move.Arc, 15, 160) * 0.5)\\n\\tlocal cf = root.CFrame\\n\\tlocal color = if heavy then GOLD elseif (move.ComboIndex or 1) % 2 == 0 then BLUE else RED\\n\\tfor layer = 1, 2 do\\n\\t\\tlocal previous: Vector3? = nil\\n\\t\\tfor i = 0, 8 do\\n\\t\\t\\tlocal angle = -half + half * 2 * i / 8\\n\\t\\t\\tlocal point = cf:PointToWorldSpace(Vector3.new(math.sin(angle) * reach, 0.25 + math.sin(angle) * 0.6,\\n\\t\\t\\t\\t-math.cos(angle) * reach * (if layer == 1 then 1 else 0.94)))\\n\\t\\t\\tif previous then G.line(ctx, group, previous, point, if layer == 1 then 0.08 else 0.035, if layer == 1 then color else WHITE, 0.24) end\\n\\t\\t\\tprevious = point\\n\\t\\tend\\n\\tend\\nend\\nfunction Combat.parry(ctx: any, position: Vector3, direction: Vector3)\\n\\tlocal group = ctx:Group(\\\"SanguineCrimsonCobaltParry\\\", 0.65)\\n\\tif not group then return end\\n\\tlocal flat = Vector3.new(direction.X, 0, direction.Z)\\n\\tlocal forward = if flat.Magnitude > 0.01 then flat.Unit else Vector3.zAxis\\n\\tlocal right = forward:Cross(Vector3.yAxis)\\n\\tG.pulse(ctx, group, position, 1.1, WHITE, 0.18)\\n\\tG.lightning(ctx, group, position - right * 1.5 - Vector3.yAxis, position + right * 1.5 + Vector3.yAxis, BLUE, 0.24)\\n\\tG.lightning(ctx, group, position + right * 1.5 - Vector3.yAxis, position - right * 1.5 + Vector3.yAxis, RED, 0.24)\\n\\tG.ring(ctx, group, CFrame.new(position) * CFrame.Angles(math.pi / 2, 0, 0), 2.3, GOLD, 0.28)\\n\\tctx:Emit(group, position, GOLD, 20)\\nend\\nfunction Combat.hit(ctx: any, position: Vector3, heavy: boolean, blocked: boolean?)\\n\\tlocal group = ctx:Group(if blocked then \\\"SanguineMetalContact\\\" else \\\"SanguineHitSpark\\\", 0.55)\\n\\tif not group then return end\\n\\tlocal color = if blocked then GOLD elseif heavy then GOLD else RED\\n\\tG.pulse(ctx, group, position, if heavy then 1.2 else 0.55, WHITE, 0.16)\\n\\tif heavy then G.forks(ctx, group, position, 1.8, color, BLUE) end\\n\\tctx:Emit(group, position, color, if heavy then 18 else 8)\\nend\\nreturn table.freeze(Combat)\\n\", \"SanguineGhost\": \"--!strict\\n-- Read-only silhouette samples: never clone a character, Humanoid, script or motion controller.\\nlocal Ghost = {}\\nlocal NAMES = { Head = true, UpperTorso = true, LowerTorso = true, Torso = true,\\n\\tLeftUpperArm = true, RightUpperArm = true, LeftUpperLeg = true, RightUpperLeg = true }\\nfunction Ghost.dodge(ctx: any, model: Model)\\n\\tlocal group = ctx:Group(\\\"SanguineDodgeAfterimage\\\", 0.4)\\n\\tif not group then return end\\n\\tfor _, limb in model:GetChildren() do\\n\\t\\tif limb:IsA(\\\"BasePart\\\") and NAMES[limb.Name] and limb.Transparency < 1 then\\n\\t\\t\\tlocal ghost = ctx:Part(group, \\\"SanguineAfterimage\\\", limb.Size * 0.97, limb.CFrame, Color3.fromRGB(103, 146, 185), 0.88)\\n\\t\\t\\tctx:Tween(ghost, 0.3, { Transparency = 1 })\\n\\t\\tend\\n\\tend\\nend\\nreturn table.freeze(Ghost)\\n\", \"SanguineMagic\": \"--!strict\\n-- Selected demo spell/phase/death motifs. Existing authoritative telegraphs and actor death own timing.\\nlocal G = require(script.Parent.SanguineGeometry)\\nlocal Magic = {}\\nlocal RED, BLUE = Color3.fromRGB(218, 22, 42), Color3.fromRGB(60, 135, 245)\\nlocal GOLD = Color3.fromRGB(255, 195, 86)\\nlocal COLORS: { [string]: Color3 } = { CelestialThunder = BLUE, CrimsonFlame = RED,\\n\\tAbyssalVoid = Color3.fromRGB(129, 80, 175), SpiritTalismans = Color3.fromRGB(91, 216, 164) }\\nfunction Magic.spell(ctx: any, position: Vector3, destination: Vector3?, discipline: string?, release: boolean)\\n\\tlocal group = ctx:Group(\\\"SanguineSpellEnergy\\\", 0.65)\\n\\tif not group then return end\\n\\tlocal color = COLORS[discipline or \\\"\\\"] or GOLD\\n\\tif release and destination and (destination - position).Magnitude > 0.1 then\\n\\t\\t-- A cosmetic path only; no simulated projectile, invented hit, target selection or damage.\\n\\t\\tlocal goal = position + (destination - position).Unit * math.min((destination - position).Magnitude, 20)\\n\\t\\tG.lightning(ctx, group, position, goal, color, 0.16)\\n\\telse\\n\\t\\tG.ring(ctx, group, CFrame.new(position), if release then 2.4 else 1.3, color, 0.32)\\n\\tend\\n\\tif release then ctx:Emit(group, position, color, 12) end\\nend\\nfunction Magic.phase(ctx: any, position: Vector3, span: number)\\n\\tlocal group = ctx:Group(\\\"SanguinePhaseAscension\\\", 1.1)\\n\\tif not group then return end\\n\\tlocal radius = math.clamp(span * 0.3, 2, 6)\\n\\tG.ring(ctx, group, CFrame.new(position), radius, RED, 0.65)\\n\\tG.forks(ctx, group, position + Vector3.yAxis, radius * 0.6, RED, BLUE)\\n\\tctx:Emit(group, position, RED, 22)\\nend\\nfunction Magic.impact(ctx: any, position: Vector3, radius: number)\\n\\tlocal group = ctx:Group(\\\"SanguineGroundImpact\\\", 0.8)\\n\\tif not group then return end\\n\\t-- Broken ground lines are visuals above the surface, never terrain edits or colliding debris.\\n\\tlocal r = math.clamp(radius, 1, 8)\\n\\tG.ring(ctx, group, CFrame.new(position), r, RED, 0.42)\\n\\tG.forks(ctx, group, position, r * 0.7, RED, GOLD)\\n\\tctx:Emit(group, position, GOLD, 16)\\nend\\nfunction Magic.death(ctx: any, position: Vector3)\\n\\tlocal group = ctx:Group(\\\"SanguineGreatEnemyFelled\\\", 1.2)\\n\\tif not group then return end\\n\\tG.ring(ctx, group, CFrame.new(position), 5, GOLD, 0.8)\\n\\tG.forks(ctx, group, position + Vector3.yAxis * 2, 3, GOLD, BLUE)\\n\\tctx:Emit(group, position + Vector3.yAxis, GOLD, 24)\\n\\t-- Deliberately no boss Material/Color/Transparency/Size writes from the demo's BossDeath.\\nend\\nreturn table.freeze(Magic)\\n\", \"SanguineDispatch\": \"--!strict\\n-- Server events/cues enter here; no input listeners, remotes or alternate combat simulation.\\nlocal Combat = require(script.Parent.SanguineCombat)\\nlocal Ghost = require(script.Parent.SanguineGhost)\\nlocal Magic = require(script.Parent.SanguineMagic)\\nlocal Spells = require(game:GetService(\\\"ReplicatedStorage\\\").AsurasPath.Simulation.SpellSchema) :: any\\nlocal Dispatch = {}\\nfunction Dispatch.event(self: any, event: any)\\n\\tlocal source, target = self.State:Get(event.Source), self.State:Get(event.Target)\\n\\tlocal own = self.State:Own()\\n\\tif event.Kind == \\\"Rest\\\" then\\n\\t\\tif own and event.Source == own.Id then self:Clear() end\\n\\t\\treturn\\n\\tend\\n\\tif event.Kind == \\\"KO\\\" and own and event.Target == own.Id then self:Clear(); return end\\n\\tif self:Blocked() then return end\\n\\tlocal point = event.Point or (if target and target.Root then target.Root.Position else nil)\\n\\tif not self:Near(point) then return end\\n\\tlocal direction = if source and source.Root and target and target.Root then target.Root.Position - source.Root.Position else Vector3.zAxis\\n\\tlocal kind = event.Kind\\n\\tif kind == \\\"DeflectSpark\\\" then Combat.parry(self.Context, point, direction)\\n\\telseif kind == \\\"Hit\\\" or kind == \\\"CounterHit\\\" or kind == \\\"Armored\\\" or kind == \\\"Deathblow\\\" then\\n\\t\\tCombat.hit(self.Context, point, kind == \\\"CounterHit\\\" or kind == \\\"Deathblow\\\", kind == \\\"Armored\\\")\\n\\telseif kind == \\\"Block\\\" or kind == \\\"GuardBreak\\\" or kind == \\\"StanceBreak\\\" then\\n\\t\\tCombat.hit(self.Context, point, kind ~= \\\"Block\\\", true)\\n\\telseif kind == \\\"Dash\\\" and source then Ghost.dodge(self.Context, source.Model) end\\nend\\nfunction Dispatch.cue(self: any, cue: any)\\n\\tlocal kind, d = cue.Kind, cue.Data\\n\\tif kind == \\\"AltarTravel\\\" or kind == \\\"BossReset\\\" or kind == \\\"BossParticipantLeft\\\" then\\n\\t\\tlocal own = self.State:Own()\\n\\t\\tif own and (cue.Source == own.Id or (type(d.participants) == \\\"table\\\" and table.find(d.participants, own.Id))) then self:Clear() end\\n\\t\\treturn\\n\\tend\\n\\tif self:Blocked() then return end\\n\\tlocal entity = self.State:Get(cue.Source)\\n\\tlocal point = if typeof(d.position) == \\\"Vector3\\\" then d.position\\n\\t\\telseif type(d.x) == \\\"number\\\" and type(d.z) == \\\"number\\\" then Vector3.new(d.x, tonumber(d.y) or 0.3, d.z)\\n\\t\\telseif entity and entity.Root then entity.Root.Position else nil\\n\\tif not self:Near(point) then return end\\n\\tif kind == \\\"BossPhase\\\" or kind == \\\"BossEnrage\\\" then\\n\\t\\tMagic.phase(self.Context, point, if entity and entity.Model then entity.Model:GetExtentsSize().Y else 8)\\n\\telseif kind == \\\"BossDefeated\\\" then Magic.death(self.Context, point)\\n\\telseif kind == \\\"Shockwave\\\" then Magic.impact(self.Context, point, tonumber(d.radius) or 4)\\n\\telseif kind == \\\"SpellStartup\\\" or kind == \\\"SpellRelease\\\" or kind == \\\"SpellPulse\\\" or kind == \\\"ProjectileParry\\\" then\\n\\t\\tlocal spell = if type(d.spell) == \\\"string\\\" then Spells.get(d.spell) else nil\\n\\t\\tMagic.spell(self.Context, point, if typeof(d.destination) == \\\"Vector3\\\" then d.destination else nil,\\n\\t\\t\\tif spell then spell.Discipline else nil, kind ~= \\\"SpellStartup\\\")\\n\\tend\\n\\t-- Demo GroundTelegraph/MeteorFall are not replayed: real BossEffects owns the danger footprint/timing.\\nend\\nreturn table.freeze(Dispatch)\\n\", \"SanguineController\": \"--!strict\\n-- Presentation-only bridge for VFX place 99240829139422. Existing controllers retain all ownership.\\nlocal RunService = game:GetService(\\\"RunService\\\")\\nlocal Runtime = require(script.Parent.SanguineRuntime)\\nlocal Dispatch = require(script.Parent.SanguineDispatch)\\nlocal Combat = require(script.Parent.SanguineCombat)\\nlocal Visibility = require(script.Parent.HudVisibility)\\nlocal Weapons = require(game:GetService(\\\"ReplicatedStorage\\\").AsurasPath.Simulation.WeaponSchema) :: any\\nlocal Controller = {}\\nController.__index = Controller\\nfunction Controller.new(state: any, ui: any): any\\n\\tassert(RunService:IsClient(), \\\"Sanguine effects are client-only\\\")\\n\\tlocal self = setmetatable({ State = state, Ui = ui, Context = Runtime.new(workspace),\\n\\t\\tLast = {}, Disconnects = {}, Alive = true, Failed = false }, Controller)\\n\\ttable.insert(self.Disconnects, state:OnEvent(function(event: any) self:Safe(Dispatch.event, event) end))\\n\\ttable.insert(self.Disconnects, state:OnCue(function(cue: any) self:Safe(Dispatch.cue, cue) end))\\n\\treturn self\\nend\\nfunction Controller.Blocked(self: any): boolean\\n\\tlocal own = self.State:Own()\\n\\treturn not self.Alive or self.Failed or not own or not own.Root or not own.Snapshot\\n\\t\\tor own.Snapshot.State == \\\"KO\\\" or not Visibility.of(self.Ui).Combat or Visibility.flags(self.Ui).Altar\\n\\t\\tor workspace:GetAttribute(\\\"AsuraSanguineVFXEnabled\\\") == false\\nend\\nfunction Controller.Near(self: any, point: any): boolean\\n\\tlocal own = self.State:Own()\\n\\treturn typeof(point) == \\\"Vector3\\\" and own ~= nil and own.Root ~= nil and (point - own.Root.Position).Magnitude <= 65\\nend\\nfunction Controller.Clear(self: any)\\n\\tself.Context:Clear(); table.clear(self.Last)\\nend\\nfunction Controller.Safe(self: any, fn: any, value: any)\\n\\tif not self.Alive or self.Failed then return end\\n\\tlocal ok, problem = pcall(fn, self, value)\\n\\tif not ok then\\n\\t\\tself.Failed = true; self:Clear()\\n\\t\\twarn(\\\"[Asura VFX] Sanguine layer disabled; existing effects remain: \\\" .. tostring(problem))\\n\\tend\\nend\\nlocal function step(self: any, dt: number)\\n\\tself.Context:Update(dt)\\n\\tif self:Blocked() then self:Clear(); return end\\n\\tfor id in self.Last do if not self.State.Entities[id] then self.Last[id] = nil end end\\n\\tfor id, entity in self.State.Entities do\\n\\t\\tlocal snap, root = entity.Snapshot, entity.Root\\n\\t\\tif not snap or not root or not self:Near(root.Position) then self.Last[id] = nil; continue end\\n\\t\\tlocal previous = self.Last[id]\\n\\t\\tlocal active = snap.State == \\\"Active\\\"\\n\\t\\tlocal newSwing = active and (not previous or previous.State ~= \\\"Active\\\" or previous.Move ~= snap.Move or snap.StateElapsed < previous.Elapsed)\\n\\t\\tif newSwing and snap.Move then\\n\\t\\t\\tlocal weapon = Weapons.Weapons[snap.Weapon] -- snapshots carry family keys (Jian), not asset ids (Jian_Sword).\\n\\t\\t\\tlocal move = if weapon then Weapons.findMove(weapon, snap.Move) else nil\\n\\t\\t\\tif move then Combat.slash(self.Context, root, move) end\\n\\t\\tend\\n\\t\\tself.Last[id] = { State = snap.State, Move = snap.Move, Elapsed = snap.StateElapsed }\\n\\tend\\nend\\nfunction Controller.Update(self: any, dt: number) self:Safe(step, dt) end\\nfunction Controller.Destroy(self: any)\\n\\tif not self.Alive then return end\\n\\tself.Alive = false\\n\\tfor _, disconnect in self.Disconnects do disconnect() end\\n\\ttable.clear(self.Disconnects); table.clear(self.Last); self.Context:Destroy()\\nend\\nreturn Controller\\n\", \"HudVisibility\": \"--!strict\\n-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/HudVisibility\\n-- One rule for which HUD layers may show. Every layer asks this each frame instead of keeping its\\n-- own hidden flag, so leaving the prologue, death screen or a dialogue restores exactly what the\\n-- current situation allows and no stale label survives a transition.\\nlocal ProximityPromptService = game:GetService(\\\"ProximityPromptService\\\")\\n\\nlocal Visibility = {}\\n\\nexport type Flags = { Death: boolean, Prologue: boolean, Dialogue: boolean, Altar: boolean, Boss: boolean, Touch: boolean? }\\nexport type Layers = {\\n\\tCombat: boolean, -- action bar, enemy plates, target plate, callouts, lock-on\\n\\tVitals: boolean, -- health / stamina / Qi plate and loadout\\n\\tBoss: boolean, -- boss bar and duo strip\\n\\tDecor: boolean, -- compass, minimap, screen petals\\n\\tGuidance: boolean, -- objective, controls pill/card, Codex button, spell cluster\\n\\tPointer: boolean, -- guidance buttons for mouse/controller only (touch reaches them through Respite)\\n\\tPrompts: boolean, -- in-world ProximityPrompts\\n\\tNotices: boolean, -- toasts and banners\\n}\\n\\n-- Pure decision table (tested in tools/test_hud_layout.luau).\\nfunction Visibility.resolve(flags: Flags): Layers\\n\\tlocal cinematic = flags.Death or flags.Prologue\\n\\tlocal talking = flags.Dialogue\\n\\treturn {\\n\\t\\tCombat = not cinematic and not talking,\\n\\t\\tVitals = not cinematic and not talking,\\n\\t\\tBoss = flags.Boss and not cinematic and not talking,\\n\\t\\tDecor = not cinematic and not talking,\\n\\t\\tGuidance = not cinematic and not talking and not flags.Altar,\\n\\t\\tPointer = not cinematic and not talking and not flags.Altar and flags.Touch ~= true,\\n\\t\\tPrompts = not cinematic and not talking and not flags.Altar, -- menus own the interact key\\n\\t\\tNotices = not flags.Death,\\n\\t}\\nend\\n\\nfunction Visibility.flags(ui: any): Flags\\n\\treturn {\\n\\t\\tDeath = ui.DeathShown == true,\\n\\t\\tPrologue = ui.PrologueActive == true or ui.EndingActive == true, -- the crossing is cinematic too\\n\\t\\tDialogue = ui.DialogueOpen == true,\\n\\t\\tAltar = ui.Altar ~= nil and ui.Altar.Visible == true,\\n\\t\\tBoss = ui.BossEntity ~= nil,\\n\\t\\tTouch = ui.TouchHud == true,\\n\\t}\\nend\\n\\nfunction Visibility.of(ui: any): Layers\\n\\treturn Visibility.resolve(Visibility.flags(ui))\\nend\\n\\n-- Small HUD pieces without their own update (e.g. the Codex button) register a layer once.\\nlocal registered: { [GuiObject]: string } = setmetatable({}, { __mode = \\\"k\\\" }) :: any\\nfunction Visibility.register(object: GuiObject, layer: string)\\n\\tregistered[object] = layer\\nend\\n\\n-- Prompts are a local client setting: hiding them never disables the server-side interaction.\\nlocal promptsShown = true\\nfunction Visibility.apply(ui: any): Layers\\n\\tlocal layers = Visibility.of(ui)\\n\\tif layers.Prompts ~= promptsShown then\\n\\t\\tpromptsShown = layers.Prompts\\n\\t\\tProximityPromptService.Enabled = layers.Prompts\\n\\tend\\n\\tfor object, layer in registered do\\n\\t\\tobject.Visible = (layers :: any)[layer] == true\\n\\tend\\n\\treturn layers\\nend\\n\\nfunction Visibility.restore()\\n\\tpromptsShown = true\\n\\tProximityPromptService.Enabled = true\\n\\ttable.clear(registered)\\nend\\n\\nreturn table.freeze(Visibility)\\n\", \"EffectsPreference\": \"--!strict\\n-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/EffectsPreference\\n-- The one shared switch for comfort and decoration. Decoration thins out during active fights so\\n-- telegraphs, damage numbers and counter prompts stay dominant; \\\"reduced effects\\\" thins it further\\n-- everywhere (screen petals, drifting ash, particle density). Batch 25 adds reduced motion (camera\\n-- shake/kick and scripted camera moves), reduced flashes (screen blooms and impact flashes) and a\\n-- text scale. Warnings and hit feedback are never removed by these, only calmed. The values are\\n-- persisted in profile.settings.comfort (ProfileSchema) and applied by the bootstrap; `sanitize`\\n-- is the single validator for both sides.\\nlocal Effects = {}\\n\\nexport type Prefs = { ReducedEffects: boolean, ReducedMotion: boolean, ReducedFlashes: boolean, TextScale: number }\\n\\n-- Share of the authored decorative density that stays visible.\\nEffects.Decor = table.freeze({ Explore = 1, Combat = 0.25, ReducedExplore = 0.3, ReducedCombat = 0 })\\n-- Decorative petals lose contrast in fights as well as count.\\nEffects.CombatContrast = 0.45\\nEffects.TextScales = table.freeze({ 1, 1.15, 1.3 })\\nEffects.FlashFloor = 0.35 -- reduced flashes keep this share of a bloom's strength (still visible)\\nEffects.MotionFloor = 0.25 -- reduced motion keeps this share of shake / kick (impacts still felt)\\nEffects.Default = table.freeze({ ReducedEffects = false, ReducedMotion = false, ReducedFlashes = false, TextScale = 1 })\\n\\nlocal prefs: Prefs = table.clone(Effects.Default) :: Prefs\\nlocal listeners: { (boolean) -> () } = {}\\n\\n-- Accepts anything (a saved table, a client packet) and returns valid preferences.\\nfunction Effects.sanitize(raw: any): Prefs\\n\\tlocal source = if type(raw) == \\\"table\\\" then raw else {}\\n\\tlocal scale = 1\\n\\tfor _, allowed in Effects.TextScales do\\n\\t\\tif source.TextScale == allowed then scale = allowed end\\n\\tend\\n\\treturn {\\n\\t\\tReducedEffects = source.ReducedEffects == true,\\n\\t\\tReducedMotion = source.ReducedMotion == true,\\n\\t\\tReducedFlashes = source.ReducedFlashes == true,\\n\\t\\tTextScale = scale,\\n\\t}\\nend\\n\\nfunction Effects.get(): Prefs\\n\\treturn table.clone(prefs)\\nend\\n\\n-- Applies a (partial) preference table; listeners hear about any change.\\nfunction Effects.set(partial: any)\\n\\tlocal merged = table.clone(prefs) :: any\\n\\tif type(partial) == \\\"table\\\" then\\n\\t\\tfor key, value in partial do merged[key] = value end\\n\\tend\\n\\tlocal nextPrefs = Effects.sanitize(merged)\\n\\tlocal changed = false\\n\\tfor key, value in nextPrefs :: any do\\n\\t\\tif (prefs :: any)[key] ~= value then changed = true end\\n\\tend\\n\\tif not changed then return end\\n\\tprefs = nextPrefs\\n\\tfor _, listener in table.clone(listeners) do\\n\\t\\ttask.spawn(listener, prefs.ReducedEffects)\\n\\tend\\nend\\n\\nfunction Effects.reduced(): boolean\\n\\treturn prefs.ReducedEffects\\nend\\n\\nfunction Effects.setReduced(value: boolean)\\n\\tEffects.set({ ReducedEffects = value })\\nend\\n\\nfunction Effects.reducedMotion(): boolean\\n\\treturn prefs.ReducedMotion\\nend\\n\\nfunction Effects.reducedFlashes(): boolean\\n\\treturn prefs.ReducedFlashes\\nend\\n\\nfunction Effects.textScale(): number\\n\\treturn prefs.TextScale\\nend\\n\\n-- Listener receives the reduced-effects flag; read the other getters inside it as needed.\\nfunction Effects.onChanged(listener: (boolean) -> ()): () -> ()\\n\\ttable.insert(listeners, listener)\\n\\treturn function()\\n\\t\\tlocal index = table.find(listeners, listener)\\n\\t\\tif index then\\n\\t\\t\\ttable.remove(listeners, index)\\n\\t\\tend\\n\\tend\\nend\\n\\n-- Decorative density multiplier (0..1) for the current situation.\\nfunction Effects.decor(engaged: boolean): number\\n\\tlocal d = Effects.Decor\\n\\tif prefs.ReducedEffects then\\n\\t\\treturn if engaged then d.ReducedCombat else d.ReducedExplore\\n\\tend\\n\\treturn if engaged then d.Combat else d.Explore\\nend\\n\\n-- Screen bloom / flash strength after the comfort setting.\\nfunction Effects.flash(strength: number): number\\n\\treturn if prefs.ReducedFlashes then strength * Effects.FlashFloor else strength\\nend\\n\\n-- Camera shake / kick magnitude after the comfort setting.\\nfunction Effects.motion(magnitude: number): number\\n\\treturn if prefs.ReducedMotion then magnitude * Effects.MotionFloor else magnitude\\nend\\n\\nreturn table.freeze(Effects)\\n\"}")
