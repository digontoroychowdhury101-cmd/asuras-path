        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CombatRules</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Simulation/CombatRules
-- Authoritative combat resolution for Asura's Path. Deterministic and engine-free: every function
-- takes explicit `now` timestamps, touches only the fighter records passed to it and reports
-- what happened through Event records. Geometry (range, facing, struck region) is supplied by callers.
local hasScript = pcall(function()
	return script.Parent
end)
local Settings: any, Schema: any, Weapons: any, Tempo: any
if hasScript then
	Settings = require(script.Parent.Parent.Shared.CombatSettings)
	Schema = require(script.Parent.MoveSchema)
	Weapons = require(script.Parent.WeaponSchema)
	Tempo = require(script.Parent.Tempo)
else
	Settings = require("../shared/CombatSettings")
	Schema = require("./MoveSchema")
	Weapons = require("./WeaponSchema")
	Tempo = require("./Tempo")
end

export type State =
	"Idle"
	| "Startup"
	| "Active"
	| "Recovery"
	| "Deflecting"
	| "Blocking"
	| "Blockstun"
	| "Dashing"
	| "Hitstun"
	| "GuardBroken"
	| "StaminaBroken"
	| "StanceBroken"
	| "DeathblowAttacker"
	| "DeathblowVictim"
	| "RestingAtShrine"
	| "KO"
type Context = { [string]: any }
export type InjuryTier = "None" | "Impaired" | "Injured" | "Severe"
export type InjuryRegion = "Head" | "Torso" | "LeftArm" | "RightArm" | "LeftLeg" | "RightLeg"
export type WeaponType = "Unarmed" | "Jian" | "Dao" | "Guandao"
export type MoveKind = "Light" | "Heavy" | "RunningAttack" | "WeaponArt"
export type DamageCategory = "Chip" | "Light" | "Heavy" | "RunningAttack" | "WeaponArt" | "Bleed" | "Deathblow"

export type EventKind =
	"DeflectSpark"
	| "Block"
	| "GuardBreak"
	| "Hit"
	| "CounterHit"
	| "Armored"
	| "StanceBreak"
	| "Deathblow"
	| "Rally"
	| "BleedProc"
	| "InjuryTier"
	| "StaminaBreak"
	| "Feint"
	| "Dash"
	| "KO"
	| "Rest"

export type Event = { Kind: EventKind, Source: number, Target: number, Value: number, Region: string? }

export type MoveTiming = {
	StartupSeconds: number,
	ActiveSeconds: number,
	RecoverySeconds: number,
	ComboWindowSeconds: number,
	CancelFrame: number,
	TotalSeconds: number,
}

export type MoveData = {
	Id: string,
	Kind: MoveKind,
	ComboIndex: number,
	BaseDamage: number,
	PostureDamage: number,
	Bleed: number,
	DeflectVulnerability: number,
	Deflectable: boolean,
	Unblockable: boolean,
	HyperArmor: boolean,
	StaminaCost: number,
	QiCost: number,
	Reach: number,
	Arc: number,
	Lunge: number,
	DamageType: "Blunt" | "Slash" | "Pierce",
	Trauma: { Head: number, Torso: number, Arms: number, Legs: number },
	Timing: MoveTiming,
}

export type Penalties = {
	StaminaCostMultiplier: number,
	DamageMultiplier: number,
	SpeedMultiplier: number,
	DashDistanceMultiplier: number,
	DeflectWindowMultiplier: number,
	PostureDecayMultiplier: number,
	StaminaRegenMultiplier: number,
	MaxPostureMultiplier: number,
	VisionBlur: number,
	EyeVignette: number,
}

export type Fighter = {
	Id: number,
	Weapon: WeaponType,
	MainHand: "Left" | "Right",
	State: State,
	StateStart: number,
	StateEnd: number,
	Move: MoveData?,
	MoveStart: number,
	HitRegistry: { [number]: boolean },
	ActiveHP: number,
	RecoverableHP: number,
	PermanentDeficit: number,
	RallyUntil: number,
	Stamina: number,
	StaminaRegenAt: number,
	Posture: number,
	PostureDecayAt: number,
	Qi: number,
	Bleed: number,
	BleedDecayAt: number,
	Trauma: { [InjuryRegion]: number },
	Injuries: { [InjuryRegion]: InjuryTier },
	TraumaAt: number,
	Penalties: Penalties,
	GuardHeld: boolean,
	Sprinting: boolean,
	DeflectPressedAt: number,
	DeflectWindow: number,
	LastDeflectPress: number,
	DeflectChain: number,
	DashChain: number,
	LastDashAt: number,
	DashSeq: number,
	DashDistance: number,
	DashDuration: number,
	DashDirX: number,
	DashDirZ: number,
	IFrameStart: number,
	IFrameEnd: number,
	DeathblowPartner: number,
	PendingKO: boolean,
	EventSeq: number,
	LastEvent: number,
	MaxHP: number,
	MaxStamina: number,
	PostureCapacity: number,
	StrengthScale: number,
	DexterityScale: number,
	PoiseArmor: number,
	ReachBonus: number,
	-- ActiveHP floors at 1 (multi-phase bosses); cleared for the final phase.
	KOProtected: boolean,
	InvulnerableUntil: number,
	PendingHeal: number,
	PendingHealAt: number,
}

export type Stats = {
	MaxHP: number?,
	MaxStamina: number?,
	PostureCapacity: number?,
	StrengthScale: number?,
	DexterityScale: number?,
	PoiseArmor: number?,
	ReachBonus: number?,
}

export type HitContext = {
	-- Defender is facing the attacker closely enough to guard (front arc).
	Facing: boolean,
	-- Hurtbox region struck by the lag-compensated query.
	Region: InjuryRegion,
}

export type HitOutcome = "Ignored" | "Whiff" | "Deflected" | "Blocked" | "GuardBroken" | "Hit" | "CounterHit" | "Armored" | "KO"

export type DashGrant = { Distance: number, Duration: number, IFrameStart: number, IFrameEnd: number, Seq: number }

local Rules = {}

local REGIONS: { InjuryRegion } = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }
local GROUP: { [InjuryRegion]: "Head" | "Torso" | "Arms" | "Legs" } = {
	Head = "Head",
	Torso = "Torso",
	LeftArm = "Arms",
	RightArm = "Arms",
	LeftLeg = "Legs",
	RightLeg = "Legs",
}
local NEVER = math.huge
local FLOOR_TRAUMA = 0.02

local EVENT_CODES: { [EventKind]: number } = {
	DeflectSpark = 1,
	Block = 2,
	GuardBreak = 3,
	Hit = 4,
	CounterHit = 5,
	Armored = 6,
	StanceBreak = 7,
	Deathblow = 8,
	Rally = 9,
	BleedProc = 10,
	InjuryTier = 11,
	StaminaBreak = 12,
	Feint = 13,
	Dash = 14,
	KO = 15,
	Rest = 16,
}
local EVENT_NAMES: { [number]: EventKind } = {}
for name, code in EVENT_CODES do
	EVENT_NAMES[code] = name
end
Rules.EventCodes = table.freeze(EVENT_CODES)
Rules.EventNames = table.freeze(EVENT_NAMES)

-- Fraction of base walk speed allowed in each state (dash displacement is granted separately).
local STATE_SPEED: { [State]: number } = {
	Idle = 1,
	Startup = 0.35,
	Active = 0.25,
	Recovery = 0.5,
	Deflecting = 0.6,
	Blocking = 0.5,
	Blockstun = 0.2,
	Dashing = 0,
	Hitstun = 0,
	GuardBroken = 0,
	StaminaBroken = 0.35,
	StanceBroken = 0,
	DeathblowAttacker = 0,
	DeathblowVictim = 0,
	RestingAtShrine = 0,
	KO = 0,
}
Rules.StateSpeed = table.freeze(STATE_SPEED)

local function emit(f: Fighter, events: { Event }?, kind: EventKind, source: number, target: number, value: number, region: string?)
	f.EventSeq = (f.EventSeq + 1) % 65536
	f.LastEvent = EVENT_CODES[kind]
	if events then
		table.insert(events, { Kind = kind, Source = source, Target = target, Value = value, Region = region })
	end
end

local function weaponOf(f: Fighter): any
	return Weapons.get(f.Weapon)
end

local function refreshPenalties(f: Fighter)
	f.Penalties = Schema.penalties(f.Injuries, Weapons.isTwoHanded(weaponOf(f)), f.MainHand)
end

local function enter(f: Fighter, state: State, now: number, duration: number?)
	f.State = state
	f.StateStart = now
	f.StateEnd = if duration then now + duration else NEVER
end

local function clearMove(f: Fighter)
	f.Move = nil
	table.clear(f.HitRegistry)
end

function Rules.new(id: number, weapon: WeaponType?, now: number): Fighter
	local trauma: { [InjuryRegion]: number } = {}
	local injuries: { [InjuryRegion]: InjuryTier } = {}
	for _, region in REGIONS do
		trauma[region] = 0
		injuries[region] = "None"
	end
	local fighter: Fighter = {
		Id = id,
		Weapon = weapon or "Unarmed",
		MainHand = "Right",
		State = "Idle",
		StateStart = now,
		StateEnd = NEVER,
		Move = nil,
		MoveStart = now,
		HitRegistry = {},
		ActiveHP = Settings.Health.MaxHP,
		RecoverableHP = 0,
		PermanentDeficit = 0,
		RallyUntil = -NEVER,
		Stamina = Settings.Stamina.Max,
		StaminaRegenAt = now,
		Posture = 0,
		PostureDecayAt = now,
		Qi = Settings.Qi.Initial,
		Bleed = 0,
		BleedDecayAt = now,
		Trauma = trauma,
		Injuries = injuries,
		TraumaAt = -NEVER,
		Penalties = Schema.penalties(injuries, false, "Right"),
		GuardHeld = false,
		Sprinting = false,
		DeflectPressedAt = -NEVER,
		DeflectWindow = Settings.Posture.DeflectWindow,
		LastDeflectPress = -NEVER,
		DeflectChain = 0,
		DashChain = 0,
		LastDashAt = -NEVER,
		DashSeq = 0,
		DashDistance = 0,
		DashDuration = 0,
		DashDirX = 0,
		DashDirZ = 0,
		IFrameStart = -NEVER,
		IFrameEnd = -NEVER,
		DeathblowPartner = 0,
		PendingKO = false,
		EventSeq = 0,
		LastEvent = 0,
		MaxHP = Settings.Health.MaxHP,
		MaxStamina = Settings.Stamina.Max,
		PostureCapacity = Settings.Posture.StanceBreakThreshold,
		StrengthScale = 1,
		DexterityScale = 1,
		PoiseArmor = 0,
		ReachBonus = 0,
		KOProtected = false,
		InvulnerableUntil = -NEVER,
		PendingHeal = 0,
		PendingHealAt = NEVER,
	}
	refreshPenalties(fighter)
	return fighter
end

-- Shrine rest / respawn restoration. `full` clears every layer regardless of shrine settings.
function Rules.restore(f: Fighter, now: number, full: boolean?)
	local shrine = Settings.Health.Shrine
	if full or shrine.ClearsPermanentDeficit then
		f.PermanentDeficit = 0
	end
	if full or shrine.ClearsRecoverableHP then
		f.RecoverableHP = 0
	end
	if full or shrine.RestoresActiveHP then
		f.ActiveHP = Rules.effectiveMaxHP(f) - f.RecoverableHP
	end
	if full or shrine.ClearsInjuries then
		for _, region in REGIONS do
			f.Trauma[region] = 0
			f.Injuries[region] = "None"
		end
		refreshPenalties(f)
	end
	if full or Settings.Qi.ClearOnShrine then
		f.Qi = Settings.Qi.Initial
	end
	f.Stamina = f.MaxStamina
	f.Posture = 0
	f.Bleed = 0
	f.PendingHeal = 0
	f.PendingHealAt = NEVER
	f.InvulnerableUntil = -NEVER
	f.RallyUntil = -NEVER
	f.DashChain = 0
	f.DeflectChain = 0
	f.PendingKO = false
	f.DeathblowPartner = 0
	f.GuardHeld = false
	f.Sprinting = false
	clearMove(f)
end

function Rules.effectiveMaxHP(f: Fighter): number
	local health = Settings.Health
	local ratio = f.MaxHP / health.MaxHP
	return math.max(health.MinEffectiveMaxHP * ratio, f.MaxHP - f.PermanentDeficit)
end

function Rules.maxPermanentDeficit(f: Fighter): number
	return Settings.Health.MaxPermanentDeficit * f.MaxHP / Settings.Health.MaxHP
end

-- Applies attribute- or definition-derived pools. `refill` tops every pool up to its new maximum.
function Rules.applyStats(f: Fighter, stats: Stats, refill: boolean?)
	local hpRatio = if f.MaxHP > 0 then f.ActiveHP / f.MaxHP else 1
	f.MaxHP = math.clamp(stats.MaxHP or f.MaxHP, 1, 1600)
	f.MaxStamina = math.clamp(stats.MaxStamina or f.MaxStamina, 1, 600)
	f.PostureCapacity = math.clamp(stats.PostureCapacity or f.PostureCapacity, 1, 600)
	f.StrengthScale = math.clamp(stats.StrengthScale or f.StrengthScale, 0.1, 5)
	f.DexterityScale = math.clamp(stats.DexterityScale or f.DexterityScale, 0.1, 5)
	f.PoiseArmor = math.clamp(stats.PoiseArmor or f.PoiseArmor, 0, 1)
	f.ReachBonus = math.clamp(stats.ReachBonus or f.ReachBonus, 0, 8)
	f.PermanentDeficit = math.min(f.PermanentDeficit, Rules.maxPermanentDeficit(f))
	if refill then
		f.ActiveHP = Rules.effectiveMaxHP(f) - f.RecoverableHP
		f.Stamina = f.MaxStamina
	else
		f.ActiveHP = math.min(Rules.effectiveMaxHP(f), hpRatio * f.MaxHP)
		f.Stamina = math.min(f.Stamina, f.MaxStamina)
	end
	f.ActiveHP = math.max(f.ActiveHP, 0)
	f.RecoverableHP = math.clamp(f.RecoverableHP, 0, math.max(Rules.effectiveMaxHP(f) - f.ActiveHP, 0))
	f.Posture = math.min(f.Posture, Rules.maxPosture(f))
end

-- Attribute scaling: Strength drives unarmed and heavy strikes, Dexterity drives bladed technique.
function Rules.damageScale(f: Fighter, move: MoveData): number
	if f.Weapon == "Unarmed" or move.Kind == "Heavy" then
		return f.StrengthScale
	end
	return f.DexterityScale
end

function Rules.maxPosture(f: Fighter): number
	return f.PostureCapacity * f.Penalties.MaxPostureMultiplier
end

function Rules.armTier(f: Fighter): InjuryTier
	return Schema.attackArmTier(f.Injuries, Weapons.isTwoHanded(weaponOf(f)), f.MainHand)
end

function Rules.isAlive(f: Fighter): boolean
	return f.State ~= "KO"
end

function Rules.isInvulnerable(f: Fighter, now: number): boolean
	if Schema.isInvulnerable(f.State) or now < f.InvulnerableUntil then
		return true
	end
	return f.State == "Dashing" and now >= f.IFrameStart and now <= f.IFrameEnd
end

function Rules.speedMultiplier(f: Fighter): number
	local weapon = weaponOf(f)
	local sprint = if f.Sprinting and f.State == "Idle" then Settings.Movement.SprintSpeed / Settings.Movement.WalkSpeed else 1
	return STATE_SPEED[f.State] * f.Penalties.SpeedMultiplier * weapon.MoveSpeedMultiplier * sprint
end

function Rules.recoveryStart(f: Fighter): number
	local move = f.Move
	if move == nil then
		return f.StateStart
	end
	return f.MoveStart + move.Timing.StartupSeconds + move.Timing.ActiveSeconds
end

function Rules.comboWindowOpen(f: Fighter, now: number): boolean
	local move = f.Move
	if f.State ~= "Recovery" or move == nil or move.Timing.ComboWindowSeconds <= 0 then
		return false
	end
	return now - Rules.recoveryStart(f) <= move.Timing.ComboWindowSeconds + Tempo.HalfTick
end

function Rules.cancelWindowOpen(f: Fighter, now: number): boolean
	if f.State == "Recovery" then
		local move = f.Move
		return move ~= nil and now - f.MoveStart >= Tempo.framesToSeconds(move.Timing.CancelFrame) - Tempo.HalfTick
	elseif f.State == "Dashing" then
		return now - f.StateStart >= f.DashDuration * Settings.Backdash.CancelFraction
	end
	return false
end

-- 0..1 progress through the active frames (drives procedural weapon arcs); nil outside Active.
function Rules.activeProgress(f: Fighter, now: number): number?
	local move = f.Move
	if f.State ~= "Active" or move == nil then
		return nil
	end
	local start = f.MoveStart + move.Timing.StartupSeconds
	return math.clamp((now - start) / math.max(move.Timing.ActiveSeconds, Tempo.TickSeconds), 0, 1)
end

function Rules.context(f: Fighter, now: number, extra: Context?): Context
	local ctx: Context = {
		ComboWindowOpen = Rules.comboWindowOpen(f, now),
		CancelWindowOpen = Rules.cancelWindowOpen(f, now),
		Sprinting = f.Sprinting,
		DeflectReady = true,
		Qi = f.Qi,
		ArmTier = Rules.armTier(f),
	}
	if extra then
		for key, value in extra :: any do
			(ctx :: any)[key] = value
		end
	end
	return ctx
end

-------------------------------------------------------------------------------------------------
-- 1. Stamina & posture expenditure
-------------------------------------------------------------------------------------------------

function Rules.attackStaminaCost(f: Fighter, move: MoveData): number
	return move.StaminaCost * Schema.armStaminaMultiplier(Rules.armTier(f))
end

-- Spends stamina; returns true when the fighter is now at or below the break threshold.
function Rules.spendStamina(f: Fighter, amount: number, now: number): boolean
	if amount <= 0 then
		return f.Stamina <= Settings.Stamina.BreakThreshold
	end
	f.Stamina = math.max(f.Stamina - amount, Settings.Stamina.BreakThreshold - f.MaxStamina)
	f.StaminaRegenAt = now + Settings.Stamina.RegenDelay
	return f.Stamina <= Settings.Stamina.BreakThreshold
end

local function staminaBreak(f: Fighter, now: number, events: { Event }?, source: number)
	if f.State == "KO" or f.State == "StanceBroken" or f.State == "DeathblowVictim" or f.State == "DeathblowAttacker" then
		return
	end
	clearMove(f)
	f.Stamina = math.max(f.Stamina, 0)
	f.Sprinting = false
	enter(f, "StaminaBroken", now, Settings.Stun.StaminaBroken)
	emit(f, events, "StaminaBreak", source, f.Id, f.Stamina)
end

local function stanceBreak(f: Fighter, now: number, events: { Event }?, source: number)
	clearMove(f)
	f.Posture = Rules.maxPosture(f)
	f.Sprinting = false
	enter(f, "StanceBroken", now, Settings.Stun.StanceBroken)
	emit(f, events, "StanceBreak", source, f.Id, f.Posture)
end

-- Adds posture; returns true if this triggered a StanceBreak. `cap` keeps posture below the break line.
function Rules.addPosture(f: Fighter, amount: number, now: number, events: { Event }?, source: number, cap: boolean?): boolean
	if amount <= 0 or f.State == "KO" or f.State == "StanceBroken" or f.State == "DeathblowVictim" or f.State == "DeathblowAttacker" then
		return false
	end
	local limit = Rules.maxPosture(f)
	f.Posture = if cap then math.min(f.Posture + amount, limit - 1) else f.Posture + amount
	f.PostureDecayAt = now + Settings.Posture.DecayDelay
	if f.Posture >= limit then
		stanceBreak(f, now, events, source)
		return true
	end
	return false
end

-------------------------------------------------------------------------------------------------
-- 4. Blood Rally / tri-layer health
-------------------------------------------------------------------------------------------------

local function convertRecoverable(f: Fighter)
	if f.RecoverableHP <= 0 then
		return
	end
	f.PermanentDeficit = math.min(Rules.maxPermanentDeficit(f), f.PermanentDeficit + f.RecoverableHP)
	f.RecoverableHP = 0
end

local function clampLayers(f: Fighter)
	local cap = Rules.effectiveMaxHP(f)
	f.ActiveHP = math.min(f.ActiveHP, cap)
	f.RecoverableHP = math.clamp(f.RecoverableHP, 0, math.max(cap - math.max(f.ActiveHP, 0), 0))
end

-- Applies damage to ActiveHP and distributes it into the recoverable and permanent layers.
-- Returns ActiveHP actually removed.
function Rules.applyDamage(f: Fighter, amount: number, category: DamageCategory, now: number): number
	if amount <= 0 or f.State == "KO" then
		return 0
	end
	local health = Settings.Health
	if category == "Heavy" or category == "Deathblow" then
		convertRecoverable(f)
	end
	local dealt = math.min(amount, math.max(f.ActiveHP, 0))
	if f.KOProtected then
		dealt = math.min(dealt, math.max(f.ActiveHP - 1, 0))
	end
	f.ActiveHP -= dealt
	f.RecoverableHP += dealt * (health.RecoverableFraction[category] or 0)
	f.PermanentDeficit = math.min(Rules.maxPermanentDeficit(f), f.PermanentDeficit + dealt * (health.PermanentFraction[category] or 0))
	f.RallyUntil = now + health.Rally.Window
	clampLayers(f)
	return dealt
end

-- Striking back inside the rally window returns RecoverableHP proportional to damage dealt.
function Rules.rally(f: Fighter, dealt: number, now: number, events: { Event }?, target: number): number
	if dealt <= 0 or now > f.RallyUntil or f.RecoverableHP <= 0 or f.State == "KO" then
		return 0
	end
	local restored = math.min(f.RecoverableHP, dealt * Settings.Health.Rally.ReturnRatio)
	f.RecoverableHP -= restored
	f.ActiveHP += restored
	clampLayers(f)
	emit(f, events, "Rally", f.Id, target, restored)
	return restored
end

function Rules.heal(f: Fighter, amount: number)
	if f.State == "KO" or amount <= 0 then
		return
	end
	local fromRecoverable = math.min(f.RecoverableHP, amount)
	f.RecoverableHP -= fromRecoverable
	f.ActiveHP += amount
	clampLayers(f)
end

-------------------------------------------------------------------------------------------------
-- Injury trauma
-------------------------------------------------------------------------------------------------

local function addTrauma(f: Fighter, region: InjuryRegion, amount: number, now: number, events: { Event }?, source: number)
	if amount <= 0 then
		return
	end
	f.Trauma[region] = math.min(1, f.Trauma[region] + amount)
	f.TraumaAt = now
	local tier: InjuryTier = Schema.tierFromCoefficient(region, f.Trauma[region])
	if tier ~= f.Injuries[region] then
		local rose = Schema.tierIndex(tier) > Schema.tierIndex(f.Injuries[region])
		f.Injuries[region] = tier
		refreshPenalties(f)
		if rose then
			emit(f, events, "InjuryTier", source, f.Id, Schema.tierIndex(tier), region)
		end
	end
end

function Rules.traumaFor(move: MoveData, region: InjuryRegion): number
	local amount: number = (move.Trauma :: any)[GROUP[region]]
	if amount <= 0 then
		amount = FLOOR_TRAUMA
	end
	if region == "Head" and move.DamageType == "Blunt" then
		amount *= Settings.Injury.BluntHeadConcussionScale
	end
	return amount
end

-------------------------------------------------------------------------------------------------
-- Timed simulation
-------------------------------------------------------------------------------------------------

local function expire(f: Fighter, now: number, events: { Event }?)
	local state = f.State
	local move = f.Move
	if state == "Startup" and move then
		f.State = "Active"
		f.StateStart = f.MoveStart + move.Timing.StartupSeconds
		f.StateEnd = f.StateStart + move.Timing.ActiveSeconds
		table.clear(f.HitRegistry)
	elseif state == "Active" and move then
		f.State = "Recovery"
		f.StateStart = f.StateEnd
		f.StateEnd = f.StateStart + move.Timing.RecoverySeconds
	elseif state == "Deflecting" or state == "Blockstun" then
		local guard = f.GuardHeld and f.Stamina > Settings.Stamina.BreakThreshold
		enter(f, if guard then "Blocking" else "Idle", f.StateEnd)
	elseif state == "StaminaBroken" then
		f.Stamina = math.max(f.Stamina, f.MaxStamina * Settings.Stamina.RecoverToFraction)
		enter(f, "Idle", f.StateEnd)
	elseif state == "StanceBroken" then
		f.Posture = Settings.Posture.StanceBreakResetValue
		enter(f, "Idle", f.StateEnd)
	elseif state == "DeathblowVictim" then
		f.Posture = 0
		f.DeathblowPartner = 0
		if f.PendingKO or f.ActiveHP <= 0 then
			f.PendingKO = false
			enter(f, "KO", f.StateEnd)
			emit(f, events, "KO", 0, f.Id, 0)
		else
			enter(f, "Idle", f.StateEnd)
		end
	elseif state == "DeathblowAttacker" then
		f.DeathblowPartner = 0
		enter(f, "Idle", f.StateEnd)
	elseif state ~= "KO" then
		clearMove(f)
		enter(f, "Idle", f.StateEnd)
	end
	if f.State == "Idle" then
		clearMove(f)
	end
end

local function regenerate(f: Fighter, now: number, dt: number)
	if f.State == "KO" then
		return
	end
	local stamina = Settings.Stamina
	local posture = Settings.Posture
	local health = Settings.Health

	if f.Sprinting then
		if f.State == "Idle" then
			f.Stamina -= stamina.SprintCostPerSecond * dt
			f.StaminaRegenAt = now + stamina.RegenDelay * 0.5
			if f.Stamina <= 1 then
				f.Stamina = math.max(f.Stamina, 1)
				f.Sprinting = false
			end
		elseif f.State ~= "Startup" and f.State ~= "Active" and f.State ~= "Recovery" then
			f.Sprinting = false
		end
	end

	if now >= f.StaminaRegenAt and f.Stamina < f.MaxStamina then
		local rate = stamina.RegenRate * f.Penalties.StaminaRegenMultiplier
		if Schema.isGuarding(f.State) then
			rate *= stamina.GuardRegenMultiplier
		elseif f.State == "StaminaBroken" then
			rate *= stamina.BrokenRegenMultiplier
		end
		f.Stamina = math.min(f.MaxStamina, f.Stamina + rate * dt)
	end

	if now >= f.PostureDecayAt and f.Posture > 0 and f.State ~= "StanceBroken" then
		local hpRatio = math.clamp(f.ActiveHP / Rules.effectiveMaxHP(f), 0, 1)
		local scale = posture.LowHealthDecayScale
		local hpScale = scale.AtZeroHP + (scale.AtFullHP - scale.AtZeroHP) * hpRatio
		local rate = posture.DecayRate * Schema.postureDecayMultiplier(f.State) * hpScale * f.Penalties.PostureDecayMultiplier
		f.Posture = math.max(0, f.Posture - rate * dt)
	end

	if now > f.RallyUntil + (health.Rally.DecayDelay - health.Rally.Window) and f.RecoverableHP > 0 then
		f.RecoverableHP = math.max(0, f.RecoverableHP - health.Rally.DecayRate * dt)
	end

	if now >= f.BleedDecayAt and f.Bleed > 0 then
		f.Bleed = math.max(0, f.Bleed - Settings.Bleed.DecayRate * dt)
	end

	if Settings.Qi.DecayRate > 0 and f.Qi > 0 then
		f.Qi = math.max(0, f.Qi - Settings.Qi.DecayRate * dt)
	end

	if now >= f.TraumaAt + Settings.Injury.RecoveryDelay then
		local changed = false
		for _, region in REGIONS do
			local value = f.Trauma[region]
			if value > 0 then
				local group = Settings.Injury.Group[region]
				local floor = Schema.recoveryFloor(region, value)
				local nextValue = math.max(floor, value - Settings.Injury.RecoveryPerSecond[group] * dt)
				if nextValue ~= value then
					f.Trauma[region] = nextValue
					local tier: InjuryTier = Schema.tierFromCoefficient(region, nextValue)
					if tier ~= f.Injuries[region] then
						f.Injuries[region] = tier
						changed = true
					end
				end
			end
		end
		if changed then
			refreshPenalties(f)
		end
	end
end

-- Advances timers, state expiry and passive regeneration by one tick ending at `now`.
function Rules.step(f: Fighter, now: number, dt: number, events: { Event }?)
	for _ = 1, 4 do
		if now < f.StateEnd then
			break
		end
		local before = f.State
		expire(f, now, events)
		if f.State == before and f.StateEnd == NEVER then
			break
		end
	end
	-- Elixir resolves at the end of the drink unless the drink was interrupted.
	if f.PendingHeal > 0 and now >= f.PendingHealAt then
		if f.State == "Recovery" and f.Move == nil then
			Rules.heal(f, f.PendingHeal)
		end
		f.PendingHeal = 0
		f.PendingHealAt = NEVER
	elseif f.PendingHeal > 0 and (f.State ~= "Recovery" or f.Move ~= nil) then
		f.PendingHeal = 0
		f.PendingHealAt = NEVER
	end
	-- An action that spent the last stamina leaves the fighter winded once it resolves.
	if f.State == "Idle" and f.Stamina <= Settings.Stamina.BreakThreshold then
		staminaBreak(f, now, events, f.Id)
	end
	regenerate(f, now, dt)
end

-------------------------------------------------------------------------------------------------
-- Intents
-------------------------------------------------------------------------------------------------

function Rules.selectMove(f: Fighter, kind: MoveKind, now: number): MoveData
	local weapon = weaponOf(f)
	if kind == "Light" then
		local current = f.Move
		if current ~= nil and current.Kind == "Light" and Rules.comboWindowOpen(f, now) then
			return Weapons.nextLight(weapon, current)
		end
		return weapon.Light[1]
	end
	return Weapons.moveForKind(weapon, kind, nil)
end

function Rules.tryAttack(f: Fighter, kind: MoveKind, now: number): (boolean, string)
	local move = Rules.selectMove(f, kind, now)
	local ctx = Rules.context(f, now, { StaminaCost = move.StaminaCost, QiCost = if move.QiCost > 0 then move.QiCost else nil })
	local ok, reason = Schema.canAct(f.State, kind, f.Stamina, f.Posture, ctx)
	if not ok then
		return false, reason
	end
	Rules.spendStamina(f, Rules.attackStaminaCost(f, move), now)
	if move.QiCost > 0 then
		f.Qi = math.max(0, f.Qi - move.QiCost)
	end
	if kind ~= "RunningAttack" then
		f.Sprinting = false
	end
	table.clear(f.HitRegistry)
	f.Move = move
	f.MoveStart = now
	f.State = "Startup"
	f.StateStart = now
	f.StateEnd = now + move.Timing.StartupSeconds
	return true, move.Id
end

-- 5b. Feint: a Heavy or Weapon Art may be abandoned inside the feint window for a flat stamina cost.
function Rules.tryFeint(f: Fighter, now: number, events: { Event }?): (boolean, string)
	local move = f.Move
	if f.State ~= "Startup" or move == nil then
		return false, "NotInStartup"
	end
	if not Settings.Feint.Kinds[move.Kind] then
		return false, "NotFeintable"
	end
	if now - f.MoveStart > Settings.Feint.Window + Tempo.HalfTick then
		return false, "FeintWindowClosed"
	end
	local cost = Settings.Stamina.Costs.Feint
	if f.Stamina < cost then
		return false, Schema.Reasons.InsufficientStamina
	end
	Rules.spendStamina(f, cost, now)
	clearMove(f)
	enter(f, "Idle", now)
	emit(f, events, "Feint", f.Id, f.Id, cost)
	return true, "Feint"
end

function Rules.tryDeflect(f: Fighter, now: number, pressTime: number?): (boolean, string)
	local ok, reason = Schema.canAct(f.State, "Deflect", f.Stamina, f.Posture, Rules.context(f, now))
	if not ok then
		return false, reason
	end
	local posture = Settings.Posture
	local pressed = math.min(pressTime or now, now)
	if pressed - f.LastDeflectPress <= posture.DeflectSpamLockout then
		f.DeflectChain += 1
	else
		f.DeflectChain = 0
	end
	f.LastDeflectPress = pressed
	local base = Schema.headDeflectWindow(f.Injuries.Head)
	f.DeflectWindow = math.max(posture.DeflectChainFloor, base * (1 - posture.DeflectSpamDecay) ^ f.DeflectChain)
	f.DeflectPressedAt = pressed
	clearMove(f)
	f.Sprinting = false
	f.State = "Deflecting"
	f.StateStart = pressed
	f.StateEnd = math.max(now + Tempo.TickSeconds, pressed + f.DeflectWindow + posture.DeflectRecovery)
	return true, "Deflect"
end

function Rules.setGuard(f: Fighter, held: boolean, now: number): (boolean, string)
	f.GuardHeld = held
	if held then
		if f.State == "Blocking" then
			return true, "Blocking"
		end
		if f.State ~= "Idle" and f.State ~= "Recovery" then
			return false, Schema.Reasons.NotInWindow
		end
		local ok, reason = Schema.canAct(f.State, "Block", f.Stamina, f.Posture, Rules.context(f, now))
		if not ok then
			return false, reason
		end
		clearMove(f)
		f.Sprinting = false
		enter(f, "Blocking", now)
		return true, "Blocking"
	end
	if f.State == "Blocking" then
		enter(f, "Idle", now)
	end
	return true, "Released"
end

function Rules.setSprint(f: Fighter, on: boolean, now: number): boolean
	if not on then
		f.Sprinting = false
		return true
	end
	local ok = Schema.canAct(f.State, "Sprint", f.Stamina, f.Posture, Rules.context(f, now))
	f.Sprinting = ok
	return ok
end

-- 6. Evasion with backdash decay: rapid Roll/Dash spam shortens distance and i-frames.
function Rules.tryDash(f: Fighter, kind: "Roll" | "Dash", now: number, dirX: number, dirZ: number, events: { Event }?): (DashGrant?, string)
	local ok, reason = Schema.canAct(f.State, kind, f.Stamina, f.Posture, Rules.context(f, now))
	if not ok then
		return nil, reason
	end
	local decay = Settings.Backdash
	local movement = Settings.Movement
	if now - f.LastDashAt <= decay.SpamWindow then
		f.DashChain += 1
	else
		f.DashChain = 0
	end
	f.LastDashAt = now
	local distanceScale = math.max(decay.MinDistanceScale, 1 - decay.DecayPerUse * f.DashChain)
	local iframeScale = math.max(decay.MinIFrameScale, 1 - decay.IFrameDecayPerUse * f.DashChain)
	local roll = kind == "Roll"
	local baseDistance = if roll then movement.RollDistance else movement.DashDistance
	local duration = if roll then movement.RollDuration else movement.DashDuration
	local window = if roll then movement.RollInvulnerable else movement.DashInvulnerable
	Rules.spendStamina(f, Schema.staminaCost(kind, nil), now)
	clearMove(f)
	f.Sprinting = false
	local magnitude = math.sqrt(dirX * dirX + dirZ * dirZ)
	f.DashDirX = if magnitude > 1e-6 then dirX / magnitude else 0
	f.DashDirZ = if magnitude > 1e-6 then dirZ / magnitude else 0
	f.DashDistance = baseDistance * distanceScale * f.Penalties.DashDistanceMultiplier
	f.DashDuration = duration
	f.IFrameStart = now + window.Start
	f.IFrameEnd = now + window.Start + (window.Finish - window.Start) * iframeScale
	if iframeScale <= 0 then
		f.IFrameEnd = f.IFrameStart - 1
	end
	f.DashSeq = (f.DashSeq + 1) % 256
	enter(f, "Dashing", now, duration)
	emit(f, events, "Dash", f.Id, f.Id, f.DashDistance)
	return { Distance = f.DashDistance, Duration = duration, IFrameStart = f.IFrameStart, IFrameEnd = f.IFrameEnd, Seq = f.DashSeq }, kind
end

function Rules.tryEquip(f: Fighter, weapon: WeaponType, now: number): (boolean, string)
	if Weapons.Weapons[weapon] == nil then
		return false, "UnknownWeapon"
	end
	local ok, reason = Schema.canAct(f.State, "Equip", f.Stamina, f.Posture, Rules.context(f, now))
	if not ok then
		return false, reason
	end
	f.Weapon = weapon
	clearMove(f)
	refreshPenalties(f)
	return true, weapon
end

function Rules.tryRest(f: Fighter, now: number, atShrine: boolean, events: { Event }?): (boolean, string)
	if f.State == "RestingAtShrine" then
		enter(f, "Idle", now)
		return true, "Rose"
	end
	local ok, reason = Schema.canAct(f.State, "RestAtShrine", f.Stamina, f.Posture, Rules.context(f, now, { AtShrine = atShrine }))
	if not ok then
		return false, reason
	end
	Rules.restore(f, now, false)
	enter(f, "RestingAtShrine", now, Settings.Health.Shrine.RestDuration)
	emit(f, events, "Rest", f.Id, f.Id, 0)
	return true, "Rest"
end

-- Elixir drink: a short interruptible Recovery; the heal lands when the drink completes.
function Rules.tryHeal(f: Fighter, now: number, fraction: number?, duration: number?): (boolean, string)
	local ok, reason = Schema.canAct(f.State, "Heal", f.Stamina, f.Posture, Rules.context(f, now, { HasHealCharge = true }))
	if not ok then
		return false, reason
	end
	local elixir = Settings.Elixir
	local drink = duration or elixir.DrinkDuration
	clearMove(f)
	f.Sprinting = false
	enter(f, "Recovery", now, drink)
	f.PendingHeal = f.MaxHP * (fraction or elixir.HealFraction)
	f.PendingHealAt = now + drink - Tempo.HalfTick
	return true, "Heal"
end

-- Cinematic lock (boss metamorphosis, scripted beats): cannot act or be struck for `duration`.
function Rules.cinematic(f: Fighter, now: number, duration: number)
	clearMove(f)
	f.Sprinting = false
	f.GuardHeld = false
	enter(f, "Recovery", now, duration)
	f.InvulnerableUntil = now + duration
end

-- Swaps weapon outside the Equip eligibility rules (phase transitions, scripted loadouts).
function Rules.forceWeapon(f: Fighter, weapon: WeaponType)
	assert(Weapons.Weapons[weapon] ~= nil, "Unknown weapon")
	f.Weapon = weapon
	clearMove(f)
	refreshPenalties(f)
end

-- Area strike (shockwaves, hazards). I-frames evade; a timed deflect or guard absorbs unless unblockable.
function Rules.applyArea(source: Fighter, target: Fighter, now: number, damage: number, posture: number, unblockable: boolean, facing: boolean, events: { Event }?): HitOutcome
	if target.State == "KO" or target.Id == source.Id then
		return "Ignored"
	end
	if Rules.isInvulnerable(target, now) then
		return "Whiff"
	end
	if not unblockable and facing and Rules.isDeflectTimed(target, now) then
		Rules.addPosture(target, posture * Settings.Posture.DeflectSelfScale, now, events, source.Id, true)
		emit(target, events, "DeflectSpark", target.Id, source.Id, 0)
		return "Deflected"
	end
	if not unblockable and facing and (target.State == "Blocking" or target.State == "Blockstun") then
		local depleted = Rules.spendStamina(target, Settings.Stamina.Costs.Block, now)
		Rules.applyDamage(target, damage * 0.2, "Chip", now)
		if Rules.addPosture(target, posture, now, events, source.Id) then
			return "Blocked"
		end
		if depleted then
			clearMove(target)
			enter(target, "GuardBroken", now, Settings.Stun.GuardBroken)
			emit(target, events, "GuardBreak", source.Id, target.Id, posture)
			return "GuardBroken"
		end
		enter(target, "Blockstun", now, Settings.Stun.Blockstun)
		emit(target, events, "Block", source.Id, target.Id, damage * 0.2)
		return "Blocked"
	end
	local dealt = Rules.applyDamage(target, damage, "WeaponArt", now)
	emit(target, events, "Hit", source.Id, target.Id, dealt, "Torso")
	if target.ActiveHP <= 0 then
		clearMove(target)
		enter(target, "KO", now)
		emit(target, events, "KO", source.Id, target.Id, dealt)
		return "KO"
	end
	if Rules.addPosture(target, posture * (1 - target.PoiseArmor * Settings.Poise.PostureReduction), now, events, source.Id) then
		return "Hit"
	end
	if target.PoiseArmor < Settings.Poise.HeavyThreshold then
		clearMove(target)
		target.Sprinting = false
		enter(target, "Hitstun", now, Settings.Stun.HitstunHeavy)
	end
	return "Hit"
end

-------------------------------------------------------------------------------------------------
-- 3. StanceBreak & Deathblow
-------------------------------------------------------------------------------------------------

function Rules.canDeathblow(attacker: Fighter, victim: Fighter, distance: number, facingDot: number, now: number): (boolean, string)
	if victim.State ~= "StanceBroken" then
		return false, Schema.Reasons.NoDeathblowTarget
	end
	local deathblow = Settings.Deathblow
	if distance > deathblow.Range or facingDot < deathblow.FacingDot then
		return false, Schema.Reasons.NoDeathblowTarget
	end
	return Schema.canAct(attacker.State, "Deathblow", attacker.Stamina, attacker.Posture, Rules.context(attacker, now, { TargetDeathblowable = true }))
end

function Rules.executeDeathblow(attacker: Fighter, victim: Fighter, now: number, events: { Event }?): number
	local deathblow = Settings.Deathblow
	clearMove(attacker)
	clearMove(victim)
	attacker.Sprinting = false
	victim.Sprinting = false
	enter(attacker, "DeathblowAttacker", now, Settings.Stun.DeathblowAttacker)
	enter(victim, "DeathblowVictim", now, Settings.Stun.DeathblowVictim)
	attacker.DeathblowPartner = victim.Id
	victim.DeathblowPartner = attacker.Id
	local damage = math.max(deathblow.MinimumDamage, victim.MaxHP * deathblow.DamageFraction)
	local dealt = Rules.applyDamage(victim, damage, "Deathblow", now)
	if deathblow.ClearsPosture then
		victim.Posture = 0
		attacker.Posture = 0
	end
	victim.PendingKO = victim.ActiveHP <= 0
	attacker.Qi = math.min(Settings.Qi.Max, attacker.Qi + Settings.Qi.GainOnDeathblow)
	attacker.DashChain = 0
	Rules.rally(attacker, dealt, now, events, victim.Id)
	emit(attacker, events, "Deathblow", attacker.Id, victim.Id, dealt)
	emit(victim, nil, "Deathblow", attacker.Id, victim.Id, dealt)
	return dealt
end

-------------------------------------------------------------------------------------------------
-- 2 + 4 + 5. Hit resolution: deflect -> block -> counter-hit -> damage, rally, posture, bleed, trauma
-------------------------------------------------------------------------------------------------

function Rules.isDeflectTimed(defender: Fighter, hitTime: number): boolean
	if defender.State ~= "Deflecting" then
		return false
	end
	local delta = hitTime - defender.DeflectPressedAt
	return delta >= -Tempo.HalfTick and delta <= defender.DeflectWindow + Tempo.HalfTick
end

local function hitstunFor(move: MoveData): number
	return if move.Kind == "Light" then Settings.Stun.HitstunLight else Settings.Stun.HitstunHeavy
end

function Rules.resolveHit(attacker: Fighter, defender: Fighter, now: number, hit: HitContext, events: { Event }?): HitOutcome
	local move = attacker.Move
	if attacker.State ~= "Active" or move == nil or attacker.HitRegistry[defender.Id] or defender.Id == attacker.Id then
		return "Ignored"
	end
	if defender.State == "KO" then
		return "Ignored"
	end
	attacker.HitRegistry[defender.Id] = true
	if Rules.isInvulnerable(defender, now) then
		return "Whiff"
	end

	local attackerWeapon = weaponOf(attacker)
	local defenderWeapon = weaponOf(defender)

	-- 2. Perfect deflect: negate damage, heavy posture onto the attacker, spark.
	if hit.Facing and move.Deflectable and Rules.isDeflectTimed(defender, now) then
		local outcome = Weapons.deflectOutcome(move, attackerWeapon, defenderWeapon)
		local reflected = math.max(outcome.AttackerPosture, Settings.Posture.DeflectMinimumReflect)
		Rules.addPosture(defender, outcome.DefenderPosture, now, events, attacker.Id, true)
		defender.Qi = math.min(Settings.Qi.Max, defender.Qi + Settings.Qi.GainOnDeflect)
		defender.DeflectChain = 0
		defender.LastDeflectPress = -NEVER
		if now <= defender.RallyUntil and defender.RecoverableHP > 0 then
			local restored = math.min(defender.RecoverableHP, Settings.Health.Rally.DeflectBonus)
			defender.RecoverableHP -= restored
			defender.ActiveHP += restored
			clampLayers(defender)
			emit(defender, events, "Rally", defender.Id, attacker.Id, restored)
		end
		emit(defender, events, "DeflectSpark", defender.Id, attacker.Id, reflected)
		if not Rules.addPosture(attacker, reflected, now, events, defender.Id) then
			clearMove(attacker)
			enter(attacker, "Blockstun", now, Settings.Stun.DeflectRecoil)
		end
		return "Deflected"
	end

	-- Guard (held block, blockstun, or a mistimed deflect).
	local guarding = hit.Facing and (defender.State == "Blocking" or defender.State == "Blockstun" or defender.State == "Deflecting")
	local guardShattered = false
	if guarding and not move.Unblockable then
		local outcome = Weapons.blockOutcome(move, attackerWeapon, defenderWeapon, defender.Stamina)
		local cost = if defender.State == "Deflecting" then Settings.Stamina.Costs.DeflectMiss else outcome.DefenderStamina
		local depleted = Rules.spendStamina(defender, cost, now)
		local chip = Rules.applyDamage(defender, outcome.DefenderChip, "Chip", now)
		Rules.rally(attacker, chip, now, events, defender.Id)
		attacker.Qi = math.min(Settings.Qi.Max, attacker.Qi + Settings.Qi.GainOnHit * 0.5)
		if defender.ActiveHP <= 0 then
			clearMove(defender)
			enter(defender, "KO", now)
			emit(defender, events, "KO", attacker.Id, defender.Id, chip)
			return "KO"
		end
		if Rules.addPosture(defender, outcome.DefenderPosture, now, events, attacker.Id) then
			return "Blocked"
		end
		if depleted or outcome.GuardBreak then
			clearMove(defender)
			defender.Stamina = math.max(defender.Stamina, 0)
			enter(defender, "GuardBroken", now, Settings.Stun.GuardBroken)
			emit(defender, events, "GuardBreak", attacker.Id, defender.Id, outcome.DefenderPosture)
			return "GuardBroken"
		end
		enter(defender, "Blockstun", now, Settings.Stun.Blockstun)
		emit(defender, events, "Block", attacker.Id, defender.Id, chip)
		return "Blocked"
	elseif guarding and move.Unblockable then
		-- Perilous strike through a guard: shatter it, then resolve as a clean hit.
		local outcome = Weapons.blockOutcome(move, attackerWeapon, defenderWeapon, defender.Stamina)
		Rules.spendStamina(defender, outcome.DefenderStamina, now)
		Rules.addPosture(defender, outcome.DefenderPosture, now, events, attacker.Id)
		guardShattered = true
		emit(defender, events, "GuardBreak", attacker.Id, defender.Id, outcome.DefenderPosture)
	end

	-- 5a. Counter-hit: struck during Startup cancels the move for bonus damage.
	local defenderMove = defender.Move
	local poise = Settings.Poise
	local poiseThreshold = if move.Kind == "Light" then poise.LightThreshold else poise.HeavyThreshold
	local armored = (defenderMove ~= nil and defenderMove.HyperArmor and (defender.State == "Startup" or defender.State == "Active"))
		or defender.PoiseArmor >= poiseThreshold
	local counter = defender.State == "Startup" and not armored
	local counterScale = Settings.Counter
	local damage = Schema.damage(move.BaseDamage, Rules.armTier(attacker)) * Rules.damageScale(attacker, move) * (if counter then counterScale.HitMultiplier else 1)
	local category: DamageCategory = move.Kind
	local dealt = Rules.applyDamage(defender, damage, category, now)
	Rules.rally(attacker, dealt, now, events, defender.Id)
	attacker.Qi = math.min(Settings.Qi.Max, attacker.Qi + Settings.Qi.GainOnHit)
	attacker.DashChain = 0

	-- Bleed accumulation and proc.
	local bleed = Weapons.bleedBuildup(move, attackerWeapon)
	if bleed > 0 then
		defender.Bleed += bleed
		defender.BleedDecayAt = now + Settings.Bleed.DecayDelay
		if defender.Bleed >= Settings.Bleed.Max then
			local burst = Rules.applyDamage(defender, Rules.effectiveMaxHP(defender) * Settings.Bleed.ProcDamageFraction, "Bleed", now)
			dealt += burst
			if Settings.Bleed.ResetOnProc then
				defender.Bleed = 0
			else
				defender.Bleed = Settings.Bleed.Max
			end
			emit(defender, events, "BleedProc", attacker.Id, defender.Id, burst)
		end
	end

	addTrauma(defender, hit.Region, Rules.traumaFor(move, hit.Region), now, events, attacker.Id)

	local kind: EventKind = if counter then "CounterHit" elseif armored then "Armored" else "Hit"
	emit(defender, events, kind, attacker.Id, defender.Id, dealt, hit.Region)

	if defender.ActiveHP <= 0 then
		clearMove(defender)
		enter(defender, "KO", now)
		emit(defender, events, "KO", attacker.Id, defender.Id, dealt)
		return "KO"
	end

	if defender.State == "StanceBroken" then
		-- Already broken (guard shattered into a full posture bar): keep the Deathblow opening.
		return if counter then "CounterHit" else "Hit"
	end

	local posture = Weapons.postureDamage(move, attackerWeapon) * Settings.Posture.HitScale * (if counter then counterScale.PostureMultiplier else 1)
		* (1 - defender.PoiseArmor * poise.PostureReduction)
	if Rules.addPosture(defender, posture, now, events, attacker.Id) then
		return if counter then "CounterHit" else "Hit"
	end

	if guardShattered then
		clearMove(defender)
		enter(defender, "GuardBroken", now, Settings.Stun.GuardBroken)
		return "GuardBroken"
	end
	if armored then
		return "Armored"
	end
	clearMove(defender)
	defender.Sprinting = false
	enter(defender, "Hitstun", now, hitstunFor(move))
	return if counter then "CounterHit" else "Hit"
end

-- Environmental or scripted damage (falls, hazards) through the same layered health.
function Rules.applyExternalDamage(f: Fighter, amount: number, now: number, events: { Event }?): number
	local dealt = Rules.applyDamage(f, amount, "Heavy", now)
	if f.ActiveHP <= 0 and f.State ~= "KO" then
		clearMove(f)
		enter(f, "KO", now)
		emit(f, events, "KO", 0, f.Id, dealt)
	end
	return dealt
end

function Rules.knockOut(f: Fighter, now: number, events: { Event }?)
	if f.State == "KO" then
		return
	end
	f.ActiveHP = 0
	clearMove(f)
	enter(f, "KO", now)
	emit(f, events, "KO", 0, f.Id, 0)
end

-------------------------------------------------------------------------------------------------
-- Replication codec: fixed 58-byte little-endian record, base64-wrapped for string attributes.
-------------------------------------------------------------------------------------------------

export type Snapshot = {
	State: State,
	Weapon: WeaponType,
	Move: string?,
	ComboIndex: number,
	ActiveHP: number,
	RecoverableHP: number,
	PermanentDeficit: number,
	Stamina: number,
	Posture: number,
	Qi: number,
	Bleed: number,
	Injuries: { [InjuryRegion]: InjuryTier },
	StateElapsed: number,
	StateDuration: number,
	Blocking: boolean,
	Sprinting: boolean,
	Invulnerable: boolean,
	Armored: boolean,
	RallyActive: boolean,
	DeathblowLocked: boolean,
	DashSeq: number,
	DashDistance: number,
	DashDuration: number,
	DashDirX: number,
	DashDirZ: number,
	RallyRemaining: number,
	EventSeq: number,
	LastEvent: EventKind?,
	DeathblowPartner: number,
	MaxHP: number,
	MaxStamina: number,
	PostureCapacity: number,
	PoiseArmor: number,
	KOProtected: boolean,
}

Rules.PACKET_SIZE = 58
Rules.PACKET_VERSION = 2
local HP_SCALE = 40

local STATE_INDEX: { [string]: number } = {}
for index, name in Schema.StateList do
	STATE_INDEX[name] = index
end
local WEAPON_INDEX: { [string]: number } = {}
for index, name in Weapons.WeaponTypes do
	WEAPON_INDEX[name] = index
end
local MOVE_LIST: { string } = {}
for _, weapon in Weapons.Weapons do
	for id in weapon.Moves do
		table.insert(MOVE_LIST, id)
	end
end
table.sort(MOVE_LIST)
local MOVE_INDEX: { [string]: number } = {}
for index, id in MOVE_LIST do
	MOVE_INDEX[id] = index
end
local TIER_LIST: { InjuryTier } = { "None", "Impaired", "Injured", "Severe" }

local function u16(value: number, scale: number): number
	return math.clamp(math.floor(value * scale + 0.5), 0, 65535)
end

local function i16(value: number, scale: number): number
	return math.clamp(math.floor(value * scale + 0.5), -32768, 32767)
end

function Rules.pack(f: Fighter, now: number, into: buffer?): buffer
	local b = into or buffer.create(Rules.PACKET_SIZE)
	local move = f.Move
	buffer.writeu8(b, 0, Rules.PACKET_VERSION)
	buffer.writeu8(b, 1, STATE_INDEX[f.State])
	buffer.writeu8(b, 2, WEAPON_INDEX[f.Weapon])
	buffer.writeu8(b, 3, if move then move.ComboIndex else 0)
	buffer.writeu16(b, 4, if move then MOVE_INDEX[move.Id] or 0 else 0)
	buffer.writeu16(b, 6, u16(math.max(f.ActiveHP, 0), HP_SCALE))
	buffer.writeu16(b, 8, u16(f.RecoverableHP, HP_SCALE))
	buffer.writeu16(b, 10, u16(f.PermanentDeficit, HP_SCALE))
	buffer.writeu16(b, 12, u16(math.max(f.Stamina, 0), 100))
	buffer.writeu16(b, 14, u16(f.Posture, 100))
	buffer.writeu16(b, 16, u16(f.Qi, 100))
	buffer.writeu16(b, 18, u16(f.Bleed, 100))
	local injuries = 0
	for index, region in REGIONS do
		injuries += (Schema.tierIndex(f.Injuries[region]) :: number) * 4 ^ (index - 1)
	end
	buffer.writeu16(b, 20, injuries)
	buffer.writeu16(b, 22, u16(math.max(now - f.StateStart, 0), 1000))
	buffer.writeu16(b, 24, if f.StateEnd == NEVER then 0 else u16(math.max(f.StateEnd - f.StateStart, 0), 1000))
	local flags = 0
	if f.State == "Blocking" or f.GuardHeld then
		flags += 1
	end
	if f.Sprinting then
		flags += 2
	end
	if Rules.isInvulnerable(f, now) then
		flags += 4
	end
	if move ~= nil and move.HyperArmor and (f.State == "Startup" or f.State == "Active") then
		flags += 8
	end
	if now <= f.RallyUntil and f.RecoverableHP > 0 then
		flags += 16
	end
	if f.State == "DeathblowAttacker" or f.State == "DeathblowVictim" then
		flags += 32
	end
	buffer.writeu8(b, 26, flags)
	buffer.writeu8(b, 27, f.DashSeq)
	buffer.writeu16(b, 28, u16(f.DashDistance, 100))
	buffer.writei16(b, 30, i16(f.DashDirX, 10000))
	buffer.writei16(b, 32, i16(f.DashDirZ, 10000))
	buffer.writeu16(b, 34, u16(math.max(f.RallyUntil - now, 0), 1000))
	buffer.writeu16(b, 36, f.EventSeq)
	buffer.writeu8(b, 38, f.LastEvent)
	buffer.writeu8(b, 39, 0)
	buffer.writeu16(b, 40, u16(f.DashDuration, 1000))
	buffer.writef64(b, 42, f.DeathblowPartner)
	buffer.writeu16(b, 50, u16(f.MaxHP, HP_SCALE))
	buffer.writeu16(b, 52, u16(f.MaxStamina, 100))
	buffer.writeu16(b, 54, u16(f.PostureCapacity, 100))
	buffer.writeu8(b, 56, math.clamp(math.floor(f.PoiseArmor * 255 + 0.5), 0, 255))
	buffer.writeu8(b, 57, if f.KOProtected then 1 else 0)
	return b
end

function Rules.unpack(b: buffer): Snapshot?
	if buffer.len(b) < Rules.PACKET_SIZE or buffer.readu8(b, 0) ~= Rules.PACKET_VERSION then
		return nil
	end
	local state = Schema.StateList[buffer.readu8(b, 1)]
	local weapon = Weapons.WeaponTypes[buffer.readu8(b, 2)]
	if state == nil or weapon == nil then
		return nil
	end
	local moveIndex = buffer.readu16(b, 4)
	local packed = buffer.readu16(b, 20)
	local injuries: { [InjuryRegion]: InjuryTier } = {}
	for index, region in REGIONS do
		injuries[region] = TIER_LIST[(packed // 4 ^ (index - 1)) % 4 + 1]
	end
	local flags = buffer.readu8(b, 26)
	local function flag(bit: number): boolean
		return (flags // bit) % 2 == 1
	end
	local duration = buffer.readu16(b, 24)
	local eventCode = buffer.readu8(b, 38)
	return {
		State = state,
		Weapon = weapon,
		Move = if moveIndex > 0 then MOVE_LIST[moveIndex] else nil,
		ComboIndex = buffer.readu8(b, 3),
		ActiveHP = buffer.readu16(b, 6) / HP_SCALE,
		RecoverableHP = buffer.readu16(b, 8) / HP_SCALE,
		PermanentDeficit = buffer.readu16(b, 10) / HP_SCALE,
		Stamina = buffer.readu16(b, 12) / 100,
		Posture = buffer.readu16(b, 14) / 100,
		Qi = buffer.readu16(b, 16) / 100,
		Bleed = buffer.readu16(b, 18) / 100,
		Injuries = injuries,
		StateElapsed = buffer.readu16(b, 22) / 1000,
		StateDuration = if duration == 0 then math.huge else duration / 1000,
		Blocking = flag(1),
		Sprinting = flag(2),
		Invulnerable = flag(4),
		Armored = flag(8),
		RallyActive = flag(16),
		DeathblowLocked = flag(32),
		DashSeq = buffer.readu8(b, 27),
		DashDistance = buffer.readu16(b, 28) / 100,
		DashDirX = buffer.readi16(b, 30) / 10000,
		DashDirZ = buffer.readi16(b, 32) / 10000,
		RallyRemaining = buffer.readu16(b, 34) / 1000,
		EventSeq = buffer.readu16(b, 36),
		LastEvent = EVENT_NAMES[eventCode],
		DashDuration = buffer.readu16(b, 40) / 1000,
		DeathblowPartner = buffer.readf64(b, 42),
		MaxHP = buffer.readu16(b, 50) / HP_SCALE,
		MaxStamina = buffer.readu16(b, 52) / 100,
		PostureCapacity = buffer.readu16(b, 54) / 100,
		PoiseArmor = buffer.readu8(b, 56) / 255,
		KOProtected = buffer.readu8(b, 57) == 1,
	}
end

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local ENCODE: { number } = {}
local DECODE: { [number]: number } = {}
for index = 1, 64 do
	local byte = string.byte(ALPHABET, index)
	ENCODE[index - 1] = byte
	DECODE[byte] = index - 1
end
local PAD = string.byte("=")

-- Attributes cannot hold buffers; base64 keeps the packed record replication-safe as a string.
function Rules.encode(b: buffer): string
	local length = buffer.len(b)
	local out = buffer.create(((length + 2) // 3) * 4)
	local o = 0
	for i = 0, length - 1, 3 do
		local remain = length - i
		local b0 = buffer.readu8(b, i)
		local b1 = if remain > 1 then buffer.readu8(b, i + 1) else 0
		local b2 = if remain > 2 then buffer.readu8(b, i + 2) else 0
		local n = b0 * 65536 + b1 * 256 + b2
		buffer.writeu8(out, o, ENCODE[n // 262144])
		buffer.writeu8(out, o + 1, ENCODE[(n // 4096) % 64])
		buffer.writeu8(out, o + 2, if remain > 1 then ENCODE[(n // 64) % 64] else PAD)
		buffer.writeu8(out, o + 3, if remain > 2 then ENCODE[n % 64] else PAD)
		o += 4
	end
	return buffer.tostring(out)
end

function Rules.decode(text: string): buffer?
	local length = #text
	if length == 0 or length % 4 ~= 0 then
		return nil
	end
	local padding = (if string.byte(text, length) == PAD then 1 else 0) + (if string.byte(text, length - 1) == PAD then 1 else 0)
	local out = buffer.create(length // 4 * 3 - padding)
	local o = 0
	for i = 1, length, 4 do
		local values = 0
		for k = 0, 3 do
			local byte = string.byte(text, i + k)
			local value = if byte == PAD then 0 else DECODE[byte]
			if value == nil then
				return nil
			end
			values = values * 64 + value
		end
		local bytes = { values // 65536, (values // 256) % 256, values % 256 }
		for k = 1, 3 do
			if o < buffer.len(out) then
				buffer.writeu8(out, o, bytes[k])
				o += 1
			end
		end
	end
	return out
end

function Rules.packString(f: Fighter, now: number, scratch: buffer?): string
	return Rules.encode(Rules.pack(f, now, scratch))
end

function Rules.unpackString(text: string): Snapshot?
	local b = Rules.decode(text)
	if b == nil then
		return nil
	end
	return Rules.unpack(b)
end

return table.freeze(Rules)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">InputBuffer</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Simulation/InputBuffer
-- Fixed-capacity circular input buffer. Slots are allocated once; pushes overwrite in place.
-- Consuming a buffered input never bypasses MoveSchema.canAct at the moment it is executed.
local hasScript = pcall(function()
	return script.Parent
end)
local Settings: any
if hasScript then
	Settings = require(script.Parent.Parent.Shared.CombatSettings)
else
	Settings = require("../shared/CombatSettings")
end

export type BufferedAction =
	"Light"
	| "Heavy"
	| "RunningAttack"
	| "WeaponArt"
	| "Roll"
	| "Dash"
	| "Deflect"
	| "Block"
	| "Heal"
	| "Equip"

export type Slot = {
	Live: boolean,
	Action: BufferedAction,
	Priority: number,
	Time: number,
	Sequence: number,
	Variant: string,
	DirX: number,
	DirZ: number,
}

export type Buffer = {
	Slots: { Slot },
	Capacity: number,
	Window: number,
	Head: number,
	Count: number,
	Sequence: number,
}

export type Filter = (action: BufferedAction, variant: string) -> boolean

local InputBuffer = {}

local PRIORITY: { [string]: number } = Settings.Input.Priority
local DEFAULT_WINDOW: number = Settings.Input.BufferWindow
local DEFAULT_CAPACITY: number = Settings.Input.BufferCapacity
local DUPLICATE_WINDOW: number = Settings.Input.DuplicateWindow

function InputBuffer.priority(action: BufferedAction): number
	local value = PRIORITY[action]
	assert(value ~= nil, "Unbuffered action " .. tostring(action))
	return value
end

function InputBuffer.new(capacity: number?, window: number?): Buffer
	local size = capacity or DEFAULT_CAPACITY
	assert(size % 1 == 0 and size >= 1 and size <= 64, "InputBuffer capacity must be an integer in 1..64")
	local lifetime = window or DEFAULT_WINDOW
	assert(lifetime == lifetime and lifetime > 0 and lifetime <= 1, "InputBuffer window must be in (0, 1]")
	local slots: { Slot } = table.create(size) :: any
	for index = 1, size do
		slots[index] = {
			Live = false,
			Action = "Light",
			Priority = 0,
			Time = 0,
			Sequence = 0,
			Variant = "",
			DirX = 0,
			DirZ = 0,
		}
	end
	return {
		Slots = slots,
		Capacity = size,
		Window = lifetime,
		Head = 1,
		Count = 0,
		Sequence = 0,
	}
end

local function slotIndex(buffer: Buffer, offset: number): number
	return (buffer.Head - 1 + offset) % buffer.Capacity + 1
end

-- Advances Head past consumed or expired slots so Count always spans live-or-pending entries.
local function compact(buffer: Buffer)
	while buffer.Count > 0 and not buffer.Slots[buffer.Head].Live do
		buffer.Head = buffer.Head % buffer.Capacity + 1
		buffer.Count -= 1
	end
	if buffer.Count == 0 then
		buffer.Head = 1
	end
end

function InputBuffer.flush(buffer: Buffer, now: number): number
	local removed = 0
	for offset = 0, buffer.Count - 1 do
		local slot = buffer.Slots[slotIndex(buffer, offset)]
		if slot.Live and now - slot.Time > buffer.Window then
			slot.Live = false
			removed += 1
		end
	end
	compact(buffer)
	return removed
end

function InputBuffer.clear(buffer: Buffer)
	for _, slot in buffer.Slots do
		slot.Live = false
	end
	buffer.Head = 1
	buffer.Count = 0
end

-- Removes every live entry for an action (e.g. a released Block or a cancelled Heal).
function InputBuffer.discard(buffer: Buffer, action: BufferedAction): number
	local removed = 0
	for offset = 0, buffer.Count - 1 do
		local slot = buffer.Slots[slotIndex(buffer, offset)]
		if slot.Live and slot.Action == action then
			slot.Live = false
			removed += 1
		end
	end
	compact(buffer)
	return removed
end

function InputBuffer.push(buffer: Buffer, action: BufferedAction, now: number, variant: string?, dirX: number?, dirZ: number?): boolean
	assert(now == now, "InputBuffer.push requires a timestamp")
	local priority = InputBuffer.priority(action)
	local tag = variant or ""
	InputBuffer.flush(buffer, now)

	-- Repeated presses inside the duplicate window refresh the existing entry instead of stacking.
	for offset = buffer.Count - 1, 0, -1 do
		local slot = buffer.Slots[slotIndex(buffer, offset)]
		if slot.Live and slot.Action == action and slot.Variant == tag and now - slot.Time <= DUPLICATE_WINDOW then
			slot.Time = now
			slot.DirX = dirX or slot.DirX
			slot.DirZ = dirZ or slot.DirZ
			return false
		end
	end

	if buffer.Count == buffer.Capacity then
		-- Full: evict the oldest entry by advancing Head.
		buffer.Slots[buffer.Head].Live = false
		buffer.Head = buffer.Head % buffer.Capacity + 1
		buffer.Count -= 1
	end

	buffer.Sequence += 1
	local slot = buffer.Slots[slotIndex(buffer, buffer.Count)]
	slot.Live = true
	slot.Action = action
	slot.Priority = priority
	slot.Time = now
	slot.Sequence = buffer.Sequence
	slot.Variant = tag
	slot.DirX = dirX or 0
	slot.DirZ = dirZ or 0
	buffer.Count += 1
	return true
end

-- Highest priority wins; equal priority resolves to the earliest press so input order is respected.
local function choose(buffer: Buffer, now: number, filter: Filter?): Slot?
	InputBuffer.flush(buffer, now)
	local best: Slot? = nil
	for offset = 0, buffer.Count - 1 do
		local slot = buffer.Slots[slotIndex(buffer, offset)]
		if slot.Live and (filter == nil or filter(slot.Action, slot.Variant)) then
			local current = best
			if current == nil or slot.Priority > current.Priority or (slot.Priority == current.Priority and slot.Sequence < current.Sequence) then
				best = slot
			end
		end
	end
	return best
end

function InputBuffer.peek(buffer: Buffer, now: number, filter: Filter?): (BufferedAction?, number?, string?)
	local slot = choose(buffer, now, filter)
	if slot == nil then
		return nil, nil, nil
	end
	return slot.Action, slot.Time, slot.Variant
end

-- Returns (action, pressTime, variant, dirX, dirZ) without allocating; nil when nothing eligible.
function InputBuffer.pop(buffer: Buffer, now: number, filter: Filter?): (BufferedAction?, number?, string?, number?, number?)
	local slot = choose(buffer, now, filter)
	if slot == nil then
		return nil, nil, nil, nil, nil
	end
	slot.Live = false
	local action, time, variant, dirX, dirZ = slot.Action, slot.Time, slot.Variant, slot.DirX, slot.DirZ
	compact(buffer)
	return action, time, variant, dirX, dirZ
end

function InputBuffer.count(buffer: Buffer, now: number?): number
	if now ~= nil then
		InputBuffer.flush(buffer, now)
	end
	local live = 0
	for offset = 0, buffer.Count - 1 do
		if buffer.Slots[slotIndex(buffer, offset)].Live then
			live += 1
		end
	end
	return live
end

function InputBuffer.has(buffer: Buffer, action: BufferedAction, now: number): boolean
	InputBuffer.flush(buffer, now)
	for offset = 0, buffer.Count - 1 do
		local slot = buffer.Slots[slotIndex(buffer, offset)]
		if slot.Live and slot.Action == action then
			return true
		end
	end
	return false
end

return table.freeze(InputBuffer)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">MatchmakingRules</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Simulation/MatchmakingRules
-- Pure mathematical simulation module: ELO rating calculations, bracket expansion, and multi-cage allocation.

export type QueueEntry = {
	userId: number,
	elo: number,
	enteredAt: number,
	mode: string, -- "Ranked1v1" | "Casual1v1"
}

export type CageState = {
	id: number,
	name: string,
	status: string, -- "Available" | "Occupied" | "Decided"
	fighter1: number?,
	fighter2: number?,
	startedAt: number,
}

local MatchmakingRules = {}

local BASE_SEARCH_WINDOW = 50
local WINDOW_EXPANSION_PER_SEC = 5 -- Expands by 5 ELO per second (50 ELO per 10s)
local MAX_SEARCH_WINDOW = 400

function MatchmakingRules.CalculateExpectedScore(ratingA: number, ratingB: number): number
	return 1 / (1 + 10 ^ ((ratingB - ratingA) / 400))
end

function MatchmakingRules.CalculateEloChange(ratingA: number, ratingB: number, scoreA: number): (number, number)
	local expectedA = MatchmakingRules.CalculateExpectedScore(ratingA, ratingB)
	local expectedB = 1 - expectedA

	local kA = if ratingA < 1600 then 32 else 16
	local kB = if ratingB < 1600 then 32 else 16

	local scoreB = 1 - scoreA
	local deltaA = math.round(kA * (scoreA - expectedA))
	local deltaB = math.round(kB * (scoreB - expectedB))

	local newA = math.max(100, ratingA + deltaA)
	local newB = math.max(100, ratingB + deltaB)

	return newA, newB
end

function MatchmakingRules.GetDivision(elo: number): (string, {number})
	if elo >= 1600 then
		return "Black Belt (Undisputed Champion)", { 245, 195, 60 }
	elseif elo >= 1400 then
		return "Brown Belt (Master Contender)", { 180, 115, 65 }
	elseif elo >= 1200 then
		return "Purple Belt (Elite Fighter)", { 165, 75, 230 }
	elseif elo >= 1000 then
		return "Blue Belt (Championship Prospect)", { 50, 140, 240 }
	else
		return "White Belt (Debutant)", { 220, 225, 235 }
	end
end

function MatchmakingRules.FindMatch(queue: {QueueEntry}, now: number): (number?, number?)
	if #queue < 2 then
		return nil, nil
	end

	for i = 1, #queue - 1 do
		local a = queue[i]
		local waitA = math.max(0, now - a.enteredAt)
		local windowA = math.min(MAX_SEARCH_WINDOW, BASE_SEARCH_WINDOW + waitA * WINDOW_EXPANSION_PER_SEC)

		for j = i + 1, #queue do
			local b = queue[j]
			if a.mode == b.mode then
				local waitB = math.max(0, now - b.enteredAt)
				local windowB = math.min(MAX_SEARCH_WINDOW, BASE_SEARCH_WINDOW + waitB * WINDOW_EXPANSION_PER_SEC)
				local activeWindow = math.max(windowA, windowB)

				local eloDiff = math.abs(a.elo - b.elo)
				if eloDiff <= activeWindow then
					return i, j
				end
			end
		end
	end

	return nil, nil
end

function MatchmakingRules.CreateVenues(cageCount: number): { [number]: CageState }
	local cages: { [number]: CageState } = {}
	local cageNames = { "Main Championship Octagon", "Sparring Cage B", "Underground Mat C", "Training Pit D" }
	for id = 1, cageCount do
		cages[id] = {
			id = id,
			name = cageNames[id] or ("Octagon " .. id),
			status = "Available",
			fighter1 = nil,
			fighter2 = nil,
			startedAt = 0,
		}
	end
	return cages
end

function MatchmakingRules.AssignCage(cages: { [number]: CageState }, p1: number, p2: number, now: number): number?
	for id, cage in ipairs(cages) do
		if cage.status == "Available" then
			cage.status = "Occupied"
			cage.fighter1 = p1
			cage.fighter2 = p2
			cage.startedAt = now
			return id
		end
	end
	return nil
end

function MatchmakingRules.ReleaseCage(cages: { [number]: CageState }, cageId: number)
	local cage = cages[cageId]
	if cage then
		cage.status = "Available"
		cage.fighter1 = nil
		cage.fighter2 = nil
		cage.startedAt = 0
	end
end

return table.freeze(MatchmakingRules)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">MoveSchema</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Simulation/MoveSchema
-- Pure combat state enumeration, transition graph, action eligibility and injury penalties.
local hasScript = pcall(function()
	return script.Parent
end)
local Settings: any
if hasScript then
	Settings = require(script.Parent.Parent.Shared.CombatSettings)
else
	Settings = require("../shared/CombatSettings")
end

export type State =
	"Idle"
	| "Startup"
	| "Active"
	| "Recovery"
	| "Deflecting"
	| "Blocking"
	| "Blockstun"
	| "Dashing"
	| "Hitstun"
	| "GuardBroken"
	| "StaminaBroken"
	| "StanceBroken"
	| "DeathblowAttacker"
	| "DeathblowVictim"
	| "RestingAtShrine"
	| "KO"

export type Action =
	"Move"
	| "Sprint"
	| "Light"
	| "Heavy"
	| "RunningAttack"
	| "WeaponArt"
	| "Roll"
	| "Dash"
	| "Deflect"
	| "Block"
	| "Deathblow"
	| "Heal"
	| "Equip"
	| "RestAtShrine"

export type InjuryTier = "None" | "Impaired" | "Injured" | "Severe"
export type InjuryRegion = "Head" | "Torso" | "LeftArm" | "RightArm" | "LeftLeg" | "RightLeg"
export type InjuryGroup = "Head" | "Torso" | "Arm" | "Leg"

export type Context = {
	ComboWindowOpen: boolean?,
	CancelWindowOpen: boolean?,
	Sprinting: boolean?,
	DeflectReady: boolean?,
	TargetDeathblowable: boolean?,
	AtShrine: boolean?,
	HasHealCharge: boolean?,
	Qi: number?,
	QiCost: number?,
	ArmTier: InjuryTier?,
	StaminaCost: number?,
}

export type Injuries = { [InjuryRegion]: InjuryTier }

export type Penalties = {
	StaminaCostMultiplier: number,
	DamageMultiplier: number,
	SpeedMultiplier: number,
	DashDistanceMultiplier: number,
	DeflectWindowMultiplier: number,
	PostureDecayMultiplier: number,
	StaminaRegenMultiplier: number,
	MaxPostureMultiplier: number,
	VisionBlur: number,
	EyeVignette: number,
}

local Schema = {}

local STATE_LIST: { State } = {
	"Idle",
	"Startup",
	"Active",
	"Recovery",
	"Deflecting",
	"Blocking",
	"Blockstun",
	"Dashing",
	"Hitstun",
	"GuardBroken",
	"StaminaBroken",
	"StanceBroken",
	"DeathblowAttacker",
	"DeathblowVictim",
	"RestingAtShrine",
	"KO",
}

local ACTION_LIST: { Action } = {
	"Move",
	"Sprint",
	"Light",
	"Heavy",
	"RunningAttack",
	"WeaponArt",
	"Roll",
	"Dash",
	"Deflect",
	"Block",
	"Deathblow",
	"Heal",
	"Equip",
	"RestAtShrine",
}

local function enumerate<T>(list: { T }): { [T]: T }
	local result: { [T]: T } = {}
	for _, value in list do
		result[value] = value
	end
	return table.freeze(result)
end

local function set<T>(list: { T }): { [T]: boolean }
	local result: { [T]: boolean } = {}
	for _, value in list do
		result[value] = true
	end
	return table.freeze(result)
end

Schema.States = enumerate(STATE_LIST)
Schema.Actions = enumerate(ACTION_LIST)
Schema.StateList = table.freeze(table.clone(STATE_LIST))
Schema.ActionList = table.freeze(table.clone(ACTION_LIST))

-- Actions permitted unconditionally in each state.
local ALLOWED: { [State]: { [Action]: boolean } } = {
	Idle = set({ "Move", "Sprint", "Light", "Heavy", "RunningAttack", "WeaponArt", "Roll", "Dash", "Deflect", "Block", "Deathblow", "Heal", "Equip", "RestAtShrine" } :: { Action }),
	Startup = set({} :: { Action }),
	Active = set({} :: { Action }),
	Recovery = set({ "Deflect", "Block" } :: { Action }),
	Deflecting = set({ "Move", "Block", "Deflect", "Light", "Heavy", "Deathblow" } :: { Action }),
	Blocking = set({ "Move", "Block", "Deflect", "Light", "Heavy", "WeaponArt", "Roll", "Dash", "Deathblow" } :: { Action }),
	Blockstun = set({ "Deflect", "Block" } :: { Action }),
	Dashing = set({} :: { Action }),
	Hitstun = set({} :: { Action }),
	GuardBroken = set({} :: { Action }),
	StaminaBroken = set({} :: { Action }),
	StanceBroken = set({} :: { Action }),
	DeathblowAttacker = set({} :: { Action }),
	DeathblowVictim = set({} :: { Action }),
	RestingAtShrine = set({ "Equip", "RestAtShrine" } :: { Action }),
	KO = set({} :: { Action }),
}

-- Actions unlocked by a context window (combo chain or cancel frames).
local COMBO_UNLOCKS: { [State]: { [Action]: boolean } } = {
	Recovery = set({ "Light", "Heavy" } :: { Action }),
}

local CANCEL_UNLOCKS: { [State]: { [Action]: boolean } } = {
	Startup = set({ "Deflect", "Roll", "Dash" } :: { Action }),
	Recovery = set({ "Roll", "Dash", "WeaponArt" } :: { Action }),
	Dashing = set({ "Light", "Heavy", "RunningAttack", "Deflect", "Block" } :: { Action }),
}

local TRANSITIONS: { [State]: { [State]: boolean } } = {
	Idle = set({ "Startup", "Deflecting", "Blocking", "Dashing", "Hitstun", "GuardBroken", "StaminaBroken", "StanceBroken", "DeathblowAttacker", "RestingAtShrine", "KO" } :: { State }),
	Startup = set({ "Active", "Idle", "Deflecting", "Dashing", "Hitstun", "StaminaBroken", "StanceBroken", "KO" } :: { State }),
	Active = set({ "Recovery", "Blockstun", "Hitstun", "StaminaBroken", "StanceBroken", "KO" } :: { State }),
	Recovery = set({ "Idle", "Startup", "Deflecting", "Blocking", "Dashing", "Hitstun", "StaminaBroken", "StanceBroken", "KO" } :: { State }),
	Deflecting = set({ "Idle", "Deflecting", "Blocking", "Startup", "Blockstun", "Hitstun", "StaminaBroken", "StanceBroken", "DeathblowAttacker", "KO" } :: { State }),
	Blocking = set({ "Idle", "Deflecting", "Startup", "Dashing", "Blockstun", "GuardBroken", "Hitstun", "StaminaBroken", "StanceBroken", "DeathblowAttacker", "KO" } :: { State }),
	Blockstun = set({ "Idle", "Blocking", "Deflecting", "GuardBroken", "Hitstun", "StaminaBroken", "StanceBroken", "KO" } :: { State }),
	Dashing = set({ "Idle", "Startup", "Deflecting", "Blocking", "Hitstun", "StaminaBroken", "StanceBroken", "KO" } :: { State }),
	Hitstun = set({ "Idle", "Hitstun", "StaminaBroken", "StanceBroken", "KO" } :: { State }),
	GuardBroken = set({ "Idle", "Hitstun", "StanceBroken", "KO" } :: { State }),
	StaminaBroken = set({ "Idle", "Hitstun", "StanceBroken", "KO" } :: { State }),
	StanceBroken = set({ "Idle", "Hitstun", "DeathblowVictim", "KO" } :: { State }),
	DeathblowAttacker = set({ "Idle" } :: { State }),
	DeathblowVictim = set({ "Idle", "KO" } :: { State }),
	RestingAtShrine = set({ "Idle" } :: { State }),
	KO = set({ "Idle", "RestingAtShrine" } :: { State }),
}

local GUARDING = set({ "Deflecting", "Blocking", "Blockstun" } :: { State })
local STUNNED = set({ "Hitstun", "Blockstun", "GuardBroken", "StaminaBroken", "StanceBroken", "DeathblowVictim" } :: { State })
local ATTACKING = set({ "Startup", "Active", "Recovery" } :: { State })
local LOCKED = set({ "DeathblowAttacker", "DeathblowVictim", "RestingAtShrine", "KO" } :: { State })
local STATIC_INVULNERABLE = set({ "DeathblowAttacker", "DeathblowVictim", "RestingAtShrine", "KO" } :: { State })
local STAMINA_FREE = set({ "Move", "Equip", "RestAtShrine", "Deathblow", "Heal" } :: { Action })

Schema.Allowed = ALLOWED
Schema.Transitions = TRANSITIONS

-- Reasons returned alongside eligibility verdicts.
Schema.Reasons = table.freeze({
	Ok = "Ok",
	UnknownState = "UnknownState",
	UnknownAction = "UnknownAction",
	StateLocked = "StateLocked",
	NotInWindow = "NotInWindow",
	PostureBroken = "PostureBroken",
	InsufficientStamina = "InsufficientStamina",
	RequiresSprint = "RequiresSprint",
	DeflectCooldown = "DeflectCooldown",
	NoDeathblowTarget = "NoDeathblowTarget",
	NotAtShrine = "NotAtShrine",
	NoHealCharge = "NoHealCharge",
	InsufficientQi = "InsufficientQi",
})

local function tierT(tier: InjuryTier): number?
	if tier == "Impaired" then
		return 0
	elseif tier == "Injured" then
		return 0.5
	elseif tier == "Severe" then
		return 1
	end
	return nil
end

-- Interpolates a {Min, Max} penalty range across Impaired..Severe; None yields zero.
function Schema.penalty(range: { Min: number, Max: number }, tier: InjuryTier): number
	local t = tierT(tier)
	if t == nil then
		return 0
	end
	return range.Min + (range.Max - range.Min) * t
end

local function worse(a: InjuryTier, b: InjuryTier): InjuryTier
	local index = Settings.Injury.TierIndex
	return if index[a] >= index[b] then a else b
end

function Schema.tierIndex(tier: InjuryTier): number
	return Settings.Injury.TierIndex[tier]
end

function Schema.tierFromCoefficient(region: InjuryRegion, coefficient: number): InjuryTier
	local group: InjuryGroup = Settings.Injury.Group[region]
	assert(group ~= nil, "Unknown injury region")
	local thresholds = Settings.Injury.Thresholds[group]
	if coefficient >= thresholds.Severe then
		return "Severe"
	elseif coefficient >= thresholds.Injured then
		return "Injured"
	elseif coefficient >= thresholds.Impaired then
		return "Impaired"
	end
	return "None"
end

-- Lowest coefficient natural recovery may reach once a region has crossed the persistent tier.
function Schema.recoveryFloor(region: InjuryRegion, coefficient: number): number
	local group: InjuryGroup = Settings.Injury.Group[region]
	local tier = Schema.tierFromCoefficient(region, coefficient)
	local persistent: InjuryTier = Settings.Injury.PersistentTier
	if Schema.tierIndex(tier) < Schema.tierIndex(persistent) or persistent == "None" then
		return 0
	end
	return Settings.Injury.Thresholds[group][persistent :: any]
end

function Schema.armStaminaMultiplier(tier: InjuryTier): number
	return 1 + Schema.penalty(Settings.Injury.Penalties.Arm.StaminaCostIncrease, tier)
end

function Schema.armDamageMultiplier(tier: InjuryTier): number
	return 1 - Schema.penalty(Settings.Injury.Penalties.Arm.DamageReduction, tier)
end

function Schema.legSpeedMultiplier(tier: InjuryTier): number
	return 1 - Schema.penalty(Settings.Injury.Penalties.Leg.SpeedReduction, tier)
end

function Schema.legDashMultiplier(tier: InjuryTier): number
	return 1 - Schema.penalty(Settings.Injury.Penalties.Leg.DashDistanceReduction, tier)
end

function Schema.headDeflectWindow(tier: InjuryTier): number
	local window = Settings.Posture.DeflectWindow * (1 - Schema.penalty(Settings.Injury.Penalties.Head.DeflectWindowReduction, tier))
	return math.max(window, Settings.Posture.DeflectWindowMin)
end

-- Effective arm tier for an attack: two-handed grips suffer the worse arm, one-handed the weapon arm.
function Schema.attackArmTier(injuries: Injuries, twoHanded: boolean, mainHand: "Left" | "Right"?): InjuryTier
	local left = injuries.LeftArm or "None"
	local right = injuries.RightArm or "None"
	if twoHanded then
		return worse(left, right)
	end
	return if mainHand == "Left" then left else right
end

function Schema.penalties(injuries: Injuries, twoHanded: boolean?, mainHand: "Left" | "Right"?): Penalties
	local p = Settings.Injury.Penalties
	local arm = Schema.attackArmTier(injuries, twoHanded == true, mainHand)
	local leg = worse(injuries.LeftLeg or "None", injuries.RightLeg or "None")
	local head = injuries.Head or "None"
	local torso = injuries.Torso or "None"
	return {
		StaminaCostMultiplier = Schema.armStaminaMultiplier(arm),
		DamageMultiplier = Schema.armDamageMultiplier(arm),
		SpeedMultiplier = Schema.legSpeedMultiplier(leg),
		DashDistanceMultiplier = Schema.legDashMultiplier(leg),
		DeflectWindowMultiplier = Schema.headDeflectWindow(head) / Settings.Posture.DeflectWindow,
		PostureDecayMultiplier = 1 - Schema.penalty(p.Head.PostureDecayReduction, head),
		StaminaRegenMultiplier = 1 - Schema.penalty(p.Torso.StaminaRegenReduction, torso),
		MaxPostureMultiplier = 1 - Schema.penalty(p.Torso.MaxPostureReduction, torso),
		VisionBlur = Schema.penalty(p.Head.VisionBlur, head),
		EyeVignette = Schema.penalty(p.Head.EyeVignette, head),
	}
end

function Schema.baseStaminaCost(action: Action): number
	local costs = Settings.Stamina.Costs
	if action == "Light" then
		return costs.Light
	elseif action == "Heavy" then
		return costs.Heavy
	elseif action == "Roll" then
		return costs.Roll
	elseif action == "Dash" then
		return costs.Dash
	elseif action == "RunningAttack" then
		return costs.RunningAttack
	elseif action == "WeaponArt" then
		return costs.WeaponArt
	elseif action == "Deflect" then
		return costs.DeflectSuccess
	elseif action == "Block" then
		return 0
	end
	return 0
end

local function isAttack(action: Action): boolean
	return action == "Light" or action == "Heavy" or action == "RunningAttack" or action == "WeaponArt"
end

-- Final stamina cost, applying arm trauma to offensive actions only.
function Schema.staminaCost(action: Action, armTier: InjuryTier?, override: number?): number
	local base = override or Schema.baseStaminaCost(action)
	if isAttack(action) then
		return base * Schema.armStaminaMultiplier(armTier or "None")
	end
	return base
end

function Schema.damage(baseDamage: number, armTier: InjuryTier?): number
	return baseDamage * Schema.armDamageMultiplier(armTier or "None")
end

-- Real-time duration of timed lockout states; nil means the state is driven by move frames or input.
function Schema.stateDuration(state: State): number?
	local stun = Settings.Stun
	if state == "StaminaBroken" then
		return stun.StaminaBroken
	elseif state == "GuardBroken" then
		return stun.GuardBroken
	elseif state == "StanceBroken" then
		return stun.StanceBroken
	elseif state == "Blockstun" then
		return stun.Blockstun
	elseif state == "DeathblowAttacker" then
		return stun.DeathblowAttacker
	elseif state == "DeathblowVictim" then
		return stun.DeathblowVictim
	elseif state == "Deflecting" then
		return Settings.Posture.DeflectWindow + Settings.Posture.DeflectRecovery
	elseif state == "RestingAtShrine" then
		return Settings.Health.Shrine.RestDuration
	end
	return nil
end

function Schema.isValidState(state: any): boolean
	return type(state) == "string" and ALLOWED[state :: State] ~= nil
end

function Schema.isValidAction(action: any): boolean
	return type(action) == "string" and (Schema.Actions :: any)[action] ~= nil
end

function Schema.canTransition(from: State, to: State): boolean
	local edges = TRANSITIONS[from]
	return edges ~= nil and edges[to] == true
end

function Schema.isGuarding(state: State): boolean
	return GUARDING[state] == true
end

function Schema.isStunned(state: State): boolean
	return STUNNED[state] == true
end

function Schema.isAttacking(state: State): boolean
	return ATTACKING[state] == true
end

function Schema.isLocked(state: State): boolean
	return LOCKED[state] == true
end

function Schema.isDeathblowVulnerable(state: State): boolean
	return state == "StanceBroken"
end

-- Invulnerability independent of i-frame windows (rolls/dashes resolve those from Movement timings).
function Schema.isInvulnerable(state: State): boolean
	return STATIC_INVULNERABLE[state] == true
end

function Schema.canTakeHits(state: State): boolean
	return not Schema.isInvulnerable(state)
end

function Schema.postureDecayMultiplier(state: State): number
	if Schema.isStunned(state) and state ~= "Blockstun" then
		return 0
	end
	if Schema.isGuarding(state) then
		return Settings.Posture.GuardingDecayMultiplier
	end
	return 1
end

function Schema.canAct(state: State, action: Action, stamina: number, posture: number, context: Context?): (boolean, string)
	local reasons = Schema.Reasons
	local allowed = ALLOWED[state]
	if allowed == nil then
		return false, reasons.UnknownState
	end
	if not Schema.isValidAction(action) then
		return false, reasons.UnknownAction
	end
	if Schema.isLocked(state) and not allowed[action] then
		return false, reasons.StateLocked
	end

	local ctx: Context = context or {}
	local permitted = allowed[action] == true
	if not permitted and ctx.ComboWindowOpen then
		local combo = COMBO_UNLOCKS[state]
		permitted = combo ~= nil and combo[action] == true
	end
	if not permitted and ctx.CancelWindowOpen then
		local cancel = CANCEL_UNLOCKS[state]
		permitted = cancel ~= nil and cancel[action] == true
	end
	if not permitted then
		return false, if Schema.isStunned(state) or Schema.isLocked(state) then reasons.StateLocked else reasons.NotInWindow
	end

	if posture >= Settings.Posture.StanceBreakThreshold and action ~= "Move" and action ~= "Equip" then
		return false, reasons.PostureBroken
	end

	if action == "RunningAttack" and not ctx.Sprinting and state ~= "Dashing" then
		return false, reasons.RequiresSprint
	end
	if action == "Deathblow" and not ctx.TargetDeathblowable then
		return false, reasons.NoDeathblowTarget
	end
	if action == "RestAtShrine" and state ~= "RestingAtShrine" and not ctx.AtShrine then
		return false, reasons.NotAtShrine
	end
	if action == "Heal" and ctx.HasHealCharge == false then
		return false, reasons.NoHealCharge
	end
	if action == "Deflect" and ctx.DeflectReady == false then
		return false, reasons.DeflectCooldown
	end
	if action == "WeaponArt" and ctx.QiCost ~= nil and (ctx.Qi or 0) < ctx.QiCost then
		return false, reasons.InsufficientQi
	end

	if not STAMINA_FREE[action] then
		local floor = Settings.Stamina.BreakThreshold
		if action == "Deflect" or action == "Block" then
			-- Guarding is attempted on any positive stamina; a missed deflect may overdraw into StaminaBroken.
			if stamina <= floor then
				return false, reasons.InsufficientStamina
			end
		elseif action == "Sprint" then
			if stamina < Settings.Stamina.SprintMinimum then
				return false, reasons.InsufficientStamina
			end
		else
			local cost = Schema.staminaCost(action, ctx.ArmTier, ctx.StaminaCost)
			if stamina <= floor or stamina < cost then
				return false, reasons.InsufficientStamina
			end
		end
	end

	return true, reasons.Ok
end

-- Validates the static tables at load so a malformed edit fails immediately.
do
	for _, state in STATE_LIST do
		assert(ALLOWED[state] ~= nil, "Missing action row for state " .. state)
		assert(TRANSITIONS[state] ~= nil, "Missing transition row for state " .. state)
		for target in TRANSITIONS[state] do
			assert(ALLOWED[target] ~= nil, "Transition to unknown state " .. tostring(target))
		end
	end
	for _, rows in { ALLOWED, COMBO_UNLOCKS, CANCEL_UNLOCKS } do
		for state, row in rows do
			assert(ALLOWED[state] ~= nil, "Unknown state " .. tostring(state))
			for action in row do
				assert((Schema.Actions :: any)[action] ~= nil, "Unknown action " .. tostring(action))
			end
		end
	end
	for _, region in Settings.Injury.Regions do
		local thresholds = Settings.Injury.Thresholds[Settings.Injury.Group[region]]
		assert(thresholds.Impaired < thresholds.Injured and thresholds.Injured < thresholds.Severe and thresholds.Severe <= 1, "Injury thresholds must ascend for " .. region)
	end
end

table.freeze(ALLOWED)
table.freeze(COMBO_UNLOCKS)
table.freeze(CANCEL_UNLOCKS)
table.freeze(TRANSITIONS)

return table.freeze(Schema)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Tempo</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Simulation/Tempo
-- Converts baseline timing into Asura's Path tempo and snaps it to the 60 Hz server tick.
local hasScript = pcall(function()
	return script.Parent
end)
local Settings: any
if hasScript then
	Settings = require(script.Parent.Parent.Shared.CombatSettings)
else
	Settings = require("../shared/CombatSettings")
end

export type TelegraphClass = "Light" | "Heavy" | "RunningAttack" | "WeaponArt"

local EPSILON = 1e-6
local SCALAR: number = Settings.Tempo.Scalar
local TICK_RATE: number = Settings.Tempo.TickRate
local TICK: number = Settings.Tempo.TickSeconds

local Tempo = {}

Tempo.Scalar = SCALAR
Tempo.TickRate = TICK_RATE
Tempo.TickSeconds = TICK
Tempo.HalfTick = TICK * 0.5

local function snapFramesUp(seconds: number): number
	return math.ceil(seconds * TICK_RATE - EPSILON)
end

local function snapFramesNearest(seconds: number): number
	return math.floor(seconds * TICK_RATE + 0.5 + EPSILON)
end

Tempo.HeavyMinFrames = snapFramesUp(Settings.Tempo.Telegraph.HeavyMinSeconds)
Tempo.LightMinFrames = math.max(1, snapFramesNearest(Settings.Tempo.Telegraph.LightTargetSeconds))
Tempo.HeavyMinSeconds = Tempo.HeavyMinFrames * TICK
Tempo.LightMinSeconds = Tempo.LightMinFrames * TICK

function Tempo.toDuration(baseSec: number): number
	assert(baseSec == baseSec and baseSec >= 0, "Tempo.toDuration requires a non-negative number")
	return baseSec / SCALAR
end

function Tempo.toRate(baseRate: number): number
	assert(baseRate == baseRate, "Tempo.toRate requires a number")
	return baseRate * SCALAR
end

function Tempo.toFrames(seconds: number): number
	assert(seconds == seconds and seconds >= 0, "Tempo.toFrames requires a non-negative number")
	return snapFramesNearest(seconds)
end

function Tempo.toFramesCeil(seconds: number): number
	assert(seconds == seconds and seconds >= 0, "Tempo.toFramesCeil requires a non-negative number")
	return math.max(0, snapFramesUp(seconds))
end

function Tempo.framesToSeconds(frames: number): number
	return frames * TICK
end

-- Baseline 60 Hz frame count -> tempo-scaled frame count (never below one frame).
function Tempo.scaleFrames(baseFrames: number): number
	assert(baseFrames == baseFrames and baseFrames >= 0, "Tempo.scaleFrames requires a non-negative number")
	if baseFrames == 0 then
		return 0
	end
	return math.max(1, math.floor(baseFrames / SCALAR + 0.5 + EPSILON))
end

function Tempo.quantize(seconds: number): number
	return snapFramesNearest(seconds) * TICK
end

function Tempo.quantizeUp(seconds: number): number
	return snapFramesUp(seconds) * TICK
end

function Tempo.quantizeDown(seconds: number): number
	return math.floor(seconds * TICK_RATE + EPSILON) * TICK
end

function Tempo.tickIndex(time: number, origin: number?): number
	return math.floor((time - (origin or 0)) * TICK_RATE + EPSILON)
end

function Tempo.tickTime(index: number, origin: number?): number
	return (origin or 0) + index * TICK
end

-- Snaps a client or replicated timestamp onto the nearest server tick boundary.
function Tempo.snapTime(time: number, origin: number?): number
	local base = origin or 0
	return base + snapFramesNearest(time - base) * TICK
end

-- Snaps a client-reported timestamp to a tick, never later than the server's current tick and
-- never earlier than the allowed rewind, so 16.6 ms jitter cannot buy a timing advantage.
function Tempo.reconcile(clientTime: number, serverTime: number, maxRewind: number): number
	local latest = Tempo.snapTime(serverTime)
	local earliest = math.min(Tempo.quantizeUp(serverTime - maxRewind), latest)
	return math.clamp(Tempo.snapTime(clientTime), earliest, latest)
end

function Tempo.sameTick(a: number, b: number): boolean
	return math.abs(a - b) < Tempo.HalfTick
end

-- Window test with half-tick tolerance on both edges so 16.6 ms jitter cannot flip a result.
function Tempo.withinWindow(eventTime: number, windowStart: number, windowLength: number): boolean
	local tolerance = Tempo.HalfTick
	return eventTime >= windowStart - tolerance and eventTime <= windowStart + windowLength + tolerance
end

function Tempo.minimumStartupFrames(class: TelegraphClass): number
	if class == "Heavy" or class == "WeaponArt" then
		return Tempo.HeavyMinFrames
	end
	return Tempo.LightMinFrames
end

function Tempo.enforceTelegraph(class: TelegraphClass, frames: number): number
	return math.max(frames, Tempo.minimumStartupFrames(class))
end

function Tempo.isReactable(class: TelegraphClass, frames: number): boolean
	return frames >= Tempo.minimumStartupFrames(class)
end

return table.freeze(Tempo)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WeaponSchema</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Simulation/WeaponSchema
-- Weapon contracts and move trees. Frame data is authored at the 60 Hz baseline and resolved
-- through Tempo (1.4x) with reactable telegraph floors enforced at load.
local hasScript = pcall(function()
	return script.Parent
end)
local Settings: any, Tempo: any
if hasScript then
	Settings = require(script.Parent.Parent.Shared.CombatSettings)
	Tempo = require(script.Parent.Tempo)
else
	Settings = require("../shared/CombatSettings")
	Tempo = require("./Tempo")
end

export type WeaponType = "Unarmed" | "Jian" | "Dao" | "Guandao"
export type Grip = "Fist" | "OneHanded" | "TwoHanded"
export type MoveKind = "Light" | "Heavy" | "RunningAttack" | "WeaponArt"
export type DamageType = "Blunt" | "Slash" | "Pierce"

export type Trauma = { Head: number, Torso: number, Arms: number, Legs: number }

export type Timing = {
	StartupFrames: number,
	ActiveFrames: number,
	RecoveryFrames: number,
	ComboWindowFrames: number,
	CancelFrame: number,
	TotalFrames: number,
	StartupSeconds: number,
	ActiveSeconds: number,
	RecoverySeconds: number,
	ComboWindowSeconds: number,
	TotalSeconds: number,
	Reactable: boolean,
}

export type MoveSpec = {
	Id: string,
	Name: string,
	Kind: MoveKind,
	ComboIndex: number,
	Startup: number,
	Active: number,
	Recovery: number,
	ComboWindow: number,
	CancelFrom: number,
	BaseDamage: number,
	PostureDamage: number,
	Bleed: number,
	DeflectVulnerability: number,
	Deflectable: boolean,
	Unblockable: boolean,
	HyperArmor: boolean,
	StaminaCost: number,
	QiCost: number,
	Reach: number,
	Arc: number,
	Lunge: number,
	DamageType: DamageType,
	Trauma: Trauma,
	Animation: string,
}

export type Move = MoveSpec & { Timing: Timing }

export type WeaponSpec = {
	Id: string,
	Type: WeaponType,
	Name: string,
	Grip: Grip,
	Reach: number,
	Weight: number,
	DeflectEfficiency: number,
	GuardChip: number,
	BleedMultiplier: number,
	PostureMultiplier: number,
	BlockPostureResistance: number,
	MoveSpeedMultiplier: number,
	Light: { MoveSpec },
	Heavy: MoveSpec,
	RunningAttack: MoveSpec,
	WeaponArt: MoveSpec,
}

export type Weapon = {
	Id: string,
	Type: WeaponType,
	Name: string,
	Grip: Grip,
	Reach: number,
	Weight: number,
	DeflectEfficiency: number,
	GuardChip: number,
	BleedMultiplier: number,
	PostureMultiplier: number,
	BlockPostureResistance: number,
	MoveSpeedMultiplier: number,
	Light: { Move },
	Heavy: Move,
	RunningAttack: Move,
	WeaponArt: Move,
	Moves: { [string]: Move },
}

export type DeflectOutcome = { AttackerPosture: number, DefenderPosture: number, DefenderStamina: number }
export type BlockOutcome = { DefenderPosture: number, DefenderChip: number, DefenderStamina: number, GuardBreak: boolean }

local Schema = {}

Schema.WeaponTypes = table.freeze({ "Unarmed", "Jian", "Dao", "Guandao" } :: { WeaponType })
Schema.MoveKinds = table.freeze({ "Light", "Heavy", "RunningAttack", "WeaponArt" } :: { MoveKind })

local function trauma(head: number, torso: number, arms: number, legs: number): Trauma
	return { Head = head, Torso = torso, Arms = arms, Legs = legs }
end

local function check(condition: boolean, message: string)
	if not condition then
		error("WeaponSchema: " .. message, 3)
	end
end

local function inRange(value: number, low: number, high: number): boolean
	return value == value and value >= low and value <= high
end

function Schema.resolveTiming(spec: MoveSpec): Timing
	local startup = Tempo.enforceTelegraph(spec.Kind, Tempo.scaleFrames(spec.Startup))
	local active = Tempo.scaleFrames(spec.Active)
	local recovery = Tempo.scaleFrames(spec.Recovery)
	local combo = math.min(Tempo.scaleFrames(spec.ComboWindow), recovery)
	local cancel = startup + active + math.min(Tempo.scaleFrames(spec.CancelFrom), recovery)
	local total = startup + active + recovery
	local timing: Timing = {
		StartupFrames = startup,
		ActiveFrames = active,
		RecoveryFrames = recovery,
		ComboWindowFrames = combo,
		CancelFrame = cancel,
		TotalFrames = total,
		StartupSeconds = Tempo.framesToSeconds(startup),
		ActiveSeconds = Tempo.framesToSeconds(active),
		RecoverySeconds = Tempo.framesToSeconds(recovery),
		ComboWindowSeconds = Tempo.framesToSeconds(combo),
		TotalSeconds = Tempo.framesToSeconds(total),
		Reactable = Tempo.isReactable(spec.Kind, startup),
	}
	table.freeze(timing :: any)
	return timing
end

function Schema.validateMove(spec: MoveSpec, weaponId: string)
	local label = weaponId .. "." .. tostring(spec.Id)
	check(type(spec.Id) == "string" and #spec.Id > 0, label .. " requires Id")
	check(type(spec.Name) == "string" and #spec.Name > 0, label .. " requires Name")
	check(spec.Kind == "Light" or spec.Kind == "Heavy" or spec.Kind == "RunningAttack" or spec.Kind == "WeaponArt", label .. " unknown Kind")
	check(spec.DamageType == "Blunt" or spec.DamageType == "Slash" or spec.DamageType == "Pierce", label .. " unknown DamageType")
	for _, key in { "Startup", "Active", "Recovery" } do
		local value = (spec :: any)[key]
		check(type(value) == "number" and value % 1 == 0 and inRange(value, 1, 120), label .. " invalid " .. key)
	end
	check(spec.ComboWindow % 1 == 0 and inRange(spec.ComboWindow, 0, spec.Recovery), label .. " ComboWindow exceeds Recovery")
	check(spec.CancelFrom % 1 == 0 and inRange(spec.CancelFrom, 0, spec.Recovery), label .. " CancelFrom exceeds Recovery")
	check(inRange(spec.BaseDamage, 0, 60), label .. " invalid BaseDamage")
	check(inRange(spec.PostureDamage, 0, 80), label .. " invalid PostureDamage")
	check(inRange(spec.Bleed, 0, 1), label .. " Bleed must be 0..1")
	check(inRange(spec.DeflectVulnerability, 0, 1), label .. " DeflectVulnerability must be 0..1")
	check(type(spec.Deflectable) == "boolean" and type(spec.Unblockable) == "boolean" and type(spec.HyperArmor) == "boolean", label .. " flags must be boolean")
	check(spec.Deflectable or not spec.Unblockable, label .. " cannot be both undeflectable and unblockable")
	check(inRange(spec.QiCost, 0, Settings.Qi.Max), label .. " invalid QiCost")
	check(inRange(spec.Reach, 1, 16) and inRange(spec.Arc, 0, 360) and inRange(spec.Lunge, 0, 20), label .. " invalid spatial data")
	check(type(spec.Animation) == "string" and #spec.Animation > 0, label .. " requires Animation key")
	for _, part in { "Head", "Torso", "Arms", "Legs" } do
		check(inRange((spec.Trauma :: any)[part], 0, 0.5), label .. " invalid Trauma." .. part)
	end
	local stamina = Settings.Stamina
	if spec.Kind == "Light" then
		check(inRange(spec.StaminaCost, stamina.LightRange.Min, stamina.LightRange.Max), label .. " light stamina outside range")
		check(spec.ComboIndex >= 1, label .. " light requires ComboIndex")
		check(spec.QiCost == 0, label .. " light cannot cost Qi")
	elseif spec.Kind == "Heavy" then
		check(inRange(spec.StaminaCost, stamina.HeavyRange.Min, stamina.HeavyRange.Max), label .. " heavy stamina outside range")
		check(spec.ComboIndex == 0, label .. " heavy ComboIndex must be 0")
	elseif spec.Kind == "RunningAttack" then
		check(inRange(spec.StaminaCost, stamina.LightRange.Min, stamina.HeavyRange.Max), label .. " running stamina outside range")
		check(spec.ComboIndex == 0, label .. " running ComboIndex must be 0")
	else
		check(inRange(spec.StaminaCost, stamina.HeavyRange.Min, stamina.Costs.WeaponArt * 1.25), label .. " art stamina outside range")
		check(spec.QiCost > 0, label .. " weapon art requires QiCost")
		check(spec.ComboIndex == 0, label .. " art ComboIndex must be 0")
	end
	local timing = Schema.resolveTiming(spec)
	check(timing.Reactable, label .. " startup is below the reactable telegraph floor")
end

function Schema.validateWeapon(spec: WeaponSpec)
	local id = tostring(spec.Id)
	check(type(spec.Id) == "string" and #spec.Id > 0, "weapon requires Id")
	check(table.find(Schema.WeaponTypes, spec.Type) ~= nil, id .. " unknown Type")
	check(spec.Grip == "Fist" or spec.Grip == "OneHanded" or spec.Grip == "TwoHanded", id .. " unknown Grip")
	check(inRange(spec.Reach, 1, 16) and inRange(spec.Weight, 0, 10), id .. " invalid Reach/Weight")
	check(inRange(spec.DeflectEfficiency, 0.5, 2), id .. " invalid DeflectEfficiency")
	check(inRange(spec.GuardChip, 0, 0.5), id .. " invalid GuardChip")
	check(inRange(spec.BleedMultiplier, 0, 2) and inRange(spec.PostureMultiplier, 0.5, 2), id .. " invalid multipliers")
	check(inRange(spec.BlockPostureResistance, 0.5, 1.5), id .. " invalid BlockPostureResistance")
	check(inRange(spec.MoveSpeedMultiplier, 0.7, 1.1), id .. " invalid MoveSpeedMultiplier")
	check(#spec.Light >= 3 and #spec.Light <= 4, id .. " light string must be 3-4 hits")
	local seen: { [string]: boolean } = {}
	local function visit(move: MoveSpec, kind: MoveKind)
		check(move.Kind == kind, id .. "." .. move.Id .. " kind mismatch")
		check(not seen[move.Id], id .. " duplicate move id " .. move.Id)
		seen[move.Id] = true
		Schema.validateMove(move, id)
	end
	for index, move in spec.Light do
		check(move.ComboIndex == index, id .. " light ComboIndex out of order")
		visit(move, "Light")
	end
	check(spec.Light[#spec.Light].ComboWindow == 0, id .. " final light cannot chain")
	visit(spec.Heavy, "Heavy")
	visit(spec.RunningAttack, "RunningAttack")
	visit(spec.WeaponArt, "WeaponArt")
end

local function resolveMove(spec: MoveSpec): Move
	local move = table.clone(spec) :: any
	move.Trauma = table.freeze(table.clone(spec.Trauma))
	move.Timing = Schema.resolveTiming(spec)
	return table.freeze(move) :: Move
end

function Schema.build(spec: WeaponSpec): Weapon
	Schema.validateWeapon(spec)
	local light: { Move } = {}
	local moves: { [string]: Move } = {}
	for index, entry in spec.Light do
		local move = resolveMove(entry)
		light[index] = move
		moves[move.Id] = move
	end
	local heavy = resolveMove(spec.Heavy)
	local running = resolveMove(spec.RunningAttack)
	local art = resolveMove(spec.WeaponArt)
	moves[heavy.Id] = heavy
	moves[running.Id] = running
	moves[art.Id] = art
	table.freeze(light)
	table.freeze(moves)
	local weapon: Weapon = {
		Id = spec.Id,
		Type = spec.Type,
		Name = spec.Name,
		Grip = spec.Grip,
		Reach = spec.Reach,
		Weight = spec.Weight,
		DeflectEfficiency = spec.DeflectEfficiency,
		GuardChip = spec.GuardChip,
		BleedMultiplier = spec.BleedMultiplier,
		PostureMultiplier = spec.PostureMultiplier,
		BlockPostureResistance = spec.BlockPostureResistance,
		MoveSpeedMultiplier = spec.MoveSpeedMultiplier,
		Light = light,
		Heavy = heavy,
		RunningAttack = running,
		WeaponArt = art,
		Moves = moves,
	}
	table.freeze(weapon :: any)
	return weapon
end

