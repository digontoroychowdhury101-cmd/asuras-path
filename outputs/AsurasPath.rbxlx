			cashPrice = 3500,
			robuxPrice = 499,
			description = "Rapid 4-punch combination into a front double-bicep flex.",
		},
	} :: { [string]: CosmeticItem },

	Bundles = {
		Cash_Small = {
			id = "Cash_Small",
			name = "500 Fight Cash",
			bundleType = "Cash",
			amount = 500,
			robuxPrice = 49,
