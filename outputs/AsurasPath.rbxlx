local WEAPONS: { [WeaponType]: Weapon } = {
	Unarmed = Schema.build(UNARMED),
	Jian = Schema.build(JIAN),
	Dao = Schema.build(DAO),
	Guandao = Schema.build(GUANDAO),
}
local keys: {WeaponType} = table.clone(Schema.WeaponTypes)
for _, spec in Expansion.specs() do
	WEAPONS[spec.Id] = Schema.build(spec)
	if not table.find(keys, spec.Id) then table.insert(keys, spec.Id) end
end
Schema.WeaponKeys = table.freeze(keys)
local BY_ID: { [string]: Weapon } = {}
for _, weapon in WEAPONS do
	assert(BY_ID[weapon.Id] == nil, "Duplicate weapon id " .. weapon.Id)
	BY_ID[weapon.Id] = weapon
end
table.freeze(WEAPONS)
table.freeze(BY_ID)

Schema.Weapons = WEAPONS
Schema.ById = BY_ID

function Schema.get(weaponType: WeaponType): Weapon
	local weapon = WEAPONS[weaponType]
	assert(weapon ~= nil, "Unknown weapon type")
	return weapon
end

function Schema.getById(id: string): Weapon?
	return BY_ID[id]
end

function Schema.findMove(weapon: Weapon, moveId: string): Move?
	return weapon.Moves[moveId]
end

-- Next light in the string; wraps to the opener once the finisher has played.
function Schema.nextLight(weapon: Weapon, current: Move?): Move
	if current == nil or current.Kind ~= "Light" or current.ComboIndex &gt;= #weapon.Light then
		return weapon.Light[1]
	end
	return weapon.Light[current.ComboIndex + 1]
end

function Schema.moveForKind(weapon: Weapon, kind: MoveKind, current: Move?): Move
	if kind == "Light" then
		return Schema.nextLight(weapon, current)
	elseif kind == "Heavy" then
		return weapon.Heavy
	elseif kind == "RunningAttack" then
		return weapon.RunningAttack
	end
	return weapon.WeaponArt
end

function Schema.isTwoHanded(weapon: Weapon): boolean
	return weapon.Grip == "TwoHanded"
end

function Schema.postureDamage(move: Move, attacker: Weapon): number
	return move.PostureDamage * attacker.PostureMultiplier
end

function Schema.bleedBuildup(move: Move, attacker: Weapon): number
	return move.BaseDamage * move.Bleed * attacker.BleedMultiplier * Settings.Bleed.BuildupScale
end

-- Successful deflect: the attacker absorbs reflected posture, the defender pays a small share and no stamina.
function Schema.deflectOutcome(move: Move, attacker: Weapon, defender: Weapon): DeflectOutcome
	local posture = Schema.postureDamage(move, attacker)
	local p = Settings.Posture
	local outcome: DeflectOutcome = {
		AttackerPosture = posture * move.DeflectVulnerability * defender.DeflectEfficiency * p.DeflectReflectScale + posture * (defender.PostureReflect or 0),
		DefenderPosture = posture * p.DeflectSelfScale / defender.DeflectEfficiency,
		DefenderStamina = Settings.Stamina.Costs.DeflectSuccess,
	}
	return table.freeze(outcome) :: DeflectOutcome
end

-- Held guard: full posture pressure, guard-chip into RecoverableHP and the block stamina cost.
function Schema.blockOutcome(move: Move, attacker: Weapon, defender: Weapon, defenderStamina: number): BlockOutcome
	local p = Settings.Posture
	local scale = if move.Unblockable then p.UnblockableBlockScale else p.BlockScale
	local posture = Schema.postureDamage(move, attacker) * scale / defender.BlockPostureResistance
	local stamina: number = Settings.Stamina.Costs.Block
	local outcome: BlockOutcome = {
		DefenderPosture = posture,
		DefenderChip = if move.Unblockable then move.BaseDamage else move.BaseDamage * attacker.GuardChip,
		DefenderStamina = stamina,
		GuardBreak = move.Unblockable or defenderStamina - stamina &lt;= Settings.Stamina.BreakThreshold,
	}
	return table.freeze(outcome) :: BlockOutcome
end

return table.freeze(Schema)
</string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="92">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="93">
      <Properties>
        <string name="Name">AsurasPath</string>
      </Properties>
      <Item class="Script" referent="94">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source">--!strict
-- Script: ServerScriptService/AsurasPath/Bootstrap
-- Asura's Path master server entry. Brings services up in dependency order:
--   Environment -&gt; LagCompensation -&gt; ProfileStore (Persistence) -&gt; CharacterService -&gt; AIService
--   -&gt; SanctuaryService -&gt; MonasteryService -&gt; WorldService -&gt; ColosseumService
-- SanctuaryService and MonasteryService precede WorldService: their map folders suppress greybox
-- and their altar anchors receive the rest prompts.
-- then owns the player lifecycle: leased profile hydration, durable ranked-result recovery,
-- character admission, death/respawn telemetry and an ordered, deadline-bounded shutdown save.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local Validator = require(Shared.Shared.ConfigValidator) :: any
local Protocol = require(Shared.Shared.IntentProtocol)
local ShopCatalog = require(Shared.ShopCatalog) :: any
local Services = script.Parent:WaitForChild("Services")

local READY_ATTRIBUTE: string = Config.Names.ReadyAttribute
Workspace:SetAttribute(READY_ATTRIBUTE, false)
Workspace:SetAttribute("AsuraReady", false)

-- Dependency order. Each require is a hard dependency of the next layer.
local Environment = require(Services:WaitForChild("EnvironmentService") :: ModuleScript)
local Lag = require(Services:WaitForChild("LagCompensation") :: ModuleScript)
local ProfileStore = require(Services:WaitForChild("ProfileStore") :: ModuleScript)
local Persistence = require(Services:WaitForChild("PersistenceService") :: ModuleScript) :: any
local Characters = require(Services:WaitForChild("CharacterService") :: ModuleScript)
local AI = require(Services:WaitForChild("AIService") :: ModuleScript)
local Sanctuary = require(Services:WaitForChild("SanctuaryService") :: ModuleScript)
local Monastery = require(Services:WaitForChild("MonasteryService") :: ModuleScript)
local Campaign = require(Services:WaitForChild("CampaignWorld") :: ModuleScript)
local WorldService = require(Services:WaitForChild("WorldService") :: ModuleScript)
local Colosseum = require(Services:WaitForChild("ColosseumService") :: ModuleScript)
local Shop = require(Services:WaitForChild("ShopService") :: ModuleScript) :: any

local Magic = require(Services:WaitForChild("MagicService") :: ModuleScript)
local Loot = require(Services:WaitForChild("LootService") :: ModuleScript)
local Dialogue = require(Services:WaitForChild("DialogueService") :: ModuleScript)
local Wagering = require(Services:WaitForChild("WagerService") :: ModuleScript)
local Presentation = require(Services:WaitForChild("PresentationService") :: ModuleScript)
local WeaponEffects = require(Services:WaitForChild("WeaponEffects") :: ModuleScript)
local Tutorial = require(Services:WaitForChild("TutorialService") :: ModuleScript)

type Bucket = Protocol.Bucket

local SHUTDOWN_BUDGET = 25
local FLUSH_BUDGET = 8
local LOAD_RETRY_DELAY = 2

local connections: { RBXScriptConnection } = {}
local disconnectors: { () -&gt; () } = {}
local shopBudgets: { [number]: Bucket } = {}
local shopBusy: { [number]: boolean } = {}
local loading: { [number]: boolean } = {}
local started: { [string]: boolean } = {}
local shuttingDown = false

local net = Shared:WaitForChild("Net")
local shopRemote = net:WaitForChild("ShopIntent") :: RemoteEvent

local MarketplaceService: any = nil
pcall(function()
	MarketplaceService = game:GetService("MarketplaceService")
	MarketplaceService.ProcessReceipt = Shop.ProcessReceipt
end)

local function trace(problem: any): string
	return debug.traceback(tostring(problem), 2)
end

local function teardown()
 pcall(Presentation.Destroy)
 if started.Tutorial then pcall(Tutorial.Destroy) end
 if started.Dialogue then pcall(Dialogue.Destroy) end
 if started.Wagers then pcall(Wagering.Destroy) end
	for _, disconnect in disconnectors do
		pcall(disconnect)
	end
	table.clear(disconnectors)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	if started.Arsenal then
		pcall(WeaponEffects.Destroy); pcall(Loot.Destroy); pcall(Magic.Destroy)
	end
	if started.Colosseum then
		pcall(Colosseum.Destroy)
	end
	if started.World then
		pcall(WorldService.Destroy)
	end
	if started.Campaign then
		pcall(Campaign.Destroy)
	end
	if started.Monastery then
		pcall(Monastery.Destroy)
	end
	if started.Sanctuary then
		pcall(Sanctuary.Destroy)
	end
	if started.AI then
		pcall(AI.Destroy)
	end
	if started.Characters then
		pcall(Characters.Destroy)
	end
	table.clear(started)
end

local function syncProfile(player: Player)
	if player.Parent and player:GetAttribute("AsuraClientReady") == true then
		shopRemote:FireClient(player, { action = "ProfileSync", profile = Persistence.PublicProfile(player.UserId) })
		Loot.Sync(player)
	end
end

-------------------------------------------------------------------------------------------------
-- Player lifecycle
-------------------------------------------------------------------------------------------------

-- Hydrates the leased profile (Souls section included), settles ranked results that finished
-- while the player was away, then admits their character to the world.
local function hydrate(player: Player)
	local userId = player.UserId
	if loading[userId] or shuttingDown then
		return
	end
	loading[userId] = true
	local loaded, problem = pcall(Persistence.Load, userId)
	if not loaded then
		loading[userId] = nil
		warn("[Asura] Profile load refused for " .. userId .. ": " .. tostring(problem))
		if player.Parent then
			player:Kick("Your warrior's record could not be safely loaded. Please rejoin shortly.")
		end
		return
	end
	if not player.Parent then
		loading[userId] = nil
		Persistence.Unload(userId)
		return
	end
	local profile = Persistence.Get(userId)
	if not profile or type(profile.souls) ~= "table" then
		loading[userId] = nil
		warn("[Asura] Profile for " .. userId .. " has no Souls record")
		Persistence.Unload(userId)
		player:Kick("Your warrior's record is incomplete. Please rejoin.")
		return
	end
	-- Ranked inbox: a result committed elsewhere is applied exactly once before play resumes.
	local recovered = false
	for _ = 1, 3 do
		recovered = Colosseum.Recover(userId)
		if recovered or not player.Parent then
			break
		end
		task.wait(LOAD_RETRY_DELAY)
	end
	if not recovered then
		warn("[Asura] Ranked recovery deferred for " .. userId .. "; it retries at the next queue entry")
	end
	loading[userId] = nil
	if not player.Parent then
		return
	end
	Characters.RefreshRoster()
	syncProfile(player)
end

local function release(player: Player)
	local userId = player.UserId
	Colosseum.Disconnect(userId)
	WorldService.Flush(userId, FLUSH_BUDGET)
	local ok, problem = Persistence.Unload(userId)
	if not ok and problem then
		warn("[Asura] Release for " .. userId .. ": " .. tostring(problem))
	end
	shopBudgets[userId] = nil
	shopBusy[userId] = nil
	loading[userId] = nil
end

-- Death and respawn: penalties live in WorldService and timing in CharacterService; the
-- bootstrap publishes the lifecycle so clients and analytics see one consistent record.
local function onCombatEvent(event: any, _point: Vector3?)
	if event.Kind ~= "KO" then
		return
	end
	local player = Players:GetPlayerByUserId(event.Target)
	if not player then
		return
	end
	player:SetAttribute("AsuraDowned", true)
	if not Characters.IsInDuel(event.Target) then
		player:SetAttribute("AsuraDeaths", (tonumber(player:GetAttribute("AsuraDeaths")) or 0) + 1)
	end
end

local function onEntityAdded(id: number, kind: Characters.EntityKind)
	if kind ~= "Player" then
		return
	end
	local player = Players:GetPlayerByUserId(id)
	if player then
		player:SetAttribute("AsuraDowned", false)
	end
end

local function watchCharacters(player: Player)
	table.insert(connections, player.CharacterAdded:Connect(function()
		player:SetAttribute("AsuraDowned", false)
	end))
end

-------------------------------------------------------------------------------------------------
-- Account remote (settings, cosmetics, style rolls, receipts)
-------------------------------------------------------------------------------------------------

local function onShop(player: Player, payload: any)
	if not Protocol.Shop(payload) then
		return
	end
	local userId = player.UserId
	if payload.action == "GetProfile" then
		player:SetAttribute("AsuraClientReady", true)
	end
	if not Persistence.Get(userId) then
		shopRemote:FireClient(player, { action = "ShopError", err = "Profile unavailable" })
		return
	end
	local clock = os.clock()
	local budget = shopBudgets[userId]
	if not budget then
		budget = { tokens = Config.Network.ShopBurst, time = clock }
		shopBudgets[userId] = budget
	end
	if shopBusy[userId] or not Protocol.Take(budget, clock, 1, Config.Network.ShopPerSecond, Config.Network.ShopBurst) then
		return
	end
	shopBusy[userId] = true
	local handled, problem = xpcall(function(): boolean
		local action: string = payload.action
		if action == "GetProfile" then
			syncProfile(player)
		elseif action == "SaveSettings" then
			local saved, err = Shop.SaveSettings(userId, payload.settings)
			shopRemote:FireClient(player, { action = "SettingsResult", ok = saved, err = err, profile = Persistence.PublicProfile(userId) })
		elseif action == "RollStyle" then
			local ok, err, drop, duplicate = Shop.RollStyle(userId, payload.useToken == true)
			shopRemote:FireClient(player, {
				action = "RollResult",
				ok = ok,
				err = err,
				drop = drop,
				isDuplicate = duplicate,
				profile = Persistence.PublicProfile(userId),
			})
		elseif action == "RollCrate" then
			local ok, err, itemId, duplicate = Shop.RollCrate(userId, payload.crateId)
			shopRemote:FireClient(player, {
				action = "CrateResult",
				ok = ok,
				err = err,
				itemId = itemId,
				isDuplicate = duplicate,
				crateId = payload.crateId,
				profile = Persistence.PublicProfile(userId),
			})
		elseif action == "BuyCosmetic" then
			local ok, err = Shop.BuyCosmetic(userId, payload.itemId)
			shopRemote:FireClient(player, { action = "BuyResult", ok = ok, err = err, profile = Persistence.PublicProfile(userId) })
		elseif action == "EquipCosmetic" then
			local ok, err = Shop.EquipCosmetic(userId, payload.itemId)
			local profile = Persistence.PublicProfile(userId)
			shopRemote:FireClient(player, { action = "EquipResult", ok = ok, err = err, profile = profile })
			if ok and profile and profile.equippedCosmetics then
				Characters.UpdateCosmetics(userId, profile.equippedCosmetics.Trunks, profile.equippedCosmetics.Gloves, profile.equippedCosmetics)
			end
		elseif action == "EquipStyle" then
			local ok, err = false, "Finish your duel and leave the queue before changing style"
			if Colosseum.CanEquip(userId) and Characters.CanSetStyle(userId) then
				ok, err = Shop.EquipStyle(userId, payload.styleName)
				if ok then
					Characters.SetPlayerStyle(userId, payload.styleName)
				end
			end
			shopRemote:FireClient(player, { action = "EquipStyleResult", ok = ok, err = err, profile = Persistence.PublicProfile(userId) })
		elseif action == "BuyBundle" then
			if not Config.Features.PaidPurchases or not Config.Release.PurchasesIntegrationPassed then
				shopRemote:FireClient(player, { action = "BuyBundleResult", ok = false, err = "Purchases are not enabled" })
				return false
			end
			local bundle = ShopCatalog.Bundles[payload.bundleId]
			if bundle and MarketplaceService and not RunService:IsStudio() then
				pcall(function()
					MarketplaceService:PromptProductPurchase(player, bundle.productId)
				end)
			end
		end
		return true
	end, trace)
	shopBusy[userId] = nil
	Characters.RefreshProgression(userId)
	if not handled then
		warn("[Asura] Account operation failed: " .. tostring(problem))
		shopRemote:FireClient(player, { action = "ShopError", err = "Your record is unavailable. Please retry shortly." })
	end
end

-------------------------------------------------------------------------------------------------
-- Shutdown
-------------------------------------------------------------------------------------------------

-- Ordered so nothing is lost: duels settle (ranked journals close), live world state (essence,
-- gourd charges, bloodstains) commits through the serial queues, then every lease is released.
local function shutdown()
	if shuttingDown then
		return
	end
	shuttingDown = true
	Workspace:SetAttribute(READY_ATTRIBUTE, false)
	Workspace:SetAttribute("AsuraReady", false)
	local deadline = os.clock() + SHUTDOWN_BUDGET
	local steps: { { Name: string, Run: () -&gt; () } } = {
		{ Name = "Colosseum", Run = function()
			Colosseum.Close(deadline)
		end },
		{ Name = "Spectator wagers", Run = function()
   Wagering.Close(deadline)
  end },
		{ Name = "World", Run = function()
			WorldService.FlushAll(math.min(FLUSH_BUDGET, math.max(deadline - os.clock(), 1)))
		end },
		{ Name = "Persistence", Run = function()
			Persistence.Close(deadline)
		end },
	}
	for _, item in steps do
		local ok, problem = xpcall(function(): boolean
			item.Run()
			return true
		end, trace)
		if not ok then
			warn("[Asura] Shutdown step " .. item.Name .. " failed: " .. tostring(problem))
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Startup
-------------------------------------------------------------------------------------------------

local ok, problem = xpcall(function(): boolean
	Validator.Validate(Config)
	Environment.Apply()
	assert(type(Lag.MAX_REWIND) == "number" and Lag.MAX_REWIND &gt; 0, "LagCompensation rewind budget missing")
	assert(getmetatable(Persistence.Engine) == ProfileStore, "Persistence must run on the ProfileStore engine")

	Persistence.Start()
	Characters.Start()
	started.Characters = true
	AI.Start()
	started.AI = true
	Sanctuary.Start()
	started.Sanctuary = true
	Monastery.Start()
	started.Monastery = true
	Campaign.Start() -- Bamboo Pass .. Sky Citadel maps (batches 17-21); before WorldService, like the Monastery
	started.Campaign = true
	WorldService.Start()
	started.World = true
	started.Arsenal = true
	Magic.Start(); Loot.Start(); WeaponEffects.Start()
	Colosseum.Start()
 Dialogue.Start();started.Dialogue=true
 Tutorial.Start();started.Tutorial=true
 Wagering.Start(Colosseum);started.Wagers=true
	started.Colosseum = true
	local presented, presentationError = pcall(Presentation.Start)
	if not presented then warn("[Asura AV] Dressing skipped: " .. tostring(presentationError)) end

	table.insert(disconnectors, Characters.Subscribe(onCombatEvent))
	table.insert(disconnectors, Characters.OnEntityAdded(onEntityAdded))
	table.insert(connections, Players.PlayerAdded:Connect(function(player: Player)
		watchCharacters(player)
		hydrate(player)
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(release))
	table.insert(connections, shopRemote.OnServerEvent:Connect(onShop))
	game:BindToClose(shutdown)
	for _, player in Players:GetPlayers() do
		watchCharacters(player)
		task.spawn(hydrate, player)
	end

	Workspace:SetAttribute(READY_ATTRIBUTE, true)
	Workspace:SetAttribute("AsuraReady", true)
	local rings = Colosseum.GetRings()
	print(string.format(
		"[Asura's Path] Server ready: 60 Hz authority, %.0f ms rewind budget, %d Colosseum rings; ranked league %s.",
		Lag.MAX_REWIND * 1000,
		#rings,
		if not Colosseum.RankedOpen() then "sealed (release gate)"
			elseif RunService:IsStudio() and not (Config.Features.Matchmaking and Config.Release.RankedIntegrationPassed) then "open (development)"
			else "open"
	))
	return true
end, trace)

if not ok then
	Workspace:SetAttribute(READY_ATTRIBUTE, false)
	Workspace:SetAttribute("AsuraReady", false)
	teardown()
	error("[Asura's Path] Server startup failed.\n" .. tostring(problem), 0)
end

script.Destroying:Connect(teardown)
</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="95">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">AIService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/AIService
-- PvE combat coordinator. Every agent drives the same CombatRules fighter as a player does, through
-- CharacterService intents; nothing here applies damage directly except authored boss shockwaves,
-- which are telegraphed and routed through CombatRules.applyArea.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local World = require(Shared.Shared.WorldDefinitions)
local Settings = require(Shared.Shared.CombatSettings) :: any
local Weapons = require(Shared.Simulation.WeaponSchema) :: any
local Tempo = require(Shared.Simulation.Tempo) :: any
local Schema = require(Shared.Simulation.MoveSchema) :: any
local Combat = require(Shared.Simulation.CombatRules)
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local BossTactics = require(script.Parent.BossTactics)
local BossDuo = require(script.Parent.BossDuo)
local BossAppearance = require(script.Parent.BossAppearance)
local Handoff = require(script.Parent.EncounterHandoff)
local HandoffRules = require(Shared.Shared.BossHandoff)
local Bodies = require(Shared.Shared.BossBodies)
local Zones = require(Shared.Shared.MonasteryZones)
local Campaign = require(Shared.Shared.CampaignZones)

type Entity = Characters.Entity
type MobDef = World.MobDef
type BossDef = World.BossDef
type AIProfile = World.AIProfile
type Shockwave = World.Shockwave

export type Mode = "Idle" | "Patrol" | "Alert" | "Engage" | "Combat" | "StanceBroken" | "Return" | "Cinematic" | "Dead"
export type TelegraphClass = "Light" | "Heavy" | "Perilous"
export type AgentInfo = { Kind: "Mob" | "Boss", Definition: string, SpawnId: string?, Region: string, Essence: number }

type PendingAttack = { Action: "Light" | "Heavy" | "WeaponArt", At: number }
type PendingShockwave = { At: number, Wave: Shockwave, Cancelable: boolean }

type Agent = {
	Id: number,
	Kind: "Mob" | "Boss",
	Definition: string,
	SpawnId: string?,
	Region: string,
	Essence: number,
	Home: CFrame,
	Patrol: { Vector3 },
	PatrolIndex: number,
	Profile: AIProfile,
	Rng: Random,
	Mode: Mode,
	ModeSince: number,
	Target: number,
	LastSeen: number,
	LastKnown: Vector3?,
	Suspicion: number,
	NextThink: number,
	PlannedFor: number,
	DeflectAt: number,
	GuardUntil: number,
	RecomposeUntil: number,
	Pending: PendingAttack?,
	StrafeSign: number,
	StrafeUntil: number,
	-- Boss only
	Boss: BossDef?,
	Phase: number,
	Deathblows: number,
	Allowed: { [number]: boolean }?,
	Shockwave: PendingShockwave?,
	TransitionEnd: number,
	NextSpecial: number,
	HoldUntil: number, -- encounter handoff: the boss stands until readable control returns (#16)
	Pillars: { Bodies.Pillar }?, -- arena columns a long body steers around
	Clearance: number,
	Zone: Zones.Zone?, -- Monastery spawns fight only inside their zone (batch 15, #27)
}

type Noise = { Position: Vector3, Time: number }

local AIService = {}

local PLAYER_REACTION = 0.25
local PERILOUS_LEAD = 0.45
local NOISE_LIFETIME = 1.5
local LOS_HEIGHT = Vector3.new(0, 1.5, 0)
local CLOSE_DETECT = 6

local agents: { [number]: Agent } = {}
local spawnAgents: { [string]: number } = {}
local bossAgents: { [string]: number } = {}
local noises: { Noise } = {}
local bossListeners: { (bossId: string, entityId: number) -&gt; () } = {}
local disconnectors: { () -&gt; () } = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local ignoreDirty = true
local running = false

-------------------------------------------------------------------------------------------------
-- Telegraphing (pure): schedules attacks so a warning always precedes impact by a fair margin.
-------------------------------------------------------------------------------------------------

local Telegraph = {}

function Telegraph.classify(move: Combat.MoveData): TelegraphClass
	if move.Unblockable then
		return "Perilous"
	elseif move.Kind == "Heavy" or move.Kind == "WeaponArt" or move.Kind == "RunningAttack" then
		return "Heavy"
	end
	return "Light"
end

function Telegraph.lead(class: TelegraphClass, reactionFloor: number): number
	if class == "Perilous" then
		return math.max(PERILOUS_LEAD, reactionFloor)
	elseif class == "Heavy" then
		return math.max(Tempo.HeavyMinSeconds, reactionFloor)
	end
	return Tempo.LightMinSeconds
end

-- Returns (attackAt, warnAt, impactAt). The warning is published at `now`; if the move's own startup
-- is shorter than the required lead the attack itself is delayed so impact - warn &gt;= lead.
function Telegraph.plan(move: Combat.MoveData, now: number, reactionFloor: number): (number, number, number)
	local class = Telegraph.classify(move)
	local lead = Telegraph.lead(class, reactionFloor)
	local startup = move.Timing.StartupSeconds
	local attackAt = Tempo.quantizeUp(now + math.max(0, lead - startup))
	return attackAt, now, attackAt + startup
end

function Telegraph.shockwave(wave: Shockwave, now: number): (number, number)
	return now, Tempo.quantizeUp(now + math.max(wave.Windup, PERILOUS_LEAD))
end

AIService.Telegraph = table.freeze(Telegraph)

-------------------------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------------------------

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatUnit(v: Vector3): Vector3
	local f = flat(v)
	local m = f.Magnitude
	return if m &gt; 1e-5 then f / m else Vector3.zero
end

-- Where a fighting AI aims (StrikeGeometry): the target's position a short beat ahead along its
-- ground velocity, so steady circling is read while a late reversal or dodge still makes it whiff.
local function leadPoint(target: Entity): Vector3
	return target.Root.Position + flat(target.Root.AssemblyLinearVelocity) * Settings.Tracking.AimLeadSeconds
end

local function toCFrame(p: World.Placement): CFrame
	return CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, math.rad(p.Yaw), 0)
end

local function setMode(agent: Agent, mode: Mode, now: number)
	if agent.Mode == mode then
		return
	end
	agent.Mode = mode
	agent.ModeSince = now
	local e = Characters.GetEntity(agent.Id)
	if e then
		e.Model:SetAttribute("AsuraAIMode", mode)
	end
end

local function rebuildIgnore()
	local list: { Instance } = {}
	for _, e in Characters.Entities() do
		table.insert(list, e.Model)
	end
	rayParams.FilterDescendantsInstances = list
	ignoreDirty = false
end

local function lineOfSight(from: Vector3, to: Vector3): boolean
	if ignoreDirty then
		rebuildIgnore()
	end
	local direction = to - from
	return Workspace:Raycast(from, direction, rayParams) == nil
end

local function isTargetable(agent: Agent, e: Entity): boolean
	if e.Kind ~= "Player" or e.Fighter.State == "KO" or e.Respawning or e.Duel ~= nil then
		return false
	end
	local allowed = agent.Allowed
	return allowed == nil or allowed[e.Id] == true
end

local function noisy(e: Entity): boolean
	local state = e.Fighter.State
	return e.Fighter.Sprinting or state == "Startup" or state == "Active" or state == "Dashing"
end

local function reachOf(agent: Agent, f: Combat.Fighter): number
	local weapon = Weapons.get(f.Weapon)
	return weapon.Light[1].Reach + f.ReachBonus
end

-------------------------------------------------------------------------------------------------
-- Perception
-------------------------------------------------------------------------------------------------

-- Returns the best visible target and whether any target was only heard.
local function perceive(agent: Agent, self: Entity, now: number): (Entity?, Vector3?)
	local profile = agent.Profile
	local origin = self.Root.Position
	local look = flatUnit(self.Root.CFrame.LookVector)
	local cosHalf = math.cos(math.rad(profile.FieldOfView) * 0.5)
	local best: Entity? = nil
	local bestDistance = math.huge
	local heard: Vector3? = nil
	for _, e in Characters.Entities() do
		if isTargetable(agent, e) and e.Model.Parent then
			local offset = e.Root.Position - origin
			local distance = offset.Magnitude
			if distance &lt;= profile.SightRange then
				local inCone = profile.FieldOfView &gt;= 360 or distance &lt;= CLOSE_DETECT or look:Dot(flatUnit(offset)) &gt;= cosHalf
				if inCone and distance &lt; bestDistance and lineOfSight(origin + LOS_HEIGHT, e.Root.Position + LOS_HEIGHT) then
					best, bestDistance = e, distance
				end
			end
			if heard == nil and distance &lt;= profile.HearingRange and noisy(e) then
				heard = e.Root.Position
			end
		end
	end
	if heard == nil then
		for _, noise in noises do
			if now - noise.Time &lt;= NOISE_LIFETIME and (noise.Position - origin).Magnitude &lt;= profile.HearingRange then
				heard = noise.Position
				break
			end
		end
	end
	return best, heard
end

-------------------------------------------------------------------------------------------------
-- Combat behaviour
-------------------------------------------------------------------------------------------------

local function publishTelegraph(agent: Agent, move: Combat.MoveData, class: TelegraphClass, impactAt: number)
	local e = Characters.GetEntity(agent.Id)
	if e then
		e.Model:SetAttribute("AsuraTelegraph", string.format("%s|%s|%.3f", class, move.Id, impactAt))
	end
	if class ~= "Light" then
		Characters.Cue("Telegraph", agent.Id, { class = class, move = move.Id, impact = impactAt })
	end
end

local function queueAttack(agent: Agent, f: Combat.Fighter, action: "Light" | "Heavy" | "WeaponArt", now: number)
	local move = Combat.selectMove(f, action, now)
	local attackAt, _, impactAt = Telegraph.plan(move, now, PLAYER_REACTION)
	publishTelegraph(agent, move, Telegraph.classify(move), impactAt)
	if attackAt &lt;= now + 1e-6 then
		Characters.PushIntent(agent.Id, action)
	else
		agent.Pending = { Action = action, At = attackAt }
	end
end

local function react(agent: Agent, self: Entity, target: Entity, now: number)
	local f = self.Fighter
	local tf = target.Fighter
	local profile = agent.Profile
	if now &gt;= agent.DeflectAt then
		agent.DeflectAt = math.huge
		Characters.PushIntent(agent.Id, "Deflect")
	end
	if f.GuardHeld and now &gt;= agent.GuardUntil then
		Characters.SetGuard(agent.Id, false)
	end
	local move = tf.Move
	if tf.State ~= "Startup" or move == nil or tf.MoveStart == agent.PlannedFor then
		return
	end
	local distance = (target.Root.Position - self.Root.Position).Magnitude
	if distance &gt; move.Reach + tf.ReachBonus + 4 then
		return
	end
	agent.PlannedFor = tf.MoveStart
	local impact = tf.MoveStart + move.Timing.StartupSeconds
	local press = impact - f.DeflectWindow * 0.5 + agent.Rng:NextNumber(-profile.TimingJitter, profile.TimingJitter)
	local readable = press &gt;= tf.MoveStart + profile.ReactionTime
	if move.Unblockable then
		-- Perilous: deflect only (guarding is useless); otherwise evade backwards.
		if readable and agent.Rng:NextNumber() &lt; profile.DeflectChance then
			agent.DeflectAt = math.max(press, now)
		elseif f.Stamina &gt; Settings.Stamina.Costs.Dash then
			local away = flatUnit(self.Root.Position - target.Root.Position)
			Characters.PushIntent(agent.Id, "Dash", nil, away.X, away.Z)
		end
		return
	end
	if readable and agent.Rng:NextNumber() &lt; profile.DeflectChance then
		agent.DeflectAt = math.max(press, now)
	elseif agent.Rng:NextNumber() &lt; profile.GuardChance then
		agent.GuardUntil = impact + move.Timing.ActiveSeconds + 0.1
		Characters.SetGuard(agent.Id, true)
	end
end

-- Every agent walk goes through here; a long-bodied boss bends its path round the arena pillars.
local function moveTo(agent: Agent, point: Vector3)
	local pillars = agent.Pillars
	local e = if pillars and #pillars &gt; 0 then Characters.GetEntity(agent.Id) else nil
	if pillars and e then
		local x, z = Bodies.steer(e.Root.Position.X, e.Root.Position.Z, point.X, point.Z, pillars, agent.Clearance)
		point = Vector3.new(x, point.Y, z)
	end
	Characters.MoveTo(agent.Id, point)
end

-- Engage just inside attack reach, never on the target's own root (BossBodies.closeIn).
-- A Twin flanks: it never takes the engage point its living partner already holds (Bodies.flank).
local function closeIn(agent: Agent, self: Entity, target: Entity, reach: number)
	local at, to = self.Root.Position, target.Root.Position
	local x, z = Bodies.closeIn(at.X, at.Z, to.X, to.Z, reach * 0.6)
	local encounter = self.Model:GetAttribute("AsuraEncounter")
	for _, id in if type(encounter) == "string" then BossDuo.members(encounter) else {} do
		local partner = if id ~= agent.Id then Characters.GetEntity(id) else nil
		if partner and partner.Fighter.State ~= "KO" then
			local o = partner.Root.Position
			x, z = Bodies.flank(at.X, at.Z, to.X, to.Z, reach * 0.6, o.X, o.Z, 2.5 * (self.Model:GetScale() + partner.Model:GetScale()))
		end
	end
	moveTo(agent, Vector3.new(x, to.Y, z))
end

local function strafePoint(agent: Agent, self: Entity, target: Entity, spacing: number, now: number): Vector3
	if now &gt;= agent.StrafeUntil then
		agent.StrafeSign = if agent.Rng:NextNumber() &lt; 0.5 then -1 else 1
		agent.StrafeUntil = now + agent.Rng:NextNumber(1.2, 2.6)
	end
	local away = flatUnit(self.Root.Position - target.Root.Position)
	if away.Magnitude == 0 then
		away = Vector3.new(0, 0, 1)
	end
	local perpendicular = Vector3.new(-away.Z, 0, away.X) * agent.StrafeSign
	return target.Root.Position + away * spacing + perpendicular * 3
end

local function decide(agent: Agent, self: Entity, target: Entity, now: number)
	local f = self.Fighter
	local tf = target.Fighter
	local profile = agent.Profile
	local phantomUntil = target.Model:GetAttribute("PhantomUntil")
	local phantom = target.Model:GetAttribute("PhantomPosition")
	if type(phantomUntil)=="number" and now &lt; phantomUntil and typeof(phantom)=="Vector3" then
		Characters.Face(agent.Id,phantom);moveTo(agent,phantom);return
	end
	local distance = (target.Root.Position - self.Root.Position).Magnitude
	local reach = reachOf(agent, f)

	Characters.Face(agent.Id, leadPoint(target))

	if tf.State == "StanceBroken" and distance &lt;= Settings.Deathblow.Range then
		Characters.PushIntent(agent.Id, "Heavy")
		return
	end

	-- Posture management: back off and let the bar drain before it breaks.
	local postureRatio = f.Posture / math.max(Combat.maxPosture(f), 1)
	if postureRatio &gt;= profile.PostureGuard and now &gt;= agent.RecomposeUntil then
		agent.RecomposeUntil = now + agent.Rng:NextNumber(1.2, 2.0)
		if f.Stamina &gt; Settings.Stamina.Costs.Dash then
			local away = flatUnit(self.Root.Position - target.Root.Position)
			Characters.PushIntent(agent.Id, "Dash", nil, away.X, away.Z)
		end
	end
	if now &lt; agent.RecomposeUntil then
		moveTo(agent, strafePoint(agent, self, target, reach * 1.8, now))
		return
	end

	if distance &gt; reach * 0.95 then
		closeIn(agent, self, target, reach)
		return
	end

	if f.Stamina &lt; profile.RetreatStamina and agent.Rng:NextNumber() &lt; 0.3 then
		local away = flatUnit(self.Root.Position - target.Root.Position)
		Characters.PushIntent(agent.Id, "Dash", nil, away.X, away.Z)
		return
	end
	if f.GuardHeld or agent.DeflectAt &lt; math.huge or agent.Pending ~= nil then
		Characters.StopMoving(agent.Id)
		return
	end

	local comboOpen = Combat.comboWindowOpen(f, now)
	if f.State ~= "Idle" and not comboOpen then
		return
	end
	if comboOpen then
		if agent.Rng:NextNumber() &lt;= profile.ComboContinueChance then
			queueAttack(agent, f, "Light", now)
		end
		return
	end
	if agent.Rng:NextNumber() &lt; profile.StrafeChance * (1 - profile.Aggression) then
		moveTo(agent, strafePoint(agent, self, target, reach * 0.8, now))
		return
	end
	Characters.StopMoving(agent.Id)
	if agent.Rng:NextNumber() &gt; profile.Aggression then
		return
	end
	local weapon = Weapons.get(f.Weapon)
	local roll = agent.Rng:NextNumber()
	if roll &lt; profile.ArtChance and f.Qi &gt;= weapon.WeaponArt.QiCost then
		queueAttack(agent, f, "WeaponArt", now)
	elseif roll &lt; profile.ArtChance + profile.HeavyChance then
		queueAttack(agent, f, "Heavy", now)
	else
		queueAttack(agent, f, "Light", now)
	end
end

-------------------------------------------------------------------------------------------------
-- Boss multi-phase manager
-------------------------------------------------------------------------------------------------

local function scheduleShockwave(agent: Agent, wave: Shockwave, now: number, cancelable: boolean, earliest: number?)
	local _, impactAt = Telegraph.shockwave(wave, now)
	impactAt = math.max(impactAt, earliest or impactAt) -- never inside an encounter handoff
	agent.Shockwave = { At = impactAt, Wave = wave, Cancelable = cancelable }
	Characters.Cue("Telegraph", agent.Id, { class = "Perilous", move = "Shockwave", impact = impactAt, radius = wave.Radius })
	local e = Characters.GetEntity(agent.Id)
	if e then
		e.Model:SetAttribute("AsuraTelegraph", string.format("Perilous|Shockwave|%.3f", impactAt))
	end
end

local function releaseShockwave(agent: Agent, self: Entity)
	local pending = agent.Shockwave
	agent.Shockwave = nil
	if not pending then
		return
	end
	local wave = pending.Wave
	local origin = self.Root.Position
	Characters.Cue("Shockwave", agent.Id, { radius = wave.Radius, x = origin.X, y = origin.Y, z = origin.Z })
	for _, e in Characters.Entities() do
		if e.Kind == "Player" and agent.Allowed and agent.Allowed[e.Id] and e.Model.Parent and e.Root.Position.Y - 3 &lt;= 6 and (e.Root.Position - origin).Magnitude &lt;= wave.Radius then
			Characters.ApplyArea(agent.Id, e.Id, wave.Damage, wave.Posture, wave.Unblockable)
		end
	end
end

local function applyPhase(agent: Agent, boss: BossDef, index: number, self: Entity)
	local phase = boss.Phases[index]
	agent.Phase = index
	agent.Profile = phase.AI
	agent.Deathblows = 0
	Characters.ForceWeapon(agent.Id, phase.Weapon)
	Characters.ApplyStats(agent.Id, phase.Stats, false)
	local f = self.Fighter
	f.Posture = 0
	f.KOProtected = index &lt; #boss.Phases
	if phase.Transition then
		Characters.Tint(agent.Id, phase.Transition.BodyColor)
	end
	BossAppearance.phase(self.Model, phase.AnimationSet, index)
	self.Model:SetAttribute("AsuraBossPhases", #boss.Phases)
	self.Model:SetAttribute("AsuraBossPhase", index)
	self.Model:SetAttribute("AsuraBossPhaseName", phase.Name)
end

local function beginTransition(agent: Agent, boss: BossDef, index: number, self: Entity, now: number)
	local phase = boss.Phases[index]
	local transition = phase.Transition
	BossTactics.reset(agent.Id)
	agent.Pending = nil
	agent.DeflectAt = math.huge
	if not transition then
		applyPhase(agent, boss, index, self)
		return
	end
	setMode(agent, "Cinematic", now)
	Characters.Cinematic(agent.Id, transition.Duration)
	-- The metamorphosis takes the camera: participants are locked and protected for the shot, and
	-- the unblockable wave lands no sooner than BossHandoff.Lead after control returns.
	local participants: { number } = {}
	local allowed: { [number]: boolean } = agent.Allowed or {}
	for id in allowed do table.insert(participants, id) end
	local window = Handoff.begin(boss.Id, "Phase", participants)
	Characters.Cue("BossPhase", agent.Id, { boss = boss.Id, phase = index, name = phase.Name, duration = transition.Duration,
		shot = HandoffRules.shot("Phase"), participants = participants })
	scheduleShockwave(agent, transition.Shockwave, now, false, HandoffRules.earliest(window))
	BossAppearance.phase(self.Model, phase.AnimationSet, index) -- the body changes under the camera; the moveset at the end
	agent.TransitionEnd = now + transition.Duration
	agent.Phase = index
end

local function finishTransition(agent: Agent, boss: BossDef, self: Entity, now: number)
	applyPhase(agent, boss, agent.Phase, self)
	agent.TransitionEnd = math.huge
	local special = boss.Phases[agent.Phase].Special
	agent.NextSpecial = if special then now + agent.Rng:NextNumber(special.IntervalMin, special.IntervalMax) else math.huge
	setMode(agent, "Combat", now)
end

local function updateBoss(agent: Agent, boss: BossDef, self: Entity, now: number): boolean
	local f = self.Fighter
	if agent.TransitionEnd &lt; math.huge then
		if agent.Shockwave and now &gt;= agent.Shockwave.At then
			releaseShockwave(agent, self)
		end
		if now &gt;= agent.TransitionEnd then
			finishTransition(agent, boss, self, now)
		end
		return true
	end
	if f.State ~= "DeathblowVictim" and f.State ~= "KO" then
		local fraction = f.ActiveHP / math.max(f.MaxHP, 1)
		local nextPhase = World.phaseFor(boss, agent.Phase, fraction, agent.Deathblows)
		if nextPhase &gt; agent.Phase then
			beginTransition(agent, boss, nextPhase, self, now)
			return true
		end
	end
	local pending = agent.Shockwave
	if pending then
		if pending.Cancelable and (Schema.isStunned(f.State) or f.State == "KO") then
			agent.Shockwave = nil
		elseif now &gt;= pending.At then
			releaseShockwave(agent, self)
		end
		return pending ~= nil and agent.Shockwave ~= nil
	end
	if now &lt; agent.HoldUntil then
		agent.Pending = nil
		Characters.StopMoving(agent.Id)
		return true
	end
	if BossTactics.step(agent.Id, boss, agent.Phase, agent.Target, agent.Allowed, now) then
		agent.Pending = nil
		return true
	end
	local special = boss.Phases[agent.Phase].Special
	if special and now &gt;= agent.NextSpecial and f.State == "Idle" and agent.Mode == "Combat" then
		agent.NextSpecial = now + agent.Rng:NextNumber(special.IntervalMin, special.IntervalMax)
		Characters.StopMoving(agent.Id)
		scheduleShockwave(agent, special.Shockwave, now, true)
		return true
	end
	return false
end

-------------------------------------------------------------------------------------------------
-- Agent loop
-------------------------------------------------------------------------------------------------

local function update(agent: Agent, now: number)
	local self = Characters.GetEntity(agent.Id)
	if not self then
		return
	end
	local f = self.Fighter
	if f.State == "KO" then
		setMode(agent, "Dead", now)
		return
	end

	local boss = agent.Boss
	if boss and updateBoss(agent, boss, self, now) then
		return
	end

	if f.State == "StanceBroken" or f.State == "DeathblowVictim" then
		if agent.Mode ~= "StanceBroken" then
			agent.Pending = nil
			agent.DeflectAt = math.huge
			setMode(agent, "StanceBroken", now)
		end
		return
	elseif agent.Mode == "StanceBroken" then
		setMode(agent, "Combat", now)
	end

	local pending = agent.Pending
	if pending and now &gt;= pending.At then
		agent.Pending = nil
		Characters.PushIntent(agent.Id, pending.Action)
	end

	local target = if agent.Target ~= 0 then Characters.GetEntity(agent.Target) else nil
	if target and not isTargetable(agent, target) then
		target = nil
		agent.Target = 0
	end
	if target and (agent.Mode == "Combat" or agent.Mode == "Engage") then
		react(agent, self, target, now)
	end

	if now &lt; agent.NextThink then
		return
	end
	local profile = agent.Profile
	agent.NextThink = now + 1 / profile.ThinkRate

	local homeDistance = (self.Root.Position - agent.Home.Position).Magnitude
	-- Zone leash: a foe whose target leaves its zone (walls, the safe landing, the far bridgehead)
	-- breaks off instead of chasing; the distance leash still applies inside it.
	local zone = agent.Zone
	local fled = false
	if zone and agent.Target ~= 0 then
		local foe = Characters.GetEntity(agent.Target)
		fled = foe ~= nil and not Zones.contains(zone, foe.Root.Position.X, foe.Root.Position.Z, Zones.Grace)
	end
	if agent.Mode ~= "Return" and (homeDistance &gt; profile.LeashRange or fled) then
		agent.Target = 0
		Characters.SetGuard(agent.Id, false)
		Characters.SetSprint(agent.Id, false)
		setMode(agent, "Return", now)
	end

	if agent.Mode == "Return" then
		moveTo(agent, agent.Home.Position)
		if homeDistance &lt;= 4 then
			Characters.RestoreFighter(agent.Id)
			setMode(agent, if #agent.Patrol &gt; 0 then "Patrol" else "Idle", now)
		end
		return
	end

	local seen, heard = perceive(agent, self, now)
	if seen and zone and not Zones.contains(zone, seen.Root.Position.X, seen.Root.Position.Z, Zones.Grace) then
		seen = nil -- noticed from beyond the zone: not worth leaving it for
	end
	if seen then
		agent.LastSeen = now
		agent.LastKnown = seen.Root.Position
	end

	if agent.Mode == "Idle" or agent.Mode == "Patrol" then
		if seen then
			agent.Target = seen.Id
			local close = (seen.Root.Position - self.Root.Position).Magnitude &lt;= CLOSE_DETECT
			agent.Suspicion = if close then 1 else 0
			setMode(agent, if close then "Engage" else "Alert", now)
		elseif heard then
			agent.LastKnown = heard
			agent.Suspicion = 0
			setMode(agent, "Alert", now)
		elseif agent.Mode == "Idle" and #agent.Patrol &gt; 0 and now - agent.ModeSince &gt; agent.Rng:NextNumber(1, 3) then
			setMode(agent, "Patrol", now)
		elseif agent.Mode == "Patrol" then
			local point = agent.Patrol[agent.PatrolIndex]
			if (flat(self.Root.Position - point)).Magnitude &lt;= 2.5 then
				agent.PatrolIndex = agent.PatrolIndex % #agent.Patrol + 1
				setMode(agent, "Idle", now)
				Characters.StopMoving(agent.Id)
			else
				moveTo(agent, point)
			end
		end
		return
	end

	if agent.Mode == "Alert" then
		local known = agent.LastKnown
		if known then
			Characters.Face(agent.Id, known)
		end
		if seen then
			agent.Target = seen.Id
			agent.Suspicion += (1 / profile.ThinkRate) / math.max(profile.AlertTime, 0.05)
			if agent.Suspicion &gt;= 1 then
				setMode(agent, "Engage", now)
			end
		elseif known then
			agent.Suspicion += (0.5 / profile.ThinkRate) / math.max(profile.AlertTime, 0.05)
			moveTo(agent, known)
		end
		if not seen and now - math.max(agent.LastSeen, agent.ModeSince) &gt; profile.SearchTime then
			setMode(agent, "Return", now)
		end
		return
	end

	if not target then
		target = seen
		agent.Target = if seen then seen.Id else 0
	end
	if not target then
		if now - agent.LastSeen &gt; profile.SearchTime then
			Characters.SetSprint(agent.Id, false)
			setMode(agent, "Return", now)
		elseif agent.LastKnown then
			moveTo(agent, agent.LastKnown :: Vector3)
		end
		return
	end

	local distance = (target.Root.Position - self.Root.Position).Magnitude
	local reach = reachOf(agent, f)
	if agent.Mode == "Engage" then
		Characters.Face(agent.Id, target.Root.Position)
		closeIn(agent, self, target, reach)
		Characters.SetSprint(agent.Id, distance &gt; reach * 3 and f.Stamina &gt; profile.RetreatStamina * 2)
		if distance &lt;= reach * 1.1 then
			Characters.SetSprint(agent.Id, false)
			setMode(agent, "Combat", now)
		end
		return
	end

	if agent.Mode == "Combat" then
		if distance &gt; reach * 1.8 then
			setMode(agent, "Engage", now)
			return
		end
		decide(agent, self, target, now)
	end
end

local function newAgent(entityId: number, kind: "Mob" | "Boss", definition: string, profile: AIProfile, region: string, essence: number, home: CFrame, patrol: { Vector3 }): Agent
	local agent: Agent = {
		Id = entityId,
		Kind = kind,
		Definition = definition,
		SpawnId = nil,
		Region = region,
		Essence = essence,
		Home = home,
		Patrol = patrol,
		PatrolIndex = 1,
		Profile = profile,
		Rng = Random.new(math.abs(entityId) * 7919 + os.time()),
		Mode = if #patrol &gt; 0 then "Patrol" else "Idle",
		ModeSince = Characters.Now(),
		Target = 0,
		LastSeen = -math.huge,
		LastKnown = nil,
		Suspicion = 0,
		NextThink = Characters.Now(),
		PlannedFor = -math.huge,
		DeflectAt = math.huge,
		GuardUntil = -math.huge,
		RecomposeUntil = -math.huge,
		Pending = nil,
		StrafeSign = 1,
		StrafeUntil = -math.huge,
		Boss = nil,
		Phase = 1,
		Deathblows = 0,
		Allowed = nil,
		Shockwave = nil,
		TransitionEnd = math.huge,
		NextSpecial = math.huge,
		HoldUntil = -math.huge,
		Pillars = nil,
		Clearance = 0,
		Zone = nil,
	}
	agents[entityId] = agent
	return agent
end

-------------------------------------------------------------------------------------------------
-- Spawning
-------------------------------------------------------------------------------------------------

function AIService.SpawnMob(spawnId: string): number?
	local existing = spawnAgents[spawnId]
	if existing and agents[existing] and Characters.GetEntity(existing) then
		return existing
	end
	local entry = World.spawnById(spawnId)
	if not entry then
		warn("[AIService] Unknown spawn " .. spawnId)
		return nil
	end
	local mob = World.Mobs[entry.Mob]
	local home = toCFrame(entry.Placement)
	local id = Characters.SpawnEnemy({
		Name = mob.Name,
		Weapon = mob.Weapon,
		CFrame = home,
		Stats = mob.Stats,
		Definition = mob.Id,
		BodyColor = mob.BodyColor,
	})
	if not id then
		return nil
	end
	local patrol: { Vector3 } = {}
	for _, point in entry.Patrol do
		table.insert(patrol, Vector3.new(point.X, point.Y, point.Z))
	end
	local agent = newAgent(id, "Mob", mob.Id, mob.AI, entry.Region, mob.Essence, home, patrol)
	agent.SpawnId = spawnId
	local zoneId = Zones.Spawns[spawnId]
	-- Campaign regions (batches 17-21) leash their foes the same way, to their layout zone.
	agent.Zone = if zoneId then Zones.get(zoneId) else Campaign.zoneForSpawn(spawnId) :: any
	spawnAgents[spawnId] = id
	return id
end

function AIService.ResetMob(spawnId: string): boolean
	local id = spawnAgents[spawnId]
	local agent = if id then agents[id] else nil
	if not id or not agent or not Characters.GetEntity(id) then
		return false
	end
	Characters.SetGuard(id, false)
	Characters.Teleport(id, agent.Home)
	Characters.RestoreFighter(id)
	agent.Target = 0
	agent.Pending = nil
	agent.DeflectAt = math.huge
	agent.PatrolIndex = 1
	setMode(agent, if #agent.Patrol &gt; 0 then "Patrol" else "Idle", Characters.Now())
	return true
end

-- Respawns every non-boss mob in a region. Engaged mobs can be left alone so another player's
-- fight is not reset underneath them.
function AIService.RespawnRegion(region: string, skipEngaged: boolean)
	for _, entry in World.Spawns do
		if entry.Region == region then
			local id = spawnAgents[entry.Id]
			local agent = if id then agents[id] else nil
			local entity = if id then Characters.GetEntity(id) else nil
			if agent and entity and entity.Fighter.State ~= "KO" then
				local engaged = agent.Mode == "Engage" or agent.Mode == "Combat" or agent.Mode == "StanceBroken"
				if not (skipEngaged and engaged) then
					AIService.ResetMob(entry.Id)
				end
			else
				if id and entity then
					Characters.DespawnEnemy(id)
				end
				spawnAgents[entry.Id] = nil
				AIService.SpawnMob(entry.Id)
			end
		end
	end
end

function AIService.SpawnBoss(bossId: string, participants: { number }?): number?
	local existing = bossAgents[bossId]
	if existing then
		local living = BossDuo.alive(bossId)
		if living then return living end
		AIService.DespawnBoss(bossId)
	end
	local boss = World.Bosses[bossId]
	if not boss then
		warn("[AIService] Unknown boss " .. bossId)
		return nil
	end
	local opening = boss.Phases[1]
	local home = toCFrame(boss.Spawn)
	local id = Characters.SpawnEnemy({
		Name = boss.Name,
		Weapon = opening.Weapon,
		CFrame = home,
		Stats = opening.Stats,
		Definition = boss.Id,
		BodyColor = boss.BodyColor,
		Boss = true,
	})
	if not id then
		return nil
	end
	local agent = newAgent(id, "Boss", boss.Id, opening.AI, boss.Region, boss.Essence, home, {})
	agent.Boss = boss
	agent.Mode = "Engage"
	agent.Pillars = Bodies.pillars(boss)
	local hull = (Bodies.Hulls :: any)[boss.Archetype]
	agent.Clearance = if hull then hull[3] * 0.5 * (boss.Scale or 1) + 0.5 else 0

	local entity = Characters.GetEntity(id)
	if entity then
		applyPhase(agent, boss, 1, entity)
		entity.Model:SetAttribute("AsuraBossTitle", boss.Title)
		entity.Model:SetAttribute("AsuraEncounter", boss.Id)
		BossAppearance.apply(entity.Model, boss.Archetype, boss.Scale)
	end
	bossAgents[bossId] = id
	local members = { id }
	local partner = boss.Partner
	if partner then
		local partnerId = Characters.SpawnEnemy({ Name = partner.Name, Weapon = partner.Weapon, CFrame = home * CFrame.new(16, 0, 0),
			Stats = partner.Stats, Definition = boss.Id, BodyColor = { 100, 88, 68 }, Boss = true })
		if not partnerId then
			agents[id] = nil; bossAgents[bossId] = nil; Characters.DespawnEnemy(id)
			return nil
		end
		local partnerBoss = table.clone(boss)
		local partnerPhase = table.clone(opening)
		partnerPhase.Weapon, partnerPhase.Stats, partnerPhase.Attacks = partner.Weapon, partner.Stats, partner.Attacks
		partnerPhase.AI = table.clone(opening.AI)
		partnerPhase.AI.Aggression, partnerPhase.AI.GuardChance, partnerPhase.AI.DeflectChance = 0.5, 0.95, 0.05
		partnerPhase.AttackInterval = 4
		partnerBoss.Phases, partnerBoss.Partner = { partnerPhase }, nil
		local ally = newAgent(partnerId, "Boss", boss.Id, partnerPhase.AI, boss.Region, 0, home * CFrame.new(16, 0, 0), {})
		ally.Boss, ally.Mode = partnerBoss, "Engage"
		local partnerEntity = Characters.GetEntity(partnerId)
		if partnerEntity then
			applyPhase(ally, partnerBoss, 1, partnerEntity)
			partnerEntity.Model:SetAttribute("AsuraEncounter", boss.Id)
			BossAppearance.apply(partnerEntity.Model, "IronBull", partner.Scale)
		end
		table.insert(members, partnerId)
	end
	BossDuo.register(boss, members)
	if participants then AIService.SetBossTargets(bossId, participants) end
	-- Entry handoff: everyone locked and protected through the framing shot and the camera's return.
	local shot = if participants and #participants &gt; 0 then HandoffRules.shot("Intro") else nil
	if participants and shot then Handoff.begin(boss.Id, "Intro", participants, members) end
	Characters.Cue("BossIntro", id, { boss = boss.Id, title = boss.Title, phase = 1, name = opening.Name, members = members, participants = participants, shot = shot })
	return id
end

-- Holds a boss's actors still until `untilTime` (+ half the readable lead) and keeps their first
-- scheduled attack after it; EncounterHandoff calls this through SetHolder.
function AIService.Hold(bossId: string, untilTime: number)
	for _, id in BossDuo.members(bossId) do
		local agent = agents[id]
		if agent then
			agent.HoldUntil = untilTime + HandoffRules.Lead * 0.5
			BossTactics.hold(id, untilTime)
		end
	end
end
Handoff.SetHolder(AIService.Hold)

function AIService.SetBossTargets(bossId: string, participants: { number })
	for _, id in BossDuo.members(bossId) do
		local agent = agents[id]
		if not agent then continue end
		local allowed: { [number]: boolean } = {}
		for _, participant in participants do allowed[participant] = true end
		agent.Allowed = allowed
		if agent.Target ~= 0 and not allowed[agent.Target] then agent.Target = 0 end
	end
end

function AIService.DespawnBoss(bossId: string)
	local members = table.clone(BossDuo.members(bossId))
	Handoff.forget(bossId)
	BossDuo.forget(bossId)
	bossAgents[bossId] = nil
	for _, id in members do agents[id] = nil; Characters.DespawnEnemy(id) end
end

function AIService.GetBossEntity(bossId: string): number?
	return BossDuo.alive(bossId)
end

function AIService.GetAgent(entityId: number): AgentInfo?
	local agent = agents[entityId]
	if not agent then
		return nil
	end
	return { Kind = agent.Kind, Definition = agent.Definition, SpawnId = agent.SpawnId, Region = agent.Region, Essence = agent.Essence }
end

function AIService.GetMode(entityId: number): Mode?
	local agent = agents[entityId]
	return if agent then agent.Mode else nil
end

-- True while any agent is actively fighting or chasing this player (blocks resting at an altar).
function AIService.IsHunting(playerId: number): boolean
	for _, agent in agents do
		if agent.Target == playerId and (agent.Mode == "Engage" or agent.Mode == "Combat" or agent.Mode == "Cinematic") then
			return true
		end
	end
	return false
end

function AIService.OnBossDefeated(listener: (bossId: string, entityId: number) -&gt; ()): () -&gt; ()
	table.insert(bossListeners, listener)
	return function()
		local index = table.find(bossListeners, listener)
		if index then
			table.remove(bossListeners, index)
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

local function onEvent(event: Combat.Event, point: Vector3?)
	if point and (event.Kind == "Hit" or event.Kind == "DeflectSpark" or event.Kind == "Block" or event.Kind == "CounterHit" or event.Kind == "GuardBreak") then
		table.insert(noises, { Position = point, Time = Characters.Now() })
		if #noises &gt; 32 then
			table.remove(noises, 1)
		end
	end
	local victim = agents[event.Target]
	if not victim then
		return
	end
	if event.Kind == "Deathblow" and victim.Boss then
		victim.Deathblows += 1
		local e = Characters.GetEntity(victim.Id)
		local final = e ~= nil and e.Fighter.PendingKO
		for _, member in BossDuo.members(victim.Boss.Id) do
			local other = Characters.GetEntity(member)
			if member ~= victim.Id and other and other.Fighter.State ~= "KO" then final = false end
		end
		if final then Characters.Cue("BossFinish", victim.Id, { boss = victim.Boss.Id }) end
	elseif (event.Kind == "Hit" or event.Kind == "CounterHit") and victim.Mode ~= "Combat" and victim.Mode ~= "Cinematic" then
		local source = Characters.GetEntity(event.Source)
		if source and isTargetable(victim, source) then
			victim.Target = source.Id
			victim.LastSeen = Characters.Now()
			victim.LastKnown = source.Root.Position
			setMode(victim, "Engage", Characters.Now())
		end
	elseif event.Kind == "KO" then
		setMode(victim, "Dead", Characters.Now())
		local boss = victim.Boss
		local won, oath = false, nil
		if boss then won, oath = BossDuo.onKO(boss.Id, victim.Id) end
		if boss and oath then
			local participants: { number } = {}
			local allowed: { [number]: boolean } = victim.Allowed or {}
			for id in allowed do table.insert(participants, id) end
			Handoff.begin(boss.Id, "Enrage", participants)
		end
		if boss and won then

			for _, listener in table.clone(bossListeners) do
				local ok, problem = pcall(listener, boss.Id, victim.Id)
				if not ok then
					warn("[AIService] Boss listener failed: " .. tostring(problem))
				end
			end
		end
	end
end

local function onRemoved(id: number, _kind: Characters.EntityKind)
	ignoreDirty = true
	local agent = agents[id]
	if not agent then
		return
	end
	BossTactics.reset(id)
	agents[id] = nil
	if agent.SpawnId and spawnAgents[agent.SpawnId] == id then
		spawnAgents[agent.SpawnId] = nil
	end
	local boss = agent.Boss
	if boss and bossAgents[boss.Id] == id then
		bossAgents[boss.Id] = BossDuo.alive(boss.Id)
	end
end

local function onAdded(id: number, kind: Characters.EntityKind)
	ignoreDirty = true
	if kind ~= "Enemy" or agents[id] then
		return
	end
	-- Hand-placed tagged models carry a Definition attribute naming a mob archetype.
	task.defer(function()
		if agents[id] then
			return
		end
		local e = Characters.GetEntity(id)
		if not e then
			return
		end
		local definition = e.Definition
		local mob = if definition then World.Mobs[definition] else nil
		if not mob then
			return
		end
		Characters.ApplyStats(id, mob.Stats, true)
		local position = e.Root.Position
		local region = World.regionAt(position.X, position.Y, position.Z) or "DesecratedMonastery"
		newAgent(id, "Mob", mob.Id, mob.AI, region, mob.Essence, e.Root.CFrame, {})
	end)
end

function AIService.Start()
	assert(not running, "AIService already started")
	running = true
	table.insert(disconnectors, Characters.OnStep(function(now: number, _dt: number)
		for i = #noises, 1, -1 do
			if now - noises[i].Time &gt; NOISE_LIFETIME then
				table.remove(noises, i)
			end
		end
		for _, agent in agents do
			update(agent, now)
		end
	end))
	table.insert(disconnectors, Characters.Subscribe(onEvent))
	table.insert(disconnectors, Characters.OnEntityRemoved(onRemoved))
	table.insert(disconnectors, Characters.OnEntityAdded(onAdded))
end

function AIService.Destroy()
	for bossId in table.clone(bossAgents) do AIService.DespawnBoss(bossId) end
	running = false
	for _, disconnect in disconnectors do
		disconnect()
	end
	table.clear(disconnectors)
	for id in agents do
		Characters.DespawnEnemy(id)
	end
	table.clear(agents)
	table.clear(spawnAgents)
	table.clear(bossAgents)
	table.clear(noises)
end

return AIService
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">ArenaLighting</string>
            <string name="Source">--!strict
-- Corner braziers give each arena its firelight; overhead fill lanterns (ArenaLightPlan) keep the
-- whole floor and both fighters readable in the arena's biome colour. Clients retint braziers.
local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage").AsurasPath.Shared
local World = require(Shared.WorldDefinitions)
local Plan = require(Shared.ArenaLightPlan)
local Profiles = require(Shared.EnvironmentProfiles)
local Pbr = require(script.Parent.PbrAssets)
local Lighting = {}
local function anchor(folder: Instance, name: string, at: Vector3): Part
	local part=Instance.new("Part")
	part.Name,part.Size,part.Position,part.Transparency=name,Vector3.one*0.1,at,1
	part.Anchored,part.CanCollide,part.CanQuery,part.CanTouch,part.CastShadow=true,false,false,false,false
	part.Parent=folder
	return part
end
function Lighting.Build(): Folder
	local old = workspace:FindFirstChild("AsuraArenaLighting")
	if old then old:Destroy() end
	local folder = Instance.new("Folder"); folder.Name,folder.Parent="AsuraArenaLighting",workspace
	for _, boss in World.Bosses do
		for i, at in Plan.braziers(boss.Arena) do
			Pbr.place(folder,"AsuraFirePit",CFrame.new(at),5,"Longest")
			local light=Instance.new("PointLight")
			light.Color,light.Range,light.Brightness,light.Shadows=Profiles.arena(boss.Region).Brazier,Plan.Brazier.Range,Plan.Brazier.Brightness,i&lt;=2
			light.Parent=anchor(folder,"ArenaBrazierLight",at+Vector3.yAxis*Plan.Brazier.Height);CollectionService:AddTag(light,"AsuraArenaLight")
		end
		for _, at in Plan.fills(boss.Arena) do
			local light=Instance.new("PointLight")
			light.Color,light.Range,light.Brightness,light.Shadows=Profiles.arena(boss.Region).Fill,Plan.Fill.Range,Plan.Fill.Brightness,false
			light.Parent=anchor(folder,"ArenaFillLight",at);CollectionService:AddTag(light,"AsuraArenaFill")
		end
	end
	return folder
end
return Lighting
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">BambooDressing</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/BambooDressing
-- Bamboo Pass silhouettes and storytelling (batch 17). All decor: the thicket groves that read as the
-- pass's walls, frost-capped karst spires beyond them, the Bamboo Gate's lacquered torii lintels, the
-- whispering shrine's roof and wind ribbons, a fallen jade-root giant by tablet V, a pilgrim's hat and
-- staff where the first swordsman waits, the frost ridge's snow drifts and the moon gate's ring.
-- Collision lives in BambooPassLayout only.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Decor = require(script.Parent:WaitForChild("RegionDecor") :: ModuleScript)

local Dressing = {}
local P = Kit.Palette
local M = Enum.Material
local rgb = Color3.fromRGB
local FROST = rgb(222, 230, 234)

local function spire(parent: Instance, x: number, z: number, height: number, rng: Random)
	local base = CFrame.new(x, -2, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
	local tower = Decor.kit("Karst", rng)
	if tower then -- fluted, frost-capped limestone tower (tools/blender/bamboo_karst_kit.py)
		Decor.placeKit(parent, tower, "Karst", base * CFrame.new(0, -4, 0), height + 4)
		return
	end
	local width = height * rng:NextNumber(0.22, 0.32)
	Kit.part(parent, "KarstSpire", Vector3.new(width, height, width * 0.8), base * CFrame.new(0, height / 2, 0)
		* CFrame.Angles(math.rad(rng:NextNumber(-4, 4)), 0, math.rad(rng:NextNumber(-4, 4))), rgb(84, 88, 92), M.Rock, Kit.decor())
	Kit.part(parent, "FrostCap", Vector3.new(width * 0.9, 3, width * 0.7), base * CFrame.new(0, height - 0.5, 0), FROST, M.Snow, Kit.decor())
end

function Dressing.Build(map: Instance, layout: any, rng: Random)
	local groves = Kit.folder("BambooGroves", map)
	for _, grove in layout.Groves or {} do
		Decor.scatter(grove, rng, function(x, floor, z)
			Decor.bamboo(groves, x, floor, z, rng)
		end)
	end
	local set = Kit.folder("PassDressing", map)
	-- Karst spires beyond the thicket: the pass's skyline on both sides.
	for i = 0, 9 do
		local z = -1160 - i * 54
		spire(set, -186 + rng:NextNumber(-8, 8), z, rng:NextNumber(60, 110), rng)
		spire(set, 186 + rng:NextNumber(-8, 8), z - 20, rng:NextNumber(60, 110), rng)
	end
	-- Bamboo Gate: two lacquered lintels on the posts (x +/-9, z -1150), a weathered name board.
	Kit.part(set, "ToriiKasagi", Vector3.new(26, 1.4, 2), CFrame.new(0, 16.6, -1150), P.Lacquer, M.Wood, Kit.decor())
	Kit.part(set, "ToriiNuki", Vector3.new(21, 0.9, 1.2), CFrame.new(0, 13.4, -1150), P.WoodDark, M.Wood, Kit.decor())
	Kit.part(set, "GateBoard", Vector3.new(3, 2.4, 0.4), CFrame.new(0, 15, -1149.4), P.WoodDark, M.Wood, Kit.decor())
	-- The fallen jade-root giant beside tablet V (outside the veil, seen from the path).
	Kit.part(set, "JadeRootGiant", Vector3.new(38, 6, 6), CFrame.new(-56, 2.9, -1150) * CFrame.Angles(0, math.rad(68), 0),
		rgb(96, 128, 98), M.Wood, { Collide = false, Query = false, Shadow = true, Shape = Enum.PartType.Cylinder })
	-- A pilgrim's hat and staff where the first swordsman waits.
	Kit.part(set, "PilgrimHat", Vector3.new(0.5, 3.2, 3.2), CFrame.new(-4, 0.3, -1200) * CFrame.Angles(0, 0, math.rad(90)), rgb(150, 128, 86), M.Fabric,
		{ Collide = false, Query = false, Shadow = true, Shape = Enum.PartType.Cylinder })
	Kit.beam(set, "PilgrimStaff", Vector3.new(-6, 0.2, -1197), Vector3.new(-2, 0.5, -1205), 0.25, P.WoodDark)
	-- The whispering shrine: roof over its back screen, wind ribbons, a bronze bell.
	Decor.roof(set, CFrame.new(-36, 9.2, -1346), 22, 8, 2.4)
	for k = 0, 5 do
		local x = -45 + k * 3.6
		Kit.part(set, "WindRibbon", Vector3.new(0.5, 3.2, 0.05), CFrame.new(x, 7, -1344.6) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-8, 8))),
			if k % 2 == 0 then P.Lacquer else rgb(214, 204, 176), M.Fabric, Kit.decor())
	end
	local bell = Kit.part(set, "ShrineBell", Vector3.new(1.6, 2, 1.6), CFrame.new(-28, 7.2, -1344.4), rgb(112, 91, 57), M.Metal, Kit.decor())
	bell.Shape = Enum.PartType.Ball
	-- Frost ridge: snow drifts, frost on the stones, mist pooling in the arena basin below.
	for _ = 1, 14 do
		Kit.part(set, "SnowDrift", Vector3.new(rng:NextNumber(6, 14), 0.6, rng:NextNumber(4, 10)),
			CFrame.new(rng:NextNumber(110, 156), 18.15, rng:NextNumber(-1296, -1388)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), FROST, M.Snow, Kit.decor())
	end
	for _, x in { -30, -18, 18, 28 } do
		Kit.part(set, "SnowDrift", Vector3.new(8, 0.6, 5), CFrame.new(x, 12.15, -1270 + rng:NextNumber(-12, 12)), FROST, M.Snow, Kit.decor())
	end
	Fx.mist(set, CFrame.new(0, 4, -1470), Vector3.new(170, 6, 170), 3, 26, FROST)
	Fx.mist(set, CFrame.new(-120, 6, -1250), Vector3.new(120, 8, 220), 2, 30)
	-- Moon gate: a half ring of stone voussoirs springing from the jambs (decor; the jambs are the layout's).
	for k = 0, 12 do
		local a = math.rad(k * 15)
		Kit.part(set, "MoonRing", Vector3.new(4.6, 2, 3), CFrame.new(math.cos(a) * 17, 18 + math.sin(a) * 17, -1577) * CFrame.Angles(0, 0, a + math.pi / 2),
			P.Stone, M.Slate, Kit.decor())
	end
	-- Baize's palisade: frost-rimed caps and torn prayer flags along its top.
	for z = -1386, -1556, -34 do
		Decor.banner(set, CFrame.new(-104, 9.5, z) * CFrame.Angles(0, math.rad(90), 0), 5, rgb(214, 204, 176))
	end
end

return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">BossAppearance</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/BossAppearance
-- Dresses each boss actor in its authored look (batches 11-13) before scaling it, so costume,
-- hull and rewound hurtboxes scale together; creatures also swap the upright humanoid hurtbox for
-- their BossBodies shape. Replaces the old neon gear blocks. A production skin (BossSkin) still
-- overrides the look when a valid template is imported; the look is the diagnosed fallback.
local PhysicsService = game:GetService("PhysicsService")
local ServerStorage = game:GetService("ServerStorage")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared
local Characters = require(script.Parent.CharacterService)
local Kit = require(script.Parent.CostumeKit)
local Bodies = require(Shared.BossBodies)
local Schema = require(Shared.CostumeSchema)
local AnimationRules = require(Shared.BossAnimationRules)

local Appearance = {}
Appearance.HullGroup, Appearance.WorldGroup = "AsuraCreatureHull", "WorldGeometry"

local LOOKS: { [string]: Schema.Look } = {}
for _, source in { "LooksDuelists", "LooksBeasts", "LooksSovereigns" } do
	for key, look in require(Shared:WaitForChild(source) :: ModuleScript) :: any do LOOKS[key] = look end
end
-- Archetype -&gt; look key; the Twins' partner is dressed as "IronBull".
Appearance.Keys = table.freeze({ Duelist = "GrandmasterShen", Duo = "GeneralZhao", IronBull = "IronBull", Beast = "VenerableBaize",
	Colossus = "SlumberingTitan", Sorcerer = "SovereignWu", Dragon = "AzureWyrm" })

function Appearance.look(archetype: string?): Schema.Look?
	local key = if archetype then Appearance.Keys[archetype] else nil
	return if key then LOOKS[key] else nil
end

local function registerGroups()
	pcall(function()
		for _, name in { Appearance.HullGroup, Appearance.WorldGroup } do
			if not PhysicsService:IsCollisionGroupRegistered(name) then PhysicsService:RegisterCollisionGroup(name) end
		end
		for _, group in PhysicsService:GetRegisteredCollisionGroups() do
			PhysicsService:CollisionGroupSetCollidable(Appearance.HullGroup, group.name, group.name == Appearance.WorldGroup)
		end
	end)
end

-- One invisible box that only meets world geometry: stops a long creature body at pillars.
local function hull(model: Model, root: BasePart, spec: { number })
	registerGroups()
	local p = Instance.new("Part")
	p.Name, p.Size, p.Transparency = "AsuraHull", Vector3.new(spec[1], spec[2], spec[3]), 1
	p.Anchored, p.Massless, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, true, true, false, false, false
	p.CollisionGroup = Appearance.HullGroup
	local c0 = CFrame.new(spec[4], spec[5], spec[6])
	p.CFrame = root.CFrame * c0
	local weld = Instance.new("Weld")
	weld.Name, weld.Part0, weld.Part1, weld.C0, weld.Parent = "AsuraBind", root, p, c0, p
	p.Parent = model
end

-- F10: imported boss tracks are Animation objects in ServerStorage.AsuraAssets.AsuraBossAnimations
-- named by slot key (BossAnimationRules); each actor gets its look's ids as attributes at spawn,
-- so every retry and phase reads the same overrides. The status names what is still a stand-in.
local function animationStatus(model: Model)
	local look, phase = model:GetAttribute("AsuraLookKey"), model:GetAttribute("AsuraBossPhase")
	if type(look) ~= "string" then return end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local rig = if model:GetAttribute("AsuraRig") == "Creature" then "Creature"
		elseif humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then "R6" else "R15"
	model:SetAttribute("AsuraAnimationStatus", AnimationRules.status(look, if type(phase) == "number" then phase else 1, rig,
		function(name) return model:GetAttribute(name) end))
end
Appearance.animationStatus = animationStatus

function Appearance.bindAnimations(model: Model, library: Instance?)
	local look = model:GetAttribute("AsuraLookKey")
	local folder = library and library:FindFirstChild("AsuraBossAnimations")
	if type(look) ~= "string" or not folder then return end
	for _, animation in folder:GetChildren() do
		if animation:IsA("Animation") and string.sub(animation.Name, 1, #look + 1) == look .. "_" and AnimationRules.validId(animation.AnimationId) then
			model:SetAttribute("AsuraBossAnimation_" .. animation.Name, animation.AnimationId)
		end
	end
end

function Appearance.apply(model: Model, archetype: string?, scale: number?)
	local look = Appearance.look(archetype)
	local root = model:FindFirstChild("HumanoidRootPart")
	model:SetAttribute("AsuraArchetype", archetype)
	if look then
		model:SetAttribute("AsuraLookKey", look.Key)
		Kit.build(model, look, 1)
		local spec = if archetype then (Bodies.Hulls :: any)[archetype] else nil
		if spec and root and root:IsA("BasePart") then hull(model, root, spec) end
	end
	local shape = Bodies.shape(archetype)
	local id = Characters.GetEntityByModel(model)
	if id and ((scale and scale ~= 1) or shape) then Characters.ScaleEnemy(id, scale or 1, shape) end
	if archetype == "Colossus" then model:SetAttribute("AsuraVisceralTarget", "Ankles") end
	Appearance.bindAnimations(model, ServerStorage:FindFirstChild("AsuraAssets"))
	animationStatus(model)
end

-- The phase index is published before the animation set: PresentationService re-binds the skin on
-- the set change and BossSkin resolves AsuraBoss_&lt;Look&gt;_P&lt;phase&gt; from it (F10: the set changed
-- first, so phase 2 kept resolving the _P1 template).
function Appearance.phase(model: Model, animationSet: string?, index: number?)
	model:SetAttribute("AsuraBossPhase", index or 1)
	model:SetAttribute("AsuraAnimationSet", animationSet or "Boss")
	Kit.phase(model, index or 1)
	animationStatus(model)
end

return Appearance
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">BossArenas</string>
            <string name="Source">--!strict
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage").AsurasPath
local World = require(Shared.Shared.WorldDefinitions)
local InputMap = require(Shared.Shared.InputMap)
local Rules = require(Shared.Shared.BossEncounterRules)
local Bodies = require(Shared.Shared.BossBodies)
local Characters = require(script.Parent.CharacterService)
local Routes = require(Shared.Shared.SanctuaryRoutes)
local Campaign = require(Shared.Shared.CampaignZones)
local Arenas = {}
Arenas.FloorColor = Color3.fromRGB(118, 110, 100) -- duel floor tone (F09 readability)
local walls: { [string]: { Part } } = {}
local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position, p.Color = name, size, position, color
	p.Anchored, p.Material, p.Parent = true, Enum.Material.Slate, parent
	return p
end
function Arenas.seal(gateId: string, sealed: boolean)
	for _, p in walls[gateId] or {} do
		p.CanCollide = sealed
		p.Transparency = if sealed then 0.45 else 1
		p:SetAttribute("Sealed", sealed)
	end
end
-- `destination` arrives facing `yaw` (degrees, 0 = -Z), so every portal leg lands looking along its route.
local function portal(parent: Instance, name: string, position: Vector3, destination: Vector3, yaw: number?)
	local anchor = part(parent, name, Vector3.new(8, 10, 2), position, Color3.fromRGB(170, 148, 80))
	anchor.CanCollide, anchor.Material, anchor.Transparency = false, Enum.Material.ForceField, 0.3
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText, prompt.HoldDuration = "Traverse", name, 0.4
	InputMap.applyPrompt(prompt)
	prompt.MaxActivationDistance, prompt.Parent = 12, anchor
	prompt.Triggered:Connect(function(player: Player)
		local e = Characters.GetEntity(player.UserId)
		if e and e.Fighter.State ~= "KO" and not Characters.IsInDuel(e.Id) and (e.Root.Position - position).Magnitude &lt;= 15 then
			Characters.Teleport(e.Id, CFrame.new(destination) * CFrame.Angles(0, math.rad(yaw or 0), 0))
		end
	end)
end
function Arenas.build(root: Instance)
	table.clear(walls)
	local old = root:FindFirstChild("BossArenas")
	if old then old:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "BossArenas", root
	for _, boss in World.Bosses do
		local c, s = boss.Arena.Center, boss.Arena.Size
		local center = Vector3.new(c.X, 0, c.Z)
		-- F09: a mid stone, not near-black slate: at the low dusk sun the bare Titan and Wu floors read
		-- black, and dark costumes (the player, Wu) vanished against them. Lights are unchanged.
		part(folder, boss.Id .. "Floor", Vector3.new(s.X, 4, s.Z), center - Vector3.new(0, 2, 0), Arenas.FloorColor)
		part(folder, boss.Id .. "Approach", Vector3.new(30, 4, 40), center + Vector3.new(0, -2, s.Z / 2 + 20), Color3.fromRGB(61, 56, 48))
		local boundary: { Part } = {}
		-- Entrance is on the north face; only the fog aperture remains open there.
		for _, spec in {
			{ Vector3.new(2, 100, s.Z), Vector3.new(-s.X / 2, 48, 0) },
			{ Vector3.new(2, 100, s.Z), Vector3.new(s.X / 2, 48, 0) },
			{ Vector3.new(s.X, 100, 2), Vector3.new(0, 48, -s.Z / 2) },
			{ Vector3.new((s.X - 26) / 2, 100, 2), Vector3.new(-(s.X + 26) / 4, 48, s.Z / 2) },
			{ Vector3.new((s.X - 26) / 2, 100, 2), Vector3.new((s.X + 26) / 4, 48, s.Z / 2) },
		} do
			local wall = part(folder, "AshPerimeter", spec[1], center + spec[2], Color3.fromRGB(198, 163, 81))
			wall.Material = Enum.Material.ForceField
			table.insert(boundary, wall)
		end
		walls[boss.FogGate] = boundary
		Arenas.seal(boss.FogGate, false)
		-- Shared layout (BossBodies): AI steering and the pounce path avoid these exact columns, and
		-- they are world geometry so the creature hull and the camera probe both meet them.
		for _, pillar in Bodies.pillars(boss) do
			local column = part(folder, "FrostPillar", Vector3.new(pillar.Half * 2, pillar.Top, pillar.Half * 2),
				Vector3.new(pillar.X, pillar.Top / 2, pillar.Z), Color3.fromRGB(97, 128, 140))
			column.CollisionGroup = "WorldGeometry"
		end
	end
	-- Traversable link for the Monastery's side courtyard. The Pagoda and Summit roads that used to
	-- bridge the campaign regions are now their layouts' cloud stair and saddle bridge (batches 20-21).
	part(folder, "CourtyardRoad", Vector3.new(160, 4, 24), Vector3.new(220, -2, -810), Color3.fromRGB(61, 56, 48))
	-- Crypt leg (batches 16/19): the Well of Descent south of the plaza &lt;-&gt; the crypt's Descent Landing;
	-- the Sky Citadel's bastion returns to the bonfire for the ending (batch 21).
	local function at(m: any, lift: number): Vector3 return Vector3.new(m.X, m.Y + lift, m.Z) end
	local descent, back = Routes.Marks.CryptDescent, Routes.Marks.CryptReturn
	local arrival, home = Campaign.mark("SanctuaryDepths", "Arrival"), Campaign.mark("SanctuaryDepths", "ReturnPortal")
	local bonfire = World.startingAltar().Spawn
	portal(folder, "Descend to the Sunken Crypt", at(descent, 5), at(arrival, 3), arrival.Yaw)
	portal(folder, "Return to the Shrine", at(home, 5), at(back, 3), back.Yaw)
	portal(folder, "Return to the Shrine", at(Campaign.mark("SkyCitadel", "ReturnPortal"), 5), Vector3.new(bonfire.X, bonfire.Y, bonfire.Z), bonfire.Yaw)
end
function Arenas.loot(position: Vector3, essence: number)
	for _, drop in Rules.loot(essence, 12) do
		local orb = part(workspace, "QiEssence", Vector3.one, position, Color3.fromRGB(244, 196, 91))
		orb.Shape, orb.Material, orb.CanCollide, orb.CanQuery = Enum.PartType.Ball, Enum.Material.Neon, false, false
		orb:SetAttribute("Essence", drop.Amount)
		orb:SetAttribute("CosmeticReward", true)
		TweenService:Create(orb, TweenInfo.new(1.6), { Position = position + Vector3.new(drop.X, 6, drop.Z), Transparency = 1 }):Play()
		Debris:AddItem(orb, 2)
	end
end
return Arenas
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">BossAttackService</string>
            <string name="Source">--!strict
local Shared = game:GetService("ReplicatedStorage").AsurasPath
local Types = require(Shared.Shared.BossTypes)
local World = require(Shared.Shared.WorldDefinitions)
local Rules = require(Shared.Shared.BossEncounterRules)
local Characters = require(script.Parent.CharacterService)
local Motion = require(script.Parent.BossMotion)
local Hazards = require(script.Parent.BossHazards)
local Handoff = require(script.Parent.EncounterHandoff)
local Service = {}
type Active = { Attack: Types.Attack, Impact: number, Origin: Vector3, Aim: Vector3, Target: number,
	Allowed: { [number]: boolean }?, Hazard: Hazards.Hazard?, Pulse: number }
local active: { [number]: Active } = {}
function Service.cancel(id: number)
	active[id] = nil
	Motion.cancel(id)
	local e = Characters.GetEntity(id)
	if e then e.Model:SetAttribute("AsuraBossAttack", nil) end
end
function Service.start(id: number, attack: Types.Attack, target: number, allowed: { [number]: boolean }?, now: number)
	Service.cancel(id)
	local e, victim = Characters.GetEntity(id), Characters.GetEntity(target)
	if not e or not victim or not allowed or not allowed[target] then return end
	local encounter = e.Model:GetAttribute("AsuraEncounter")
	-- No impact inside an encounter handoff: the windup stretches to the readable lead (#16).
	local impact = Rules.impact(now, attack.Windup)
	if type(encounter) == "string" then impact = Handoff.defer(encounter, impact) end
	local origin = Vector3.new(e.Root.Position.X, 3, e.Root.Position.Z)
	local aim = Motion.clamp(id, Vector3.new(victim.Root.Position.X, e.Root.Position.Y, victim.Root.Position.Z))
	active[id] = { Attack = attack, Impact = impact, Origin = origin, Aim = aim, Target = target, Allowed = allowed, Hazard = nil, Pulse = 0 }
	local _, counter = Rules.classify(attack.Kind)
	Characters.StopMoving(id)
	Characters.SetGuard(id, false)
	if attack.Kind ~= "Tail" then Characters.Face(id, aim) end
	e.Model:SetAttribute("AsuraBossAttack", attack.Kind)
	e.Model:SetAttribute("AsuraTelegraph", string.format("Perilous|%s|%.3f", attack.Id, impact))
	Characters.Cue("Telegraph", id, { class = "Perilous", move = attack.Id, kind = attack.Kind, counter = counter, impact = impact,
		radius = attack.Radius, ox = origin.X, oz = origin.Z, x = aim.X, y = 0, z = aim.Z, duration = attack.Duration, element = attack.Element })
	if attack.Motion then Motion.begin(id, attack.Motion, Motion.approach(id, attack.Motion, aim), now, impact) end
end
local function strike(id: number, current: Active)
	local e = Characters.GetEntity(id)
	if not e then return end
	local a = current.Attack
	for target in current.Allowed or {} do
		local victim = Characters.GetEntity(target)
		if not victim or victim.Fighter.State == "KO" then continue end
		local delta = victim.Root.Position - e.Root.Position
		local flat = Vector3.new(delta.X, 0, delta.Z)
		local within = flat.Magnitude &lt;= a.Radius
		if a.Kind == "PerilousGrab" then within = delta.Magnitude &lt;= a.Radius end
		if a.Kind == "PerilousThrust" or a.Kind == "ShieldCharge" then
			local p, origin, aim = victim.Root.Position, current.Origin, current.Aim
			within = Rules.segmentHit(p.X, p.Z, origin.X, origin.Z, aim.X, aim.Z, 5) and math.abs(delta.Y) &lt; 8
		elseif a.Kind == "PerilousSweep" or a.Kind == "Tail" then
			within = within and victim.Root.Position.Y - current.Origin.Y &lt;= (a.Height or 5)
			if a.Kind == "Tail" and flat.Magnitude &gt; 0.01 then within = within and e.Root.CFrame.LookVector:Dot(flat.Unit) &lt; 0.3 end
		end
		if within then Characters.ApplyBossAttack(id, target, a.Damage, a.Posture, a.Kind) end
	end
end
function Service.step(id: number, now: number): boolean
	local current, e = active[id], Characters.GetEntity(id)
	if not current then return false end
	if not e or e.Fighter.State == "KO" or e.Fighter.State == "StanceBroken" or e.Fighter.State == "DeathblowVictim"
		or e.Fighter.State == "Hitstun" or e.Fighter.State == "GuardBroken" then Service.cancel(id); return false end
	Characters.StopMoving(id)
	Motion.step(id, now)
	if now &lt; current.Impact then return true end
	local a = current.Attack
	local kind = a.Kind
	if kind == "PerilousSweep" or kind == "PerilousThrust" or kind == "PerilousGrab" or kind == "Tail" or kind == "ShieldCharge" then
		if now &gt;= current.Impact + current.Pulse * (a.Interval or 0.7) then
			strike(id, current)
			current.Pulse += 1
			if current.Pulse &lt; (a.Repeats or 1) then
				Characters.Cue("Telegraph", id, { class = "Perilous", kind = kind, counter = select(2, Rules.classify(kind)),
					move = a.Id, impact = current.Impact + current.Pulse * (a.Interval or 0.7) })
			else Service.cancel(id); return true end
		end
	else
		if not current.Hazard then
			local origin = if kind == "Leap" then Vector3.new(current.Aim.X, 3, current.Aim.Z) else current.Origin
			if kind == "Ritual" then
				local encounter = e.Model:GetAttribute("AsuraEncounter")
				local boss = if type(encounter) == "string" then World.Bosses[encounter] else nil
				if boss then origin = Vector3.new(boss.Arena.Center.X, 3, boss.Arena.Center.Z) end
			end
			current.Hazard = Hazards.new(a, origin, current.Aim, current.Impact, current.Allowed)
			if kind == "Breath" then
				local direction = current.Aim - current.Origin
				local endpoint = current.Aim + (if direction.Magnitude &gt; 0.1 then direction.Unit * 70 else Vector3.zAxis * 70)
				Motion.begin(id, "Aerial", endpoint, now, now + (a.Duration or 3))
			end
			Characters.Cue("BossHazard", id, { kind = kind, radius = a.Radius, speed = a.Speed or 36, duration = a.Duration,
				repeats = a.Repeats or 1, interval = a.Interval or 1, element = a.Element, x = origin.X, y = 0.3, z = origin.Z,
				ax = current.Aim.X, az = current.Aim.Z })
		end
		if not Hazards.step(id, current.Hazard :: Hazards.Hazard, now) then Service.cancel(id) end
	end
	return true
end
return Service
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">BossDuo</string>
            <string name="Source">--!strict
local Characters = require(script.Parent.CharacterService)
local Tactics = require(script.Parent.BossTactics)
local World = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.WorldDefinitions)
local HandoffRules = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.BossHandoff)
local Duo = {}
type Encounter = { Members: { number }, Enraged: boolean, Finished: boolean, Boss: World.BossDef }
local encounters: { [string]: Encounter } = {}
function Duo.register(boss: World.BossDef, members: { number })
	encounters[boss.Id] = { Members = members, Enraged = false, Finished = false, Boss = boss }
end
function Duo.members(bossId: string): { number }
	local encounter = encounters[bossId]
	return if encounter then encounter.Members else {}
end
function Duo.alive(bossId: string): number?
	for _, id in Duo.members(bossId) do
		local e = Characters.GetEntity(id)
		if e and e.Fighter.State ~= "KO" then return id end
	end
	return nil
end
-- True when the encounter is won; the second value is the Twin who just swore the oath (the
-- caller opens the "Enrage" handoff for the participants).
function Duo.onKO(bossId: string, victim: number): (boolean, number?)
	local encounter = encounters[bossId]
	if not encounter or encounter.Finished then return false, nil end
	Tactics.reset(victim)
	local survivor = Duo.alive(bossId)
	if survivor then
		if #encounter.Members == 2 and not encounter.Enraged then
			encounter.Enraged = true
			local e = Characters.GetEntity(survivor)
			local boss = encounter.Boss
			if e then
				Characters.RestoreFighter(survivor)
				Characters.Cinematic(survivor, 2)
				e.Model:SetAttribute("AsuraBossEnraged", true)
				e.Model:SetAttribute("AsuraAffinity", "Lightning+Iron")
				Tactics.enrage(survivor, if survivor == encounter.Members[1] and boss.Partner then boss.Partner.Attacks else boss.Phases[1].Attacks or {})
				Characters.Cue("BossEnrage", survivor, { boss = bossId, duration = 2, name = "Oath of the Fallen", affinity = "Lightning+Iron",
					members = encounter.Members, survivor = e.Model.Name, shot = HandoffRules.shot("Enrage") })
				return false, survivor
			end
		end
		return false, nil
	end
	encounter.Finished = true
	return true
end
function Duo.forget(bossId: string)
	for _, id in Duo.members(bossId) do Tactics.reset(id) end
	encounters[bossId] = nil
end
return Duo
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">BossHazards</string>
            <string name="Source">--!strict
local Replicated = game:GetService("ReplicatedStorage").AsurasPath
local Types = require(Replicated.Shared.BossTypes)
local Rules = require(Replicated.Shared.BossEncounterRules)
local Characters = require(script.Parent.CharacterService)
type Entity = Characters.Entity
type Projectile = { Position: Vector3, Target: number, Hit: boolean }
export type Hazard = { Attack: Types.Attack, Origin: Vector3, Aim: Vector3, Start: number, Previous: number,
	Allowed: { [number]: boolean }?, Hits: { [string]: boolean }, Projectiles: { Projectile }, LastTick: number }
local Hazards = {}
function Hazards.new(attack: Types.Attack, origin: Vector3, aim: Vector3, now: number, allowed: { [number]: boolean }?): Hazard
	local projectiles: { Projectile } = {}
	if attack.Kind == "Barrage" then
		local targets = {}
		for id in allowed or {} do table.insert(targets, id) end
		table.sort(targets)
		for i = 1, attack.Count or 5 do
			table.insert(projectiles, { Position = origin + Vector3.new((i - 3) * 2, 8, 0), Target = targets[(i - 1) % math.max(#targets, 1) + 1] or 0, Hit = false })
		end
	end
	return { Attack = attack, Origin = origin, Aim = aim, Start = now, Previous = 0, Allowed = allowed,
		Hits = {}, Projectiles = projectiles, LastTick = -1 }
end
local function hit(id: number, hazard: Hazard, e: Entity, key: string)
	if hazard.Hits[key] then return end
	hazard.Hits[key] = true
	local a = hazard.Attack
	Characters.ApplyBossAttack(id, e.Id, a.Damage, a.Posture, a.Kind)
end
function Hazards.step(id: number, h: Hazard, now: number): boolean
	local a = h.Attack
	local elapsed, dt = now - h.Start, math.max(0, now - h.Start - h.Previous)
	local kind, height = a.Kind, a.Height or 6
	local speed = a.Speed or 36
	local sendProjectiles = math.floor(elapsed * 10) &gt; h.LastTick
	local duration = a.Duration or (if kind == "Barrage" then a.Radius / speed + 1 else a.Radius / speed)
	local repeats, interval = a.Repeats or 1, a.Interval or 1
	for _, e in Characters.Entities() do
		if e.Kind ~= "Player" or not h.Allowed or not h.Allowed[e.Id] or e.Fighter.State == "KO" then continue end
		local p = e.Root.Position
		local delta = p - h.Origin
		local distance, altitude = Vector3.new(delta.X, 0, delta.Z).Magnitude, delta.Y
		if kind == "Barrage" then
			for i, projectile in h.Projectiles do
				if projectile.Hit or projectile.Target ~= e.Id then continue end
				local old = projectile.Position
				local direction = p - old
				local travel = math.min(direction.Magnitude, speed * dt)
				projectile.Position += if direction.Magnitude &gt; 0.01 then direction.Unit * travel else Vector3.zero
				if (p - projectile.Position).Magnitude &lt;= 3 then hit(id, h, e, tostring(i) .. ":" .. e.Id); projectile.Hit = true end
				if sendProjectiles then Characters.Cue("BossProjectile", id, { index = i, x = projectile.Position.X, y = projectile.Position.Y, z = projectile.Position.Z }) end
			end
		elseif kind == "Gravity" or kind == "Ritual" or kind == "Breath" or (kind == "Leap" and a.Element == "Frost") then
			local center = if kind == "Gravity" then h.Aim else h.Origin
			local d = p - center
			local inside = Vector3.new(d.X, 0, d.Z).Magnitude &lt;= a.Radius and altitude &lt;= height
			if kind == "Breath" then
				local endPoint = h.Aim + (h.Aim - h.Origin) * 2
				inside = altitude &lt;= height and Rules.segmentHit(p.X, p.Z, h.Origin.X, h.Origin.Z, endPoint.X, endPoint.Z, 14)
			end
			if inside then
				if kind == "Gravity" and d.Magnitude &gt; 2 then
					local pull = Vector3.new(-d.X, 0, -d.Z).Unit * 18
					e.Root.AssemblyLinearVelocity = Vector3.new(pull.X, e.Root.AssemblyLinearVelocity.Y, pull.Z)
				end
				hit(id, h, e, tostring(math.floor(elapsed / 0.8)) .. ":" .. e.Id)
			end
		else
			for pulse = 0, repeats - 1 do
				local age, previous = elapsed - pulse * interval, h.Previous - pulse * interval
				if age &gt;= 0 and previous &lt;= duration and Rules.waveHit(distance, altitude, age, previous, speed, a.Radius, height) then
					hit(id, h, e, tostring(pulse) .. ":" .. e.Id)
				end
			end
		end
	end
	h.Previous = elapsed
	h.LastTick = math.floor(elapsed * 10)
	return elapsed &lt; duration + (repeats - 1) * interval
end
return Hazards
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">BossMotion</string>
            <string name="Source">--!strict
local Characters = require(script.Parent.CharacterService)
local World = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.WorldDefinitions)
local Bodies = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.BossBodies)
local Motion = {}
type Flight = { From: Vector3, To: Vector3, Start: number, Impact: number, Height: number, Kind: string, Perch: Vector3, Anchored: boolean, Clear: number }
local flights: { [number]: Flight } = {}
function Motion.clamp(id: number, point: Vector3): Vector3
	local e = Characters.GetEntity(id)
	local bossId = e and e.Model:GetAttribute("AsuraEncounter")
	local boss = if type(bossId) == "string" then World.Bosses[bossId] else nil
	if not boss then return point end
	local c, s = boss.Arena.Center, boss.Arena.Size
	return Vector3.new(math.clamp(point.X, c.X - s.X / 2 + 12, c.X + s.X / 2 - 12), point.Y,
		math.clamp(point.Z, c.Z - s.Z / 2 + 12, c.Z + s.Z / 2 - 12))
end
-- The pillar across the arena from the target, perched on its top (feet just above it), plus the
-- horizontal radius within which the body must stay above the column.
local function pillarPerch(id: number, target: Vector3): (Vector3, number)
	local e = Characters.GetEntity(id)
	local bossId = e and e.Model:GetAttribute("AsuraEncounter")
	local boss = if type(bossId) == "string" then World.Bosses[bossId] else nil
	if boss and e then
		local scale = e.Model:GetScale()
		local c = boss.Arena.Center
		for _, pillar in Bodies.pillars(boss) do
			if (pillar.X &lt; c.X) == (target.X &gt;= c.X) and (pillar.Z &lt; c.Z) == (target.Z &gt;= c.Z) then
				local hull = (Bodies.Hulls :: any)[boss.Archetype]
				local reach = if hull then math.max(hull[1], hull[3]) * 0.5 * scale else 2
				return Vector3.new(pillar.X, Bodies.perchY(pillar, scale), pillar.Z), pillar.Half * math.sqrt(2) + reach
			end
		end
	end
	return Motion.clamp(id, target + Vector3.new(50, 31, -50)), 0
end
-- Where a lunge or aerial landing should end: a body short of the marked point on the boss's
-- side, not inside the target (F10: Shen's Flowing Jian ended 0.2 studs from the player and
-- climbed onto them). Hits still resolve from the marked origin/aim, so reach and timing hold.
local function bodyStop(e: any): number
	local bossId = e.Model:GetAttribute("AsuraEncounter")
	local boss = if type(bossId) == "string" then World.Bosses[bossId] else nil
	local hull = if boss then (Bodies.Hulls :: any)[boss.Archetype] else nil
	return (if hull then math.max(hull[1], hull[3]) * 0.5 else 1) * e.Model:GetScale() + 2
end
function Motion.approach(id: number, kind: string, aim: Vector3): Vector3
	local e = Characters.GetEntity(id)
	if not e or (kind ~= "Lunge" and kind ~= "Aerial") then return aim end
	local x, z = Bodies.closeIn(e.Root.Position.X, e.Root.Position.Z, aim.X, aim.Z, bodyStop(e))
	return Vector3.new(x, aim.Y, z)
end
function Motion.begin(id: number, kind: string, destination: Vector3, now: number, impact: number)
	Motion.cancel(id)
	local e = Characters.GetEntity(id)
	if not e then return end
	local target = Motion.clamp(id, destination)
	local perch, clear = pillarPerch(id, target)
	if kind == "Pillar" then -- the pounce comes down beside the mark, on the pillar's side (F11: it landed on the player)
		local x, z = Bodies.closeIn(perch.X, perch.Z, target.X, target.Z, bodyStop(e))
		target = Vector3.new(x, target.Y, z)
	end
	flights[id] = { From = e.Root.Position, To = target, Start = now, Impact = impact, Clear = clear,
		Kind = kind, Perch = perch,
		Height = if kind == "Pillar" then 34 elseif kind == "Aerial" then 28 elseif kind == "Teleport" then 0 else 4,
		Anchored = e.Root.Anchored }
	e.Root.Anchored = true
	Characters.StopMoving(id)
end
function Motion.step(id: number, now: number)
	local flight, e = flights[id], Characters.GetEntity(id)
	if not flight or not e then return end
	local t = math.clamp((now - flight.Start) / math.max(flight.Impact - flight.Start, 0.01), 0, 1)
	-- Hang above a pillar/ceiling, then commit to the marked landing point.
	local point = flight.From:Lerp(flight.To, t) + Vector3.new(0, math.sin(math.pi * t) * flight.Height, 0)
	if flight.Kind == "Teleport" then point = if t &lt; 0.75 then flight.From else flight.To end
	if flight.Kind == "Pillar" then
		-- Rise before crossing the column, hold on its top, leave the top before falling (BossBodies.arc).
		local from, perch, to = flight.From, flight.Perch, flight.To
		local p = if t &lt; 0.3 then Bodies.arc({ from.X, from.Y, from.Z }, { perch.X, perch.Y, perch.Z }, perch.Y, flight.Clear, false, true, t / 0.3)
			elseif t &lt; 0.65 then { perch.X, perch.Y, perch.Z }
			else Bodies.arc({ perch.X, perch.Y, perch.Z }, { to.X, to.Y, to.Z }, perch.Y, flight.Clear, true, false, (t - 0.65) / 0.35)
		point = Vector3.new(p[1], p[2], p[3])
	end
	local direction = flight.To - flight.From
	local look = Vector3.new(direction.X, 0, direction.Z)
	e.Model:PivotTo(if look.Magnitude &gt; 0.1 then CFrame.lookAt(point, point + Vector3.new(look.X, 0, look.Z)) else CFrame.new(point))
	if t &gt;= 1 then Motion.cancel(id) end
end
-- A felled body keeps the anchor settleCorpse gave it (F12: a Wyrm killed in flight was set on the
-- floor, then this restored its pre-flight unanchored root and it fell through the arena).
function Motion.cancel(id: number)
	local flight, e = flights[id], Characters.GetEntity(id)
	if flight and e then
		if e.Fighter.State ~= "KO" then e.Root.Anchored = flight.Anchored end
		e.Root.AssemblyLinearVelocity = Vector3.zero
	end
	flights[id] = nil
end
return Motion
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">BossSkin</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/BossSkin
-- Production skin binding. A template is a Model in ServerStorage.AsuraAssets named by
-- CostumeSchema.templates (AsuraBoss_&lt;LookKey&gt;_P&lt;phase&gt;, then AsuraBoss_&lt;LookKey&gt;, then the legacy
-- encounter names). Each MeshPart carries an AsuraBone attribute (R15 limb, or HumanoidRootPart for
-- creatures) and an AsuraBind Attachment aligned to that limb; skin geometry never collides,
-- queries or touches. Audit (batch 11): the library held no AsuraBoss_* templates at all, both
-- Twins resolved the same encounter template, and a missing/invalid template returned silently, so
-- every boss showed its bare block rig. Now each actor resolves its own look key, every outcome is
-- written to the AsuraSkinStatus attribute (and warned once), and the authored CostumeKit look
-- remains the visible fallback until a valid template is imported.
local ServerStorage = game:GetService("ServerStorage")
local Schema = require(game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared.CostumeSchema)
local Pbr = require(script.Parent.PbrAssets)

local Skin = {}
local reported: { [string]: boolean } = {}

local function report(actor: Model, status: string)
	actor:SetAttribute("AsuraSkinStatus", status)
	local key = tostring(actor:GetAttribute("AsuraLookKey")) .. "|" .. status
	if not reported[key] and string.sub(status, 1, 9) ~= "Template:" then
		reported[key] = true
		warn("[Asura AV] " .. actor.Name .. " skin " .. status)
	end
end

-- The candidate names for this actor and the first one present in the library.
function Skin.resolve(library: Instance?, actor: Model): (Model?, { string })
	local encounter = actor:GetAttribute("AsuraEncounter")
	local key = actor:GetAttribute("AsuraLookKey")
	local phase = actor:GetAttribute("AsuraBossPhase")
	local set = actor:GetAttribute("AsuraAnimationSet")
	local lookKey = if type(key) == "string" then key elseif type(encounter) == "string" then encounter else actor.Name
	local names = Schema.templates(lookKey, if type(phase) == "number" then phase else 1,
		if type(encounter) == "string" then encounter else nil, if type(set) == "string" then set else nil)
	for _, name in names do
		local found = library and library:FindFirstChild(name)
		if found and found:IsA("Model") then return found, names end
	end
	return nil, names
end

function Skin.attach(actor: Model): boolean
	local library = ServerStorage:FindFirstChild("AsuraAssets")
	local template, names = Skin.resolve(library, actor)
	local old = actor:FindFirstChild("AsuraBossSkin")
	if not template then
		if not old then report(actor, "Fallback:Costume (no " .. names[1] .. " or " .. names[2] .. ")") end
		return old ~= nil
	end
	if old and old:GetAttribute("Template") == template.Name then return true end
	local valid, reason = Pbr.validate(template)
	if not valid then report(actor, "Invalid:" .. template.Name .. " " .. tostring(reason)); return false end
	local rig = actor:GetAttribute("AsuraRig")
	local required = Schema.RequiredBones[if type(rig) == "string" then rig else "Humanoid"] or Schema.RequiredBones.Humanoid
	local model = template:Clone()
	model:ScaleTo(actor:GetScale())
	local coverage: { [string]: boolean } = {}
	for _, part in model:GetDescendants() do
		if not part:IsA("BasePart") then continue end
		part.Anchored, part.Massless, part.CanCollide, part.CanQuery, part.CanTouch = false, true, false, false, false
		if not part:IsA("MeshPart") then continue end
		local bone = part:GetAttribute("AsuraBone")
		local limb = if type(bone) == "string" then actor:FindFirstChild(bone) else nil
		local bind = part:FindFirstChild("AsuraBind")
		if not limb or not limb:IsA("BasePart") or not bind or not bind:IsA("Attachment") then
			model:Destroy()
			report(actor, "Invalid:" .. template.Name .. " " .. part.Name .. " unbound (AsuraBone " .. tostring(bone) .. ")")
			return false
		end
		coverage[bone :: string] = true
		part.CFrame = limb.CFrame * bind.CFrame:Inverse()
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = limb, part, part
	end
	for _, bone in required do
		if not coverage[bone] then
			model:Destroy()
			report(actor, "Invalid:" .. template.Name .. " missing " .. bone)
			return false
		end
	end
	model:SetAttribute("Template", template.Name)
	if old then old:Destroy() end
	model.Name, model.Parent = "AsuraBossSkin", actor
	for _, part in actor:GetDescendants() do
		if part:IsA("BasePart") and not part:IsDescendantOf(model) and part.Name ~= "AsuraWeapon" and not part:FindFirstAncestor("ArsenalWeapon")
			and part:GetAttribute("AsuraRole") ~= "Weapon" then
			part.Transparency, part.CastShadow = 1, false
		end
	end
	report(actor, "Template:" .. template.Name)
	return true
end

return Skin
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">BossTactics</string>
            <string name="Source">--!strict
local Shared = game:GetService("ReplicatedStorage").AsurasPath
local World = require(Shared.Shared.WorldDefinitions)
local Types = require(Shared.Shared.BossTypes)
local Rules = require(Shared.Shared.BossEncounterRules)
local Combat = require(Shared.Simulation.CombatRules)
local Characters = require(script.Parent.CharacterService)
local Attacks = require(script.Parent.BossAttackService)
local Motion = require(script.Parent.BossMotion)
local Tactics = {}
type Schedule = { Next: number, Cursor: number, FarSince: number, NextClose: number, Extra: { Types.Attack }, Kneeling: boolean, StandHip: number? }
local schedules: { [number]: Schedule } = {}
function Tactics.reset(id: number)
	Attacks.cancel(id)
	schedules[id] = nil
end
function Tactics.enrage(id: number, inherited: { Types.Attack })
	Attacks.cancel(id)
	local schedule = schedules[id]
	if not schedule then
		schedule = { Next = Characters.Now() + 1, Cursor = 0, FarSince = Characters.Now(), NextClose = Characters.Now() + 3, Extra = {}, Kneeling = false }
		schedules[id] = schedule
	end
	schedule.Extra = inherited; schedule.Next = Characters.Now() + 1
end
-- Encounter handoff: nothing is scheduled to start before control returns at `untilTime`.
function Tactics.hold(id: number, untilTime: number)
	local schedule = schedules[id]
	if not schedule then
		schedule = { Next = untilTime, Cursor = 0, FarSince = untilTime, NextClose = untilTime, Extra = {}, Kneeling = false }
		schedules[id] = schedule
	end
	schedule.Next, schedule.NextClose = math.max(schedule.Next, untilTime), math.max(schedule.NextClose, untilTime)
	schedule.FarSince = math.max(schedule.FarSince, untilTime)
end
function Tactics.step(id: number, boss: World.BossDef, phase: number, targetId: number, allowed: { [number]: boolean }?, now: number): boolean
	local e, target = Characters.GetEntity(id), Characters.GetEntity(targetId)
	if not e then return false end
	local schedule = schedules[id]
	if not schedule then
		schedule = { Next = now + 2, Cursor = 0, FarSince = now, NextClose = now, Extra = {}, Kneeling = false }
		schedules[id] = schedule
	end
	if e.Fighter.State == "StanceBroken" and boss.Archetype == "Colossus" then
		if not schedule.Kneeling then
			schedule.Kneeling = true
			Attacks.cancel(id)
			e.Model:SetAttribute("AsuraVisceralTarget", "Head")
			Characters.Cue("BossKneel", id, { duration = 2.5 })
			-- Lower the head into the normal deathblow reach, then restore when posture recovers.
			schedule.StandHip = e.Humanoid.HipHeight
			e.Humanoid.HipHeight = 0
		end
		return true
	elseif schedule.Kneeling then
		schedule.Kneeling = false
		e.Model:SetAttribute("AsuraVisceralTarget", "Ankles")
		-- The scaled standing height, not a constant (F11: 6 sank the scale-3 Titan's feet 0.58 studs).
		e.Humanoid.HipHeight = schedule.StandHip or e.Humanoid.HipHeight
	end
	if Attacks.step(id, now) then return true end
	if not target or not allowed or not allowed[targetId] or target.Fighter.State == "KO" or e.Fighter.State ~= "Idle" then return false end
	local distance = (target.Root.Position - e.Root.Position).Magnitude
	local p = boss.Phases[phase]
	local closer = p.GapCloser
	if distance &lt;= (closer and closer.Range or 40) then schedule.FarSince = now end
	if closer and now &gt;= schedule.NextClose and Rules.shouldClose(distance, schedule.FarSince, now, closer.Range, closer.Delay) then
		schedule.NextClose = now + closer.Cooldown
		schedule.Next = now + 2
		Attacks.start(id, { Id = "Pursuit", Kind = "Leap", Motion = closer.Motion, Windup = 1, Radius = 18, Damage = 22, Posture = 30 }, targetId, allowed, now)
		return true
	end
	-- A cornered oracle marks a destination before shadow-stepping away.
	if boss.Archetype == "Sorcerer" and distance &lt; 16 and now &gt;= schedule.NextClose then
		schedule.NextClose = now + 7
		local away = e.Root.Position - target.Root.Position
		local direction = if away.Magnitude &gt; 0.1 then away.Unit else Vector3.zAxis
		local destination = Motion.clamp(id, e.Root.Position + direction * 35)
		Characters.Cue("BossTeleport", id, { x = destination.X, y = destination.Y, z = destination.Z })
		Characters.Teleport(id, CFrame.new(destination))
		Combat.cinematic(e.Fighter, now, 0.4)
		return true
	end
	if now &lt; schedule.Next then return false end
	local moves: { Types.Attack } = table.clone(p.Attacks or {})
	for _, move in schedule.Extra do table.insert(moves, move) end
	if #moves == 0 then return false end
	schedule.Cursor = schedule.Cursor % #moves + 1
	schedule.Next = now + (p.AttackInterval or 3)
	local attack = table.clone(moves[schedule.Cursor])
	if e.Model:GetAttribute("AsuraBossEnraged") then
		attack.Element, attack.Damage, attack.Posture = "Lightning+Iron", attack.Damage * 1.2, attack.Posture * 1.2
	end
	Attacks.start(id, attack, targetId, allowed, now)
	return true
end
return Tactics
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">CampaignBounds</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CampaignBounds
-- Fall returns for the authored campaign regions (batches 17-21, finding #27), the counterpart of
-- MonasteryBounds' ravine mist: a body that drops below a layout's catch volume (the crypt's flooded
-- pit, the Citadel's cloud chasm and summit edge) is carried back to that volume's ledge after a short
-- hold. Boundaries themselves are the layouts' Veil boxes (built with the map). A participant in a
-- boss fight is left to the arena's own return, and duels, KO and respawns are never touched.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared
local Layout = require(Shared.RegionLayout)
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)

local Bounds = {}
Bounds.HOLD = 0.6

local layouts: { any } = {}
local below: { [number]: number } = {}
local running = false

-- Pure: the catch volume holding a root position across all layouts, if any.
function Bounds.returnFor(list: { any }, position: Vector3): any
	for _, layout in list do
		local r = Layout.returnFor(layout, position.X, position.Y, position.Z)
		if r then
			return r
		end
	end
	return nil
end

local function poll(dt: number)
	for _, player in Players:GetPlayers() do
		local id = player.UserId
		local e = Characters.GetEntity(id)
		local catch = if e and e.Fighter.State ~= "KO" and not e.Respawning and not Characters.IsInDuel(id)
			and not Characters.IsSettling(id) and player:GetAttribute("AsuraEncounter") == nil then Bounds.returnFor(layouts, e.Root.Position) else nil
		if catch then
			below[id] = (below[id] or 0) + dt
			if below[id] &gt;= Bounds.HOLD then
				below[id] = nil
				local to = catch.To
				Characters.Teleport(id, CFrame.new(to.X, to.Y + 3, to.Z) * CFrame.Angles(0, math.rad(to.Yaw), 0))
				Characters.Cue("MistReturn", id, { place = catch.Name })
			end
		else
			below[id] = nil
		end
	end
end

function Bounds.Start(list: { any })
	layouts = list
	if running then return end
	running = true
	task.spawn(function()
		while running do
			poll(task.wait(0.2))
		end
	end)
end

function Bounds.Stop()
	running = false
	table.clear(below)
end

return Bounds
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">CampaignWorld</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CampaignWorld
-- Raises the authored campaign regions (batches 17-21) as Workspace.Map_&lt;Region&gt; from their shared
-- layouts: Bamboo Pass, Ash Colosseum, the Sunken Crypt, the Celestial Pagoda and the Sky Citadel.
-- Every layout box becomes a part (RegionDecor), every lantern spot is lit, then the region's own
-- dressing module adds non-colliding silhouettes, landmarks and storytelling. Boss arena floors,
-- seals, frost pillars and portals stay with BossArenas. Start() must run before WorldService.Start():
-- each MapFolder suppresses its region's greybox floor. A failed dressing layer fails soft; a failed
-- structure layer removes that map so the greybox returns.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath").Shared
local World = require(Shared.WorldDefinitions)
local Campaign = require(Shared.CampaignZones)
local Services = script.Parent
local Decor = require(Services:WaitForChild("RegionDecor") :: ModuleScript)
local Bounds = require(Services:WaitForChild("CampaignBounds") :: ModuleScript)
local Dressings: { [string]: any } = {
	BambooPass = require(Services:WaitForChild("BambooDressing") :: ModuleScript),
	AshColosseum = require(Services:WaitForChild("ColosseumDressing") :: ModuleScript),
	SanctuaryDepths = require(Services:WaitForChild("CryptDressing") :: ModuleScript),
	CelestialPagoda = require(Services:WaitForChild("PagodaDressing") :: ModuleScript),
	SkyCitadel = require(Services:WaitForChild("CitadelDressing") :: ModuleScript),
}

local CampaignWorld = {}
local maps: { Folder } = {}
local running = false

local function build(layout: any): Folder?
	local region = World.Regions[layout.Region]
	local existing = Workspace:FindFirstChild(region.MapFolder)
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = region.MapFolder
	map:SetAttribute("AsuraRegion", layout.Region)
	local ok, problem = pcall(function()
		local structure = Instance.new("Folder")
		structure.Name = "Structure"
		structure.Parent = map
		for _, box in layout.Solids do
			Decor.solid(structure, box)
		end
		local lights = Instance.new("Folder")
		lights.Name = "Lanterns"
		lights.Parent = map
		for _, l in layout.Lights do
			Decor.lantern(lights, l[1], l[2], l[3])
		end
	end)
	if not ok then
		warn(string.format("[Asura's Path] %s structure failed: %s", layout.Region, tostring(problem)))
		map:Destroy()
		return nil
	end
	local dressing = Dressings[layout.Region]
	if dressing then
		local dressed, err = pcall(dressing.Build, map, layout, Random.new(#layout.Solids * 7919))
		if not dressed then
			warn(string.format("[Asura's Path] %s dressing skipped: %s", layout.Region, tostring(err)))
		end
	end
	local parts = 0
	for _, d in map:GetDescendants() do
		parts += if d:IsA("BasePart") then 1 else 0
	end
	map:SetAttribute("AsuraParts", parts)
	map.Parent = Workspace
	return map
end

function CampaignWorld.Start()
	assert(not running, "CampaignWorld already started")
	running = true
	local started = os.clock()
	for _, layout in Campaign.Layouts do
		local map = build(layout)
		if map then
			table.insert(maps, map)
		end
	end
	Bounds.Start(Campaign.Layouts)
	local total = 0
	for _, map in maps do
		total += map:GetAttribute("AsuraParts") or 0
	end
	print(string.format("[Asura's Path] Campaign regions raised: %d maps, %d parts (%.0f ms).", #maps, total, (os.clock() - started) * 1000))
end

function CampaignWorld.Destroy()
	running = false
	Bounds.Stop()
	for _, map in maps do
		map:Destroy()
	end
	table.clear(maps)
end

return CampaignWorld
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">CastFigures</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CastFigures
-- The speaking cast's bodies (batch 14). `statue` stands a LooksCast figure on the ground: an
-- anchored default-R15-proportioned body (rounded head, solid torso and legs, non-colliding arms)
-- dressed by CostumeKit and scaled about its feet, replacing the old robe-block NPCs; its head
-- stays at the dialogue portrait height (n.Y + ~2.3) and it faces its Look point. `dress` puts a
-- look on a live rig (Master Smith Gao) so the attire binds to the spawned character itself.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared
local Schema = require(Shared.CostumeSchema)
local Looks = require(Shared.LooksCast)
local Kit = require(script.Parent.CostumeKit)

local Figures = {}
Figures.Scale = 0.85 -- portrait height: head centre (3 + 1.8) * 0.85 = 4.1 studs above the feet
local SOLID = { UpperTorso = true, LowerTorso = true, LeftUpperLeg = true, RightUpperLeg = true, LeftLowerLeg = true, RightLowerLeg = true }

local function v3(list: { number }): Vector3 return Vector3.new(list[1], list[2], list[3]) end

function Figures.look(key: string): Schema.Look?
	return (Looks :: any)[key]
end

-- `ground` is the point under the figure's feet; returns the model, its torso and its head.
function Figures.statue(parent: Instance, key: string, ground: Vector3): (Model, BasePart, BasePart)
	local look = assert(Figures.look(key), "No cast look " .. key)
	local model = Instance.new("Model")
	model.Name = key
	local face = look.Look
	local base = if face then CFrame.lookAt(ground, Vector3.new(face[1], ground.Y, face[2])) else CFrame.new(ground)
	local root = base * CFrame.new(0, -Schema.Ground, 0)
	local limbs: { [string]: { Size: { number }, At: { number } } } = Schema.R15 :: any
	for bone, spec in limbs do
		if bone == "HumanoidRootPart" then continue end
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame = bone, v3(spec.Size), root * CFrame.new(v3(spec.At))
		-- Like the attire, non-colliding limbs stay out of queries: otherwise an arm blocks the
		-- Speak prompt's line of sight to the torso whenever the camera swings past the figure.
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, SOLID[bone] == true, SOLID[bone] == true, false
		p.Material = Enum.Material.SmoothPlastic
		if bone == "Head" then p.Shape = Enum.PartType.Ball end
		p.Parent = model
	end
	model.PrimaryPart = model:FindFirstChild("UpperTorso") :: BasePart
	Kit.build(model, look, 1)
	model.WorldPivot = base -- scale about the feet so the figure stays standing on the ground
	model:ScaleTo(Figures.Scale)
	model.Parent = parent
	return model, model:FindFirstChild("UpperTorso") :: BasePart, model:FindFirstChild("Head") :: BasePart
end

-- Dresses a live rig; returns the limbs the look could not find (empty when fully bound).
function Figures.dress(model: Model, key: string): { string }
	local look = Figures.look(key)
	if not look then return { "look:" .. key } end
	local _, missing = Kit.build(model, look, 1)
	return missing
end

return table.freeze(Figures)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CharacterService
-- Authoritative entity coordinator for player characters and PvE humanoids. Runs CombatRules on a
-- fixed 60 Hz clock, resolves weapon contact through LagCompensation and replicates each fighter as
-- a packed base64 attribute plus a batched event stream. Behaviour (AI) and world rules (altars,
-- bloodstains, progression) attach through step listeners, event subscriptions and hooks.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local Settings = require(Shared.Shared.CombatSettings) :: any
local Schema = require(Shared.Simulation.MoveSchema) :: any
local Weapons = require(Shared.Simulation.WeaponSchema) :: any
local Combat = require(Shared.Simulation.CombatRules)
local Strike = require(Shared.Simulation.StrikeGeometry)
local Contact = require(Shared.Shared.ContactCues)
local InputBuffer = require(Shared.Simulation.InputBuffer)
local Tempo = require(Shared.Simulation.Tempo) :: any
local Protocol = require(Shared.Shared.IntentProtocol)
local Lag = require(script.Parent:WaitForChild("LagCompensation") :: ModuleScript)
local Recovery = require(script.Parent:WaitForChild("RecoveryRules") :: ModuleScript)

local Persistence: any = nil
pcall(function()
	Persistence = require(script.Parent:WaitForChild("PersistenceService", 5) :: ModuleScript)
end)

type Fighter = Combat.Fighter
type Event = Combat.Event
type History = Lag.History
type Bucket = Protocol.Bucket
type WeaponType = Combat.WeaponType
export type EntityKind = "Player" | "Enemy"

export type EnemySpec = {
	Name: string,
	Weapon: WeaponType,
	CFrame: CFrame,
	Template: Model?,
	Stats: Combat.Stats?,
	Definition: string?,
	BodyColor: { number }?,
	Boss: boolean?,
}

export type Hooks = {
	RespawnPoint: ((userId: number) -&gt; CFrame?)?,
	Stats: ((userId: number) -&gt; Combat.Stats?)?,
	Loadout: ((userId: number) -&gt; (string?, string?))?,
	CanEquip: ((userId: number, weapon: string) -&gt; boolean)?,
	Rest: ((userId: number) -&gt; (boolean, string))?,
	Heal: ((userId: number) -&gt; (boolean, string))?,
	Interact: ((userId: number) -&gt; (boolean, string))?,
	LevelUp: ((userId: number, attribute: string) -&gt; (boolean, string))?,
	Swap: ((userId: number) -&gt; (boolean, string))?,
	Travel: ((userId: number, altarId: string) -&gt; (boolean, string))?,
	Skip: ((userId: number) -&gt; (boolean, string))?,
}

export type Entity = {
	Id: number,
	Kind: EntityKind,
	Player: Player?,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Fighter: Fighter,
	History: History,
	Buffer: InputBuffer.Buffer,
	Eligible: InputBuffer.Filter,
	Actions: Bucket,
	LastSeq: number,
	Scratch: buffer,
	Packed: string,
	MirroredHealth: number,
	WalkSpeed: number,
	JumpHeight: number,
	AppliedDashSeq: number,
	WeaponPart: BasePart?,
	Connections: { RBXScriptConnection },
	RespawnAt: number,
	DespawnAt: number,
	Respawning: boolean,
	Shrine: CFrame?,
	Duel: string?,
	SpawnOverride: CFrame?,
	Placement: Recovery.Hold?,
	Definition: string?,
	Boss: boolean,
	LastMoveTo: Vector3,
	MoveIssuedAt: number,
	Style: string,
	Elo: number,
	Vip: boolean,
	Cosmetics: any,
	-- StrikeGeometry facing/air state: press aim and committed yaw (each keyed by Fighter.MoveStart),
	-- last enemy Face time and the airtime allowances.
	Omni: { Aim: number?, AimFor: number, Yaw: number?, YawFor: number, LastFace: number, Air: Strike.Air },
}

type Duel = {
	Id: string,
	Mode: string,
	A: number,
	B: number,
	Complete: (string, number?, boolean, number, { [number]: number }) -&gt; any,
	Finished: boolean,
	Spawns: { CFrame }?,
	Xp: { [number]: number },
}

type EventListener = (event: Event, point: Vector3?) -&gt; ()
type StepListener = (now: number, dt: number) -&gt; ()
type EntityListener = (id: number, kind: EntityKind) -&gt; ()

local Service = {}
local Appearance = require(script.Parent:WaitForChild("FighterAppearance") :: ModuleScript)
local WeaponModels = require(script.Parent:WaitForChild("WeaponModels") :: ModuleScript)
local EnemyAppearance = require(script.Parent:WaitForChild("EnemyAppearance") :: ModuleScript)

local TICK: number = Tempo.TickSeconds
local MAX_CATCHUP: number = Config.Movement.MaxCatchupSteps
local MAX_FRAME_DELTA: number = Config.Movement.MaxFrameDelta
local SNAPSHOT_INTERVAL = math.max(1, math.floor(Tempo.TickRate / Config.Network.SnapshotRate + 0.5))
local STATE_ATTRIBUTE = "AsuraState"
local ID_ATTRIBUTE = "AsuraId"
local ENEMY_TAG = "AsuraEnemy"
local FACING_DOT = 0.15
local MOVE_RENEW = 4 -- seconds; Humanoid:MoveTo times out after 8
local PROTOCOL_TAG = "Asura1"
local MAX_SEQUENCE_GAP = 4096
local DEFAULT_JUMP = 7.2

local INTENT_ACTIONS: { [string]: boolean } = {
	Light = true,
	Heavy = true,
	WeaponArt = true,
	Roll = true,
	Dash = true,
	Deflect = true,
	Block = true,
	Sprint = true,
	Feint = true,
	Equip = true,
	Swap = true,
	Rest = true,
	Heal = true,
	Interact = true,
	LevelUp = true,
	Travel = true,
	Skip = true,
}
local BUFFERED: { [string]: boolean } = { Light = true, Heavy = true, WeaponArt = true, Roll = true, Dash = true, Deflect = true }
local INTENT_KEYS: { [string]: string } = {
	seq = "number",
	action = "string",
	time = "number",
	variant = "string",
	x = "number",
	z = "number",
	held = "boolean",
}

local WEAPON_VISUALS: { [string]: { Size: Vector3, Color: Color3, Material: Enum.Material } } = {
	Jian = { Size = Vector3.new(0.12, 0.28, 4.2), Color = Color3.fromRGB(196, 202, 210), Material = Enum.Material.Metal },
	Dao = { Size = Vector3.new(0.16, 0.5, 3.6), Color = Color3.fromRGB(170, 160, 150), Material = Enum.Material.Metal },
	Guandao = { Size = Vector3.new(0.22, 0.22, 8.5), Color = Color3.fromRGB(92, 70, 52), Material = Enum.Material.Wood },
}

local entities: { [number]: Entity } = {}
local byModel: { [Model]: Entity } = {}
local playerConnections: { [number]: { RBXScriptConnection } } = {}
local pendingSpawn: { [number]: boolean } = {}
local retryAt: { [number]: number } = {}
local connections: { RBXScriptConnection } = {}
local frameEvents: { Event } = {}
local eventPoints: { [Event]: Vector3 } = {}
local stepTimes: { number } = {}
local eventListeners: { EventListener } = {}
local stepListeners: { StepListener } = {}
local addedListeners: { EntityListener } = {}
local removedListeners: { EntityListener } = {}
local spawnedListeners: { EntityListener } = {}
local hooks: Hooks = {}
local stepTimeIndex = 0
local droppedSteps = 0
local running = false
local accumulator = 0
local tickCount = 0
local simTime = 0
-- Enemy entity ids count down from far below zero: Studio's local test players get UserIds -1, -2, ...,
-- and an enemy holding the same id made ensurePlayer skip spawning them (no multi-client tests).
local nextEnemyId = -1000000
local duels: { [string]: Duel } = {}

local net = Shared:WaitForChild("Net")
local actionRemote = net:WaitForChild("ActionIntent") :: RemoteEvent
local eventRemote = net:WaitForChild("StateSnapshots") :: RemoteEvent

local function rootFolder(name: string): Folder
	local root = Workspace:FindFirstChild(Config.Names.Root)
	if not root then
		local folder = Instance.new("Folder")
		folder.Name = Config.Names.Root
		folder.Parent = Workspace
		root = folder
	end
	local child = (root :: Instance):FindFirstChild(name)
	if not child then
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = root
		child = folder
	end
	return child :: Folder
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function notify(list: { EntityListener }, id: number, kind: EntityKind)
	for _, listener in table.clone(list) do
		local ok, problem = pcall(listener, id, kind)
		if not ok then
			warn("[CharacterService] Entity listener failed: " .. tostring(problem))
		end
	end
end

local function subscribe&lt;T&gt;(list: { T }, listener: T): () -&gt; ()
	table.insert(list, listener)
	return function()
		local index = table.find(list, listener)
		if index then
			table.remove(list, index)
		end
	end
end

local function awardXp(e: Entity, amount: number)
	local duelId = e.Duel
	local active = if duelId then duels[duelId] else nil
	if not active or active.Finished or active.Mode ~= "Ranked1v1" or e.Kind ~= "Player" then
		return
	end
	active.Xp[e.Id] = (active.Xp[e.Id] or 0) + amount
end

local function hostile(a: Entity, b: Entity): boolean
	if a.Id == b.Id then
		return false
	end
	-- Duelists are sealed inside their match: nothing outside it can strike in, nor they out.
	if (a.Duel ~= nil) ~= (b.Duel ~= nil) then
		return false
	end
	if a.Kind ~= b.Kind then
		return true
	end
	if a.Kind == "Enemy" then
		return false
	end
	if a.Duel ~= nil and a.Duel == b.Duel then
		return true
	end
	return Workspace:GetAttribute("AsuraOpenPvP") == true and a.Duel == nil and b.Duel == nil
end

local function flatUnit(v: Vector3): Vector3
	local flat = Vector3.new(v.X, 0, v.Z)
	local magnitude = flat.Magnitude
	if magnitude &lt; 1e-5 then
		return Vector3.zero
	end
	return flat / magnitude
end

local function facingDot(from: Entity, toward: Entity): number
	local look = flatUnit(from.Root.CFrame.LookVector)
	local direction = flatUnit(toward.Root.Position - from.Root.Position)
	return look:Dot(direction)
end

local function alive(e: Entity): boolean
	return e.Model.Parent ~= nil and e.Humanoid.Parent ~= nil and e.Root.Parent ~= nil
end

-------------------------------------------------------------------------------------------------
-- Weapon visuals, tint and procedural weapon volumes
-------------------------------------------------------------------------------------------------

local function attachWeapon(e: Entity)
	if e.WeaponPart then
		e.WeaponPart:Destroy()
		e.WeaponPart = nil
	end
	if e.Model:GetAttribute("AsuraWeaponVisual") == "Costume" then
		e.Model:SetAttribute("AsuraWeapon", e.Fighter.Weapon);return -- the boss look carries its weapon
	end
	if WeaponModels.attach(e.Model,e.Fighter.Weapon) then
		e.Model:SetAttribute("AsuraWeapon",e.Fighter.Weapon);return
	end
	local visual = WEAPON_VISUALS[e.Fighter.Weapon]
	e.Model:SetAttribute("AsuraWeapon", e.Fighter.Weapon)
	if visual == nil then
		return
	end
	local hand = e.Model:FindFirstChild("RightHand") or e.Model:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local part = Instance.new("Part")
	part.Name = "AsuraWeapon"
	part.Size = visual.Size
	part.Color = visual.Color
	part.Material = visual.Material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Anchored = false
	part.CFrame = hand.CFrame * CFrame.new(0, -hand.Size.Y * 0.5, -visual.Size.Z * 0.5 + 0.4)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = part
	weld.Parent = part
	part.Parent = e.Model
	WeaponModels.dress(part, e.Fighter.Weapon)
	e.WeaponPart = part
end

local function tint(model: Model, rgb: { number })
	if model:GetAttribute("AsuraCostume") ~= nil then
		return -- authored looks recolour per phase themselves (CostumeKit)
	end
	local color = Color3.fromRGB(rgb[1] or 255, rgb[2] or 255, rgb[3] or 255)
	local attire = model:FindFirstChild("AsuraAttire")
	for _, descendant in model:GetDescendants() do
		local fitting = descendant.Parent ~= nil and descendant.Parent.Name == "AsuraWeapon" -- WeaponModels.dress
		if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" and descendant.Name ~= "AsuraWeapon" and not fitting
			and not (attire and descendant:IsDescendantOf(attire)) then
			descendant.Color = color
		end
	end
end

-- World-space weapon segment for a move at `progress` through its active frames (StrikeGeometry:
-- slashes sweep the authored arc around the root, thrusts extend along the facing; lunge and reach
-- bonus fold into the tip). The client draws the same path from the AsuraStrike record.
local function weaponSegment(rootCFrame: CFrame, move: Combat.MoveData, progress: number, bonus: number): (Vector3, Vector3)
	local ax, ay, az, bx, by, bz = Strike.segment(move, progress, bonus)
	return rootCFrame:PointToWorldSpace(Vector3.new(ax, ay, az)), rootCFrame:PointToWorldSpace(Vector3.new(bx, by, bz))
end

local function yawOf(cframe: CFrame): number
	local look = cframe.LookVector
	return Strike.yaw(look.X, look.Z) or 0
end

-- The attacker's frame for the current swing: its live root turned to the committed yaw. Without a
-- commit for this move it is the live root, so nothing changes until a swing is out.
local function strikeFrame(e: Entity): CFrame
	local omni, root = e.Omni, e.Root.CFrame
	if omni.Yaw == nil or omni.YawFor ~= e.Fighter.MoveStart then
		return root
	end
	return CFrame.new(root.Position) * CFrame.Angles(0, Strike.delta(yawOf(root), omni.Yaw :: number), 0) * root.Rotation
end

local function weaponRadius(f: Fighter): number
	return if f.Weapon == "Unarmed" then 0.55 else 0.3
end

-------------------------------------------------------------------------------------------------
-- Entity construction
-------------------------------------------------------------------------------------------------

-- Ground probe for bodies that can jump; anchored (scripted flight) roots never count as airborne.
local airParams = RaycastParams.new()
airParams.FilterType = Enum.RaycastFilterType.Exclude
airParams.RespectCanCollide = true
local function airborne(e: Entity): boolean
	local root = e.Root
	if root.Anchored then
		return false
	end
	airParams.FilterDescendantsInstances = { e.Model }
	local reach = e.Humanoid.HipHeight + root.Size.Y * 0.5 + Settings.Tracking.AirborneClearance
	return Workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), airParams) == nil
end

local function ruleset(e: Entity): string?
	local value = e.Model:GetAttribute("AsuraRuleset")
	return if type(value) == "string" then value else nil
end

local function eligibleFor(e: Entity): InputBuffer.Filter
	return function(action: InputBuffer.BufferedAction, _variant: string): boolean
		local f = e.Fighter
		local now = simTime
		-- Air rules hold refused presses in the buffer, so a heavy pressed just before landing fires on touchdown.
		if not (Strike.airAllows(e.Omni.Air, action, ruleset(e))) then
			return false
		end
		if action == "Light" then
			local kind: Combat.MoveKind = if f.Sprinting and f.State == "Idle" then "RunningAttack" else "Light"
			local move = Combat.selectMove(f, kind, now)
			return (Schema.canAct(f.State, kind, f.Stamina, f.Posture, Combat.context(f, now, { StaminaCost = move.StaminaCost })))
		elseif action == "Heavy" or action == "WeaponArt" then
			local move = Combat.selectMove(f, action :: Combat.MoveKind, now)
			local extra = { StaminaCost = move.StaminaCost, QiCost = if move.QiCost &gt; 0 then move.QiCost else nil, TargetDeathblowable = true }
			return (Schema.canAct(f.State, action, f.Stamina, f.Posture, Combat.context(f, now, extra)))
				or (action == "Heavy" and (Schema.canAct(f.State, "Deathblow", f.Stamina, f.Posture, Combat.context(f, now, extra))))
		end
		return (Schema.canAct(f.State, action, f.Stamina, f.Posture, Combat.context(f, now)))
	end
end

local function disconnectAll(list: { RBXScriptConnection })
	for _, connection in list do
		connection:Disconnect()
	end
	table.clear(list)
end

local function mirrorHealth(e: Entity)
	local f = e.Fighter
	local health = if f.State == "KO" then 0 else math.max(f.ActiveHP, 0.01)
	local maximum = f.MaxHP
	if math.abs(e.Humanoid.MaxHealth - maximum) &gt; 0.005 then
		e.Humanoid.MaxHealth = maximum
	end
	if math.abs(health - e.MirroredHealth) &gt; 0.005 then
		e.MirroredHealth = health
		e.Humanoid.Health = health
	end
end

local function bindModel(e: Entity)
	local humanoid = e.Humanoid
	humanoid.MaxHealth = e.Fighter.MaxHP
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = DEFAULT_JUMP
	humanoid.WalkSpeed = Settings.Movement.WalkSpeed
	e.WalkSpeed = Settings.Movement.WalkSpeed
	e.JumpHeight = DEFAULT_JUMP
	e.MirroredHealth = -1
	mirrorHealth(e)
	local regen = e.Model:FindFirstChild("Health")
	if regen and regen:IsA("Script") then
		regen:Destroy()
	end
	e.Model:SetAttribute(ID_ATTRIBUTE, e.Id)
	e.Model:SetAttribute("AsuraKind", e.Kind)
	e.Model:SetAttribute("AsuraStyle", e.Style)
	if e.Definition then
		e.Model:SetAttribute("AsuraDefinition", e.Definition)
	end
	byModel[e.Model] = e
	if e.Kind == "Player" then
		Appearance.Apply(e.Model, e.Connections)
		local player = e.Player
		local model = e.Model
		if player then
			table.insert(e.Connections, player.CharacterAppearanceLoaded:Connect(function(loaded: Model)
				if loaded == model and e.Model == model then
					Appearance.Apply(model, e.Connections)
					attachWeapon(e)
				end
			end))
		end
	end
	table.insert(e.Connections, humanoid.HealthChanged:Connect(function(health: number)
		-- Health only falls below the mirror through outside sources (void, hazards, scripts).
		if health &lt; e.MirroredHealth - 0.5 and e.Fighter.State ~= "KO" then
			local loss = e.MirroredHealth - health
			e.MirroredHealth = health
			Combat.applyExternalDamage(e.Fighter, loss, simTime, frameEvents)
		end
	end))
	table.insert(e.Connections, humanoid.Died:Connect(function()
		Combat.knockOut(e.Fighter, simTime, frameEvents)
	end))
	attachWeapon(e)
	e.Packed = ""
end

local function newEntity(id: number, kind: EntityKind, player: Player?, model: Model, humanoid: Humanoid, root: BasePart, weapon: WeaponType): Entity
	local e: Entity = {
		Id = id,
		Kind = kind,
		Player = player,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Fighter = Combat.new(id, weapon, simTime),
		History = Lag.newHistory(),
		Buffer = InputBuffer.new(),
		Eligible = function()
			return false
		end,
		Actions = { tokens = Config.Network.ActionBurst, time = os.clock() },
		LastSeq = 0,
		Scratch = buffer.create(Combat.PACKET_SIZE),
		Packed = "",
		MirroredHealth = -1,
		WalkSpeed = 0,
		JumpHeight = 0,
		AppliedDashSeq = 0,
		WeaponPart = nil,
		Connections = {},
		RespawnAt = math.huge,
		DespawnAt = math.huge,
		Respawning = false,
		Shrine = nil,
		Duel = nil,
		SpawnOverride = nil,
		Placement = nil,
		Definition = nil,
		Boss = false,
		LastMoveTo = Vector3.new(math.huge, 0, 0),
		MoveIssuedAt = 0,
		Style = "Unarmed",
		Elo = 1000,
		Vip = false,
		Cosmetics = nil,
		Omni = { Aim = nil, AimFor = -1, Yaw = nil, YawFor = -1, LastFace = 0, Air = Strike.newAir() },
	}
	e.Eligible = eligibleFor(e)
	return e
end

local function releaseModel(e: Entity)
	disconnectAll(e.Connections)
	byModel[e.Model] = nil
	if e.WeaponPart then
		e.WeaponPart:Destroy()
		e.WeaponPart = nil
	end
end

local function removeEntity(id: number, destroyModel: boolean)
	local e = entities[id]
	if not e then
		return
	end
	releaseModel(e)
	entities[id] = nil
	if destroyModel and e.Model.Parent then
		e.Model:Destroy()
	end
	for _, other in entities do
		if other.Fighter.DeathblowPartner == id then
			other.Fighter.DeathblowPartner = 0
		end
	end
	notify(removedListeners, id, e.Kind)
end

-------------------------------------------------------------------------------------------------
-- Spawning: players, enemies, duels
-------------------------------------------------------------------------------------------------

local function defaultSpawn(): CFrame
	local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then
		return spawn.CFrame * CFrame.new(0, spawn.Size.Y * 0.5 + 3, 0)
	end
	return CFrame.new(0, Config.Movement.RootHeight + 2, 0)
end

local function duelSpawn(slot: number): CFrame
	local z = if slot == 1 then Config.Arena.SpawnDistance else -Config.Arena.SpawnDistance
	local position = Vector3.new(0, Config.Movement.RootHeight, z)
	return CFrame.lookAt(position, Vector3.new(0, Config.Movement.RootHeight, 0))
end

local function spawnCFrameFor(e: Entity): CFrame
	local override = e.SpawnOverride
	if override then
		e.SpawnOverride = nil
		return override
	end
	local duelId = e.Duel
	local active = if duelId then duels[duelId] else nil
	if active then
		local slot = if e.Id == active.A then 1 else 2
		local spawns = active.Spawns
		return if spawns and spawns[slot] then spawns[slot] else duelSpawn(slot)
	end
	local resolver = hooks.RespawnPoint
	if resolver and e.Kind == "Player" then
		local ok, point = pcall(resolver, e.Id)
		if ok and point then
			return point
		end
	end
	return e.Shrine or defaultSpawn()
end

-- Floor probe for respawn placement; ignores every fighter so nobody spawns on another's head.
local function groundProbe(model: Model): Recovery.Probe
	local ignore: { Instance } = { model, rootFolder("Entities") }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	return function(origin: Vector3, direction: Vector3): Vector3?
		local hit = Workspace:Raycast(origin, direction, params)
		return if hit then hit.Position else nil
	end
end

local function placeBody(e: Entity, target: CFrame)
	e.Model:PivotTo(target)
	e.Root.AssemblyLinearVelocity = Vector3.zero
	e.LastMoveTo = Vector3.new(math.huge, 0, 0)
	Lag.clear(e.History)
end

-- LoadCharacter may move the body after CharacterAdded placed it; hold the target briefly.
local function settle(e: Entity, hold: Recovery.Hold, clock: number)
	local verdict = Recovery.check(hold, e.Root.Position, clock)
	if verdict == "Release" then
		e.Placement = nil
	elseif verdict == "Correct" then
		print(string.format("[CharacterService] Respawn of %d displaced to %s; restored to %s", e.Id, tostring(e.Root.Position), tostring(hold.Target.Position)))
		placeBody(e, hold.Target)
	end
end

local function loadProfile(e: Entity)
	local player = e.Player
	if not player or not Persistence then
		return
	end
	local ok, profile = pcall(Persistence.Get, player.UserId)
	if not ok or not profile then
		return
	end
	e.Elo = profile.elo or e.Elo
	e.Vip = profile.ownedCosmetics ~= nil and profile.ownedCosmetics.VIP_Pass == true
	e.Style = if type(profile.activeStyle) == "string" and profile.activeStyle ~= "" then profile.activeStyle else e.Style
	e.Cosmetics = profile.equippedCosmetics
end

local function applyPlayerProgression(e: Entity)
	local statsHook = hooks.Stats
	if statsHook then
		local ok, stats = pcall(statsHook, e.Id)
		if ok and stats then
			Combat.applyStats(e.Fighter, stats, true)
		end
	end
	local loadoutHook = hooks.Loadout
	if loadoutHook then
		local ok, mainhand = pcall(loadoutHook, e.Id)
		if ok and type(mainhand) == "string" and Weapons.Weapons[mainhand] then
			Combat.forceWeapon(e.Fighter, mainhand :: WeaponType)
		end
	end
end

local function onCharacter(player: Player, model: Model)
	local humanoid = model:WaitForChild("Humanoid", 10)
	local root = model:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") or not player.Parent then
		return
	end
	-- CharacterAdded can precede the body assembly. The outfit and held weapon need the limbs.
	local r15 = humanoid.RigType == Enum.HumanoidRigType.R15
	local head = model:WaitForChild("Head", 10)
	local torso = model:WaitForChild(if r15 then "UpperTorso" else "Torso", 10)
	local hand = model:WaitForChild(if r15 then "RightHand" else "Right Arm", 10)
	if not head or not torso or not hand or player.Character ~= model then return end
	local id = player.UserId
	local existing = entities[id]
	local created = existing == nil
	local e: Entity
	if existing then
		releaseModel(existing)
		existing.Model = model
		existing.Humanoid = humanoid
		existing.Root = root
		e = existing
	else
		e = newEntity(id, "Player", player, model, humanoid, root, "Unarmed")
		entities[id] = e
		loadProfile(e)
	end
	Combat.restore(e.Fighter, simTime, true)
	applyPlayerProgression(e)
	Combat.restore(e.Fighter, simTime, true)
	e.Fighter.State = "Idle"
	e.Fighter.StateStart = simTime
	e.Fighter.StateEnd = math.huge
	e.RespawnAt = math.huge
	e.Respawning = false
	Lag.clear(e.History)
	InputBuffer.clear(e.Buffer)
	bindModel(e)
	model:SetAttribute("AsuraDuel", e.Duel)
	local target = Recovery.standing(spawnCFrameFor(e), Config.Movement.RootHeight, groundProbe(model))
	placeBody(e, target)
	e.Placement = Recovery.begin(target, os.clock())
	if e.Cosmetics then
		model:SetAttribute("Trunks", e.Cosmetics.Trunks)
		model:SetAttribute("Gloves", e.Cosmetics.Gloves)
	end
	if created then
		notify(addedListeners, id, "Player")
	end
	notify(spawnedListeners, id, "Player")
end

local function requestCharacter(player: Player)
	local id = player.UserId
	if pendingSpawn[id] or not player.Parent then
		return
	end
	pendingSpawn[id] = true
	task.spawn(function()
		local ok, problem = pcall(function()
			player:LoadCharacter()
			-- Avatar assembly may replace early cosmetic parts while applying its description.
			local current = entities[id]
			if current and current.Model == player.Character then
				Appearance.Apply(current.Model, current.Connections)
				attachWeapon(current)
			end
		end)
		pendingSpawn[id] = nil
		if not ok then
			warn("[CharacterService] LoadCharacter failed for " .. tostring(id) .. ": " .. tostring(problem))
			retryAt[id] = os.clock() + 2
			local e = entities[id]
			if e then
				e.Respawning = false
			end
		end
	end)
end

local function trackPlayer(player: Player)
	local id = player.UserId
	if playerConnections[id] then
		return
	end
	local list: { RBXScriptConnection } = {}
	playerConnections[id] = list
	table.insert(list, player.CharacterAdded:Connect(function(model: Model)
		onCharacter(player, model)
	end))
	table.insert(list, player.CharacterRemoving:Connect(function(model: Model)
		local e = entities[id]
		if e and e.Model == model then
			releaseModel(e)
		end
	end))
end

local function profileReady(player: Player): boolean
	if not Persistence then
		return true
	end
	local ok, profile = pcall(Persistence.Get, player.UserId)
	return ok and profile ~= nil
end

local function ensurePlayer(player: Player)
	trackPlayer(player)
	local e = entities[player.UserId]
	if e and alive(e) then
		return
	end
	if player.Character and player.Character.Parent then
		task.spawn(onCharacter, player, player.Character)
		return
	end
	requestCharacter(player)
end

local function buildEnemyModel(spec: EnemySpec): Model?
	if spec.Template then
		return spec.Template:Clone()
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok then
		warn("[CharacterService] Enemy rig creation failed: " .. tostring(model))
		return nil
	end
	return model
end

local function spawnEnemy(spec: EnemySpec, existing: Model?): number?
	local model = existing or buildEnemyModel(spec)
	if not model then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		warn("[CharacterService] Enemy model lacks Humanoid/HumanoidRootPart: " .. spec.Name)
		if not existing then
			model:Destroy()
		end
		return nil
	end
	local id = nextEnemyId
	nextEnemyId -= 1
	model.Name = spec.Name
	humanoid.DisplayName = spec.Name
	humanoid.BreakJointsOnDeath = false -- no physics breakup; EnemyDissolve authors the death
	-- Authored enemy looks (EnemyAppearance) replace the flat body tint for known mobs.
	local dressed = model:FindFirstChild("AsuraAttire") ~= nil or EnemyAppearance.Apply(model, spec.Definition)
	if spec.BodyColor and not dressed then
		tint(model, spec.BodyColor)
	end
	if not existing then
		model.Parent = rootFolder("Entities")
	end
	model:PivotTo(spec.CFrame)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local e = newEntity(id, "Enemy", nil, model, humanoid, root, spec.Weapon)
	e.Style = spec.Weapon
	e.Definition = spec.Definition
	e.Boss = spec.Boss == true
	if spec.Stats then
		Combat.applyStats(e.Fighter, spec.Stats, true)
	end
	entities[id] = e
	bindModel(e)
	model:SetAttribute("AsuraBoss", e.Boss)
	notify(addedListeners, id, "Enemy")
	return id
end

local function registerTagged(instance: Instance)
	if not instance:IsA("Model") or byModel[instance] or not instance:IsDescendantOf(Workspace) then
		return
	end
	local weaponName = instance:GetAttribute("Weapon")
	local weapon: WeaponType = if type(weaponName) == "string" and Weapons.Weapons[weaponName] then weaponName :: WeaponType else "Unarmed"
	local definition = instance:GetAttribute("Definition")
	spawnEnemy({
		Name = instance.Name,
		Weapon = weapon,
		CFrame = instance:GetPivot(),
		Definition = if type(definition) == "string" then definition else nil,
	}, instance)
end

-------------------------------------------------------------------------------------------------
-- Intent handling
-------------------------------------------------------------------------------------------------

local function validIntent(packet: any, lastSeq: number): boolean
	if type(packet) ~= "table" then
		return false
	end
	local count = 0
	for key, value in packet do
		count += 1
		if count &gt; 7 or type(key) ~= "string" then
			return false
		end
		local expected = INTENT_KEYS[key]
		if expected == nil or type(value) ~= expected then
			return false
		end
		if expected == "number" and (value ~= value or math.abs(value) == math.huge) then
			return false
		end
	end
	local seq, action = packet.seq, packet.action
	if type(seq) ~= "number" or seq % 1 ~= 0 or seq &lt;= lastSeq or seq &gt; lastSeq + MAX_SEQUENCE_GAP then
		return false
	end
	if type(action) ~= "string" or not INTENT_ACTIONS[action] or type(packet.time) ~= "number" then
		return false
	end
	if packet.variant ~= nil and #packet.variant &gt; 32 then
		return false
	end
	if packet.x ~= nil and math.abs(packet.x) &gt; 1.001 then
		return false
	end
	if packet.z ~= nil and math.abs(packet.z) &gt; 1.001 then
		return false
	end
	return true
end

local function report(e: Entity, seq: number, ok: boolean, reason: string)
	local player = e.Player
	if player then
		player:SetAttribute("AsuraAck", seq)
		player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
	end
end

local function findDeathblowTarget(attacker: Entity, now: number): Entity?
	local best: Entity? = nil
	local bestDistance = math.huge
	for _, other in entities do
		if other.Fighter.State == "StanceBroken" and hostile(attacker, other) and alive(other) then
			local distance = (other.Root.Position - attacker.Root.Position).Magnitude
			if distance &lt; bestDistance then
				local ok = Combat.canDeathblow(attacker.Fighter, other.Fighter, distance, facingDot(attacker, other), now)
				if ok then
					best, bestDistance = other, distance
				end
			end
		end
	end
	return best
end

local function applyDash(e: Entity)
	local f = e.Fighter
	if f.DashSeq == e.AppliedDashSeq then
		return
	end
	e.AppliedDashSeq = f.DashSeq
	if e.Kind ~= "Enemy" or f.DashDuration &lt;= 0 then
		-- Players own their assembly; the client executes the granted displacement from the replicated record.
		return
	end
	local direction = Vector3.new(f.DashDirX, 0, f.DashDirZ)
	if direction.Magnitude &lt; 1e-3 then
		direction = -flatUnit(e.Root.CFrame.LookVector)
	end
	local velocity = direction * (f.DashDistance / f.DashDuration)
	e.Root.AssemblyLinearVelocity = Vector3.new(velocity.X, e.Root.AssemblyLinearVelocity.Y, velocity.Z)
end

-- Press aim for a swing that just started (StrikeGeometry): the sent direction (players), else the
-- body's facing (AI turns through Face). A combo follow-up turns from the last committed yaw at the
-- shared rate only, the same budget an enemy's Face gets while recovering.
local function aimStrike(e: Entity, prevState: string, prevYaw: number?, prevEnd: number, dirX: number, dirZ: number)
	local f, omni = e.Fighter, e.Omni
	local aim = Strike.yaw(dirX, dirZ) or yawOf(e.Root.CFrame)
	if prevState == "Recovery" and prevYaw then
		aim = Strike.turn(prevYaw, aim, Strike.turnStep("Recovery", 0, 0, math.max(0, simTime - prevEnd)))
	elseif prevState ~= "Recovery" and Strike.turnStep(prevState, 0, 0, 1) ~= math.huge then
		-- Out of a guard the swing leaves along the body (guards turn at the shared rate, never snap).
		aim = yawOf(e.Root.CFrame)
	end
	omni.Aim, omni.AimFor = aim, f.MoveStart
end

local function attack(e: Entity, kind: Combat.MoveKind, now: number, dirX: number, dirZ: number): (boolean, string)
	local f = e.Fighter
	local prevState, prevYaw = f.State, if e.Omni.YawFor == f.MoveStart then e.Omni.Yaw else nil
	local prevEnd = Combat.recoveryStart(f)
	local ok, reason = Combat.tryAttack(f, kind, now)
	if ok then
		aimStrike(e, prevState, prevYaw, prevEnd, dirX, dirZ)
		Strike.airSpend(e.Omni.Air, if kind == "RunningAttack" then "Light" else kind)
	end
	return ok, reason
end

local function perform(e: Entity, action: string, pressTime: number, dirX: number, dirZ: number): (boolean, string)
	local f = e.Fighter
	local now = simTime
	local airOk, airReason = Strike.airAllows(e.Omni.Air, action, ruleset(e))
	if not airOk then
		return false, airReason
	end
	if action == "Light" then
		local kind: Combat.MoveKind = if f.Sprinting and f.State == "Idle" and not e.Omni.Air.Airborne then "RunningAttack" else "Light"
		return attack(e, kind, now, dirX, dirZ)
	elseif action == "Heavy" then
		local victim = findDeathblowTarget(e, now)
		if victim then
			local dealt = Combat.executeDeathblow(f, victim.Fighter, now, frameEvents)
   if f.SignatureFinisher then Service.Cue("SignatureFinisher",e.Id,{target=victim.Id,weapon=f.Weapon,position=victim.Root.Position}) end
			eventPoints[frameEvents[#frameEvents]] = victim.Root.Position
			awardXp(e, 60)
			local look = flatUnit(victim.Root.Position - e.Root.Position)
			if e.Kind == "Enemy" and look.Magnitude &gt; 0 then
				e.Root.CFrame = CFrame.lookAt(e.Root.Position, e.Root.Position + look)
			end
			return true, "Deathblow:" .. string.format("%.1f", dealt)
		end
		return attack(e, "Heavy", now, dirX, dirZ)
	elseif action == "WeaponArt" then
		return attack(e, "WeaponArt", now, dirX, dirZ)
	elseif action == "Roll" or action == "Dash" then
		local grant, reason = Combat.tryDash(f, action :: "Roll" | "Dash", now, dirX, dirZ, frameEvents)
		if grant then
			Strike.airSpend(e.Omni.Air, action)
			applyDash(e)
			return true, reason
		end
		return false, reason
	elseif action == "Deflect" then
		return Combat.tryDeflect(f, now, pressTime)
	end
	return false, "UnknownAction"
end

local function callHook(name: string, ...: any): (boolean, string)
	local hook = (hooks :: any)[name]
	if hook == nil then
		return false, "Unavailable"
	end
	local ok, accepted, reason = pcall(hook, ...)
	if not ok then
		warn("[CharacterService] " .. name .. " hook failed: " .. tostring(accepted))
		return false, "Error"
	end
	return accepted == true, if type(reason) == "string" then reason else name
end

local function immediate(e: Entity, packet: any): (boolean, string)
	local f = e.Fighter
	local now = simTime
	local action: string = packet.action
	if action == "Block" then
		return Combat.setGuard(f, packet.held == true, now)
	elseif action == "Sprint" then
		local ok = Combat.setSprint(f, packet.held == true, now)
		return ok, if ok then "Sprint" else "SprintRefused"
	elseif action == "Feint" then
		return Combat.tryFeint(f, now, frameEvents)
	elseif action == "Equip" then
		local weapon = packet.variant
		if type(weapon) ~= "string" or Weapons.Weapons[weapon] == nil then
			return false, "UnknownWeapon"
		end
		local guard = hooks.CanEquip
		if guard and not guard(e.Id, weapon) then
			return false, "WeaponLocked"
		end
		local ok, reason = Combat.tryEquip(f, weapon :: WeaponType, now)
		if ok then
			attachWeapon(e)
		end
		return ok, reason
	elseif action == "Swap" then
		return callHook("Swap", e.Id)
	elseif action == "Rest" then
		if e.Duel then
			return false, "InDuel"
		end
		return callHook("Rest", e.Id)
	elseif action == "Heal" then
		return callHook("Heal", e.Id)
	elseif action == "Interact" then
		return callHook("Interact", e.Id)
	elseif action == "LevelUp" then
		return callHook("LevelUp", e.Id, packet.variant or "")
	elseif action == "Travel" then
		if e.Duel then
			return false, "InDuel"
		end
		return callHook("Travel", e.Id, packet.variant or "")
	elseif action == "Skip" then
		return callHook("Skip", e.Id) -- ends this player's boss cutscene lock (EncounterHandoff)
	end
	return false, "UnknownAction"
end

local function onIntent(player: Player, packet: any)
	if not running then
		return
	end
	local e = entities[player.UserId]
	if not e or e.Respawning then
		return
	end
	if not Protocol.Take(e.Actions, os.clock(), 1, Config.Network.ActionsPerSecond, Config.Network.ActionBurst) then
		return
	end
	if not validIntent(packet, e.LastSeq) then
		return
	end
	e.LastSeq = packet.seq
	local action: string = packet.action
	if BUFFERED[action] then
		local pressTime = Tempo.reconcile(packet.time, simTime, Lag.MAX_REWIND)
		InputBuffer.push(e.Buffer, action :: InputBuffer.BufferedAction, pressTime, packet.variant, packet.x, packet.z)
		report(e, packet.seq, true, "Buffered")
		return
	end
	local ok, reason = immediate(e, packet)
	report(e, packet.seq, ok, reason)
end

local function drainBuffer(e: Entity)
	if InputBuffer.count(e.Buffer) == 0 then
		return
	end
	local action, pressTime, _variant, dirX, dirZ = InputBuffer.pop(e.Buffer, simTime, e.Eligible)
	if action == nil then
		return
	end
	local ok, reason = perform(e, action, pressTime or simTime, dirX or 0, dirZ or 0)
	local player = e.Player
	if player then
		player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
	end
end

-------------------------------------------------------------------------------------------------
-- Simulation step
-------------------------------------------------------------------------------------------------

-- First active frame of a swing: fix its yaw (StrikeGeometry.commit) for the server sweep, turn an
-- AI body to it so the body agrees, and publish the record the client draws (AsuraStrike).
local function commitStrike(e: Entity)
	local f, omni = e.Fighter, e.Omni
	local move = f.Move
	if move == nil or omni.YawFor == f.MoveStart then
		return
	end
	local actual = yawOf(e.Root.CFrame)
	local aim = if omni.AimFor == f.MoveStart and omni.Aim then omni.Aim :: number else actual
	omni.Yaw, omni.YawFor = Strike.commit(aim, actual, move.Timing.StartupSeconds), f.MoveStart
	if e.Kind == "Enemy" then
		e.Root.CFrame = strikeFrame(e)
	end
	if not Combat.RangedEffects[move.Effect or ""] then
		e.Model:SetAttribute("AsuraStrike", Strike.encode({ Arc = move.Arc, Reach = move.Reach + f.ReachBonus, Lunge = move.Lunge,
			Yaw = omni.Yaw :: number, Start = f.MoveStart + move.Timing.StartupSeconds, Active = move.Timing.ActiveSeconds, Weapon = f.Weapon }))
	end
end

local function resolveContacts(attacker: Entity, now: number)
	local f = attacker.Fighter
	local move = f.Move
	if move and Combat.RangedEffects[move.Effect or ""] then return end
	local progress = Combat.activeProgress(f, now)
	if move == nil or progress == nil then
		return
	end
	local previous = math.max(0, progress - TICK / math.max(move.Timing.ActiveSeconds, TICK))
	local rootCFrame = strikeFrame(attacker)
	local prevA, prevB = weaponSegment(rootCFrame, move, previous, f.ReachBonus)
	local curA, curB = weaponSegment(rootCFrame, move, progress, f.ReachBonus)
	local radius = weaponRadius(f)
	local player = attacker.Player
	local rewindTo = if player then Lag.rewindTime(now, nil, player:GetNetworkPing()) else now
	for _, defender in entities do
		if defender ~= attacker and not f.HitRegistry[defender.Id] and defender.Fighter.State ~= "KO" and alive(defender) and hostile(attacker, defender) then
			local hit = Lag.queryHit(prevA, prevB, curA, curB, radius, defender.History, rewindTo, TICK)
			if hit then
				local before = #frameEvents
				local ankleTarget = defender.Model:GetAttribute("AsuraVisceralTarget") == "Ankles"
				local ankleHit = ankleTarget and (hit.Region == "LeftLeg" or hit.Region == "RightLeg")
				local outcome = Combat.resolveHit(f, defender.Fighter, now, {
					Facing = facingDot(defender, attacker) &gt;= FACING_DOT,
					Region = hit.Region :: any,
					PostureBonus = if ankleHit then move.PostureDamage * 1.8 else nil,
				}, frameEvents)
				for index = before + 1, #frameEvents do
					eventPoints[frameEvents[index]] = hit.Point
				end
				if outcome == "Deflected" then
					awardXp(defender, 15)
				elseif outcome == "Hit" or outcome == "CounterHit" or outcome == "Armored" then
					awardXp(attacker, if outcome == "CounterHit" then 20 else 10)
				elseif outcome == "KO" then
					awardXp(attacker, 100)
				end
			end
		end
	end
end

-- F07: Combat.step ends an active window before contacts are resolved, so the tick that closes it
-- never swept the blade to full extension and every move fell short of its authored reach (a Jian
-- thrust touched ~6 of 7.5 studs and read as MISSED). Sweep that last stretch first; a hit lands on
-- the same tick and fills HitRegistry, so the expiring window no longer reports a whiff.
local function sweepClosingWindows(live: { Entity }, now: number)
	for _, e in live do
		local f = e.Fighter
		if entities[e.Id] == e and f.State == "Active" and f.Move and now &gt;= f.StateEnd then
			resolveContacts(e, now)
		end
	end
end

-- Whiffs (batch 09): name the foe a contact-less swing was nearest to and how many studs short it
-- fell, and place the cue at the weapon tip, so a miss reads as distance rather than a broken hit.
local function annotateWhiffs(from: number)
	for index = from, #frameEvents do
		local event = frameEvents[index]
		local e = if event.Kind == "Whiff" then entities[event.Source] else nil
		local move = e and e.Fighter.Move
		if e and move then
			local reach = move.Reach + e.Fighter.ReachBonus + move.Lunge * 0.35
			local best, gap = nil :: Entity?, math.huge
			for _, other in entities do
				if other ~= e and other.Fighter.State ~= "KO" and alive(other) and hostile(e, other) then
					local g = Contact.gap(e.Root.Position, other.Root.Position, reach)
					if g &lt; gap then best, gap = other, g end
				end
			end
			if best and gap &lt;= Contact.NoticeRange then
				event.Target, event.Value = best.Id, gap
			end
			local _, tip = weaponSegment(strikeFrame(e), move, 1, e.Fighter.ReachBonus)
			eventPoints[event] = tip
		end
	end
end

-- Enemy deaths are authored on clients (EnemyDissolve): the fallen body is pinned where it fell,
-- keeps its joints (BreakJointsOnDeath is off) and stops colliding or answering queries, so it
-- never blocks a walkway, a camera probe or a later swing while it collapses and burns away.
local function settleCorpse(e: Entity)
	-- A boss felled mid-flight or mid-pounce comes down to the floor before it dissolves.
	local params = RaycastParams.new()
	local ignore: { Instance } = { e.Model, rootFolder("Entities") }
	for _, player in Players:GetPlayers() do
		if player.Character then table.insert(ignore, player.Character) end
	end
	params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, ignore
	local floor = Workspace:Raycast(e.Root.Position, Vector3.new(0, -400, 0), params)
	local stand = e.Humanoid.HipHeight + e.Root.Size.Y * 0.5
	if floor and e.Root.Position.Y - floor.Position.Y &gt; stand + 1 then
		e.Model:PivotTo(e.Model:GetPivot() - Vector3.yAxis * (e.Root.Position.Y - floor.Position.Y - stand))
	end
	e.Root.Anchored = true
	for _, d in e.Model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide, d.CanQuery, d.CanTouch = false, false, false
		end
	end
	e.Model:SetAttribute("AsuraDissolve", simTime)
end

local function finishDuel(loser: Entity)
	local duelId = loser.Duel
	local active = if duelId then duels[duelId] else nil
	if not active or active.Finished then
		return
	end
	active.Finished = true
	local winner = if loser.Id == active.A then active.B else active.A
	local results = table.clone(active.Xp)
	local complete = active.Complete
	local matchId = active.Id
	task.spawn(function()
		local ok, problem = pcall(complete, matchId, winner, false, 1, results)
		if not ok then
			warn("[CharacterService] Duel completion failed: " .. tostring(problem))
		end
	end)
end

local function handleDefeat(e: Entity, now: number)
	local f = e.Fighter
	if f.State ~= "KO" then
		return
	end
	if e.Kind == "Enemy" then
		if e.DespawnAt == math.huge then
			e.DespawnAt = now + Settings.Respawn.EnemyCorpseTime
			e.Humanoid:MoveTo(e.Root.Position)
			settleCorpse(e)
		elseif now &gt;= e.DespawnAt then
			removeEntity(e.Id, true)
		end
		return
	end
	if e.Duel then
		finishDuel(e)
		return
	end
	if e.RespawnAt == math.huge then
		e.RespawnAt = now + Settings.Respawn.PlayerDelay
	elseif now &gt;= e.RespawnAt and not e.Respawning then
		local player = e.Player
		if player and player.Parent then
			e.Respawning = true
			requestCharacter(player)
		end
	end
end

local function applyLocomotion(e: Entity)
	local f = e.Fighter
	e.Model:SetAttribute("JadeAegisUntil",f.WardUntil)
	local speed = if f.RootUntil &gt; simTime then 0 else Settings.Movement.WalkSpeed * Combat.speedMultiplier(f)
	if math.abs(speed - e.WalkSpeed) &gt; 0.01 then
		e.WalkSpeed = speed
		e.Humanoid.WalkSpeed = speed
	end
	local jump = if speed &gt; 0 and (f.State == "Idle" or f.State == "Blocking") then DEFAULT_JUMP else 0
	if jump ~= e.JumpHeight then
		e.JumpHeight = jump
		e.Humanoid.JumpHeight = jump
	end
	-- AI bodies walk during windups (0.35x) and swings (0.25x); only Face may turn them then.
	if e.Kind == "Enemy" then
		local free = Strike.turnStep(f.State, 0, 0, 1) == math.huge
		if e.Humanoid.AutoRotate ~= free then
			e.Humanoid.AutoRotate = free
		end
	end
end

local function replicate(e: Entity, now: number)
	local packed = Combat.packString(e.Fighter, now, e.Scratch)
	if packed ~= e.Packed then
		e.Packed = packed
		e.Model:SetAttribute(STATE_ATTRIBUTE, packed)
	end
end

local function flushEvents(now: number)
	if #frameEvents == 0 then
		return
	end
	local batch = table.create(#frameEvents)
	for index, event in frameEvents do
		local point = eventPoints[event]
		for _, listener in eventListeners do
			local ok, problem = pcall(listener, event, point)
			if not ok then
				warn("[CharacterService] Event listener failed: " .. tostring(problem))
			end
		end
		batch[index] = {
			k = Combat.EventCodes[event.Kind],
			s = event.Source,
			t = event.Target,
			v = math.floor(event.Value * 100 + 0.5) / 100,
			r = event.Region,
			p = point,
		}
	end
	table.clear(frameEvents)
	table.clear(eventPoints)
	eventRemote:FireAllClients({ v = PROTOCOL_TAG, t = now, e = batch })
end

local function step()
	tickCount += 1
	simTime += TICK
	local drift = serverNow() - simTime
	if math.abs(drift) &gt; 0.25 then
		simTime += drift
	end
	local now = simTime

	local live: { Entity } = {}
	local clock = os.clock()
	for _, e in entities do
		if alive(e) then
			local hold = e.Placement
			if hold then
				settle(e, hold, clock)
			end
			table.insert(live, e)
			Lag.record(e.History, now, e.Root.CFrame, e.Root.AssemblyLinearVelocity)
		elseif e.Kind == "Player" and not e.Respawning and not pendingSpawn[e.Id] and clock &gt;= (retryAt[e.Id] or 0) then
			-- Character vanished outside the combat flow (destroyed, reset): restore one.
			local player = e.Player
			if player and player.Parent then
				e.Respawning = true
				requestCharacter(player)
			end
		end
	end
	table.sort(live, function(a: Entity, b: Entity): boolean
		return a.Id &gt; b.Id
	end)

	for _, listener in stepListeners do
		local ok, problem = pcall(listener, now, TICK)
		if not ok then
			warn("[CharacterService] Step listener failed: " .. tostring(problem))
		end
	end

	sweepClosingWindows(live, now)
	local stepped = #frameEvents + 1
	for _, e in live do
		if entities[e.Id] == e then
			local f = e.Fighter
			local air = e.Omni.Air
			if e.Kind == "Player" then
				Strike.airUpdate(air, airborne(e))
			end
			if air.Landing and not air.Airborne and Combat.landingRecovery(f, now, Settings.Tracking.LandingRecoverySeconds) ~= "Wait" then
				air.Landing = false
			end
			Combat.step(f, now, TICK, frameEvents)
			if f.GuardHeld and f.State == "Idle" then
				Combat.setGuard(f, true, now)
			end
			drainBuffer(e)
		end
	end

	annotateWhiffs(stepped)

	for _, e in live do
		if entities[e.Id] == e and e.Fighter.State == "Active" then
			commitStrike(e)
			resolveContacts(e, now)
		end
	end

	local replicateNow = tickCount % SNAPSHOT_INTERVAL == 0
	for _, e in live do
		if entities[e.Id] == e then
			handleDefeat(e, now)
		end
		if entities[e.Id] == e then
			applyDash(e)
			applyLocomotion(e)
			mirrorHealth(e)
			if replicateNow then
				replicate(e, now)
			end
		end
	end

	flushEvents(now)
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function Service.Start()
	assert(not running, "CharacterService already started")
	running = true
	accumulator = 0
	tickCount = 0
	simTime = serverNow()
	Players.CharacterAutoLoads = false
	rootFolder("Entities")

	table.insert(connections, Players.PlayerAdded:Connect(function(player: Player)
		trackPlayer(player)
		if not Persistence then
			ensurePlayer(player)
		end
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		local id = player.UserId
		removeEntity(id, false)
		pendingSpawn[id] = nil
		retryAt[id] = nil
		local list = playerConnections[id]
		if list then
			disconnectAll(list)
			playerConnections[id] = nil
		end
	end))
	for _, player in Players:GetPlayers() do
		trackPlayer(player)
		if profileReady(player) then
			ensurePlayer(player)
		end
	end

	for _, instance in CollectionService:GetTagged(ENEMY_TAG) do
		registerTagged(instance)
	end
	table.insert(connections, CollectionService:GetInstanceAddedSignal(ENEMY_TAG):Connect(registerTagged))
	table.insert(connections, actionRemote.OnServerEvent:Connect(onIntent))
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		accumulator += math.min(dt, MAX_FRAME_DELTA)
		local steps = 0
		while accumulator &gt;= TICK and steps &lt; MAX_CATCHUP do
			accumulator -= TICK
			steps += 1
			local started = os.clock()
			step()
			stepTimeIndex = stepTimeIndex % 7200 + 1
			stepTimes[stepTimeIndex] = (os.clock() - started) * 1000
		end
		if accumulator &gt;= TICK then
			droppedSteps += math.floor(accumulator / TICK)
			accumulator %= TICK
		end
	end))
end

function Service.Destroy()
	running = false
	disconnectAll(connections)
	for id, e in entities do
		removeEntity(id, e.Kind == "Enemy")
	end
	for id, list in playerConnections do
		disconnectAll(list)
		playerConnections[id] = nil
	end
	table.clear(frameEvents)
	table.clear(eventPoints)
	table.clear(duels)
end

-------------------------------------------------------------------------------------------------
-- Extension points
-------------------------------------------------------------------------------------------------

function Service.SetHooks(newHooks: Hooks)
	hooks = newHooks
end

function Service.GetHooks(): Hooks
	return hooks
end

function Service.Subscribe(listener: EventListener): () -&gt; ()
	return subscribe(eventListeners, listener)
end

function Service.OnStep(listener: StepListener): () -&gt; ()
	return subscribe(stepListeners, listener)
end

function Service.OnEntityAdded(listener: EntityListener): () -&gt; ()
	return subscribe(addedListeners, listener)
end

function Service.OnEntityRemoved(listener: EntityListener): () -&gt; ()
	return subscribe(removedListeners, listener)
end

-- Fires after every player character admission (first spawn and each respawn), once placed.
function Service.OnCharacterSpawned(listener: EntityListener): () -&gt; ()
	return subscribe(spawnedListeners, listener)
end

-- True while a fresh body is held at its respawn point; recovery safeguards must ignore it.
function Service.IsSettling(id: number): boolean
	local e = entities[id]
	return e ~= nil and e.Placement ~= nil
end

function Service.Now(): number
	return simTime
end

function Service.GetEntity(id: number): Entity?
	local e = entities[id]
	if e and alive(e) then
		return e
	end
	return nil
end

function Service.Entities(): { [number]: Entity }
	return entities
end

function Service.IsHostile(a: number, b: number): boolean
	local first, second = entities[a], entities[b]
	return first ~= nil and second ~= nil and hostile(first, second)
end

function Service.IsInDuel(id: number): boolean
	local e = entities[id]
	return e ~= nil and e.Duel ~= nil
end

function Service.GetDuel(id: number): string?
	local e = entities[id]
	return if e then e.Duel else nil
end

-------------------------------------------------------------------------------------------------
-- Control surface for AI and world services
-------------------------------------------------------------------------------------------------

function Service.PushIntent(id: number, action: InputBuffer.BufferedAction, variant: string?, dirX: number?, dirZ: number?): boolean
	local e = entities[id]
	if not e or not alive(e) then
		return false
	end
	return InputBuffer.push(e.Buffer, action, simTime, variant, dirX, dirZ)
end

function Service.SetGuard(id: number, held: boolean): boolean
	local e = entities[id]
	if not e then
		return false
	end
	return (Combat.setGuard(e.Fighter, held, simTime))
end

function Service.SetSprint(id: number, on: boolean): boolean
	local e = entities[id]
	if not e then
		return false
	end
	return Combat.setSprint(e.Fighter, on, simTime)
end

function Service.MoveTo(id: number, position: Vector3)
	local e = entities[id]
	if not e or not alive(e) or e.Kind ~= "Enemy" then
		return
	end
	-- F08: Humanoid:MoveTo gives up after 8 s, so a chase toward a foe standing still stalled for good
	-- (the Sparring Phantom never closed on a player who waited). Renew it before the engine does.
	if (position - e.LastMoveTo).Magnitude &gt; 0.75 or simTime - e.MoveIssuedAt &gt; MOVE_RENEW then
		e.LastMoveTo, e.MoveIssuedAt = position, simTime
		e.Humanoid:MoveTo(position)
	end
end

function Service.StopMoving(id: number)
	local e = entities[id]
	if e and alive(e) and e.Kind == "Enemy" then
		e.LastMoveTo = e.Root.Position
		e.Humanoid:MoveTo(e.Root.Position)
	end
end

function Service.Face(id: number, position: Vector3)
	local e = entities[id]
	if not e or not alive(e) or e.Kind ~= "Enemy" then
		return
	end
	local f = e.Fighter
	if f.State == "Dashing" or f.State == "Active" or Schema.isStunned(f.State) or Schema.isLocked(f.State) then
		return
	end
	local origin = e.Root.Position
	local direction = flatUnit(position - origin)
	if direction.Magnitude &gt; 0 then
		-- StrikeGeometry: instant in neutral, the shared rate while winding up or recovering, and no
		-- tracking in the commit lead, so a late sidestep makes the swing whiff.
		local omni = e.Omni
		local dt = math.clamp(simTime - omni.LastFace, TICK, 0.25)
		omni.LastFace = simTime
		local startup = if f.Move then f.Move.Timing.StartupSeconds else 0
		local step = Strike.turnStep(f.State, simTime - f.StateStart, startup, dt)
		local yaw = Strike.turn(yawOf(e.Root.CFrame), Strike.yaw(direction.X, direction.Z) :: number, step)
		e.Root.CFrame = CFrame.new(origin) * CFrame.Angles(0, yaw, 0)
	end
end

function Service.Teleport(id: number, cframe: CFrame)
	local e = entities[id]
	if e and alive(e) then
		e.Placement = nil
		e.Model:PivotTo(cframe)
		e.Root.AssemblyLinearVelocity = Vector3.zero
		e.LastMoveTo = Vector3.new(math.huge, 0, 0)
		Lag.clear(e.History)
	end
end

function Service.SetRespawnPoint(id: number, cframe: CFrame)
	local e = entities[id]
	if e then
		e.Shrine = cframe
	end
end

function Service.ApplyStats(id: number, stats: Combat.Stats, refill: boolean?)
	local e = entities[id]
	if e then
		Combat.applyStats(e.Fighter, stats, refill)
		mirrorHealth(e)
	end
end

function Service.ForceWeapon(id: number, weapon: WeaponType)
	local e = entities[id]
	if e then
		Combat.forceWeapon(e.Fighter, weapon)
		attachWeapon(e)
		e.Style = weapon
	end
end

-- Keep rewound hurtboxes aligned with large boss bodies. `shape` (BossBodies) replaces the upright
-- humanoid capsules for creatures, so the hurtbox follows the body players actually see.
function Service.ScaleEnemy(id: number, scale: number, shape: any?)
	local e = entities[id]
	if not e or e.Kind ~= "Enemy" then return end
	if scale ~= 1 then e.Model:ScaleTo(scale) end
	local base = Lag.HumanoidProfile
	if shape then
		local list: { Lag.Capsule } = {}
		for _, c in shape.Capsules do
			table.insert(list, { Region = c.Region, A = Vector3.new(c.A[1], c.A[2], c.A[3]), B = Vector3.new(c.B[1], c.B[2], c.B[3]), Radius = c.Radius })
		end
		local box = shape.Box
		base = { Capsules = list, BoxOffset = CFrame.new(0, box[1], 0), BoxHalfSize = Vector3.new(box[2], box[3], box[4]), Reach = shape.Reach }
	end
	local capsules: { Lag.Capsule } = {}
	for _, capsule in base.Capsules do
		table.insert(capsules, { Region = capsule.Region, A = capsule.A * scale, B = capsule.B * scale, Radius = capsule.Radius * scale })
	end
	e.History.Profile = { Capsules = capsules, BoxOffset = CFrame.new(base.BoxOffset.Position * scale), BoxHalfSize = base.BoxHalfSize * scale, Reach = base.Reach * scale }
	Lag.clear(e.History)
end

function Service.Tint(id: number, rgb: { number })
	local e = entities[id]
	if e and alive(e) then
		tint(e.Model, rgb)
	end
end

-- Full restore outside the shrine flow (leash reset, encounter reset).
function Service.RestoreFighter(id: number)
	local e = entities[id]
	if not e or e.Fighter.State == "KO" then
		return
	end
	Combat.restore(e.Fighter, simTime, true)
	e.Fighter.State = "Idle"
	e.Fighter.StateStart = simTime
	e.Fighter.StateEnd = math.huge
	InputBuffer.clear(e.Buffer)
end

function Service.Rest(id: number): (boolean, string)
	local e = entities[id]
	if not e or not alive(e) then
		return false, "Unavailable"
	end
	return Combat.tryRest(e.Fighter, simTime, true, frameEvents)
end

function Service.TryHeal(id: number, fraction: number?): (boolean, string)
	local e = entities[id]
	if not e or not alive(e) then
		return false, "Unavailable"
	end
	return Combat.tryHeal(e.Fighter, simTime, fraction)
end

function Service.Cinematic(id: number, duration: number)
	local e = entities[id]
	if e then
		Combat.cinematic(e.Fighter, simTime, duration)
		InputBuffer.clear(e.Buffer)
		if e.Kind == "Enemy" and alive(e) then
			e.Humanoid:MoveTo(e.Root.Position)
		end
	end
end

-- Chain and launch attacks resolve defense before applying displacement.
function Service.ResolveWeaponHit(sourceId: number, targetId: number): string
 local source,target=entities[sourceId],entities[targetId]
 if not source or not target or not hostile(source,target) then return "Ignored" end
 local move=source.Fighter.Move
 if not move or (source.Root.Position-target.Root.Position).Magnitude&gt;move.Reach+source.Fighter.ReachBonus then return "Whiff" end
 local before=#frameEvents
 local result=Combat.resolveHit(source.Fighter,target.Fighter,simTime,{Facing=facingDot(target,source)&gt;=FACING_DOT,Region="Torso"},frameEvents)
 for index=before+1,#frameEvents do eventPoints[frameEvents[index]]=target.Root.Position end
 return result
end

function Service.ApplyArea(sourceId: number, targetId: number, damage: number, posture: number, unblockable: boolean): string
	local source, target = entities[sourceId], entities[targetId]
	if not source or not target or not alive(target) or not hostile(source, target) then
		return "Ignored"
	end
	local before = #frameEvents
	local outcome = Combat.applyArea(source.Fighter, target.Fighter, simTime, damage, posture, unblockable, facingDot(target, source) &gt;= FACING_DOT, frameEvents)
	for index = before + 1, #frameEvents do
		eventPoints[frameEvents[index]] = target.Root.Position
	end
	return outcome
end

-- Geometry is evaluated by the boss scheduler; combat remains authoritative here.
function Service.ApplyBossAttack(sourceId: number, targetId: number, damage: number, posture: number, kind: string): string
	local source, target = entities[sourceId], entities[targetId]
	if not source or not target or not alive(target) or not hostile(source, target) then return "Ignored" end
	local velocity = target.Root.AssemblyLinearVelocity
	if kind == "PerilousGrab" and Vector3.new(velocity.X, 0, velocity.Z).Magnitude &gt;= 24 then return "Whiff" end
	local before = #frameEvents
	local result = Combat.applyBossAttack(source.Fighter, target.Fighter, simTime, damage, posture, kind,
		facingDot(target, source) &gt;= FACING_DOT, frameEvents)
	for index = before + 1, #frameEvents do eventPoints[frameEvents[index]] = target.Root.Position end
	if kind == "PerilousGrab" and result == "Hit" then
		target.Root.AssemblyLinearVelocity = Vector3.new(0, 24, 0)
		InputBuffer.clear(target.Buffer)
		Service.Cue("BossGrab", sourceId, { target = targetId, duration = 1.2 })
	end
	return result
end

-- Broadcast a presentation cue (telegraph, boss phase, fog gate) on the shared event stream.
function Service.Cue(kind: string, sourceId: number, payload: { [string]: any })
	eventRemote:FireAllClients({ v = PROTOCOL_TAG, t = simTime, cue = kind, s = sourceId, d = payload })
end

function Service.SpawnEnemy(spec: EnemySpec): number?
	assert(Weapons.Weapons[spec.Weapon] ~= nil, "Unknown enemy weapon")
	return spawnEnemy(spec, nil)
end

function Service.DespawnEnemy(id: number)
	local e = entities[id]
	if e and e.Kind == "Enemy" then
		removeEntity(id, true)
	end
end

function Service.EquipWeapon(id: number, weapon: WeaponType): (boolean, string)
	local e = entities[id]
	if not e then
		return false, "Entity not found"
	end
	local ok, reason = Combat.tryEquip(e.Fighter, weapon, simTime)
	if ok then
		attachWeapon(e)
	end
	return ok, reason
end

function Service.GetFighter(id: number): Fighter?
	local e = entities[id]
	return if e then e.Fighter else nil
end

function Service.GetActor(id: number): any
	return entities[id]
end

function Service.GetEntityByModel(model: Model): number?
	local e = byModel[model]
	return if e then e.Id else nil
end

-------------------------------------------------------------------------------------------------
-- Account, progression and match API used by Bootstrap and Matchmaking
-------------------------------------------------------------------------------------------------

function Service.RefreshRoster()
	for id, e in entities do
		local player = e.Player
		if e.Kind == "Player" and player and not profileReady(player) then
			removeEntity(id, false)
			if player.Character then
				player.Character:Destroy()
			end
		end
	end
	for _, player in Players:GetPlayers() do
		if profileReady(player) then
			ensurePlayer(player)
		end
	end
end

function Service.RefreshProgression(id: number)
	local e = entities[id]
	if not e or not Persistence then
		return
	end
	loadProfile(e)
	e.Model:SetAttribute("AsuraStyle", e.Style)
	local statsHook = hooks.Stats
	if statsHook and e.Kind == "Player" then
		local ok, stats = pcall(statsHook, id)
		if ok and stats then
			Combat.applyStats(e.Fighter, stats, false)
		end
	end
end

function Service.UpdateCosmetics(userId: number, trunks: string?, gloves: string?, cosmetics: any?)
	local e = entities[userId]
	if not e then
		return
	end
	if cosmetics then
		e.Cosmetics = cosmetics
	end
	if trunks then
		e.Model:SetAttribute("Trunks", trunks)
	end
	if gloves then
		e.Model:SetAttribute("Gloves", gloves)
	end
end

function Service.CanSetStyle(id: number): boolean
	local e = entities[id]
	return e == nil or (e.Duel == nil and (e.Fighter.State == "Idle" or e.Fighter.State == "RestingAtShrine"))
end

-- Profile style is kept as an identity tag; combat moves come from the equipped weapon.
function Service.SetPlayerStyle(userId: number, styleName: string): (boolean, string?)
	local e = entities[userId]
	if not e then
		return false, "Player entity not found"
	end
	local profile = if Persistence then Persistence.Get(userId) else nil
	if Persistence and (not profile or not profile.styles or not profile.styles[styleName] or not profile.styles[styleName].unlocked) then
		return false, "Style is locked"
	end
	e.Style = styleName
	e.Model:SetAttribute("AsuraStyle", styleName)
	return true, nil
end

function Service.GetPerformance()
	local times = table.clone(stepTimes)
	table.sort(times)
	local count = 0
	for _ in entities do
		count += 1
	end
	return {
		samples = #times,
		p95StepMs = times[math.max(1, math.ceil(#times * 0.95))] or 0,
		maxStepMs = times[#times] or 0,
		droppedSteps = droppedSteps,
		entities = count,
	}
end

function Service.GetMatchXp(id: string?): { [number]: number }
	local active = if id then duels[id] else nil
	return if active then table.clone(active.Xp) else {}
end

function Service.GetRound(): number
	return 1
end

-- Seals two players into a duel. `spawns` places them (slot 1, slot 2); duels run concurrently.
function Service.StartAllocatedMatch(id: string, p1: number, p2: number, mode: string, complete: any, spawns: { CFrame }?): boolean
	if duels[id] or p1 == p2 then
		return false
	end
	local a, b = entities[p1], entities[p2]
	if not a or not b or a.Kind ~= "Player" or b.Kind ~= "Player" or a.Duel ~= nil or b.Duel ~= nil then
		return false
	end
	if not alive(a) or not alive(b) or a.Respawning or b.Respawning then
		return false
	end
	if Persistence and (not Persistence.Get(p1) or not Persistence.Get(p2)) then
		return false
	end
	duels[id] = { Id = id, Mode = mode, A = p1, B = p2, Complete = complete, Finished = false, Spawns = spawns, Xp = {} }
	for _, e in { a, b } do
		e.Duel = id
		e.SpawnOverride = nil
		Combat.restore(e.Fighter, simTime, true)
		e.Fighter.State = "Idle"
		e.Fighter.StateStart = simTime
		e.Fighter.StateEnd = math.huge
		InputBuffer.clear(e.Buffer)
		Lag.clear(e.History)
		e.RespawnAt = math.huge
		e.Model:SetAttribute("AsuraDuel", id)
		e.Placement = nil
		e.Model:PivotTo(spawnCFrameFor(e))
		e.Root.AssemblyLinearVelocity = Vector3.zero
	end
	return true
end

-- Releases a duel. Standing fighters are restored and moved to `returns[userId]`; fallen ones
-- respawn there (or at their respawn point when no destination is given).
function Service.EndAllocatedMatch(id: string, returns: { [number]: CFrame }?)
	local active = duels[id]
	if not active then
		return
	end
	duels[id] = nil
	for _, userId in { active.A, active.B } do
		local e = entities[userId]
		if e and e.Duel == id then
			e.Duel = nil
			e.Model:SetAttribute("AsuraDuel", nil)
			local destination = if returns then returns[userId] else nil
			local player = e.Player
			if destination and alive(e) and e.Fighter.State ~= "KO" then
				Combat.restore(e.Fighter, simTime, true)
				e.Fighter.State = "Idle"
				e.Fighter.StateStart = simTime
				e.Fighter.StateEnd = math.huge
				InputBuffer.clear(e.Buffer)
				e.RespawnAt = math.huge
				e.Placement = nil
				e.Model:PivotTo(destination)
				e.Root.AssemblyLinearVelocity = Vector3.zero
				e.LastMoveTo = Vector3.new(math.huge, 0, 0)
				Lag.clear(e.History)
			elseif player and player.Parent then
				e.SpawnOverride = destination
				e.Respawning = true
				requestCharacter(player)
			end
		end
	end
end

return Service
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">CitadelDressing</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CitadelDressing
-- Sky Citadel skyline, weather and storytelling (batch 21). All decor and none of it over the
-- summit: a sea of cloud far below the bridge, ruined citadel towers ringing the chasm and the
-- bastion (outside the veil), torn azure banners on the battlements, chain posts that mark the
-- saddle stair's edges, the dragon's perch with gouged rock and broken chains, and wind-driven
-- sleet. The summit plateau keeps open air for the Wyrm's flight and landings. Collision lives in
-- SkyCitadelLayout.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Decor = require(script.Parent:WaitForChild("RegionDecor") :: ModuleScript)

local Dressing = {}
local P = Kit.Palette
local M = Enum.Material
local rgb = Color3.fromRGB
local AZURE = rgb(64, 96, 150)
local CLOUD = rgb(214, 220, 236)

local function ruinTower(parent: Instance, x: number, z: number, height: number, rng: Random)
	local base = CFrame.new(x, -60, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
	Kit.part(parent, "CitadelTower", Vector3.new(16, height, 16), base * CFrame.new(0, height / 2, 0), rgb(122, 126, 138), M.Slate, Kit.decor())
	Kit.part(parent, "TowerBreak", Vector3.new(12, 6, 9), base * CFrame.new(-2, height + 1, 1) * CFrame.Angles(0, 0, math.rad(14)), rgb(108, 112, 124), M.Slate, Kit.decor())
	if rng:NextNumber() &lt; 0.6 then
		Decor.roof(parent, base * CFrame.new(0, height - 6, 0), 22, 22, 5, rgb(52, 60, 80))
	end
end

function Dressing.Build(map: Instance, _layout: any, rng: Random)
	local set = Kit.folder("CitadelDressing", map)
	-- The cloud sea far below, and banks drifting through the chasm.
	for _, c in { { 0, -2600, 360, 200 }, { -170, -2820, 160, 360 }, { 170, -2820, 160, 360 }, { 0, -2960, 360, 80 } } do
		Kit.part(set, "CloudSea", Vector3.new(c[3], 2, c[4]), CFrame.new(c[1], -96, c[2]), CLOUD, M.Glass, { Collide = false, Query = false, Shadow = false, Transparency = 0.35 })
	end
	Fx.mist(set, CFrame.new(0, -48, -2600), Vector3.new(200, 30, 120), 4, 40, CLOUD)
	Fx.mist(set, CFrame.new(0, -40, -2830), Vector3.new(260, 20, 220), 3, 46, CLOUD)
	-- Ruined towers around the chasm and the summit (outside the veil): the skyline from the bridge.
	for _, t in { { -70, -2580, 120 }, { 70, -2600, 140 }, { -120, -2690, 150 }, { 120, -2700, 130 }, { -150, -2860, 170 }, { 150, -2900, 160 } } do
		ruinTower(set, t[1], t[2], t[3], rng)
	end
	-- Banners on the battlements and the gate towers.
	for _, spot in { { -71.5, -2690 }, { -71.5, -2722 }, { 71.5, -2690 }, { 71.5, -2722 } } do
		Decor.banner(set, CFrame.new(spot[1], 6.6, spot[2]) * CFrame.Angles(0, math.rad(90), 0), 8, AZURE)
	end
	for _, side in { -1, 1 } do
		Decor.banner(set, CFrame.new(side * 22, 26, -2719.8), 14, AZURE)
		-- Chain posts marking the saddle stair's edges (the veil stands just outside them).
		for z = -2552, -2584, -8 do
			local y = -(z + 2548) / 2
			Kit.part(set, "ChainPost", Vector3.new(0.8, 3, 0.8), CFrame.new(side * 5.6, y + 1.5, z), P.StoneDark, M.Slate, Kit.decor())
			Kit.beam(set, "Chain", Vector3.new(side * 5.6, y + 2.6, z), Vector3.new(side * 5.6, y - 1.4, z - 8), 0.2, P.Iron, M.Metal)
		end
	end
	-- The dragon's perch: gouges, broken chains, scattered scales.
	for k = 1, 4 do
		Kit.part(set, "ClawGouge", Vector3.new(1, 16, 0.6), CFrame.new(-4 + k * 2, 60 + k * 3, -2944.8) * CFrame.Angles(0, 0, math.rad(12)), rgb(40, 42, 50), M.Slate, Kit.decor())
	end
	for k = 1, 8 do
		Kit.beam(set, "PerchChain", Vector3.new(0, 70, -2952), Vector3.new(math.cos(k) * 30, 10 + k * 3, -2952 + math.sin(k) * 20), 0.5, P.Iron, M.Metal)
	end
	for _ = 1, 12 do
		Kit.part(set, "ShedScale", Vector3.new(1.6, 0.2, 2.2), CFrame.new(rng:NextNumber(-60, 60), 0.12, rng:NextNumber(-2900, -2930))
			* CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), rgb(90, 140, 190), M.Glass, Kit.decor())
	end
	-- Wind-driven sleet over the whole approach (thin; effects never compete with telegraphs).
	local sky = Kit.hidden(set, "SleetSky", Vector3.new(300, 1, 460), CFrame.new(0, 90, -2760))
	local sleet = Instance.new("ParticleEmitter")
	sleet.Name, sleet.Texture, sleet.Rate = "Sleet", Kit.Texture.Mote, 18
	sleet.Lifetime, sleet.Speed = NumberRange.new(5, 7), NumberRange.new(18, 26)
	sleet.Acceleration, sleet.EmissionDirection = Vector3.new(14, -8, 4), Enum.NormalId.Bottom
	sleet.Size, sleet.Color = NumberSequence.new(0.18), ColorSequence.new(CLOUD)
	sleet.Transparency, sleet.LightInfluence = NumberSequence.new(0.4), 1
	sleet.Enabled = sleet.Texture ~= ""
	sleet.Parent = sky
end

return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">ColosseumDressing</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/ColosseumDressing
-- Ash Colosseum silhouettes and storytelling (batch 18). All decor: champion statues on the road's
-- plinths (the uploaded AsuraColossusStatue where present, a carved stand-in otherwise), broken
-- arcade arches along the cavea's crown (AsuraRuinArch), torn order banners on the facade, braziers
-- in the hall and on the tiers, the antechamber's fallen roof beams, spears and shields of the
-- order's last disciples in the ash, and Victor's gate lintel. Collision lives in AshColosseumLayout.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Decor = require(script.Parent:WaitForChild("RegionDecor") :: ModuleScript)
local Pbr = require(script.Parent:WaitForChild("PbrAssets") :: ModuleScript)

local Dressing = {}
local P = Kit.Palette
local M = Enum.Material
local rgb = Color3.fromRGB
local ASH = rgb(92, 88, 86)

local function statue(parent: Instance, base: CFrame)
	if Pbr.place(parent, "AsuraColossusStatue", base, 11, "Y") then
		return
	end
	Kit.part(parent, "ChampionRobe", Vector3.new(3.4, 7, 2.6), base * CFrame.new(0, 3.5, 0), P.Stone, M.Slate, Kit.decor())
	Kit.part(parent, "ChampionShoulders", Vector3.new(4.6, 1.4, 2.4), base * CFrame.new(0, 7.4, 0), P.Stone, M.Slate, Kit.decor())
	Kit.part(parent, "ChampionHead", Vector3.new(1.6, 1.8, 1.6), base * CFrame.new(0, 9, 0), P.StoneDark, M.Slate, Kit.decor())
	Kit.beam(parent, "ChampionJian", (base * CFrame.new(0.6, 1, -1.4)).Position, (base * CFrame.new(0.6, 8, -1.4)).Position, 0.3, P.StoneDark, M.Slate)
end

function Dressing.Build(map: Instance, _layout: any, rng: Random)
	local set = Kit.folder("ColosseumDressing", map)
	-- Champions on the ash road plinths (x +/-20, z -1694, plinth top 4); one has fallen.
	statue(set, CFrame.new(-20, 4, -1694) * CFrame.Angles(0, math.rad(200), 0))
	Kit.part(set, "FallenChampion", Vector3.new(8, 3, 3), CFrame.new(24, 1.4, -1702) * CFrame.Angles(0, math.rad(30), math.rad(8)), P.Stone, M.Slate, Kit.decor())
	-- Arcade arches along the cavea's crown (tier 5 top 20) and across the facade.
	for _, spot in { { -108, -1930 }, { -108, -2010 }, { 108, -1950 }, { 108, -2030 }, { -60, -2073 }, { 60, -2073 } } do
		if not Pbr.place(set, "AsuraRuinArch", CFrame.new(spot[1], 20, spot[2]) * CFrame.Angles(0, if math.abs(spot[1]) &gt; 100 then math.rad(90) else 0, 0), 16, "Y") then
			for _, side in { -1, 1 } do
				Kit.part(set, "ArcadePier", Vector3.new(2.4, 14, 2.4), CFrame.new(spot[1], 27, spot[2]) * CFrame.Angles(0, if math.abs(spot[1]) &gt; 100 then math.rad(90) else 0, 0)
					* CFrame.new(side * 5, 0, 0), P.Stone, M.Slate, Kit.decor())
			end
		end
	end
	for _, x in { -60, -36, 36, 60, 88 } do
		Decor.banner(set, CFrame.new(x, 20.5, -1887.2), rng:NextNumber(9, 14), if x == 88 then rgb(60, 22, 22) else P.Lacquer)
	end
	-- Braziers: hall colonnade gaps and the tier crowns either side of the arena.
	for _, spot in { { -22, 0, -1828 }, { 22, 0, -1806 }, { -100, 16, -1920 }, { 100, 16, -1920 }, { -100, 16, -2000 }, { 100, 16, -2000 } } do
		Decor.brazier(set, CFrame.new(spot[1], spot[2], spot[3]))
	end
	-- Antechamber: fallen roof beams high over the hall (open to the ash sky), soot on the walls.
	for k = 0, 3 do
		Kit.beam(set, "FallenRafter", Vector3.new(-34, 12 + k * 0.6, -1716 - k * 13), Vector3.new(30 - k * 6, 10.5 - k, -1722 - k * 12), 1.2, P.WoodDark, M.Wood)
	end
	-- The order's last stand: spears and shields in the ash of the hall and the arena margins.
	for _ = 1, 18 do
		local x, z = rng:NextNumber(-48, 48), rng:NextNumber(-1782, -1878)
		if math.abs(x) &gt; 10 then
			local tip = Vector3.new(x + rng:NextNumber(-1, 1), rng:NextNumber(4, 6), z + rng:NextNumber(-1, 1))
			Kit.beam(set, "FallenSpear", Vector3.new(x, -0.4, z), tip, 0.2, P.WoodDark, M.Wood)
		end
	end
	for _ = 1, 8 do
		Kit.part(set, "DiscardedShield", Vector3.new(0.4, 3, 3), CFrame.new(rng:NextNumber(-46, 46), 0.1, rng:NextNumber(-1782, -1878))
			* CFrame.Angles(math.rad(rng:NextNumber(-10, 10)), rng:NextNumber(0, math.pi), math.rad(90)), rgb(70, 52, 40), M.Metal,
			{ Collide = false, Query = false, Shadow = true, Shape = Enum.PartType.Cylinder })
	end
	for _ = 1, 16 do
		Kit.part(set, "AshDrift", Vector3.new(rng:NextNumber(8, 20), 0.3, rng:NextNumber(6, 14)), CFrame.new(rng:NextNumber(-110, 110), 0.05, rng:NextNumber(-1700, -2110))
			* CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), ASH, M.Sand, Kit.decor())
	end
	-- Victor's gate: a lintel and a name board over the south passage.
	Kit.part(set, "VictorLintel", Vector3.new(38, 2.4, 4), CFrame.new(0, 21, -2035), P.StoneDark, M.Slate, Kit.decor())
	Kit.part(set, "VictorBoard", Vector3.new(10, 3, 0.4), CFrame.new(0, 17.5, -2032.8), P.WoodDark, M.Wood, Kit.decor())
end

return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">ColosseumService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/ColosseumService
-- Overworld PvP Colosseums. Each ring is an octagon sealed by an invisible barrier and bordered by
-- an ember threshold; standing on that threshold opens matchmaking for the player:
--   * Ranked 1v1 duels: ELO-bracketed queue, gated on round-trip latency so every hit stays inside
--     the LagCompensation rewind budget, journaled before start and settled through the durable
--     match inbox (exactly-once ELO, recoverable after a crash or disconnect).
--   * Casual spars: an instant challenge to any player on the server, sealed on acceptance.
-- Ranked fighters are normalised to a fixed competitive attribute budget that preserves their
-- build's proportions, so story-mode grinding never decides a ranked duel.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local Settings = require(Shared.Shared.CombatSettings) :: any
local World = require(Shared.Shared.WorldDefinitions)
local Protocol = require(Shared.Shared.IntentProtocol)
local Rules = require(Shared.Simulation.MatchmakingRules) :: any
local ArenaRules = require(Shared.Shared.ArenaRules)
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local Lag = require(script.Parent:WaitForChild("LagCompensation") :: ModuleScript)
local AI = require(script.Parent:WaitForChild("AIService") :: ModuleScript)
local WorldService = require(script.Parent:WaitForChild("WorldService") :: ModuleScript)
local Persistence = require(script.Parent:WaitForChild("PersistenceService") :: ModuleScript) :: any
local ProfileStore = require(script.Parent:WaitForChild("ProfileStore") :: ModuleScript)
local Journal = require(script.Parent:WaitForChild("MatchJournal") :: ModuleScript) :: any

type Bucket = Protocol.Bucket
type Souls = ProfileStore.Souls
type Attributes = ProfileStore.Attributes
type AttributeName = ProfileStore.AttributeName

export type Mode = "Ranked1v1" | "Casual1v1"
export type Phase = "Countdown" | "Fighting" | "Resolving"

export type RingDefinition = {
	Id: string,
	Name: string,
	Glyph: string,
	Region: string,
	Center: Vector3,
	Apothem: number,
	Band: number,
	Yaw: number,
}

type Ring = {
	Definition: RingDefinition,
	Model: Model?,
	Owned: boolean,
	Match: Match?,
	CooldownUntil: number,
	Directions: { Vector3 },
}

type Match = {
	Id: string,
	Ring: Ring,
	Mode: Mode,
	A: number,
	B: number,
	Names: { [number]: string },
	Profiles: { [number]: any },
	Phase: Phase,
	PhaseEnds: number,
	Winner: number?,
	Draw: boolean,
	Reason: string,
	Results: { [string]: any }?,
	Journaled: boolean,
	Busy: boolean,
	ReleaseAt: number,
	Abandoned: boolean?, -- a fighter left while the match was still being set up (batch 24)
}

type QueueEntry = {
	userId: number,
	mode: Mode,
	elo: number,
	enteredAt: number,
	ring: string,
}

type Challenge = {
	Id: string,
	From: number,
	To: number,
	Ring: string,
	Expires: number,
}

type Remainder = { Name: AttributeName, Fraction: number }

type Presence = {
	Ring: string?,
	Dismissed: string?,
	Ping: number,
	LastRoster: number,
}

local ColosseumService = {}

-------------------------------------------------------------------------------------------------
-- Tuning
-------------------------------------------------------------------------------------------------

local POLL_INTERVAL = 0.25
local ROSTER_INTERVAL = 2
local COUNTDOWN_SECONDS: number = math.max(12,Config.Match.CountdownSeconds)
local FIGHT_SECONDS: number = Config.Match.RoundSeconds
local RESULT_HOLD = 3
local RING_COOLDOWN = 2
local CHALLENGE_SECONDS = 15
local DRAW_EPSILON = 0.01
local ESCAPE_MARGIN = 1.5
local FLOOR_TOP = 0.4
local ROOT_OFFSET = 3
local WALL_HEIGHT = 3.2
local BARRIER_HEIGHT = 34
local PILLAR_HEIGHT = 9
-- Ranked hit validation rewinds at most Lag.MAX_REWIND; a round trip beyond it would leave the
-- slower duelist's strikes judged against positions the server can no longer reconstruct.
local RANKED_ENTRY_PING: number = Lag.MAX_REWIND
local RANKED_DROP_PING: number = Lag.MAX_REWIND * 1.6
local PING_SMOOTHING = 0.2
-- Competitive baseline: every ranked fighter carries exactly this many points above base,
-- distributed in the proportions of their own build and clamped per attribute.
local RANKED_POINT_BUDGET = 60
local RANKED_ATTRIBUTE_CAP = 40
local ATTRIBUTE_BASE = 10
local ATTRIBUTE_ORDER: { AttributeName } = { "Vigor", "Endurance", "Strength", "Dexterity", "ArcaneQi" }

local INTENT_RATE = 3
local INTENT_BURST = 6
local INTENT_SHAPES: { [string]: { [string]: string } } = {
	Enqueue = { action = "string" },
	Dequeue = { action = "string" },
	Refresh = { action = "string" },
	Dismiss = { action = "string" },
	Challenge = { action = "string", target = "number" },
	Respond = { action = "string", challenge = "string", accept = "boolean" },
}
local LOCKED_HOOKS = { "Heal", "Rest", "Travel", "LevelUp", "Interact" }

local ASH = Color3.fromRGB(46, 40, 38)
local STONE = Color3.fromRGB(74, 68, 64)
local EMBER = Color3.fromRGB(232, 118, 46)
local CHAR = Color3.fromRGB(28, 22, 20)

local PROMENADE = World.Sanctuary.Promenade

local RING_DEFINITIONS: { RingDefinition } = {
	{
		Id = "Ring_SanctuaryPromenade",
		Name = "The Colosseum Promenade",
		Glyph = "",
		Region = "Sanctuary",
		Center = Vector3.new(PROMENADE.X, PROMENADE.Y, PROMENADE.Z),
		Apothem = 16,
		Band = 6,
		Yaw = 0,
	},
	{
		Id = "Ring_OctagonOfAsh",
		Name = "The Octagonal Ring of Ash",
		Glyph = "",
		Region = "AshColosseum",
		Center = Vector3.new(118, 0, -1770),
		Apothem = 20,
		Band = 7,
		Yaw = 0,
	},
	{
		Id = "Ring_GatehouseCircle",
		Name = "The Gatehouse Sparring Ring",
		Glyph = "",
		Region = "DesecratedMonastery",
		Center = Vector3.new(-130, 0, -745),
		Apothem = 16,
		Band = 6,
		Yaw = 0,
	},
}

-------------------------------------------------------------------------------------------------
-- State
-------------------------------------------------------------------------------------------------

local rings: { [string]: Ring } = {}
local ringOrder: { Ring } = {}
local matches: { [string]: Match } = {}
local matchOf: { [number]: Match } = {}
local normalized: { [number]: boolean } = {}
local queue: { QueueEntry } = {}
local challenges: { [string]: Challenge } = {}
local outgoing: { [number]: string } = {}
local presence: { [number]: Presence } = {}
local budgets: { [number]: Bucket } = {}
local connections: { RBXScriptConnection } = {}
local baseHooks: Characters.Hooks? = nil
local colosseumFolder: Folder? = nil
local running = false
local closing = false
local pairing = false
local accumulator = 0

local net = Shared:WaitForChild("Net")
local remote = net:WaitForChild("ColosseumIntent") :: RemoteEvent

local journalBacking: { [string]: any } = {}
local journalStore: any = if Persistence.IsMock
	then {
		UpdateAsync = function(_self: any, key: string, transform: (any) -&gt; any): any
			local value = transform(ProfileStore.Copy(journalBacking[key]))
			if value ~= nil then
				journalBacking[key] = ProfileStore.Copy(value)
			end
			return ProfileStore.Copy(value)
		end,
	}
	else game:GetService("DataStoreService"):GetDataStore("AsuraMatches_v1")
local journal: any = Journal.new(journalStore, function(fn: () -&gt; any): (boolean, any)
	return Persistence.Engine:Retry(fn)
end, os.time)

-------------------------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------------------------

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function trace(problem: any): string
	return debug.traceback(tostring(problem), 2)
end

local function notify(userId: number, payload: { [string]: any })
	local player = Players:GetPlayerByUserId(userId)
	if player then
		remote:FireClient(player, payload)
	end
end

local function displayName(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	return if player then player.DisplayName else "Unknown"
end

local function presenceOf(userId: number): Presence
	local existing = presence[userId]
	if existing then
		return existing
	end
	local created: Presence = { Ring = nil, Dismissed = nil, Ping = 0, LastRoster = 0 }
	presence[userId] = created
	return created
end

local function soulsOf(userId: number): Souls?
	local profile = Persistence.Get(userId)
	return if profile then profile.souls else nil
end

-- Development (Studio) opens ranked by default; the Workspace attribute AsuraColosseumQA
-- overrides either way. Live servers stay behind the release gate.
local function developmentRanked(): boolean
	if not RunService:IsStudio() then
		return false
	end
	local override = Workspace:GetAttribute("AsuraColosseumQA")
	if type(override) == "boolean" then
		return override
	end
	return Settings.Colosseum.RankedInDevelopment == true
end

local function rankedOpen(): boolean
	return Protocol.QueueEnabled("Ranked1v1", Config.Features.Matchmaking == true, Config.Release.RankedIntegrationPassed == true, developmentRanked())
end

local function inQueue(userId: number): boolean
	for _, entry in queue do
		if entry.userId == userId then
			return true
		end
	end
	return false
end

local function dequeue(userId: number): boolean
	for index, entry in queue do
		if entry.userId == userId then
			table.remove(queue, index)
			return true
		end
	end
	return false
end

-- Octagonal distance: the largest projection onto the eight edge normals (equals the apothem
-- exactly on an edge), so the ring, its threshold and its interior share one metric.
local function octagonDistance(ring: Ring, position: Vector3): number
	local offset = position - ring.Definition.Center
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local best = 0
	for _, direction in ring.Directions do
		best = math.max(best, flat:Dot(direction))
	end
	return best
end

local function verticalOk(ring: Ring, position: Vector3): boolean
	return math.abs(position.Y - ring.Definition.Center.Y) &lt;= 14
end

local function onThreshold(ring: Ring, position: Vector3): boolean
	local d = octagonDistance(ring, position)
	local definition = ring.Definition
	return verticalOk(ring, position) and d &gt;= definition.Apothem + 0.5 and d &lt;= definition.Apothem + 1.5 + definition.Band
end

local function insideRing(ring: Ring, position: Vector3): boolean
	return verticalOk(ring, position) and octagonDistance(ring, position) &lt; ring.Definition.Apothem
end

local function ringFrame(ring: Ring): CFrame
	local definition = ring.Definition
	return CFrame.new(definition.Center) * CFrame.Angles(0, math.rad(definition.Yaw), 0)
end

-- Slot 1 stands on the ring's local +Z side, slot 2 on -Z; both face the centre.
local function duelSpawn(ring: Ring, slot: number): CFrame
	local frame = ringFrame(ring)
	local distance = ring.Definition.Apothem * 0.55
	local position = (frame * CFrame.new(0, FLOOR_TOP + ROOT_OFFSET, if slot == 1 then distance else -distance)).Position
	local centre = Vector3.new(frame.Position.X, position.Y, frame.Position.Z)
	return CFrame.lookAt(position, centre)
end

local function thresholdPoint(ring: Ring, slot: number): CFrame
	local frame = ringFrame(ring)
	local definition = ring.Definition
	local distance = definition.Apothem + 1 + definition.Band * 0.5
	local position = (frame * CFrame.new(if slot == 1 then 3 else -3, ROOT_OFFSET + 0.2, if slot == 1 then distance else -distance)).Position
	local centre = Vector3.new(frame.Position.X, position.Y, frame.Position.Z)
	return CFrame.lookAt(position, centre)
end

local function ringOfPlayer(userId: number): Ring?
	local e = Characters.GetEntity(userId)
	if not e then
		return nil
	end
	local position = e.Root.Position
	for _, ring in ringOrder do
		if onThreshold(ring, position) then
			return ring
		end
	end
	return nil
end

local function freeRing(preferred: string?): Ring?
	local clock = now()
	local first = if preferred then rings[preferred] else nil
	if first and first.Match == nil and clock &gt;= first.CooldownUntil then
		return first
	end
	for _, ring in ringOrder do
		if ring.Match == nil and clock &gt;= ring.CooldownUntil then
			return ring
		end
	end
	return nil
end

-- Whether a player may be pulled into a duel right now.
local function available(userId: number): (boolean, string?)
	if closing then
		return false, "ColosseumClosed"
	end
	local player = Players:GetPlayerByUserId(userId)
	if not player or not Persistence.Get(userId) or Persistence.Engine.busy[userId] then
		return false, "Unavailable"
	end
	if matchOf[userId] or Characters.IsInDuel(userId) then
		return false, "InDuel"
	end
	local e = Characters.GetEntity(userId)
	if not e or e.Respawning or e.Fighter.State == "KO" or e.Fighter.State == "DeathblowVictim" then
		return false, "Fallen"
	end
	if WorldService.IsInBossFight(userId) then
		return false, "InBossFight"
	end
	if AI.IsHunting(userId) then
		return false, "EnemiesNearby"
	end
	return true, nil
end

-------------------------------------------------------------------------------------------------
-- Stat normalisation
-------------------------------------------------------------------------------------------------

-- Redistributes a fixed point budget across the four attributes in the proportions the player
-- invested, clamped per attribute; an uninvested build is spread evenly. Largest-remainder
-- rounding keeps the total exact.
function ColosseumService.NormalizeAttributes(_attributes: Attributes): Attributes
 return ArenaRules.normalized() :: Attributes
end

local function rankedStats(userId: number): any
	local record = soulsOf(userId)
	if not record then
		return nil
	end
	local view = table.clone(record) :: any
	view.attributes = ColosseumService.NormalizeAttributes(record.attributes)
	-- Blacksmith reinforcement is story progression too; ranked fighters carry unforged steel.
	view.inventory = table.clone(record.inventory)
	view.inventory.reinforcement = {}
 view.rpg=nil
	return ProfileStore.DeriveStats(view)
end

local function normalizedLevel(userId: number): number
	local record = soulsOf(userId)
	if not record then
		return 1
	end
	return ProfileStore.SoulLevel(ColosseumService.NormalizeAttributes(record.attributes))
end

-------------------------------------------------------------------------------------------------
-- Ranked durability (match journal + participant inbox)
-------------------------------------------------------------------------------------------------

-- Settles every pending ranked match recorded in the player's inbox. Yields.
function ColosseumService.Recover(userId: number): boolean
	local profile = Persistence.Get(userId)
	if not profile then
		return false
	end
	for matchId in profile.pendingMatches do
		if matches[matchId] then
			continue
		end
		local ok, record = journal:Read(matchId)
		if not ok or not record then
			return false
		end
		if record.state == "Active" then
			return false
		end
		if record.state == "Complete" then
			local result = record.results and record.results[tostring(userId)]
			if not result or not Persistence.ApplyResult(userId, matchId, result) then
				return false
			end
		elseif not Persistence.Transaction(userId, function(p: any)
			p.pendingMatches[matchId] = nil
		end) then
			return false
		end
	end
	return true
end

local function rankedResults(match: Match): { [string]: any }
	local first, second = match.Profiles[match.A], match.Profiles[match.B]
	local score = if match.Draw then 0.5 elseif match.Winner == match.A then 1 else 0
	local newA, newB = Rules.CalculateEloChange(first.elo, second.elo, score)
	local xp = Characters.GetMatchXp(match.Id)
	local results: { [string]: any } = {}
	for index, userId in { match.A, match.B } do
		local profile = if index == 1 then first else second
		local win = match.Winner == userId
		results[tostring(userId)] = {
			userId = userId,
			mode = "Ranked1v1",
			eloDelta = if index == 1 then newA - first.elo else newB - second.elo,
			cash = 135 + (if win then 150 elseif match.Draw then 50 else 0),
			outcome = if match.Draw then "Draw" elseif win then "Win" else "Loss",
			style = profile.activeStyle,
			xp = (if win then 150 elseif match.Draw then 75 else 50) + (xp[userId] or 0),
		}
	end
	return results
end

local function clearInbox(userId: number, matchId: string)
	if Persistence.Get(userId) then
		Persistence.Transaction(userId, function(p: any)
			p.pendingMatches[matchId] = nil
		end)
	end
end

-------------------------------------------------------------------------------------------------
-- Match lifecycle
-------------------------------------------------------------------------------------------------

local function broadcast(kind: string, match: Match, extra: { [string]: any }?)
	local payload: { [string]: any } = {
		ring = match.Ring.Definition.Id,
		name = match.Ring.Definition.Name,
		mode = match.Mode,
		a = match.A,
		b = match.B,
		an = match.Names[match.A],
		bn = match.Names[match.B],
		x = match.Ring.Definition.Center.X,
		z = match.Ring.Definition.Center.Z,
	}
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	Characters.Cue(kind, 0, payload)
end

local function conclude(match: Match, winner: number?, draw: boolean, reason: string)
	if match.Phase == "Resolving" then
		return
	end
	match.Phase = "Resolving"
	match.Winner = winner
	match.Draw = draw
	match.Reason = reason
	match.ReleaseAt = now() + RESULT_HOLD
	match.Results = if match.Mode == "Ranked1v1" and not closing then rankedResults(match) else nil
	if (ColosseumService :: any).SpectatorResult then
  (ColosseumService :: any).SpectatorResult(match.Id,winner,draw or closing or winner==nil)
 end
 broadcast("ColosseumResult", match, {
		winner = winner,
		draw = draw,
		reason = reason,
		wn = if winner then match.Names[winner] else nil,
	})
end

local function onDuelComplete(matchId: string, winner: number?, isDraw: boolean, _rounds: number, _xp: any)
	local match = matches[matchId]
	if match then
		conclude(match, winner, isDraw, "KO")
	end
end

local function decideOnTime(match: Match)
	local fa, fb = Characters.GetFighter(match.A), Characters.GetFighter(match.B)
	local ra = if fa then fa.ActiveHP / math.max(fa.MaxHP, 1) else 0
	local rb = if fb then fb.ActiveHP / math.max(fb.MaxHP, 1) else 0
	if math.abs(ra - rb) &lt; DRAW_EPSILON then
		conclude(match, nil, true, "Time")
	else
		conclude(match, if ra &gt; rb then match.A else match.B, false, "Time")
	end
end

local function cancelBeforeStart(id: string, mode: Mode, a: number, b: number)
	if mode == "Ranked1v1" then
		journal:Finish(id, nil)
		clearInbox(a, id)
		clearInbox(b, id)
	end
end

-- Seals two players into a ring. Yields while the ranked journal is written.
local function begin(ring: Ring, a: number, b: number, mode: Mode): (boolean, string?)
	if ring.Match then
		return false, "RingOccupied"
	end
	local id = HttpService:GenerateGUID(false)
	local match: Match = {
		Id = id,
		Ring = ring,
		Mode = mode,
		A = a,
		B = b,
		Names = { [a] = displayName(a), [b] = displayName(b) },
		Profiles = { [a] = Persistence.Get(a), [b] = Persistence.Get(b) },
		Phase = "Countdown",
		PhaseEnds = math.huge,
		Winner = nil,
		Draw = false,
		Reason = "",
		Results = nil,
		Journaled = false,
		Busy = false,
		ReleaseAt = math.huge,
	}
	-- Reserve the ring and both fighters before yielding so no second pairing can claim them.
	ring.Match = match
	matchOf[a] = match
	matchOf[b] = match
	local function abandon(reason: string): (boolean, string?)
		ring.Match = nil
		matchOf[a] = nil
		matchOf[b] = nil
		normalized[a] = nil
		normalized[b] = nil
		return false, reason
	end
	if not match.Profiles[a] or not match.Profiles[b] then
		return abandon("Unavailable")
	end
	if mode == "Ranked1v1" then
		local saved = journal:Create(id, { a, b }, game.JobId)
		if not saved then
			return abandon("JournalUnavailable")
		end
		for _, userId in { a, b } do
			local registered = Persistence.Transaction(userId, function(p: any)
				p.pendingMatches[id] = true
			end)
			if not registered then
				cancelBeforeStart(id, mode, a, b)
				return abandon("ProfileBusy")
			end
		end
		match.Journaled = true
	end
	-- Persistence yields: either fighter may have left, died or been pulled into a boss fight.
	for _, userId in { a, b } do
		local e = Characters.GetEntity(userId)
		if closing or match.Abandoned or not Players:GetPlayerByUserId(userId) or not e or e.Respawning or e.Fighter.State == "KO"
			or WorldService.IsInBossFight(userId) then
			cancelBeforeStart(id, mode, a, b)
			return abandon("Unavailable")
		end
	end
	if mode == "Ranked1v1" then
		normalized[a] = true
		normalized[b] = true
	end
	matches[id] = match
	local started = Characters.StartAllocatedMatch(id, a, b, mode, onDuelComplete, { duelSpawn(ring, 1), duelSpawn(ring, 2) })
	if not started then
		matches[id] = nil
		cancelBeforeStart(id, mode, a, b)
		return abandon("StartRefused")
	end
	for slot, userId in { a, b } do
		dequeue(userId)
		local pending = outgoing[userId]
		if pending then
			challenges[pending] = nil
			outgoing[userId] = nil
		end
		if mode == "Ranked1v1" then
			local stats = rankedStats(userId)
			if stats then
				Characters.ApplyStats(userId, stats, true)
			end
		end
		Characters.Cinematic(userId, COUNTDOWN_SECONDS)
		local player = Players:GetPlayerByUserId(userId)
		if player then
			player:SetAttribute("AsuraColosseum", ring.Definition.Id)
   player:SetAttribute("AsuraArenaNormalized",mode=="Ranked1v1")
		end
		local opponent = if slot == 1 then b else a
		local profile = match.Profiles[opponent]
		notify(userId, {
			action = "MatchFound",
			matchId = id,
			ring = ring.Definition.Id,
			name = ring.Definition.Name,
			mode = mode,
			opponent = opponent,
			opponentName = match.Names[opponent],
			opponentElo = if mode == "Ranked1v1" and profile then profile.elo else nil,
			level = if mode == "Ranked1v1" then normalizedLevel(userId) else nil,
			starts = now() + COUNTDOWN_SECONDS,
			ends = now() + COUNTDOWN_SECONDS + FIGHT_SECONDS,
		})
	end
	match.PhaseEnds = now() + COUNTDOWN_SECONDS
	broadcast("ColosseumBegin", match, { starts = match.PhaseEnds })
 if (ColosseumService :: any).SpectatorBegin then
  (ColosseumService :: any).SpectatorBegin(id,a,b,match.Names[a],match.Names[b],match.PhaseEnds,ring.Definition.Id)
 end
	return true, nil
end

-- Releases a resolved match: journal, settle, restore story stats and return both to the threshold.
local function release(match: Match)
	if match.Busy then
		return
	end
	match.Busy = true
	local ok, problem = xpcall(function(): boolean
		local record: any = nil
		if match.Journaled then
			local saved, written = journal:Finish(match.Id, match.Results)
			if not saved then
				return false -- Retry on the next poll; never award before the journal commits.
			end
			record = written
			match.Journaled = false
		end
		if record and record.state == "Complete" then
			for _, userId in { match.A, match.B } do
				if Persistence.Get(userId) then
					local result = record.results[tostring(userId)]
					if result and not Persistence.ApplyResult(userId, match.Id, result) then
						warn("[Colosseum] Result for " .. userId .. " deferred to the durable inbox")
					end
				end
			end
		elseif record then
			clearInbox(match.A, match.Id)
			clearInbox(match.B, match.Id)
		end
		local ring = match.Ring
		local returns: { [number]: CFrame } = {
			[match.A] = thresholdPoint(ring, 1),
			[match.B] = thresholdPoint(ring, 2),
		}
		for _, userId in { match.A, match.B } do
			normalized[userId] = nil
			Characters.RefreshProgression(userId)
		end
		Characters.EndAllocatedMatch(match.Id, returns)
		matches[match.Id] = nil
		ring.Match = nil
		ring.CooldownUntil = now() + RING_COOLDOWN
		for _, userId in { match.A, match.B } do
			if matchOf[userId] == match then
				matchOf[userId] = nil
			end
			local result = if match.Results then match.Results[tostring(userId)] else nil
			local opponent = if userId == match.A then match.B else match.A
			notify(userId, {
				action = "MatchResult",
				matchId = match.Id,
				mode = match.Mode,
				outcome = if match.Draw then "Draw" elseif match.Winner == userId then "Win" elseif match.Winner == nil then "Cancelled" else "Loss",
				reason = match.Reason,
				opponentName = match.Names[opponent],
				eloDelta = if result then result.eloDelta else nil,
				profile = Persistence.PublicProfile(userId),
			})
			local p = presence[userId]
			if p then
				p.Ring = nil
				p.Dismissed = nil
			end
		end
		return true
	end, trace)
	match.Busy = false
	if not ok then
		warn("[Colosseum] Release failed: " .. tostring(problem))
	end
end

local function stepMatch(match: Match, clock: number)
	if match.Phase == "Countdown" then
		if clock &gt;= match.PhaseEnds then
			match.Phase = "Fighting"
			match.PhaseEnds = clock + FIGHT_SECONDS
			broadcast("ColosseumFight", match, { ends = match.PhaseEnds })
			for _, userId in { match.A, match.B } do
				notify(userId, { action = "MatchState", phase = "Fighting", ends = match.PhaseEnds })
			end
		end
	elseif match.Phase == "Fighting" then
		if clock &gt;= match.PhaseEnds then
			decideOnTime(match)
			return
		end
		-- Duelists that slip the barrier (lag, physics) are placed back on their mark.
		for slot, userId in { match.A, match.B } do
			local e = Characters.GetEntity(userId)
			if e and e.Fighter.State ~= "KO" then
				local position = e.Root.Position
				if octagonDistance(match.Ring, position) &gt; match.Ring.Definition.Apothem + ESCAPE_MARGIN
					or position.Y &lt; match.Ring.Definition.Center.Y - 8 then
					Characters.Teleport(userId, duelSpawn(match.Ring, slot))
				end
			end
		end
	end
	if match.Phase == "Resolving" and clock &gt;= match.ReleaseAt and not match.Busy then
		task.spawn(release, match)
	end
end

-------------------------------------------------------------------------------------------------
-- Queue and challenges
-------------------------------------------------------------------------------------------------

local function queueStatus(userId: number, ok: boolean, err: string?)
	notify(userId, { action = "Queue", ok = ok, err = err, queued = inQueue(userId), rankedOpen = rankedOpen() })
end

local function enqueue(userId: number): (boolean, string?)
	if closing then
		return false, "ColosseumClosed"
	end
	if not rankedOpen() then
		return false, "RankedClosed"
	end
	local ring = ringOfPlayer(userId)
	if not ring then
		return false, "StepOnThreshold"
	end
	if inQueue(userId) then
		return false, "AlreadyQueued"
	end
	local ready, reason = available(userId)
	if not ready then
		return false, reason
	end
	if presenceOf(userId).Ping &gt; RANKED_ENTRY_PING then
		return false, "HighLatency"
	end
	if not ColosseumService.Recover(userId) then
		return false, "RecoveryPending"
	end
	-- Recover yields: repeat occupancy checks before touching the queue.
	if inQueue(userId) or matchOf[userId] then
		return false, "AlreadyAssigned"
	end
	local profile = Persistence.Get(userId)
	if not profile or Persistence.Engine.busy[userId] then
		return false, "ProfileBusy"
	end
	table.insert(queue, { userId = userId, mode = "Ranked1v1" :: Mode, elo = profile.elo, enteredAt = os.clock(), ring = ring.Definition.Id })
	return true, nil
end

local function pairRanked()
	if pairing or closing or #queue &lt; 2 then
		return
	end
	pairing = true
	local ok, problem = xpcall(function(): boolean
		for index = #queue, 1, -1 do
			local entry = queue[index]
			local userId = entry.userId
			if not Players:GetPlayerByUserId(userId) or not Persistence.Get(userId) then
				table.remove(queue, index)
			elseif presenceOf(userId).Ping &gt; RANKED_DROP_PING then
				table.remove(queue, index)
				queueStatus(userId, false, "HighLatency")
			end
		end
		-- Only fighters who can be sealed right now take part in this pairing pass.
		local eligible: { QueueEntry } = {}
		for _, entry in queue do
			if available(entry.userId) then
				table.insert(eligible, entry)
			end
		end
		local first, second = Rules.FindMatch(eligible :: any, os.clock())
		if not first or not second then
			return false
		end
		local a, b = eligible[first], eligible[second]
		local ring = freeRing(a.ring) or freeRing(b.ring)
		if not ring then
			return false
		end
		local started, reason = begin(ring, a.userId, b.userId, "Ranked1v1" :: Mode)
		if not started then
			warn("[Colosseum] Ranked pairing refused: " .. tostring(reason))
		end
		return true
	end, trace)
	pairing = false
	if not ok then
		warn("[Colosseum] Pairing failed: " .. tostring(problem))
	end
end

local function challenge(from: number, target: number): (boolean, string?)
	if from == target then
		return false, "InvalidTarget"
	end
	local ring = ringOfPlayer(from)
	if not ring then
		return false, "StepOnThreshold"
	end
	local ready, reason = available(from)
	if not ready then
		return false, reason
	end
	local targetReady, targetReason = available(target)
	if not targetReady then
		return false, "Target" .. (targetReason or "Unavailable")
	end
	local previous = outgoing[from]
	if previous then
		local old = challenges[previous]
		challenges[previous] = nil
		if old then
			notify(old.To, { action = "ChallengeWithdrawn", challenge = previous })
		end
	end
	for _, existing in challenges do
		if existing.From == target and existing.To == from then
			return false, "AlreadyChallenged"
		end
	end
	local id = HttpService:GenerateGUID(false)
	local expires = now() + CHALLENGE_SECONDS
	challenges[id] = { Id = id, From = from, To = target, Ring = ring.Definition.Id, Expires = expires }
	outgoing[from] = id
	notify(target, {
		action = "Challenge",
		challenge = id,
		from = from,
		fromName = displayName(from),
		ring = ring.Definition.Id,
		name = ring.Definition.Name,
		expires = expires,
	})
	return true, nil
end

local function respond(userId: number, id: string, accept: boolean)
	local pending = challenges[id]
	if not pending or pending.To ~= userId then
		notify(userId, { action = "ChallengeResult", ok = false, err = "ChallengeExpired" })
		return
	end
	challenges[id] = nil
	if outgoing[pending.From] == id then
		outgoing[pending.From] = nil
	end
	if not accept then
		notify(pending.From, { action = "ChallengeResult", ok = false, err = "ChallengeDeclined", name = displayName(userId) })
		return
	end
	if now() &gt; pending.Expires then
		notify(userId, { action = "ChallengeResult", ok = false, err = "ChallengeExpired" })
		return
	end
	local fromReady, fromReason = available(pending.From)
	local toReady, toReason = available(userId)
	if not fromReady or not toReady then
		local err = if not fromReady then "Target" .. (fromReason or "Unavailable") else toReason
		notify(userId, { action = "ChallengeResult", ok = false, err = err })
		notify(pending.From, { action = "ChallengeResult", ok = false, err = if not toReady then "Target" .. (toReason or "Unavailable") else fromReason })
		return
	end
	local ring = freeRing(pending.Ring)
	if not ring then
		notify(userId, { action = "ChallengeResult", ok = false, err = "RingsOccupied" })
		notify(pending.From, { action = "ChallengeResult", ok = false, err = "RingsOccupied" })
		return
	end
	local started, reason = begin(ring, pending.From, userId, "Casual1v1" :: Mode)
	if not started then
		notify(userId, { action = "ChallengeResult", ok = false, err = reason })
		notify(pending.From, { action = "ChallengeResult", ok = false, err = reason })
	end
end

local function roster(userId: number): { any }
	local list: { any } = {}
	for _, player in Players:GetPlayers() do
		local other = player.UserId
		if other ~= userId and Persistence.Get(other) then
			local record = soulsOf(other)
			local ready, reason = available(other)
			table.insert(list, {
				id = other :: any,
				name = player.DisplayName,
				level = if record then record.level else 1,
				status = if ready then "Ready" else (reason or "Unavailable"),
			})
		end
	end
	table.sort(list, function(x: any, y: any): boolean
		if (x.status == "Ready") ~= (y.status == "Ready") then
			return x.status == "Ready"
		end
		return tostring(x.name) &lt; tostring(y.name)
	end)
	return list
end

local function sendPanel(userId: number, ring: Ring, action: string)
	local profile = Persistence.Get(userId)
	local p = presenceOf(userId)
	p.LastRoster = os.clock()
	notify(userId, {
		action = action,
		ring = ring.Definition.Id,
		name = ring.Definition.Name,
		glyph = ring.Definition.Glyph,
		rankedOpen = rankedOpen(),
		queued = inQueue(userId),
		elo = if profile then profile.colosseum.Elo else nil,
  rank = if profile then profile.colosseum.Rank else "Unranked",
		ping = math.floor(p.Ping * 1000 + 0.5),
		pingLimit = math.floor(RANKED_ENTRY_PING * 1000 + 0.5),
		level = normalizedLevel(userId),
		players = roster(userId),
		occupied = ring.Match ~= nil,
	})
end

-------------------------------------------------------------------------------------------------
-- Intents
-------------------------------------------------------------------------------------------------

local function validIntent(payload: any): boolean
	if type(payload) ~= "table" or type(payload.action) ~= "string" then
		return false
	end
	local shape = INTENT_SHAPES[payload.action]
	if not shape then
		return false
	end
	local count = 0
	for key, value in payload do
		count += 1
		if type(key) ~= "string" or shape[key] == nil or type(value) ~= shape[key] then
			return false
		end
	end
	local expected = 0
	for _ in shape do
		expected += 1
	end
	if count ~= expected then
		return false
	end
	if payload.action == "Challenge" then
		return payload.target == payload.target and payload.target % 1 == 0 and math.abs(payload.target) &lt; 2 ^ 53
	elseif payload.action == "Respond" then
		return #payload.challenge &lt;= 40 and string.match(payload.challenge, "^[%x%-]+$") ~= nil
	end
	return true
end

local function onIntent(player: Player, payload: any)
	if not running or not validIntent(payload) then
		return
	end
	local userId = player.UserId
	local clock = os.clock()
	local budget = budgets[userId]
	if not budget then
		budget = { tokens = INTENT_BURST, time = clock }
		budgets[userId] = budget
	end
	if not Protocol.Take(budget, clock, 1, INTENT_RATE, INTENT_BURST) then
		return
	end
	local action: string = payload.action
	if action == "Enqueue" then
		task.spawn(function()
			local ok, err = enqueue(userId)
			queueStatus(userId, ok, err)
		end)
	elseif action == "Dequeue" then
		dequeue(userId)
		queueStatus(userId, true, nil)
	elseif action == "Refresh" then
		local ring = ringOfPlayer(userId)
		if ring then
			sendPanel(userId, ring, "Roster")
		end
	elseif action == "Dismiss" then
		local p = presenceOf(userId)
		p.Dismissed = p.Ring
	elseif action == "Challenge" then
		local ok, err = challenge(userId, payload.target)
		notify(userId, { action = "ChallengeResult", ok = ok, err = err, sent = ok, name = displayName(payload.target) })
	elseif action == "Respond" then
		task.spawn(respond, userId, payload.challenge, payload.accept)
	end
end

-------------------------------------------------------------------------------------------------
-- Ring geometry
-------------------------------------------------------------------------------------------------

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, geometry: boolean): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	if geometry then
		pcall(function()
			p.CollisionGroup = "WorldGeometry"
		end)
	end
	p.Parent = parent
	return p
end

local function buildRing(ring: Ring, parent: Folder): Model
	local definition = ring.Definition
	local frame = ringFrame(ring)
	local model = Instance.new("Model")
	model.Name = definition.Id
	model:SetAttribute("AsuraColosseum", definition.Name)
	local apothem = definition.Apothem
	local outer = apothem + 1 + definition.Band
	local edge = 2 * math.tan(math.rad(22.5))

	-- Two squares rotated 45° share an apothem and union into a regular octagon.
	for index = 0, 1 do
		local yaw = CFrame.Angles(0, math.rad(45 * index), 0)
		part(model, "Threshold" .. index, Vector3.new(outer * 2, 0.4, outer * 2), frame * yaw * CFrame.new(0, 0.0, 0), STONE, Enum.Material.Slate, true)
		part(model, "Floor" .. index, Vector3.new(apothem * 2, 0.8, apothem * 2), frame * yaw * CFrame.new(0, 0, 0), ASH, Enum.Material.Basalt, true)
	end
	local sigil = part(model, "Sigil", Vector3.new(0.05, apothem * 1.1, apothem * 1.1), frame * CFrame.new(0, FLOOR_TOP + 0.03, 0) * CFrame.Angles(0, 0, math.rad(90)), CHAR, Enum.Material.Slate, false)
	sigil.Shape = Enum.PartType.Cylinder
	sigil.CanCollide = false
	sigil.CanQuery = false
	local inner = part(model, "SigilCore", Vector3.new(0.06, apothem * 0.35, apothem * 0.35), frame * CFrame.new(0, FLOOR_TOP + 0.04, 0) * CFrame.Angles(0, 0, math.rad(90)), EMBER, Enum.Material.Neon, false)
	inner.Shape = Enum.PartType.Cylinder
	inner.CanCollide = false
	inner.CanQuery = false
	inner.Transparency = 0.55

	for k = 0, 7 do
		local yaw = frame * CFrame.Angles(0, math.rad(45 * k), 0)
		local length = apothem * edge
		part(model, "Wall" .. k, Vector3.new(length + 0.9, WALL_HEIGHT, 1), yaw * CFrame.new(0, FLOOR_TOP + WALL_HEIGHT * 0.5, -apothem - 0.5), STONE, Enum.Material.Slate, true)
		local glow = part(model, "Ember" .. k, Vector3.new(length * 0.9, 0.12, 0.6), yaw * CFrame.new(0, 0.22, -(apothem + 1 + definition.Band * 0.5)), EMBER, Enum.Material.Neon, false)
		glow.CanCollide = false
		glow.CanQuery = false
		glow.Transparency = 0.35
		local barrier = part(model, "Barrier" .. k, Vector3.new(length + 1.2, BARRIER_HEIGHT, 1), yaw * CFrame.new(0, FLOOR_TOP + BARRIER_HEIGHT * 0.5, -apothem - 0.5), CHAR, Enum.Material.SmoothPlastic, false)
		barrier.Transparency = 1
		barrier.CanQuery = false
		barrier.CastShadow = false

		local vertex = frame * CFrame.Angles(0, math.rad(45 * k + 22.5), 0) * CFrame.new(0, 0, -(apothem / math.cos(math.rad(22.5)) + 0.6))
		local pillar = part(model, "Pillar" .. k, Vector3.new(1.6, PILLAR_HEIGHT, 1.6), vertex * CFrame.new(0, FLOOR_TOP + PILLAR_HEIGHT * 0.5, 0), CHAR, Enum.Material.Basalt, true)
		local brazier = part(model, "Brazier" .. k, Vector3.new(1.2, 0.8, 1.2), pillar.CFrame * CFrame.new(0, PILLAR_HEIGHT * 0.5 + 0.4, 0), EMBER, Enum.Material.Neon, false)
		brazier.CanCollide = false
		brazier.CanQuery = false
		local light = Instance.new("PointLight")
		light.Color = EMBER
		light.Range = 18
		light.Brightness = 1.4
		light.Shadows = k % 2 == 0
		light.Parent = brazier
	end

	local signPost = part(model, "Sign", Vector3.new(1, 1, 1), frame * CFrame.new(0, FLOOR_TOP + PILLAR_HEIGHT + 3, 0), CHAR, Enum.Material.SmoothPlastic, false)
	signPost.Transparency = 1
	signPost.CanCollide = false
	signPost.CanQuery = false
	local billboard = Instance.new("BillboardGui")
	-- Sized in studs (scale) so it reads as a banner in the world, not a screen-sized overlay.
	billboard.Size = UDim2.fromScale(22, 4.6)
	billboard.MaxDistance = 90
	billboard.LightInfluence = 0
	billboard.Parent = signPost
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0.62, 0)
	title.Font = Enum.Font.Antique
	title.TextScaled = true
	title.Text = string.upper(definition.Name)
	title.TextColor3 = Color3.fromRGB(236, 226, 206)
	title.TextStrokeTransparency = 0.4
	title.Parent = billboard
	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.Position = UDim2.fromScale(0, 0.62)
	hint.Size = UDim2.new(1, 0, 0.38, 0)
	hint.Font = Enum.Font.Garamond
	hint.TextScaled = true
	hint.Text = "Step upon the ember threshold to duel"
	hint.TextColor3 = EMBER
	hint.TextStrokeTransparency = 0.5
	hint.Parent = billboard

	model.PrimaryPart = model:FindFirstChild("Floor0") :: BasePart
	model.Parent = parent
	if definition.Id == "Ring_SanctuaryPromenade" then
		require(script.Parent:WaitForChild("SanctuaryRingFinish") :: ModuleScript).Dress(model)
	end
	return model
end

local function validateDefinitions()
	local seen: { [string]: boolean } = {}
	for _, definition in RING_DEFINITIONS do
		assert(not seen[definition.Id], "Duplicate Colosseum ring " .. definition.Id)
		seen[definition.Id] = true
		local region = World.Regions[definition.Region :: any]
		assert(region, "Unknown Colosseum region " .. definition.Region)
		local reach = (definition.Apothem + 1 + definition.Band) / math.cos(math.rad(22.5))
		for _, corner in { Vector3.new(reach, 0, reach), Vector3.new(-reach, 0, reach), Vector3.new(reach, 0, -reach), Vector3.new(-reach, 0, -reach) } do
			local point = definition.Center + corner
			assert(World.contains(region.Bounds, point.X, point.Y, point.Z), "Colosseum ring leaves its region: " .. definition.Id)
		end
		for _, altar in World.Altars do
			local p = altar.Placement
			assert((Vector3.new(p.X, p.Y, p.Z) - definition.Center).Magnitude &gt; reach + altar.Radius + 4, "Colosseum ring overlaps altar " .. altar.Id)
		end
		for _, entry in World.Spawns do
			local p = entry.Placement
			assert((Vector3.new(p.X, 0, p.Z) - definition.Center).Magnitude &gt; reach + 12, "Colosseum ring overlaps spawn " .. entry.Id)
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Poll
-------------------------------------------------------------------------------------------------

local function poll()
	local clock = now()
	for _, match in matches do
		stepMatch(match, clock)
	end
	for id, pending in challenges do
		if clock &gt; pending.Expires then
			challenges[id] = nil
			if outgoing[pending.From] == id then
				outgoing[pending.From] = nil
			end
			notify(pending.From, { action = "ChallengeResult", ok = false, err = "ChallengeExpired", name = displayName(pending.To) })
			notify(pending.To, { action = "ChallengeWithdrawn", challenge = id })
		end
	end
	local wall = os.clock()
	for _, player in Players:GetPlayers() do
		local userId = player.UserId
		local p = presenceOf(userId)
		local okPing, sample = pcall(function()
			return player:GetNetworkPing()
		end)
		if okPing and type(sample) == "number" then
			p.Ping = if p.Ping &lt;= 0 then sample else p.Ping + (sample - p.Ping) * PING_SMOOTHING
		end
		local match = matchOf[userId]
		if match then
			continue
		end
		-- Clear the Colosseum flag once a returned duelist is standing again.
		if player:GetAttribute("AsuraColosseum") ~= nil then
			local e = Characters.GetEntity(userId)
			if e and e.Fighter.State ~= "KO" and not e.Respawning and not Characters.IsInDuel(userId) then
				player:SetAttribute("AsuraColosseum", nil)
   player:SetAttribute("AsuraArenaNormalized",false)
			end
		end
		local e = Characters.GetEntity(userId)
		local position = if e then e.Root.Position else nil
		-- Nobody outside a match stands inside a sealed ring.
		if position and e and e.Fighter.State ~= "KO" then
			for _, ring in ringOrder do
				if insideRing(ring, position) then
					Characters.Teleport(userId, thresholdPoint(ring, if (position - ring.Definition.Center):Dot(ringFrame(ring).LookVector) &lt; 0 then 1 else 2))
					position = nil
					break
				end
			end
		end
		local current: Ring? = nil
		if position then
			for _, ring in ringOrder do
				if onThreshold(ring, position) then
					current = ring
					break
				end
			end
		end
		local currentId = if current then current.Definition.Id else nil
		if currentId ~= p.Ring then
			p.Ring = currentId
			if current then
				if p.Dismissed ~= currentId then
					sendPanel(userId, current, "Open")
				end
			else
				p.Dismissed = nil
				notify(userId, { action = "Close" })
			end
		elseif current and p.Dismissed ~= currentId and wall - p.LastRoster &gt;= ROSTER_INTERVAL then
			sendPanel(userId, current, "Roster")
		end
	end
	if not pairing and #queue &gt;= 2 then
		task.spawn(pairRanked)
	end
end

-------------------------------------------------------------------------------------------------
-- Hooks: duel rules layered over the story-mode world hooks
-------------------------------------------------------------------------------------------------

local function invoke(fn: any, ...: any): ...any
	return fn(...)
end

local function installHooks()
	local base = Characters.GetHooks() :: any
	baseHooks = base
	local wrapped = table.clone(base) :: any
	local baseStats: any = base.Stats
	wrapped.Stats = function(userId: number): any
		if normalized[userId] then
			return rankedStats(userId)
		end
		return if baseStats ~= nil then invoke(baseStats, userId) else nil
	end
	local baseEquip: any = base.CanEquip
	wrapped.CanEquip = function(userId: number, weapon: string): boolean
		local match = matchOf[userId]
		if match and match.Mode == "Ranked1v1" then
			return false
		end
		return if baseEquip ~= nil then invoke(baseEquip, userId, weapon) == true else true
	end
	local baseSwap: any = base.Swap
	wrapped.Swap = function(userId: number): (boolean, string)
		local match = matchOf[userId]
		if match and match.Mode == "Ranked1v1" then
			return false, "InColosseum"
		end
		if baseSwap ~= nil then
			return invoke(baseSwap, userId)
		end
		return false, "Unavailable"
	end
	for _, name in LOCKED_HOOKS do
		local original: any = base[name]
		wrapped[name] = function(userId: number, ...: any): (boolean, string)
			if matchOf[userId] then
				return false, "InColosseum"
			end
			if original ~= nil then
				return invoke(original, userId, ...)
			end
			return false, "Unavailable"
		end
	end
	Characters.SetHooks(wrapped)
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function ColosseumService.Start()
	assert(not running, "ColosseumService already started")
	validateDefinitions()
	running = true
	closing = false
	local root = Workspace:FindFirstChild(Config.Names.Root)
	if not root then
		root = Instance.new("Folder")
		root.Name = Config.Names.Root
		root.Parent = Workspace
	end
	local container = (root :: Instance):FindFirstChild("Colosseums")
	local owned = false
	if not container then
		container = Instance.new("Folder")
		container.Name = "Colosseums"
		container.Parent = root
		owned = true
	end
	colosseumFolder = if owned then container :: Folder else nil
	for _, definition in RING_DEFINITIONS do
		local directions: { Vector3 } = {}
		for k = 0, 7 do
			local look = (CFrame.Angles(0, math.rad(definition.Yaw + 45 * k), 0)).LookVector
			table.insert(directions, -Vector3.new(look.X, 0, look.Z).Unit)
		end
		local ring: Ring = {
			Definition = definition,
			Model = nil,
			Owned = false,
			Match = nil,
			CooldownUntil = 0,
			Directions = directions,
		}
		-- An authored model with the ring's id replaces the procedural build.
		local authored = Workspace:FindFirstChild(definition.Id, true)
		if authored and authored:IsA("Model") then
			ring.Model = authored
		else
			ring.Model = buildRing(ring, container :: Folder)
			ring.Owned = true
		end
		rings[definition.Id] = ring
		table.insert(ringOrder, ring)
	end
	installHooks()
	table.insert(connections, remote.OnServerEvent:Connect(onIntent))
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator &gt;= POLL_INTERVAL then
			accumulator = 0
			local ok, problem = pcall(poll)
			if not ok then
				warn("[Colosseum] Poll failed: " .. tostring(problem))
			end
		end
	end))
end

-- Forfeits any match the leaving player is part of and withdraws their queue and challenges.
function ColosseumService.Disconnect(userId: number)
	dequeue(userId)
	local pending = outgoing[userId]
	if pending then
		local old = challenges[pending]
		challenges[pending] = nil
		if old then
			notify(old.To, { action = "ChallengeWithdrawn", challenge = pending })
		end
		outgoing[userId] = nil
	end
	for id, entry in challenges do
		if entry.To == userId then
			challenges[id] = nil
			if outgoing[entry.From] == id then
				outgoing[entry.From] = nil
			end
			notify(entry.From, { action = "ChallengeResult", ok = false, err = "TargetUnavailable", name = displayName(userId) })
		end
	end
	local match = matchOf[userId]
	if match and matches[match.Id] ~= match then
		-- Still being set up (begin is yielding on the journal/inbox): it never began, so there is
		-- no forfeit, result broadcast or spectator settlement; begin cancels it when it resumes.
		match.Abandoned = true
	elseif match and match.Phase ~= "Resolving" then
		conclude(match, if match.A == userId then match.B else match.A, false, "Forfeit")
		match.ReleaseAt = now()
	end
	presence[userId] = nil
	budgets[userId] = nil
end

function ColosseumService.IsInMatch(userId: number): boolean
	return matchOf[userId] ~= nil
end

function ColosseumService.CanEquip(userId: number): boolean
	return matchOf[userId] == nil and not inQueue(userId)
end

function ColosseumService.RankedOpen(): boolean
	return rankedOpen()
end

function ColosseumService.GetRings(): { RingDefinition }
	return RING_DEFINITIONS
end

-- Shutdown: cancels every unfinished match (ranked journals close as Cancelled, so no ELO moves)
-- and releases fighters before persistence closes.
function ColosseumService.Close(deadline: number?)
	closing = true
	table.clear(queue)
	table.clear(challenges)
	table.clear(outgoing)
	for _, match in matches do
		if match.Phase ~= "Resolving" then
			conclude(match, nil, false, "Shutdown")
		end
		match.Results = nil
		match.ReleaseAt = 0
	end
	local limit = math.min(deadline or math.huge, os.clock() + 10)
	while next(matches) ~= nil and os.clock() &lt; limit do
		for _, match in matches do
			if not match.Busy then
				task.spawn(release, match)
			end
		end
		task.wait(0.1)
	end
end

function ColosseumService.Destroy()
	running = false
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for id, match in matches do
		Characters.EndAllocatedMatch(id, nil)
		for _, userId in { match.A, match.B } do
			normalized[userId] = nil
			matchOf[userId] = nil
		end
	end
	table.clear(matches)
	local base = baseHooks
	if base then
		Characters.SetHooks(base)
		baseHooks = nil
	end
	for _, ring in ringOrder do
		if ring.Owned and ring.Model then
			ring.Model:Destroy()
		end
	end
	if colosseumFolder then
		colosseumFolder:Destroy()
		colosseumFolder = nil
	end
	table.clear(rings)
	table.clear(ringOrder)
	table.clear(queue)
	table.clear(challenges)
	table.clear(outgoing)
	table.clear(presence)
	table.clear(budgets)
end

return ColosseumService
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">CostumeKit</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CostumeKit
-- Builds a CostumeSchema look onto a live rig (batches 11-14). Every piece is a non-colliding,
-- non-querying, massless Part joined to its limb by a Weld whose C0 is the authored offset, so the
-- rig's Motor6Ds, animations and the server's rewound hurtboxes are untouched; creature joints
-- (AsuraJoint) are posed client-side by CreatureMotion through the same C0. Phase pieces are shown
-- or hidden in place. Creature looks hide the humanoid body (BossAppearance adds their world hull).
local Schema = require(game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared.CostumeSchema)

local Kit = {}
local warned: { [string]: boolean } = {}

local function v3(list: { number }): Vector3 return Vector3.new(list[1], list[2], list[3]) end

local function offset(piece: Schema.Piece, limb: BasePart): CFrame
	local at, face, rot = v3(piece.At or { 0, 0, 0 }), v3(piece.Face or { 0, 0, 0 }), piece.Rot or { 0, 0, 0 }
	return CFrame.new(at + face * limb.Size * 0.5) * CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
end

local function make(piece: Schema.Piece, limb: BasePart, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = piece.Name
	p.Shape = (Enum.PartType :: any)[piece.Shape or "Block"]
	p.Size = if piece.Fit then limb.Size + v3(piece.Size) else v3(piece.Size)
	p.Color = Color3.fromRGB(piece.Color[1], piece.Color[2], piece.Color[3])
	p.Material = (Enum.Material :: any)[piece.Material]
	p.Transparency = piece.Transparency or 0
	p.Anchored, p.Massless, p.CanCollide, p.CanQuery, p.CanTouch = false, true, false, false, false
	p.CastShadow = piece.Glow == nil
	local c0 = offset(piece, limb)
	p.CFrame = limb.CFrame * c0
	local weld = Instance.new("Weld")
	weld.Name, weld.Part0, weld.Part1, weld.C0 = "AsuraBind", limb, p, c0
	weld.Parent = p
	p:SetAttribute("AsuraOpacity", p.Transparency)
	if piece.Phase then p:SetAttribute("AsuraPhase", piece.Phase) end
	if piece.Joint then
		p:SetAttribute("AsuraJoint", piece.Joint)
		-- The hinge in the piece's own space as a fraction of its size, so it survives Model:ScaleTo.
		local hinge = c0:PointToObjectSpace(if piece.Pivot then v3(piece.Pivot) else c0.Position)
		p:SetAttribute("AsuraPivot", hinge / p.Size)
		if piece.Pivot2 then p:SetAttribute("AsuraPivot2", c0:PointToObjectSpace(v3(piece.Pivot2)) / p.Size) end
	end
	if piece.Role then p:SetAttribute("AsuraRole", piece.Role) end
	if piece.Glow then
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness, light.Shadows = p.Color, piece.Glow, 0.7, false
		if piece.Name == "SoulLantern" then
			light.Color, light.Range, light.Brightness, light.Shadows = Color3.fromRGB(255, 175, 95), 15, 1.2, true
		end
		light.Parent = p
	end
	p.Parent = parent
	return p
end

-- Builds `look` onto `model`, replacing any earlier attire. Returns the folder and missing limbs.
function Kit.build(model: Model, look: Schema.Look, phase: number?): (Folder, { string })
	for _, name in { "AsuraAttire", "AsuraHull" } do
		local old = model:FindFirstChild(name)
		if old then old:Destroy() end
	end
	local folder = Instance.new("Folder")
	folder.Name = "AsuraAttire"
	folder:SetAttribute("AsuraCostume", look.Key)
	folder.Parent = model
	local missing: { string } = {}
	for _, piece in look.Pieces do
		local limb = model:FindFirstChild(piece.Bone)
		if limb and limb:IsA("BasePart") then
			make(piece, limb, folder)
		elseif not table.find(missing, piece.Bone) then
			table.insert(missing, piece.Bone)
		end
	end
	if look.HideBody then
		for _, item in model:GetChildren() do
			if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" then
				item.Transparency, item.CastShadow = 1, false
				local face = item:FindFirstChildOfClass("Decal")
				if face then face:Destroy() end
			end
		end
	end
	if look.Body and not look.HideBody then
		for index, body in { look.Body, look.Body2 or look.Body } do
			folder:SetAttribute("Skin" .. index, Color3.fromRGB(body[1][1], body[1][2], body[1][3]))
			folder:SetAttribute("Cloth" .. index, Color3.fromRGB(body[2][1], body[2][2], body[2][3]))
		end
	end
	model:SetAttribute("AsuraCostume", look.Key)
	model:SetAttribute("AsuraRig", look.Rig)
	model:SetAttribute("AsuraWeaponVisual", if look.OwnWeapon then "Costume" else nil)
	local held: { string } = if look.OwnWeapon then { "AsuraWeapon", "ArsenalWeapon" } else {}
	for _, name in held do
		local generic = model:FindFirstChild(name) -- the generic held weapon; the look carries its own
		if generic then generic:Destroy() end
	end
	if #missing &gt; 0 and not warned[look.Key] then
		warned[look.Key] = true
		warn("[Asura Costume] " .. look.Key .. " missing limbs: " .. table.concat(missing, ", "))
	end
	Kit.phase(model, phase or 1)
	return folder, missing
end

-- Shows the pieces of `phase` (untagged pieces always show).
function Kit.phase(model: Model, phase: number)
	local folder = model:FindFirstChild("AsuraAttire")
	if not folder then return end
	folder:SetAttribute("AsuraPhase", phase)
	-- Bare skin (head, hands) and base cloth of the rig itself, per phase.
	local skin, cloth = folder:GetAttribute("Skin" .. phase) or folder:GetAttribute("Skin1"), folder:GetAttribute("Cloth" .. phase) or folder:GetAttribute("Cloth1")
	if typeof(skin) == "Color3" and typeof(cloth) == "Color3" then
		for _, item in model:GetChildren() do
			if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" and item.Name ~= "AsuraWeapon" and item.Name ~= "AsuraHull" then
				local bare = item.Name == "Head" or string.find(item.Name, "Hand") ~= nil
				item.Color, item.Material = if bare then skin else cloth, Enum.Material.SmoothPlastic
			end
		end
	end
	local skinned = model:FindFirstChild("AsuraBossSkin") ~= nil -- a production skin covers all but the weapon
	for _, item in folder:GetChildren() do
		if item:IsA("BasePart") then
			local tagged = item:GetAttribute("AsuraPhase")
			local base = item:GetAttribute("AsuraOpacity")
			local show = (tagged == nil or tagged == phase) and (not skinned or item:GetAttribute("AsuraRole") == "Weapon")
			item.Transparency = if show then (if type(base) == "number" then base else 0) else 1
			local light = item:FindFirstChildOfClass("PointLight")
			if light then light.Enabled = show end
		end
	end
end

return table.freeze(Kit)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">CryptDressing</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CryptDressing
-- The Sunken Crypt's depth and storytelling (batch 19). All decor: ribbed vaults over the nave and
-- the ossuary (the Titan's hall stays open to a far crack of sky, so his height, the Wyrm-free air and
-- the camera are never capped), bone niches, candle drifts on the sarcophagi, the Titan's broken
-- chains anchored at the hall's corners, a pale inlaid ring on the hall floor that keeps his ankles
-- legible against the stone, teal light from the flooded pit, and carved signs at the landing and
-- the gallery. Lighting is warm and pale instead of near-black (with EnvironmentProfiles). Collision
-- lives in SunkenCryptLayout.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Decor = require(script.Parent:WaitForChild("RegionDecor") :: ModuleScript)

local Dressing = {}
local P = Kit.Palette
local M = Enum.Material
local rgb = Color3.fromRGB
local VAULT = rgb(58, 64, 70)
local BONE = rgb(206, 196, 170)
local TEAL = rgb(120, 214, 206)

local function sign(parent: Instance, text: string, cf: CFrame)
	local board = Kit.part(parent, "CarvedSign", Vector3.new(7, 1.8, 0.3), cf, rgb(44, 48, 52), M.Slate, Kit.decor())
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.LightInfluence, gui.PixelsPerStud = Enum.NormalId.Front, 0.4, 40
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.Text = UDim2.fromScale(1, 1), 1, text
	label.Font, label.TextScaled, label.TextColor3 = Enum.Font.Antique, true, rgb(226, 206, 160)
	label.Parent = gui
end

function Dressing.Build(map: Instance, _layout: any, rng: Random)
	local set = Kit.folder("CryptDressing", map)
	-- Vaults: ribs and shells over the nave (z 975..1046) and the ossuary (x 356..404), none over the hall.
	for x = 364, 620, 16 do
		Kit.part(set, "VaultRib", Vector3.new(2, 2, 74), CFrame.new(x, 44, 1010), VAULT, M.Slate, Kit.decor())
	end
	Kit.part(set, "VaultShell", Vector3.new(272, 2, 76), CFrame.new(492, 47, 1010), VAULT:Lerp(rgb(30, 34, 38), 0.4), M.Slate, Kit.decor())
	Kit.part(set, "VaultShell", Vector3.new(50, 2, 196), CFrame.new(380, 47, 874), VAULT:Lerp(rgb(30, 34, 38), 0.4), M.Slate, Kit.decor())
	-- Bone niches along the ossuary and nave walls.
	for z = 790, 1040, 10 do
		if z &lt; 850 or z &gt; 900 then
			Kit.part(set, "BoneNiche", Vector3.new(1.2, 3, 7), CFrame.new(358.8, 6 + (z % 20) * 0.2, z), rgb(34, 36, 40), M.Slate, Kit.decor())
			for k = -1, 1 do
				local skull = Kit.part(set, "Skull", Vector3.new(1, 1, 1), CFrame.new(359.3, 5.4 + (z % 20) * 0.2, z + k * 2), BONE, M.Limestone, Kit.decor())
				skull.Shape = Enum.PartType.Ball
			end
		end
	end
	-- Candle drifts on the sarcophagi and the gallery sill.
	for _, spot in { { 384, 3, 1012 }, { 404, 3, 1028 }, { 572, 3, 1004 }, { 596, 3, 1020 }, { 452, 15, 1022 }, { 366, 0.4, 812 } } do
		for _ = 1, 5 do
			Kit.part(set, "Candle", Vector3.new(0.3, rng:NextNumber(0.5, 1.2), 0.3),
				CFrame.new(spot[1] + rng:NextNumber(-1.4, 1.4), spot[2] + 0.4, spot[3] + rng:NextNumber(-2.5, 2.5)), BONE, M.Limestone, Kit.decor())
		end
		local glow = Kit.hidden(set, "CandleGlow", Vector3.one, CFrame.new(spot[1], spot[2] + 1.4, spot[3]))
		Fx.glow(glow, 0.6)
		Kit.light(glow, rgb(255, 196, 140), 14, 0.9, false)
	end
	-- The Titan's broken chains: anchors at the hall's corners, links slack on the floor.
	for _, c in { { 434, 794 }, { 606, 794 }, { 434, 966 }, { 606, 966 } } do
		Kit.part(set, "ChainAnchor", Vector3.new(4, 6, 4), CFrame.new(c[1] + (if c[1] &lt; 520 then -8 else 8), 3, c[2]), rgb(40, 38, 40), M.Metal, Kit.decor())
		for k = 1, 6 do
			Kit.part(set, "ChainLink", Vector3.new(2.4, 0.5, 1.2), CFrame.new(c[1] + (if c[1] &lt; 520 then -6 + k * 2 else 6 - k * 2), 0.3, c[2] + rng:NextNumber(-1, 1))
				* CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), rgb(54, 50, 50), M.Metal, Kit.decor())
		end
	end
	-- A pale inlaid ring on the hall floor (top 0): reads under the Titan's feet without blocking.
	for k = 0, 23 do
		local a = math.rad(k * 15)
		Kit.part(set, "InlayRing", Vector3.new(10.6, 0.06, 1.2), CFrame.new(520 + math.cos(a) * 40, 0.04, 880 + math.sin(a) * 40) * CFrame.Angles(0, -a + math.pi / 2, 0),
			rgb(176, 168, 150), M.Marble, Kit.decor())
	end
	-- Light: teal from the pit, pale shafts in the hall, warm braziers by the gate.
	local pit = Kit.hidden(set, "PitGlow", Vector3.one, CFrame.new(380, -8, 875))
	Kit.light(pit, TEAL, 40, 1.2, false)
	for _, spot in { { 470, 40, 830 }, { 570, 40, 830 }, { 470, 40, 930 }, { 570, 40, 930 } } do
		local shaft = Kit.hidden(set, "SkyShaft", Vector3.one, CFrame.new(spot[1], spot[2], spot[3]))
		Kit.light(shaft, rgb(200, 220, 230), 60, 1.1, false)
	end
	for _, x in { 504, 536 } do
		Decor.brazier(set, CFrame.new(x, 0, 1012))
	end
	Fx.mist(set, CFrame.new(380, -4, 875), Vector3.new(46, 6, 48), 2, 18, TEAL)
	-- Way signs: back to the shrine at the landing, down to the nave from the gallery.
	sign(set, "RETURN TO THE SHRINE  ↑", CFrame.new(520, 38, 1077.6))
	sign(set, "THE TITAN'S HALL  ↓", CFrame.new(455, 19, 1077.6))
end

return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">DialogueActions</string>
            <string name="Source">--!strict
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Progress=require(Shared.Shared.ProgressionRules)
local Catalog=require(Shared.Shared.NarrativeCatalog)
local Ending=require(Shared.Shared.EndingRules)
local Persistence=require(script.Parent.PersistenceService) :: any
local Characters=require(script.Parent.CharacterService)
local World=require(script.Parent.WorldService)
local Shop=require(script.Parent.ShopService)
local Loot=require(script.Parent.LootService)
local Actions={}
function Actions.view(id: number): any
 local p=Persistence.Get(id);if not p then return nil end
 local rested=0;for _,boss in Catalog.Sovereigns do if p.defeatedBosses[boss] then rested+=1 end end
 return {sovereigns=rested,story=table.clone(p.souls.world.story or {}),qi=p.qiEssence,attributes=p.attributes,inventory=p.inventory,loadout=p.equippedLoadout,mastery=p.weaponMastery,
  colosseum=p.colosseum,cost=Progress.levelCost(Progress.level(p.attributes)),bosses=p.defeatedBosses,
  altars=p.unlockedAltars,tier=(p.inventory.Weapons[p.equippedLoadout.MainWeapon] or {Level=0}).Level}
end
function Actions.run(player: Player,s: any,packet: any,valid: ()-&gt;boolean): (boolean,string?)
 World.Flush(player.UserId,3)
 assert(valid(),"Conversation ended")
 if packet.action=="Upgrade" and s.Panel=="Forge" then return Shop.UpgradeWeapon(player.UserId)
 elseif packet.action=="Infuse" and s.Panel=="Forge" then return Shop.InfuseWeapon(player.UserId,packet.id)
 elseif packet.action=="Trade" and s.Panel=="Trade" then return Shop.Trade(player.UserId,packet.id)
 elseif packet.action=="Level" and s.Panel=="Level" then
  assert(table.find(Progress.Attributes,packet.id),"Unknown attribute")
  return Persistence.Transaction(player.UserId,function(p: any)
   assert(valid(),"Conversation ended");assert(s.NPC=="Lin","Seek Lady Lin")
   local cost=Progress.levelCost(Progress.level(p.attributes));assert(p.qiEssence&gt;=cost,"Not enough Essence")
   assert(p.attributes[packet.id]&lt;99,"Attribute at maximum")
   p.qiEssence-=cost;p.attributes[packet.id]+=1
  end)
 end
 return false,"Choice unavailable"
end
-- Cross / Remain (batch 22): recorded in the story flags before any scene plays, so an interrupted
-- scene, death or disconnect keeps the choice. Grants nothing; returns whether it was the first time.
function Actions.decide(player: Player,s: any,choice: string,valid: ()-&gt;boolean): (boolean,any)
 World.Flush(player.UserId,3)
 local first=false
 local ok,err=Persistence.Transaction(player.UserId,function(p: any)
  assert(valid(),"Conversation ended");assert(s.NPC=="Lin","Seek Lady Lin")
  local story=p.souls.world.story or {};p.souls.world.story=story
  local done,why,isFirst=Ending.decide(story,Ending.stage(p.defeatedBosses,story),choice,s.Projection==true)
  assert(done,why);first=isFirst
 end)
 if not ok then return false,err end
 return true,first
end
function Actions.panel(player: Player,action: string)
 if action=="Arsenal" then Loot.Sync(player,true) end
end
function Actions.lore(player: Player,id: string,valid: ()-&gt;boolean): (boolean,string?)
 local lore=Catalog.Lore[id];if not lore then return false,"Unknown inscription" end
 return Persistence.Transaction(player.UserId,function(p: any)
  assert(valid(),"Too far from memorial");Progress.discover(p,id,lore.Qi)
 end)
end
function Actions.refresh(id: number)
 Characters.RefreshProgression(id);World.Refresh(id)
end
return table.freeze(Actions)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">DialogueService</string>
            <string name="Source">--!strict
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Catalog=require(Shared.Shared.NarrativeCatalog)
local Rules=require(Shared.Shared.DialogueRules)
local Budget=require(Shared.Shared.IntentProtocol)
local Definitions=require(Shared.Shared.WorldDefinitions)
local Ending=require(Shared.Shared.EndingRules)
local Characters=require(script.Parent.CharacterService)
local AI=require(script.Parent.AIService)
local World=require(script.Parent.WorldService)
local Actions=require(script.Parent.DialogueActions)
local Build=require(script.Parent.NarrativeWorld)
local remote=Shared.Net:WaitForChild("DialogueIntent") :: RemoteEvent
local Service={}
local sessions: {[number]: any}={}
local buckets: {[number]: Budget.Bucket}={}
local busy: {[number]: boolean}={}
local links: {RBXScriptConnection}={}
local root: Folder?=nil
local serial=0
local PRESENT=24 -- studs: an NPC this close to the summoning altar answers in person
local function nearby(player: Player,point: Vector3): boolean
 local e=Characters.GetActor(player.UserId)
 return e~=nil and not e.Duel and (e.Fighter.State=="Idle" or e.Fighter.State=="RestingAtShrine")
  and not World.IsInBossFight(player.UserId) and not AI.IsHunting(player.UserId) and (e.Root.Position-point).Magnitude&lt;=18
end
local function valid(player: Player,s: any): boolean
 return sessions[player.UserId]==s and os.clock()&lt;s.Expires and nearby(player,s.Point)
end
local function send(player: Player,s: any,message: string?)
 serial+=1;s.Revision=serial
 remote:FireClient(player,{action="Dialogue",npc=s.NPC,node=s.Node,panel=s.Panel,revision=s.Revision,
  point=s.Subject or s.Point,projection=s.Projection,altar=s.Altar,view=Actions.view(player.UserId),message=message})
end
-- altarId: Lin summoned from the altar menu. Her spirit is projected to the altar (intentional),
-- unless her physical self already stands beside it (the Sanctuary bonfire), where she speaks in person.
-- Point is where the session is validated (the altar when summoned); Subject is who the camera frames.
function Service.Open(player: Player,npc: string,altarId: string?)
 local n=Catalog.NPCs[npc];if not n or busy[player.UserId] then return end
 local point=Vector3.new(n.X,n.Y,n.Z);local subject=point;local projection=false
 if altarId then
  local a=Definitions.Altars[altarId];if not a then return end
  point=Vector3.new(a.Placement.X,a.Placement.Y,a.Placement.Z)
  if (point-subject).Magnitude&gt;PRESENT then subject=point;projection=true end
 end
 if not nearby(player,point) or not Actions.view(player.UserId) then return end
 World.Flush(player.UserId,3)
 if not nearby(player,point) then return end
 local node=n.Start
 local view=Actions.view(player.UserId)
 if npc=="Lin" and view then node=Ending.linNode(Ending.stage(view.bosses,view.story),projection) end
 local s={NPC=npc,Node=node,Panel=nil,Point=point,Expires=os.clock()+120,Revision=0,Projection=projection,Altar=altarId,Subject=subject}
 sessions[player.UserId]=s;send(player,s)
end
local function lore(player: Player,id: string)
 local l=Catalog.Lore[id];if not l or busy[player.UserId] then return end
 local point=Vector3.new(l.X,l.Y,l.Z)
 if not nearby(player,point) then return end
 busy[player.UserId]=true
 local ok,err=Actions.lore(player,id,function() return nearby(player,point) end);busy[player.UserId]=nil
 if ok then Actions.refresh(player.UserId);remote:FireClient(player,{action="Lore",id=id,view=Actions.view(player.UserId)})
 else remote:FireClient(player,{action="Result",message=tostring(err)}) end
end
local function handle(player: Player,p: any)
 if not Rules.valid(p) then return end
 local id=player.UserId;local now=os.clock();local b=buckets[id] or {tokens=6,time=now};buckets[id]=b
 if not Budget.Take(b,now,1,3,6) or busy[id] then return end
 if p.action=="Close" then sessions[id]=nil;return end
 if p.action=="Codex" then remote:FireClient(player,{action="Codex",view=Actions.view(id)});return end
 if p.action=="Summon" then -- deliberate altar-menu choice; resting never opens her by itself
  local profile=Actions.view(id);local live=World.GetSession(id)
  local kindled=(live~=nil and live.Altars~=nil and live.Altars[p.id]==true) or (profile~=nil and profile.altars[p.id]==true)
  if not (Definitions.Altars[p.id] and kindled) then return end
  -- Resting respawns the region, so foes can be hunting at the altar: say so instead of doing nothing.
  if AI.IsHunting(id) then remote:FireClient(player,{action="Refused",message="Lady Lin cannot answer while foes hunt you"});return end
  Service.Open(player,"Lin",p.id)
  return
 end
 local s=sessions[id];if not s or not valid(player,s) or p.revision~=s.Revision then return end
 if p.action=="Choose" then
  local choice=Rules.choose(s.NPC,s.Node,p.index);if not choice then return end
  if choice.Close then sessions[id]=nil;remote:FireClient(player,{action="Close",reason="Farewell"});return end
  if choice.Action=="Cross" or choice.Action=="Remain" then -- batch 22: recorded first, then the scene
   busy[id]=true
   local success,ok,first=pcall(Actions.decide,player,s,choice.Action,function() return valid(player,s) end)
   busy[id]=nil
   if not (success and ok) then if valid(player,s) then send(player,s,string.gsub(tostring(if success then first else ok),"^.-:%d+: ","")) end;return end
   sessions[id]=nil;Actions.refresh(id)
   remote:FireClient(player,{action="Close",reason=choice.Action})
   remote:FireClient(player,{action="Ending",choice=choice.Action,first=first==true});return
  end
  s.Node=choice.Next;s.Panel=choice.Action
  if s.NPC=="Lin" and s.Node=="Greeting" then local v=Actions.view(id);if v then s.Node=Ending.linNode(Ending.stage(v.bosses,v.story),s.Projection) end end
  if s.Panel=="Arsenal" then
   sessions[id]=nil;remote:FireClient(player,{action="Close"});Actions.panel(player,s.Panel);return
  end
  send(player,s);return
 end
 busy[id]=true
 local success,ok,err=pcall(Actions.run,player,s,p,function() return valid(player,s) end)
 busy[id]=nil
 if success and ok then Actions.refresh(id) end
 if valid(player,s) then send(player,s,if success and ok then "The path remembers." else string.gsub(tostring(if success then err else ok),"^.-:%d+: ","")) end
end
function Service.Start()
 assert(not root,"DialogueService already started")
 local folder,connections=Build.build(function(p: Player,id: string) Service.Open(p,id) end,lore);root=folder;links=connections;
 table.insert(links,remote.OnServerEvent:Connect(handle))
 local elapsed=0
 table.insert(links,Run.Heartbeat:Connect(function(dt: number)
  elapsed+=dt;if elapsed&lt;0.5 then return end;elapsed=0
  for id,s in sessions do
   local player=Players:GetPlayerByUserId(id)
   if not player or not valid(player,s) then sessions[id]=nil;if player then remote:FireClient(player,{action="Close"}) end end
  end
 end))
 table.insert(links,Players.PlayerRemoving:Connect(function(p: Player) sessions[p.UserId]=nil;buckets[p.UserId]=nil;busy[p.UserId]=nil end))
end
function Service.Destroy()
 for _,c in links do c:Disconnect() end;table.clear(links)
 if root then root:Destroy();root=nil end;table.clear(sessions);table.clear(buckets);table.clear(busy)
end
return Service
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">EncounterHandoff</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/EncounterHandoff
-- Server side of the shared boss-entry contract (BossHandoff, #16). Opening a handoff locks and
-- protects every participant for exactly the camera shot plus its return blend (Combat cinematic:
-- no actions, no damage), holds the boss for the same window (AIService.Hold) and records the
-- window so the first impact can be deferred to readable control. A participant's Skip intent cuts
-- their own lock to the blend; once every participant has skipped, the boss hold shortens with
-- them. Death, reset and leaving release the player's lock immediately.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared
local HandoffRules = require(Shared.BossHandoff)
local Characters = require(script.Parent.CharacterService)

local Service = {}
type Open = { Window: HandoffRules.Window, Participants: { [number]: boolean }, Skipped: { [number]: boolean }, Members: { number } }
local open: { [string]: Open } = {}
local holdBoss: ((bossId: string, untilTime: number) -&gt; ())? = nil

-- AIService registers how to hold a boss's agents (avoids a require cycle).
function Service.SetHolder(holder: (bossId: string, untilTime: number) -&gt; ())
	holdBoss = holder
end

-- Opens a handoff of `kind` for `participants`; `members` (boss actors) are locked with them when
-- given (an entry); a phase transition keeps its own longer boss cinematic. Returns the window.
function Service.begin(bossId: string, kind: string, participants: { number }, members: { number }?): HandoffRules.Window
	local now = Characters.Now()
	local window = HandoffRules.window(kind, now)
	local set: { [number]: boolean } = {}
	for _, id in participants do
		local e = Characters.GetEntity(id)
		if e and e.Fighter.State ~= "KO" then
			set[id] = true
			Characters.Cinematic(id, HandoffRules.remaining(window, now))
		end
	end
	local actors: { number } = members or {}
	for _, id in actors do Characters.Cinematic(id, HandoffRules.remaining(window, now)) end
	open[bossId] = { Window = window, Participants = set, Skipped = {}, Members = actors }
	if holdBoss then (holdBoss :: any)(bossId, window.Ends) end
	return window
end

function Service.window(bossId: string): HandoffRules.Window?
	local entry = open[bossId]
	return if entry then entry.Window else nil
end

-- Defers an impact time against the boss's open handoff (no-op once it has passed).
function Service.defer(bossId: string, impact: number): number
	local entry = open[bossId]
	return if entry then HandoffRules.defer(impact, entry.Window) else impact
end

local function find(userId: number): (string?, Open?)
	for bossId, entry in open do
		if entry.Participants[userId] then return bossId, entry end
	end
	return nil, nil
end

function Service.skip(userId: number): (boolean, string)
	local bossId, entry = find(userId)
	local now = Characters.Now()
	if not bossId or not entry or now &gt;= entry.Window.Lock or entry.Skipped[userId] then return false, "NoCinematic" end
	entry.Skipped[userId] = true
	Characters.Cinematic(userId, HandoffRules.Blend)
	for id in entry.Participants do
		if not entry.Skipped[id] then return true, "CinematicSkipped" end
	end
	-- Everyone has skipped: the boss's hold ends with theirs and the lead counts from now.
	entry.Window = HandoffRules.skip(entry.Window, now)
	for _, id in entry.Members do Characters.Cinematic(id, HandoffRules.Blend) end
	if holdBoss then (holdBoss :: any)(bossId, entry.Window.Ends) end
	return true, "CinematicSkipped"
end

-- Death, leaving or reset: the player's lock ends now (a KO keeps its own state).
function Service.release(userId: number)
	local _, entry = find(userId)
	if not entry then return end
	entry.Participants[userId] = nil
	local e = Characters.GetEntity(userId)
	if e and e.Fighter.State ~= "KO" and Characters.Now() &lt; entry.Window.Ends then Characters.Cinematic(userId, 0) end
end

function Service.forget(bossId: string)
	local entry = open[bossId]
	if not entry then return end
	local everyone: { [number]: boolean } = table.clone(entry.Participants)
	for id in everyone do Service.release(id) end
	open[bossId] = nil
end

function Service.isProtected(userId: number): boolean
	local _, entry = find(userId)
	return entry ~= nil and not entry.Skipped[userId] and HandoffRules.protected(entry.Window, Characters.Now())
end

return Service
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">EnemyAppearance</string>
            <string name="Source">--!strict
-- Server-authored enemy silhouettes for the opening regions, in the same welded-part language as
-- the player's FighterAppearance (no uploaded imagery). Each look colours the rig's body (skin vs.
-- cloth) and builds an "AsuraAttire" folder; CharacterService's tint skips that folder so boss
-- phase recolours never flatten the clothing.
local Appearance = require(script.Parent:WaitForChild("FighterAppearance") :: ModuleScript)

local gear = Appearance.Gear
local EnemyAppearance = {}

local FABRIC, METAL, WOOD = Enum.Material.Fabric, Enum.Material.Metal, Enum.Material.Wood
local EMBER = Color3.fromRGB(255, 70, 40)

type Parts = { Head: BasePart, Torso: BasePart, Waist: BasePart, Model: Model, Outfit: Folder }

local function limb(model: Model, name: string): BasePart?
	local found = model:FindFirstChild(name)
	return if found and found:IsA("BasePart") then found else nil
end

local function colorBody(model: Model, skin: Color3, cloth: Color3)
	for _, item in model:GetChildren() do
		if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" and item.Name ~= "AsuraWeapon" then
			local bare = item.Name == "Head" or string.find(item.Name, "Hand") ~= nil
			item.Color = if bare then skin else cloth
			-- Fabric's weave reads as wicker on whole limbs; keep it for the smaller attire pieces.
			item.Material = Enum.Material.SmoothPlastic
		end
	end
end

-- Corruption reads through the eyes: two faint embers under the brow.
local function emberEyes(p: Parts)
	local h = p.Head.Size
	for side = -1, 1, 2 do
		local eye = gear(p.Outfit, p.Head, "EmberEye", Vector3.new(0.13, 0.06, 0.05), CFrame.new(side * h.X * 0.18, h.Y * 0.08, -h.Z * 0.5 - 0.01), EMBER, Enum.Material.Neon)
		eye.CastShadow = false
	end
	local light = Instance.new("PointLight")
	light.Color, light.Brightness, light.Range, light.Shadows = EMBER, 0.6, 5, false
	light.Parent = p.Head
end

local function splitSkirt(p: Parts, front: Color3, back: Color3, length: number)
	local w = p.Waist.Size
	for side = -1, 1, 2 do
		gear(p.Outfit, p.Waist, "RaggedSkirtBack", Vector3.new(w.X * 0.5, length, 0.12),
			CFrame.new(side * w.X * 0.26, -length * 0.5 - 0.1, w.Z * 0.5 + 0.08) * CFrame.Angles(math.rad(-7), 0, side * math.rad(6)), back, FABRIC)
		gear(p.Outfit, p.Waist, "RaggedSkirtFront", Vector3.new(w.X * 0.42, length * 0.8, 0.12),
			CFrame.new(side * w.X * 0.28, -length * 0.4 - 0.1, -w.Z * 0.5 - 0.08) * CFrame.Angles(math.rad(7), 0, side * math.rad(-8)), front, FABRIC)
	end
end

local LOOKS: { [string]: (p: Parts) -&gt; () } = {
	-- Fallen temple monk: ash-grey skin, rust kasaya over one shoulder, rope belt, prayer beads.
	CorruptWanderingMonk = function(p)
		local rust, robe, rope = Color3.fromRGB(96, 40, 26), Color3.fromRGB(46, 34, 28), Color3.fromRGB(120, 104, 78)
		colorBody(p.Model, Color3.fromRGB(104, 98, 92), robe)
		local t, w = p.Torso.Size, p.Waist.Size
		gear(p.Outfit, p.Torso, "KasayaDrape", Vector3.new(t.X * 0.62, t.Y * 1.25, t.Z + 0.16),
			CFrame.new(-t.X * 0.12, 0, 0) * CFrame.Angles(0, 0, math.rad(24)), rust, FABRIC)
		gear(p.Outfit, p.Waist, "RopeBelt", Vector3.new(w.X + 0.12, 0.2, w.Z + 0.12), CFrame.new(0, 0.1, 0), rope, FABRIC)
		for bead = 0, 11 do
			local a = bead / 12 * math.pi * 2
			local b = gear(p.Outfit, p.Torso, "PrayerBead", Vector3.new(0.17, 0.17, 0.17),
				CFrame.new(math.sin(a) * t.X * 0.36, t.Y * 0.36 - math.abs(math.cos(a)) * 0.25, -math.cos(a) * t.Z * 0.55), Color3.fromRGB(34, 26, 22), WOOD)
			b.Shape = Enum.PartType.Ball
		end
		splitSkirt(p, robe, rust:Lerp(robe, 0.5), 1.25)
		-- Brawler role: bare forearms bound in stained wraps and iron-knuckled fists.
		for _, name in { "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand" } do
			local arm = limb(p.Model, name)
			if arm then
				local fist = string.find(name, "Hand") ~= nil
				gear(p.Outfit, arm, if fist then "IronKnuckles" else "StainedWraps", arm.Size + (if fist then Vector3.new(0.18, 0.12, 0.18) else Vector3.new(0.06, -0.2, 0.06)),
					CFrame.new(), if fist then Color3.fromRGB(70, 66, 62) else Color3.fromRGB(112, 100, 84), if fist then METAL else FABRIC)
			end
		end
		emberEyes(p)
	end,
	-- Ash Pagoda guard: dark iron lamellar, pauldrons, black kasa and a tattered cloak.
	CursedSwordsman = function(p)
		local iron, cloth, straw = Color3.fromRGB(66, 66, 70), Color3.fromRGB(24, 24, 28), Color3.fromRGB(58, 48, 34)
		colorBody(p.Model, Color3.fromRGB(88, 80, 74), cloth)
		local t, h = p.Torso.Size, p.Head.Size
		for row = 0, 3 do
			gear(p.Outfit, p.Torso, "Lamellar", Vector3.new(t.X + 0.14, t.Y * 0.22, t.Z + 0.14),
				CFrame.new(0, t.Y * (0.33 - row * 0.22), 0), if row % 2 == 0 then iron else iron:Lerp(cloth, 0.3), METAL)
		end
		for side = -1, 1, 2 do
			gear(p.Outfit, p.Torso, "Pauldron", Vector3.new(0.9, 0.22, t.Z + 0.35),
				CFrame.new(side * (t.X * 0.5 + 0.3), t.Y * 0.42, 0) * CFrame.Angles(0, 0, side * math.rad(-22)), iron, METAL)
		end
		for tier = 0, 9 do
			local radius = 1.6 * (1 - tier / 10.5)
			gear(p.Outfit, p.Head, "BlackKasa", Vector3.new(0.09, radius * 2, radius * 2),
				CFrame.new(0, h.Y * 0.42 + tier * 0.1, 0) * CFrame.Angles(0, 0, math.pi * 0.5), straw:Lerp(cloth, tier / 12), WOOD, true)
		end
		gear(p.Outfit, p.Torso, "TatteredCloak", Vector3.new(t.X * 1.05, t.Y * 2.1, 0.1),
			CFrame.new(0, -t.Y * 0.45, t.Z * 0.5 + 0.12) * CFrame.Angles(math.rad(-6), 0, 0), Color3.fromRGB(34, 22, 22), FABRIC)
		splitSkirt(p, cloth, iron, 1.1)
		-- Swordsman role: the dao's lacquered scabbard rides the left hip.
		gear(p.Outfit, p.Waist, "Scabbard", Vector3.new(0.22, 0.4, 3.4), CFrame.new(-p.Waist.Size.X * 0.62, -0.2, 0.3) * CFrame.Angles(math.rad(-28), 0, 0), Color3.fromRGB(40, 22, 20), WOOD)
		emberEyes(p)
	end,
	-- Sparring Phantom: a translucent jade training spirit with a white sash; never mistaken for a foe.
	SparringPhantom = function(p)
		local jade = Color3.fromRGB(150, 220, 196)
		colorBody(p.Model, jade, jade)
		for _, item in p.Model:GetChildren() do
			if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" then item.Transparency, item.Material = 0.35, Enum.Material.Glass end
		end
		local sash = gear(p.Outfit, p.Waist, "TrainingSash", p.Waist.Size + Vector3.new(0.14, 0.2, 0.14), CFrame.new(), Color3.fromRGB(240, 240, 232), FABRIC)
		sash.Transparency = 0.1
		local glow = Instance.new("PointLight")
		glow.Color, glow.Brightness, glow.Range, glow.Shadows = jade, 0.8, 8, false
		glow.Parent = p.Torso
	end,
}

function EnemyAppearance.Has(definition: string?): boolean
	return definition ~= nil and LOOKS[definition] ~= nil
end

-- Returns true when a look was applied; callers fall back to the flat body tint otherwise.
function EnemyAppearance.Apply(model: Model, definition: string?): boolean
	local build = if definition then LOOKS[definition] else nil
	local head, torso = limb(model, "Head"), limb(model, "UpperTorso") or limb(model, "Torso")
	local waist = limb(model, "LowerTorso") or torso
	if not build or not head or not torso or not waist then
		return false
	end
	local outfit = Instance.new("Folder")
	outfit.Name = "AsuraAttire"
	outfit.Parent = model
	build({ Head = head, Torso = torso, Waist = waist, Model = model, Outfit = outfit })
	return true
end

return table.freeze(EnemyAppearance)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">EnvironmentService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/EnvironmentService
-- Applies Config.Lighting at runtime so the place file and the live server always agree: the
-- Overcast sanctuary sun, colour shift, Atmosphere, SunRays, Bloom, colour correction and
-- depth of field. Effects are created by name if missing and updated in place if present.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("AsurasPath"):WaitForChild("Config") :: ModuleScript) :: any

local Profiles = require(ReplicatedStorage.AsurasPath.Shared.EnvironmentProfiles)
local Environment = {}

local function color(rgb: { number }): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function effect(name: string, className: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing then
		assert(existing.ClassName == className, "Unexpected class at Lighting/" .. name)
		return existing
	end
	local created = Instance.new(className :: any)
	created.Name = name
	created.Parent = Lighting
	return created
end

function Environment.Apply()
	local l = Config.Lighting
	Workspace.Gravity = Config.Workspace.Gravity
	local wind = Config.Workspace.GlobalWind
	Workspace.GlobalWind = Vector3.new(wind[1], wind[2], wind[3])

	Lighting.Brightness = l.Brightness
	Lighting.ClockTime = l.ClockTime
	Lighting.GeographicLatitude = l.GeographicLatitude
	Lighting.Ambient = color(l.Ambient)
	Lighting.OutdoorAmbient = color(l.OutdoorAmbient)
	Lighting.ColorShift_Top = color(l.ColorShiftTop)
	Lighting.ColorShift_Bottom = color(l.ColorShiftBottom)
	Lighting.EnvironmentDiffuseScale = l.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = l.EnvironmentSpecularScale
	Lighting.GlobalShadows = l.GlobalShadows
	Lighting.ShadowSoftness = l.ShadowSoftness
	Lighting.ExposureCompensation = l.ExposureCompensation
	Lighting.FogColor = color(l.FogColor)
	Lighting.FogStart = l.FogStart
	Lighting.FogEnd = l.FogEnd
	-- Technology and quality are baked into the place; Studio restricts writing them at runtime.
	if Lighting.LightingStyle ~= Enum.LightingStyle.Realistic or Lighting.PrioritizeLightingQuality ~= l.PrioritizeLightingQuality then
		warn("[AsurasPath] In Studio set LightingStyle=Realistic and PrioritizeLightingQuality=true.")
	end
	if Workspace.StreamingEnabled ~= Config.Workspace.StreamingEnabled then
		warn("[AsurasPath] In Studio set Workspace.StreamingEnabled to the Config value.")
	end
	if Workspace.FallenPartsDestroyHeight ~= Config.Workspace.FallenPartsDestroyHeight then
		warn("[AsurasPath] In Studio set Workspace.FallenPartsDestroyHeight to the Config value.")
	end

	local cc = effect("CB_ColorCorrection", "ColorCorrectionEffect") :: ColorCorrectionEffect
	cc.Enabled = l.ColorCorrection.Enabled
	cc.Brightness = l.ColorCorrection.Brightness
	cc.Contrast = l.ColorCorrection.Contrast
	cc.Saturation = l.ColorCorrection.Saturation
	cc.TintColor = color(l.ColorCorrection.TintColor)

	local bloom = effect("CB_Bloom", "BloomEffect") :: BloomEffect
	bloom.Enabled = l.Bloom.Enabled
	bloom.Intensity = l.Bloom.Intensity
	bloom.Size = l.Bloom.Size
	bloom.Threshold = l.Bloom.Threshold

	local dof = effect("CB_DepthOfField", "DepthOfFieldEffect") :: DepthOfFieldEffect
	dof.Enabled = l.DepthOfField.Enabled
	dof.FarIntensity = l.DepthOfField.FarIntensity
	dof.NearIntensity = l.DepthOfField.NearIntensity
	dof.FocusDistance = l.DepthOfField.FocusDistance
	dof.InFocusRadius = l.DepthOfField.InFocusRadius

	local atmosphere = effect("CB_Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = l.Atmosphere.Density
	atmosphere.Offset = l.Atmosphere.Offset
	atmosphere.Haze = l.Atmosphere.Haze
	atmosphere.Glare = l.Atmosphere.Glare
	atmosphere.Color = color(l.Atmosphere.Color)
	atmosphere.Decay = color(l.Atmosphere.Decay)

	local rays = effect("CB_SunRays", "SunRaysEffect") :: SunRaysEffect
	rays.Enabled = l.SunRays.Enabled
	rays.Intensity = l.SunRays.Intensity
	rays.Spread = l.SunRays.Spread

 -- The shared shrine profile is the server baseline. Clients blend regional profiles locally.
 for name, values in Profiles.Sanctuary do
  local target = if name == "Lighting" then Lighting else Lighting:FindFirstChild(name)
  if target then for property, value in values do (target :: any)[property] = value end end
 end
 local sky = Lighting:FindFirstChildOfClass("Sky")
 if not sky then local created = Instance.new("Sky"); created.Name = "AsuraSky"; created.Parent = Lighting end
 Workspace.Terrain.WaterColor = Color3.fromRGB(31,69,68)
 Workspace.Terrain.WaterReflectance = 0.5
 Workspace.Terrain.WaterTransparency = 0.46
 Workspace.Terrain.WaterWaveSize, Workspace.Terrain.WaterWaveSpeed = 0.06, 4

	-- Only one Atmosphere renders; a second authored one would fight the configured sky.
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") and child ~= atmosphere then
			warn("[AsurasPath] Extra Atmosphere in Lighting overrides the configured sky: " .. child.Name)
		end
	end
end

return table.freeze(Environment)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">FighterAppearance</string>
            <string name="Source">--!strict
-- Server-authored wanderer silhouette. Uses local geometry and materials only; combat rigs,
-- joints and movement animations remain owned by the character system.
local Appearance = {}

local CLOTH = Color3.fromRGB(32, 39, 41)
local HEM = Color3.fromRGB(45, 51, 49)
local WRAP = Color3.fromRGB(96, 94, 80)
local SKIN = Color3.fromRGB(137, 116, 94)
local SASH = Color3.fromRGB(88, 35, 33)
local STRAW = Color3.fromRGB(85, 76, 54)
local HAIR = Color3.fromRGB(24, 20, 20)

local function gear(parent: Instance, limb: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, cylinder: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	if cylinder then p.Shape = Enum.PartType.Cylinder end
	p.CFrame = limb.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = limb
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent
	return p
end

local function imported(item: Instance): boolean
	return item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants")
		or item:IsA("ShirtGraphic") or item:IsA("BodyColors")
end

local function colorBody(model: Model)
	for _, item in model:GetChildren() do
		if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" and item.Name ~= "AsuraWeapon" then
			local skin = item.Name == "Head" or string.find(item.Name, "Hand") ~= nil
			item.Color = if skin then SKIN else CLOTH
			item.Material = if skin then Enum.Material.SmoothPlastic else Enum.Material.Fabric
			if item:IsA("MeshPart") then item.TextureID = "" end
			for _, child in item:GetChildren() do
				if child:IsA("Decal") or child:IsA("SurfaceAppearance") then child:Destroy() end
			end
		end
	end
end

-- True when every attire piece is still welded to a limb of this rig. Avatar loading can swap the
-- head or torso after CharacterAdded; pieces welded to the old limb fall away, and the old
-- "folder has children" check kept that orphaned attire instead of rebuilding it (#24: the
-- player read as a bald block body).
function Appearance.Attached(model: Model, attire: Instance): boolean
	local count = 0
	for _, piece in attire:GetChildren() do
		local weld = piece:FindFirstChildOfClass("WeldConstraint")
		local limb = weld and weld.Part0
		if not limb or limb.Parent ~= model then return false end
		count += 1
	end
	return count &gt; 0
end

function Appearance.Apply(model: Model, connections: { RBXScriptConnection })
	-- Account accessories can arrive after CharacterAdded; remove them only from this game rig.
	for _, child in model:GetChildren() do
		if imported(child) then child:Destroy() end
	end
	colorBody(model)
	local existing = model:FindFirstChild("AsuraAttire")
	if existing and Appearance.Attached(model, existing) then return end
	if existing then existing:Destroy() end
	if not model:GetAttribute("AsuraAttireWatch") then
		model:SetAttribute("AsuraAttireWatch", true)
		table.insert(connections, model.ChildAdded:Connect(function(child)
			if imported(child) or child:IsA("BasePart") then
				task.defer(function()
					if imported(child) and child.Parent == model then child:Destroy() end
					-- A replaced limb re-dresses the rig so attire always binds to the live body.
					if model.Parent then Appearance.Apply(model, connections) end
				end)
			end
		end))
	end
	local head = model:FindFirstChild("Head")
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	local waist = model:FindFirstChild("LowerTorso") or torso
	if not head or not head:IsA("BasePart") or not torso or not torso:IsA("BasePart")
		or not waist or not waist:IsA("BasePart") then return end
	local outfit = Instance.new("Folder")
	outfit.Name = "AsuraAttire"
	outfit.Parent = model
	-- Closely spaced round courses read as the weave of a low travelling hat.
	for tier = 0, 13 do
		local radius = 1.48 * (1-tier/15)
		gear(outfit, head, "WovenHat", Vector3.new(0.065, radius*2, radius*2),
			CFrame.new(0, head.Size.Y*0.4+tier*0.048, 0)*CFrame.Angles(0,0,math.pi*0.5),
			if tier%3==0 then STRAW else STRAW:Lerp(CLOTH,0.15), Enum.Material.Wood, true)
	end
	gear(outfit, head, "ShadowedFaceWrap", Vector3.new(head.Size.X*0.92,head.Size.Y*0.36,0.12),
		CFrame.new(0,-head.Size.Y*0.18,-head.Size.Z*0.5),CLOTH,Enum.Material.Fabric)
	-- Hair under the hat brim, a queue down the back, and a readable eye band above the wrap.
	local h = head.Size
	gear(outfit, head, "HairCap", Vector3.new(h.X * 1.05, h.Y * 0.3, h.Z * 1.05), CFrame.new(0, h.Y * 0.3, h.Z * 0.03), HAIR, Enum.Material.Fabric)
	for link = 0, 2 do
		gear(outfit, head, "Queue", Vector3.new(0.24, 0.5, 0.24), CFrame.new(0, -h.Y * 0.1 - link * 0.42, h.Z * 0.55 + link * 0.04), HAIR, Enum.Material.Fabric)
	end
	for side = -1, 1, 2 do
		gear(outfit, head, "Eye", Vector3.new(h.X * 0.13, h.Y * 0.06, 0.04), CFrame.new(side * h.X * 0.18, h.Y * 0.06, -h.Z * 0.5 - 0.01), Color3.fromRGB(26, 22, 22), Enum.Material.SmoothPlastic)
		gear(outfit, head, "Brow", Vector3.new(h.X * 0.24, h.Y * 0.05, 0.04), CFrame.new(side * h.X * 0.19, h.Y * 0.17, -h.Z * 0.5 - 0.01) * CFrame.Angles(0, 0, side * math.rad(-8)), HAIR, Enum.Material.Fabric)
	end
	local t = torso.Size
	gear(outfit, torso, "ShoulderMantle", Vector3.new(t.X * 1.14, t.Y * 0.32, t.Z * 1.25), CFrame.new(0, t.Y * 0.36, 0.02), HEM, Enum.Material.Fabric)
	gear(outfit, torso, "MantleBack", Vector3.new(t.X * 1.02, t.Y * 1.05, 0.1), CFrame.new(0, -t.Y * 0.05, t.Z * 0.5 + 0.08) * CFrame.Angles(math.rad(-4), 0, 0), HEM, Enum.Material.Fabric)
	gear(outfit, torso, "CrossedLapel", Vector3.new(0.18,torso.Size.Y*1.05,0.1),
		CFrame.new(-0.15,0,-torso.Size.Z*0.5-0.06)*CFrame.Angles(0,0,math.rad(-28)),WRAP,Enum.Material.Fabric)
	gear(outfit, waist, "OxBloodSash", Vector3.new(waist.Size.X+0.15,0.32,waist.Size.Z+0.14),
		CFrame.new(0,0,0),SASH,Enum.Material.Fabric)
	gear(outfit, waist, "SashKnot", Vector3.new(0.32,0.4,0.2),
		CFrame.new(-waist.Size.X*0.3,-0.08,-waist.Size.Z*0.5-0.12),WRAP,Enum.Material.Fabric)
	for side=-1,1,2 do
		gear(outfit, waist, "SplitRobeBack", Vector3.new(waist.Size.X*0.49,1.3,0.12),
			CFrame.new(side*waist.Size.X*0.27,-0.72,waist.Size.Z*0.5+0.08)*CFrame.Angles(math.rad(-8),0,side*math.rad(5)),HEM,Enum.Material.Fabric)
		gear(outfit, waist, "SplitRobeFront", Vector3.new(waist.Size.X*0.4,0.95,0.12),
			CFrame.new(side*waist.Size.X*0.3,-0.58,-waist.Size.Z*0.5-0.08)*CFrame.Angles(math.rad(8),0,side*math.rad(-7)),CLOTH,Enum.Material.Fabric)
	end
	for _, name in {"LeftLowerArm", "RightLowerArm", "LeftLowerLeg", "RightLowerLeg"} do
		local limb = model:FindFirstChild(name)
		if limb and limb:IsA("BasePart") then
			gear(outfit, limb, if string.find(name, "Arm") then "LinenBracer" else "LegWrap", limb.Size+Vector3.new(0.07,-0.15,0.07),CFrame.new(),WRAP,Enum.Material.Fabric)
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
end

-- Shared with EnemyAppearance so every fighter's attire is built the same way.
Appearance.Gear = gear

return table.freeze(Appearance)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">ForgeService</string>
            <string name="Source">--!strict
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Rules=require(Shared.Shared.ProgressionRules)
local Catalog=require(Shared.Shared.NarrativeCatalog)
local Persistence=require(script.Parent.PersistenceService) :: any
local Characters=require(script.Parent.CharacterService)
local World=require(Shared.Shared.WorldDefinitions)
local Forge={}
local function near(id: number,point: Vector3): boolean
 local e=Characters.GetActor(id)
 return e~=nil and not e.Duel and (e.Fighter.State=="Idle" or e.Fighter.State=="RestingAtShrine") and (e.Root.Position-point).Magnitude&lt;=18
end
function Forge.smith(id: number): boolean
 local p=World.Sanctuary.Loggia;return near(id,Vector3.new(p.X+5,p.Y+3,p.Z))
end
function Forge.Upgrade(id: number): (boolean,string?)
 if not Forge.smith(id) then return false,"Visit Master Smith Gao" end
 return Persistence.Transaction(id,function(p: any)
  assert(Forge.smith(id),"Visit Master Smith Gao");Rules.upgrade(p,p.equippedLoadout.MainWeapon)
 end)
end
function Forge.Infuse(id: number,affinity: string): (boolean,string?)
 if not Forge.smith(id) then return false,"Visit Master Smith Gao" end
 return Persistence.Transaction(id,function(p: any)
  assert(Forge.smith(id),"Visit Master Smith Gao");Rules.infuse(p,p.equippedLoadout.MainWeapon,affinity)
 end)
end
function Forge.Trade(id: number,item: string): (boolean,string?)
 local trade=Catalog.Trades[item];if not trade then return false,"Unknown trade" end
 local h=Catalog.NPCs.Hermit;local position=Vector3.new(h.X,h.Y,h.Z)
 if not near(id,position) then return false,"Visit the Wandering Hermit" end
 return Persistence.Transaction(id,function(p: any)
  assert(near(id,position),"Visit the Wandering Hermit");assert(p.qiEssence&gt;=trade.Price,"Not enough Essence")
  p.qiEssence-=trade.Price;p.inventory.Materials[item]=(p.inventory.Materials[item] or 0)+1
 end)
end
return table.freeze(Forge)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">LagCompensation</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/LagCompensation
-- 60 Hz pose history per entity and continuous weapon-vs-hurtbox queries against rewound poses.
-- Ring slots are allocated once; recording overwrites in place and sampling returns multiple values.

export type Capsule = { Region: string, A: Vector3, B: Vector3, Radius: number }
export type Profile = { Capsules: { Capsule }, BoxOffset: CFrame, BoxHalfSize: Vector3, Reach: number }

export type History = {
	Capacity: number,
	Head: number,
	Count: number,
	Times: { number },
	CFrames: { CFrame },
	Velocities: { Vector3 },
	WeaponA: { Vector3 },
	WeaponB: { Vector3 },
	WeaponRadius: { number },
	Profile: Profile,
}

export type Hit = { Region: string, Point: Vector3, Fraction: number, Distance: number }

local LagCompensation = {}

LagCompensation.TICK_RATE = 60
LagCompensation.TICK = 1 / 60
LagCompensation.HISTORY_FRAMES = 30
LagCompensation.MAX_REWIND = 0.15
LagCompensation.INTERPOLATION_DELAY = 1 / 30
LagCompensation.MAX_SWEEP_STEPS = 12

local EPSILON = 1e-9
local ZERO = Vector3.zero
local GOLDEN = (math.sqrt(5) - 1) / 2

-- Root-part-relative capsules for a standard R15 humanoid (HumanoidRootPart at the hip line).
LagCompensation.HumanoidProfile = table.freeze({
	Capsules = table.freeze({
		table.freeze({ Region = "Head", A = Vector3.new(0, 1.55, 0), B = Vector3.new(0, 2.05, 0), Radius = 0.6 }),
		table.freeze({ Region = "Torso", A = Vector3.new(0, -0.15, 0), B = Vector3.new(0, 1.05, 0), Radius = 0.95 }),
		table.freeze({ Region = "LeftArm", A = Vector3.new(-1.5, 1.05, 0), B = Vector3.new(-1.5, -0.55, 0), Radius = 0.45 }),
		table.freeze({ Region = "RightArm", A = Vector3.new(1.5, 1.05, 0), B = Vector3.new(1.5, -0.55, 0), Radius = 0.45 }),
		table.freeze({ Region = "LeftLeg", A = Vector3.new(-0.5, -0.95, 0), B = Vector3.new(-0.5, -2.75, 0), Radius = 0.5 }),
		table.freeze({ Region = "RightLeg", A = Vector3.new(0.5, -0.95, 0), B = Vector3.new(0.5, -2.75, 0), Radius = 0.5 }),
	}),
	BoxOffset = CFrame.new(0, -0.3, 0),
	BoxHalfSize = Vector3.new(2.05, 2.95, 1.0),
	Reach = 3.6,
}) :: Profile

function LagCompensation.newHistory(profile: Profile?, capacity: number?): History
	local size = capacity or LagCompensation.HISTORY_FRAMES
	assert(size % 1 == 0 and size &gt;= 2 and size &lt;= 240, "History capacity must be an integer in 2..240")
	local times: { number } = table.create(size, -math.huge)
	local cframes: { CFrame } = table.create(size, CFrame.identity)
	local velocities: { Vector3 } = table.create(size, ZERO)
	local weaponA: { Vector3 } = table.create(size, ZERO)
	local weaponB: { Vector3 } = table.create(size, ZERO)
	local weaponRadius: { number } = table.create(size, 0)
	return {
		Capacity = size,
		Head = 0,
		Count = 0,
		Times = times,
		CFrames = cframes,
		Velocities = velocities,
		WeaponA = weaponA,
		WeaponB = weaponB,
		WeaponRadius = weaponRadius,
		Profile = profile or LagCompensation.HumanoidProfile,
	}
end

function LagCompensation.clear(history: History)
	history.Head = 0
	history.Count = 0
end

local function slot(history: History, logical: number): number
	-- logical 0 = oldest, Count-1 = newest
	return (history.Head - history.Count + logical) % history.Capacity + 1
end

function LagCompensation.record(history: History, time: number, cframe: CFrame, velocity: Vector3, weaponA: Vector3?, weaponB: Vector3?, weaponRadius: number?)
	local index: number
	if history.Count &gt; 0 and time &lt;= history.Times[history.Head] + EPSILON then
		-- Same or older tick: refresh the newest sample rather than breaking monotonic order.
		index = history.Head
		time = history.Times[index]
	else
		history.Head = history.Head % history.Capacity + 1
		history.Count = math.min(history.Count + 1, history.Capacity)
		index = history.Head
	end
	history.Times[index] = time
	history.CFrames[index] = cframe
	history.Velocities[index] = velocity
	history.WeaponA[index] = weaponA or cframe.Position
	history.WeaponB[index] = weaponB or cframe.Position
	history.WeaponRadius[index] = weaponRadius or 0
end

function LagCompensation.newestTime(history: History): number?
	if history.Count == 0 then
		return nil
	end
	return history.Times[history.Head]
end

function LagCompensation.oldestTime(history: History): number?
	if history.Count == 0 then
		return nil
	end
	return history.Times[slot(history, 0)]
end

-- Largest logical index whose time is &lt;= t (bisection); -1 when t predates the history.
local function bisect(history: History, t: number): number
	local low, high = 0, history.Count - 1
	if t &lt; history.Times[slot(history, 0)] then
		return -1
	end
	if t &gt;= history.Times[slot(history, high)] then
		return high
	end
	while high - low &gt; 1 do
		local mid = (low + high) // 2
		if history.Times[slot(history, mid)] &lt;= t then
			low = mid
		else
			high = mid
		end
	end
	return low
end

-- Interpolated pose at t, clamped to the stored range: (cframe, velocity, weaponA, weaponB, weaponRadius).
function LagCompensation.samplePoseAt(history: History, timestamp: number): (CFrame?, Vector3, Vector3, Vector3, number)
	if history.Count == 0 then
		return nil, ZERO, ZERO, ZERO, 0
	end
	local lower = bisect(history, timestamp)
	if lower &lt; 0 then
		local i = slot(history, 0)
		return history.CFrames[i], history.Velocities[i], history.WeaponA[i], history.WeaponB[i], history.WeaponRadius[i]
	end
	local i = slot(history, lower)
	if lower &gt;= history.Count - 1 then
		return history.CFrames[i], history.Velocities[i], history.WeaponA[i], history.WeaponB[i], history.WeaponRadius[i]
	end
	local j = slot(history, lower + 1)
	local t0, t1 = history.Times[i], history.Times[j]
	local alpha = if t1 - t0 &gt; EPSILON then math.clamp((timestamp - t0) / (t1 - t0), 0, 1) else 0
	if alpha &lt;= EPSILON then
		return history.CFrames[i], history.Velocities[i], history.WeaponA[i], history.WeaponB[i], history.WeaponRadius[i]
	end
	return history.CFrames[i]:Lerp(history.CFrames[j], alpha),
		history.Velocities[i]:Lerp(history.Velocities[j], alpha),
		history.WeaponA[i]:Lerp(history.WeaponA[j], alpha),
		history.WeaponB[i]:Lerp(history.WeaponB[j], alpha),
		history.WeaponRadius[i] + (history.WeaponRadius[j] - history.WeaponRadius[i]) * alpha
end

-- Server time to rewind a target to for an attacker. Client claims are trusted only inside the
-- MAX_REWIND ceiling and never beyond measured round-trip plus interpolation delay.
function LagCompensation.rewindTime(now: number, claimedTime: number?, ping: number?): number
	local budget = LagCompensation.MAX_REWIND
	if ping ~= nil and ping == ping and ping &gt;= 0 then
		budget = math.min(budget, ping + LagCompensation.INTERPOLATION_DELAY + LagCompensation.TICK)
	end
	local earliest = now - budget
	if claimedTime == nil or claimedTime ~= claimedTime then
		return earliest
	end
	return math.clamp(claimedTime, earliest, now)
end

-- Closest points between segments p1q1 and p2q2: (distanceSquared, s, t, closest1, closest2).
function LagCompensation.segmentSegment(p1: Vector3, q1: Vector3, p2: Vector3, q2: Vector3): (number, number, number, Vector3, Vector3)
	local d1 = q1 - p1
	local d2 = q2 - p2
	local r = p1 - p2
	local a = d1:Dot(d1)
	local e = d2:Dot(d2)
	local f = d2:Dot(r)
	local s, t
	if a &lt;= EPSILON and e &lt;= EPSILON then
		local diff = p1 - p2
		return diff:Dot(diff), 0, 0, p1, p2
	end
	if a &lt;= EPSILON then
		s = 0
		t = math.clamp(f / e, 0, 1)
	else
		local c = d1:Dot(r)
		if e &lt;= EPSILON then
			t = 0
			s = math.clamp(-c / a, 0, 1)
		else
			local b = d1:Dot(d2)
			local denom = a * e - b * b
			s = if denom &gt; EPSILON then math.clamp((b * f - c * e) / denom, 0, 1) else 0
			t = (b * s + f) / e
			if t &lt; 0 then
				t = 0
				s = math.clamp(-c / a, 0, 1)
			elseif t &gt; 1 then
				t = 1
				s = math.clamp((b - c) / a, 0, 1)
			end
		end
	end
	local c1 = p1 + d1 * s
	local c2 = p2 + d2 * t
	local diff = c1 - c2
	return diff:Dot(diff), s, t, c1, c2
end

function LagCompensation.capsuleCapsule(a0: Vector3, a1: Vector3, ra: number, b0: Vector3, b1: Vector3, rb: number): (boolean, number, Vector3)
	local distSq, _, _, c1, c2 = LagCompensation.segmentSegment(a0, a1, b0, b1)
	local radius = ra + rb
	local distance = math.sqrt(distSq)
	local point = if distance &gt; EPSILON then c2 + (c1 - c2) * ((rb) / distance) else c2
	return distSq &lt;= radius * radius, distance - radius, point
end

local function pointBoxDistanceSq(localPoint: Vector3, half: Vector3): number
	local dx = math.max(math.abs(localPoint.X) - half.X, 0)
	local dy = math.max(math.abs(localPoint.Y) - half.Y, 0)
	local dz = math.max(math.abs(localPoint.Z) - half.Z, 0)
	return dx * dx + dy * dy + dz * dz
end

-- Segment-to-OBB distance. Distance to a convex set is convex along the segment, so a golden-section
-- search converges to the true minimum; 24 iterations resolve well below 1e-4 studs on weapon lengths.
function LagCompensation.segmentBoxDistance(p: Vector3, q: Vector3, box: CFrame, half: Vector3): (number, Vector3)
	local lp = box:PointToObjectSpace(p)
	local lq = box:PointToObjectSpace(q)
	local delta = lq - lp
	local low, high = 0, 1
	local x1 = high - GOLDEN * (high - low)
	local x2 = low + GOLDEN * (high - low)
	local f1 = pointBoxDistanceSq(lp + delta * x1, half)
	local f2 = pointBoxDistanceSq(lp + delta * x2, half)
	for _ = 1, 24 do
		if f1 &lt;= f2 then
			high = x2
			x2 = x1
			f2 = f1
			x1 = high - GOLDEN * (high - low)
			f1 = pointBoxDistanceSq(lp + delta * x1, half)
		else
			low = x1
			x1 = x2
			f1 = f2
			x2 = low + GOLDEN * (high - low)
			f2 = pointBoxDistanceSq(lp + delta * x2, half)
		end
	end
	local best = (low + high) * 0.5
	local bestSq = pointBoxDistanceSq(lp + delta * best, half)
	local startSq = pointBoxDistanceSq(lp, half)
	local endSq = pointBoxDistanceSq(lq, half)
	if startSq &lt; bestSq then
		best, bestSq = 0, startSq
	end
	if endSq &lt; bestSq then
		best, bestSq = 1, endSq
	end
	return math.sqrt(bestSq), p + (q - p) * best
end

local function sweepSteps(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, targetTravel: number): number
	local travel = math.max((curA - prevA).Magnitude, (curB - prevB).Magnitude) + targetTravel
	local spacing = math.max(radius, 0.25)
	return math.clamp(math.ceil(travel / spacing), 1, LagCompensation.MAX_SWEEP_STEPS)
end

-- Swept weapon capsule vs a target OBB moving from boxFrom to boxTo over the same interval.
function LagCompensation.sweptCapsuleVsBox(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, boxFrom: CFrame, boxTo: CFrame, half: Vector3): (boolean, number, Vector3)
	local steps = sweepSteps(prevA, prevB, curA, curB, radius, (boxTo.Position - boxFrom.Position).Magnitude)
	for step = 0, steps do
		local alpha = step / steps
		local a = prevA:Lerp(curA, alpha)
		local b = prevB:Lerp(curB, alpha)
		local box = if alpha &lt;= 0 then boxFrom elseif alpha &gt;= 1 then boxTo else boxFrom:Lerp(boxTo, alpha)
		local distance, point = LagCompensation.segmentBoxDistance(a, b, box, half)
		if distance &lt;= radius then
			return true, alpha, point
		end
	end
	return false, 1, curB
end

-- Swept weapon capsule vs a target capsule moving with its root between two poses.
function LagCompensation.sweptCapsuleVsCapsule(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, capsule: Capsule, rootFrom: CFrame, rootTo: CFrame): (boolean, number, Vector3, number)
	local steps = sweepSteps(prevA, prevB, curA, curB, radius, (rootTo.Position - rootFrom.Position).Magnitude)
	local closest = math.huge
	for step = 0, steps do
		local alpha = step / steps
		local a = prevA:Lerp(curA, alpha)
		local b = prevB:Lerp(curB, alpha)
		local root = if alpha &lt;= 0 then rootFrom elseif alpha &gt;= 1 then rootTo else rootFrom:Lerp(rootTo, alpha)
		local hit, gap, point = LagCompensation.capsuleCapsule(a, b, radius, root:PointToWorldSpace(capsule.A), root:PointToWorldSpace(capsule.B), capsule.Radius)
		closest = math.min(closest, gap)
		if hit then
			return true, alpha, point, gap
		end
	end
	return false, 1, curB, closest
end

-- Full query: swept-box broadphase then per-region swept capsules against the target rewound to
-- `rewindTo`. Returns the earliest-contact region (ties broken by deepest penetration).
function LagCompensation.queryHit(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, target: History, rewindTo: number, interval: number?): Hit?
	if target.Count == 0 then
		return nil
	end
	local span = interval or LagCompensation.TICK
	local rootTo = LagCompensation.samplePoseAt(target, rewindTo)
	local rootFrom = LagCompensation.samplePoseAt(target, rewindTo - span)
	if rootTo == nil or rootFrom == nil then
		return nil
	end
	local profile = target.Profile
	local reachSq = (profile.Reach + radius + (curB - curA).Magnitude + (curB - prevB).Magnitude) ^ 2
	local offset = rootTo.Position - curA
	if offset:Dot(offset) &gt; reachSq then
		return nil
	end
	local broad = LagCompensation.sweptCapsuleVsBox(prevA, prevB, curA, curB, radius, rootFrom * profile.BoxOffset, rootTo * profile.BoxOffset, profile.BoxHalfSize)
	if not broad then
		return nil
	end
	local bestRegion: string? = nil
	local bestFraction, bestGap = math.huge, math.huge
	local bestPoint = curB
	for _, capsule in profile.Capsules do
		local hit, fraction, point, gap = LagCompensation.sweptCapsuleVsCapsule(prevA, prevB, curA, curB, radius, capsule, rootFrom, rootTo)
		if hit and (fraction &lt; bestFraction - EPSILON or (math.abs(fraction - bestFraction) &lt;= EPSILON and gap &lt; bestGap)) then
			bestRegion, bestFraction, bestGap, bestPoint = capsule.Region, fraction, gap, point
		end
	end
	if bestRegion == nil then
		return nil
	end
	return { Region = bestRegion, Point = bestPoint, Fraction = bestFraction, Distance = bestGap }
end

return table.freeze(LagCompensation)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">LootService</string>
            <string name="Source">--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Catalog=require(Shared.Shared.ArsenalCatalog)
local World=require(Shared.Shared.WorldDefinitions)
local Protocol=require(Shared.Shared.ArsenalProtocol)
local Budget=require(Shared.Shared.IntentProtocol)
local Inventory=require(Shared.Simulation.ArsenalInventory)
local Weapons=require(Shared.Simulation.WeaponSchema)
local Characters=require(script.Parent.CharacterService)
local Persistence=require(script.Parent.PersistenceService) :: any
local Magic=require(script.Parent.MagicService)
local LootWorld=require(script.Parent.LootWorld)
local remote=Shared.Net:WaitForChild("ArsenalIntent") :: RemoteEvent
local Loot={}
local connections: {RBXScriptConnection}={}
local buckets: {[number]: Budget.Bucket}={}
local busy: {[number]: boolean}={}
local root: Folder?=nil
local function available(id: number): any
 local e=Characters.GetActor(id)
 return if e and e.Fighter.State=="Idle" and not e.Duel then e else nil
end
local function nearSmith(e: any): boolean
 local l=World.Sanctuary.Loggia
 return (e.Root.Position-Vector3.new(l.X+5,l.Y+3,l.Z)).Magnitude&lt;=16
end
function Loot.Sync(player: Player,open: boolean?)
 local p=Persistence.Get(player.UserId);if not p then return end
 local inventory=table.clone(p.souls.inventory);inventory.materials=table.clone(p.inventory.Materials)
 remote:FireClient(player,{action="State",inventory=inventory,cooldowns=Magic.Cooldowns(player.UserId),open=open or false})
end
-- Assert messages carry "Script:line: "; players see only the reason (F06: the toast showed the script path).
local function reason(err: any): string return (string.gsub(tostring(err),"^.-:%d+: ","")) end
local function transact(player: Player,mutate: (any)-&gt;())
 local id=player.UserId;if busy[id] then return end;busy[id]=true
 local ok,err=Persistence.Transaction(id,function(p: any) mutate(p.souls.inventory) end)
 busy[id]=nil
 if ok then Characters.RefreshProgression(id);Loot.Sync(player) end
 if player.Parent then remote:FireClient(player,{action="Result",ok=ok,message=if ok then "Arsenal updated" else reason(err)}) end
end
function Loot.Claim(player: Player,id: string)
 local c=Catalog.Caches[id];local e=available(player.UserId)
 if not c or not e or (e.Root.Position-Vector3.new(c.X,c.Y,c.Z)).Magnitude&gt;10 then return end
 transact(player,function(i: any)
  local live=available(player.UserId);assert(live and (live.Root.Position-Vector3.new(c.X,c.Y,c.Z)).Magnitude&lt;=10,"Too far from cache")
  local ok,reason=Inventory.claim(i,id);assert(ok,reason)
 end)
end
function Loot.Forge(player: Player,id: string)
 local e=available(player.UserId);if not e or not nearSmith(e) then remote:FireClient(player,{action="Result",ok=false,message="Visit Master Smith Gao in the Loggia"});return end
 transact(player,function(i: any)
  local live=available(player.UserId);assert(live and nearSmith(live),"Visit Master Smith Gao")
  local ok,reason=Inventory.forge(i,id);assert(ok,reason)
 end)
end
local function useTalisman(player: Player)
 local id=player.UserId;local e=available(id);if not e or busy[id] then return end;busy[id]=true
 local ok,err=Persistence.Transaction(id,function(p: any)
  assert(available(id)==e,"Cannot use a talisman now")
  local m=p.inventory.Materials;assert((m.LastBreathTalisman or 0)&gt;0,"No Last Breath Talisman")
  m.LastBreathTalisman-=1
 end)
 busy[id]=nil
 if ok and available(id)==e then e.Fighter.WardUntil=Characters.Now()+30 end
 Loot.Sync(player);remote:FireClient(player,{action="Result",ok=ok,message=if ok then "Last Breath · one fatal blow warded for 30s" else reason(err)})
end
local function handle(player: Player,packet: any)
 if not Protocol.valid(packet) or packet.action=="Cast" then return end
 local id=player.UserId;local now=Characters.Now();local bucket=buckets[id] or {tokens=5,time=now};buckets[id]=bucket
 if not Budget.Take(bucket,now,1,2,5) then return end
 if packet.action=="State" then Loot.Sync(player);return end
 if packet.action=="UseTalisman" then useTalisman(player);return end
 if packet.action=="Forge" then Loot.Forge(player,packet.id);return end
 if not available(id) then return end
 if packet.action=="EquipSpell" then
  transact(player,function(i: any)
   assert(available(id),"Cannot equip now");assert(i.spells[packet.id],"Spell is locked");i.spellSlots[packet.slot]=packet.id
  end)
 elseif packet.action=="EquipWeapon" then
  transact(player,function(i: any)
   assert(available(id),"Cannot equip now");assert(i.weapons[packet.id] and Weapons.Weapons[packet.id],"Weapon is locked")
   if packet.offhand then assert(packet.id=="Catalyst","Only catalysts may focus spells off-hand");i.offhand=packet.id else i.mainhand=packet.id end
  end)
  local p=Persistence.Get(id)
  if p and available(id) then Characters.EquipWeapon(id,p.souls.inventory.mainhand) end
 end
end
function Loot.Start()
 assert(not root,"LootService already started")
 local folder,links=LootWorld.build(Loot.Claim,function(player: Player) if available(player.UserId) then Loot.Sync(player,true) end end)
 root=folder;for _,c in links do table.insert(connections,c) end
 table.insert(connections,remote.OnServerEvent:Connect(handle))
 table.insert(connections,Players.PlayerRemoving:Connect(function(player: Player) buckets[player.UserId]=nil;busy[player.UserId]=nil end))
end
function Loot.Destroy()
 for _,c in connections do c:Disconnect() end
 table.clear(connections);table.clear(buckets);table.clear(busy)
 if root then root:Destroy();root=nil end
end
return Loot
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">LootWorld</string>
            <string name="Source">--!strict
local Workspace=game:GetService("Workspace")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Catalog=require(Shared.Shared.ArsenalCatalog)
local World=require(Shared.Shared.WorldDefinitions)
local InputMap=require(Shared.Shared.InputMap)
local LootWorld={}
local function part(parent: Instance,name: string,size: Vector3,position: Vector3): Part
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.Position=position;p.Anchored=true
 p.Material=Enum.Material.Slate;p.Color=Color3.fromRGB(54,60,58);p.Parent=parent
 return p
end
LootWorld.SealOffset=-10 -- studs along Z from the loggia centre (Gao stands at Z-1, facing +X)
function LootWorld.build(claim: (Player,string)-&gt;(),openSmith: (Player)-&gt;()): (Folder,{RBXScriptConnection})
 local root=Instance.new("Folder");root.Name="WorldDiscoveryCaches";root.Parent=Workspace
 local connections: {RBXScriptConnection}={}
 for id,c in Catalog.Caches do
  local position=Vector3.new(c.X,c.Y,c.Z)
  part(root,id.."Ledge",Vector3.new(8,1,8),position-Vector3.new(0,1.5,0))
  local chest=part(root,id,Vector3.new(3,1.8,2),position)
  chest.Material=Enum.Material.Metal;chest.Color=Color3.fromRGB(111,93,49)
  chest:SetAttribute("CacheId",id)
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Open Hidden Cache";prompt.ObjectText=c.Name
  prompt.HoldDuration=0.6;prompt.MaxActivationDistance=9;InputMap.applyPrompt(prompt)
  prompt.RequiresLineOfSight=true;prompt.Parent=chest
  table.insert(connections,prompt.Triggered:Connect(function(player: Player) claim(player,id) end))
  if id=="WaterfallAlcove" then
   local water=part(root,"SecretWaterfall",Vector3.new(12,25,0.5),position+Vector3.new(0,9,5))
   water.CanCollide=false;water.CanQuery=false;water.Transparency=0.65;water.Material=Enum.Material.Glass;water.Color=Color3.fromRGB(89,168,177)
   for _,side in {-1,1} do part(root,"AlcoveRock",Vector3.new(4,12,12),position+Vector3.new(side*6,3,0)) end
  elseif id=="PagodaRafters" or id=="SanctuaryEaves" then
   -- The ladder stands flush outside the ledge's south edge and ends at its top (batch 15, #44):
   -- it used to rise inside the 8x8 ledge, so a climber met the ledge's underside.
   local ground=if c.Region=="Sanctuary" then 600 else 0.2
   local floor=c.Y-1;local ladder=Instance.new("TrussPart");ladder.Name="HiddenRafterLadder";ladder.Size=Vector3.new(2,floor-ground,2)
   ladder.Position=Vector3.new(c.X,ground+(floor-ground)/2,c.Z-5);ladder.Anchored=true;ladder.Parent=root
   part(root,"RafterBeam",Vector3.new(14,0.8,1.5),position-Vector3.new(0,1.5,0))
  elseif id=="SealedMausoleum" then
   for _,side in {-1,1} do part(root,"MausoleumWall",Vector3.new(1,8,9),position+Vector3.new(side*5,2,0)) end
   part(root,"MausoleumRoof",Vector3.new(12,1,11),position+Vector3.new(0,6,0))
  end
 end
 -- Shrine caches (eaves deck, ladder, rafter, reliquary ledge) wear the lobby kit's timber.
 for _,d in root:GetDescendants() do
  if d:IsA("BasePart") and d.Material~=Enum.Material.Metal and d.Material~=Enum.Material.Neon and World.regionAt(d.Position.X,d.Position.Y,d.Position.Z)=="Sanctuary" then
   d.Material=Enum.Material.Wood;d.MaterialVariant="AsuraTimber";d.Color=Color3.fromRGB(255,255,255)
  end
 end
 local l=World.Sanctuary.Loggia
 -- Beside Gao, not in front of him (F13): at l.X+5 it stood where a player stops to talk, so its Z
 -- prompt always beat "Speak to Master Smith Gao" and his dialogue only opened from the side.
 local sealAt=Vector3.new(l.X,l.Y,l.Z+LootWorld.SealOffset)
 local smith=part(root,"TransmutationSeal",Vector3.new(2,2,2),sealAt+Vector3.new(0,3,0))
 -- Keep the original prompt/collision anchor, housed inside a carved smith's seal.
 smith.Material=Enum.Material.Slate;smith.MaterialVariant="AsuraStone";smith.Color=Color3.fromRGB(126,141,158)
 local styled,kit=pcall(function() return require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript) end)
 if styled then
  local base=CFrame.new(sealAt.X,l.Y+1,sealAt.Z)*CFrame.Angles(0,math.rad(90),0)
  local seal=kit.place(root,"Stele_Dragon",base,Vector3.new(0.55,0.5,0.55))
  if seal then smith.Transparency=1 end
  kit.slab(root,"SmithSealPlinth",Vector3.new(2.55,1,2.55),CFrame.new(sealAt.X,l.Y+0.5,sealAt.Z),"StoneDark",kit.decor())
 end
 local prompt=Instance.new("ProximityPrompt");prompt.Name="TransmutePrompt";prompt.ActionText="Transmute Remembrance"
 prompt.ObjectText="Master Smith Gao";InputMap.applyPrompt(prompt)
 prompt.MaxActivationDistance=12;prompt.HoldDuration=0.4;prompt.Parent=smith
 table.insert(connections,prompt.Triggered:Connect(openSmith))
 return root,connections
end
return table.freeze(LootWorld)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">MagicService</string>
            <string name="Source">--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Spells=require(Shared.Simulation.SpellSchema)
local Rules=require(Shared.Simulation.SpellRules)
local Protocol=require(Shared.Shared.ArsenalProtocol)
local Budget=require(Shared.Shared.IntentProtocol)
local Characters=require(script.Parent.CharacterService)
local Persistence=require(script.Parent.PersistenceService) :: any
local Effects=require(script.Parent.SpellEffects)
local remote=Shared.Net:WaitForChild("ArsenalIntent") :: RemoteEvent
local Magic={}
local pending: {[number]: {Cast: Rules.Cast,Actor: any,Fighter: any}}={}
local cooldowns: {[number]: {[string]: number}}={}
local buckets: {[number]: Budget.Bucket}={}
local connections: {RBXScriptConnection}={}
local disconnect: (() -&gt; ())?=nil
function Magic.Cast(userId: number,slot: number): (boolean,string)
 local actor=Characters.GetActor(userId);local profile=Persistence.Get(userId)
 if not actor or not profile or pending[userId] then return false,"Unavailable" end
 local inventory=profile.souls.inventory;local id=inventory.spellSlots[slot]
 if not id or not inventory.spells[id] then return false,"Spell is locked" end
 local cd=cooldowns[userId] or {};cooldowns[userId]=cd
 local cast,reason=Rules.begin(actor.Fighter,id,Characters.Now(),cd,inventory.offhand)
 if not cast then return false,reason end
 pending[userId]={Cast=cast,Actor=actor,Fighter=actor.Fighter}
 Characters.Cue("SpellStartup",userId,{spell=id,release=cast.Release,finish=cast.End,position=actor.Root.Position})
 remote:FireClient(actor.Player,{action="Cooldown",id=id,untilTime=cd[id]})
 return true,reason
end
function Magic.Cooldowns(userId: number): {[string]: number}
 return table.clone(cooldowns[userId] or {})
end
function Magic.ReleaseArt(actor: any,id: string,now: number)
 if Spells.get(id) then Effects.release(actor,id,1,now) end
end
function Magic.Start()
 assert(not disconnect,"MagicService already started")
 disconnect=Characters.OnStep(function(now: number,dt: number)
  for id,p in pending do
   if Characters.GetActor(id)~=p.Actor or p.Actor.Fighter~=p.Fighter or not Rules.valid(p.Fighter,p.Cast) then
    pending[id]=nil;Characters.Cue("SpellInterrupted",id,{spell=p.Cast.Id})
   elseif now&gt;=p.Cast.Release then pending[id]=nil;Effects.release(p.Actor,p.Cast.Id,p.Cast.Potency,now) end
  end
  Effects.step(now,dt)
 end)
 table.insert(connections,remote.OnServerEvent:Connect(function(player: Player,packet: any)
  if not Protocol.valid(packet) or packet.action~="Cast" then return end
  local now=Characters.Now();local bucket=buckets[player.UserId] or {tokens=4,time=now};buckets[player.UserId]=bucket
  if not Budget.Take(bucket,now,1,3,4) then return end
  local ok,reason=Magic.Cast(player.UserId,packet.slot)
  remote:FireClient(player,{action="Result",ok=ok,message=reason})
 end))
 table.insert(connections,Players.PlayerRemoving:Connect(function(player: Player)
  pending[player.UserId]=nil;cooldowns[player.UserId]=nil;buckets[player.UserId]=nil
 end))
end
function Magic.Destroy()
 if disconnect then disconnect();disconnect=nil end
 for _,c in connections do c:Disconnect() end
 table.clear(connections);table.clear(pending);table.clear(cooldowns);table.clear(buckets);Effects.clear()
end
return Magic
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">MatchJournal</string>
            <string name="Source">--!nonstrict
-- Durable immutable match results, discoverable through each participant's pre-start inbox.
local Journal={};Journal.__index=Journal
function Journal.new(store,retry,now) return setmetatable({store=store,retry=retry,now=now},Journal) end
function Journal:Create(id,players,owner)
 return self.retry(function()
  return self.store:UpdateAsync("Match_"..id,function(old)
   return old or {id=id,players=players,owner=owner,state="Active",expires=self.now()+1200}
  end)
 end)
end
function Journal:Finish(id,results)
 return self.retry(function()
  return self.store:UpdateAsync("Match_"..id,function(old)
   assert(old,"Missing match journal")
   if old.state~="Active" then return old end
   old.state=if results then "Complete" else "Cancelled";old.results=results
   return old
  end)
 end)
end
function Journal:Read(id)
 return self.retry(function()
  return self.store:UpdateAsync("Match_"..id,function(old)
   if old and old.state=="Active" and old.expires&lt;=self.now() then old.state="Cancelled" end
   return old
  end)
 end)
end
return Journal
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">MonasteryAtmosphere</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryAtmosphere
-- Mood layer for the Desecrated Monastery: banks of dawn mist (dense in the ravine), crimson leaf
-- litter drifted against stone, falling leaves, pale roots strangling the masonry and a sparse
-- string of warm lanterns marking the route from the gate to the cloister.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Grounds = require(script.Parent:WaitForChild("MonasteryGrounds") :: ModuleScript)

local Atmosphere = {}

local P = Kit.Palette
local G = Kit.GROUND

local function mists(parent: Instance)
	local group = Kit.folder("DawnMist", parent)
	-- Ground-hugging veils over each zone.
	Fx.mist(group, CFrame.new(0, G + 1.5, -722), Vector3.new(60, 2, 50), 0.6, 22)
	Fx.mist(group, CFrame.new(0, G + 2, -805), Vector3.new(160, 3, 100), 2.2, 30)
	Fx.mist(group, CFrame.new(0, G + 2, -900), Vector3.new(220, 3, 70), 1.8, 30)
	Fx.mist(group, CFrame.new(70, G + 2, -1052), Vector3.new(110, 3, 120), 1, 28)
	Fx.mist(group, CFrame.new(-75, G + 2, -1052), Vector3.new(110, 3, 120), 1.2, 32)
	-- The ravine breathes thick mist up around the bridge.
	for x = -110, 110, 44 do
		Fx.mist(group, CFrame.new(x, -8, Grounds.RAVINE_Z), Vector3.new(44, 6, 34), 1.8, 40, Color3.fromRGB(170, 166, 168))
	end
	-- Distant dawn haze over the valley walls and beyond the south road.
	for _, spot in { Vector3.new(-215, 34, -800), Vector3.new(215, 34, -800), Vector3.new(-215, 34, -1020), Vector3.new(215, 34, -1020), Vector3.new(0, 20, -1150) } do
		Fx.mist(group, CFrame.new(spot), Vector3.new(60, 20, 200), 0.8, 90)
	end
end

local DRIFTS = {
	-- {x, z, radius, count}: leaves pile against walls, columns and the dead tree.
	{ -58, -836, 12, 40 }, { -70, -756, 10, 18 }, { 60, -756, 10, 18 }, { -78, -812, 6, 14 }, { 78, -830, 6, 14 },
	{ 0, -852, 8, 16 }, { -44, -900, 8, 16 }, { 44, -905, 8, 16 }, { -12, -936, 4, 10 }, { 12, -986, 4, 10 },
	{ 66, -1048, 12, 36 }, { 24, -1100, 8, 14 }, { 118, -1000, 8, 14 }, { -50, -1030, 14, 24 }, { 0, -1110, 8, 14 },
}

local function litter(parent: Instance, rng: Random)
	local group = Kit.folder("LeafLitter", parent)
	for _, drift in DRIFTS do
		for _ = 1, drift[4] do
			local r = drift[3] * math.sqrt(rng:NextNumber()) ^ 1.5
			local a = rng:NextNumber(0, math.pi * 2)
			local color = P.Leaf:Lerp(P.LeafDark, rng:NextNumber()):Lerp(P.Rust, if rng:NextNumber() &lt; 0.2 then 0.6 else 0)
			Kit.part(group, "Leaf", Vector3.new(rng:NextNumber(0.5, 0.9), 0.05, rng:NextNumber(0.4, 0.7)),
				CFrame.new(drift[1] + math.cos(a) * r, G + rng:NextNumber(0.03, 0.12), drift[2] + math.sin(a) * r) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, math.pi * 2), 0),
				color, Enum.Material.Fabric, Kit.decor())
		end
	end
	for _, spot in { Vector3.new(-58, 20, -836), Vector3.new(66, 20, -1048), Vector3.new(0, 15, -800), Vector3.new(0, 13, -1060) } do
		local volume = Kit.hidden(group, "LeafFall", Vector3.new(if spot.Y &gt; 16 then 18 else 120, 2, if spot.Y &gt; 16 then 18 else 80), CFrame.new(spot))
		Fx.leaves(volume, if spot.Y &gt; 16 then 7 else 3)
	end
end

-- A pale root creeping over the ground from `start`, half-sunk, bending and thinning as it goes.
local function root(parent: Instance, start: Vector3, dir: Vector3, segments: number, radius: number, rng: Random)
	local at, heading, r = Vector3.new(start.X, G - radius * 0.3, start.Z), Vector3.new(dir.X, 0, dir.Z).Unit, radius
	for _ = 1, segments do
		local length = rng:NextNumber(2, 3.4)
		heading = (heading + Vector3.new(rng:NextNumber(-0.45, 0.45), 0, rng:NextNumber(-0.45, 0.45))).Unit
		local nextAt = Vector3.new(at.X, G - r * 0.3, at.Z) + heading * length
		Kit.part(parent, "Root", Vector3.new(length + r, r * 2, r * 2), CFrame.lookAt((at + nextAt) * 0.5, nextAt) * CFrame.Angles(0, math.pi / 2, 0),
			P.Root:Lerp(P.StoneDark, rng:NextNumber(0.25, 0.5)), Enum.Material.Wood, { Collide = false, Query = false, Shape = Enum.PartType.Cylinder })
		at, r = nextAt, math.max(0.12, r * 0.84)
	end
end

local ROOTS = {
	-- {start, direction}: creeping out from wall feet, idols, the tree and the ravine lips.
	{ Vector3.new(-80, 0, -780), Vector3.new(1, 0, 0.2) }, { Vector3.new(-80, 0, -830), Vector3.new(1, 0, -0.3) },
	{ Vector3.new(80, 0, -800), Vector3.new(-1, 0, 0.1) }, { Vector3.new(-40, 0, -754), Vector3.new(0.2, 0, -1) },
	{ Vector3.new(-100, 0, -890), Vector3.new(1, 0, 0.3) }, { Vector3.new(116, 0, -912), Vector3.new(-1, 0, -0.2) },
	{ Vector3.new(-30, 0, -935), Vector3.new(0.3, 0, 1) }, { Vector3.new(40, 0, -935), Vector3.new(-0.2, 0, 1) },
	{ Vector3.new(126, 0, -1040), Vector3.new(-1, 0, 0) }, { Vector3.new(80, 0, -1112), Vector3.new(0, 0, 1) },
	{ Vector3.new(-58, 0, -836), Vector3.new(1, 0, 0.6) }, { Vector3.new(66, 0, -1048), Vector3.new(-0.7, 0, 1) },
}

function Atmosphere.Build(parent: Instance, rng: Random)
	mists(parent)
	litter(parent, rng)
	local roots = Kit.folder("PaleRoots", parent)
	for _, spec in ROOTS do
		for strand = 1, 2 do
			root(roots, spec[1] + Vector3.new(0, 0, strand * 0.8), spec[2], 6 + strand * 2, 0.55 - strand * 0.1, rng)
		end
	end
	-- Sparse warm light along the route; most of the ruin stays in cold dawn shadow.
	local lamps = Kit.folder("RouteLanterns", parent)
	for _, spot in { Vector2.new(-16, -766), Vector2.new(16, -846), Vector2.new(-11, -870), Vector2.new(11, -926), Vector2.new(-10, -1000), Vector2.new(10, -1060) } do
		Fx.lantern(lamps, CFrame.new(spot.X, G, spot.Y), false, 20)
	end
end

return Atmosphere
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">MonasteryBounds</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryBounds
-- Traversal limits for the Desecrated Monastery (batch 07, findings #26/#27), decided per space so
-- double jump, bullet jump and Air Glide keep all of their reach inside the level:
--   * Intended: wall tops, roofs and rafters inside the valley (the High Pagoda Rafters cache is up
--     there), and gliding across the ravine instead of fighting the bridge swordsman.
--   * Resisted: leaving the valley over the ridges (there is no floor beyond them any more) and
--     climbing out of the ravine onto the far bank to skip the bridge.
-- The crest carries a tall invisible "mist veil" (collides, ignored by queries and cameras) that
-- follows the ridges, the east pass and the side plateau; the road south to the Bamboo Pass stays
-- open. Anyone who drops into the ravine is carried back to the north bridgehead by the mist.
local Players = game:GetService("Players")

local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Terrain = require(script.Parent:WaitForChild("MonasteryTerrain") :: ModuleScript)

local Bounds = {}

local V, P = Terrain.VALLEY_HALF, Terrain.PLATEAU
-- Crest polyline segments {x0, z0, x1, z1}; the south end (|x| &lt; 130 at z -1200) is the road out.
Bounds.Walls = {
	{ -V, -646, V, -646 }, -- north ridge
	{ -V, -646, -V, -1200 }, -- west ridge
	{ V, -646, V, P.Z0 }, -- east ridge north of the pass
	{ V, P.Z0, P.X1, P.Z0 }, { P.X1, P.Z0, P.X1, P.Z1 }, { P.X1, P.Z1, P.X0, P.Z1 }, -- side plateau
	{ P.X0, P.Z1, P.X0, -1200 }, -- east ridge south of the plateau
	{ -V, -1200, -130, -1200 }, { 130, -1200, P.X0, -1200 }, -- shoulders either side of the south road
} :: { { number } }
Bounds.HEIGHT, Bounds.THICK = 220, 4
Bounds.Ravine = { HalfX = 140, Z0 = Terrain.RAVINE_Z + 26, Z1 = Terrain.RAVINE_Z - 26, Below = Kit.GROUND - 4.5, Hold = 0.6 }
Bounds.Bridgehead = CFrame.new(0, 3, -926) -- facing -Z: back toward the bridge and its guardian

-- Pure: is this root position down in the ravine (below the banks, between its lips)?
function Bounds.inRavine(p: Vector3): boolean
	local r = Bounds.Ravine
	return math.abs(p.X) &lt; r.HalfX and p.Z &lt; r.Z0 and p.Z &gt; r.Z1 and p.Y &lt; r.Below
end

function Bounds.Build(parent: Instance)
	local group = Kit.folder("MistVeil", parent)
	for _, w in Bounds.Walls do
		local a, b = Vector3.new(w[1], 0, w[2]), Vector3.new(w[3], 0, w[4])
		local length = (b - a).Magnitude + Bounds.THICK
		local mid = (a + b) * 0.5 + Vector3.new(0, Bounds.HEIGHT * 0.5 - 40, 0)
		Kit.part(group, "Veil", Vector3.new(Bounds.THICK, Bounds.HEIGHT, length), CFrame.lookAt(mid, mid + (b - a)),
			Kit.Palette.Mist, Enum.Material.Slate, { Collide = true, Query = false, Transparency = 1, Shadow = false })
	end
end

local below: { [number]: number } = {}
local running = false

local function poll(dt: number)
	for _, player in Players:GetPlayers() do
		local id = player.UserId
		local e = Characters.GetEntity(id)
		if e and e.Fighter.State ~= "KO" and not e.Respawning and not Characters.IsInDuel(id) and Bounds.inRavine(e.Root.Position) then
			below[id] = (below[id] or 0) + dt
			if below[id] &gt;= Bounds.Ravine.Hold then
				below[id] = nil
				Characters.Teleport(id, Bounds.Bridgehead)
				Characters.Cue("RavineReturn", id, {})
			end
		else
			below[id] = nil
		end
	end
end

function Bounds.Start()
	if running then return end
	running = true
	task.spawn(function()
		while running do
			poll(task.wait(0.2))
		end
	end)
end

function Bounds.Stop()
	running = false
	table.clear(below)
end

return Bounds
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">MonasteryDressing</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryDressing
-- Places the uploaded PBR set pieces (ServerStorage.AsuraAssets) into the Desecrated Monastery:
-- iron gates hanging open in the gatehouse, dead sacred trees in the courtyard and cloister
-- garth, a fallen trunk in the ravine and pale roots clutching the shrines and idols. Textures
-- come from each MeshPart's SurfaceAppearance. Every placement is pcall-wrapped and returns false
-- when the asset folder is missing, so cosmetics can never stop the server from booting.
local ServerStorage = game:GetService("ServerStorage")

local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)

local Dressing = {}

local G = Kit.GROUND

local function try(label: string, fn: () -&gt; boolean): boolean
	local ok, placed = pcall(fn)
	if not ok then
		warn(string.format("[Asura's Path] Monastery dressing '%s' skipped: %s", label, tostring(placed)))
	end
	return ok and placed == true
end

local function asset(name: string): Model?
	local folder = ServerStorage:FindFirstChild("AsuraAssets")
	local found = folder and folder:FindFirstChild(name)
	return if found and found:IsA("Model") then found:Clone() else nil
end

local function settle(model: Model, collide: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, collide, collide, false, true
		end
	end
end

local function scaleTo(model: Model, axis: "X" | "Y" | "Z", target: number)
	local size = model:GetExtentsSize()
	local current = if axis == "X" then size.X elseif axis == "Y" then size.Y else size.Z
	if current &gt; 0 then
		model:ScaleTo(model:GetScale() * target / current)
	end
end

-- The gate leaves hang open inward, as if the monks fled and never closed them.
local function gates(parent: Instance): boolean
	local template = asset("AsuraIronGate")
	if not template then
		return false
	end
	scaleTo(template, "Y", 12.4)
	settle(template, false)
	for side = -1, 1, 2 do
		local gate = if side == 1 then template else template:Clone()
		local hinge = CFrame.new(side * 6.6, G, -753.5)
		gate:PivotTo(hinge * CFrame.Angles(0, math.rad(side * 62 + (if side == 1 then 180 else 0)), 0) * CFrame.new(side * 3, 0, 0))
		local box, extents = gate:GetBoundingBox()
		gate:PivotTo(gate:GetPivot() + Vector3.new(0, G - (box.Position.Y - extents.Y * 0.5), 0))
		gate.Parent = parent
	end
	return true
end

-- World-space bounds of a model's parts. GetExtentsSize measures in the pivot's own frame, which
-- for the trunk stood on end is its thickness, not its height.
local function worldBounds(model: Model): (Vector3, Vector3)
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			local cf, s = p.CFrame, p.Size / 2
			local ext = Vector3.new(
				math.abs(cf.RightVector.X) * s.X + math.abs(cf.UpVector.X) * s.Y + math.abs(cf.LookVector.X) * s.Z,
				math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z,
				math.abs(cf.RightVector.Z) * s.X + math.abs(cf.UpVector.Z) * s.Y + math.abs(cf.LookVector.Z) * s.Z)
			lo, hi = lo:Min(p.Position - ext), hi:Max(p.Position + ext)
		end
	end
	return lo, hi
end

-- Upright dead tree: the trunk asset (lying along its X) stood on end with a slight lean, `height`
-- studs tall in the world, its foot bedded 1.5 studs into the flagstones at `at`.
local function deadTree(parent: Instance, at: Vector3, height: number, lean: number): boolean
	local tree = asset("AsuraDeadTrunk")
	if not tree then
		return false
	end
	settle(tree, true)
	tree:PivotTo(CFrame.Angles(math.rad(lean), math.rad(lean * 7), math.rad(90)))
	local lo, hi = worldBounds(tree)
	if hi.Y &gt; lo.Y then
		tree:ScaleTo(tree:GetScale() * height / (hi.Y - lo.Y))
	end
	lo, hi = worldBounds(tree)
	local centre = (lo + hi) / 2
	tree:PivotTo(tree:GetPivot() + Vector3.new(at.X - centre.X, G - 1.5 - lo.Y, at.Z - centre.Z))
	tree.Parent = parent
	return true
end

local function fallenTrunk(parent: Instance, at: CFrame, length: number): boolean
	local log = asset("AsuraDeadTrunk")
	if not log then
		return false
	end
	scaleTo(log, "X", length)
	settle(log, true)
	log:PivotTo(at)
	log.Parent = parent
	return true
end

local function roots(parent: Instance, center: Vector3, reach: number, length: number, yaws: { number }): boolean
	local template = asset("AsuraRoots")
	if not template then
		return false
	end
	scaleTo(template, "X", length)
	settle(template, false)
	for index, yaw in yaws do
		local cluster = if index == 1 then template else template:Clone()
		local spot = CFrame.new(center.X, G, center.Z) * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.new(0, 0.4, -reach)
		cluster:PivotTo(spot * CFrame.Angles(math.rad(-6 - (index % 2) * 5), math.rad(90), 0))
		cluster.Parent = parent
	end
	return true
end

function Dressing.Build(parent: Instance): number
	local group = Kit.folder("SetPieces", parent)
	local placed = 0
	local jobs: { [string]: () -&gt; boolean } = {
		Gates = function() return gates(group) end,
		CourtyardTree = function() return deadTree(group, Vector3.new(-58, 0, -836), 26, 5) end,
		CloisterTree = function() return deadTree(group, Vector3.new(66, 0, -1048), 22, -4) end,
		RavineLog = function() return fallenTrunk(group, CFrame.new(-58, -9, -960) * CFrame.Angles(0.15, 0.4, 0.1), 30) end,
		GraveLog = function() return fallenTrunk(group, CFrame.new(-40, 1.2, -1086) * CFrame.Angles(0, 1.2, 0.05), 20) end,
		TreeRoots = function() return roots(group, Vector3.new(-58, 0, -836), 7, 14, { 30, 150, 260 }) end,
		CloisterRoots = function() return roots(group, Vector3.new(66, 0, -1048), 6, 12, { 80, 200, 320 }) end,
		GateShrineRoots = function() return roots(group, Vector3.new(0, 0, -716), 5, 10, { 20, 160 }) end,
		CloisterShrineRoots = function() return roots(group, Vector3.new(60, 0, -1006), 5, 10, { 200, 340 }) end,
	}
	for label, job in jobs do
		if try(label, job) then
			placed += 1
		end
	end
	return placed
end

return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">MonasteryFx</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryFx
-- Custom texture presets and bronze lantern light for the
-- Desecrated Monastery. Glow comes from translucent paper, PointLights and light-emitting
-- particles rather than Neon parts.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)

local Fx = {}

local P = Kit.Palette
local seq = Kit.sequence

-- Slow, wide banks of dawn mist that hug the ground inside a box volume.
function Fx.mist(parent: Instance, cframe: CFrame, size: Vector3, rate: number, scale: number, color: Color3?): ParticleEmitter
	local anchor = Kit.hidden(parent, "MistBank", size, cframe)
	local e = Instance.new("ParticleEmitter")
	e.Name = "DawnMist"
	e.Texture = Kit.Texture.Smoke
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Rate = rate
	e.Lifetime = NumberRange.new(14, 22)
	e.Speed = NumberRange.new(0.1, 0.6)
	e.Acceleration = Vector3.new(0.35, 0.04, -0.15)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-4, 4)
	e.Size = seq({ { 0, scale * 0.6 }, { 1, scale } })
	e.Transparency = seq({ { 0, 1 }, { 0.25, 0.72 }, { 0.75, 0.78 }, { 1, 1 } })
	e.Color = ColorSequence.new(color or P.Mist, P.Dawn)
	e.LightInfluence = 0.8
	e.Enabled = e.Texture ~= ""
	e.Parent = anchor
	return e
end

-- Crimson leaves drifting down from a volume (dead maples, wind over broken walls).
function Fx.leaves(parent: BasePart, rate: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = "CrimsonLeaves"
	e.Texture = Kit.Texture.Mote
	e.Shape = Enum.ParticleEmitterShape.Box
	e.Rate = rate
	e.Lifetime = NumberRange.new(7, 11)
	e.Speed = NumberRange.new(0.5, 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(1.1, -1.2, 0.5)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Squash = seq({ {0,0}, {0.3,0.45}, {0.6,-0.35}, {1,0} })
	e.Drag = 0.6
	e.Size = seq({ { 0, 0.32 }, { 1, 0.18 } })
	e.Transparency = seq({ { 0, 1 }, { 0.12, 0.1 }, { 0.85, 0.2 }, { 1, 1 } })
	e.Color = ColorSequence.new(P.Leaf, P.LeafDark)
	e.LightInfluence = 1
	e.Enabled = e.Texture ~= ""
	e.Parent = parent
	return e
end

-- Soft candle glow that sits inside translucent paper or a brazier bowl.
function Fx.glow(parent: BasePart, size: number)
	local e = Instance.new("ParticleEmitter")
	e.Name = "Glow"
	e.Texture = Kit.Texture.Fire
	e.LockedToPart = true
	e.Rate = 8
	e.Lifetime = NumberRange.new(0.6, 0.9)
	e.Speed = NumberRange.new(0, 0.2)
	e.Size = seq({ { 0, size }, { 1, size * 0.6 } })
	e.Transparency = seq({ { 0, 0.55 }, { 1, 1 } })
	e.Color = ColorSequence.new(Color3.fromRGB(255, 196, 120), Color3.fromRGB(255, 110, 40))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Enabled = e.Texture ~= ""
	e.Parent = parent
end

-- Rising embers over a brazier or censer.
function Fx.embers(parent: BasePart, rate: number)
	local e = Instance.new("ParticleEmitter")
	e.Name = "Embers"
	e.Texture = Kit.Texture.Sparks
	e.Rate = rate
	e.Lifetime = NumberRange.new(2, 3.5)
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(18, 18)
	e.Acceleration = Vector3.new(0.6, 2, 0.3)
	e.Drag = 0.7
	e.Size = seq({ { 0, 0.2 }, { 1, 0.04 } })
	e.Transparency = seq({ { 0, 0 }, { 0.8, 0.3 }, { 1, 1 } })
	e.Color = ColorSequence.new(Color3.fromRGB(255, 200, 110), Color3.fromRGB(255, 80, 30))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Enabled = e.Texture ~= ""
	e.Parent = parent
end

-- Stone (standing) or paper (hanging) lantern; the only warm light sources in the ruin.
function Fx.lantern(parent: Instance, base: CFrame, hanging: boolean?, range: number?)
	local group = Kit.folder("Lantern", parent)
	local y = if hanging then 0 else 3.4
	if not hanging then
		Kit.part(group, "Foot", Vector3.new(2.6, 0.4, 2.6), base * CFrame.new(0, 0.2, 0), P.StoneDark, Enum.Material.Slate)
		Kit.part(group, "Stem", Vector3.new(0.9, 2.4, 0.9), base * CFrame.new(0, 1.6, 0), P.Stone, Enum.Material.Slate)
		Kit.part(group, "Sill", Vector3.new(2, 0.3, 2), base * CFrame.new(0, y - 0.85, 0), P.StoneDark, Enum.Material.Slate, Kit.decor())
	else
		Kit.part(group, "Cord", Vector3.new(0.08, 3, 0.08), base * CFrame.new(0, 2.2, 0), P.Iron, Enum.Material.Metal, Kit.decor())
	end
	local paper = Kit.part(group, "Paper", Vector3.new(1.3, 1.5, 1.3), base * CFrame.new(0, y, 0), P.Lantern, Enum.Material.Glass,
		{ Collide = false, Query = false, Transparency = 0.25, Shadow = false })
	for x = -1, 1, 2 do
		for z = -1, 1, 2 do
			Kit.part(group, "Rib", Vector3.new(0.12, 1.7, 0.12), base * CFrame.new(x * 0.7, y, z * 0.7), P.WoodDark, Enum.Material.Wood, Kit.decor())
		end
	end
	Kit.part(group, "Cap", Vector3.new(2.2, 0.35, 2.2), base * CFrame.new(0, y + 0.95, 0), P.Iron, Enum.Material.Metal, Kit.decor())
	Fx.glow(paper, 1.1)
	Kit.light(paper, P.Lantern, range or 18, 1.3, true)
end

return Fx
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">MonasteryGrounds</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryGrounds
-- The ground of the Desecrated Monastery: laid flagstone courtyards over the MonasteryTerrain valley
-- (mud, moss, cliffs of dark rock and a misted ravine), and the stone bridge across the ravine.
-- Every walkable top sits at Kit.GROUND so WorldDefinitions placements (Y = 3) drop onto stone.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Terrain = require(script.Parent:WaitForChild("MonasteryTerrain") :: ModuleScript)

local Grounds = {}

local P = Kit.Palette
local G = Kit.GROUND

Grounds.RAVINE_Z = Terrain.RAVINE_Z
Grounds.BRIDGE = { Z0 = -932, Z1 = -988, Half = 10 }
Grounds.VALLEY_HALF, Grounds.PLATEAU, Grounds.EAST_PASS = Terrain.VALLEY_HALF, Terrain.PLATEAU, Terrain.EAST_PASS

-- Flagstone courtyards {x0, x1, z0, z1, tile, dark}: every spawn, patrol point and altar lies on one.
Grounds.Paving = {
	{ -26, 26, -698, -748, 7, false }, -- Gate landing
	{ -82, 82, -748, -858, 8, false }, -- Main courtyard
	{ -14, 14, -858, -932, 7, true }, -- Processional path between the halls
	{ -102, -38, -866, -934, 6, true }, -- West prayer hall
	{ 38, 118, -868, -934, 6, true }, -- East prayer hall
	{ -14, 14, -988, -1120, 7, false }, -- South road to the Bamboo Pass
	{ 14, 128, -990, -1114, 8, false }, -- Cloister garth and walks
}

local function pave(parent: Instance, spec: { any }, rng: Random)
	local x0, x1, z0, z1, tile, dark = spec[1] :: number, spec[2] :: number, spec[3] :: number, spec[4] :: number, spec[5] :: number, spec[6] :: boolean
	local light, deep = if dark then P.FlagDark else P.Flag, if dark then P.StoneDark else P.FlagDark
	local cols, rows = math.max(1, math.round((x1 - x0) / tile)), math.max(1, math.round(math.abs(z1 - z0) / tile))
	local w, d = (x1 - x0) / cols, (z1 - z0) / rows
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			-- A few stones are missing; the mud beneath is only 0.2 lower, so it never trips.
			if rng:NextNumber() &gt; 0.05 then
				local shade = light:Lerp(deep, rng:NextNumber() ^ 1.6):Lerp(P.Moss, if rng:NextNumber() &lt; 0.12 then 0.35 else 0)
				local material = if rng:NextNumber() &lt; 0.3 then Enum.Material.Cobblestone else Enum.Material.Slate
				Kit.part(parent, "Flagstone", Vector3.new(math.abs(w) - 0.18, 1.4, math.abs(d) - 0.18),
					CFrame.new(x0 + (i + 0.5) * w, G - 0.7, z0 + (j + 0.5) * d) * CFrame.Angles(0, math.rad(rng:NextNumber(-0.6, 0.6)), 0),
					shade, material)
			end
		end
	end
end

-- A stone beam bridge with ruined balustrades; the Cursed Swordsman guards its crown.
local function bridge(parent: Instance, rng: Random)
	local b = Grounds.BRIDGE
	local group = Kit.folder("RavineBridge", parent)
	local length = math.abs(b.Z1 - b.Z0)
	local mid = (b.Z0 + b.Z1) * 0.5
	for k = 0, 6 do
		local z = b.Z0 - (k + 0.5) * length / 7
		Kit.part(group, "Deck", Vector3.new(b.Half * 2, 1.6, length / 7 - 0.15), CFrame.new(0, G - 0.8, z),
			P.Flag:Lerp(P.StoneDark, rng:NextNumber(0, 0.5)), Enum.Material.Slate)
	end
	-- Batch 15 (#32): a wuxia granite beam bridge. Three stringers rest on two trestle piers with
	-- boat-prow cutwaters facing up and down the ravine, in place of the semicircular voussoir ring
	-- on square piers that read as a Roman aqueduct. Everything sits under the deck surface.
	for _, x in { -6.5, 0, 6.5 } do
		Kit.part(group, "Stringer", Vector3.new(2.4, 1.6, length + 6), CFrame.new(x, G - 2.4, mid), P.StoneDark, Enum.Material.Slate, Kit.decor())
	end
	for _, z in { mid + 14, mid - 14 } do
		Kit.part(group, "PierCap", Vector3.new(b.Half * 2 + 1, 1.2, 5.4), CFrame.new(0, G - 3.8, z), P.Stone:Lerp(P.StoneDark, 0.4), Enum.Material.Slate)
		Kit.part(group, "Trestle", Vector3.new(b.Half * 2 - 3, 12, 4), CFrame.new(0, G - 10.4, z), P.StoneDark:Lerp(P.Moss, 0.15), Enum.Material.Slate)
		for side = -1, 1, 2 do -- the prow: a square column turned 45 degrees at each end of the pier
			Kit.part(group, "Cutwater", Vector3.new(2.8, 12, 2.8), CFrame.new(side * (b.Half - 1.5), G - 10.4, z) * CFrame.Angles(0, math.rad(45), 0),
				P.StoneDark, Enum.Material.Slate)
		end
	end
	for side = -1, 1, 2 do
		for k = 0, math.floor(length / 4) do
			local z = b.Z0 - k * 4
			local broken = (side == -1 and z &lt; -940 and z &gt; -950) or (side == 1 and z &lt; -972 and z &gt; -982)
			if not broken then
				Kit.part(group, "Post", Vector3.new(0.9, 3.4, 0.9), CFrame.new(side * (b.Half - 0.45), G + 1.7, z), P.Stone, Enum.Material.Slate)
				Kit.part(group, "LotusCap", Vector3.new(1.15, 1.15, 1.15), CFrame.new(side * (b.Half - 0.45), G + 3.75, z), P.Stone:Lerp(P.Moss, 0.2), Enum.Material.Slate,
					{ Shape = Enum.PartType.Ball, Collide = false, Query = false })
				if k &lt; math.floor(length / 4) then
					Kit.part(group, "Rail", Vector3.new(0.6, 0.6, 4), CFrame.new(side * (b.Half - 0.45), G + 2.9, z - 2), P.StoneDark, Enum.Material.Slate)
				end
			elseif rng:NextNumber() &lt; 0.6 then
				Kit.part(group, "FallenRail", Vector3.new(0.6, 0.6, 3.6), CFrame.new(side * (b.Half - 1.6), G + 0.3, z - 1) *
					CFrame.Angles(0, math.rad(rng:NextNumber(-30, 30)), 0), P.StoneDark, Enum.Material.Slate, Kit.decor())
			end
		end
	end
end

Grounds.Extent, Grounds.Clear = Terrain.Extent, Terrain.Clear

function Grounds.Build(parent: Instance, rng: Random)
	Terrain.Build(rng)
	local floor = Kit.folder("Flagstones", parent)
	for _, spec in Grounds.Paving do
		pave(floor, spec, rng)
	end
	bridge(parent, rng)
end

return Grounds
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">MonasteryHalls</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryHalls
-- The two ruined prayer halls flanking the processional path and the desecrated cloister beyond
-- the ravine. Halls keep half a pagoda roof; the other half has slid off and leans against the
-- north colonnade. Column lines stay outside every patrol circle in WorldDefinitions.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Ruins = require(script.Parent:WaitForChild("MonasteryRuins") :: ModuleScript)

local Halls = {}

local P = Kit.Palette
local G = Kit.GROUND
local SLATE, WOOD, FABRIC = Enum.Material.Slate, Enum.Material.Wood, Enum.Material.Fabric
local COLUMN_HEIGHT = 14

local function column(parent: Instance, x: number, z: number, rng: Random, height: number?)
	local h = height or COLUMN_HEIGHT
	local broken = height == nil and rng:NextNumber() &lt; 0.22
	if broken then
		h = rng:NextNumber(3, 8)
	end
	Kit.disc(parent, "ColumnBase", 1.7, 1, CFrame.new(x, G + 0.5, z), P.StoneDark, SLATE)
	Kit.disc(parent, "Column", 1, h, CFrame.new(x, G + 1 + h * 0.5, z), P.Lacquer:Lerp(P.WoodDark, rng:NextNumber(0.35, 0.7)), WOOD)
	if broken then
		Kit.part(parent, "ColumnDrum", Vector3.new(2, 2, rng:NextNumber(4, 7)), CFrame.new(x + rng:NextNumber(-1, 1), G + 1, z + 3) *
			CFrame.Angles(0, rng:NextNumber(-0.5, 0.5), 0), P.Lacquer:Lerp(P.WoodDark, 0.6), WOOD, Kit.decor())
	else
		Kit.part(parent, "Bracket", Vector3.new(3, 1, 3), CFrame.new(x, G + h + 1.5, z), P.WoodDark, WOOD, Kit.decor())
	end
end

local function banner(parent: Instance, at: CFrame, rng: Random)
	local length = rng:NextNumber(6, 9)
	Kit.part(parent, "Banner", Vector3.new(2.4, length, 0.08), at * CFrame.new(0, -length * 0.5, 0) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.05, 0.05)),
		P.LeafDark:Lerp(P.WoodDark, rng:NextNumber(0, 0.4)), FABRIC, { Collide = false, Query = false })
end

-- side = -1 for the west hall (back wall at x0), +1 for the east hall (back wall at x1).
local function hall(parent: Instance, name: string, x0: number, x1: number, z0: number, z1: number, side: number, rng: Random)
	local group = Kit.folder(name, parent)
	local back, front = if side &lt; 0 then x0 else x1, if side &lt; 0 then x1 else x0
	local inward = -side -- direction from the back wall toward the path
	local zN, zS, zMid = z0 - 3, z1 + 3, (z0 + z1) * 0.5
	for x = back + inward * 4, front - inward * 2, inward * 8 do
		column(group, x, zN, rng)
		column(group, x, zS, rng)
	end
	for z = zN - 8, zS + 1, -8 do
		column(group, front - inward * 3, z, rng)
	end
	if side &lt; 0 then -- the west hall's back wall is breached where the waterfall path rejoins (z -876..-884)
		Ruins.wall(group, Vector2.new(back, z0), Vector2.new(back, -876), 13, rng, 0.08)
		Ruins.wall(group, Vector2.new(back, -884), Vector2.new(back, z1), 13, rng, 0.08)
	else
		Ruins.wall(group, Vector2.new(back, z0), Vector2.new(back, z1), 13, rng, 0.08)
	end
	Ruins.wall(group, Vector2.new(back, z0 - 0.5), Vector2.new(back + inward * 24, z0 - 0.5), 13, rng, 0.15)
	-- Half the roof survives over the back aisle...
	local width = math.abs(x1 - x0) * 0.5 + 2
	Ruins.roof(group, CFrame.new(back + inward * (width * 0.5 - 1), G + COLUMN_HEIGHT + 2, zMid), width, math.abs(z1 - z0) + 4, rng, true)
	-- ...the front half slid off and leans against the north colonnade, tiles shattered below.
	for k = 0, 2 do
		local xc = front - inward * (6 + k * 9)
		local top, foot = Vector3.new(xc, G + COLUMN_HEIGHT, zN - 1), Vector3.new(xc + rng:NextNumber(-1, 1), G + 0.6, zN + 9)
		Kit.part(group, "FallenRoof", Vector3.new(9.4, 0.6, (top - foot).Magnitude), CFrame.lookAt((top + foot) * 0.5, top) * CFrame.Angles(0, 0, rng:NextNumber(-0.06, 0.06)),
			P.Roof:Lerp(P.StoneDark, rng:NextNumber(0, 0.3)), SLATE)
	end
	for _ = 1, 26 do
		Kit.part(group, "Tile", Vector3.new(1.4, 0.18, 1), CFrame.new(front - inward * rng:NextNumber(2, 26), G + 0.09, zMid + rng:NextNumber(-30, 30)) *
			CFrame.Angles(0, rng:NextNumber(0, math.pi), rng:NextNumber(-0.1, 0.1)), P.Roof, SLATE, Kit.decor())
	end
	-- The defaced idol at the back: seated body, head struck off and lying at its feet.
	local idol = back + inward * 7
	Kit.part(group, "IdolDais", Vector3.new(7, 2, 9), CFrame.new(idol, G + 1, zMid), P.StoneDark, SLATE)
	Kit.part(group, "IdolBody", Vector3.new(4, 6, 5), CFrame.new(idol, G + 5, zMid), P.Stone:Lerp(P.Moss, 0.25), SLATE)
	Kit.part(group, "IdolHead", Vector3.new(2.2, 2.4, 2.2), CFrame.new(idol + inward * 5, G + 1.2, zMid + 3) * CFrame.Angles(0.4, 1.1, 1.3), P.Stone, SLATE)
	for dz = -1, 1, 2 do
		Fx.lantern(group, CFrame.new(idol + inward * 6, G, zMid + dz * 7), false, 16)
		banner(group, CFrame.new(front - inward * 3, G + COLUMN_HEIGHT, zMid + dz * 12), rng)
	end
	local motes = Kit.hidden(group, "Dust", Vector3.new(24, 10, 50), CFrame.new(back + inward * 14, G + 7, zMid))
	local dust = Fx.leaves(motes, 3)
	dust.Name = "DustMotes"
	dust.Color = ColorSequence.new(P.Dawn)
	dust.Acceleration = Vector3.new(0.2, -0.05, 0.1)
	dust.Size = Kit.sequence({ { 0, 0.12 }, { 1, 0.06 } })
end

-- Square cloister: outer wall, inner colonnade under lean-to eaves (some fallen), open garth.
local function cloister(parent: Instance, x0: number, x1: number, z0: number, z1: number, rng: Random)
	local group = Kit.folder("Cloister", parent)
	local walls = Kit.folder("CloisterWalls", group)
	Ruins.wall(walls, Vector2.new(x0, z0), Vector2.new(x1, z0), 10, rng, 0.12)
	Ruins.wall(walls, Vector2.new(x1, z0), Vector2.new(x1, z1), 10, rng, 0.1)
	Ruins.wall(walls, Vector2.new(x1, z1), Vector2.new(x0, z1), 10, rng, 0.15)
	Ruins.wall(walls, Vector2.new(x0, z1), Vector2.new(x0, -1034), 10, rng, 0.1) -- West gateway opens -990..-1034
	local cx0, cx1, cz0, cz1 = x0 + 8, x1 - 8, z0 - 8, z1 + 8
	local ring: { { Vector3 } } = {
		{ Vector3.new(cx0, 0, cz0), Vector3.new(cx1, 0, cz0), Vector3.new(0, 0, 8) },
		{ Vector3.new(cx1, 0, cz0), Vector3.new(cx1, 0, cz1), Vector3.new(-8, 0, 0) },
		{ Vector3.new(cx1, 0, cz1), Vector3.new(cx0, 0, cz1), Vector3.new(0, 0, -8) },
		{ Vector3.new(cx0, 0, cz1), Vector3.new(cx0, 0, cz0), Vector3.new(8, 0, 0) },
	}
	for _, edge in ring do
		local a, b, out = edge[1], edge[2], edge[3]
		local count = math.round((b - a).Magnitude / 12)
		for k = 0, count - 1 do
			local at = a:Lerp(b, k / count)
			-- The altar's pocket and its aisle to the west gateway stay open (Kit.keepClear).
			if not Kit.keepClear(at.X, at.Z, 1.7) then
				column(group, at.X, at.Z, rng, 8)
			end
			local mid = a:Lerp(b, (k + 0.5) / count)
			local low, high = mid + Vector3.new(0, G + 9.2, 0), mid + out + Vector3.new(0, G + 10.8, 0)
			if rng:NextNumber() &lt; 0.8 then
				Kit.part(group, "Eave", Vector3.new(12.4, 0.45, (high - low).Magnitude + 1.6), CFrame.lookAt((low + high) * 0.5, high), P.Roof:Lerp(P.StoneDark, rng:NextNumber(0, 0.3)), SLATE, Kit.decor())
			else
				local foot = mid + out * 0.4 + Vector3.new(0, G + 0.5, 0)
				Kit.part(group, "FallenEave", Vector3.new(12, 0.45, 10), CFrame.lookAt((foot + high) * 0.5, high), P.Roof, SLATE, Kit.decor())
			end
		end
	end
end

function Halls.Build(parent: Instance, rng: Random)
	hall(parent, "WestPrayerHall", -102, -38, -866, -934, -1, rng)
	hall(parent, "EastPrayerHall", 38, 118, -868, -936, 1, rng)
	cloister(parent, 14, 128, -990, -1114, rng)
end

return Halls
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">MonasteryKit</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryKit
-- Shared construction kit for the Desecrated Monastery map: palette, texture ids and part
-- builders. No Neon, no SmoothPlastic anywhere in the map (MonasteryFx supplies the glow).
local Kit = {}

-- Walkable flagstone top. Terrain sits flush at Y = 0 beneath, so stones always cover it.
Kit.GROUND = 0.2

Kit.Palette = {
	Flag = Color3.fromRGB(104, 100, 93),
	FlagDark = Color3.fromRGB(80, 77, 72),
	Stone = Color3.fromRGB(108, 104, 97),
	StoneDark = Color3.fromRGB(62, 61, 61),
	Moss = Color3.fromRGB(56, 62, 46),
	Iron = Color3.fromRGB(30, 29, 31),
	Rust = Color3.fromRGB(82, 48, 34),
	Wood = Color3.fromRGB(48, 36, 30),
	WoodDark = Color3.fromRGB(30, 24, 22),
	Lacquer = Color3.fromRGB(78, 24, 22),
	Roof = Color3.fromRGB(34, 36, 38),
	Root = Color3.fromRGB(198, 188, 168),
	Leaf = Color3.fromRGB(132, 22, 26),
	LeafDark = Color3.fromRGB(82, 14, 18),
	Lantern = Color3.fromRGB(240, 162, 86),
	Mist = Color3.fromRGB(196, 186, 180),
	Dawn = Color3.fromRGB(214, 176, 150),
}

local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
Kit.Texture = {
	Smoke = Assets.Textures.Smoke,
	Fire = Assets.Textures.Flame,
	Sparks = Assets.Textures.Ember,
	Mote = Assets.Textures.Leaf,
}

-- Rest pockets (batch 07): no solid piece stands within POCKET studs of a Monastery altar or within
-- AISLE studs of the straight walk from the altar to its Exit, so resting, the portrait camera and
-- leaving never meet a pillar. Builders that place columns or scatter ask Kit.keepClear first.
Kit.POCKET, Kit.AISLE = 12.5, 4
local World = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.WorldDefinitions)
function Kit.keepClear(x: number, z: number, margin: number?): boolean
	local m = margin or 0
	for _, altar in (World.Regions :: any).DesecratedMonastery.Altars do
		local ax, az = altar.Placement.X, altar.Placement.Z
		if math.sqrt((x - ax) ^ 2 + (z - az) ^ 2) &lt; Kit.POCKET + m then return true end
		local exit = altar.Exit
		if exit then
			local dx, dz = exit.X - ax, exit.Z - az
			local t = math.clamp(((x - ax) * dx + (z - az) * dz) / (dx * dx + dz * dz), 0, 1)
			if math.sqrt((x - ax - dx * t) ^ 2 + (z - az - dz * t) ^ 2) &lt; Kit.AISLE + m then return true end
		end
	end
	return false
end

export type PartOptions = { Collide: boolean?, Query: boolean?, Transparency: number?, Shadow: boolean?, Shape: Enum.PartType?, Class: string? }

function Kit.folder(name: string, parent: Instance): Folder
	local created = Instance.new("Folder")
	created.Name = name
	created.Parent = parent
	return created
end

function Kit.part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, options: PartOptions?): BasePart
	local o: PartOptions = options or {}
	local p = Instance.new((o.Class or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.CanCollide = if o.Collide == nil then true else o.Collide
	p.CanQuery = if o.Query == nil then p.CanCollide else o.Query
	p.Transparency = o.Transparency or 0
	p.CastShadow = if o.Shadow == nil then true else o.Shadow
	if o.Shape and p:IsA("Part") then
		p.Shape = o.Shape
	end
	p.Parent = parent
	return p
end

-- Upright cylinder centred on `center` (Roblox cylinders run along local X).
function Kit.disc(parent: Instance, name: string, radius: number, height: number, center: CFrame, color: Color3, material: Enum.Material, options: PartOptions?): BasePart
	local o: PartOptions = if options then table.clone(options) else {}
	o.Shape = Enum.PartType.Cylinder
	return Kit.part(parent, name, Vector3.new(height, radius * 2, radius * 2), center * CFrame.Angles(0, 0, math.rad(90)), color, material, o)
end

function Kit.decor(): PartOptions
	return { Collide = false, Query = false, Shadow = false }
end

-- Invisible emitter / anchor volume.
function Kit.hidden(parent: Instance, name: string, size: Vector3, cframe: CFrame): BasePart
	return Kit.part(parent, name, size, cframe, Kit.Palette.Stone, Enum.Material.Slate, { Collide = false, Query = false, Transparency = 1, Shadow = false })
end

function Kit.beam(parent: Instance, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3, material: Enum.Material?, collide: boolean?): BasePart
	return Kit.part(parent, name, Vector3.new(thickness, thickness, (b - a).Magnitude), CFrame.lookAt((a + b) * 0.5, b), color,
		material or Enum.Material.Wood, if collide then nil else Kit.decor())
end

function Kit.sequence(points: { { number } }): NumberSequence
	local keys = {}
	for _, point in points do
		table.insert(keys, NumberSequenceKeypoint.new(point[1], point[2]))
	end
	return NumberSequence.new(keys)
end

function Kit.light(parent: BasePart, color: Color3, range: number, brightness: number, shadows: boolean): PointLight
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness, l.Shadows = color, range, brightness, shadows
	l.Parent = parent
	return l
end

return Kit
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">MonasteryLandmarks</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryLandmarks
-- Set pieces that give each zone of the Desecrated Monastery a silhouette: the two rest shrines
-- (AltarAnchor_&lt;id&gt; parts receive WorldService's rest prompt), the gutted bell tower and its
-- fallen bronze bell, the cold iron cauldron, and the toppled pagoda among the grave stupas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("AsurasPath").Shared.WorldDefinitions)
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Ruins = require(script.Parent:WaitForChild("MonasteryRuins") :: ModuleScript)
local Zones = require(ReplicatedStorage:WaitForChild("AsurasPath").Shared.MonasteryZones)

local Landmarks = {}

local P = Kit.Palette
local G = Kit.GROUND
local SLATE, WOOD, CORRODED = Enum.Material.Slate, Enum.Material.Wood, Enum.Material.CorrodedMetal

-- Low stone shrine with an iron censer; its stele stands behind (+Z), away from the spawn point.
local function shrine(parent: Instance, altar: World.Altar)
	local group = Kit.folder("Shrine_" .. altar.Id, parent)
	local base = CFrame.new(altar.Placement.X, G, altar.Placement.Z)
	Kit.disc(group, "Step", 3.4, 0.5, base * CFrame.new(0, 0.25, 0), P.StoneDark, SLATE)
	Kit.part(group, "Pedestal", Vector3.new(2.6, 2, 2.6), base * CFrame.new(0, 1.5, 0), P.Stone:Lerp(P.Moss, 0.2), SLATE)
	Kit.disc(group, "Censer", 1.3, 0.9, base * CFrame.new(0, 2.95, 0), P.Iron, CORRODED)
	Kit.disc(group, "Ash", 1.05, 0.1, base * CFrame.new(0, 3.42, 0), Color3.fromRGB(70, 64, 60), Enum.Material.Sand, Kit.decor())
	for k = 0, 4 do
		local a = math.rad(k * 72)
		Kit.part(group, "Incense", Vector3.new(0.06, 1.3, 0.06), base * CFrame.new(math.cos(a) * 0.5, 4, math.sin(a) * 0.5) * CFrame.Angles(0.12, 0, 0.1), P.Wood, WOOD, Kit.decor())
	end
	local stele = Kit.part(group, "Stele", Vector3.new(3.4, 6, 0.9), base * CFrame.new(0, 3, 4.6) * CFrame.Angles(math.rad(-4), 0, math.rad(3)), P.StoneDark, SLATE)
	Kit.part(group, "SteleCap", Vector3.new(4.2, 0.7, 1.4), stele.CFrame * CFrame.new(0, 3.3, 0), P.Roof, SLATE, Kit.decor())
	local anchor = Kit.hidden(group, "AltarAnchor_" .. altar.Id, Vector3.new(1, 0.2, 1), base * CFrame.new(0, 3.6, 0))
	Fx.glow(anchor, 0.9)
	Fx.embers(anchor, 3)
	Kit.light(anchor, P.Lantern, 20, 1.6, true)
end

local function bellTower(parent: Instance, at: Vector3)
	local group = Kit.folder("BellTower", parent)
	local base = CFrame.new(at.X, G, at.Z)
	Kit.part(group, "Podium", Vector3.new(14, 3, 14), base * CFrame.new(0, 1.5, 0), P.StoneDark, Enum.Material.Cobblestone)
	for index, corner in { Vector2.new(-5, -5), Vector2.new(5, -5), Vector2.new(5, 5), Vector2.new(-5, 5) } do
		local h = ({ 16, 9, 5, 13 })[index]
		Kit.part(group, "Post", Vector3.new(1.6, h, 1.6), base * CFrame.new(corner.X, 3 + h * 0.5, corner.Y), P.Lacquer:Lerp(P.WoodDark, 0.55), WOOD)
	end
	Kit.beam(group, "HangingBeam", (base * CFrame.new(-5, 18.6, -5)).Position, (base * CFrame.new(4, 6, 6)).Position, 1.2, P.WoodDark, WOOD)
	Kit.part(group, "RoofShard", Vector3.new(12, 0.6, 9), base * CFrame.new(-1.5, 16, 0) * CFrame.Angles(math.rad(28), 0.2, math.rad(-14)), P.Roof, SLATE, Kit.decor())
	Fx.lantern(group, CFrame.new(at.X - 5, G + 13.4, at.Z - 6.4), true, 18)
end

-- The great bell lies on its side where it fell, its lip split open.
local function fallenBell(parent: Instance, at: Vector3)
	local group = Kit.folder("FallenBell", parent)
	local lie = CFrame.new(at.X, G + 3.6, at.Z) * CFrame.Angles(0, math.rad(35), 0)
	Kit.part(group, "Body", Vector3.new(7, 7, 7), lie, Color3.fromRGB(58, 52, 40), CORRODED, { Shape = Enum.PartType.Cylinder })
	Kit.part(group, "Lip", Vector3.new(1.2, 8.6, 8.6), lie * CFrame.new(3.6, -0.3, 0), Color3.fromRGB(70, 62, 44), CORRODED, { Shape = Enum.PartType.Cylinder })
	Kit.part(group, "Crown", Vector3.new(1.4, 3, 3), lie * CFrame.new(-4.1, 0, 0), P.Iron, CORRODED, { Shape = Enum.PartType.Cylinder })
	for k = 0, 3 do
		Kit.part(group, "Band", Vector3.new(0.3, 7.3, 7.3), lie * CFrame.new(-2.4 + k * 1.6, 0, 0), P.Rust, CORRODED, { Shape = Enum.PartType.Cylinder, Collide = false, Query = false })
	end
end

local function cauldron(parent: Instance, at: Vector3)
	local group = Kit.folder("IronCauldron", parent)
	local base = CFrame.new(at.X, G, at.Z)
	Kit.disc(group, "Plinth", 4.4, 0.8, base * CFrame.new(0, 0.4, 0), P.StoneDark, SLATE)
	for k = 0, 2 do
		local a = math.rad(k * 120)
		Kit.part(group, "Leg", Vector3.new(0.7, 2.4, 0.7), base * CFrame.new(math.cos(a) * 2.2, 2, math.sin(a) * 2.2), P.Iron, CORRODED)
	end
	Kit.disc(group, "Bowl", 3, 2.4, base * CFrame.new(0, 3.6, 0), P.Iron, CORRODED)
	Kit.disc(group, "Rim", 3.3, 0.35, base * CFrame.new(0, 4.9, 0), P.Rust, CORRODED, Kit.decor())
	local coals = Kit.disc(group, "Coals", 2.7, 0.12, base * CFrame.new(0, 4.82, 0), Color3.fromRGB(60, 34, 24), Enum.Material.Basalt, Kit.decor())
	Fx.glow(coals, 1.6)
	Fx.embers(coals, 5)
	Kit.light(coals, Color3.fromRGB(255, 140, 70), 22, 1.4, true)
end

-- First tier still stands; the three upper tiers fell west and lie broken in a line.
local function toppledPagoda(parent: Instance, at: Vector3, rng: Random)
	local group = Kit.folder("ToppledPagoda", parent)
	Kit.disc(group, "Platform", 11, 1.6, CFrame.new(at.X, 0.8, at.Z), P.StoneDark, SLATE)
	Kit.part(group, "Tier1", Vector3.new(11, 9, 11), CFrame.new(at.X, 6.1, at.Z), P.Stone:Lerp(P.Lacquer, 0.25), Enum.Material.Plaster)
	Ruins.roof(group, CFrame.new(at.X, 10.4, at.Z), 18, 18, rng, true)
	for tier = 2, 4 do
		local s = 11 - tier * 1.8
		local x = at.X - 6 - tier * 8.5
		local lie = CFrame.new(x, s * 0.5 - 0.4, at.Z + rng:NextNumber(-2, 2)) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), math.rad(90 + rng:NextNumber(-12, 12)))
		Kit.part(group, "Tier" .. tier, Vector3.new(s, s * 0.8, s), lie, P.Stone:Lerp(P.Lacquer, 0.2), Enum.Material.Plaster)
		Kit.part(group, "TierEave", Vector3.new(s + 5, 0.6, s + 5), lie * CFrame.new(0, s * 0.42, 0), P.Roof, SLATE, Kit.decor())
	end
	Kit.beam(group, "Spire", Vector3.new(at.X - 46, 1, at.Z), Vector3.new(at.X - 58, 2.4, at.Z + 4), 0.8, P.Iron, CORRODED, true)
end

local function stupa(parent: Instance, at: Vector3, rng: Random)
	local tilt = CFrame.new(at.X, G, at.Z) * CFrame.Angles(rng:NextNumber(-0.12, 0.12), rng:NextNumber(0, math.pi), rng:NextNumber(-0.12, 0.12))
	local s = rng:NextNumber(0.8, 1.3)
	Kit.part(parent, "StupaBase", Vector3.new(3 * s, 1.4 * s, 3 * s), tilt * CFrame.new(0, 0.7 * s, 0), P.StoneDark, SLATE)
	Kit.part(parent, "StupaDome", Vector3.new(2.6 * s, 2.6 * s, 2.6 * s), tilt * CFrame.new(0, 2.6 * s, 0), P.Stone:Lerp(P.Moss, rng:NextNumber(0, 0.5)), SLATE, { Shape = Enum.PartType.Ball })
	Kit.part(parent, "StupaSpire", Vector3.new(0.5 * s, 2.4 * s, 0.5 * s), tilt * CFrame.new(0, 4.8 * s, 0), P.Iron, CORRODED, Kit.decor())
end

function Landmarks.Build(parent: Instance, rng: Random)
	for _, altar in World.Regions.DesecratedMonastery.Altars do
		shrine(parent, altar)
	end
	bellTower(parent, Vector3.new(64, 0, -772))
	fallenBell(parent, Vector3.new(58, 0, -843))
	cauldron(parent, Vector3.new(0, 0, -836))
	toppledPagoda(parent, Vector3.new(-62, 0, -1052), rng)
	local graves = Kit.folder("GraveStupas", parent)
	for _ = 1, 12 do
		local spot = Vector3.new(rng:NextNumber(-130, -26), 0, rng:NextNumber(-998, -1108))
		if (spot - Vector3.new(-90, 0, -1052)).Magnitude &gt; 34 and Zones.distanceToPath(Zones.GravePath, spot.X, spot.Z) &gt; 5 then
			stupa(graves, spot, rng)
		end
	end
end

return Landmarks
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">MonasteryPockets</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryPockets
-- Batch 15 (#25, #32): rhythm, cover and storytelling along the walked route, in the established
-- ruin vocabulary (slate and lacquered timber, tiled roofs, moss wear). Each stop gets its own
-- silhouette: carved cloud pillars at the gate, toppled stone lanterns and a broken spirit screen
-- as courtyard cover, a stele avenue on the processional path, the seven-bowl table beside the
-- Feast inscription, a timber gateway and guardian lions at the bridge, and a dry "river of souls"
-- crossed by stepping stones in the cloister garth. The central lanes stay open.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Ruins = require(script.Parent:WaitForChild("MonasteryRuins") :: ModuleScript)

local Pockets = {}

local P = Kit.Palette
local G = Kit.GROUND
local SLATE, WOOD = Enum.Material.Slate, Enum.Material.Wood

-- Pillars of the gate approach: octagonal shaft, a cloud plate across it, a crouching beast on top.
local function cloudPillar(parent: Instance, x: number, z: number)
	local base = CFrame.new(x, G, z)
	Kit.disc(parent, "PillarPlinth", 2, 1.2, base * CFrame.new(0, 0.6, 0), P.StoneDark, SLATE)
	Kit.disc(parent, "CloudPillar", 0.9, 11, base * CFrame.new(0, 6.7, 0), P.Stone:Lerp(P.Moss, 0.2), SLATE)
	Kit.part(parent, "CloudPlate", Vector3.new(4.2, 0.9, 0.5), base * CFrame.new(0, 10, 0) * CFrame.Angles(0, math.rad(if x &gt; 0 then 90 else -90), 0), P.Stone, SLATE, Kit.decor())
	Kit.part(parent, "Beast", Vector3.new(1.6, 1.4, 1.6), base * CFrame.new(0, 12.9, 0), P.StoneDark, SLATE, { Shape = Enum.PartType.Ball, Collide = false, Query = false })
end

-- A stone lantern toppled where it stood: plinth upright, shaft and firebox lying beside it.
local function toppledLantern(parent: Instance, x: number, z: number, yaw: number)
	local base = CFrame.new(x, G, z) * CFrame.Angles(0, math.rad(yaw), 0)
	Kit.part(parent, "LanternPlinth", Vector3.new(3, 1.6, 3), base * CFrame.new(0, 0.8, 0), P.StoneDark, SLATE)
	Kit.part(parent, "LanternShaft", Vector3.new(1.6, 1.6, 6), base * CFrame.new(0, 0.8, -4.6) * CFrame.Angles(0, 0.15, 0), P.Stone:Lerp(P.Moss, 0.3), SLATE)
	Kit.part(parent, "Firebox", Vector3.new(2.6, 2.6, 2.6), base * CFrame.new(0.6, 1.3, -8.8) * CFrame.Angles(0.2, 0.5, 0.1), P.Stone, SLATE)
	Kit.part(parent, "LanternRoof", Vector3.new(3.8, 0.7, 3.8), base * CFrame.new(-1.4, 0.4, -11) * CFrame.Angles(0.3, 0.8, 0.2), P.Roof, SLATE, Kit.decor())
end

-- The fallen spirit screen: low broken halves of the courtyard's warding wall, waist-high cover.
local function spiritScreen(parent: Instance, x: number, z: number)
	Kit.part(parent, "ScreenHalf", Vector3.new(5.4, 4, 1.4), CFrame.new(x - 3, G + 2, z) * CFrame.Angles(0, 0.08, 0.04), P.Stone:Lerp(P.Dawn, 0.25), Enum.Material.Plaster)
	Kit.part(parent, "ScreenHalf", Vector3.new(4.6, 2.6, 1.4), CFrame.new(x + 2.6, G + 1.3, z - 0.6) * CFrame.Angles(0, -0.2, 0), P.Stone, Enum.Material.Plaster)
	Kit.part(parent, "ScreenCap", Vector3.new(5.6, 0.6, 2.2), CFrame.new(x + 4, G + 0.3, z + 2.6) * CFrame.Angles(0, 0.6, 0.1), P.Roof, SLATE)
end

-- "The bowls were set for seven" (Feast inscription): a long offering table, six bowls overturned.
local function feastTable(parent: Instance, at: Vector3)
	local group = Kit.folder("SevenBowls", parent)
	local base = CFrame.new(at.X, G, at.Z)
	Kit.part(group, "Table", Vector3.new(9, 0.6, 2.6), base * CFrame.new(0, 2.5, 0), P.StoneDark, SLATE)
	for _, x in { -3.8, 3.8 } do Kit.part(group, "TableLeg", Vector3.new(0.8, 2.2, 2), base * CFrame.new(x, 1.1, 0), P.StoneDark, SLATE) end
	for k = 0, 6 do
		local upright = k == 3
		Kit.part(group, "Bowl", Vector3.new(0.5, 0.9, 0.9), base * CFrame.new(-3.6 + k * 1.2, 3.05, 0) * CFrame.Angles(0, 0, math.rad(if upright then 90 else 90 + 70)),
			Color3.fromRGB(96, 74, 52), Enum.Material.Wood, { Shape = Enum.PartType.Cylinder, Collide = false, Query = false })
	end
end

local function stele(parent: Instance, x: number, z: number, height: number, fallen: boolean)
	local frame = if fallen then CFrame.new(x, G + 0.6, z) * CFrame.Angles(math.rad(90), 0.3, 0) else CFrame.new(x, G + height * 0.5, z) * CFrame.Angles(0, 0, math.rad(x * 0.2))
	Kit.part(parent, "Stele", Vector3.new(2.4, height, 0.8), frame, P.StoneDark:Lerp(P.Moss, 0.2), SLATE)
	if not fallen then Kit.part(parent, "SteleCap", Vector3.new(3, 0.6, 1.3), frame * CFrame.new(0, height * 0.5 + 0.3, 0), P.Roof, SLATE, Kit.decor()) end
end

-- Timber gateway over the north bridgehead and stone lions guarding the far end.
local function bridgeGate(parent: Instance)
	local group = Kit.folder("BridgeGateway", parent)
	for side = -1, 1, 2 do
		Kit.part(group, "GatePlinth", Vector3.new(2.8, 1, 2.8), CFrame.new(side * 12.5, G + 0.5, -928), P.StoneDark, SLATE)
		Kit.part(group, "GatePost", Vector3.new(1.8, 13, 1.8), CFrame.new(side * 12.5, G + 7.5, -928), P.Lacquer:Lerp(P.WoodDark, 0.45), WOOD)
		local lion = CFrame.new(side * 11.6, G, -993) * CFrame.Angles(0, if side &lt; 0 then math.rad(-15) else math.rad(15), 0)
		Kit.part(group, "LionPlinth", Vector3.new(2.6, 1.6, 3.6), lion * CFrame.new(0, 0.8, 0), P.StoneDark, SLATE)
		Kit.part(group, "LionBody", Vector3.new(2, 2.4, 2.8), lion * CFrame.new(0, 2.8, 0.3), P.Stone:Lerp(P.Moss, 0.25), SLATE)
		Kit.part(group, "LionHead", Vector3.new(1.9, 1.9, 1.9), lion * CFrame.new(0, 4.5, -0.9), P.Stone, SLATE, { Shape = Enum.PartType.Ball })
	end
	Kit.part(group, "Lintel", Vector3.new(28, 1.4, 1.6), CFrame.new(0, G + 13.4, -928), P.WoodDark, WOOD)
	Kit.part(group, "TieBeam", Vector3.new(24, 0.9, 1.2), CFrame.new(0, G + 10.8, -928), P.WoodDark, WOOD)
	local plaque = Kit.part(group, "Plaque", Vector3.new(7, 1.6, 0.3), CFrame.new(0, G + 12.1, -927.3) * CFrame.Angles(0, math.pi, 0), P.WoodDark, WOOD, Kit.decor())
	Ruins.inscription(plaque, "BRIDGE OF PARTING SOULS")
	Ruins.roof(group, CFrame.new(0, G + 14.2, -928) * CFrame.Angles(0, math.pi / 2, 0), 4.4, 30, Random.new(15), false)
	Fx.lantern(group, CFrame.new(-11, G + 10.2, -926.8), true, 18)
end

-- "A phantom stood at the river of souls": a dry stone channel across the garth, stepping stones.
local function soulRiver(parent: Instance)
	local group = Kit.folder("RiverOfSouls", parent)
	for side = -1, 1, 2 do
		Kit.part(group, "Curb", Vector3.new(56, 0.35, 0.8), CFrame.new(72, G + 0.17, -1079 + side * 3), P.StoneDark, SLATE, Kit.decor())
	end
	Kit.part(group, "Riverbed", Vector3.new(56, 0.06, 5.2), CFrame.new(72, G + 0.03, -1079), Color3.fromRGB(46, 50, 54), Enum.Material.Pebble, Kit.decor())
	for k = -1, 1 do Kit.disc(group, "SteppingStone", 1.2, 0.4, CFrame.new(72 + k * 1.6, G + 0.2, -1079 + k * 1.1), P.Flag, SLATE, Kit.decor()) end
end

function Pockets.Build(parent: Instance, _rng: Random)
	local group = Kit.folder("RoutePockets", parent)
	for _, x in { -22, 22 } do cloudPillar(group, x, -744) end
	toppledLantern(group, -30, -806, 20)
	toppledLantern(group, 32, -812, -160)
	spiritScreen(group, -24, -832)
	feastTable(group, Vector3.new(48, 0, -838))
	for index, z in { -870, -890, -910 } do
		stele(group, -11, z, ({ 6, 3.2, 5.2 })[index], index == 2)
		stele(group, 11, z - 6, ({ 4.4, 6, 2.6 })[index], index == 3)
	end
	bridgeGate(group)
	soulRiver(group)
end

return Pockets
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">MonasteryRuins</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryRuins
-- Masonry of the Desecrated Monastery: crumbling enclosure walls with tiled coping, the pagoda
-- roof builder shared by every building, the lacquered gatehouse the player arrives beneath, the
-- ravine parapets and the south exit gate toward the Bamboo Pass.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)

local Ruins = {}

local P = Kit.Palette
local G = Kit.GROUND
local SLATE, COBBLE, WOOD, METAL = Enum.Material.Slate, Enum.Material.Cobblestone, Enum.Material.Wood, Enum.Material.Metal

local function rubble(parent: Instance, at: Vector3, rng: Random, count: number)
	for _ = 1, count do
		local s = rng:NextNumber(0.8, 2.2)
		Kit.part(parent, "Rubble", Vector3.new(s * 1.4, s * 0.7, s), CFrame.new(at + Vector3.new(rng:NextNumber(-3, 3), G + s * 0.3, rng:NextNumber(-3, 3)))
			* CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi), rng:NextNumber(-0.4, 0.4)), P.Stone:Lerp(P.Moss, rng:NextNumber(0, 0.4)), COBBLE)
	end
end

-- Wall from a to b (XZ plane) built in ~6-stud courses: some crumble, some are breached.
function Ruins.wall(parent: Instance, a: Vector2, b: Vector2, height: number, rng: Random, breach: number?, coping: boolean?)
	local group = Kit.folder("Wall", parent)
	local delta = b - a
	local count = math.max(1, math.round(delta.Magnitude / 6))
	local seg = delta.Magnitude / count
	local dir = Vector3.new(delta.Unit.X, 0, delta.Unit.Y)
	for k = 0, count - 1 do
		local c = Vector3.new(a.X, 0, a.Y) + dir * (k + 0.5) * seg
		local frame = CFrame.lookAt(c, c + dir)
		if rng:NextNumber() &lt; (breach or 0.1) then
			rubble(group, c, rng, 4)
			continue
		end
		local crumbled = rng:NextNumber() &lt; 0.35
		local h = if crumbled then height * rng:NextNumber(0.4, 0.85) else height
		Kit.part(group, "Plinth", Vector3.new(3.2, 1.4, seg + 0.05), frame * CFrame.new(0, G + 0.7, 0), P.StoneDark, SLATE)
		Kit.part(group, "Course", Vector3.new(2.4, h - 1.4, seg + 0.02), frame * CFrame.new(0, G + 1.4 + (h - 1.4) * 0.5, 0),
			P.Stone:Lerp(P.Moss, rng:NextNumber(0, 0.3)):Lerp(P.StoneDark, rng:NextNumber(0, 0.4)), COBBLE)
		if coping ~= false and not crumbled then
			Kit.part(group, "Coping", Vector3.new(4, 0.5, seg + 0.3), frame * CFrame.new(0, G + h + 0.25, 0), P.Roof, SLATE)
			Kit.part(group, "CopingRidge", Vector3.new(0.7, 0.5, seg + 0.3), frame * CFrame.new(0, G + h + 0.7, 0), P.Iron, SLATE, Kit.decor())
		elseif crumbled then
			rubble(group, c + frame.RightVector * (if rng:NextNumber() &lt; 0.5 then 3 else -3), rng, 2)
		end
	end
	return group
end

-- Curved two-slope tiled roof. `base` sits at eave height, ridge along local Z; `broken` roofs
-- shed tile courses and show their rafters.
function Ruins.roof(parent: Instance, base: CFrame, width: number, depth: number, rng: Random, broken: boolean?)
	local group = Kit.folder("PagodaRoof", parent)
	local half, rise = width * 0.5, width * 0.22
	local function height(t: number): number
		return rise * (1 - t) ^ 1.35 + rise * 0.4 * t ^ 7
	end
	for side = -1, 1, 2 do
		for strip = 0, 5 do
			local t0, t1 = strip / 6, (strip + 1) / 6
			local x0, x1, y0, y1 = side * half * t0, side * half * t1, height(t0), height(t1)
			local frame = base * CFrame.new((x0 + x1) * 0.5, (y0 + y1) * 0.5, 0) * CFrame.Angles(0, 0, math.atan((y1 - y0) / (x1 - x0)))
			local length = math.sqrt((x1 - x0) ^ 2 + (y1 - y0) ^ 2)
			if broken and strip &gt; 0 and strip &lt; 5 and rng:NextNumber() &lt; 0.3 then
				for z = -depth * 0.4, depth * 0.4, depth * 0.2 do
					Kit.part(group, "Rafter", Vector3.new(length + 0.4, 0.35, 0.35), frame * CFrame.new(0, -0.2, z), P.WoodDark, WOOD, Kit.decor())
				end
			else
				Kit.part(group, "Tiles", Vector3.new(length + 0.12, 0.4, depth), frame, P.Roof:Lerp(P.StoneDark, if strip % 2 == 0 then 0.1 else 0.3), SLATE, Kit.decor())
			end
		end
		for face = -1, 1, 2 do
			Kit.beam(group, "EaveHorn", (base * CFrame.new(side * (half - 1.5), height(0.9), face * depth * 0.5)).Position,
				(base * CFrame.new(side * (half + 1.4), height(1) + 1.8, face * (depth * 0.5 + 0.6))).Position, 0.4, P.Iron, METAL)
		end
	end
	Kit.part(group, "Ridge", Vector3.new(0.7, 0.7, depth + 1.5), base * CFrame.new(0, rise + 0.3, 0), P.Iron, METAL, Kit.decor())
	return group
end

function Ruins.inscription(parent: BasePart, text: string)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(150, 128, 92)
	label.TextScaled = true
	label.Font = Enum.Font.Antique
	label.Parent = gui
	gui.Parent = parent
end

-- Three-bay lacquered gatehouse; side bays are walled up so the centre bay frames the courtyard.
local function gatehouse(parent: Instance, z: number, rng: Random)
	local g = Kit.folder("Gatehouse", parent)
	for _, x in { -19, -8, 8, 19 } do
		Kit.part(g, "PillarBase", Vector3.new(3.6, 1.2, 3.6), CFrame.new(x, G + 0.6, z), P.StoneDark, SLATE)
		Kit.part(g, "Pillar", Vector3.new(2.4, 17, 2.4), CFrame.new(x, G + 9.7, z), P.Lacquer:Lerp(P.WoodDark, 0.4), WOOD)
	end
	Kit.part(g, "Lintel", Vector3.new(46, 1.8, 2.8), CFrame.new(0, G + 18.1, z), P.WoodDark, WOOD)
	Kit.part(g, "TieBeam", Vector3.new(18, 1.2, 2.2), CFrame.new(0, G + 13.2, z), P.WoodDark, WOOD)
	local plaque = Kit.part(g, "Plaque", Vector3.new(6, 2.6, 0.4), CFrame.new(0, G + 15.6, z + 1.3) * CFrame.Angles(0, math.pi, 0), P.WoodDark, WOOD)
	Ruins.inscription(plaque, "ANCIENT TEMPLE")
	Ruins.roof(g, CFrame.new(0, G + 19, z) * CFrame.Angles(0, math.pi / 2, 0), 11, 50, rng, true)
	for side = -1, 1, 2 do
		Kit.part(g, "BayWall", Vector3.new(8.6, 7, 2.2), CFrame.new(side * 13.5, G + 3.5, z), P.Stone, COBBLE)
		Fx.lantern(g, CFrame.new(side * 5, G + 10.6, z + 1.8), true, 22)
	end
end

function Ruins.Build(parent: Instance, rng: Random)
	local walls = Kit.folder("Walls", parent)
	local function run(x0: number, z0: number, x1: number, z1: number, h: number, breach: number?, coping: boolean?)
		Ruins.wall(walls, Vector2.new(x0, z0), Vector2.new(x1, z1), h, rng, breach, coping)
	end
	-- Courtyard enclosure (north wall meets the gatehouse, south wall opens on the processional path).
	run(-82, -752, -21, -752, 12)
	run(21, -752, 82, -752, 12)
	run(-82, -752, -82, -826, 12, 0.12) -- the west postern (z -826..-834) opens on the waterfall path
	run(-82, -834, -82, -858, 12, 0.12)
	-- East wall opens (z -800..-822) on the road through the ridge pass to the Twins' side plateau.
	run(82, -752, 82, -800, 12, 0.12)
	run(82, -822, 82, -858, 12, 0.12)
	run(-82, -858, -16, -858, 8, 0.25)
	run(16, -858, 82, -858, 8, 0.25)
	run(-26, -698, -26, -748, 3.2, 0.15, false) -- arrival landing parapets
	run(26, -698, 26, -748, 3.2, 0.15, false)
	run(-26, -698, 26, -698, 3.2, 0.2, false)
	-- Ravine lips, broken where the ground slumped.
	run(-120, -937, -12, -937, 3, 0.3, false)
	run(12, -937, 124, -937, 3, 0.3, false)
	run(-120, -986, -12, -986, 3, 0.3, false)
	gatehouse(parent, -752, rng)
	-- South exit: two leaning pillars and a fallen lintel where the road leaves for the Bamboo Pass.
	local exit = Kit.folder("SouthGate", parent)
	for side = -1, 1, 2 do
		Kit.part(exit, "Pillar", Vector3.new(2.4, 14, 2.4), CFrame.new(side * 11, G + 7, -1114) * CFrame.Angles(0, 0, math.rad(side * 3)), P.Lacquer:Lerp(P.WoodDark, 0.5), WOOD)
		Fx.lantern(exit, CFrame.new(side * 15, G, -1110), false, 20)
	end
	Kit.part(exit, "FallenLintel", Vector3.new(26, 1.6, 2.4), CFrame.new(-19, G + 0.6, -1100) * CFrame.Angles(0, math.rad(84), math.rad(4)), P.WoodDark, WOOD)
end

return Ruins
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">MonasterySecrets</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasterySecrets
-- The optional discoveries of the Desecrated Monastery made into places (batch 15, #26, #44).
-- The once-empty strip west of the courtyard becomes the secret waterfall path: a postern in the
-- courtyard wall, stepping slabs and prayer-ribbon posts, a cliff that the waterfall pours from with
-- the cache behind the curtain, and a return through the breached back wall of the west prayer
-- hall (a bypass of the courtyard's south). The high rafter cache gets the drum tower it is named
-- for, its ladder outside the loft floor; the mausoleum gets a broken seal and a walk through the
-- graves. Chests, ledges and the ladder themselves are LootWorld's; this layer only stages them.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared
local Zones = require(Shared.MonasteryZones)
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Ruins = require(script.Parent:WaitForChild("MonasteryRuins") :: ModuleScript)

local Secrets = {}

local P = Kit.Palette
local G = Kit.GROUND
local SLATE, WOOD, FABRIC, BASALT = Enum.Material.Slate, Enum.Material.Wood, Enum.Material.Fabric, Enum.Material.Basalt
Secrets.Tower = { X = 92, Z = -1000, Floor = 29, Half = 4 } -- PagodaRafters loft (ArsenalCatalog cache)

-- Flat slabs along a polyline, tops at ground level; every `ribbons`-th turn gets a ribbon post.
local function walk(parent: Instance, path: { { number } }, rng: Random, ribbons: number?)
	for k = 1, #path - 1 do
		local a, b = Vector3.new(path[k][1], G, path[k][2]), Vector3.new(path[k + 1][1], G, path[k + 1][2])
		local steps = math.max(1, math.floor((b - a).Magnitude / 3.2))
		for s = 0, steps - 1 do
			local at = a:Lerp(b, (s + 0.5) / steps)
			Kit.part(parent, "PathSlab", Vector3.new(rng:NextNumber(2.4, 3), 0.5, rng:NextNumber(1.8, 2.3)),
				CFrame.lookAt(at, b) * CFrame.new(0, -0.25, 0) * CFrame.Angles(0, rng:NextNumber(-0.25, 0.25), 0), P.Flag:Lerp(P.Moss, rng:NextNumber(0.1, 0.4)), SLATE)
		end
		if ribbons and k % ribbons == 0 then
			local post = Kit.part(parent, "RibbonPost", Vector3.new(0.4, 4.6, 0.4), CFrame.new(b + Vector3.new(2.2, 2.3, 0)), P.WoodDark, WOOD)
			Kit.part(parent, "PrayerRibbon", Vector3.new(0.08, 2.2, 0.5), post.CFrame * CFrame.new(0.2, 1, 0) * CFrame.Angles(0, 0, 0.2), P.Leaf, FABRIC, Kit.decor())
		end
	end
end

local function postern(parent: Instance)
	local group = Kit.folder("WestPostern", parent)
	for _, z in { -825.6, -834.4 } do
		Kit.part(group, "PosternPost", Vector3.new(1.4, 9, 1.4), CFrame.new(-82, G + 4.5, z), P.Lacquer:Lerp(P.WoodDark, 0.5), WOOD)
	end
	Kit.part(group, "PosternLintel", Vector3.new(1.6, 1, 10.4), CFrame.new(-82, G + 9.4, -830), P.WoodDark, WOOD)
	Kit.part(group, "FallenDoor", Vector3.new(3.6, 0.4, 7.4), CFrame.new(-87.5, G + 0.2, -823.5) * CFrame.Angles(0, 0.35, 0.05), P.WoodDark, WOOD)
	Fx.lantern(group, CFrame.new(-87, G, -836), false, 14)
end

-- Rock walls close the alcove on three sides; the waterfall (LootWorld) pours from the lip.
local function alcove(parent: Instance)
	local group = Kit.folder("WaterfallCliff", parent)
	local c = Zones.Alcove
	Kit.part(group, "CliffBack", Vector3.new(18, 30, 3), CFrame.new(c.X, G + 15, c.Z - 7.5), P.StoneDark, BASALT)
	for _, x in { -8, 8 } do
		Kit.part(group, "CliffShoulder", Vector3.new(3, 28, 7), CFrame.new(c.X + x, G + 14, c.Z - 2), P.StoneDark:Lerp(P.Moss, 0.2), BASALT)
	end
	Kit.part(group, "CliffLip", Vector3.new(18, 3, 7), CFrame.new(c.X, G + 28, c.Z + 2), P.StoneDark, BASALT)
	Kit.part(group, "PlungePool", Vector3.new(13, 0.1, 6), CFrame.new(c.X, G + 0.06, c.Z + 9), Color3.fromRGB(70, 132, 140), Enum.Material.Glass,
		{ Collide = false, Query = false, Transparency = 0.35 })
end

-- Timber drum tower whose loft floor is the PagodaRafters ledge; the ladder rises on its south face.
local function drumTower(parent: Instance, rng: Random)
	local group = Kit.folder("DrumTower", parent)
	local t = Secrets.Tower
	local top = t.Floor + 6.5
	for _, x in { -t.Half, t.Half } do
		for _, z in { -t.Half, t.Half } do
			Kit.part(group, "TowerPost", Vector3.new(1.2, top - G, 1.2), CFrame.new(t.X + x, (top + G) * 0.5, t.Z + z), P.Lacquer:Lerp(P.WoodDark, 0.5), WOOD)
		end
	end
	for _, y in { 10, 20 } do
		for _, z in { -t.Half, t.Half } do
			Kit.part(group, "Brace", Vector3.new(t.Half * 2, 0.6, 0.6), CFrame.new(t.X, G + y, t.Z + z), P.WoodDark, WOOD, Kit.decor())
		end
	end
	for _, edge in { { 0, t.Half }, { -t.Half, 0 }, { t.Half, 0 } } do -- loft rails; the ladder (south) side stays open
		local along = edge[1] == 0
		Kit.part(group, "LoftRail", Vector3.new(if along then t.Half * 2 else 0.4, 0.4, if along then 0.4 else t.Half * 2), CFrame.new(t.X + edge[1], t.Floor + 2.4, t.Z + edge[2]), P.WoodDark, WOOD, Kit.decor())
	end
	Ruins.roof(group, CFrame.new(t.X, top, t.Z), 13, 13, rng, true)
	Fx.lantern(group, CFrame.new(t.X - t.Half, t.Floor + 4.5, t.Z - t.Half - 0.6), true, 16)
end

local function mausoleum(parent: Instance, rng: Random)
	local group = Kit.folder("MausoleumSeal", parent)
	Kit.part(group, "BrokenSeal", Vector3.new(6, 0.5, 4.2), CFrame.new(-110, G + 0.25, -1067.2) * CFrame.Angles(0, 0.12, 0.03), P.StoneDark, SLATE)
	for _, x in { -115.6, -104.4 } do
		Kit.part(group, "SealTalisman", Vector3.new(0.06, 1.6, 0.7), CFrame.new(x, G + 4, -1064.6), Color3.fromRGB(214, 190, 120), FABRIC, Kit.decor())
	end
	Fx.lantern(group, CFrame.new(-102, G, -1070), false, 14)
	walk(group, Zones.GravePath, rng, nil)
end

function Secrets.Build(parent: Instance, rng: Random)
	local group = Kit.folder("Secrets", parent)
	postern(group)
	walk(Kit.folder("WaterfallPath", group), Zones.WestPath, rng, 2)
	alcove(group)
	drumTower(group, rng)
	mausoleum(group, rng)
end

return Secrets
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">MonasteryService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryService
-- The Desecrated Monastery: a ruined grimdark wuxia monastery in a misted mountain valley, built
-- procedurally under Workspace.Map_DesecratedMonastery from the WorldDefinitions layout:
--   gate landing (Altar_MonasteryGate) and gatehouse -&gt; courtyard (bell tower, cauldron, dead tree)
--   -&gt; prayer halls -&gt; bridge over the misted ravine -&gt; cloister (Altar_DesecratedCloister) and
--   graveyard with its toppled pagoda -&gt; south road to the Bamboo Pass.
-- Start() must run before WorldService.Start(): this MapFolder suppresses the region's greybox and
-- the shrines' AltarAnchor_&lt;id&gt; parts receive the rest prompts. If the ground layer fails the map
-- is removed so the greybox returns; the decorative layers fail soft.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("AsurasPath").Shared.WorldDefinitions)
local Services = script.Parent
local Grounds = require(Services:WaitForChild("MonasteryGrounds") :: ModuleScript)
local Ruins = require(Services:WaitForChild("MonasteryRuins") :: ModuleScript)
local Halls = require(Services:WaitForChild("MonasteryHalls") :: ModuleScript)
local Landmarks = require(Services:WaitForChild("MonasteryLandmarks") :: ModuleScript)
local Atmosphere = require(Services:WaitForChild("MonasteryAtmosphere") :: ModuleScript)
local Dressing = require(Services:WaitForChild("MonasteryDressing") :: ModuleScript)
local Survey = require(Services:WaitForChild("MonasterySurvey") :: ModuleScript)
local Bounds = require(Services:WaitForChild("MonasteryBounds") :: ModuleScript)
local Pockets = require(Services:WaitForChild("MonasteryPockets") :: ModuleScript)
local Secrets = require(Services:WaitForChild("MonasterySecrets") :: ModuleScript)

local MonasteryService = {}

local REGION_ID: World.RegionId = "DesecratedMonastery"
local REGION = World.Regions[REGION_ID]
local SEED = 7341
local SURVEY_DELAY = 2
local root: Folder? = nil
local running = false

local function layer(label: string, fn: () -&gt; ()): boolean
	local ok, problem = pcall(fn)
	if not ok then
		warn(string.format("[Asura's Path] Monastery layer '%s' failed: %s", label, tostring(problem)))
	end
	return ok
end

function MonasteryService.Start()
	assert(not running, "MonasteryService already started")
	assert(REGION ~= nil and REGION.Altars.MonasteryGate ~= nil, "Desecrated Monastery layout missing")
	running = true
	local existing = Workspace:FindFirstChild(REGION.MapFolder)
	if existing then
		existing:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = REGION.MapFolder
	map:SetAttribute("AsuraRegion", REGION_ID)
	local rng = Random.new(SEED)
	local started = os.clock()
	local grounded = layer("Grounds", function()
		Grounds.Clear()
		Grounds.Build(map, rng)
	end)
	if not grounded then
		map:Destroy()
		pcall(Grounds.Clear)
		return
	end
	root = map
	layer("Ruins", function()
		Ruins.Build(map, rng)
	end)
	layer("Halls", function()
		Halls.Build(map, rng)
	end)
	layer("Landmarks", function()
		Landmarks.Build(map, rng)
	end)
	layer("Pockets", function() -- route cover and storytelling (batch 15)
		Pockets.Build(map, rng)
	end)
	layer("Secrets", function() -- waterfall path, drum tower, mausoleum seal (batch 15)
		Secrets.Build(map, rng)
	end)
	layer("Atmosphere", function()
		Atmosphere.Build(map, rng)
	end)
	layer("Bounds", function()
		Bounds.Build(map)
		Bounds.Start()
	end)
	local placed = Dressing.Build(map)
	map.Parent = Workspace

	local parts, elapsed = 0, (os.clock() - started) * 1000
	for _, d in map:GetDescendants() do
		parts += if d:IsA("BasePart") then 1 else 0
	end
	-- New terrain voxels only become raycastable after the next physics steps.
	task.delay(SURVEY_DELAY, function()
		if not running or root ~= map then
			return
		end
		local problems = Survey.Run(REGION_ID)
		for _, problem in problems do
			warn("[Asura's Path] Monastery walkability: " .. problem)
		end
		print(string.format("[Asura's Path] Desecrated Monastery raised: %d parts, %d set pieces, %d walkability issues (%.0f ms).",
			parts, placed, #problems, elapsed))
	end)
end

function MonasteryService.Destroy()
	running = false
	Bounds.Stop()
	local folderRoot = root
	if folderRoot then
		folderRoot:Destroy()
		root = nil
		pcall(Grounds.Clear)
	end
end

return MonasteryService
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">MonasterySurvey</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasterySurvey
-- Walkability check for a procedurally built region: raycasts every altar surround, altar spawn,
-- mob spawn and patrol point down to the walkable top, and every patrol leg sideways at knee and
-- chest height. Each altar's rest pocket (Kit.POCKET, shrine excluded) and the walk from its spawn
-- to its Exit (batch 07) must be free of solid geometry. Returns human-readable problems.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("AsurasPath").Shared.WorldDefinitions)
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)

local Survey = {}

local GROUND_TOLERANCE = 0.6
local PROBE_HEIGHT = 60

-- Every altar, spawn and patrol point must stand on stone at Kit.GROUND with nothing solid on top,
-- and every patrol leg must be walkable in a straight line.
function Survey.Run(regionId: World.RegionId): { string }
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	-- Characters (players and the region's spawned enemies) are not terrain; look through them.
	local characters: { Instance } = {}
	for _, d in Workspace:GetDescendants() do
		if d:IsA("Humanoid") and d.Parent then
			table.insert(characters, d.Parent)
		end
	end
	params.FilterDescendantsInstances = characters
	local problems: { string } = {}
	local function ground(label: string, x: number, z: number)
		local hit = Workspace:Raycast(Vector3.new(x, Kit.GROUND + PROBE_HEIGHT, z), Vector3.new(0, -PROBE_HEIGHT * 2, 0), params)
		if not hit then
			table.insert(problems, string.format("%s (%.0f, %.0f): no ground", label, x, z))
		elseif math.abs(hit.Position.Y - Kit.GROUND) &gt; GROUND_TOLERANCE then
			table.insert(problems, string.format("%s (%.0f, %.0f): surface at Y %.1f (%s)", label, x, z, hit.Position.Y, hit.Instance.Name))
		end
	end
	local function leg(label: string, a: World.Placement, b: World.Placement)
		for _, lift in { 1.2, 3.5 } do
			local from = Vector3.new(a.X, Kit.GROUND + lift, a.Z)
			local hit = Workspace:Raycast(from, Vector3.new(b.X, Kit.GROUND + lift, b.Z) - from, params)
			if hit then
				table.insert(problems, string.format("%s leg blocked by %s at (%.0f, %.0f)", label, hit.Instance.Name, hit.Position.X, hit.Position.Z))
				return
			end
		end
	end
	for id, altar in World.Regions[regionId].Altars do -- The shrine fills the altar point; survey its diagonals.
		for k = 0, 3 do
			local a = math.pi / 4 + k * math.pi / 2
			ground(id .. " altar ring", altar.Placement.X + math.cos(a) * 5.5, altar.Placement.Z + math.sin(a) * 5.5)
		end
		ground(id .. " spawn", altar.Spawn.X, altar.Spawn.Z)
		local shrine = Workspace:FindFirstChild("Shrine_" .. altar.Id, true)
		local saved = params.FilterDescendantsInstances
		local ignore = table.clone(characters)
		if shrine then table.insert(ignore, shrine) end
		params.FilterDescendantsInstances = ignore
		for k = 0, 11 do -- pocket: spokes from the shrine's edge out to the pocket radius
			local a = k * math.pi / 6
			local from = Vector3.new(altar.Placement.X + math.cos(a) * 3.5, 0, altar.Placement.Z + math.sin(a) * 3.5)
			local to = Vector3.new(altar.Placement.X + math.cos(a) * Kit.POCKET, 0, altar.Placement.Z + math.sin(a) * Kit.POCKET)
			leg(id .. " pocket", { X = from.X, Y = 3, Z = from.Z, Yaw = 0 }, { X = to.X, Y = 3, Z = to.Z, Yaw = 0 })
		end
		if altar.Exit then
			leg(id .. " departure", altar.Spawn, altar.Exit)
		end
		params.FilterDescendantsInstances = saved
	end
	for _, entry in World.spawnsIn(regionId) do
		ground(entry.Id, entry.Placement.X, entry.Placement.Z)
		for index, point in entry.Patrol do
			ground(entry.Id .. " patrol " .. index, point.X, point.Z)
			leg(entry.Id .. " patrol " .. index, point, entry.Patrol[index % #entry.Patrol + 1])
		end
	end
	return problems
end

return Survey
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">MonasteryTerrain</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/MonasteryTerrain
-- Terrain of the Desecrated Monastery: the valley floor of mud and sour moss between dark rock
-- ridges, the side plateau holding the Twin Sentinels' arena with the pass cut to reach it, and the
-- misted ravine. Walkable tops stay just under MonasteryKit.GROUND so the flagstones cover them.
-- Batch 07: the floor used to span the region bounds, which the boss roster widened to 900 studs
-- for the Twins' side courtyard, leaving flat empty ground ~350 studs past both ridges. It now
-- covers only the valley, the plateau and the pass; MonasteryBounds walls the crest.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("AsurasPath").Shared.WorldDefinitions)
local Zones = require(ReplicatedStorage:WaitForChild("AsurasPath").Shared.MonasteryZones)

local Terrain = {}

local BOUNDS = (World.Regions :: any).DesecratedMonastery.Bounds
local CENTER = Vector3.new(BOUNDS.Center.X, 0, BOUNDS.Center.Z)
local MARGIN = 80

Terrain.RAVINE_Z = -960
Terrain.VALLEY_HALF = 214 -- floor half-width; the ridge crests stand near x = ±180..200
Terrain.PLATEAU = { X0 = 206, X1 = 404, Z0 = -786, Z1 = -1034 } -- Twins arena (x 210..390) and approach
Terrain.EAST_PASS = { X0 = 140, X1 = 236, Z0 = -796, Z1 = -824 } -- the courtyard road's cut through the ridge

-- Smooth terrain renders and collides 2 studs above a filled block's top, so fills stop at
-- TERRAIN_TOP to leave the surface just under the flagstones.
local TERRAIN_TOP = -2.2

-- Terrain extent cleared on build and teardown (region bounds plus the cliff margin).
function Terrain.Extent(): (CFrame, Vector3)
	return CFrame.new(CENTER.X, -20, CENTER.Z), Vector3.new(BOUNDS.Size.X + MARGIN * 2, 120, BOUNDS.Size.Z + MARGIN * 2)
end

function Terrain.Clear()
	local cframe, size = Terrain.Extent()
	Workspace.Terrain:FillBlock(cframe, size, Enum.Material.Air)
end

local function floor(t: Terrain, x0: number, x1: number, z0: number, z1: number)
	t:FillBlock(CFrame.new((x0 + x1) * 0.5, (TERRAIN_TOP - 16) * 0.5, (z0 + z1) * 0.5), Vector3.new(x1 - x0, 16 + TERRAIN_TOP, math.abs(z1 - z0)), Enum.Material.Ground)
end

-- Batch 15 (#26): the dead ground between the outer walls and the ridges becomes boulder scree,
-- keeping clear of every walked zone, the waterfall path and alcove, the ridge-pass road and the
-- ravine, so leaving the route is either the authored secret or a visible climb, not empty flat.
Terrain.Scree = {
	{ -180, -90, -662, -934 }, { 90, 180, -662, -934 }, { -180, -34, -662, -752 }, { 34, 180, -662, -752 },
	{ -180, -140, -926, -1120 }, { 136, 180, -926, -1120 },
}
-- Batch 24: the Gatehouse sparring ring (ColosseumService Ring_GatehouseCircle) keeps a clear yard
-- that opens onto the waterfall path; the batch 15 scree had buried its octagon. Stones that would
-- touch it are skipped after their random draws, so every other scattered stone stays where it was.
Terrain.SPARRING_YARD = { X = -130, Z = -745, Clear = 30 }
function Terrain.inYard(x: number, z: number, radius: number): boolean
	local yard = Terrain.SPARRING_YARD
	return math.sqrt((x - yard.X) ^ 2 + (z - yard.Z) ^ 2) &lt; radius + yard.Clear
end
function Terrain.screeClear(x: number, z: number, radius: number): boolean
	if z &lt; -936 and z &gt; -994 and math.abs(x) &lt; 140 then return false end -- the ravine keeps its own shape
	if math.abs(z + 811) &lt; radius + 10 and x &gt; 70 then return false end -- road through the ridge pass
	if Zones.distanceToPath(Zones.WestPath, x, z) &lt; radius + 3 then return false end
	if math.sqrt((x - Zones.Alcove.X) ^ 2 + (z - Zones.Alcove.Z) ^ 2) &lt; radius + 10 then return false end
	for _, zone in Zones.List do -- boulders end a stud outside the walls, so no flat band remains
		if zone.Id ~= "WestReach" and zone.Id ~= "EastPass" and Zones.contains(zone, x, z, radius + 1) then return false end
	end
	return true
end

local function scree(t: Terrain, rng: Random)
	for _, box in Terrain.Scree do
		for x = box[1], box[2], 8 do
			for z = box[3], box[4], -8 do
				local r = rng:NextNumber(8, 12)
				local px, pz = x + rng:NextNumber(-2, 2), z + rng:NextNumber(-2, 2)
				while r &gt;= 4 and not Terrain.screeClear(px, pz, r) do r -= 2 end -- smaller stones fill the seams by walls
				if r &gt;= 4 then
					local lift, rock = rng:NextNumber(1, 5), rng:NextNumber() &lt; 0.7
					if not Terrain.inYard(px, pz, r) then
						t:FillBall(Vector3.new(px, lift * r / 10, pz), r, if rock then Enum.Material.Rock else Enum.Material.Slate)
					end
				end
			end
		end
	end
end

function Terrain.Build(rng: Random)
	local t = Workspace.Terrain
	t:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(58, 50, 44))
	t:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(46, 38, 34))
	t:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(70, 68, 46))
	t:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(62, 62, 64))
	t:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(52, 54, 56))
	local sz = BOUNDS.Size.Z + MARGIN * 2
	floor(t, -Terrain.VALLEY_HALF, Terrain.VALLEY_HALF, CENTER.Z + sz * 0.5, CENTER.Z - sz * 0.5)
	local plateau = Terrain.PLATEAU
	floor(t, plateau.X0, plateau.X1, plateau.Z0, plateau.Z1)
	-- Top-layer patches of mud and sour moss break up the floor between the stones.
	for _ = 1, 36 do
		local x, z = rng:NextNumber(-190, 190), CENTER.Z + rng:NextNumber(-215, 215)
		local material = if rng:NextNumber() &lt; 0.55 then Enum.Material.Mud else Enum.Material.LeafyGrass
		t:FillBlock(CFrame.new(x, TERRAIN_TOP - 1, z), Vector3.new(rng:NextNumber(16, 40), 2, rng:NextNumber(16, 40)), material)
	end
	-- Valley walls: dark rock ridges east, west and north; the south stays open for the road.
	for z = -640, -1160, -22 do
		for side = -1, 1, 2 do
			local x = side * (180 + rng:NextNumber(-6, 12))
			t:FillBall(Vector3.new(x, rng:NextNumber(-6, 14), z), rng:NextNumber(26, 36), Enum.Material.Rock)
			t:FillBall(Vector3.new(x + side * 18, rng:NextNumber(18, 38), z), rng:NextNumber(18, 26), Enum.Material.Slate)
		end
	end
	for x = -200, 200, 22 do
		t:FillBall(Vector3.new(x, rng:NextNumber(-4, 16), -656 + rng:NextNumber(-4, 4)), rng:NextNumber(24, 32), Enum.Material.Rock)
	end
	scree(t, rng)
	-- The east pass: a cut through the ridge where the courtyard road leaves for the side plateau.
	local pass = Terrain.EAST_PASS
	t:FillBlock(CFrame.new((pass.X0 + pass.X1) * 0.5, 22.5, (pass.Z0 + pass.Z1) * 0.5), Vector3.new(pass.X1 - pass.X0, 44, math.abs(pass.Z1 - pass.Z0)), Enum.Material.Air)
	-- The ravine: a chain of spherical cuts that taper into the cliffs at both ends.
	for x = -136, 136, 8 do
		local taper = math.clamp((math.abs(x) - 100) / 36, 0, 1)
		t:FillBall(Vector3.new(x, 14, Terrain.RAVINE_Z + rng:NextNumber(-1.5, 1.5)), 26 - taper * 11, Enum.Material.Air)
	end
	local ravine = Region3.new(Vector3.new(-140, -16, Terrain.RAVINE_Z - 28), Vector3.new(140, -2, Terrain.RAVINE_Z + 28))
	t:ReplaceMaterial(ravine:ExpandToGrid(4), 4, Enum.Material.Ground, Enum.Material.Mud)
end

return Terrain
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">NarrativeWorld</string>
            <string name="Source">--!strict
local World=game:GetService("Workspace")
local Shared=game:GetService("ReplicatedStorage").AsurasPath.Shared
local Catalog=require(Shared.NarrativeCatalog)
local InputMap=require(Shared.InputMap)
local Figures=require(script.Parent.CastFigures)
local Kit={}
local function part(parent: Instance,name: string,size: Vector3,cf: CFrame,color: Color3): Part
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Anchored=true;p.Color=color;p.Material=Enum.Material.Slate;p.Parent=parent;return p
end
local function prompt(parent: BasePart,label: string,name: string,run: (Player)-&gt;(),links: {RBXScriptConnection})
 local p=Instance.new("ProximityPrompt");p.Name="NarrativePrompt";p.ActionText=label;p.ObjectText=name;p.HoldDuration=0.25
 InputMap.applyPrompt(p);p.MaxActivationDistance=12;p.RequiresLineOfSight=true;p.Parent=parent
 table.insert(links,p.Triggered:Connect(run))
end
function Kit.build(open: (Player,string)-&gt;(),lore: (Player,string)-&gt;()): (Folder,{RBXScriptConnection})
 local root=Instance.new("Folder");root.Name="JadeCataclysm";root.Parent=World
 local links: {RBXScriptConnection}={}
 for id,n in Catalog.NPCs do
  if id=="Gao" then continue end -- the smith is a live rig dressed by SanctuaryService
  -- Authored figure (LooksCast) where the robe block stood: feet at its hem, head at portrait height.
  local model,torso,head=Figures.statue(root,id,Vector3.new(n.X,n.Y-1.8,n.Z));model:SetAttribute("DialogueNPC",id)
  local label=Instance.new("BillboardGui");label.Size=UDim2.fromOffset(220,36);label.StudsOffset=Vector3.new(0,4,0);label.MaxDistance=36;label.Parent=head
  local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Font=Enum.Font.Antique;text.Text=n.Name
  text.TextColor3=Color3.fromRGB(224,202,153);text.TextSize=15;text.Parent=label
  prompt(torso,"Speak",n.Name,function(player: Player) open(player,id) end,links)
 end
 for id,l in Catalog.Lore do
  local cf=CFrame.new(l.X,l.Y,l.Z)
  part(root,id.."Pedestal",Vector3.new(4.5,1,3),cf*CFrame.new(0,-2.5,0),Color3.fromRGB(43,45,41))
  local stone=part(root,id,Vector3.new(2.6,5,0.8),cf,Color3.fromRGB(38,49,47));stone:SetAttribute("LoreId",id)
  -- Jade script on both faces so a memorial reads from the path whichever way it is walked (#44).
  local rune=part(stone,"JadeInscription",Vector3.new(0.12,3,0.08),cf*CFrame.new(0,0,-0.45),Color3.fromRGB(113,207,172));rune.Material=Enum.Material.Neon;rune.CanCollide=false
  local back=part(stone,"JadeInscription",Vector3.new(0.12,3,0.08),cf*CFrame.new(0,0,0.45),rune.Color);back.Material=Enum.Material.Neon;back.CanCollide=false
  local light=Instance.new("PointLight");light.Color=rune.Color;light.Range=if id==Catalog.LoreOrder[1] then 16 else 9;light.Brightness=if id==Catalog.LoreOrder[1] then 1.2 else 0.6;light.Parent=rune
  prompt(stone,"Read Memorial",l.Title,function(player: Player) lore(player,id) end,links)
 end
 return root,links
end
return table.freeze(Kit)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">PagodaDressing</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/PagodaDressing
-- Celestial Pagoda silhouettes and storytelling (batch 20). All decor: four corner towers with
-- stacked curved eaves around Wu's open hall (their roofs start above the arena's air space), the
-- torn upper roof ring, criss-cross rafters over the lotus gorge, a lotus pool and drifting mist in
-- the gorge, prayer banners from the gallery, the empty throne's canopy and the hall's great bell.
-- Collision lives in CelestialPagodaLayout.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)
local Decor = require(script.Parent:WaitForChild("RegionDecor") :: ModuleScript)

local Dressing = {}
local P = Kit.Palette
local M = Enum.Material
local rgb = Color3.fromRGB
local GOLD = rgb(176, 140, 72)

local function tower(parent: Instance, x: number, z: number, tiers: number)
	Kit.part(parent, "TowerBody", Vector3.new(14, 40, 14), CFrame.new(x, 20, z), P.Lacquer:Lerp(P.WoodDark, 0.35), M.Wood, Kit.decor())
	for k = 1, tiers do
		local y = 40 + (k - 1) * 14
		Decor.roof(parent, CFrame.new(x, y, z), 24 - k * 3, 24 - k * 3, 4)
		Kit.part(parent, "TowerStorey", Vector3.new(12 - k * 2, 10, 12 - k * 2), CFrame.new(x, y + 9, z), P.Lacquer, M.Wood, Kit.decor())
	end
	Kit.part(parent, "TowerFinial", Vector3.new(1, 8, 1), CFrame.new(x, 44 + tiers * 14, z), GOLD, M.Metal, Kit.decor())
end

function Dressing.Build(map: Instance, _layout: any, rng: Random)
	local set = Kit.folder("PagodaDressing", map)
	-- Corner towers and the torn roof ring above the hall (clear of its 86-stud air space).
	for _, c in { { -114, -2296 }, { 114, -2296 }, { -114, -2466 }, { 114, -2466 } } do
		tower(set, c[1], c[2], 3)
	end
	for k = 0, 15 do
		if k % 5 ~= 2 then -- broken bays
			local a = math.rad(k * 22.5)
			Kit.part(set, "RoofRing", Vector3.new(38, 1.2, 10), CFrame.new(math.cos(a) * 100, 96 + (k % 3), -2380 + math.sin(a) * 100)
				* CFrame.Angles(0, -a + math.pi / 2, math.rad(12)), P.Roof, M.Slate, Kit.decor())
		end
	end
	-- Rafters over the gorge: dark beams at two heights, criss-crossed.
	for k = 0, 6 do
		local z = -2180 - k * 11
		Kit.beam(set, "OverRafter", Vector3.new(-150, 14 + (k % 2) * 6, z), Vector3.new(150, 14 + (k % 2) * 6, z - 8), 1.4, P.WoodDark, M.Wood)
	end
	Kit.beam(set, "OverRafter", Vector3.new(-150, 24, -2176), Vector3.new(150, 18, -2248), 1.6, P.WoodDark, M.Wood)
	-- Lotus pool on the gorge floor (top -26) and mist pooling under the galleries.
	Kit.part(set, "LotusPool", Vector3.new(60, 0.1, 30), CFrame.new(70, -25.94, -2214), rgb(40, 74, 82), M.Glass, Kit.decor())
	for _ = 1, 22 do
		local pad = Kit.part(set, "LotusPad", Vector3.new(0.12, rng:NextNumber(2, 4), rng:NextNumber(2, 4)), CFrame.new(rng:NextNumber(44, 96), -25.85, rng:NextNumber(-2202, -2226))
			* CFrame.Angles(0, 0, math.rad(90)), rgb(70, 110, 66), M.Grass, Kit.decor())
		pad.Shape = Enum.PartType.Cylinder
	end
	Fx.mist(set, CFrame.new(0, -22, -2212), Vector3.new(290, 6, 70), 3, 28)
	-- Prayer banners from the gallery and the lantern rafter.
	for _, x in { -112, -96, -80, -66 } do
		Decor.banner(set, CFrame.new(x, -6.8, -2240.4), rng:NextNumber(5, 8), if x == -96 then rgb(214, 204, 176) else P.Lacquer)
	end
	Decor.banner(set, CFrame.new(0, -6.8, -2216.2), 6, GOLD)
	-- The empty throne: canopy and posts (the seat itself is the layout's EmptyThrone).
	Kit.part(set, "ThroneBack", Vector3.new(6, 6, 0.8), CFrame.new(-140, 23, -2282), P.Lacquer, M.Wood, Kit.decor())
	Decor.roof(set, CFrame.new(-140, 26, -2280), 10, 8, 2, P.Lacquer)
	Kit.part(set, "ThroneCushion", Vector3.new(5, 0.6, 3), CFrame.new(-140, 20.3, -2279.5), GOLD, M.Fabric, Kit.decor())
	-- The hall's great bell, hung beside the fog gate.
	Kit.part(set, "BellFrame", Vector3.new(12, 1, 1), CFrame.new(60, 16, -2276), P.WoodDark, M.Wood, Kit.decor())
	local bell = Kit.part(set, "GreatBell", Vector3.new(6, 8, 6), CFrame.new(60, 11, -2276), rgb(112, 91, 57), M.Metal, Kit.decor())
	bell.Shape = Enum.PartType.Cylinder
	bell.CFrame = bell.CFrame * CFrame.Angles(0, 0, math.rad(90))
	-- A dawn-coloured haze beyond the dawn terrace, toward the summit.
	Fx.mist(set, CFrame.new(0, -6, -2520), Vector3.new(80, 10, 40), 2, 34, rgb(232, 200, 176))
end

return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">PbrAssets</string>
            <string name="Source">--!strict
-- Static dressing shares uploaded meshes/maps. Missing/invalid imports preserve existing geometry.
local ServerStorage = game:GetService("ServerStorage")
local Pbr = {}
function Pbr.validate(model: Model): (boolean, string?)
	local count = 0
	for _, item in model:GetDescendants() do
		if not item:IsA("MeshPart") then continue end
		count += 1
		local surface = item:FindFirstChildOfClass("SurfaceAppearance")
		if not surface then return false, item.Name .. ": missing SurfaceAppearance" end
		-- Legacy *Map strings require Plugin security; *MapContent is readable in live servers.
		for _, key in {"ColorMapContent","NormalMapContent","RoughnessMapContent","MetalnessMapContent"} do
			local content = (surface :: any)[key]
			if not content or not content.Uri or content.Uri == "" then return false, item.Name .. ": incomplete PBR maps" end
		end
	end
	return count &gt; 0, if count == 0 then "no MeshParts" else nil
end
function Pbr.place(parent: Instance, name: string, floor: CFrame, target: number, axis: string?, proxy: Instance?): Model?
	local library = ServerStorage:FindFirstChild("AsuraAssets")
	local template = library and library:FindFirstChild(name)
	if not template or not template:IsA("Model") then return nil end
	local ok, reason = Pbr.validate(template)
	if not ok then warn("[Asura PBR] " .. name .. " skipped: " .. tostring(reason)); return nil end
	local model = template:Clone()
	local size = model:GetExtentsSize()
	local current = if axis == "Longest" then math.max(size.X,size.Y,size.Z) elseif axis == "X" then size.X elseif axis == "Z" then size.Z else size.Y
	if current &lt; 0.001 then model:Destroy(); return nil end
	model:ScaleTo(model:GetScale() * target / current)
	model:PivotTo(floor)
	local box, extents = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + Vector3.yAxis * (floor.Position.Y - box.Position.Y + extents.Y/2))
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored, item.CanCollide, item.CanQuery, item.CanTouch = true, false, false, false
			item:SetAttribute("AsuraDecorative", true)
			-- RenderFidelity is authored on the imported template; runtime writes are restricted.
		end
	end
	model:SetAttribute("AsuraPbr", true); model.Parent = parent
	-- Preserve movement surfaces as invisible, simple collision proxies.
	if proxy then
		local parts = proxy:GetDescendants()
		if proxy:IsA("BasePart") then table.insert(parts, proxy) end
		for _, item in parts do
			if item:IsA("BasePart") then item.Transparency = 1; item.CastShadow = false end
		end
	end
	return model
end
return Pbr
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">PersistenceService</string>
            <string name="Source">--!nonstrict
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Schema=require(Shared.ProfileSchema)
local Engine=require(script.Parent.ProfileStore)
local RunService=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Config=require(Shared.Config)
local mock={}
local dataStore
if RunService:IsStudio() and not Config.Backend.StudioLiveData then
 dataStore={UpdateAsync=function(_,key,callback)
  local value=callback(Engine.Copy(mock[key]))
  if value~=nil then mock[key]=Engine.Copy(value) end
  return Engine.Copy(value)
 end}
else
 dataStore=game:GetService("DataStoreService"):GetDataStore("AsuraProfiles_v1")
end
local engine=Engine.new(dataStore,Schema,{owner=game.JobId..":"..Http:GenerateGUID(false),now=os.time,wait=task.wait,
 attempts=4,leaseSeconds=Config.Backend.LeaseSeconds})
local Service={Engine=engine,IsMock=RunService:IsStudio() and not Config.Backend.StudioLiveData}
function Service.Load(id)
 local deadline=os.clock()+20
 local ownershipAttempts=0
 repeat
  local p,err=engine:Load(id)
  if p then return p end
  if os.clock()&gt;=deadline then error(err,0) end
  if err=="Profile is active on another server" then
   -- Teleport/rejoin can arrive before PlayerRemoving finishes its release.
   -- Wait for that normal release; never force an active owner's lease.
   ownershipAttempts+=1
   if ownershipAttempts&gt;=8 then error(err,0) end
   task.wait(math.min(ownershipAttempts,3,math.max(0,deadline-os.clock())))
  elseif err=="Profile is busy" then task.wait(0.05)
  else error(err,0) end
 until false
end
function Service.Get(id) return engine:Get(id) end
function Service.Transaction(id,fn) return engine:Transaction(id,fn) end
function Service.Save(id) return engine:Save(id) end
function Service.Unload(id)
 local deadline=os.clock()+20
 repeat
  local ok,err=engine:Release(id)
  if ok or err~="Profile is busy" then return ok,err end
  task.wait(0.05)
 until os.clock()&gt;deadline
 return false,"Release timed out"
end
function Service.ProcessReceipt(id,purchaseId,productId,grant) return engine:Receipt(id,purchaseId,productId,grant) end
function Service.ApplyResult(id,matchId,result) return engine:ApplyResult(id,matchId,result) end
function Service.PublicProfile(id)
 local p=Service.Get(id)
 if p then p.receipts=nil;p.appliedMatches=nil;p.pendingMatches=nil end
 return p
end
function Service.Start()
 task.spawn(function()
  while not engine.closed do
   task.wait(Config.Backend.AutosaveSeconds)
   if engine.closed then break end
   for id in engine.profiles do task.spawn(function()
    local ok,err=Service.Save(id)
    if not ok then
     warn("[Persistence] Autosave "..id..": "..tostring(err))
     if not Service.Get(id) then
      local player=game:GetService("Players"):GetPlayerByUserId(id)
      if player then player:Kick("Your fighter session expired. Please rejoin safely.") end
     end
    end
   end) end
  end
 end)
end
function Service.Close(deadline)
 engine.closed=true
 local pending=0
 for id in engine.profiles do pending+=1;task.spawn(function() Service.Unload(id);pending-=1 end) end
 deadline=deadline or os.clock()+25
 repeat task.wait(0.05) until pending==0 or os.clock()&gt;deadline
 if pending&gt;0 then warn("[Persistence] Shutdown deadline; remaining leases expire safely") end
end
return Service
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">PresentationAudit</string>
            <string name="Source">--!strict
-- Read-only Studio inspection. Instance counts are not a measurement of GPU draw calls.
local Audit = {}
function Audit.Run(root: Instance): any
	local result: any = {Parts=0,Meshes=0,Surfaces=0,Decorative=0,Emitters=0,UniqueMeshes=0,UniqueMaps=0,Issues={}}
	local meshes, maps = {}, {}
	for _, item in root:GetDescendants() do
		if item:IsA("BasePart") then
			result.Parts += 1
			if item:GetAttribute("AsuraDecorative") then
				result.Decorative += 1
				if not item.Anchored or item.CanCollide or item.CanTouch or item.CanQuery then
					table.insert(result.Issues,item:GetFullName() .. ": decorative physics enabled")
				end
			end
		end
		if item:IsA("MeshPart") then
			result.Meshes += 1; meshes[item.MeshId]=true
			local s = item:FindFirstChildOfClass("SurfaceAppearance")
			if not s then table.insert(result.Issues,item:GetFullName() .. ": missing SurfaceAppearance")
			else
				result.Surfaces += 1
				for _, key in {"ColorMap","NormalMap","RoughnessMap","MetalnessMap"} do
					local content = (s :: any)[key.."Content"]
					local id = content and content.Uri
					if not id or id == "" then table.insert(result.Issues,item:GetFullName() .. ": missing " .. key) else maps[id]=true end
				end
			end
		elseif item:IsA("ParticleEmitter") then
			result.Emitters += 1
			if item.Enabled and (item.Texture == "" or string.find(item.Texture,"rbxasset://textures/particles",1,true)) then
				table.insert(result.Issues,item:GetFullName() .. ": untextured/stock emitter")
			end
		end
	end
	for _ in meshes do result.UniqueMeshes += 1 end
	for _ in maps do result.UniqueMaps += 1 end
	local ok, memory = pcall(function() return game:GetService("Stats"):GetTotalMemoryUsageMb() end)
	result.TotalMemoryMb = if ok then memory else nil
	result.Uncompressed1024MapEstimateMb = result.UniqueMaps * 4 -- estimate; compression/mips vary by device
	print("[Asura AV Audit] " .. game:GetService("HttpService"):JSONEncode(result))
	return result
end
return Audit
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">PresentationDressing</string>
            <string name="Source">--!strict
local Pbr = require(script.Parent.PbrAssets)
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Dressing = {}
local function floorOf(p: BasePart): CFrame return p.CFrame - Vector3.yAxis * p.Size.Y/2 end
function Dressing.Build(root: Instance): number
	local old = root:FindFirstChild("Phase5Pbr")
	if old then old:Destroy() end
	local folder = Instance.new("Folder"); folder.Name,folder.Parent = "Phase5Pbr",root
	local placed = 0
	-- Replace discrete decorative objects, preserving all floor/platform collisions and prompts.
	for _, p in root:GetDescendants() do
		if not p:IsA("BasePart") or p:IsDescendantOf(folder) or p.Transparency &gt;= 1 then continue end
		if placed &gt;= Assets.Limits.Scenery then break end
		local name: string? = nil
		local axis: string? = nil
		local size: number? = nil
		if p.Name == "Rubble" then name,axis,size = "AsuraStone","X",p.Size.X
		elseif p.Name == "IdolBody" then name,axis,size = "AsuraColossusStatue","Y",8
		elseif p.Name == "Stele" then name,axis,size = "AsuraSpeakingStones","Y",p.Size.Y
		elseif p.Name == "Pillar" and p.Size.Y &gt; 8 then name,axis,size = "AsuraRuinPillar","Y",p.Size.Y
		end
		if name and size and Pbr.place(folder,name,floorOf(p),size,axis,p) then placed += 1 end
	end
	if root.Name == "Map_DesecratedMonastery" then
		local placements: {{any}} = {
			{"AsuraRuinArch", CFrame.new(0,0.3,-861),17,"Y"},
			{"AsuraBrassLantern",CFrame.new(-16,0.3,-766),3,"Y"},
			{"AsuraBrassLantern",CFrame.new(16,0.3,-846),3,"Y"},
			{"AsuraFirePit",CFrame.new(0,0.3,-812),8,"X"},
			{"AsuraFoundationRuin",CFrame.new(-68,0.3,-1090),14,"X"},
		}
		for _, spec in placements do
			if Pbr.place(folder,spec[1] :: string,spec[2] :: CFrame,spec[3] :: number,spec[4] :: string) then placed += 1 end
		end
		local bridge = root:FindFirstChild("RavineBridge",true)
		if bridge then
			for side = -1,1,2 do for z = -944,-984,-10 do
				if Pbr.place(folder,"AsuraRomanRail",CFrame.new(side*8.5,0.3,z),10,"Longest") then placed += 1 end
			end end
		end
	end
	root:SetAttribute("AsuraPbrPlacements",placed)
	return placed
end
return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">PresentationService</string>
            <string name="Source">--!strict
local Workspace = game:GetService("Workspace")
local Characters = require(script.Parent.CharacterService)
local Dressing = require(script.Parent.PresentationDressing)
local Skin = require(script.Parent.BossSkin)
local ArenaLighting = require(script.Parent.ArenaLighting)
local Service = {}
local disconnect: (() -&gt; ())? = nil
local watchers: {[Model]: {RBXScriptConnection}} = {}
function Service.Start()
	ArenaLighting.Build()
	for _, name in {"Sanctuary","Map_DesecratedMonastery","Map_BambooPass","Map_AshColosseum","Map_SanctuaryDepths","Map_CelestialPagoda","Map_SkyCitadel"} do
		local root = Workspace:FindFirstChild(name)
		if root then Dressing.Build(root) end
	end
	local function attach(id: number)
		task.defer(function()
			local e = Characters.GetEntity(id)
			if e and e.Boss then
				local ok, err=pcall(Skin.attach,e.Model)
				if not ok then warn("[Asura AV] Boss skin skipped: "..tostring(err)) end
				if not watchers[e.Model] then
					watchers[e.Model]={e.Model:GetAttributeChangedSignal("AsuraAnimationSet"):Connect(function() attach(id) end),
						e.Model.Destroying:Connect(function()
							local list: {RBXScriptConnection} = watchers[e.Model] or {}
							for _, connection in list do connection:Disconnect() end
							watchers[e.Model]=nil
						end)}
				end
			end
		end)
	end
	disconnect=Characters.OnEntityAdded(function(id: number) attach(id) end)
	for id in Characters.Entities() do attach(id) end
end
function Service.Destroy()
	if disconnect then disconnect();disconnect=nil end
	for _, list in watchers do for _, connection in list do connection:Disconnect() end end
	table.clear(watchers)
	local folder=Workspace:FindFirstChild("AsuraArenaLighting")
	if folder then folder:Destroy() end
end
return Service
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">ProfileBridge</string>
            <string name="Source">--!strict
-- The RPG record owns data. Older world/arsenal code receives a synchronized compatibility view.
local hasScript=pcall(function() return script.Parent end)
local Shared: any=if hasScript then game:GetService("ReplicatedStorage").AsurasPath.Shared else nil
local Rules: any=if hasScript then require(Shared.ProgressionRules) else require("../shared/ProgressionRules")
local Arena: any=if hasScript then require(Shared.ArenaRules) else require("../shared/ArenaRules")
local Bridge={}
function Bridge.toSouls(p: any)
 local s=p.souls;local i=s.inventory
 s.essence=p.qiEssence;s.attributes=table.clone(p.attributes);s.level=Rules.level(p.attributes)
 s.world.bosses=table.clone(p.defeatedBosses);s.world.altars=table.clone(p.unlockedAltars)
 i.weapons={};i.reinforcement={}
 for id,w in p.inventory.Weapons do i.weapons[id]=true;if w.Level&gt;0 then i.reinforcement[id]=w.Level end end
 i.spells=table.clone(p.inventory.Spells);i.mainhand=p.equippedLoadout.MainWeapon;i.offhand=p.equippedLoadout.OffWeapon or "None"
 i.spellSlots={p.equippedLoadout.SpellSlot1 or "ThunderclapPalm",p.equippedLoadout.SpellSlot2 or "GaleStep"}
 s.rpg={Materials=p.inventory.Materials,Weapons=p.inventory.Weapons,Mastery=p.weaponMastery}
 p.elo=p.colosseum.Elo;p.peakElo=math.max(p.peakElo,p.elo);p.wins=p.colosseum.Wins;p.losses=p.colosseum.Losses;p.winStreak=p.colosseum.WinStreak
end
function Bridge.snapshot(p: any): any
 return {qi=p.qiEssence,attributes=table.clone(p.attributes),levels=table.clone(p.souls.inventory.reinforcement),
  main=p.equippedLoadout.MainWeapon,off=p.souls.inventory.offhand,slots=table.clone(p.souls.inventory.spellSlots),
  elo=p.elo,wins=p.wins,losses=p.losses,streak=p.winStreak}
end
function Bridge.reconcile(p: any,b: any)
 local s=p.souls;local i=s.inventory
 if s.essence~=b.qi then p.qiEssence=s.essence end
 for _,key in Rules.Attributes do if s.attributes[key]~=b.attributes[key] then p.attributes[key]=s.attributes[key] end end
 for id,owned in i.weapons do
  if owned then
   if not p.inventory.Weapons[id] then p.inventory.Weapons[id]={Level=0} end
   local tier=i.reinforcement[id] or 0
   if tier~=(b.levels[id] or 0) then p.inventory.Weapons[id].Level=tier end
  end
 end
 for id,owned in i.spells do if owned then p.inventory.Spells[id]=true end end
 for id,flag in s.world.bosses do if flag then p.defeatedBosses[id]=true end end
 for id,flag in s.world.altars do if flag then p.unlockedAltars[id]=true end end
 if i.mainhand~=b.main then p.equippedLoadout.MainWeapon=i.mainhand end
 if i.offhand~=b.off then p.equippedLoadout.OffWeapon=if i.offhand=="None" then nil else i.offhand end
 for slot=1,2 do if i.spellSlots[slot]~=b.slots[slot] then p.equippedLoadout["SpellSlot"..slot]=i.spellSlots[slot] end end
 local c=p.colosseum
 if p.elo~=b.elo then c.Elo=p.elo end;if p.wins~=b.wins then c.Wins=p.wins end
 if p.losses~=b.losses then c.Losses=p.losses end;if p.winStreak~=b.streak then c.WinStreak=p.winStreak end
 c.Rank=Arena.rank(c.Elo,c.Wins+c.Losses+p.draws)
 Bridge.toSouls(p)
end
return table.freeze(Bridge)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/ProfileStore
-- Pure, injectable storage engine plus the Asura's Path Souls progression record. Update callbacks
-- never yield or grant outside the stored record. Every profile carries a `souls` section that the
-- engine migrates and validates alongside the account schema it is constructed with.
local hasScript = pcall(function()
	return script.Parent
end)
local Settings: any, Weapons: any, World: any, Arsenal: any
if hasScript then
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
	Settings = require(Shared.Shared.CombatSettings)
	Weapons = require(Shared.Simulation.WeaponSchema)
	World = require(Shared.Shared.WorldDefinitions)
	Arsenal = require(Shared.Simulation.ArsenalInventory)
else
	Settings = require("../shared/CombatSettings")
	Weapons = require("../simulation/WeaponSchema")
	World = require("../shared/WorldDefinitions")
	Arsenal = require("../simulation/ArsenalInventory")
end

local Bridge: any = if hasScript then require(script.Parent.ProfileBridge) else require("./ProfileBridge")
local Progression: any = if hasScript then require(game:GetService("ReplicatedStorage").AsurasPath.Shared.ProgressionRules) else require("../shared/ProgressionRules")

export type AttributeName = "Vigor" | "Endurance" | "Strength" | "Dexterity" | "ArcaneQi"
export type Attributes = { [AttributeName]: number }
export type Bloodstain = { region: string, x: number, y: number, z: number, essence: number, death: number }
export type Elixirs = { charges: number, max: number, potency: number }
-- reinforcement: blacksmith upgrade level per weapon (absent = 0), 1..Store.ReinforceMax.
export type Inventory = {
	spells: {[string]: boolean}, spellSlots: {string}, remembrances: {[string]: any}, spentRemembrances: {[string]: boolean}, caches: {[string]: boolean},
	weapons: { [string]: boolean },
	mainhand: string,
	offhand: string,
	elixirs: Elixirs,
	reinforcement: { [string]: number },
}
export type WorldState = { altars: { [string]: boolean }, activeAltar: string, bosses: { [string]: boolean }, bloodstain: Bloodstain?, tutorial: { [string]: boolean }?, story: { [string]: boolean }? }
export type Souls = {
	version: number,
	level: number,
	attributes: Attributes,
	essence: number,
	inventory: Inventory,
	world: WorldState,
	deaths: number,
}
export type DerivedStats = {
	MaxQi: number, RallyScale: number, SpellScale: number, InfusionBurn: number, InfusionStun: number, GuardPierce: number, VoidScale: number, SignatureFinisher: boolean,
	MaxHP: number,
	MaxStamina: number,
	PostureCapacity: number,
	StrengthScale: number,
	DexterityScale: number,
}

type Schema = {
	Migrate: (raw: any, id: number) -&gt; any,
	Validate: (profile: any) -&gt; (boolean, string?),
	Level: (xp: number) -&gt; number,
}

type Options = {
	owner: string,
	now: () -&gt; number,
	wait: (seconds: number) -&gt; any,
	attempts: number,
	leaseSeconds: number,
	startingAltar: string?,
}

type DataStore = { UpdateAsync: (self: any, key: string, transform: (old: any) -&gt; any) -&gt; any }

local Store = {}
Store.__index = Store

export type Engine = typeof(setmetatable(
	{} :: {
		dataStore: DataStore,
		schema: Schema,
		options: Options,
		profiles: { [number]: any },
		busy: { [number]: boolean },
		closed: boolean,
		operation: number,
	},
	Store
))

local function copy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, child in v do
		out[k] = copy(child)
	end
	return out
end
Store.Copy = copy

-- Conservative JSON upper bound: even fully escaped keys fit below the platform
-- record limit. Never remove deduplication keys to make a record fit.
local MAX_RECORD_BYTES = 3500000
local function jsonBound(value: any): number
	if type(value) == "string" then
		return #value * 6 + 2
	end
	if type(value) ~= "table" then
		return 32
	end
	local bytes = 2
	for key, child in value do
		bytes += jsonBound(key) + 1 + jsonBound(child) + 1
		if bytes &gt; MAX_RECORD_BYTES then
			break
		end
	end
	return bytes
end
Store.JsonByteUpperBound = jsonBound

local function bounded(record: any): any
	assert(jsonBound(record) &lt;= MAX_RECORD_BYTES, "Profile byte budget exceeded; archival required")
	return record
end

-------------------------------------------------------------------------------------------------
-- Souls progression schema
-------------------------------------------------------------------------------------------------

-- v2: weapon reinforcement levels.
local SOULS_VERSION = 4
local MAX_SAFE_INTEGER = 9007199254740991
local ATTRIBUTE_BASE = 10
local ATTRIBUTE_MAX = 99
local ATTRIBUTES: { AttributeName } = { "Vigor", "Endurance", "Strength", "Dexterity", "ArcaneQi" }
local MAX_IDENTIFIER = 64
local MAX_WORLD_ENTRIES = 512
local COORDINATE_LIMIT = 1e6
-- New records begin at the Sanctuary bonfire; the id lives only in WorldDefinitions.
local DEFAULT_ALTAR: string = World.Regions.Sanctuary.Altars.SanctuaryBonfire.Id
assert(DEFAULT_ALTAR == (World :: any).startingAltar().Id, "The Sanctuary bonfire must remain the starting altar")
local STARTING_WEAPONS = { "Unarmed", "Jian" }
local REINFORCE_MAX = 10
local REINFORCE_STEP = 0.1
local ELIXIR = Settings.Elixir

Store.Attributes = table.freeze(table.clone(ATTRIBUTES))
Store.AttributeBase = ATTRIBUTE_BASE
Store.AttributeMax = ATTRIBUTE_MAX

local WEAPON_SET: { [string]: boolean } = {}
for _, name in Weapons.WeaponKeys do
	WEAPON_SET[name] = true
end

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

local function integer(value: any, low: number, high: number): boolean
	return finite(value) and value &gt;= low and value &lt;= high and value % 1 == 0
end

local function identifier(value: any): boolean
	return type(value) == "string" and #value &gt; 0 and #value &lt;= MAX_IDENTIFIER and string.match(value, "^[%w_]+$") ~= nil
end

function Store.SoulLevel(attributes: Attributes): number
	local total = 0
	for _, name in ATTRIBUTES do
		total += attributes[name]
	end
	return total - ATTRIBUTE_BASE * #ATTRIBUTES + 1
end

-- Essence required to advance from `level` to `level + 1`.
function Store.LevelCost(level: number): number
	return Progression.levelCost(level)
end

-- Piecewise soft caps: full value per point to 40, reduced to 60, minimal beyond.
local function softCap(points: number, early: number, mid: number, late: number): number
	local spent = math.max(points - ATTRIBUTE_BASE, 0)
	local first = math.min(spent, 30)
	local second = math.clamp(spent - 30, 0, 20)
	local third = math.max(spent - 50, 0)
	return first * early + second * mid + third * late
end

Store.ReinforceMax = REINFORCE_MAX

-- Essence the blacksmith asks to raise a weapon from `level` to `level + 1`.
function Store.ReinforceCost(level: number): number
	local cost = Progression.upgradeCost(level)
 return cost
end

function Store.ReinforceLevel(souls: Souls, weapon: string): number
	local levels = souls.inventory.reinforcement
	return if levels then levels[weapon] or 0 else 0
end

function Store.DeriveStats(souls: Souls): DerivedStats
 local stats = Progression.stats(souls.attributes, Store.ReinforceLevel(souls, souls.inventory.mainhand))
 local rpg=(souls :: any).rpg
 local weapon=souls.inventory.mainhand
 local infusion=if rpg and rpg.Weapons[weapon] then rpg.Weapons[weapon].Infusion else nil
 local affinity=Progression.affinity(infusion,souls.attributes)
 local signature=rpg~=nil and Progression.masteryRank(rpg.Mastery[weapon] or 0)&gt;=5
 return {InfusionBurn=affinity.Burn,InfusionStun=affinity.Stun,GuardPierce=affinity.GuardPierce,VoidScale=affinity.VoidScale,SignatureFinisher=signature,
  MaxHP=Settings.Health.MaxHP+stats.HPBonus, MaxStamina=Settings.Stamina.Max+stats.StaminaBonus,
  PostureCapacity=Settings.Posture.StanceBreakThreshold+stats.PostureBonus, StrengthScale=stats.StrengthScale,
  DexterityScale=stats.DexterityScale, MaxQi=stats.MaxQi, RallyScale=stats.RallyScale, SpellScale=stats.SpellScale}
end

function Store.DefaultSouls(startingAltar: string?): Souls
	local weapons: { [string]: boolean } = {}
	for _, name in STARTING_WEAPONS do
		weapons[name] = true
	end
	local altar = startingAltar or DEFAULT_ALTAR
	return {
		version = SOULS_VERSION,
		level = 1,
		attributes = { Vigor = ATTRIBUTE_BASE, Endurance = ATTRIBUTE_BASE, ArcaneQi = ATTRIBUTE_BASE, Strength = ATTRIBUTE_BASE, Dexterity = ATTRIBUTE_BASE },
		essence = 0,
		inventory = {
			weapons = weapons,
			mainhand = "Jian",
			offhand = "Unarmed",
			elixirs = { charges = ELIXIR.BaseCharges, max = ELIXIR.BaseCharges, potency = 0 },
			reinforcement = {},
			spells = {ThunderclapPalm=true,GaleStep=true}, spellSlots={"ThunderclapPalm","GaleStep"}, remembrances={}, spentRemembrances={}, caches={},
		},
		-- tutorial: opening-training steps completed (TutorialRules ids, "Skipped" when declined).
		-- story: six-sovereign ending flags (EndingRules.Flags); they only ever gain entries.
		world = { altars = { [altar] = true }, activeAltar = altar, bosses = {}, bloodstain = nil, tutorial = {}, story = {} },
		deaths = 0,
	}
end

local function validBloodstain(stain: any): boolean
	if type(stain) ~= "table" then
		return false
	end
	for key in stain do
		if key ~= "region" and key ~= "x" and key ~= "y" and key ~= "z" and key ~= "essence" and key ~= "death" then
			return false
		end
	end
	return identifier(stain.region)
		and finite(stain.x) and math.abs(stain.x) &lt;= COORDINATE_LIMIT
		and finite(stain.y) and math.abs(stain.y) &lt;= COORDINATE_LIMIT
		and finite(stain.z) and math.abs(stain.z) &lt;= COORDINATE_LIMIT
		and integer(stain.essence, 0, MAX_SAFE_INTEGER)
		and integer(stain.death, 0, MAX_SAFE_INTEGER)
end

local function validFlagSet(set: any): boolean
	if type(set) ~= "table" then
		return false
	end
	local count = 0
	for key, value in set do
		count += 1
		if count &gt; MAX_WORLD_ENTRIES or not identifier(key) or value ~= true then
			return false
		end
	end
	return true
end

function Store.ValidateSouls(raw: any): (boolean, string?)
	if type(raw) ~= "table" then
		return false, "Missing souls record"
	end
	if raw.version ~= SOULS_VERSION then
		return false, "Unsupported souls version"
	end
	local attributes = raw.attributes
	if type(attributes) ~= "table" then
		return false, "Missing attributes"
	end
	for _, name in ATTRIBUTES do
		if not integer(attributes[name], ATTRIBUTE_BASE, ATTRIBUTE_MAX) then
			return false, "Invalid attribute " .. name
		end
	end
	for key in attributes do
		if table.find(ATTRIBUTES, key) == nil then
			return false, "Unknown attribute"
		end
	end
	if raw.level ~= Store.SoulLevel(attributes) then
		return false, "Level does not match attributes"
	end
	if not integer(raw.essence, 0, MAX_SAFE_INTEGER) or not integer(raw.deaths, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid essence or deaths"
	end
	local inventory = raw.inventory
	if type(inventory) ~= "table" or type(inventory.weapons) ~= "table" then
		return false, "Missing inventory"
	end
	if not Arsenal.validate(inventory) then return false, "Invalid arsenal inventory" end
	for name, owned in inventory.weapons do
		if not WEAPON_SET[name] or owned ~= true then
			return false, "Invalid weapon ownership"
		end
	end
	if inventory.weapons.Unarmed ~= true then
		return false, "Unarmed discipline must remain unlocked"
	end
	if type(inventory.mainhand) ~= "string" or inventory.weapons[inventory.mainhand] ~= true then
		return false, "Mainhand must be unlocked"
	end
	if inventory.offhand ~= "None" and (type(inventory.offhand) ~= "string" or inventory.weapons[inventory.offhand] ~= true) then
		return false, "Offhand must be unlocked or None"
	end
	local elixirs = inventory.elixirs
	if type(elixirs) ~= "table" or not integer(elixirs.max, ELIXIR.BaseCharges, ELIXIR.MaxCharges)
		or not integer(elixirs.charges, 0, elixirs.max) or not integer(elixirs.potency, 0, 10) then
		return false, "Invalid elixirs"
	end
	if type(inventory.reinforcement) ~= "table" then
		return false, "Missing reinforcement"
	end
	for name, level in inventory.reinforcement do
		if not WEAPON_SET[name] or not integer(level, 1, REINFORCE_MAX) then
			return false, "Invalid reinforcement"
		end
	end
	local world = raw.world
	if type(world) ~= "table" or not validFlagSet(world.altars) or not validFlagSet(world.bosses) then
		return false, "Invalid world state"
	end
	if not identifier(world.activeAltar) or world.altars[world.activeAltar] ~= true then
		return false, "Active altar must be activated"
	end
	if world.tutorial ~= nil and not validFlagSet(world.tutorial) then
		return false, "Invalid tutorial progress"
	end
	if world.story ~= nil and not validFlagSet(world.story) then
		return false, "Invalid story progress"
	end
	if world.bloodstain ~= nil and not validBloodstain(world.bloodstain) then
		return false, "Invalid bloodstain"
	end
	return true, nil
end

function Store.MigrateSouls(raw: any, startingAltar: string?): Souls
	local souls = Store.DefaultSouls(startingAltar)
	if type(raw) ~= "table" then
		return souls
	end
	if finite(raw.version) and raw.version &gt; SOULS_VERSION then
		error("Souls record is newer than this server supports", 0)
	end
	if raw.version == SOULS_VERSION then assert(Arsenal.validate(raw.inventory),"Corrupt arsenal inventory") end
	if type(raw.attributes) == "table" then
		for _, name in ATTRIBUTES do
			local value = raw.attributes[name]
            if value == nil then value = if name == "Vigor" then raw.attributes.Vitality elseif name == "Endurance" then raw.attributes.Qi else nil end
			if integer(value, ATTRIBUTE_BASE, ATTRIBUTE_MAX) then
				souls.attributes[name] = value
			end
		end
	end
	souls.level = Store.SoulLevel(souls.attributes)
	if integer(raw.essence, 0, MAX_SAFE_INTEGER) then
		souls.essence = raw.essence
	end
	if integer(raw.deaths, 0, MAX_SAFE_INTEGER) then
		souls.deaths = raw.deaths
	end
	local inventory = raw.inventory
	if type(inventory) == "table" then
		if type(inventory.weapons) == "table" then
			for name, owned in inventory.weapons do
				if WEAPON_SET[name] and owned == true then
					souls.inventory.weapons[name] = true
				end
			end
		end
		if type(inventory.mainhand) == "string" and souls.inventory.weapons[inventory.mainhand] then
			souls.inventory.mainhand = inventory.mainhand
		end
		if inventory.offhand == "None" or (type(inventory.offhand) == "string" and souls.inventory.weapons[inventory.offhand]) then
			souls.inventory.offhand = inventory.offhand
		end
		local elixirs = inventory.elixirs
		if type(elixirs) == "table" then
			if integer(elixirs.max, ELIXIR.BaseCharges, ELIXIR.MaxCharges) then
				souls.inventory.elixirs.max = elixirs.max
			end
			if integer(elixirs.charges, 0, souls.inventory.elixirs.max) then
				souls.inventory.elixirs.charges = elixirs.charges
			else
				souls.inventory.elixirs.charges = souls.inventory.elixirs.max
			end
			if integer(elixirs.potency, 0, 10) then
				souls.inventory.elixirs.potency = elixirs.potency
			end
		end
		if type(inventory.reinforcement) == "table" then
			for name, level in inventory.reinforcement do
				if WEAPON_SET[name] and integer(level, 1, REINFORCE_MAX) then
					souls.inventory.reinforcement[name] = level
				end
			end
		end
	end
	local world = raw.world
	if type(world) == "table" then
		if validFlagSet(world.altars) then
			for id in world.altars do
				souls.world.altars[id] = true
			end
		end
		if validFlagSet(world.tutorial) then -- older records simply start the training fresh
			for id in world.tutorial do
				(souls.world.tutorial :: { [string]: boolean })[id] = true
			end
		end
		if validFlagSet(world.story) then -- older records have made no ending choice yet
			for id in world.story do
				(souls.world.story :: { [string]: boolean })[id] = true
			end
		end
		if validFlagSet(world.bosses) then
			for id in world.bosses do
				souls.world.bosses[id] = true
			end
		end
		if identifier(world.activeAltar) and souls.world.altars[world.activeAltar] then
			souls.world.activeAltar = world.activeAltar
		end
		-- A corrupt bloodstain is dropped rather than repaired: its essence was already forfeit.
		if world.bloodstain ~= nil and validBloodstain(world.bloodstain) then
			souls.world.bloodstain = copy(world.bloodstain)
		end
	end
	local migratedArsenal = Arsenal.migrate(if type(raw)=="table" then raw.inventory else nil)
	for key,value in migratedArsenal do (souls.inventory :: any)[key]=value end
	for bossId in souls.world.bosses do Arsenal.award(souls.inventory,bossId) end
	assert(Store.ValidateSouls(souls))
	return souls
end

-- Wraps an account schema so every migrated profile carries a validated `souls` section.
function Store.WithSouls(schema: Schema, startingAltar: string?): Schema
	return {
		Migrate = function(raw: any, id: number): any
			local profile = schema.Migrate(raw, id)
			profile.souls = Store.MigrateSouls(if type(raw) == "table" then raw.souls else nil, startingAltar)
			Bridge.toSouls(profile)
			return profile
		end,
		Validate = function(profile: any): (boolean, string?)
			local ok, err = schema.Validate(profile)
			if not ok then
				return ok, err
			end
			return Store.ValidateSouls(profile.souls)
		end,
		Level = schema.Level,
	}
end

-------------------------------------------------------------------------------------------------
-- Storage engine
-------------------------------------------------------------------------------------------------

function Store.new(dataStore: DataStore, schema: Schema, options: Options): Engine
	local self = {
		dataStore = dataStore,
		schema = Store.WithSouls(schema, options.startingAltar),
		options = options,
		profiles = {},
		busy = {},
		closed = false,
		operation = 0,
	}
	return setmetatable(self, Store) :: any
end

function Store.Retry(self: Engine, fn: () -&gt; any): (boolean, any)
	local err: any
	for attempt = 1, self.options.attempts do
		local ok, value = pcall(fn)
		if ok then
			return true, value
		end
		err = value
		if attempt &lt; self.options.attempts then
			self.options.wait(math.min(2 ^ (attempt - 1), 4))
		end
	end
	return false, tostring(err)
end

function Store.Load(self: Engine, id: number): (any, string?)
	if self.closed then
		return nil, "Server is closing"
	end
	if self.profiles[id] then
		return self:Get(id), nil
	end
	if self.busy[id] then
		return nil, "Profile is busy"
	end
	self.busy[id] = true
	local now = self.options.now
	local ok, record = self:Retry(function()
		return self.dataStore:UpdateAsync("Player_" .. id, function(old: any): any
			if old ~= nil and type(old) ~= "table" then
				error("Corrupt profile record")
			end
			local envelope = old and old.storageVersion ~= nil
			if envelope and old.storageVersion ~= 2 then
				error("Unsupported storage version")
			end
			if envelope and (type(old.profile) ~= "table" or type(old.revision) ~= "number") then
				error("Invalid storage envelope")
			end
			local lease = envelope and old.session
			if lease and (type(lease) ~= "table" or type(lease.id) ~= "string" or type(lease.expires) ~= "number") then
				error("Invalid lease")
			end
			if lease and lease.id ~= self.options.owner and lease.expires &gt; now() then
				return nil
			end
			local raw = if envelope then old.profile else old
			if raw and raw.userId ~= nil and raw.userId ~= id then
				error("Profile owner mismatch")
			end
			local profile = self.schema.Migrate(raw, id)
			assert(self.schema.Validate(profile))
			return bounded({
				storageVersion = 2,
				revision = (if envelope then old.revision else 0) + 1,
				profile = profile,
				session = { id = self.options.owner, expires = now() + self.options.leaseSeconds },
			})
		end)
	end)
	self.busy[id] = nil
	if not ok or not record then
		return nil, if ok then "Profile is active on another server" else record
	end
	self.profiles[id] = record
	return self:Get(id), nil
end

function Store.Get(self: Engine, id: number): any
	local record = self.profiles[id]
	if not record or not record.session or record.session.expires &lt;= self.options.now() then
		return nil
	end
	return copy(record.profile)
end

-- One transaction per user. Failed/ambiguous writes never expose speculative rewards to gameplay.
function Store.Transaction(self: Engine, id: number, mutate: (profile: any) -&gt; (), release: boolean?): (boolean, string?)
	local localRecord = self.profiles[id]
	if not localRecord or not self:Get(id) then
		return false, "Profile session unavailable"
	end
	if self.busy[id] then
		return false, "Profile is busy"
	end
	self.busy[id] = true
	self.operation += 1
	local operationId = self.options.owner .. ":" .. self.operation
	local ok, result = self:Retry(function()
		return self.dataStore:UpdateAsync("Player_" .. id, function(old: any): any
			if not old or old.storageVersion ~= 2 or not old.session or old.session.id ~= self.options.owner
				or old.session.expires &lt;= self.options.now() then
				return nil
			end
			if old.lastOperation == operationId then
				return old
			end
			local candidate = self.schema.Migrate(old.profile, id)
			local baseline = Bridge.snapshot(candidate)
			mutate(candidate)
			Bridge.reconcile(candidate, baseline)
			candidate.lastSaveTime = self.options.now()
			assert(self.schema.Validate(candidate))
			return bounded({
				storageVersion = 2,
				revision = old.revision + 1,
				profile = candidate,
				lastOperation = operationId,
				session = if release then nil else { id = self.options.owner, expires = self.options.now() + self.options.leaseSeconds },
			})
		end)
	end)
	self.busy[id] = nil
	if not ok or not result then
		-- Ownership refusal invalidates local access immediately. API errors leave only the last confirmed cache.
		if ok then
			self.profiles[id] = nil
		end
		return false, if ok then "Profile ownership lost" else result
	end
	self.profiles[id] = if release then nil else result
	return true, nil
end

function Store.Save(self: Engine, id: number): (boolean, string?)
	return self:Transaction(id, function() end)
end

function Store.Release(self: Engine, id: number): (boolean, string?)
	return self:Transaction(id, function() end, true)
end

function Store.Receipt(self: Engine, id: number, purchaseId: any, productId: number, grant: (profile: any) -&gt; ()): (boolean, string?)
	if type(purchaseId) ~= "string" or #purchaseId == 0 or #purchaseId &gt; 200 then
		return false, "Invalid receipt ID"
	end
	return self:Transaction(id, function(p)
		local previous = p.receipts[purchaseId]
		if previous then
			assert(previous == productId, "Receipt product mismatch")
			return
		end
		local count = 0
		for _ in p.receipts do
			count += 1
		end
		assert(count &lt; 10000, "Receipt ledger full; archival required") -- Never evict an idempotency key.
		grant(p)
		p.receipts[purchaseId] = productId
	end)
end

function Store.ApplyResult(self: Engine, id: number, matchId: string, result: any): (boolean, string?)
	return self:Transaction(id, function(p)
		if p.appliedMatches[matchId] then
			p.pendingMatches[matchId] = nil
			return
		end
		assert(p.pendingMatches[matchId], "Result was not registered before match start")
		assert(result.userId == id and result.mode == "Ranked1v1", "Invalid ranked result")
		local count = 0
		for _ in p.appliedMatches do
			count += 1
		end
		assert(count &lt; 10000, "Result ledger full; archival required")
		p.elo = math.clamp(p.elo + result.eloDelta, 0, 5000)
		p.peakElo = math.max(p.peakElo, p.elo)
		p.qiEssence += result.cash
		if result.outcome == "Win" then
			p.wins += 1
			p.winStreak += 1
		elseif result.outcome == "Draw" then
			p.draws += 1
			p.winStreak = 0
		else
			p.losses += 1
			p.winStreak = 0
		end
		local style = assert(p.styles[result.style])
		assert(style.unlocked)
		local multiplier = if p.ownedCosmetics.VIP_Pass then 2 else 1
		style.xp += result.xp * multiplier
		style.level = self.schema.Level(style.xp)
		p.appliedMatches[matchId] = true
		p.pendingMatches[matchId] = nil
	end)
end

-------------------------------------------------------------------------------------------------
-- Souls progression transactions. Each pre-checks against the confirmed cache, then re-checks
-- inside the write so a refused change is a no-op rather than a retried error.
-------------------------------------------------------------------------------------------------

function Store.Souls(self: Engine, id: number): Souls?
	local profile = self:Get(id)
	return if profile then profile.souls else nil
end

function Store.ActivateAltar(self: Engine, id: number, altarId: string, setActive: boolean, refillElixirs: boolean): (boolean, string?)
	if not identifier(altarId) then
		return false, "Invalid altar"
	end
	return self:Transaction(id, function(p)
		local world = p.souls.world
		local count = 0
		for _ in world.altars do
			count += 1
		end
		if not world.altars[altarId] and count &lt; MAX_WORLD_ENTRIES then
			world.altars[altarId] = true
		end
		if setActive and world.altars[altarId] then
			world.activeAltar = altarId
		end
		if refillElixirs then
			p.souls.inventory.elixirs.charges = p.souls.inventory.elixirs.max
		end
	end)
end

function Store.SetElixirCharges(self: Engine, id: number, charges: number): (boolean, string?)
	if not integer(charges, 0, ELIXIR.MaxCharges) then
		return false, "Invalid charges"
	end
	return self:Transaction(id, function(p)
		local elixirs = p.souls.inventory.elixirs
		elixirs.charges = math.min(charges, elixirs.max)
	end)
end

function Store.AddElixirCapacity(self: Engine, id: number): (boolean, string?)
	local souls = self:Souls(id)
	if not souls then
		return false, "Profile session unavailable"
	end
	if souls.inventory.elixirs.max &gt;= ELIXIR.MaxCharges then
		return false, "Gourd already at capacity"
	end
	return self:Transaction(id, function(p)
		local elixirs = p.souls.inventory.elixirs
		if elixirs.max &lt; ELIXIR.MaxCharges then
			elixirs.max += 1
			elixirs.charges = math.min(elixirs.charges + 1, elixirs.max)
		end
	end)
end

function Store.GrantEssence(self: Engine, id: number, amount: number): (boolean, string?)
	if not integer(amount, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid essence amount"
	end
	if amount == 0 then
		return true, nil
	end
	return self:Transaction(id, function(p)
		p.souls.essence = math.min(MAX_SAFE_INTEGER, p.souls.essence + amount)
	end)
end

-- Death: unbanked session essence joins the carried total, all of it drops into a new bloodstain,
-- and any previous unrecovered bloodstain is destroyed. Returns the essence now in the stain.
function Store.RecordDeath(self: Engine, id: number, region: string, x: number, y: number, z: number, unbanked: number): (boolean, string?, number)
	if not identifier(region) or not finite(x) or not finite(y) or not finite(z) or not integer(unbanked, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid death record", 0
	end
	local dropped = 0
	local ok, err = self:Transaction(id, function(p)
		local souls = p.souls
		souls.deaths = math.min(MAX_SAFE_INTEGER, souls.deaths + 1)
		dropped = math.min(MAX_SAFE_INTEGER, souls.essence + unbanked)
		souls.essence = 0
		souls.world.bloodstain = if dropped &gt; 0
			then {
				region = region,
				x = math.clamp(x, -COORDINATE_LIMIT, COORDINATE_LIMIT),
				y = math.clamp(y, -COORDINATE_LIMIT, COORDINATE_LIMIT),
				z = math.clamp(z, -COORDINATE_LIMIT, COORDINATE_LIMIT),
				essence = dropped,
				death = souls.deaths,
			}
			else nil
	end)
	return ok, err, if ok then dropped else 0
end

function Store.RecoverBloodstain(self: Engine, id: number, deathIndex: number): (boolean, string?, number)
	local souls = self:Souls(id)
	local stain = souls and souls.world.bloodstain
	if not stain or stain.death ~= deathIndex then
		return false, "No matching bloodstain", 0
	end
	local recovered = 0
	local ok, err = self:Transaction(id, function(p)
		local current = p.souls.world.bloodstain
		if current and current.death == deathIndex then
			recovered = current.essence
			p.souls.essence = math.min(MAX_SAFE_INTEGER, p.souls.essence + current.essence)
			p.souls.world.bloodstain = nil
		end
	end)
	return ok, err, if ok then recovered else 0
end

function Store.LevelAttribute(self: Engine, id: number, attribute: AttributeName): (boolean, string?)
	local canonical: any = attribute
	if canonical == "Vitality" then canonical = "Vigor" end
	if canonical == "Qi" then canonical = "Endurance" end
	if table.find(ATTRIBUTES, canonical) == nil then
		return false, "Unknown attribute"
	end
	attribute = canonical
	local souls = self:Souls(id)
	if not souls then
		return false, "Profile session unavailable"
	end
	if souls.attributes[attribute] &gt;= ATTRIBUTE_MAX then
		return false, "Attribute at maximum"
	end
	local cost = Store.LevelCost(souls.level)
	if souls.essence &lt; cost then
		return false, "Not enough essence"
	end
	local applied = false
	local ok, err = self:Transaction(id, function(p)
		local s = p.souls
		local price = Store.LevelCost(s.level)
		if s.essence &gt;= price and s.attributes[attribute] &lt; ATTRIBUTE_MAX then
			s.essence -= price
			s.attributes[attribute] += 1
			s.level = Store.SoulLevel(s.attributes)
			applied = true
		end
	end)
	if ok and not applied then
		return false, "Level refused"
	end
	return ok, err
end

function Store.RecordBossDefeat(self: Engine, id: number, bossId: string, essence: number): (boolean, string?)
	if not identifier(bossId) or not integer(essence, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid boss record"
	end
	return self:Transaction(id, function(p)
		Arsenal.award(p.souls.inventory, bossId)
		local bosses = p.souls.world.bosses
		local count = 0
		for _ in bosses do
			count += 1
		end
		if not bosses[bossId] and count &lt; MAX_WORLD_ENTRIES then
			bosses[bossId] = true
            local materials=p.inventory.Materials
            materials.SpiritIronOre=(materials.SpiritIronOre or 0)+8
            materials.StarfallShard=(materials.StarfallShard or 0)+4
            materials.DragoniteCore=(materials.DragoniteCore or 0)+2
            local gems={"CrimsonFireGem","CelestialLightningGem","AbyssalVoidGem"}
            local gem=gems[(count%3)+1];materials[gem]=(materials[gem] or 0)+1
			p.souls.essence = math.min(MAX_SAFE_INTEGER, p.souls.essence + essence)
		end
	end)
end

function Store.UnlockWeapon(self: Engine, id: number, weapon: string): (boolean, string?)
	if not WEAPON_SET[weapon] then
		return false, "Unknown weapon"
	end
	return self:Transaction(id, function(p)
		p.souls.inventory.weapons[weapon] = true
	end)
end

-- Blacksmith: spends banked essence to raise one weapon's reinforcement by a level.
-- Returns the new level on success.
function Store.ReinforceWeapon(self: Engine, id: number, weapon: string): (boolean, string?, number)
	if not WEAPON_SET[weapon] then
		return false, "Unknown weapon", 0
	end
 local reached=0
 local ok,err=self:Transaction(id,function(p: any)
  Progression.upgrade(p,weapon);reached=p.inventory.Weapons[weapon].Level
 end)
 return ok,err,reached
end

function Store.EquipLoadout(self: Engine, id: number, mainhand: string, offhand: string): (boolean, string?)
	local souls = self:Souls(id)
	if not souls then
		return false, "Profile session unavailable"
	end
	local weapons = souls.inventory.weapons
	if not weapons[mainhand] or (offhand ~= "None" and not weapons[offhand]) then
		return false, "Weapon is locked"
	end
	return self:Transaction(id, function(p)
		local inventory = p.souls.inventory
		if inventory.weapons[mainhand] and (offhand == "None" or inventory.weapons[offhand]) then
			inventory.mainhand = mainhand
			inventory.offhand = offhand
		end
	end)
end

return Store
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">RecoveryRules</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/RecoveryRules
-- Death and respawn lifecycle rules shared by CharacterService, WorldService and SanctuaryService.
-- Player:LoadCharacter can position a new body after CharacterAdded handlers have placed it, which
-- dropped later-altar respawns at the engine default spawn where the Sanctuary fall safeguard then
-- returned them to the bonfire. A respawn now holds its target through a short settle window and
-- re-asserts it when the body is displaced; the safeguard only catches bodies that fell from the
-- Sanctuary. Pure: callers supply the ground probe and positions.
local RecoveryRules = {}

export type Probe = (origin: Vector3, direction: Vector3) -&gt; Vector3?
export type Hold = { Target: CFrame, Until: number, Corrections: number }
export type Verdict = "Hold" | "Correct" | "Release"
export type FallState = { Aloft: boolean }
export type FallLimits = { Radius: number, FloorY: number }
export type Life = { Life: number, DeathLife: number }

-- A respawned body is checked for this long; walking or dashing never covers TOLERANCE studs in it.
RecoveryRules.SETTLE_SECONDS = 1.5
RecoveryRules.TOLERANCE = 48
RecoveryRules.MAX_CORRECTIONS = 8
local PROBE_UP = 2
local PROBE_DOWN = 40

-- Stands the root on the first floor under the spawn so no checkpoint drops or buries the body.
function RecoveryRules.standing(spawn: CFrame, rootHeight: number, probe: Probe?): CFrame
	if not probe then
		return spawn
	end
	local hit = probe(spawn.Position + Vector3.yAxis * PROBE_UP, Vector3.yAxis * -(PROBE_UP + PROBE_DOWN))
	if not hit then
		return spawn
	end
	return spawn + Vector3.yAxis * (hit.Y + rootHeight - spawn.Position.Y)
end

function RecoveryRules.begin(target: CFrame, now: number): Hold
	return { Target = target, Until = now + RecoveryRules.SETTLE_SECONDS, Corrections = 0 }
end

function RecoveryRules.check(hold: Hold, position: Vector3, now: number): Verdict
	if now &gt;= hold.Until or hold.Corrections &gt;= RecoveryRules.MAX_CORRECTIONS then
		return "Release"
	end
	if (position - hold.Target.Position).Magnitude &gt; RecoveryRules.TOLERANCE then
		hold.Corrections += 1
		return "Correct"
	end
	return "Hold"
end

-- Sanctuary fall recovery: only a body last seen in the Sanctuary is caught when it drops below the
-- shrine. Ground regions, the unclaimed space between them and respawn placement are never caught.
function RecoveryRules.sanctuaryFall(state: FallState, region: string?, flat: number, y: number, settling: boolean, limits: FallLimits): boolean
	if settling then
		state.Aloft = false
		return false
	end
	if region == "Sanctuary" then
		state.Aloft = true
	elseif region ~= nil then
		state.Aloft = false
	end
	return state.Aloft and flat &lt; limits.Radius and y &lt; limits.FloorY
end

-- One death penalty per life: duplicate KO reports before the next respawn are ignored.
function RecoveryRules.claimDeath(life: Life): boolean
	if life.DeathLife == life.Life then
		return false
	end
	life.DeathLife = life.Life
	return true
end

function RecoveryRules.spawned(life: Life)
	life.Life += 1
end

-- Where altar travel sets the fighter down: the altar's spawn when that is within resting reach,
-- otherwise (radius - 1) studs from the altar on the spawn's side, at spawn height. The Primal
-- Bonfire's spawn (also the prologue start) is 20 studs out, so travel landed there, refused to
-- rest ("TooFar") and left the previous checkpoint active (F04).
function RecoveryRules.arrival(spawn: Vector3, anchor: Vector3, radius: number): Vector3
	if (spawn - anchor).Magnitude &lt;= radius + 2 then
		return spawn
	end
	local flat = Vector3.new(spawn.X - anchor.X, 0, spawn.Z - anchor.Z)
	local direction = if flat.Magnitude &gt; 1e-3 then flat.Unit else Vector3.zAxis
	return Vector3.new(anchor.X, spawn.Y, anchor.Z) + direction * (radius - 1)
end

return RecoveryRules
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="152">
          <Properties>
            <string name="Name">RegionDecor</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/RegionDecor
-- Builders shared by the authored campaign regions (batches 16-21). Layout boxes become parts in
-- the Monastery's slate / lacquer / tile / granite vocabulary (batch 15, #32): every Kind maps to one
-- material and palette entry, no Neon or SmoothPlastic. Everything added here beyond a layout box is
-- decor (no collision, no queries), so the offline reachability suite sees every surface that can
-- stop a body or a camera.
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Fx = require(script.Parent:WaitForChild("MonasteryFx") :: ModuleScript)

local Decor = {}
local P = Kit.Palette
local M = Enum.Material
local rgb = Color3.fromRGB

Decor.Style = table.freeze({
	Path = { M.Slate, P.FlagDark }, Ground = { M.Ground, rgb(66, 58, 50) }, Grass = { M.Grass, rgb(70, 82, 58) },
	Rock = { M.Rock, rgb(74, 76, 80) }, Snow = { M.Snow, rgb(214, 222, 226) }, Timber = { M.Wood, P.WoodDark },
	Lacquer = { M.Wood, P.Lacquer }, Stone = { M.Slate, P.Stone }, Ash = { M.Ground, rgb(58, 54, 54) },
	Basalt = { M.Basalt, rgb(64, 60, 62) }, Crypt = { M.Slate, rgb(70, 78, 84) }, Marble = { M.Marble, rgb(196, 192, 184) },
	Bone = { M.Limestone, rgb(206, 196, 170) }, Water = { M.Glass, rgb(40, 74, 82) }, Tile = { M.Slate, rgb(86, 82, 80) },
})

-- One layout box as a part. Veils collide but are invisible to eyes, cameras and queries.
function Decor.solid(parent: Instance, b: any): BasePart
	local cf = CFrame.new(b.X, b.Y, b.Z) * CFrame.Angles(0, math.rad(b.Yaw), 0)
	if b.Kind == "Veil" then
		return Kit.part(parent, "MistVeil", Vector3.new(b.SX, b.SY, b.SZ), cf, P.Mist, M.Slate, { Collide = true, Query = false, Transparency = 1, Shadow = false })
	end
	local style = Decor.Style[b.Kind]
	local p = Kit.part(parent, b.Name, Vector3.new(b.SX, b.SY, b.SZ), cf, style[2], style[1])
	if b.Kind == "Water" then
		p.Transparency, p.Reflectance = 0.15, 0.3
	end
	return p
end

-- Paper lantern head on a post (or hung from a beam): warm light, glow, never collides.
function Decor.lantern(parent: Instance, x: number, y: number, z: number, range: number?)
	local base = CFrame.new(x, y, z)
	local paper = Kit.part(parent, "LanternPaper", Vector3.new(1.4, 1.6, 1.4), base, P.Lantern, M.Glass,
		{ Collide = false, Query = false, Transparency = 0.25, Shadow = false })
	Kit.part(parent, "LanternCap", Vector3.new(2.2, 0.35, 2.2), base * CFrame.new(0, 1, 0), P.Iron, M.Metal, Kit.decor())
	Fx.glow(paper, 1.1)
	Kit.light(paper, P.Lantern, range or 20, 1.3, false)
end

-- Blender-built Bamboo Pass art (tools/blender/bamboo_karst_kit.py): Bamboo_A/B/C stalks 40 studs tall
-- and Karst_A/B/C towers ~107 studs tall, each pivoted at its foot centre. Nil when the kit is missing.
local KIT_HEIGHT = { Bamboo = 41, Karst = 107 }
function Decor.kit(kind: string, rng: Random): Model?
	local kit = game:GetService("ServerStorage"):FindFirstChild("AsuraBambooKit")
	local piece = kit and kit:FindFirstChild(kind .. "_" .. ({ "A", "B", "C" })[rng:NextInteger(1, 3)])
	return if piece and piece:IsA("Model") then piece:Clone() else nil
end

-- Places a kit clone `height` studs tall with its foot at `base`.
function Decor.placeKit(parent: Instance, model: Model, kind: string, base: CFrame, height: number)
	model:ScaleTo(height / KIT_HEIGHT[kind])
	model:PivotTo(base)
	model.Parent = parent
end

-- One bamboo stalk with its leaf sprays; decor, so groves never trap bodies or cameras.
function Decor.bamboo(parent: Instance, x: number, floor: number, z: number, rng: Random)
	local height = rng:NextNumber(26, 44)
	local lean = CFrame.Angles(math.rad(rng:NextNumber(-5, 5)), 0, math.rad(rng:NextNumber(-5, 5)))
	local base = CFrame.new(x, floor, z) * lean
	local stalk = Decor.kit("Bamboo", rng)
	if stalk then
		Decor.placeKit(parent, stalk, "Bamboo", base * CFrame.Angles(0, rng:NextNumber(0, 2 * math.pi), 0), height)
		return
	end
	local green = rgb(78, 104, 66):Lerp(rgb(132, 140, 92), rng:NextNumber())
	Kit.part(parent, "BambooStalk", Vector3.new(height, 0.9, 0.9), base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		green, M.Wood, { Collide = false, Query = false, Shadow = true, Shape = Enum.PartType.Cylinder })
	if rng:NextNumber() &lt; 0.6 then
		Kit.part(parent, "BambooCrown", Vector3.new(rng:NextNumber(5, 8), 2.2, rng:NextNumber(5, 8)), base * CFrame.new(0, height - 2, 0)
			* CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), rgb(88, 116, 70), M.LeafyGrass, Kit.decor())
	end
end

-- Scatter `count` items over {x0, x1, z0, z1, floor, count} with `place(x, floor, z)`.
function Decor.scatter(grove: { number }, rng: Random, place: (number, number, number) -&gt; ())
	for _ = 1, grove[6] do
		place(rng:NextNumber(grove[1], grove[2]), grove[5], rng:NextNumber(math.min(grove[3], grove[4]), math.max(grove[3], grove[4])))
	end
end

-- Curved-eave tile roof (two slopes, ridge, upturned horns), decor; `base` is the eave line centre.
function Decor.roof(parent: Instance, base: CFrame, width: number, depth: number, rise: number, color: Color3?)
	local tone = color or P.Roof
	local slope = math.atan(rise / (depth / 2))
	local length = math.sqrt((depth / 2) ^ 2 + rise ^ 2) + 1
	for _, side in { -1, 1 } do
		Kit.part(parent, "RoofSlope", Vector3.new(width, 0.6, length), base * CFrame.new(0, rise / 2, side * depth / 4) * CFrame.Angles(side * slope, 0, 0),
			tone, M.Slate, Kit.decor())
		Kit.beam(parent, "EaveHorn", (base * CFrame.new(side * width / 2, 0, 0)).Position, (base * CFrame.new(side * (width / 2 + 2), 1.6, 0)).Position, 0.5, P.Iron, M.Metal)
	end
	Kit.part(parent, "RoofRidge", Vector3.new(width + 1, 0.7, 0.7), base * CFrame.new(0, rise + 0.2, 0), P.Iron, M.Metal, Kit.decor())
end

-- Hanging banner (crimson cloth on a crossbar); decor.
function Decor.banner(parent: Instance, top: CFrame, height: number, color: Color3?)
	Kit.part(parent, "BannerBar", Vector3.new(4.4, 0.3, 0.3), top, P.Iron, M.Metal, Kit.decor())
	Kit.part(parent, "BannerCloth", Vector3.new(3.6, height, 0.12), top * CFrame.new(0, -height / 2 - 0.2, 0), color or P.Lacquer, M.Fabric, Kit.decor())
end

-- Iron brazier with fire, embers and a warm light; decor.
function Decor.brazier(parent: Instance, base: CFrame, range: number?)
	Kit.part(parent, "BrazierLeg", Vector3.new(0.6, 3, 0.6), base * CFrame.new(0, 1.5, 0), P.Iron, M.Metal, Kit.decor())
	local bowl = Kit.part(parent, "BrazierBowl", Vector3.new(2.6, 0.8, 2.6), base * CFrame.new(0, 3.2, 0), P.Iron, M.Metal, Kit.decor())
	Fx.glow(bowl, 1.8)
	Fx.embers(bowl, 6)
	Kit.light(bowl, rgb(255, 160, 90), range or 24, 1.6, false)
end

return Decor
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="153">
          <Properties>
            <string name="Name">SanctuaryApproach</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryApproach
-- Builds the batch 16 player-scale routes (SanctuaryRoutes) into the existing shrine without touching
-- the imported colossus, the plaza or the gate: the pilgrim walk and the Well of Descent (the Sunken
-- Crypt portal itself is BossArenas'), the cloud shards and the Reliquary isle, the loggia's service
-- ledge and lookout rails, the viewing wings and pilgrim daises, and the terrace rim parapet. Decor
-- here marks the crypt leg plainly - a moon gate, a carved sign, lanterns down the walk - and keeps
-- the story exit (the northern gate) the only lit gate on the main axis.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared
local Routes = require(Shared.SanctuaryRoutes)
local Kit = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)
local Decor = require(script.Parent:WaitForChild("RegionDecor") :: ModuleScript)
local Lobby = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Rails = require(script.Parent:WaitForChild("SanctuaryRails") :: ModuleScript)
local Frame = require(script.Parent:WaitForChild("SanctuaryFrame") :: ModuleScript)

local Approach = {}
local P = Kit.Palette
local M = Enum.Material
local rgb = Color3.fromRGB
local JADE = rgb(111, 170, 164)
-- Lobby rebuild: route walls keep their collision under a carved kit balustrade; route floors take
-- the shrine's shared stone surfaces (the boxes themselves, and so the offline suites, are unchanged).
local RAILS = { WingRail = true, PavilionRail = true, PilgrimRail = true }
local COLUMNS = { WellColumn = true } -- collision for the Well pavilion's kit columns
local SURFACES = { ViewingWing = "Paving", PilgrimWalk = "PavingPath", DescentPavilion = "Paving", ServiceLedge = "Stone",
	ReliquaryIsle = "Stone", PilgrimDais = "Stone", TerraceParapet = "StoneDark" }

local ServerStorage = game:GetService("ServerStorage")

-- Cloud Reliquary art (tools/blender/reliquary_kit.py): carved stone on floating karst. Each template's
-- pivot is its walkable top centre; the route box under it stays the (now invisible) walk surface.
local function reliquary(name: string): Model?
	local kit = ServerStorage:FindFirstChild("AsuraReliquaryKit")
	local piece = kit and kit:FindFirstChild(name)
	return if piece and piece:IsA("Model") then piece else nil
end

local function reliquaryPiece(box: any): string?
	if string.sub(box.Name, 1, 10) == "CloudShard" then return "Reliquary_Shard" end
	if box.Name == "ReliquaryIsle" then return "Reliquary_Isle" end
	return nil
end

-- The loggia lookout is a timber deck: its rail walls keep their collision under an open timber
-- railing (posts, top and mid rails, balusters) rather than reading as solid black panels.
local function timberRail(group: Instance, a: Vector3, b: Vector3)
	local length = (b - a).Magnitude
	local along = CFrame.lookAt(a, b)
	local function piece(name: string, size: Vector3, offset: Vector3)
		Lobby.slab(group, name, size, along * CFrame.new(offset), "Timber", Lobby.decor())
	end
	piece("LookoutTopRail", Vector3.new(0.34, 0.26, length + 0.3), Vector3.new(0, 2.35, -length / 2))
	piece("LookoutMidRail", Vector3.new(0.22, 0.18, length), Vector3.new(0, 1.15, -length / 2))
	local posts = math.max(1, math.round(length / 2.6))
	for i = 0, posts do
		piece("LookoutPost", Vector3.new(0.42, 2.5, 0.42), Vector3.new(0, 1.25, -length * i / posts))
	end
	local balusters = math.max(2, math.floor(length / 0.65))
	for i = 1, balusters - 1 do
		piece("LookoutBaluster", Vector3.new(0.14, 2.2, 0.14), Vector3.new(0, 1.15, -length * i / balusters))
	end
end

local function solid(group: Instance, box: any)
	local p = Decor.solid(group, box)
	if box.Name == "LookoutRail" and Lobby.available() then
		p.Transparency = 1
		local axis = p.CFrame.LookVector * box.SZ / 2
		local floor = Vector3.new(box.X, box.Y - box.SY / 2, box.Z)
		timberRail(group, floor - axis, floor + axis)
		return
	end
	local art = reliquaryPiece(box)
	if art and reliquary(art) then
		p.Transparency = 1
		return
	end
	if RAILS[box.Name] and Lobby.available() then
		p.Transparency = 1
		local axis = p.CFrame.LookVector * box.SZ / 2
		local floor = Vector3.new(box.X, box.Y - box.SY / 2, box.Z)
		Rails.run(group, floor - axis, floor + axis, true, false)
		return
	end
	if COLUMNS[box.Name] and Lobby.available() then
		p.Transparency = 1
		return
	end
	local key = SURFACES[box.Name] or (if string.sub(box.Name, 1, 10) == "CloudShard" then "Stone" else nil)
	if key then
		local surface = Lobby.Surface[key]
		p.Material, p.Color, p.MaterialVariant = surface.Material, surface.Color, surface.Variant
	end
end

local function sign(parent: Instance, text: string, cf: CFrame)
	local board = Kit.part(parent, "WaySign", Vector3.new(6, 1.6, 0.3), cf, P.WoodDark, M.Wood, Kit.decor())
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.LightInfluence, gui.PixelsPerStud = Enum.NormalId.Front, 0.3, 40
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.Text = UDim2.fromScale(1, 1), 1, text
	label.Font, label.TextScaled, label.TextColor3 = Enum.Font.Antique, true, rgb(226, 206, 160)
	label.Parent = gui
end

local function stoneLantern(parent: Instance, floor: CFrame)
	if not Lobby.place(parent, "Lantern_Stone", floor) then Lobby.lanternFallback(parent, floor, false) end
	Lobby.glow(parent, floor * CFrame.new(0, 3.35, 0), Vector3.new(1.04, 1.12, 1.04), 15, 1.35)
end

function Approach.Build(parent: Instance): Folder
	local group = Kit.folder("PilgrimRoutes", parent)
	for _, box in Routes.Solids do
		solid(group, box)
	end
	local d = Routes.Marks.CryptDescent
	-- A pyramidal pavilion over the Well; corner columns only, clear of the moon gate and the shard gap.
	Frame.pavilion(group, CFrame.new(d.X, d.Y, d.Z - 8), 20, 18, 10, { Square = true, Xs = { -10, 10 }, Rise = 0.8, Lanterns = false, Collide = false })
	-- Well of Descent: a moon gate around the portal, a sunken well below it glowing jade.
	for k = 0, 16 do
		local a = math.rad(k * 22.5)
		local p = Vector3.new(d.X + math.cos(a) * 7.5, d.Y + 6 + math.sin(a) * 7.5, d.Z + 1.4)
		if p.Y &gt; d.Y + 0.5 then
			Kit.part(group, "MoonGate", Vector3.new(3.2, 1.6, 1.6), CFrame.new(p) * CFrame.Angles(0, 0, a + math.pi / 2), P.Stone, M.Slate, Kit.decor())
		end
	end
	local well = Kit.part(group, "WellGlow", Vector3.new(10, 0.2, 4), CFrame.new(d.X, d.Y + 0.12, d.Z + 4), JADE, M.Glass,
		{ Collide = false, Query = false, Shadow = false, Transparency = 0.35 })
	Kit.light(well, JADE, 22, 1.1, false)
	sign(group, "THE SUNKEN CRYPT  ·  OPTIONAL", CFrame.new(d.X, d.Y + 14.6, d.Z + 1.4))
	sign(group, "WELL OF DESCENT", CFrame.new(0, d.Y + 9, 972.4)) -- hung over the pavilion's entrance, facing the plaza
	for z = 952, 968, 8 do
		for _, side in { -1, 1 } do
			stoneLantern(group, CFrame.new(side * 13.6, 600, z))
		end
	end
	-- Loggia lookout: brackets under the deck and a lantern on its rail.
	for _, x in { -79, -73 } do
		Kit.beam(group, "DeckBracket", Vector3.new(x, 611, 918), Vector3.new(x, 615, 926), 0.6, P.WoodDark, M.Wood)
	end
	Lobby.slab(group, "LookoutLanternMast", Vector3.new(0.4, 4.8, 0.4), CFrame.new(-71.6, 618.4, 927.4), "Timber", Lobby.decor())
	Lobby.slab(group, "LookoutLanternArm", Vector3.new(1.5, 0.22, 0.25), CFrame.new(-71.1, 620.7, 927.4), "Timber", Lobby.decor())
	Frame.hanging(group, Vector3.new(-70.6, 620.7, 927.4), 15)
	-- Reveal points: a stele and a bench on each dais, lanterns on the viewing wings.
	for _, key in { "RevealDaisW", "RevealDaisE" } do
		local m = Routes.Marks[key]
		local face = CFrame.lookAt(Vector3.new(m.X, m.Y, m.Z), Vector3.new(Routes.Marks.Figure.X, m.Y, Routes.Marks.Figure.Z))
		Kit.part(group, "PilgrimBench", Vector3.new(6, 1.2, 1.6), face * CFrame.new(0, 0.6, 3.6), P.WoodDark, M.Wood, Kit.decor())
		Kit.part(group, "PilgrimStele", Vector3.new(2.2, 5, 0.8), face * CFrame.new(-4.6, 2.5, 4.6), P.Stone, M.Slate, Kit.decor())
	end
	for _, key in { "RevealWingW", "RevealWingE" } do
		local m = Routes.Marks[key]
		stoneLantern(group, CFrame.new(m.X + (if m.X &gt; 0 then 4.6 else -4.6), m.Y, m.Z + 8.6))
	end
	-- Cloud shards: carved stones on floating karst and a soft jade underglow so the optional jumps
	-- read at dusk. Shards alternate their turn; the isle turns its shrine to the far (east) end.
	for _, box in Routes.Solids do
		local art = reliquaryPiece(box)
		if art then
			local template = reliquary(art)
			if template then
				local top = CFrame.new(box.X, box.Y + box.SY / 2, box.Z)
				local piece = template:Clone()
				piece:PivotTo(top * CFrame.Angles(0, if art == "Reliquary_Isle" or box.Name == "CloudShard2" then math.pi else 0, 0))
				piece.Parent = group
			end
			local glow = Kit.hidden(group, "ShardGlow", Vector3.one, CFrame.new(box.X, box.Y - 2, box.Z))
			Kit.light(glow, JADE, 12, 0.7, false)
		end
	end
	-- The isle's arrival (west) corners take stone lanterns, a small crimson maple shades the shrine.
	for _, box in Routes.Solids do
		if box.Name == "ReliquaryIsle" and reliquary("Reliquary_Isle") then
			local y = box.Y + box.SY / 2
			for _, dz in { -6.4, 6.4 } do
				stoneLantern(group, CFrame.new(box.X - 4.4, y, box.Z + dz))
			end
			Lobby.place(group, "Tree_MapleSmall", CFrame.new(box.X + 3.2, y, box.Z - 5.6) * CFrame.Angles(0, math.rad(35), 0), 0.48)
		end
	end
	return group
end

return Approach
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="154">
          <Properties>
            <string name="Name">SanctuaryAscent</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryAscent
-- The Ascension stairs and gateway on the bonfire -&gt; stairs -&gt; gate -&gt; statue axis: a broad 1:2 flight
-- of stone treads between moulded stringers and carved balustrades, newel lanterns at its foot and
-- head, a paved landing, and a modest double-eaved gate hall whose lacquered inner columns frame the
-- jade portal (the Monastery travel trigger) and, beyond it, the Veiled Ascetic. Local to the plaza
-- centre, north is -Z; `top` is the landing height and the flight starts `start` studs north.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Frame = require(script.Parent:WaitForChild("SanctuaryFrame") :: ModuleScript)
local Rails = require(script.Parent:WaitForChild("SanctuaryRails") :: ModuleScript)
local Props = require(script.Parent:WaitForChild("SanctuaryProps") :: ModuleScript)
local Leaves = require(script.Parent:WaitForChild("SanctuaryLeaves") :: ModuleScript)
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)

local Ascent = {}

export type Stair = { Steps: number, Rise: number, Run: number, Width: number, Start: number, Landing: number, Gate: number }
local PORTAL = Color3.fromRGB(111, 170, 164)
local Y = Vector3.yAxis

local function treads(group: Instance, origin: CFrame, s: Stair)
	for i = 1, s.Steps do
		local height = i * s.Rise + 6
		local z = -(s.Start + (i - 0.5) * s.Run)
		Kit.slab(group, "Step" .. i, Vector3.new(s.Width, height, s.Run + 0.03), origin * CFrame.new(0, i * s.Rise - height / 2, z), "Stone")
		Kit.slab(group, "TreadNosing", Vector3.new(s.Width, 0.14, 0.3), origin * CFrame.new(0, i * s.Rise + 0.02, z + s.Run / 2 - 0.15), "StoneDark", Kit.decor())
	end
	for _, i in { 3, 7, 12, 16 } do
		Leaves.Scatter(group, origin * CFrame.new(0, i * s.Rise, -(s.Start + (i - 0.5) * s.Run)), Vector2.new(s.Width * 0.4, s.Run * 0.4), 10, i)
	end
	-- Stringers: a sloped moulded cap over a solid stepped cheek on each side, balustrade on top.
	local run, rise = s.Steps * s.Run, s.Steps * s.Rise
	local slope = math.atan2(rise, run)
	for side = -1, 1, 2 do
		local x = side * (s.Width / 2 + 0.85)
		for i = 1, s.Steps do
			local h = i * s.Rise + 6 -- tops stay under the sloped cap
			Kit.slab(group, "StairCheek", Vector3.new(1.7, h, s.Run + 0.03), origin * CFrame.new(x, i * s.Rise - 0.3 - h / 2, -(s.Start + (i - 0.5) * s.Run)), "StoneDark")
		end
		local mid = origin * CFrame.new(x, rise / 2 + 1.05, -(s.Start + run / 2))
		Kit.slab(group, "StringerCap", Vector3.new(1.9, 0.6, math.sqrt(run * run + rise * rise) + 0.6), mid * CFrame.Angles(slope, 0, 0), "Stone", Kit.decor())
		-- The cap's top runs 1.35 above the first tread's front edge at the stair's own pitch.
		local foot = (origin * CFrame.new(x, 1.35, -s.Start)).Position
		local head = (origin * CFrame.new(x, 1.35 + (run - s.Run) * rise / run, -(s.Start + run - s.Run))).Position
		Rails.stair(group, foot, head)
		Props.lantern(group, origin * CFrame.new(side * (s.Width / 2 + 2.4), 0.1, -s.Start + 2.4))
		Props.lantern(group, origin * CFrame.new(side * (s.Width / 2 + 3.2), rise, -(s.Start + run + 2.5)))
	end
end

local function landing(group: Instance, origin: CFrame, s: Stair)
	local top, back = s.Steps * s.Rise, s.Start + s.Steps * s.Run
	Kit.slab(group, "Landing", Vector3.new(52, 10, s.Landing + 3), origin * CFrame.new(0, top - 5, -back - s.Landing / 2), "Paving")
	Kit.slab(group, "LandingSkirting", Vector3.new(53, 2, s.Landing + 3.5), origin * CFrame.new(0, top - 6.2, -back - s.Landing / 2), "StoneDark")
	-- The TRELLIS guardian pair sits inside the landing, outside the clear stair/gate axis, looking down
	-- the stairs at arriving pilgrims, each turned 12 deg outward. The west lion is the mirrored twin
	-- (tools/blender/mirror_lion.py) so the pair mirror each other; the importer left the twin facing
	-- its own +Z where the original faces -Z, hence their different base turns. Each pedestal turns with
	-- its lion, so the carving's wide base sits along the long pedestal.
	for side = -1, 1, 2 do
		local twin = side &lt; 0 and Kit.template("AsuraGuardianLionMirror") ~= nil
		local foot = origin * CFrame.new(side * 22, top, -back - 4.5) * CFrame.Angles(0, math.rad(side * 12), 0)
		Kit.slab(group, "GuardianPedestal", Vector3.new(7.1, 1.0, 6.2), foot * CFrame.new(0, 0.5, 0), "StoneDark", Kit.decor())
		Kit.place(group, if twin then "AsuraGuardianLionMirror" else "AsuraGuardianLion",
			foot * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, if twin then 0 else math.pi, 0))
	end
	for side = -1, 1, 2 do
		local a = (origin * CFrame.new(side * (s.Width / 2 + 1.9), top, -back - 0.6)).Position
		local b = (origin * CFrame.new(side * 21, top, -back - 0.6)).Position
		Rails.run(group, a, b)
	end
end

-- Double-eaved gate hall; returns the portal trigger (touch to travel).
local function gate(group: Instance, origin: CFrame, s: Stair): BasePart
	local floor = origin * CFrame.new(0, s.Steps * s.Rise, -(s.Start + s.Steps * s.Run + s.Gate))
	-- The plaza looks at the hall's back (+Z), so the hall is turned to face south.
	local hall = floor * CFrame.Angles(0, math.pi, 0)
	Frame.pavilion(group, hall, 42, 8, 15, { Rise = 0.9, Xs = { -21, -10.7, 10.7, 21 }, Lanterns = false })
	Kit.slab(group, "UpperStorey", Vector3.new(23, 5.2, 6.6), hall * CFrame.new(0, 19.8, 0), "Lacquer", Kit.decor())
	Kit.slab(group, "StoreyBand", Vector3.new(23.4, 0.6, 7), hall * CFrame.new(0, 17.4, 0), "Timber", Kit.decor())
	Kit.place(group, "Roof_Hall", hall * CFrame.new(0, 22.6, 0), Vector3.new(0.92, 0.76, 0.9))
	local plaque = floor * CFrame.new(0, 19.9, 3.45)
	Kit.place(group, "Gate_Plaque", plaque)
	local text = Kit.part(group, "GateTablet", Vector3.new(6.2, 2.3, 0.05), plaque * CFrame.new(0, 0, 0.22), Color3.new(), Enum.Material.Wood, Kit.decor())
	text.Transparency = 1
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.SizingMode, gui.PixelsPerStud, gui.LightInfluence = Enum.NormalId.Back, Enum.SurfaceGuiSizingMode.PixelsPerStud, 40, 1
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.Text, label.TextScaled = UDim2.fromScale(1, 1), 1, "PATH OF THE ASURA", true
	label.Font, label.TextColor3 = Enum.Font.Antique, Kit.Palette.Gold
	label.Parent = gui
	gui.Parent = text
	-- Side bays: stone dado and timber lattice, so the jade portal is the one opening on the axis.
	for side = -1, 1, 2 do
		local bay = floor * CFrame.new(side * 15.8, 0, 0)
		Kit.slab(group, "GateDado", Vector3.new(9.2, 2.4, 0.8), bay * CFrame.new(0, 1.2, 0), "StoneDark")
		for x = -4.1, 4.1, 0.75 do
			Kit.slab(group, "GateLattice", Vector3.new(0.2, 10.4, 0.25), bay * CFrame.new(x, 7.6, 0), "Timber", Kit.decor())
		end
		Kit.slab(group, "GateLatticeRail", Vector3.new(9.2, 0.35, 0.4), bay * CFrame.new(0, 12.9, 0), "Lacquer", Kit.decor())
		Kit.blocker(group, "GateBayCollision", (bay * CFrame.new(-4.6, 0, 0)).Position, (bay * CFrame.new(4.6, 0, 0)).Position, 13, 0.8)
		Frame.hanging(group, (floor * CFrame.new(side * 15.8, 14.6, 4)).Position, 16)
	end
	local cf = floor * CFrame.new(0, 7.3, 0)
	local veil = Kit.part(group, "PortalVeil", Vector3.new(20, 14.4, 0.2), cf, Color3.fromRGB(46, 92, 88), Enum.Material.Glass, Kit.decor())
	veil.Transparency, veil.Reflectance = 0.25, 0.1
	for side = -1, 1, 2 do
		Kit.part(group, "PortalSeam", Vector3.new(0.045, 14.3, 0.1), cf * CFrame.new(side * 9.9, 0, 0.15), PORTAL, Enum.Material.Glass, Kit.decor())
	end
	Kit.light(veil, PORTAL, 18, 0.9, false)
	if Assets.Textures.Smoke ~= "" then
		local mist = Instance.new("ParticleEmitter")
		mist.Texture, mist.Rate, mist.Lifetime, mist.Speed = Assets.Textures.Smoke, 4, NumberRange.new(3, 4), NumberRange.new(0.2, 0.6)
		mist.SpreadAngle, mist.LightEmission = Vector2.new(30, 15), 0.15
		mist.Size = Kit.sequence({ { 0, 2 }, { 1, 6 } })
		mist.Transparency = Kit.sequence({ { 0, 1 }, { 0.3, 0.85 }, { 1, 1 } })
		mist.Color = ColorSequence.new(PORTAL, Color3.fromRGB(72, 103, 112))
		mist.Parent = veil
	end
	local trigger = Kit.part(group, "PortalTrigger", Vector3.new(20, 14.4, 2.4), cf, PORTAL, Enum.Material.SmoothPlastic,
		{ Collide = false, Query = false, Transparency = 1, Shadow = false })
	trigger.CanTouch = true
	return trigger
end

function Ascent.Build(parent: Instance, origin: CFrame, stair: Stair): BasePart
	local group = Kit.folder("AscensionGateway", parent)
	treads(group, origin, stair)
	landing(group, origin, stair)
	return gate(group, origin, stair)
end

return table.freeze(Ascent)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="155">
          <Properties>
            <string name="Name">SanctuaryBonfire</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryBonfire
-- The Primal Bonfire: a recessed charcoal bed inside a low, jointed stone hearth, stacked split
-- firewood and the coiled sword. Fire, drifting embers and smoke rise from the logs; the paving
-- never carries a flat orange glow disc or a painted ring standing in for the hearth.
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)

local Bonfire = {}

local ASH = Color3.fromRGB(58, 54, 52)
local CHAR = Color3.fromRGB(33, 27, 24)
local IRON = Color3.fromRGB(70, 66, 64)
local GLOW = Color3.fromRGB(255, 150, 60)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Size, p.CFrame, p.Color, p.Material = size, cf, color, material
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function keys(points: { { number } }): NumberSequence
	local list = {}
	for _, k in points do
		table.insert(list, NumberSequenceKeypoint.new(k[1], k[2]))
	end
	return NumberSequence.new(list)
end

local function emitter(parent: Instance, texture: string, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

-- `base` is the surrounding plaza top, Y up. The charcoal bed stays below the coping.
function Bonfire.Build(parent: Instance, base: CFrame): BasePart
	local group = Instance.new("Folder")
	group.Name = "PrimalBonfire"
	group.Parent = parent

	-- Radial blue-grey masonry has actual depth, staggered joints, a dark recessed bowl, and a
	-- broad weathered coping. Its low profile preserves the altar's walk-up and portrait camera.
	local stoneOptions = { Collide = false, Query = false, Shadow = true }
	for k = 0, 23 do
		local angle = math.pi * 2 * k / 24
		local frame = base * CFrame.Angles(0, angle, 0)
		Kit.slab(group, "HearthFoundation", Vector3.new(1.24, 0.25, 1.2), frame * CFrame.new(0, 0.125, -4.05), "StoneDark", stoneOptions)
		Kit.slab(group, "HearthWall", Vector3.new(1.08, 0.46, 0.88), frame * CFrame.new(0, 0.45, -3.95), "Stone", stoneOptions)
		local cap = base * CFrame.Angles(0, angle + math.pi / 24, 0) * CFrame.new(0, 0.77, -4.0)
		Kit.slab(group, "JointedHearthCoping", Vector3.new(1.19, 0.2, 1.15), cap, "Stone", stoneOptions)
	end
	Kit.disc(group, "RecessedHearthBowl", 3.52, 0.12, base * CFrame.new(0, 0.075, 0), Color3.fromRGB(37, 36, 35), Enum.Material.Slate, Kit.decor()).MaterialVariant = "AsuraStone"
	local rng = Random.new(4281)
	for k = 1, 24 do
		local angle, radius = rng:NextNumber(0, math.pi * 2), rng:NextNumber(0.3, 3.25)
		local coal = part(group, "BankedCharcoal", Vector3.new(rng:NextNumber(0.35, 0.8), rng:NextNumber(0.13, 0.3), rng:NextNumber(0.3, 0.7)),
			base * CFrame.new(math.cos(angle) * radius, 0.18, math.sin(angle) * radius) * CFrame.Angles(0, angle, 0), if k % 3 == 0 then ASH else CHAR, Enum.Material.Slate, Enum.PartType.Ball)
		coal.CastShadow = false
	end

	-- Two crossed courses make readable firewood rather than six thin sticks hovering in glow.
	for layer = 0, 1 do
		for k = -1, 1 do
			local cf = base * CFrame.Angles(0, math.rad(22 + layer * 90), 0) * CFrame.new(0, 0.48 + layer * 0.44, k * 0.76)
			local length = 3.6 + (if k == 0 then 0.6 else 0)
			local log = part(group, "StackedCharredFirewood", Vector3.new(length, 0.6, 0.64), cf, Color3.fromRGB(64, 47, 34), Enum.Material.Wood, Enum.PartType.Cylinder)
			log.MaterialVariant = "AsuraTimber"
			for _, side in { -1, 1 } do
				part(group, "SplitLogEnd", Vector3.new(0.024, 0.43, 0.46), cf * CFrame.new(side * (length / 2 + 0.01), 0, 0), Color3.fromRGB(103, 75, 45), Enum.Material.Wood, Enum.PartType.Cylinder)
			end
		end
	end
	for k = 0, 2 do
		local a = math.rad(k * 120 + 15)
		local frame = base * CFrame.Angles(0, a, 0)
		local foot, tip = (frame * CFrame.new(0, 0.6, -1.25)).Position, (frame * CFrame.new(0, 2.3, -0.25)).Position
		local cf = CFrame.lookAt((foot + tip) / 2, tip) * CFrame.Angles(0, math.rad(90), 0)
		part(group, "LeaningCharredLog", Vector3.new((tip - foot).Magnitude + 0.25, 0.48, 0.5), cf, CHAR, Enum.Material.Wood, Enum.PartType.Cylinder).MaterialVariant = "AsuraTimber"
	end

	-- Coiled sword: blade, crossguard and grip, a spiral of iron wound round the blade.
	local sword = base * CFrame.new(0, 2.1, 0) * CFrame.Angles(math.rad(6), 0, math.rad(-4))
	part(group, "CoiledBlade", Vector3.new(0.3, 4, 0.08), sword, IRON, Enum.Material.Metal)
	part(group, "Crossguard", Vector3.new(1.3, 0.16, 0.22), sword * CFrame.new(0, 2.05, 0), IRON, Enum.Material.Metal)
	part(group, "Grip", Vector3.new(0.14, 0.9, 0.14), sword * CFrame.new(0, 2.6, 0), CHAR, Enum.Material.Wood)
	part(group, "Pommel", Vector3.new(0.3, 0.3, 0.3), sword * CFrame.new(0, 3.1, 0), IRON, Enum.Material.Metal, Enum.PartType.Ball)
	for k = 0, 13 do
		local t = k / 13
		part(group, "Coil", Vector3.new(0.22, 0.1, 0.42), sword * CFrame.new(0, -1.7 + t * 3.4, 0) * CFrame.Angles(0, t * math.pi * 6, 0) * CFrame.new(0.2, 0, 0), IRON, Enum.Material.Metal)
	end

	-- Fire: the built-in Fire instance always renders; particles add licks, sparks and smoke.
	local heart = part(group, "FireHeart", Vector3.new(1, 1, 1), base * CFrame.new(0, 1.2, 0), GLOW, Enum.Material.SmoothPlastic)
	heart.Transparency = 1
	for _, f in { { 3.8, 6, Color3.fromRGB(255, 150, 55), Color3.fromRGB(155, 46, 16) }, { 2.3, 9, Color3.fromRGB(255, 205, 120), Color3.fromRGB(230, 105, 28) } } do
		local fire = Instance.new("Fire")
		fire.Size, fire.Heat, fire.Color, fire.SecondaryColor = f[1], f[2], f[3], f[4]
		fire.Parent = heart
	end
	if Assets.Textures.Flame ~= "" then
		emitter(heart, Assets.Textures.Flame, {
			Rate = 16, Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(1.4, 3), SpreadAngle = Vector2.new(12, 12),
			Size = keys({ { 0, 1.1 }, { 0.5, 1.5 }, { 1, 0 } }), Transparency = keys({ { 0, 0.3 }, { 0.7, 0.6 }, { 1, 1 } }),
			Color = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(220, 60, 20)), LightEmission = 0.9, Rotation = NumberRange.new(-20, 20),
		})
	end
	if Assets.Textures.Ember ~= "" then
		emitter(heart, Assets.Textures.Ember, {
			Rate = 8, Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(2.2, 4), SpreadAngle = Vector2.new(25, 25),
			Acceleration = Vector3.new(0.6, 1.1, 0.4), Drag = 0.9, Size = keys({ { 0, 0.13 }, { 1, 0.025 } }),
			Color = ColorSequence.new(Color3.fromRGB(255, 200, 110), Color3.fromRGB(255, 80, 30)), LightEmission = 1, LightInfluence = 0,
		})
	end
	if Assets.Textures.Smoke ~= "" then
		emitter(heart, Assets.Textures.Smoke, {
			Rate = 4, Lifetime = NumberRange.new(5, 8), Speed = NumberRange.new(1.3, 2.2), Acceleration = Vector3.new(0.55, 0.35, 0.2),
			Size = keys({ { 0, 1.8 }, { 1, 8 } }), Transparency = keys({ { 0, 1 }, { 0.2, 0.8 }, { 1, 1 } }),
			Color = ColorSequence.new(Color3.fromRGB(110, 104, 100), Color3.fromRGB(70, 74, 80)),
		})
	end

	-- Warm light; the Fire effect itself supplies the flicker (no per-frame server writes).
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Shadows = Color3.fromRGB(255, 175, 95), 24, 1.8, true
	light.Parent = heart
	return heart
end

return Bonfire
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">SanctuaryCloisters</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryCloisters
-- The connected covered architecture of the courtyard: two open halls flanking the Ascension stairs,
-- a cloister gallery down each side, and the roofed walkways out to the Blacksmith Loggia (west) and
-- the Colosseum Promenade (east) with carved rails between their columns. Floors are the collision;
-- columns carry their own boxes (SanctuaryFrame). Local to the plaza centre; north is -Z.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Frame = require(script.Parent:WaitForChild("SanctuaryFrame") :: ModuleScript)
local Rails = require(script.Parent:WaitForChild("SanctuaryRails") :: ModuleScript)
local Props = require(script.Parent:WaitForChild("SanctuaryProps") :: ModuleScript)

local Cloisters = {}

local TOP = 0.1
local HALL = { X = 36, Z = -37, Width = 20, Depth = 10, Height = 10.5 }
local SIDE = { X = 52.8, Z0 = -42, Z1 = -6, Width = 6, Height = 8.5 }
local WALK = { Width = 12, Height = 8.5 }
local Y = Vector3.yAxis

local function hall(group: Instance, origin: CFrame, side: number)
	local cf = origin * CFrame.new(side * HALL.X, TOP + 0.35, HALL.Z)
	Kit.slab(group, "HallSill", Vector3.new(HALL.Width + 3, 0.6, HALL.Depth + 3), cf * CFrame.new(0, -0.3, 0), "StoneDark")
	Kit.slab(group, "HallThreshold", Vector3.new(HALL.Width + 2.6, 0.12, 0.6), cf * CFrame.new(0, 0.04, HALL.Depth / 2 + 1), "Stone", Kit.decor())
	Frame.pavilion(group, cf, HALL.Width, HALL.Depth, HALL.Height)
	-- An offering table against the back row: incense censer and two candles.
	local table_ = cf * CFrame.new(0, 0, -HALL.Depth / 2 + 1.6)
	Kit.slab(group, "OfferingTable", Vector3.new(6, 0.4, 1.8), table_ * CFrame.new(0, 1.2, 0), "Timber")
	for _, x in { -2.5, 2.5 } do
		for _, z in { -0.55, 0.55 } do
			Kit.slab(group, "OfferingTableLeg", Vector3.new(0.32, 1.3, 0.32), table_ * CFrame.new(x, 0.65, z), "Timber", Kit.decor())
		end
	end
	Kit.slab(group, "OfferingTableShelf", Vector3.new(5.2, 0.18, 1.45), table_ * CFrame.new(0, 0.4, 0), "Timber", Kit.decor())
	Kit.slab(group, "OfferingTop", Vector3.new(6.4, 0.18, 2.1), table_ * CFrame.new(0, 1.49, 0), "Lacquer", Kit.decor())
	Kit.disc(group, "CenserFoot", 0.45, 0.14, table_ * CFrame.new(0, 1.66, 0), Kit.Palette.Gold, Enum.Material.Metal, Kit.decor()).MaterialVariant = "AsuraBronze"
	Kit.disc(group, "Censer", 0.6, 0.45, table_ * CFrame.new(0, 1.91, 0), Kit.Palette.Gold, Enum.Material.Metal, Kit.decor()).MaterialVariant = "AsuraBronze"
	Kit.disc(group, "CenserAsh", 0.5, 0.04, table_ * CFrame.new(0, 2.15, 0), Color3.fromRGB(61, 61, 57), Enum.Material.Basalt, Kit.decor())
	for _, x in { -0.17, 0.04, 0.19 } do
		Kit.part(group, "IncenseStick", Vector3.new(0.035, 0.72, 0.035), table_ * CFrame.new(x, 2.51, 0), Color3.fromRGB(82, 56, 35), Enum.Material.Wood, Kit.decor())
	end
	for x = -2, 2, 4 do
		Kit.disc(group, "CandleDish", 0.31, 0.08, table_ * CFrame.new(x, 1.64, 0), Kit.Palette.Gold, Enum.Material.Metal, Kit.decor())
		Kit.part(group, "OfferingCandle", Vector3.new(0.24, 0.52, 0.24), table_ * CFrame.new(x, 1.94, 0), Color3.fromRGB(194, 164, 119), Enum.Material.SmoothPlastic, Kit.decor())
		Kit.glow(group, table_ * CFrame.new(x, 2.3, 0), Vector3.new(0.1, 0.18, 0.1), 7, 0.35)
	end
end

-- Covered walk on a 12-stud bridge from the courtyard edge `a` to the destination edge `b`. `gap`
-- leaves the last bay's rail out on one side (-1 south of a westward walk), for a route off it.
local function walkway(group: Instance, origin: CFrame, a: Vector3, b: Vector3, gap: number?)
	local mid, length = (a + b) * 0.5, (b - a).Magnitude
	Kit.slab(group, "Walkway", Vector3.new(length + 2, 3, WALK.Width), origin * CFrame.new(mid + Y * (TOP - 1.55)), "Paving")
	local pa, pb = (origin * CFrame.new(a + Y * (TOP - 0.05))).Position, (origin * CFrame.new(b + Y * (TOP - 0.05))).Position
	Frame.gallery(group, pa, pb, WALK.Width, WALK.Height, { CapStart = false })
	local dir = (pb - pa).Unit
	local across = dir:Cross(Y).Unit
	local floorFrame = Kit.along(pa, pb)
	for side = -1, 1, 2 do
		Kit.slab(group, "GalleryEdgeCourse", Vector3.new(length, 0.12, 0.7), floorFrame * CFrame.new(0, -0.005, side * (WALK.Width / 2 - 0.4)), "StoneDark", Kit.decor())
		Kit.slab(group, "GalleryBronzeThread", Vector3.new(length - 0.8, 0.025, 0.06), floorFrame * CFrame.new(0, 0.057, side * (WALK.Width / 2 - 1)), "Bronze", Kit.decor())
	end
	local n = math.max(1, math.round(length / 7.5))
	local step = length / n
	for s = -1, 1, 2 do
		for i = 1, n do
			if gap == s and i == n then
				continue
			end
			local p0 = pa + dir * (step * (i - 1) + 0.9) + across * s * (WALK.Width / 2)
			local p1 = pa + dir * (step * i - 0.9) + across * s * (WALK.Width / 2)
			Rails.run(group, p0, p1, false)
		end
	end
end

function Cloisters.Build(parent: Instance, origin: CFrame, forgeEdge: number, duelEdge: number): Folder
	local group = Kit.folder("Cloisters", parent)
	for side = -1, 1, 2 do
		hall(group, origin, side)
		local a = (origin * CFrame.new(side * SIDE.X, TOP, SIDE.Z0)).Position
		local b = (origin * CFrame.new(side * SIDE.X, TOP, SIDE.Z1)).Position
		Frame.gallery(group, a, b, SIDE.Width, SIDE.Height, { CapEnd = true, Lanterns = true })
		Props.bench(group, origin * CFrame.new(side * (SIDE.X + 2.2), TOP, -24) * CFrame.Angles(0, math.rad(side * 90), 0))
	end
	-- The forge walk opens onto the Loggia Eaves service ledge (SanctuaryRoutes) beside the platform.
	walkway(group, origin, Vector3.new(-58, 0, 0), Vector3.new(-forgeEdge, 0, 0), -1)
	walkway(group, origin, Vector3.new(58, 0, 0), Vector3.new(duelEdge, 0, 0))
	return group
end

return table.freeze(Cloisters)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="157">
          <Properties>
            <string name="Name">SanctuaryColossus</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryColossus
-- The Veiled Ascetic closes the Sanctuary's main axis. Past the Ascension Stairs and the gate, a
-- rock terrace flush with the landing carries the colossus (150 studs seated) at the foot of the
-- sacred tree (~450 studs, sized by SanctuaryTitan), so every view up the stairs from the bonfire ends on her face. The terrace is a sky-island
-- shard like the plaza: kerbed slab, tapering rock foot; its dressing is SanctuaryTerrace's (lobby kit).
local Dressing = require(script.Parent:WaitForChild("SanctuaryDressing") :: ModuleScript)
local Leaves = require(script.Parent:WaitForChild("SanctuaryLeaves") :: ModuleScript)
local Titan = require(script.Parent:WaitForChild("SanctuaryTitan") :: ModuleScript)
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Terrace = require(script.Parent:WaitForChild("SanctuaryTerrace") :: ModuleScript)

local Colossus = {}

local RADIUS = math.ceil(Titan.TreeSpan.Radius) + 6 -- the tree's whole root platform fits on it
local OVERLAP = 8 -- the terrace runs under the back of the landing so the floor is continuous
local FORWARD = Titan.TreeSpan.Forward -- her seat: the front edge of the roots, toward the plaza
local STONE = Color3.fromRGB(95, 101, 96)
local STONE_DARK = Color3.fromRGB(41, 49, 51)
local ROCK = Color3.fromRGB(49, 60, 64)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, solid: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size, p.CFrame, p.Color, p.Material = size, cf, color, material
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.CanCollide = solid ~= false
	p.CanQuery = p.CanCollide
	p.Parent = parent
	return p
end

local function disc(parent: Instance, name: string, radius: number, height: number, cf: CFrame, color: Color3, material: Enum.Material): BasePart
	local p = part(parent, name, Vector3.new(height, radius * 2, radius * 2), cf * CFrame.Angles(0, 0, math.rad(90)), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- `origin` is the plaza centre; `top` and `back` are the landing's height and far edge from it.
function Colossus.Build(parent: Instance, origin: Vector3, top: number, back: number): BasePart
	local group = Instance.new("Folder")
	group.Name = "ColossusSanctuary"
	group.Parent = parent
	local plaza = CFrame.new(origin)
	local centre = plaza * CFrame.new(0, top, -(back + RADIUS - OVERLAP))

	-- Existing slab, kerb and support cylinders retain their exact movement collision. Once all
	-- broad, overlapping cliff masses are present, only those irregular scanned-rock surfaces and
	-- the authored processional paving remain visible; no cylindrical skirt is left around them.
	local slab = disc(group, "ColossusTerrace", RADIUS, 6, centre * CFrame.new(0, -3.03, 0), STONE_DARK, Enum.Material.Slate)
	local kerb = disc(group, "TerraceKerb", RADIUS + 2, 2.5, centre * CFrame.new(0, -6.9, 0), STONE, Enum.Material.Slate)
	local foot = disc(group, "TerraceFoot", RADIUS * 0.84, 70, centre * CFrame.new(0, -41, 0), ROCK, Enum.Material.Rock)
	local root = disc(group, "TerraceRoot", RADIUS * 0.55, 90, centre * CFrame.new(0, -120, 0), ROCK, Enum.Material.Rock)
	for p, surface in { [slab] = "TerracePaving", [kerb] = "StoneDark", [foot] = "Rock", [root] = "Rock" } do
		local s = Kit.Surface[surface]
		p.Color, p.Material, p.MaterialVariant = s.Color, s.Material, s.Variant
	end
	root.Transparency = 1
	slab.Color = Kit.Surface.Paving.Color
	-- Keep the old visible support as a boot-safe fallback if the uploaded cliff library is absent.
	if Terrace.Dress(group, centre, RADIUS, FORWARD) then
		for _, cylinder in { slab, kerb, foot, root } do cylinder.Transparency = 1 end
	end
	Leaves.Scatter(group, centre * CFrame.new(0, 0.02, 0), Vector2.new(RADIUS - 10, RADIUS - 10), 420, 31)

	-- Her seat, facing back down the axis toward the plaza and the bonfire.
	local anchor = part(group, "AsuraColossusAnchor", Vector3.new(4, 4, 4), centre * CFrame.new(0, 0, FORWARD), STONE, Enum.Material.SmoothPlastic, false)
	anchor.Transparency = 1
	Dressing.try("Colossus", Dressing.Colossus, group, anchor.CFrame, nil, origin)
	return anchor
end

return Colossus
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">SanctuaryCourtyard</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryCourtyard
-- The Shrine of the Ascendant's lower courtyard (lobby kit, concept 2026-10-21): a square paved
-- terrace with an axial path and bronze inlay lines, two long shallow jade-grey basins with carved
-- coping, the low three-step bonfire dais inside a radial paving medallion, stone lanterns flanking
-- the walk, memorial stelae and banners, and a carved balustrade open to the four routes (stairs N,
-- forge W, duel court E, pilgrim walk S). Collision is primitive: floors, dais steps, rim kerbs and
-- one wall per balustrade run. Coordinates are local to the plaza centre (north is -Z).
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Rails = require(script.Parent:WaitForChild("SanctuaryRails") :: ModuleScript)
local Leaves = require(script.Parent:WaitForChild("SanctuaryLeaves") :: ModuleScript)
local Bonfire = require(script.Parent:WaitForChild("SanctuaryBonfire") :: ModuleScript)
local Props = require(script.Parent:WaitForChild("SanctuaryProps") :: ModuleScript)
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Terrain = game:GetService("Workspace").Terrain

local Courtyard = {}

local HALF = 46 -- north/south extent and existing route anchors stay fixed
local HALF_X = 58
local TOP = 0.1 -- flagstone top
local POOL = { X0 = 24, X1 = 42, Z0 = -20, Z1 = 32, Floor = -0.7, Water = -0.14 }
-- Openings in the balustrade, as half-widths: north stairs, west/east walkways, south pilgrim walk.
local OPEN = { N = 20, W = 7, E = 7, S = 14 }
Courtyard.Half, Courtyard.Top, Courtyard.Pool, Courtyard.Open = HALF, TOP, table.freeze(POOL), table.freeze(OPEN)

local Y = Vector3.yAxis
local function invisible(): any
	return { Collide = true, Query = false, Transparency = 1, Shadow = false }
end

-- Broad stone courses are deliberately quiet; the existing PBR supplies chips and fine grain.
-- These recessed dark joints break the machine-regular texture at normal player-camera height.
local function pavingJoints(group: Instance, origin: CFrame, x0: number, x1: number, z0: number, z1: number)
	local row, width = 4.8, x1 - x0
	for k = 1, math.floor((z1 - z0) / row) do
		local z = z0 + k * row
		Kit.part(group, "RecessedPavingJoint", Vector3.new(width, 0.018, 0.045), origin * CFrame.new((x0 + x1) / 2, TOP + 0.007, z),
			Color3.fromRGB(55, 63, 66), Enum.Material.Slate, Kit.decor())
		local phase = if k % 2 == 0 then 0.28 else 0.62
		for j = 1, 2 do
			local x = x0 + width * (j - phase) / 2
			Kit.part(group, "RecessedPavingJoint", Vector3.new(0.045, 0.018, math.min(row, z1 - z + row)),
				origin * CFrame.new(x, TOP + 0.007, z - row / 2), Color3.fromRGB(55, 63, 66), Enum.Material.Slate, Kit.decor())
		end
	end
end

local function basin(group: Instance, origin: CFrame, side: number)
	local x0, x1 = side * POOL.X0, side * POOL.X1
	local cx, cz = (x0 + x1) / 2, (POOL.Z0 + POOL.Z1) / 2
	local w, l = math.abs(x1 - x0), POOL.Z1 - POOL.Z0
	Kit.slab(group, "BasinFloor", Vector3.new(w, 2, l), origin * CFrame.new(cx, POOL.Floor - 1, cz), "Basin")
	-- Real water supplies ripples and local reflections. Its voxel bounds extend under the paving:
	-- the solid floor and coping conceal Terrain's rounded shore and keep the basin shallow to walk.
	-- Water extends under the coping and paving; the finished rim exposes only the two basins.
	local a = (origin * CFrame.new(math.min(x0, x1), 0, POOL.Z0)).Position
	local b = (origin * CFrame.new(math.max(x0, x1), 0, POOL.Z1)).Position
	local left = math.floor(a.X / 4) * 4 - (if side &gt; 0 then 4 else 0)
	local right = math.ceil(b.X / 4) * 4 + (if side &lt; 0 then 4 else 0)
	local front, back = math.floor(a.Z / 4) * 4 - 4, math.ceil(b.Z / 4) * 4 + 4
	Terrain:FillBlock(CFrame.new((left + right) / 2, origin.Y - 2, (front + back) / 2), Vector3.new(right - left, 4, back - front), Enum.Material.Water)
	Kit.hidden(group, "StillWater", Vector3.new(w, 0.1, l), origin * CFrame.new(cx, POOL.Water - 0.05, cz))
	Leaves.Scatter(group, origin * CFrame.new(cx, POOL.Water + 0.02, cz), Vector2.new(w / 2 - 0.8, l / 2 - 1), 14, 90 + side, true)
	if Assets.Textures.Smoke ~= "" then
		for _, z in { POOL.Z0 + 9, cz, POOL.Z1 - 9 } do
			local anchor = Kit.hidden(group, "PoolMistEdge", Vector3.new(1, 0.1, 8), origin * CFrame.new(side * (POOL.X0 + 1.8), 0.1, z))
			local mist = Instance.new("ParticleEmitter")
			mist.Name, mist.Texture, mist.Rate = "WaterEdgeMist", Assets.Textures.Smoke, 0.38
			mist.Lifetime, mist.Speed, mist.Acceleration = NumberRange.new(4, 6), NumberRange.new(0.15, 0.35), Vector3.new(0.12, 0.08, 0)
			mist.Size = Kit.sequence({ { 0, 1 }, { 1, 4.5 } })
			mist.Transparency = Kit.sequence({ { 0, 1 }, { 0.25, 0.88 }, { 1, 1 } })
			mist.Color, mist.LightInfluence = ColorSequence.new(Color3.fromRGB(211, 217, 216)), 0.65
			mist.Rotation, mist.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-4, 4)
			mist.Parent = anchor
		end
	end
	-- Coping on all four edges; each piece's back (+Z) faces the water, its pivot on the water edge.
	local edges = {
		{ Vector3.new(x0, 0, POOL.Z0), Vector3.new(x0, 0, POOL.Z1), Vector3.new(side, 0, 0) },
		{ Vector3.new(x1, 0, POOL.Z0), Vector3.new(x1, 0, POOL.Z1), Vector3.new(-side, 0, 0) },
		{ Vector3.new(x0, 0, POOL.Z0), Vector3.new(x1, 0, POOL.Z0), Vector3.new(0, 0, 1) },
		{ Vector3.new(x0, 0, POOL.Z1), Vector3.new(x1, 0, POOL.Z1), Vector3.new(0, 0, -1) },
	}
	for _, e in edges do
		local a, b, into = e[1], e[2], e[3]
		local mid = (a + b) * 0.5
		local length = (b - a).Magnitude
		local frame = CFrame.fromMatrix(mid + Y * TOP, Y:Cross(into), Y)
		-- Each carved coping bay keeps the original grain scale; long one-piece stretches read as plastic.
		local bays = math.max(1, math.round(length / 8))
		local bay = length / bays
		for i = 1, bays do
			local at = origin * frame * CFrame.new(-length / 2 + bay * (i - 0.5), 0, 0)
			if not Kit.place(group, "Pool_Rim", at, Vector3.new((bay - 0.025) / 8, 1, 1)) then
				Kit.slab(group, "BasinCoping", Vector3.new(bay - 0.025, 0.5, 1.2), at * CFrame.new(0, 0.2, -0.6), "Stone", Kit.decor())
			end
		end
		Kit.slab(group, "BasinWaterline", Vector3.new(length - 0.2, 0.14, 0.18), origin * frame * CFrame.new(0, -0.12, 0.12), "StoneDark", Kit.decor())
		Kit.slab(group, "CopingShadowCourse", Vector3.new(length, 0.12, 0.16), origin * frame * CFrame.new(0, 0.13, -1.13), "StoneDark", Kit.decor())
		local kerb = (origin * frame * CFrame.new(0, 0, -0.62)).Position
		local along = (origin * frame).XVector * length * 0.5
		Kit.blocker(group, "CopingKerb", kerb - along - Y * 0.0, kerb + along, 0.5, 1.25)
	end
	for _, c in { { x0, POOL.Z0 }, { x1, POOL.Z0 }, { x0, POOL.Z1 }, { x1, POOL.Z1 } } do
		local ox = if math.abs(c[1]) &lt; math.abs(cx) then -side else side
		local oz = if c[2] &lt; cz then -1 else 1
		Kit.place(group, "Pool_Corner", origin * CFrame.new(c[1] + ox * 0.62, TOP, c[2] + oz * 0.62))
	end
end

local function dais(group: Instance, origin: CFrame)
	Kit.place(group, "Paving_Medallion", origin * CFrame.new(0, TOP - 0.01, 0))
end

local function balustrade(group: Instance, origin: CFrame)
	local ex, ez = HALF_X - 0.6, HALF - 0.6
	local function run(a: Vector3, b: Vector3)
		Rails.run(group, (origin * CFrame.new(a + Y * TOP)).Position, (origin * CFrame.new(b + Y * TOP)).Position)
	end
	for side = -1, 1, 2 do
		run(Vector3.new(side * ex, 0, -ez), Vector3.new(side * OPEN.N, 0, -ez))
		run(Vector3.new(side * ex, 0, ez), Vector3.new(side * OPEN.S, 0, ez))
		run(Vector3.new(-ex, 0, side * ez), Vector3.new(-ex, 0, side * OPEN.W))
		run(Vector3.new(ex, 0, side * ez), Vector3.new(ex, 0, side * OPEN.E))
	end
end

-- Builds the courtyard; returns the bonfire altar's anchor part (WorldService mounts its rest prompt).
function Courtyard.Build(parent: Instance, origin: CFrame, altarId: string, plinth: number): BasePart
	local group = Kit.folder("CentralPlaza", parent)
	local function floor(name: string, x0: number, x1: number, z0: number, z1: number, surface: string)
		Kit.slab(group, name, Vector3.new(x1 - x0, 4, z1 - z0), origin * CFrame.new((x0 + x1) / 2, TOP - 2, (z0 + z1) / 2), surface)
	end
	floor("AxialWalk", -POOL.X0, POOL.X0, -HALF, HALF, "PavingPath")
	pavingJoints(group, origin, -POOL.X0 + 1.5, POOL.X0 - 1.5, -HALF + 1, HALF - 1)
	for side = -1, 1, 2 do
		local a, b = math.min(side * POOL.X1, side * HALF_X), math.max(side * POOL.X1, side * HALF_X)
		floor("Flagstones", a, b, -HALF, HALF, "Paving")
		local c, d = math.min(side * POOL.X0, side * POOL.X1), math.max(side * POOL.X0, side * POOL.X1)
		floor("Flagstones", c, d, -HALF, POOL.Z0, "Paving")
		floor("Flagstones", c, d, POOL.Z1, HALF, "Paving")
		basin(group, origin, side)
		pavingJoints(group, origin, a + 0.5, b - 0.5, POOL.Z0, POOL.Z1)
		Kit.slab(group, "PathInlay", Vector3.new(0.12, 0.04, HALF * 2 - 2), origin * CFrame.new(side * 19.5, TOP + 0.01, 0), "Bronze", Kit.decor())
		for _, z in { -16, 27, 42.5 } do
			Props.lantern(group, origin * CFrame.new(side * 21.2, TOP, z))
		end
		Props.stele(group, origin * CFrame.new(side * 49, TOP, 37) * CFrame.Angles(0, math.rad(side * 45), 0), "REMEMBER\nDEATH")
		for _, x in { 28, 42 } do
			Props.banner(group, origin * CFrame.new(side * x, TOP, HALF - 1.6))
		end
		-- Sparse crimson maples and shrubs in the outer strips, echoing the sacred tree's leaves.
		Props.tree(group, origin * CFrame.new(side * 50.5, TOP, 20) * CFrame.Angles(0, side, 0), 0.8)
		for _, z in { 10, 30, 41 } do
			Props.shrub(group, origin * CFrame.new(side * 55.4, TOP, z) * CFrame.Angles(0, z, 0), 1.1)
		end
	end
	Kit.slab(group, "TerraceSkirting", Vector3.new(HALF_X * 2 + 1, 2.2, HALF * 2 + 1), origin * CFrame.new(0, TOP - 4.6, 0), "StoneDark")
	dais(group, origin)
	balustrade(group, origin)
	local anchor = Kit.part(group, "AltarAnchor_" .. altarId, Vector3.new(1, 0.2, 1), origin * CFrame.new(0, plinth, 0), Color3.new(), Enum.Material.Slate,
		{ Collide = false, Query = false, Transparency = 1, Shadow = false })
	Bonfire.Build(group, origin * CFrame.new(0, TOP + 0.03, 0))
	local petals = Kit.hidden(group, "PetalAnchor", Vector3.new(HALF * 1.8, 1, HALF * 1.8), origin * CFrame.new(0, 32, 0))
	Leaves.Emitter(petals, { Rate = 2, Size = 0.28, Wind = Vector3.new(1.5, -1.0, 0.8) })
	return anchor
end

return table.freeze(Courtyard)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">SanctuaryDressing</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryDressing
-- Places the uploaded PBR set pieces (ServerStorage.AsuraAssets, see assets/ASSET_IDS.md) into the
-- procedurally built Sanctuary: the Veiled Ascetic colossus (roots and canopy grown into one model,
-- tools/blender/build_titan.py), crimson leaves shed from her canopy, and iron gates flanking the
-- Ascension portal. Older Gothic-statue / loose-roots / dead-tree pieces remain as a fallback.
-- Textures come from each MeshPart's SurfaceAppearance, so materials are never overridden.
-- Calls return false if the asset folder is missing; Dressing.try pcall-wraps them for boot safety.
local ServerStorage = game:GetService("ServerStorage")
local Leaves = require(script.Parent:WaitForChild("SanctuaryLeaves") :: ModuleScript)
local Titan = require(script.Parent:WaitForChild("SanctuaryTitan") :: ModuleScript)

local Dressing = {}

local COLOSSUS_HEIGHT = 48 -- fits between the arch pillars (inner edges at +/-21 studs)
local COLOSSUS_YAW = 180 -- the fallback Gothic statue faces its +Z; the dais anchor looks down -Z
local ROOT_LENGTH = 26
local TREE_HEIGHT = 26
local GATE_HEIGHT = 13

function Dressing.try(label: string, fn: (...any) -&gt; boolean, ...: any): boolean
	local ok, placed = pcall(fn, ...)
	if not ok then
		warn(string.format("[Asura's Path] Sanctuary dressing '%s' skipped: %s", label, tostring(placed)))
	end
	return ok and placed == true
end

local function asset(name: string): Model?
	local folder = ServerStorage:FindFirstChild("AsuraAssets")
	local found = folder and folder:FindFirstChild(name)
	return if found and found:IsA("Model") then found:Clone() else nil
end

-- Static scenery: anchored, no collisions beyond the statue body, cheap queries.
local function settle(model: Model, collide: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = collide
			d.CanQuery = collide
			d.CanTouch = false
			d.CastShadow = true
		end
	end
end

local function scaleTo(model: Model, axis: "X" | "Y" | "Z", target: number)
	local size = model:GetExtentsSize()
	local current = if axis == "X" then size.X elseif axis == "Y" then size.Y else size.Z
	if current &gt; 0 then
		model:ScaleTo(model:GetScale() * target / current)
	end
end

local unified = false -- true once the Veiled Ascetic is mounted; Roots/SacredTree then add nothing

function Dressing.Colossus(parent: Instance, anchor: CFrame, proxy: Instance?, focus: Vector3?): boolean
	local statue = asset("FusedTreeStatue")
	unified = statue ~= nil
	statue = statue or asset("AsuraColossusStatue")
	if not statue then
		return false
	end
	settle(statue, true)
	if unified then
		-- Figure, tree and leaves are laid out against the dais and arch by SanctuaryTitan.
		if not Titan.Mount(statue, anchor, focus) then
			statue:Destroy()
			unified = false
			return false
		end
	else
		scaleTo(statue, "Y", COLOSSUS_HEIGHT)
		statue:PivotTo(anchor * CFrame.Angles(0, math.rad(COLOSSUS_YAW), 0))
	end
	statue.Parent = parent
	if proxy then proxy:Destroy() end
	return true
end

-- Roots radiate from the plinth like they grew out of the stone: tilted, half-sunk, varied.
function Dressing.Roots(parent: Instance, base: CFrame): boolean
	if unified then return true end -- roots are grown onto the Veiled Ascetic itself
	local template = asset("AsuraRoots")
	if not template then
		return false
	end
	scaleTo(template, "X", ROOT_LENGTH)
	settle(template, false)
	for index, yaw in { 20, 95, 160, 215, 290, 340 } do
		local roots = if index == 1 then template else template:Clone()
		local reach = 20 + (index % 3) * 3
		local spot = base * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.new(0, 0.6, -reach)
		roots:PivotTo(spot * CFrame.Angles(math.rad(-8 - (index % 2) * 6), math.rad(90), 0))
		roots.Parent = parent
	end
	return true
end

-- The fallen trunk stands upright as the dead sacred tree; its crown sheds crimson petals.
function Dressing.SacredTree(parent: Instance, base: CFrame): boolean
	if unified then return true end -- the canopy over her head is the sacred tree
	local tree = asset("AsuraDeadTrunk")
	if not tree then
		return false
	end
	tree:PivotTo(CFrame.Angles(0, 0, math.rad(90)))
	scaleTo(tree, "Y", TREE_HEIGHT)
	settle(tree, true)
	local size = tree:GetExtentsSize()
	tree:PivotTo(base * CFrame.new(0, size.Y * 0.5 - 2, 0) * CFrame.Angles(math.rad(6), 0, math.rad(90)))
	tree.Parent = parent
	local crown = Instance.new("Part")
	crown.Name = "PetalSource"
	crown.Anchored, crown.CanCollide, crown.CanQuery, crown.CanTouch = true, false, false, false
	crown.Transparency = 1
	crown.Size = Vector3.new(16, 4, 16)
	crown.CFrame = base * CFrame.new(0, TREE_HEIGHT - 4, 0)
	crown.Parent = parent
	Leaves.Emitter(crown)
	return true
end

-- A pair of dark iron gates, swung open to frame the Ascension portal.
function Dressing.PortalGates(parent: Instance, portal: CFrame, width: number): boolean
	local template = asset("AsuraIronGate")
	if not template then
		return false
	end
	scaleTo(template, "Y", GATE_HEIGHT)
	settle(template, false)
	local floor = portal * CFrame.new(0, -5.7, 0)
	for side = -1, 1, 2 do
		local gate = if side == 1 then template else template:Clone()
		local hinge = floor * CFrame.new(side * (width * 0.5 + 0.5), 0, 1.5)
		gate:PivotTo(hinge * CFrame.Angles(0, math.rad(side * 70 + (if side == 1 then 180 else 0)), 0) * CFrame.new(side * 3, 0, 0))
		gate.Parent = parent
	end
	return true
end

return Dressing
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="160">
          <Properties>
            <string name="Name">SanctuaryDuelCourt</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryDuelCourt
-- The Colosseum Promenade restyled as an open duel court on a rock spur: a paved octagonal balcony
-- ringed by carved balustrade, crimson banners on every far vertex and braziers flanking the gallery
-- entry, with the PvP ring itself still raised at the centre by ColosseumService (unchanged size and
-- id). `base` is the Promenade centre on the balcony top; the gallery arrives from -X.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Rails = require(script.Parent:WaitForChild("SanctuaryRails") :: ModuleScript)
local Props = require(script.Parent:WaitForChild("SanctuaryProps") :: ModuleScript)

local DuelCourt = {}

local ENTRY = 7 -- half-width of the opening for the 12-stud gallery walkway

function DuelCourt.Build(parent: Instance, base: CFrame, apothem: number): Folder
	local group = Kit.folder("ColosseumPromenade", parent)
	for index = 0, 1 do
		local yaw = base * CFrame.Angles(0, math.rad(45 * index), 0)
		Kit.slab(group, "Balcony" .. index, Vector3.new(apothem * 2, 5, apothem * 2), yaw * CFrame.new(0, -2.5, 0), "Paving")
		Kit.slab(group, "BalconySkirting" .. index, Vector3.new(apothem * 2 + 1, 2, apothem * 2 + 1), yaw * CFrame.new(0, -4.4, 0), "StoneDark")
	end
	-- Inner sill ring of darker stone just outside the duel band, so the court reads as a stage.
	local sill = Kit.disc(group, "CourtSill", 27, 0.3, base * CFrame.new(0, -0.1, 0), Kit.Surface.StoneDark.Color, Enum.Material.Slate, Kit.decor())
	sill.MaterialVariant = Kit.Surface.StoneDark.Variant
	local half = apothem * math.tan(math.rad(22.5)) - 0.9
	for k = 0, 7 do
		local edge = base * CFrame.Angles(0, math.rad(45 * k), 0) * CFrame.new(0, 0, -(apothem - 0.7))
		local a, b = (edge * CFrame.new(-half, 0, 0)).Position, (edge * CFrame.new(half, 0, 0)).Position
		if k == 5 then
			-- South-east edge stays open onto the landing below the spectator balcony stair (WagerWorld).
			local landing = base * CFrame.Angles(0, math.rad(225), 0) * CFrame.new(0, 0, -(apothem + 9))
			Kit.slab(group, "SpectatorLanding", Vector3.new(30, 5, 18), landing * CFrame.new(0, -2.5, 0), "Paving")
			Kit.slab(group, "SpectatorLandingSkirting", Vector3.new(31, 2, 18.5), landing * CFrame.new(0, -4.4, 0), "StoneDark")
			for s = -1, 1, 2 do
				Rails.run(group, (landing * CFrame.new(s * 14.4, 0, 8.4)).Position, (landing * CFrame.new(s * 14.4, 0, -8.4)).Position)
			end
		elseif k == 2 then
			-- West edge: the gallery walkway comes in through its middle.
			local c = edge.Position
			local dir = (b - a).Unit
			Rails.run(group, a, c - dir * ENTRY)
			Rails.run(group, c + dir * ENTRY, b)
		else
			Rails.run(group, a, b)
		end
		local vertex = base * CFrame.Angles(0, math.rad(45 * k + 22.5), 0) * CFrame.new(0, 0, -(apothem / math.cos(math.rad(22.5)) - 2.6))
		local facing = CFrame.lookAt(vertex.Position, base.Position) -- banners turn their cloth to the court
		if k == 1 or k == 2 then
			Props.brazier(group, facing)
		else
			Props.banner(group, facing, 16)
		end
	end
	for _, k in { 0, 4, 6 } do
		local mid = base * CFrame.Angles(0, math.rad(45 * k), 0) * CFrame.new(0, 0, -(apothem - 4))
		Props.lantern(group, mid)
	end
	return group
end

return table.freeze(DuelCourt)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="161">
          <Properties>
            <string name="Name">SanctuaryEcology</string>
            <string name="Source">--!strict
-- Small Blender-authored erosion and botanical modules. All pieces are decorative; the existing
-- terrace/bridge movement supports remain authoritative. Shared meshes keep repetition cheap.
local Kit = require(script.Parent.SanctuaryKit)
local Ecology = {}

local function piece(group: Instance, name: string, frame: CFrame, scale: Vector3, tint: Color3?): Model?
	local model = Kit.place(group, name, frame, scale, false)
	if not model then return nil end
	model:SetAttribute("AsuraDetailCluster", true)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			part:SetAttribute("AsuraMicroDetail", true)
			if tint then
				local finish = part:FindFirstChildOfClass("SurfaceAppearance")
				if finish then finish.Color = tint else part.Color = tint end
			end
		end
	end
	return model
end

local function planting(group: Instance, at: CFrame, scale: number, seed: number)
	local rng = Random.new(seed)
	for i = 1, 3 do
		local cf = at * CFrame.new(rng:NextNumber(-2.6, 2.6) * scale, 0, rng:NextNumber(-1.5, 1.5) * scale)
			* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), math.rad(rng:NextNumber(-7, 7)))
		piece(group, "Detail_Fern", cf, Vector3.one * scale * rng:NextNumber(0.65, 1.25),
			if i % 2 == 0 then Color3.fromRGB(51, 71, 43) else Color3.fromRGB(70, 86, 43))
	end
	piece(group, "Detail_MapleSpray", at * CFrame.new(0, 0.25 * scale, 0) * CFrame.Angles(0, seed, math.rad(-9)),
		Vector3.new(1.4, 0.9, 1.1) * scale, Color3.fromRGB(139, 22, 31))
end

function Ecology.Build(parent: Instance, origin: CFrame)
	local group = Kit.folder("CreviceEcology", parent)
	-- The procession and spillway mouths stay open. Unequal shelves break the smooth edge into
	-- short beds, dark crevices and warm lichen-bearing ledges visible from player height.
	for i, a in { {-49,-27,1.2,19}, {47,-30,1.0,-24}, {-50,32,1.25,-13}, {48,34,0.9,16},
		{-84,6,1.0,27}, {83,-1,0.85,-22}, {-18,46,0.8,8}, {19,46,0.95,-13} } do
		local at = origin * CFrame.new(a[1], -2.3, a[2]) * CFrame.Angles(0, math.rad(a[4]), 0)
		piece(group, "Detail_Strata", at, Vector3.new(1.2, 1.2, 1.3) * a[3], Color3.fromRGB(138, 153, 164))
		piece(group, "Detail_Fissure", at * CFrame.new(2, -12, 1.1) * CFrame.Angles(0, 0, math.rad(12)),
			Vector3.new(1.0, 1.1, 0.9) * a[3], Color3.fromRGB(116, 132, 145))
		planting(group, at * CFrame.new(-2.6, 2.5, 0), a[3] * 0.65, 3100 + i)
	end
	-- Root terrace front shoulders: fractured strata run beneath the parapets, not through stairs.
	local terrace = origin * CFrame.new(0, 20, -345)
	for i, a in { {-51,246,1.3,-20}, {54,244,1.6,18}, {-106,211,1.6,-37}, {112,204,1.3,36},
		{-181,130,1.5,-48}, {186,118,1.7,44}, {-226,38,1.8,-70}, {223,18,1.6,68} } do
		local at = terrace * CFrame.new(a[1], -2.5, a[2]) * CFrame.Angles(0, math.rad(a[4]), 0)
		for k = 0, 1 do
			piece(group, "Detail_Strata", at * CFrame.new(k * 3, -k * 2.6, -k),
				Vector3.new(1.6, 1.1, 1.4) * a[3], Color3.fromRGB(148, 163, 173))
		end
		piece(group, "Detail_Fissure", at * CFrame.new(-3, -18, 1), Vector3.new(1.3, 1.5, 1.1) * a[3], Color3.fromRGB(121, 138, 153))
		planting(group, at * CFrame.new(0, 3.0, -2), a[3], 4200 + i)
	end
	-- Rich foreground planting under the prayer-court maples and at the stone/water junctions.
	for i, a in { {-38,-14}, {39,-17}, {-48,13}, {47,9} } do planting(group, origin * CFrame.new(a[1], 0.1, a[2]), 0.7, 5100 + i) end
	group:SetAttribute("AuthoredMeshTriangles", 1382)
	group:SetAttribute("CollisionParts", 0)
end

return table.freeze(Ecology)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="162">
          <Properties>
            <string name="Name">SanctuaryForge</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryForge
-- The working forge of the Blacksmith Loggia, rebuilt from the lobby kit: a timber hall under a
-- hip-and-gable roof on a paved platform, a brick-and-stone furnace with a chimney through the roof,
-- anvil, quench-side racks, coal, bellows and benches, balustrade open to the walkway. Gameplay stays
-- in SanctuaryService (Master Smith Gao, his prompts and the quench trough); this module is the
-- building around them and keeps their spots clear. `base` is the Loggia centre on the platform top.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Frame = require(script.Parent:WaitForChild("SanctuaryFrame") :: ModuleScript)
local Rails = require(script.Parent:WaitForChild("SanctuaryRails") :: ModuleScript)
local Props = require(script.Parent:WaitForChild("SanctuaryProps") :: ModuleScript)
local Eaves = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.ArsenalCatalog).Caches.SanctuaryEaves

local Forge = {}

local HALF = 18 -- platform half-size
local HALL = { Z = -2, Width = 30, Depth = 20, Height = 12 }
local M = Enum.Material
local rgb = Color3.fromRGB
local Y = Vector3.yAxis

local function timberBrace(group: Instance, name: string, a: Vector3, b: Vector3, thickness: number)
	Kit.slab(group, name, Vector3.new(thickness, thickness, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), "Timber", Kit.decor())
end

local function fire(parent: BasePart, size: number, heat: number)
	local f = Instance.new("Fire")
	f.Size, f.Heat, f.Color, f.SecondaryColor = size, heat, rgb(255, 110, 40), rgb(200, 40, 20)
	f.Parent = parent
end

local function furnace(group: Instance, base: CFrame, embers: (BasePart) -&gt; ())
	local at = base * CFrame.new(-12, 0, 0)
	-- Keep the original solid envelope for circulation, with a recessed hearth behind a stone frontage.
	Kit.part(group, "Forge", Vector3.new(7, 6, 6), at * CFrame.new(0, 3, 0), rgb(67, 64, 60), M.Brick,
		{ Collide = true, Query = true, Transparency = 1, Shadow = false })
	Kit.slab(group, "ForgePlinth", Vector3.new(7.8, 0.8, 6.8), at * CFrame.new(0, 0.4, 0), "StoneDark")
	Kit.slab(group, "ForgeBack", Vector3.new(1, 5.2, 6), at * CFrame.new(-3, 3.4, 0), "StoneDark", Kit.decor())
	for _, side in { -1, 1 } do
		Kit.slab(group, "ForgeCheek", Vector3.new(6.1, 5.2, 1.25), at * CFrame.new(0.4, 3.4, side * 2.38), "StoneDark", Kit.decor())
		Kit.slab(group, "HearthJamb", Vector3.new(1.1, 3.8, 1.1), at * CFrame.new(3.1, 2.7, side * 2.24), "Stone", Kit.decor())
	end
	Kit.slab(group, "HearthLintel", Vector3.new(1.2, 1.2, 5.8), at * CFrame.new(3.1, 5.2, 0), "Stone", Kit.decor())
	Kit.slab(group, "ForgeHood", Vector3.new(8, 0.8, 7), at * CFrame.new(0, 6.2, 0), "StoneDark", Kit.decor())
	for i, layer in { { 7, 1.2, 6 }, { 5.8, 1.2, 4.8 }, { 4.2, 1, 3.8 } } do
		Kit.slab(group, "HoodMasonryCourse", Vector3.new(layer[1], layer[2], layer[3]), at * CFrame.new(-0.4, 6.1 + i * 1.1, 0), "StoneDark", Kit.decor())
	end
	Kit.part(group, "HearthSoot", Vector3.new(0.1, 3.5, 3.4), at * CFrame.new(0.6, 2.9, 0), rgb(24, 24, 24), M.Basalt, Kit.decor())
	Kit.part(group, "Chimney", Vector3.new(3, 15, 3), at * CFrame.new(-1, 16.5, 0), rgb(69, 65, 60), M.Brick)
	for _, h in { 9.6, 17, 23.8 } do
		Kit.part(group, "ChimneyIronBand", Vector3.new(3.12, 0.23, 3.12), at * CFrame.new(-1, h, 0), Kit.Palette.Iron, M.Metal, Kit.decor())
	end
	Kit.place(group, "Roof_Square", at * CFrame.new(-1, 24.2, 0), 0.3)
	Kit.slab(group, "HearthApron", Vector3.new(2.8, 0.25, 5.7), at * CFrame.new(4.1, 0.92, 0), "StoneDark", Kit.decor())
	local mouth = Kit.part(group, "ForgeMouth", Vector3.new(1.3, 0.18, 3.3), at * CFrame.new(2.8, 1.25, 0), rgb(50, 42, 37), M.Basalt, Kit.decor())
	for z = -1.4, 1.4, 0.56 do
		Kit.part(group, "HearthGrate", Vector3.new(1.65, 0.12, 0.1), at * CFrame.new(2.8, 1.4, z), Kit.Palette.Iron, M.Metal, Kit.decor())
	end
	fire(mouth, 3.2, 5)
	embers(mouth)
	Kit.light(mouth, rgb(255, 147, 76), 22, 2.1, true)
	-- Coal heap and bellows beside the mouth.
	for k = 0, 6 do
		local ball = Kit.part(group, "Coal", Vector3.new(1.1, 0.8, 1.1), at * CFrame.new(4.4 + (k % 3) * 0.7, 0.35 + math.floor(k / 3) * 0.4, 3.3 + (k % 2) * 0.6),
			rgb(30, 28, 28), M.Basalt, Kit.decor())
		ball.Shape = Enum.PartType.Ball
	end
	Kit.slab(group, "Bellows", Vector3.new(2.6, 1.2, 1.6), at * CFrame.new(2.2, 0.9, -3.8), "Timber")
	Kit.part(group, "BellowsHide", Vector3.new(2.2, 0.9, 1.7), at * CFrame.new(2.4, 1.9, -3.8), rgb(86, 58, 40), M.Leather, Kit.decor())
end

local function workshop(group: Instance, base: CFrame)
	Kit.disc(group, "Stump", 1.2, 2, base * CFrame.new(-4, 1, 3), rgb(70, 52, 40), M.Wood)
	Kit.part(group, "AnvilFoot", Vector3.new(1.8, 0.22, 2.2), base * CFrame.new(-4, 2.11, 3), rgb(48, 48, 50), M.Metal, Kit.decor())
	Kit.part(group, "AnvilWaist", Vector3.new(0.92, 0.68, 1.1), base * CFrame.new(-4, 2.46, 3), rgb(49, 49, 52), M.Metal, Kit.decor())
	Kit.part(group, "AnvilBody", Vector3.new(1.45, 0.32, 2.8), base * CFrame.new(-4, 2.95, 3), rgb(73, 77, 81), M.Metal)
	Kit.part(group, "AnvilHorn", Vector3.new(1.0, 0.32, 1.3), base * CFrame.new(-4, 2.95, 5.0), rgb(73, 77, 81), M.Metal, { Class = "WedgePart" })
	-- Weapon rack against the back wall, clear of the corner column.
	local rack = base * CFrame.new(-14.3, 0, -7)
	Kit.slab(group, "Rack", Vector3.new(0.6, 4.4, 6), rack * CFrame.new(0, 2.2, 0), "Lacquer")
	for k = -1, 1 do
		Kit.part(group, "RackBlade" .. (k + 2), Vector3.new(0.15, 3.8, 0.4), rack * CFrame.new(0.5, 2.6, k * 1.8) * CFrame.Angles(math.rad(-8), 0, 0),
			rgb(190, 194, 200), M.Metal, Kit.decor())
	end
	for _, z in { -2.5, 2.5 } do
		Kit.slab(group, "RackFoot", Vector3.new(2.1, 0.3, 0.7), rack * CFrame.new(0.1, 0.15, z), "Timber", Kit.decor())
	end
	-- Bench with tongs and hammers, barrels of quench oil.
	local bench = base * CFrame.new(-6, 0, 7.5)
	Kit.slab(group, "Workbench", Vector3.new(6, 0.4, 2), bench * CFrame.new(0, 2.6, 0), "Timber")
	for x = -2.6, 2.6, 5.2 do
		Kit.slab(group, "BenchLeg", Vector3.new(0.4, 2.4, 1.6), bench * CFrame.new(x, 1.2, 0), "Timber")
	end
	for x = -1.5, 1.5, 1.5 do
		Kit.part(group, "Tool", Vector3.new(0.3, 0.2, 1.6), bench * CFrame.new(x, 2.9, 0) * CFrame.Angles(0, math.rad(x * 12), 0), rgb(60, 60, 64), M.Metal, Kit.decor())
	end
	for _, p in { { 3.5, 7.4 }, { 5, 6.6 } } do
		local barrel = base * CFrame.new(p[1], 0, p[2])
		Kit.disc(group, "Barrel", 1, 2.4, barrel * CFrame.new(0, 1.2, 0), rgb(76, 54, 40), M.Wood).MaterialVariant = Kit.Surface.Timber.Variant
		for _, h in { 0.35, 1.95 } do
			Kit.disc(group, "BarrelHoop", 1.025, 0.14, barrel * CFrame.new(0, h, 0), Kit.Palette.Iron, M.Metal, Kit.decor())
		end
	end
end

-- The existing cache deck and climbable truss stay in LootWorld. This timberwork carries its load
-- visually without adding collision to the ladder's climbing volume or the service-ledge route.
local function lookout(group: Instance, base: CFrame)
	local x, z, height = Eaves.X - base.X, Eaves.Z - base.Z, Eaves.Y - base.Y - 1.9
	for _, side in { -1, 1 } do
		local cf = base * CFrame.new(x + side * 4.2, 0, HALF - 2)
		Kit.slab(group, "LookoutPostFoot", Vector3.new(1.9, 0.7, 1.9), cf * CFrame.new(0, 0.35, 0), "StoneDark", Kit.decor())
		Kit.slab(group, "LookoutTimberPost", Vector3.new(0.85, height, 0.85), cf * CFrame.new(0, height / 2, 0), "Timber", Kit.decor())
		Kit.slab(group, "LookoutCantilever", Vector3.new(0.85, 0.8, z + 4 - (HALF - 2)), cf * CFrame.new(0, height - 0.25, (z + 4 - (HALF - 2)) / 2), "Timber", Kit.decor())
		local a = (cf * CFrame.new(0, height * 0.32, 0)).Position
		local b = (base * CFrame.new(x + side * 4.2, height - 0.4, z + 2.5)).Position
		timberBrace(group, "LookoutKneeBrace", a, b, 0.65)
	end
	Kit.slab(group, "LookoutCrossTie", Vector3.new(10.8, 0.7, 0.9), base * CFrame.new(x, height - 0.25, z + 2.5), "Timber", Kit.decor())
end

-- `embers` lets the service keep its shared ember emitter for the forge mouth.
function Forge.Build(parent: Instance, base: CFrame, embers: (BasePart) -&gt; ()): Folder
	local group = Kit.folder("BlacksmithLoggia", parent)
	Kit.slab(group, "Platform", Vector3.new(HALF * 2, 6, HALF * 2), base * CFrame.new(0, -3, 0), "Paving")
	Kit.slab(group, "PlatformSkirting", Vector3.new(HALF * 2 + 1, 2, HALF * 2 + 1), base * CFrame.new(0, -4.4, 0), "StoneDark")
	local hall = base * CFrame.new(0, 0, HALL.Z)
	Frame.pavilion(group, hall, HALL.Width, HALL.Depth, HALL.Height, { Rise = 1.2 })
	-- Back wall: stone dado and a timber lattice up to the beams, behind the furnace.
	local back = hall * CFrame.new(-HALL.Width / 2 - 1.2, 0, 0)
	Kit.slab(group, "BackWall", Vector3.new(1.2, 4.5, HALL.Depth), back * CFrame.new(0, 2.25, 0), "StoneDark")
	Kit.slab(group, "LatticeRail", Vector3.new(0.5, 0.4, HALL.Depth), back * CFrame.new(0, 4.7, 0), "Timber", Kit.decor())
	for z = -HALL.Depth / 2 + 0.7, HALL.Depth / 2 - 0.7, 1.1 do
		Kit.slab(group, "Lattice", Vector3.new(0.3, 6.8, 0.22), back * CFrame.new(0, 8.3, z), "Timber", Kit.decor())
	end
	Kit.blocker(group, "BackWallCollision", (back * CFrame.new(0, 0, -HALL.Depth / 2)).Position, (back * CFrame.new(0, 0, HALL.Depth / 2)).Position, HALL.Height, 1.2)
	furnace(group, base, embers)
	workshop(group, base)
	lookout(group, base)
	local e = HALF - 0.6
	local function run(a: Vector3, b: Vector3)
		Rails.run(group, (base * CFrame.new(a)).Position, (base * CFrame.new(b)).Position)
	end
	run(Vector3.new(-e, 0, -e), Vector3.new(e, 0, -e))
	-- South edge: open where the Loggia Eaves ladder (LootWorld) stands, so it is climbed from the platform.
	local ladder = Eaves.X - base.X
	run(Vector3.new(-e, 0, e), Vector3.new(ladder - 3, 0, e))
	run(Vector3.new(ladder + 3, 0, e), Vector3.new(e, 0, e))
	run(Vector3.new(-e, 0, -e), Vector3.new(-e, 0, e))
	run(Vector3.new(e, 0, -e), Vector3.new(e, 0, -7))
	run(Vector3.new(e, 0, 7), Vector3.new(e, 0, e))
	-- Lanterns at the hall's east corners, clear of its columns and the walkway mouth.
	for _, z in { -15, 14 } do
		Props.lantern(group, base * CFrame.new(e - 3.4, 0, z))
	end
	Props.tree(group, base * CFrame.new(-13.5, 0, 13.5) * CFrame.Angles(0, 2.2, 0), 0.85, true)
	Props.shrub(group, base * CFrame.new(-15.5, 0, -15.5), 1.2)
	return group
end

return table.freeze(Forge)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="163">
          <Properties>
            <string name="Name">SanctuaryFrame</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryFrame
-- Timber-frame assemblies from the lobby kit: lacquered columns on carved stone bases, architraves,
-- bracket sets, hip-and-gable pavilions and covered galleries. Only the columns collide (one invisible
-- box each); beams, brackets and roofs are overhead and never stop a body or a camera.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)

local Frame = {}

local BASE = 0.9 -- Column_Base height
local COLUMN = 10 -- Column_Lacquer authored height
local BRACKET = 2.79 -- Bracket_Set height
local HALL = Vector3.new(30, 7.5, 18) -- Roof_Hall eave footprint and rise as authored
local SQUARE = Vector3.new(14, 5.6, 14) -- Roof_Square
local GALLERY = Vector3.new(8.8, 1, 10) -- Roof_Gallery bay length, rise scale, eave depth
local Y = Vector3.yAxis
local M = Enum.Material

export type Options = { Lanterns: boolean?, Rise: number?, CapStart: boolean?, CapEnd: boolean?, Skip: { [number]: boolean }?, Xs: { number }?, Square: boolean?, Collide: boolean? }

-- `collide` false when a layout box already stands there (SanctuaryRoutes), for the offline suites.
function Frame.column(parent: Instance, foot: Vector3, height: number, collide: boolean?)
	if collide ~= false then
		Kit.part(parent, "ColumnCollision", Vector3.new(1.3, height, 1.3), CFrame.new(foot + Y * height * 0.5), Color3.new(), M.SmoothPlastic,
			{ Collide = true, Query = false, Transparency = 1, Shadow = false })
	end
	if Kit.place(parent, "Column_Base", CFrame.new(foot)) then
		Kit.place(parent, "Column_Lacquer", CFrame.new(foot + Y * BASE), Vector3.new(1, (height - BASE) / COLUMN, 1))
		return
	end
	Kit.slab(parent, "ColumnFoot", Vector3.new(2.1, 0.9, 2.1), CFrame.new(foot + Y * 0.45), "Stone", Kit.decor())
	Kit.slab(parent, "LacquerColumn", Vector3.new(1.2, height - 0.9, 1.2), CFrame.new(foot + Y * (height + 0.9) * 0.5), "Lacquer", Kit.decor())
end

-- Architrave between two column tops at the same height (its top is flush with them).
function Frame.beam(parent: Instance, a: Vector3, b: Vector3)
	local length = (Vector3.new(b.X, 0, b.Z) - Vector3.new(a.X, 0, a.Z)).Magnitude
	local cf = Kit.along(a, b) * CFrame.new(0, -2.02, 0)
	if not Kit.place(parent, "Beam_Architrave", cf, Vector3.new(length / 8, 1, 1)) then
		Kit.slab(parent, "Architrave", Vector3.new(length, 1.6, 0.8), cf * CFrame.new(0, 1.2, 0), "Timber", Kit.decor())
	end
end

function Frame.hanging(parent: Instance, hook: Vector3, range: number?)
	if not Kit.place(parent, "Lantern_Hanging", CFrame.new(hook)) then
		Kit.lanternFallback(parent, CFrame.new(hook), true)
	end
	Kit.glow(parent, CFrame.new(hook - Y * 1.3), Vector3.new(0.88, 1.0, 0.88), range or 15, 1.35, 6)
end

-- Pavilion on `cf` (floor centre; X = width). Columns every &lt;= 11 studs along the width.
function Frame.pavilion(parent: Instance, cf: CFrame, width: number, depth: number, height: number, options: Options?): Model?
	local o: Options = options or {}
	local bays = math.max(1, math.ceil(width / 11))
	local xs = o.Xs or {}
	if #xs == 0 then
		for i = 0, bays do
			table.insert(xs, -width / 2 + width * i / bays)
		end
	end
	local skip = o.Skip or {}
	for side = -1, 1, 2 do
		local tops = {}
		for i, x in xs do
			local foot = (cf * CFrame.new(x, 0, side * depth / 2)).Position
			if not skip[(side + 1) * 50 + i - 1] then
				Frame.column(parent, foot, height, o.Collide)
				Kit.place(parent, "Bracket_Set", CFrame.fromMatrix(foot + Y * height, cf.XVector, Y))
			end
			table.insert(tops, foot + Y * height)
		end
		for i = 1, #tops - 1 do
			Frame.beam(parent, tops[i], tops[i + 1])
		end
		local a = (cf * CFrame.new(side * width / 2, height, -depth / 2)).Position
		local b = (cf * CFrame.new(side * width / 2, height, depth / 2)).Position
		Frame.beam(parent, a, b)
	end
	local dims = if o.Square then SQUARE else HALL
	local scale = Vector3.new((width + 8) / dims.X, o.Rise or 1, (depth + 8) / dims.Z)
	local eave = if o.Square then height + 2.2 else height + 3.67 - 2.0 * scale.Y
	if o.Lanterns ~= false then
		Frame.hanging(parent, (cf * CFrame.new(0, height - 0.2, 0)).Position)
	end
	local roof = Kit.place(parent, if o.Square then "Roof_Square" else "Roof_Hall", cf * CFrame.new(0, eave, 0), scale)
	if not roof then
		Kit.slab(parent, "PavilionRoof", Vector3.new(width + 6, 1.2, depth + 6), cf * CFrame.new(0, height + 1.2, 0), "RoofTile", Kit.decor())
	end
	return roof
end

-- Covered gallery along floor points a -&gt; b (centre line), columns both sides every ~7.5 studs.
function Frame.gallery(parent: Instance, a: Vector3, b: Vector3, width: number, height: number, options: Options?)
	local o: Options = options or {}
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local length = flat.Magnitude
	local dir = flat.Unit
	local side = dir:Cross(Y).Unit
	local n = math.max(1, math.round(length / 7.5))
	local step = length / n
	local skip = o.Skip or {}
	for s = -1, 1, 2 do
		local previous: Vector3? = nil
		for i = 0, n do
			local foot = a + dir * step * i + side * s * width / 2
			if not skip[(s + 1) * 50 + i] then
				Frame.column(parent, foot, height)
			end
			local top = foot + Y * height
			if previous then
				Frame.beam(parent, previous, top)
			end
			previous = top
		end
	end
	local scale = Vector3.new(step / GALLERY.X, 1, (width + 2.6) / GALLERY.Z)
	for i = 1, n do
		local mid = a + dir * step * (i - 0.5) + Y * (height + 0.2)
		if not Kit.place(parent, "Roof_Gallery", CFrame.fromMatrix(mid, dir, Y), scale) then
			Kit.slab(parent, "GalleryRoof", Vector3.new(step, 1, width + 2.6), CFrame.fromMatrix(mid + Y, dir, Y), "RoofTile", Kit.decor())
		end
		if o.Lanterns ~= false and i % 2 == 1 then
			Frame.hanging(parent, mid - Y * 0.5, 14)
		end
	end
	local capScale = Vector3.new(1, 1, scale.Z)
	if o.CapStart ~= false then
		Kit.place(parent, "Roof_GalleryEnd", CFrame.fromMatrix(a + Y * (height + 0.2), dir, Y), capScale)
	end
	if o.CapEnd ~= false then
		Kit.place(parent, "Roof_GalleryEnd", CFrame.fromMatrix(b + Y * (height + 0.2), -dir, Y), capScale)
	end
end

return table.freeze(Frame)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="164">
          <Properties>
            <string name="Name">SanctuaryHorizon</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryHorizon
-- What holds the Shrine up and what surrounds it: layered karst foundations (lobby kit cliffs) under
-- the courtyard, the walkways, the forge platform, the duel court and the Well of Descent; a sea of
-- sunlit cloud below; and an authored karst landscape with inhabited summit pagodas and cascades. Nothing here collides - falls still drop to SanctuaryService's cloud catch.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)

local Vista = require(script.Parent:WaitForChild("SanctuaryVista") :: ModuleScript)
local Horizon = {}

local function rock(group: Instance, name: string, cf: CFrame, scale: Vector3)
	if not Kit.place(group, name, cf, scale, false) then
		local size = Vector3.new(30, 24, 30) * scale
		Kit.slab(group, "RockFoot", size, cf * CFrame.new(0, -size.Y / 2, 0), "Rock", { Collide = false, Query = false, Shadow = false })
	end
end

-- Foundations: `origin` is the plaza centre; forge/duel centres and the descent pavilion are local.
function Horizon.Foundations(parent: Instance, origin: CFrame, forge: Vector3, duel: Vector3, descent: Vector3)
	local group = Kit.folder("Foundations", parent)
	for k = 0, 3 do
		local side = origin * CFrame.Angles(0, math.rad(90 * k), 0)
		for _, x in { -22, 22 } do
			rock(group, "Cliff_Shelf", side * CFrame.new(x, -5.6, -38) * CFrame.Angles(0, (x / 22) * 0.12, 0), Vector3.new(0.72, 1.4, 1.2))
		end
		rock(group, "Cliff_Ledge", side * CFrame.new(-34, -5.4, -34), Vector3.new(0.7, 1.25, 0.7))
	end
	rock(group, "Cliff_Spur", origin * CFrame.new(0, -28, 0), Vector3.new(4.2, 2.6, 4.2))
	rock(group, "Cliff_Ledge", origin * CFrame.new(forge) * CFrame.new(0, -5.2, 0), Vector3.new(0.95, 1.5, 0.95))
	rock(group, "Cliff_Spur", origin * CFrame.new(forge) * CFrame.new(-2, -36, 3), Vector3.new(2, 1.8, 2))
	rock(group, "Cliff_Ledge", origin * CFrame.new(duel) * CFrame.new(0, -4.8, 0), Vector3.new(1.65, 1.6, 1.65))
	rock(group, "Cliff_Spur", origin * CFrame.new(duel) * CFrame.new(4, -42, -2), Vector3.new(2.6, 2.2, 2.6))
	rock(group, "Cliff_Ledge", origin * CFrame.new(descent) * CFrame.new(0, -6.2, 0), Vector3.new(0.85, 1.1, 0.85))
	for _, x in { -56, 54 } do -- under the two walkways
		rock(group, "Cliff_Shelf", origin * CFrame.new(x, -3.3, 0) * CFrame.Angles(0, 0.04 * x, 0), Vector3.new(0.34, 0.8, 0.5))
	end
	rock(group, "Cliff_Shelf", origin * CFrame.new(0, -3.4, 60) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(0.4, 0.8, 0.5))
	-- Fractured shoulders break the straight platform rims into natural hanging escarpments.
	for i, placement in { { -43, -34, 22 }, { 42, -27, -18 }, { -38, 27, 63 }, { 40, 31, -51 } } do
		local edge = origin * CFrame.new(placement[1], -12 - i * 2, placement[2]) * CFrame.Angles(0, math.rad(placement[3]), 0)
		rock(group, "Cliff_Shelf", edge, Vector3.new(0.72, 2.25, 0.82))
		rock(group, "Cliff_Spur", edge * CFrame.new(5, -33, -2), Vector3.new(1.55, 2.65, 1.2))
	end
	return group
end

local function mist(anchor: BasePart, rate: number, size: number, transparency: number, color: Color3, lifetime: number, initial: number)
	if Assets.Textures.Smoke == "" then
		return
	end
	local e = Instance.new("ParticleEmitter")
	e.Name = "RollingCloud"
	e.Texture, e.Rate, e.Lifetime, e.Speed = Assets.Textures.Smoke, rate, NumberRange.new(lifetime - 5, lifetime), NumberRange.new(0.6, 1.2)
	e.Acceleration, e.Shape, e.ShapeStyle = Vector3.new(0.025, 0, 0.015), Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
	e.EmissionDirection, e.SpreadAngle = Enum.NormalId.Right, Vector2.new(8, 8)
	e.Size = Kit.sequence({ { 0, size * 0.78 }, { 0.48, size }, { 1, size * 1.1 } })
	e.Transparency = Kit.sequence({ { 0, 0.8 }, { 0.16, transparency }, { 0.68, transparency + 0.08 }, { 1, 1 } })
	e.Color = ColorSequence.new(color, Color3.fromRGB(242, 238, 236))
	e.LightInfluence, e.LightEmission = 0.05, 0.18
	e.Rotation, e.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-1.8, 1.8)
	e.Parent = anchor
	e:Emit(initial)
end

-- Two staggered beds fill the space below the island rather than painting the horizon alone.
-- Their opaque silhouettes are the overlapping soft particle alpha, never flattened mesh discs.
-- Every local emitter is 70–100 studs below the plaza; its largest puff stays below flagstones.
function Horizon.Build(parent: Instance, origin: CFrame)
	local sky = Kit.folder("CloudSea", parent)
	for row, z in { -560, -340, -120, 100 } do
		for column, x in { -220, 0, 220 } do
			local lower = Kit.hidden(sky, "DeepCloudBank", Vector3.new(210, 8, 210), origin * CFrame.new(x, -100 + (row % 2) * 2, z))
			mist(lower, 0.7, 142, 0.14, Color3.fromRGB(247, 243, 237), 26, 8)
			local upper = Kit.hidden(sky, "SunlitCloudCrest", Vector3.new(185, 6, 185), origin * CFrame.new(x + 22, -80 + (column % 2) * 2, z + 40))
			mist(upper, 0.48, 106, 0.10, Color3.fromRGB(247, 243, 237), 24, 7)
		end
	end
	-- Broad but sparse foot banks connect the rolling local sea to the hazed physical mountains.
	for _, bank in {
		{ -1180, -1120 }, { 1120, -1050 }, { -1920, -980 }, { 1870, -1640 },
		{ -920, 890 }, { 1320, 640 }, { 400, 2000 }, { -980, 2490 },
	} do
		local anchor = Kit.hidden(sky, "MountainFootCloud", Vector3.new(420, 12, 320), origin * CFrame.new(bank[1], -90, bank[2]))
		mist(anchor, 1.0, 240, 0.08, Color3.fromRGB(247, 243, 237), 34, 22)
	end
	Vista.Build(parent, origin)
	sky:SetAttribute("CloudMeshBudget", 0)
	sky:SetAttribute("MistEmitterBudget", 32)
	sky:SetAttribute("CloudParticleSteadyStateCeiling", 644)
	sky:SetAttribute("CloudInitialParticleBudget", 356)
	sky:SetAttribute("LocalCloudElevationMin", origin.Position.Y - 100)
	sky:SetAttribute("LocalCloudElevationMax", origin.Position.Y - 78)
	return sky
end

return table.freeze(Horizon)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="165">
          <Properties>
            <string name="Name">SanctuaryKit</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryKit
-- The Shrine of the Ascendant's modular architecture kit: ServerStorage.AsuraLobbyKit
-- (assets/models/AsuraLobbyKit.rbxmx), modelled by tools/blender/lobby_kit.py and uploaded through
-- Studio's 3D Importer (IDs in assets/LOBBY_KIT_UPLOADED.json). Each piece is a Model of MeshParts
-- sitting at the origin; a piece is placed by its pivot - base centre on the floor for upright pieces,
-- eave line for roofs, top centre for hanging cliffs - and may be scaled per axis in its own frame.
-- Kit meshes never collide, touch or answer queries; builders lay simple primitive collision beside
-- them. Primitives that must match the meshes use the shared MaterialVariants (MaterialService.Asura*),
-- made from the same uploaded maps. A missing template returns nil so builders keep a fallback.
local ServerStorage = game:GetService("ServerStorage")
local Base = require(script.Parent:WaitForChild("MonasteryKit") :: ModuleScript)

local Kit = {}
Kit.part, Kit.disc, Kit.folder, Kit.decor, Kit.hidden, Kit.light, Kit.sequence =
	Base.part, Base.disc, Base.folder, Base.decor, Base.hidden, Base.light, Base.sequence

local rgb = Color3.fromRGB
local M = Enum.Material

export type Surface = { Material: Enum.Material, Variant: string, Color: Color3 }
-- Part.Color tints a MaterialVariant's colour map, so white shows the authored texture.
Kit.Surface = table.freeze({
	Paving = { Material = M.Slate, Variant = "AsuraPaving", Color = rgb(139, 153, 167) },
	PavingPath = { Material = M.Slate, Variant = "AsuraPaving", Color = rgb(167, 177, 187) },
	Stone = { Material = M.Slate, Variant = "AsuraStone", Color = rgb(148, 158, 170) },
	StoneDark = { Material = M.Slate, Variant = "AsuraStone", Color = rgb(100, 112, 126) },
	Basin = { Material = M.Slate, Variant = "AsuraStone", Color = rgb(52, 80, 76) },
	Rock = { Material = M.Rock, Variant = "AsuraRock", Color = rgb(226, 222, 216) },
	TerracePaving = { Material = M.Slate, Variant = "AsuraPaving", Color = rgb(221, 228, 235) },
	Lacquer = { Material = M.Wood, Variant = "AsuraLacquer", Color = rgb(255, 255, 255) },
	Timber = { Material = M.Wood, Variant = "AsuraTimber", Color = rgb(255, 255, 255) },
	Bronze = { Material = M.Metal, Variant = "AsuraBronze", Color = rgb(255, 255, 255) },
	RoofTile = { Material = M.Slate, Variant = "AsuraRoofTile", Color = rgb(255, 255, 255) },
} :: { [string]: Surface })

Kit.Palette = table.freeze({
	Lantern = rgb(255, 175, 95),
	Paper = rgb(225, 193, 145),
	Banner = rgb(104, 22, 24),
	BannerDark = rgb(42, 14, 16),
	Gold = rgb(214, 168, 92),
	Jade = rgb(120, 196, 176),
	Water = rgb(38, 86, 82),
	Iron = rgb(34, 32, 34),
})

local function template(name: string): Model?
	local library = ServerStorage:FindFirstChild("AsuraLobbyKit")
	local piece = library and library:FindFirstChild(name)
	if not piece then
		local vista = ServerStorage:FindFirstChild("AsuraSanctuaryVista")
		piece = vista and vista:FindFirstChild(name)
	end
	if not piece then
		local detail = ServerStorage:FindFirstChild("AsuraSanctuaryDetail")
		piece = detail and detail:FindFirstChild(name)
	end
	if not piece and name:sub(1, 17) == "AsuraGuardianLion" then piece = ServerStorage:FindFirstChild(name) end
	return if piece and piece:IsA("Model") then piece else nil
end

Kit.template = template

function Kit.available(): boolean
	return template("Rail_Bay") ~= nil
end

-- Clones a piece with its pivot at `cf`. `scale` is uniform or per axis (piece frame). Every kit part
-- has an identity orientation in its template, so a per-axis scale is exact.
function Kit.place(parent: Instance, name: string, cf: CFrame, scale: (number | Vector3)?, shadow: boolean?): Model?
	local source = template(name)
	if not source then
		return nil
	end
	local s = if typeof(scale) == "Vector3" then scale elseif typeof(scale) == "number" then Vector3.one * scale else Vector3.one
	local model = Instance.new("Model")
	model.Name = name
	for _, child in source:GetChildren() do
		if child:IsA("BasePart") then
			local copy = child:Clone()
			copy.Size = child.Size * s
			copy.CFrame = cf * CFrame.new(child.Position * s)
			copy.CastShadow = shadow ~= false
			local finish = copy:FindFirstChildOfClass("SurfaceAppearance")
			if finish then
				if name:find("^Vista_") then
					-- Vista templates carry the scanned-rock tint checked in Studio.
				elseif child.Name:find("__Stone") then finish.Color = rgb(126, 141, 158)
				elseif child.Name:find("__Lacquer") then finish.Color = rgb(119, 78, 72)
				elseif child.Name:find("__Bronze") then finish.Color = rgb(178, 143, 92)
				elseif child.Name:find("__Paving") then finish.Color = rgb(156, 166, 179)
				end
			end
			copy.Parent = model
		end
	end
	model.WorldPivot = cf
	model.Parent = parent
	return model
end

-- One shared, double-sided mesh replaces two Decals per leaf plane. The saved template
-- carries its alpha SurfaceAppearance; all clones can share geometry and texture bindings.
function Kit.branchCard(parent: Instance, frame: CFrame, width: number, height: number, tint: Color3): BasePart?
	local source = template("Detail_BranchCard")
	local mesh = source and source:FindFirstChildWhichIsA("MeshPart")
	if not mesh then return nil end
	local copy = mesh:Clone()
	copy.Name, copy.Size, copy.CFrame = "CrimsonBranchSpray", Vector3.new(width, height, 0.001), frame
	copy.Color, copy.CastShadow = tint, false
	local finish = copy:FindFirstChildOfClass("SurfaceAppearance")
	if finish then finish.Color = tint end
	copy:SetAttribute("AsuraFoliage", true)
	copy.Parent = parent
	return copy
end

-- A primitive in one of the shared surfaces (collides unless told otherwise).
function Kit.slab(parent: Instance, name: string, size: Vector3, cf: CFrame, surface: string, options: Base.PartOptions?): BasePart
	local s = Kit.Surface[surface]
	local p = Base.part(parent, name, size, cf, s.Color, s.Material, options)
	p.MaterialVariant = s.Variant
	return p
end

-- Invisible movement collision between two floor points: bodies stop, cameras and queries pass.
function Kit.blocker(parent: Instance, name: string, a: Vector3, b: Vector3, height: number, thickness: number): BasePart
	local mid = (a + b) * 0.5 + Vector3.yAxis * height * 0.5
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local cf = if flat.Magnitude &gt; 1e-3 then CFrame.lookAt(mid, mid + flat) else CFrame.new(mid)
	return Base.part(parent, name, Vector3.new(thickness, height, math.max(flat.Magnitude, 0.2)), cf, rgb(0, 0, 0), M.SmoothPlastic,
		{ Collide = true, Query = false, Transparency = 1, Shadow = false })
end

-- Frame whose X axis runs from `a` to `b` (Y up): kit pieces lie along their X.
function Kit.along(a: Vector3, b: Vector3, at: Vector3?): CFrame
	local x = Vector3.new(b.X - a.X, 0, b.Z - a.Z).Unit
	return CFrame.fromMatrix(at or (a + b) * 0.5, x, Vector3.yAxis)
end

-- Frosted paper lantern chamber. Its shell is a separate PBR kit mesh; these thin, shaded paper
-- panes sit inside its posts. Only the tiny rounded flame emits, so the chamber never reads as an
-- unshaded neon brick. A light remains warm and local even when distant bloom catches the flame.
function Kit.glow(parent: Instance, cf: CFrame, size: Vector3, range: number, brightness: number?, sides: number?): BasePart
	local chamber = Instance.new("Model")
	chamber.Name = if size.X &lt; 0.3 then "CandleFlame" else "FrostedLanternChamber"
	chamber.Parent = parent
	local anchor = Base.hidden(chamber, "WarmLightSource", Vector3.new(0.1, 0.1, 0.1), cf)
	local candle = size.X &lt; 0.3
	local flameSize = if candle then size else Vector3.new(size.X * 0.22, size.Y * 0.38, size.Z * 0.22)
	local flame = Base.part(chamber, "ShelteredFlame", flameSize, cf, rgb(237, 161, 77), M.Neon,
		{ Collide = false, Query = false, Shadow = false, Shape = Enum.PartType.Ball, Transparency = if candle then 0.18 else 0.48 })
	flame.CastShadow = false
	if not candle then
		local count = sides or 4
		local apothem = math.min(size.X, size.Z) * 0.5
		local panelWidth = 2 * apothem * math.tan(math.pi / count)
		for k = 0, count - 1 do
			local angle = math.pi * 2 * k / count
			local face = cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -apothem)
			local paper = Base.part(chamber, "FrostedPaperPane", Vector3.new(panelWidth, size.Y, 0.028), face,
				rgb(151, 101, 58), M.Neon, Base.decor())
			paper.Transparency = 0.35 -- low-energy emissive paper, individually framed inside the housing
			-- Fine timber muntin gives the lit paper a crafted scale against the carved stone housing.
			Kit.slab(chamber, "PaperMuntin", Vector3.new(0.035, size.Y + 0.035, 0.038), face * CFrame.new(0, 0, -0.024), "Timber", Base.decor())
		end
	end
	Base.light(anchor, Kit.Palette.Lantern, if candle then range else math.clamp(range, 12, 16),
		if candle then (brightness or 0.35) else math.clamp(brightness or 1.35, 1.2, 1.5), true)
	return anchor
end

-- Complete emergency housing when a library is unavailable (never a bare glowing post).
-- Normal play uses the Blender-authored curved eaves, mouldings and timber/bronze PBR meshes.
function Kit.lanternFallback(parent: Instance, cf: CFrame, hanging: boolean)
	local shell = Instance.new("Model")
	shell.Name = if hanging then "HangingLanternHousing" else "PagodaLanternHousing"
	shell.Parent = parent
	local mid = if hanging then -1.3 else 3.35
	local half = if hanging then 0.55 else 0.66
	local surface = if hanging then "Bronze" else "Stone"
	if not hanging then
		for _, course in { { 2.0, 0.4, 0.2 }, { 1.6, 0.3, 0.55 }, { 0.9, 1.7, 1.55 }, { 1.85, 0.3, 2.55 } } do
			Kit.slab(shell, "StoneLanternCourse", Vector3.new(course[1], course[2], course[1]), cf * CFrame.new(0, course[3], 0), surface, Base.decor())
		end
	end
	for _, x in { -half, half } do
		for _, z in { -half, half } do
			Kit.slab(shell, "WindowCorner", Vector3.new(0.16, 1.32, 0.16), cf * CFrame.new(x, mid, z), surface, Base.decor())
		end
	end
	for _, y in { mid - 0.72, mid + 0.72 } do
		Kit.slab(shell, "WindowSill", Vector3.new(half * 2 + 0.35, 0.16, half * 2 + 0.35), cf * CFrame.new(0, y, 0), surface, Base.decor())
	end
	local roof = mid + 0.94
	for k = 0, 3 do
		local face = cf * CFrame.Angles(0, math.pi / 2 * k, 0)
		Kit.slab(shell, "PagodaRoofSlope", Vector3.new(1.75, 0.16, 0.92), face * CFrame.new(0, roof, 0.48) * CFrame.Angles(math.rad(23), 0, 0), surface, Base.decor())
	end
	Kit.part(shell, "LotusFinial", Vector3.new(0.35, 0.45, 0.35), cf * CFrame.new(0, roof + 0.45, 0), Kit.Surface[surface].Color, M.Slate,
		{ Collide = false, Query = false, Shadow = false, Shape = Enum.PartType.Ball })
	if hanging then
		Kit.slab(shell, "Suspension", Vector3.new(0.07, 0.33, 0.07), cf * CFrame.new(0, -0.17, 0), "Bronze", Base.decor())
	end
end

return table.freeze(Kit)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="166">
          <Properties>
            <string name="Name">SanctuaryLeaves</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryLeaves
-- Crimson leaves for the Sanctuary: a fluttering ParticleEmitter shed from the Veiled Ascetic's
-- canopy (and the plaza sky), plus fallen-leaf scatter on the dais, basins and stairs.
-- Textures are uploaded Decals (assets/build/veiled_titan/leaves/, ids in assets/ASSET_IDS.md);
-- The emitter waits for the leaf upload; scatter retains small authored slivers as a fallback.
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Leaves = {}

Leaves.LEAF_TEXTURE = Assets.Textures.Leaf -- rbxassetid://&lt;crimson_leaf.png&gt;  (single leaf, alpha)
Leaves.SCATTER_TEXTURE = Assets.Textures.LeafScatter -- rbxassetid://&lt;leaf_scatter.png&gt; (cluster of fallen leaves, alpha)

local FALLBACK_TEXTURE = ""
local CRIMSON = { Color3.fromRGB(150, 16, 24), Color3.fromRGB(122, 10, 18), Color3.fromRGB(176, 30, 34), Color3.fromRGB(96, 12, 16) }

export type EmitterProfile = {
	Rate: number?,
	Size: number?,
	Wind: Vector3?,
}

local function keys(points: { { number } }): NumberSequence
	local list = {}
	for _, p in points do
		table.insert(list, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(list)
end

-- Leaves tumble (fast spin), drift on a gentle draft, flutter side to side via high drag + a
-- sideways spread, and fade in/out so there is never a pop at the canopy or the ground.
function Leaves.Emitter(source: BasePart, profile: EmitterProfile?): ParticleEmitter
	local p: EmitterProfile = profile or {}
	local size = p.Size or 0.55
	local textured = Leaves.LEAF_TEXTURE ~= ""
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "CrimsonLeaves"
	emitter.Texture = if textured then Leaves.LEAF_TEXTURE else FALLBACK_TEXTURE
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, if textured then Color3.fromRGB(255, 236, 236) else CRIMSON[3]),
		ColorSequenceKeypoint.new(1, if textured then Color3.fromRGB(190, 150, 150) else CRIMSON[2]),
	})
	emitter.LightEmission = 0
	emitter.LightInfluence = 1
	emitter.Orientation = Enum.ParticleOrientation.FacingCamera
	emitter.Size = keys({ { 0, size * 0.85 }, { 0.5, size }, { 1, size * 0.8 } })
	emitter.Squash = keys({ { 0, 0 }, { 0.25, 0.45 }, { 0.5, -0.35 }, { 0.75, 0.4 }, { 1, 0 } }) -- edge-on flips
	emitter.Transparency = keys({ { 0, 1 }, { 0.08, 0 }, { 0.85, 0.05 }, { 1, 1 } })
	emitter.Lifetime = NumberRange.new(9, 14)
	emitter.Rate = p.Rate or 14
	emitter.Speed = NumberRange.new(0.4, 1.4)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = p.Wind or Vector3.new(1.1, -0.9, 0.45)
	emitter.Drag = 0.9
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-160, 160)
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.Enabled = textured
	emitter.Parent = source
	return emitter
end

-- Fallen leaves on a surface. With SCATTER_TEXTURE: a few large decal tiles; otherwise
-- individual flat crimson slivers. `surface` is a CFrame on the top face (Y up); `extent` is the
-- ellipse half-size (X, Z) so treads and basins can take narrow strips.
function Leaves.Scatter(parent: Instance, surface: CFrame, extent: Vector2, count: number, seed: number, floating: boolean?)
	local rng = Random.new(seed)
	local group = Instance.new("Folder")
	group.Name = "FallenLeaves"
	group.Parent = parent
	local useDecal = Leaves.SCATTER_TEXTURE ~= ""
	local n = if useDecal then math.max(1, math.floor(count / 25)) else count
	for _ = 1, n do
		local r = math.sqrt(rng:NextNumber())
		local a = rng:NextNumber(0, math.pi * 2)
		local spot = surface * CFrame.new(math.cos(a) * r * extent.X, 0, math.sin(a) * r * extent.Y) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		local leaf = Instance.new("Part")
		leaf.Name = "Leaf"
		leaf.Anchored, leaf.CanCollide, leaf.CanQuery, leaf.CanTouch = true, false, false, false
		leaf.CastShadow = false
		leaf.Material = Enum.Material.SmoothPlastic
		if useDecal then
			local s = math.min(rng:NextNumber(4, 7), extent.X * 2, extent.Y * 2)
			leaf.Size = Vector3.new(s, 0.05, s)
			leaf.Transparency = 1
			leaf.CFrame = spot * CFrame.new(0, 0.03, 0)
			local decal = Instance.new("Decal")
			decal.Texture = Leaves.SCATTER_TEXTURE
			decal.Face = Enum.NormalId.Top
			decal.Parent = leaf
		else
			leaf.Size = Vector3.new(rng:NextNumber(0.35, 0.6), 0.05, rng:NextNumber(0.22, 0.34))
			leaf.Color = CRIMSON[rng:NextInteger(1, #CRIMSON)]
			local tilt = if floating then 0 else rng:NextNumber(-0.25, 0.25)
			leaf.CFrame = spot * CFrame.new(0, 0.03, 0) * CFrame.Angles(tilt, 0, tilt * 0.5)
		end
		leaf.Parent = group
	end
	return group
end

return Leaves
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="167">
          <Properties>
            <string name="Name">SanctuaryProps</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryProps
-- Repeated Shrine dressing built from the lobby kit: stone lanterns with frosted paper chambers, cloth
-- banners on poles with a gold seal, and memorial stelae carrying an engraved inscription. Each solid
-- prop gets one invisible collision box; cloth, glow and text never collide.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)

local Props = {}

local function invisible(): any
	return { Collide = true, Query = false, Transparency = 1, Shadow = false }
end

local function branchCard(group: Instance, cf: CFrame, width: number, height: number, tint: Color3)
	if Kit.branchCard(group, cf, width, height, tint) then return end
	local card = Kit.hidden(group, "CrimsonBranchSpray", Vector3.new(width, height, 0.04), cf)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local image = Instance.new("Decal")
		image.Name, image.Texture, image.Face, image.Color3 = "CrimsonSpray", Assets.Textures.CrimsonBranch, face, tint
		image.Parent = card
	end
end

local function removeBlob(model: Model)
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child.Name:find("__Foliage", 1, true) then
			child:Destroy()
		end
	end
end

-- Stone lantern standing on `cf` (floor). A shaded paper chamber sits behind its carved posts.
function Props.lantern(group: Instance, cf: CFrame, range: number?)
	local shell = Kit.place(group, "Lantern_Stone", cf)
	if not shell then Kit.lanternFallback(group, cf, false) end
	Kit.glow(group, cf * CFrame.new(0, 3.35, 0), Vector3.new(1.04, 1.12, 1.04), range or 15, 1.35)
	Kit.part(group, "LanternCollision", Vector3.new(1.9, 4.4, 1.9), cf * CFrame.new(0, 2.2, 0), Color3.new(), Enum.Material.SmoothPlastic, invisible())
end

-- Banner hanging from a pole on `cf` (floor); the cloth faces the pole's front (-Z).
function Props.banner(group: Instance, cf: CFrame, height: number?)
	local h = height or 14
	Kit.slab(group, "BannerFoot", Vector3.new(1, 0.42, 1), cf * CFrame.new(0, 0.21, 0), "StoneDark", Kit.decor())
	Kit.slab(group, "BannerPole", Vector3.new(0.45, h, 0.45), cf * CFrame.new(0, h / 2, 0), "Timber", Kit.decor())
	Kit.slab(group, "BannerBar", Vector3.new(3.6, 0.28, 0.28), cf * CFrame.new(0, h - 0.6, -0.35), "Bronze", Kit.decor())
	-- The kit cloth (Banner_Cloth) carries its own folds, gold border and lotus seal.
	if Kit.place(group, "Banner_Cloth", cf * CFrame.new(0, h - 0.75, -0.42), nil, false) then
		return
	end
	local cloth = Kit.part(group, "Banner", Vector3.new(3.1, 8.2, 0.1), cf * CFrame.new(0, h - 4.8, -0.4), Kit.Palette.Banner, Enum.Material.Fabric, Kit.decor())
	Kit.part(group, "BannerHem", Vector3.new(3.12, 0.6, 0.12), cf * CFrame.new(0, h - 8.6, -0.4), Kit.Palette.BannerDark, Enum.Material.Fabric, Kit.decor())
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face, gui.SizingMode, gui.PixelsPerStud, gui.LightInfluence = face, Enum.SurfaceGuiSizingMode.PixelsPerStud, 32, 1
		local label = Instance.new("TextLabel")
		label.Size, label.Position, label.BackgroundTransparency = UDim2.fromScale(0.8, 0.5), UDim2.fromScale(0.1, 0.12), 1
		label.Text, label.TextScaled, label.Font, label.TextColor3 = "修\n羅", true, Enum.Font.Antique, Kit.Palette.Gold
		label.Parent = gui
		gui.Parent = cloth
	end
end

-- Memorial stele on `cf` (floor), inscription on its front (-Z) panel.
function Props.stele(group: Instance, cf: CFrame, text: string, broken: boolean?)
	local piece = if broken then "Stele_Broken" else "Stele_Dragon"
	if not Kit.place(group, piece, cf) then
		Kit.slab(group, "MemorialStele", Vector3.new(2.6, if broken then 3.6 else 6.8, 0.9), cf * CFrame.new(0, if broken then 1.8 else 3.4, 0), "Stone")
	end
	local height = if broken then 4.4 else 8
	Kit.part(group, "SteleCollision", Vector3.new(4.4, height, 2), cf * CFrame.new(0, height / 2, 0), Color3.new(), Enum.Material.SmoothPlastic, invisible())
	if text == "" then
		return
	end
	local plate = Kit.part(group, "SteleInscription", Vector3.new(1.8, 3.6, 0.05), cf * CFrame.new(0, 3.75, -0.52), Color3.new(), Enum.Material.Slate, Kit.decor())
	plate.Transparency = 1
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.SizingMode, gui.PixelsPerStud, gui.LightInfluence = Enum.NormalId.Front, Enum.SurfaceGuiSizingMode.PixelsPerStud, 40, 1
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.Text, label.TextScaled = UDim2.fromScale(1, 1), 1, text, true
	label.Font, label.TextColor3, label.TextTransparency = Enum.Font.Antique, Color3.fromRGB(58, 60, 60), 0.1
	label.Parent = gui
	gui.Parent = plate
end

-- Crimson maple (or the smaller one) on `cf`; only its trunk collides.
function Props.tree(group: Instance, cf: CFrame, scale: number?, small: boolean?)
	-- These are secondary garden trees; the unchanged imported sacred tree owns the skyline.
	local s = (scale or 1) * 0.78
	local tree = Kit.place(group, if small then "Tree_MapleSmall" else "Tree_Maple", cf, s)
	if tree then
		removeBlob(tree)
		local rng = Random.new(math.floor(cf.X * 23 + cf.Z * 19) % 100000)
		local height = if small then 12 else 15
		for layer = 1, 3 do
			for k = 0, 3 do
				local angle = math.rad(k * 90 + layer * 31) + rng:NextNumber(-0.2, 0.2)
				local radius = (if layer == 2 then 4.6 elseif layer == 3 then 2.7 else 3.6) * s
				local pos = Vector3.new(math.cos(angle) * radius, (height * (0.43 + layer * 0.14) + rng:NextNumber(-0.5, 0.5)) * s, math.sin(angle) * radius)
				local frame = cf * CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.22, 0.22), -angle + math.pi / 2, rng:NextNumber(-0.3, 0.3))
				branchCard(tree, frame, (if layer == 2 then 8 else 6) * s, (if layer == 2 then 4 else 3.5) * s,
					if k % 2 == 0 then Color3.fromRGB(195, 177, 169) else Color3.fromRGB(179, 162, 165))
			end
		end
		Kit.part(group, "TrunkCollision", Vector3.new(2.6, 9, 2.6) * s, cf * CFrame.new(0, 4.5 * s, 0), Color3.new(), Enum.Material.SmoothPlastic, invisible())
	end
end

function Props.shrub(group: Instance, cf: CFrame, scale: number?)
	local s = (scale or 1) * 0.68
	local shrub = Kit.place(group, "Shrub_Crimson", cf * CFrame.new(0, -0.15, 0), s)
	if not shrub then return end
	removeBlob(shrub)
	for k = 0, 4 do
		local angle = math.rad(k * 137 + 17)
		local radius = (if k % 2 == 0 then 1.1 else 0.6) * s
		local frame = cf * CFrame.new(math.cos(angle) * radius, (1.15 + (k % 3) * 0.25) * s, math.sin(angle) * radius)
			* CFrame.Angles(math.rad(-12 + k * 5), angle, math.rad(-18 + k * 8))
		branchCard(shrub, frame, 4.5 * s, 2.8 * s, Color3.fromRGB(190, 172, 163))
	end
end

-- Low resting bench, facing -Z, reserved for the outer edges of galleries and the shrine walk.
function Props.bench(group: Instance, cf: CFrame)
	Kit.slab(group, "BenchSeat", Vector3.new(6.8, 0.28, 1.9), cf * CFrame.new(0, 1.92, 0), "Timber", Kit.decor())
	for _, x in { -2.5, 2.5 } do
		Kit.slab(group, "BenchTrestle", Vector3.new(0.6, 1.8, 1.55), cf * CFrame.new(x, 0.9, 0), "Timber", Kit.decor())
		Kit.slab(group, "BenchFoot", Vector3.new(0.95, 0.2, 1.85), cf * CFrame.new(x, 0.1, 0), "Timber", Kit.decor())
	end
	Kit.slab(group, "BenchStretcher", Vector3.new(5.1, 0.32, 0.36), cf * CFrame.new(0, 0.65, 0), "Timber", Kit.decor())
	Kit.part(group, "BenchCollision", Vector3.new(6.8, 2.1, 1.9), cf * CFrame.new(0, 1.05, 0), Color3.new(), Enum.Material.SmoothPlastic, invisible())
end

-- Iron brazier on a bronze-banded stand (court corners, gate approaches): real fire and warm light.
function Props.brazier(group: Instance, cf: CFrame, range: number?)
	local iron = Kit.Palette.Iron
	Kit.part(group, "BrazierStand", Vector3.new(0.55, 3.8, 0.55), cf * CFrame.new(0, 1.9, 0), iron, Enum.Material.Metal)
	Kit.disc(group, "BrazierFoot", 1.0, 0.3, cf * CFrame.new(0, 0.15, 0), iron, Enum.Material.Metal)
	Kit.disc(group, "BrazierBowl", 1.35, 0.7, cf * CFrame.new(0, 4.1, 0), iron, Enum.Material.Metal).MaterialVariant = "AsuraBronze"
	local coals = Kit.disc(group, "BrazierCoals", 1.1, 0.2, cf * CFrame.new(0, 4.5, 0), Color3.fromRGB(49, 38, 32), Enum.Material.Slate, Kit.decor())
	for k = 0, 6 do
		local a = math.rad(k * 137)
		Kit.part(group, "BankedCoal", Vector3.new(0.48, 0.24, 0.36), cf * CFrame.new(math.cos(a) * 0.65, 4.62, math.sin(a) * 0.65),
			Color3.fromRGB(62, 42, 31), Enum.Material.Slate, { Collide = false, Query = false, Shadow = false, Shape = Enum.PartType.Ball })
	end
	local fire = Instance.new("Fire")
	fire.Size, fire.Heat, fire.Color, fire.SecondaryColor = 2.2, 4, Color3.fromRGB(255, 150, 60), Color3.fromRGB(220, 60, 20)
	fire.Parent = coals
	Kit.light(coals, Color3.fromRGB(255, 170, 100), range or 18, 1.1, false)
end

return table.freeze(Props)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="168">
          <Properties>
            <string name="Name">SanctuaryRails</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryRails
-- Carved stone balustrades for the Shrine of the Ascendant: kit posts (Rail_Post) at both ends and
-- every ~6 studs, carved bays (Rail_Bay, or Rail_BayStair along the 1:2 Ascension stair) between them,
-- and one invisible wall per run for movement. Without the kit a plain plinth-and-cap rail stands in.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)

local Rails = {}

local SPACING = 6 -- post centres; a 5.1 bay fills the gap between 0.86-stud posts
local BAY = 5.1
local HEIGHT = 3.2 -- collision, a little above the 2.6 handrail
local STAIR = 0.5 -- the stair's rise per run (WorldDefinitions: rise 1, run 2)

local function fallback(parent: Instance, a: Vector3, b: Vector3)
	local cf = Kit.along(a, b)
	local length = (Vector3.new(b.X, 0, b.Z) - Vector3.new(a.X, 0, a.Z)).Magnitude
	Kit.slab(parent, "RailPlinth", Vector3.new(length, 2.2, 0.9), cf * CFrame.new(0, 1.1, 0), "Stone", Kit.decor())
	Kit.slab(parent, "RailCap", Vector3.new(length + 0.4, 0.3, 1.2), cf * CFrame.new(0, 2.35, 0), "Stone", Kit.decor())
end

-- Level run along floor points a -&gt; b. `posts` false skips the end posts (when a column stands there);
-- `collide` false lays the carving only, over a wall that already stops bodies.
function Rails.run(parent: Instance, a: Vector3, b: Vector3, posts: boolean?, collide: boolean?)
	local length = (b - a).Magnitude
	if length &lt; 1 then
		return
	end
	if collide ~= false then
		Kit.blocker(parent, "RailCollision", a, b, HEIGHT, 0.9)
	end
	if not Kit.available() then
		fallback(parent, a, b)
		return
	end
	local n = math.max(1, math.round(length / SPACING))
	local step = length / n
	local dir = (b - a).Unit
	local frame = Kit.along(a, b, a)
	for i = 0, n do
		if posts ~= false or (i &gt; 0 and i &lt; n) then
			Kit.place(parent, "Rail_Post", frame * CFrame.new(step * i, 0, 0))
		end
	end
	local fill = math.max(step - 0.86, 0.5) / BAY
	for i = 1, n do
		Kit.place(parent, "Rail_Bay", CFrame.fromMatrix(a + dir * step * (i - 0.5), dir, Vector3.yAxis), Vector3.new(fill, 1, 1))
	end
end

-- Balustrade up a 1:2 flight: `foot` and `head` are floor points on the nosing line (head higher).
-- Bays are never stretched, so their sheared rails keep the stair's exact pitch.
function Rails.stair(parent: Instance, foot: Vector3, head: Vector3)
	local flat = Vector3.new(head.X - foot.X, 0, head.Z - foot.Z)
	local run = flat.Magnitude
	-- One wall from the foot's floor to above the head's handrail keeps bodies on the flight.
	Kit.blocker(parent, "StairRailCollision", foot, Vector3.new(head.X, foot.Y, head.Z), HEIGHT + (head.Y - foot.Y), 0.9)
	local dir = flat.Unit
	local n = math.max(1, math.floor(run / SPACING))
	local spare = run - n * SPACING
	local start = foot + dir * spare + Vector3.yAxis * spare * STAIR
	local function at(d: number): Vector3
		return start + dir * d + Vector3.yAxis * d * STAIR
	end
	if not Kit.available() then
		local mid = (at(0) + at(n * SPACING)) * 0.5
		local cf = CFrame.lookAt(mid, mid + (at(n * SPACING) - at(0)))
		Kit.slab(parent, "StairRail", Vector3.new(0.9, 2.4, (at(n * SPACING) - at(0)).Magnitude), cf * CFrame.new(0, 1.2, 0), "Stone", Kit.decor())
		return
	end
	for i = 0, n do
		Kit.place(parent, "Rail_Post", CFrame.new(at(i * SPACING) - Vector3.yAxis * 0.35))
	end
	for i = 1, n do
		-- The sheared bay rises toward its own -X, so its X axis points back down the flight.
		Kit.place(parent, "Rail_BayStair", CFrame.fromMatrix(at((i - 0.5) * SPACING) - Vector3.yAxis * 0.1, -dir, Vector3.yAxis))
	end
end

return table.freeze(Rails)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="169">
          <Properties>
            <string name="Name">SanctuaryRingFinish</string>
            <string name="Source">--!strict
-- Sanctuary-only visual finish. Original ring geometry, collision, barriers, threshold identifiers
-- and every matchmaking/duel rule remain owned by ColosseumService.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)

local Finish = {}
local BRONZE = Color3.fromRGB(138, 117, 82)
local Y = Vector3.yAxis

local function surface(part: BasePart, key: string)
	local s = Kit.Surface[key]
	part.Material, part.MaterialVariant, part.Color = s.Material, s.Variant, s.Color
end

local function sealLine(group: Instance, a: Vector3, b: Vector3, width: number)
	local line = Kit.slab(group, "BronzeSeal", Vector3.new(width, 0.025, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), "Bronze", Kit.decor())
	line.Color = BRONZE
end

local function seal(group: Instance, frame: CFrame)
	for _, radius in { 6.8, 5.9, 2.5 } do
		for k = 0, 7 do
			local a, b = math.rad(k * 45 + 22.5), math.rad((k + 1) * 45 + 22.5)
			sealLine(group, (frame * CFrame.new(math.cos(a) * radius, 0.485, math.sin(a) * radius)).Position,
				(frame * CFrame.new(math.cos(b) * radius, 0.485, math.sin(b) * radius)).Position, if radius == 6.8 then 0.1 else 0.055)
		end
	end
	for k = 0, 3 do
		local a = math.rad(k * 90 + 45)
		local radial = Vector3.new(math.cos(a), 0, math.sin(a))
		local across = radial:Cross(Y)
		local c = radial * 4.2
		local points = { c + radial * 1, c + across * 0.65, c - radial * 1, c - across * 0.65 }
		for i = 1, 4 do
			sealLine(group, (frame * CFrame.new(points[i] + Y * 0.485)).Position,
				(frame * CFrame.new(points[i % 4 + 1] + Y * 0.485)).Position, 0.07)
		end
	end
end

local function lanternPost(group: Instance, cf: CFrame)
	Kit.place(group, "Column_Base", cf, 0.8)
	Kit.place(group, "Column_Lacquer", cf * CFrame.new(0, 0.72, 0), Vector3.new(0.5, 0.55, 0.5))
	Kit.slab(group, "LanternArm", Vector3.new(2, 0.23, 0.32), cf * CFrame.new(0.7, 6.45, 0), "Timber", Kit.decor())
	Kit.slab(group, "LanternPostCap", Vector3.new(0.85, 0.17, 0.85), cf * CFrame.new(0, 6.5, 0), "Bronze", Kit.decor()).Color = BRONZE
	Kit.place(group, "Lantern_Hanging", cf * CFrame.new(1.1, 6.5, 0))
	Kit.glow(group, cf * CFrame.new(1.1, 5.2, 0), Vector3.new(0.92, 0.95, 0.92), 15, 0.65)
end

function Finish.Dress(model: Model)
	local floor = model:FindFirstChild("Floor0")
	if not floor or not floor:IsA("BasePart") then return end
	local frame, apothem = floor.CFrame, floor.Size.X / 2
	local previous = model:FindFirstChild("SanctuaryRingFinish")
	if previous then previous:Destroy() end
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			local name = child.Name
			if name:match("^Floor%d+$") then
				surface(child, "PavingPath")
			elseif name:match("^Threshold%d+$") then
				surface(child, "Stone")
			elseif name:match("^Ember%d+$") then
				surface(child, "Bronze")
				child.Color, child.Transparency = BRONZE, 0
			elseif name:match("^Wall%d+$") or name:match("^Pillar%d+$") or name == "Sigil" or name == "SigilCore" then
				child.Transparency = 1
			elseif name:match("^Brazier%d+$") then
				child.Transparency = 1
				for _, light in child:GetChildren() do
					if light:IsA("PointLight") then light.Enabled = false end
				end
			end
		end
	end
	local group = Kit.folder("SanctuaryRingFinish", model)
	Kit.place(group, "Paving_Medallion", frame * CFrame.new(0, 0.42, 0), 1.25)
	seal(group, frame)
	local length = apothem * 2 * math.tan(math.rad(22.5))
	for k = 0, 7 do
		local edge = frame * CFrame.Angles(0, math.rad(k * 45), 0) * CFrame.new(0, 0.4, -apothem - 0.5)
		for bay = -1, 1, 2 do
			Kit.place(group, "Pool_Rim", edge * CFrame.new(bay * length / 4, 0, 0), Vector3.new((length / 2 - 0.025) / 8, 1, 1))
		end
		if k % 2 == 0 then
			local vertex = frame * CFrame.Angles(0, math.rad(k * 45 + 22.5), 0) * CFrame.new(0, 0.4, -(apothem / math.cos(math.rad(22.5)) + 0.6))
			lanternPost(group, vertex)
		end
	end
	local sign = model:FindFirstChild("Sign")
	if sign then
		local gui = sign:FindFirstChildOfClass("BillboardGui")
		if gui then
			gui.MaxDistance, gui.Size, gui.LightInfluence = 40, UDim2.fromScale(13, 2.7), 0.35
			for _, label in gui:GetChildren() do
				if label:IsA("TextLabel") and label.Text:find("threshold", 1, true) then
					label.Text, label.TextColor3 = "Step upon the stone threshold to duel", Color3.fromRGB(190, 170, 133)
				end
			end
		end
	end
end

return table.freeze(Finish)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">SanctuaryService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryService
-- The Shrine of the Ascendant: a wuxia sanctuary above the clouds, rebuilt on the lobby kit
-- (assets/models/AsuraLobbyKit.rbxmx, tools/blender/lobby_kit.py; concept 2026-10-21). Builds every
-- piece under Workspace.Sanctuary from the WorldDefinitions layout through small builders:
--   * SanctuaryCourtyard: paved courtyard, reflecting basins, bonfire dais and its altar anchor.
--   * SanctuaryCloisters: halls flanking the stairs, side galleries, covered walks to forge and court.
--   * SanctuaryAscent: the Ascension stairs, landing and gate hall whose portal carries the player
--     to the Monastery Gate (the touch trigger it returns).
--   * SanctuaryForge: the Blacksmith Loggia hall around Master Smith Gao (gameplay stays here).
--   * SanctuaryDuelCourt: the Colosseum Promenade; ColosseumService raises the ring on its anchor.
--   * SanctuaryColossus/Terrace: the Veiled Ascetic's terrace; SanctuaryApproach: optional routes.
--   * SanctuaryHorizon: rock foundations, the sea of clouds and the karst horizon.
-- Start() must run before WorldService.Start(): the region's MapFolder (this folder) suppresses
-- the greybox, and the bonfire's AltarAnchor part receives the altar's rest prompt.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local World = require(Shared.Shared.WorldDefinitions)
local InputMap = require(Shared.Shared.InputMap)
local Animations = require(Shared.Shared.AnimationCatalog)
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local Recovery = require(script.Parent:WaitForChild("RecoveryRules") :: ModuleScript)
local WorldService = require(script.Parent:WaitForChild("WorldService") :: ModuleScript)
local Colossus = require(script.Parent:WaitForChild("SanctuaryColossus") :: ModuleScript)
local Approach = require(script.Parent:WaitForChild("SanctuaryApproach") :: ModuleScript)
local Bonfire = require(script.Parent:WaitForChild("SanctuaryBonfire") :: ModuleScript)
local Figures = require(script.Parent:WaitForChild("CastFigures") :: ModuleScript)
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Courtyard = require(script.Parent:WaitForChild("SanctuaryCourtyard") :: ModuleScript)
local Cloisters = require(script.Parent:WaitForChild("SanctuaryCloisters") :: ModuleScript)
local Ascent = require(script.Parent:WaitForChild("SanctuaryAscent") :: ModuleScript)
local Forge = require(script.Parent:WaitForChild("SanctuaryForge") :: ModuleScript)
local DuelCourt = require(script.Parent:WaitForChild("SanctuaryDuelCourt") :: ModuleScript)
local Horizon = require(script.Parent:WaitForChild("SanctuaryHorizon") :: ModuleScript)
local Ecology = require(script.Parent:WaitForChild("SanctuaryEcology") :: ModuleScript)

local SanctuaryService = {}

-------------------------------------------------------------------------------------------------
-- Layout
-------------------------------------------------------------------------------------------------

local LAYOUT = World.Sanctuary
local ORIGIN = Vector3.new(LAYOUT.Origin.X, LAYOUT.Origin.Y, LAYOUT.Origin.Z)
local R = LAYOUT.PlazaRadius
local LOGGIA = Vector3.new(LAYOUT.Loggia.X, LAYOUT.Loggia.Y, LAYOUT.Loggia.Z)
local PROMENADE = Vector3.new(LAYOUT.Promenade.X, LAYOUT.Promenade.Y, LAYOUT.Promenade.Z)
local BALCONY_APOTHEM = 32
local STAIR_START = R - 1
local LANDING_DEPTH = 22
local ARCH_OFFSET = 15 -- arch depth into the landing

local BONFIRE_ALTAR = World.startingAltar()
local DESTINATION = World.Altars[LAYOUT.PortalDestination]

local PORTAL_FADE = 0.5
local PORTAL_COOLDOWN = 4
local CATCH_DEPTH = 40
local CATCH_RADIUS = 1300
local CATCH_LIMITS = { Radius = CATCH_RADIUS, FloorY = ORIGIN.Y - CATCH_DEPTH }
local POLL_INTERVAL = 0.5
local SMITH_RADIUS = 10
local REFILL_RADIUS = 6

local Assets = require(Shared.Shared.PresentationAssets)
local TEXTURE_SPARKS = Assets.Textures.Ember
local STONE = Color3.fromRGB(95, 101, 96)
local DESCENT = Vector3.new(0, 0, 88) -- the Well of Descent pavilion (SanctuaryRoutes), plaza-local

-------------------------------------------------------------------------------------------------
-- State
-------------------------------------------------------------------------------------------------

local root: Folder? = nil
local spawnCFrame = CFrame.new()
local smithPosition = Vector3.zero
local connections: { RBXScriptConnection } = {}
local disconnectors: { () -&gt; () } = {}
local transit: { [number]: number } = {}
local fallState: { [number]: Recovery.FallState } = {}
local running = false
local accumulator = 0

-------------------------------------------------------------------------------------------------
-- Construction helpers
-------------------------------------------------------------------------------------------------

type PartOptions = {
	Collide: boolean?,
	Query: boolean?,
	Transparency: number?,
	Reflectance: number?,
	Shadow: boolean?,
	Shape: Enum.PartType?,
	Class: string?,
}

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, options: PartOptions?): BasePart
	local o: PartOptions = options or {}
	local p = Instance.new((o.Class or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.CanCollide = if o.Collide == nil then true else o.Collide
	p.CanQuery = if o.Query == nil then p.CanCollide else o.Query
	p.Transparency = o.Transparency or 0
	p.Reflectance = o.Reflectance or 0
	p.CastShadow = if o.Shadow == nil then true else o.Shadow
	if o.Shape and p:IsA("Part") then
		p.Shape = o.Shape
	end
	p.Parent = parent
	return p
end

local function sequence(points: { { number } }): NumberSequence
	local keys = {}
	for _, point in points do
		table.insert(keys, NumberSequenceKeypoint.new(point[1], point[2]))
	end
	return NumberSequence.new(keys)
end

local function colors(a: Color3, b: Color3): ColorSequence
	return ColorSequence.new(a, b)
end

local function embers(parent: BasePart, rate: number, spread: number, lift: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = "Embers"
	e.Texture = TEXTURE_SPARKS;e.Enabled=e.Texture~=""
	e.Rate = rate
	e.Lifetime = NumberRange.new(2.5, 4.5)
	e.Speed = NumberRange.new(3, 7)
	e.SpreadAngle = Vector2.new(spread, spread)
	e.Acceleration = Vector3.new(0.6, lift, 0.4)
	e.Drag = 0.6
	e.Size = sequence({ { 0, 0.22 }, { 1, 0.05 } })
	e.Transparency = sequence({ { 0, 0 }, { 0.8, 0.3 }, { 1, 1 } })
	e.Color = colors(Color3.fromRGB(255, 200, 110), Color3.fromRGB(255, 80, 30))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Parent = parent
	return e
end

-------------------------------------------------------------------------------------------------
-- Blacksmith Loggia: the hall is SanctuaryForge's; the smith, his prompts and the trough are here.
-------------------------------------------------------------------------------------------------

local function buildSmithFigure(parent: Instance, base: CFrame)
	-- Stone-coloured stand-in used only if the avatar rig cannot be created.
	local model = Instance.new("Model")
	model.Name = "MasterSmithGao"
	model:SetAttribute("AsuraNPC", "Gao") -- DialogueController frames his portrait by this tag
	CollectionService:AddTag(model, "AsuraNPC")
	part(model, "Legs", Vector3.new(2, 2.4, 1), base * CFrame.new(0, 1.2, 0), Color3.fromRGB(40, 34, 30), Enum.Material.Fabric)
	part(model, "Torso", Vector3.new(2.2, 2.4, 1.2), base * CFrame.new(0, 3.6, 0), Color3.fromRGB(70, 48, 36), Enum.Material.Leather)
	part(model, "Head", Vector3.new(1.3, 1.3, 1.3), base * CFrame.new(0, 5.5, 0), Color3.fromRGB(176, 128, 96), Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball })
	model.Parent = parent
end

local function spawnSmith(parent: Instance, base: CFrame)
	task.spawn(function()
		local description = Instance.new("HumanoidDescription")
		local skin = Color3.fromRGB(176, 128, 96)
		description.HeadColor = skin
		description.LeftArmColor = skin
		description.RightArmColor = skin
		description.TorsoColor = Color3.fromRGB(70, 48, 36)
		description.LeftLegColor = Color3.fromRGB(40, 34, 30)
		description.RightLegColor = Color3.fromRGB(40, 34, 30)
		local ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
		end)
		if not running or not parent.Parent then
			if ok and model then
				model:Destroy()
			end
			return
		end
		if not ok or not model then
			warn("[Sanctuary] Blacksmith rig unavailable, using the stone figure: " .. tostring(model))
			buildSmithFigure(parent, base)
			return
		end
		model.Name = "MasterSmithGao"
		model:SetAttribute("AsuraNPC", "Gao") -- DialogueController frames his portrait by this tag
		CollectionService:AddTag(model, "AsuraNPC")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if humanoid then
			humanoid.DisplayName = "Master Smith Gao"
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			humanoid.NameDisplayDistance = 40
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
		if rootPart and rootPart:IsA("BasePart") then
			rootPart.Anchored = true
		end
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		model:PivotTo(base * CFrame.new(0, 3, 0))
		model.Parent = parent
		-- Blindfold, topknot, apron and bracers bind to the live rig itself (LooksCast.Gao).
		local missing = Figures.dress(model, "Gao")
		if #missing &gt; 0 then warn("[Sanctuary] Gao attire unbound: " .. table.concat(missing, ", ")) end
		-- Idle from the catalog keeps the smith out of a bind pose until a custom idle is set.
		if humanoid then
			local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
			animator.Parent = humanoid
			local idle = Animations.weapon("Unarmed", "Idle")
			local animation = Instance.new("Animation")
			animation.AnimationId = Animations.resolve(idle, "R15")
			local loaded, track = pcall(function()
				return (animator :: Animator):LoadAnimation(animation)
			end)
			if loaded and track then
				track.Looped = true
				track.Priority = Enum.AnimationPriority.Idle
				track:Play(0.2, 1, Animations.speed(idle))
			end
		end
	end)
end

local function buildLoggia(parent: Folder): (ProximityPrompt, ProximityPrompt)
	local base = CFrame.new(LOGGIA)
	local loggia = Forge.Build(parent, base, function(mouth: BasePart)
		embers(mouth, 16, 25, 6).EmissionDirection = Enum.NormalId.Right
	end)

	-- The smith stands beside the anvil facing the plaza; prompts live on a fixed anchor so they
	-- work immediately, even while (or if) the avatar rig is still loading.
	local stand = base * CFrame.new(-2, 0, -1)
	local facing = CFrame.lookAt(stand.Position, stand.Position + Vector3.xAxis)
	smithPosition = stand.Position
	spawnSmith(loggia, facing)
	local promptAnchor = part(loggia, "SmithPrompts", Vector3.new(2, 5, 2), facing * CFrame.new(0, 2.5, 0), STONE, Enum.Material.SmoothPlastic,
		{ Collide = false, Query = false, Transparency = 1, Shadow = false })
	local reinforce = Instance.new("ProximityPrompt")
	reinforce.Name = "ReinforcePrompt"
	reinforce.ActionText = "Speak to Master Smith Gao"
	reinforce.ObjectText = "Master Smith Gao"
	InputMap.applyPrompt(reinforce)
	reinforce.HoldDuration = 0.6
	reinforce.MaxActivationDistance = SMITH_RADIUS
	reinforce.RequiresLineOfSight = false
	reinforce.Parent = promptAnchor
	local refill = Instance.new("ProximityPrompt")
	refill.Name = "RefillPrompt"
	refill.ActionText = "Refill Elixir Gourd"
	refill.ObjectText = "Master Smith Gao"
	-- Every prompt shares the Interact key (C was Slide, Start was Heal). The refill sits at the
	-- quench trough by the rack so nearest-prompt ownership decides between it and the smith.
	InputMap.applyPrompt(refill)
	refill.HoldDuration = 0.3
	refill.MaxActivationDistance = REFILL_RADIUS
	refill.RequiresLineOfSight = false
	local trough = Kit.slab(loggia, "QuenchTrough", Vector3.new(2.4, 1.6, 4), base * CFrame.new(-9, 0.8, -8), "StoneDark")
	refill.Parent = trough
	return reinforce, refill
end

local function buildHeroStatueDais(parent: Folder)
	-- The colossus closes the main axis behind the Ascension gate (SanctuaryColossus), so the
	-- plaza's north side stays clear for the stairs and the view up them ends on her.
	Colossus.Build(parent, ORIGIN, LAYOUT.StairSteps * LAYOUT.StairRise, STAIR_START + LAYOUT.StairSteps * LAYOUT.StairRun + LANDING_DEPTH)
end

-------------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------------
-- Behaviour
-------------------------------------------------------------------------------------------------

local function toCFrame(p: World.Placement): CFrame
	return CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, math.rad(p.Yaw), 0)
end

-- Portal arrival (batch 07, #30) faces the destination altar a few strides ahead, so the first
-- checkpoint is in view rather than behind the player; respawns keep the altar's own facing.
local function arrivalCFrame(altar: World.Altar): CFrame
	local at = Vector3.new(altar.Spawn.X, altar.Spawn.Y, altar.Spawn.Z)
	return CFrame.lookAt(at, Vector3.new(altar.Placement.X, at.Y, altar.Placement.Z))
end

local function result(player: Player, ok: boolean, reason: string)
	player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
end

local function onPortal(hit: BasePart)
	local model = hit:FindFirstAncestorOfClass("Model")
	local player = if model then Players:GetPlayerFromCharacter(model) else nil
	if not player then
		return
	end
	local userId = player.UserId
	local clock = os.clock()
	if (transit[userId] or 0) &gt; clock then
		return
	end
	local e = Characters.GetEntity(userId)
	if not e or e.Model ~= model or e.Fighter.State == "KO" or e.Respawning or Characters.IsInDuel(userId) then
		return
	end
	transit[userId] = clock + PORTAL_COOLDOWN
	Characters.Cinematic(userId, PORTAL_FADE * 2)
	Characters.Cue("PortalTransit", userId, { to = DESTINATION.Id, name = DESTINATION.Name, fade = PORTAL_FADE })
	task.delay(PORTAL_FADE, function()
		local current = Characters.GetEntity(userId)
		if running and current and current.Fighter.State ~= "KO" and not Characters.IsInDuel(userId) then
			Characters.Teleport(userId, arrivalCFrame(DESTINATION))
		end
	end)
end

local function poll()
	for _, player in Players:GetPlayers() do
		local userId = player.UserId
		local e = Characters.GetEntity(userId)
		if e and e.Fighter.State ~= "KO" and not e.Respawning and not Characters.IsInDuel(userId) then
			local position = e.Root.Position
			local flat = Vector3.new(position.X - ORIGIN.X, 0, position.Z - ORIGIN.Z)
			-- Only a body that fell from the Sanctuary is caught; ground regions, the space between
			-- them and respawn placement at a later altar are destinations, not falls from the clouds.
			local region = World.regionAt(position.X, position.Y, position.Z)
			local state = fallState[userId]
			if not state then
				state = { Aloft = false }
				fallState[userId] = state
			end
			if Recovery.sanctuaryFall(state, region, flat.Magnitude, position.Y, Characters.IsSettling(userId), CATCH_LIMITS) then
				-- The clouds return those who fall back to the bonfire.
				Characters.Teleport(userId, spawnCFrame)
				Characters.Cue("SanctuaryCatch", userId, {})
			end
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function SanctuaryService.Start()
	assert(not running, "SanctuaryService already started")
	assert(BONFIRE_ALTAR.Region == "Sanctuary", "The starting altar must stand in the Sanctuary")
	assert(DESTINATION ~= nil, "Sanctuary portal destination missing")
	running = true
	local existing = Workspace:FindFirstChild(World.Regions.Sanctuary.MapFolder)
	if existing then
		existing:Destroy()
	end
	local sanctuary = Instance.new("Folder")
	sanctuary.Name = World.Regions.Sanctuary.MapFolder
	root = sanctuary
	spawnCFrame = toCFrame(BONFIRE_ALTAR.Spawn)

	local origin = CFrame.new(ORIGIN)
	Courtyard.Build(sanctuary, origin, BONFIRE_ALTAR.Id, LAYOUT.PlinthHeight)
	Cloisters.Build(sanctuary, origin, ORIGIN.X - LOGGIA.X - 18, PROMENADE.X - ORIGIN.X - BALCONY_APOTHEM)
	local trigger = Ascent.Build(sanctuary, origin, { Steps = LAYOUT.StairSteps, Rise = LAYOUT.StairRise, Run = LAYOUT.StairRun,
		Width = LAYOUT.StairWidth, Start = STAIR_START, Landing = LANDING_DEPTH, Gate = ARCH_OFFSET })
	local reinforce, refill = buildLoggia(sanctuary)
	DuelCourt.Build(sanctuary, CFrame.new(PROMENADE), BALCONY_APOTHEM)
	buildHeroStatueDais(sanctuary)
	-- Batch 16: pilgrim walk and Well of Descent, cache routes, reveal points, terrace parapet.
	local okRoutes, routeProblem = pcall(Approach.Build, sanctuary)
	if not okRoutes then
		warn("[Sanctuary] Pilgrim routes skipped: " .. tostring(routeProblem))
	end
	Horizon.Foundations(sanctuary, origin, LOGGIA - ORIGIN, PROMENADE - ORIGIN, DESCENT)
	Horizon.Build(sanctuary, origin)
	Ecology.Build(sanctuary, origin)
	sanctuary.Parent = Workspace

	-- Default checkpoint for anyone without a resolved respawn yet (WorldService's altar hook
	-- supersedes it once a Souls session exists).
	table.insert(disconnectors, Characters.OnEntityAdded(function(id: number, kind: Characters.EntityKind)
		if kind == "Player" then
			Characters.SetRespawnPoint(id, spawnCFrame)
		end
	end))
	table.insert(connections, trigger.Touched:Connect(onPortal))
	table.insert(connections, reinforce.Triggered:Connect(function(player: Player)
		local Dialogue=require(script.Parent.DialogueService)
        Dialogue.Open(player,"Gao")
	end))
	table.insert(connections, refill.Triggered:Connect(function(player: Player)
		local ok, reason = WorldService.RefillElixirs(player.UserId)
		result(player, ok, reason)
	end))
	-- The Interact key beside the smith is the reinforce prompt's own key; acknowledge it quietly.
	table.insert(disconnectors, WorldService.RegisterInteractable(function(_userId: number, position: Vector3): (boolean?, string?)
		if (position - smithPosition).Magnitude &lt;= SMITH_RADIUS + 1 then
			return true, "Smith"
		end
		return nil, nil
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		transit[player.UserId] = nil
		fallState[player.UserId] = nil
	end))
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator &gt;= POLL_INTERVAL then
			accumulator = 0
			local ok, problem = pcall(poll)
			if not ok then
				warn("[Sanctuary] Poll failed: " .. tostring(problem))
			end
		end
	end))
end

function SanctuaryService.SpawnCFrame(): CFrame
	return spawnCFrame
end

function SanctuaryService.Contains(position: Vector3): boolean
	return World.regionAt(position.X, position.Y, position.Z) == "Sanctuary"
end

function SanctuaryService.Destroy()
	running = false
	for _, disconnect in disconnectors do
		disconnect()
	end
	table.clear(disconnectors)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	table.clear(transit)
	table.clear(fallState)
	local folderRoot = root
	if folderRoot then
		folderRoot:Destroy()
		root = nil
	end
end

return SanctuaryService
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="171">
          <Properties>
            <string name="Name">SanctuaryTerrace</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryTerrace
-- Dressing for the Veiled Ascetic's terrace (SanctuaryColossus owns the slab, the statue and the tree):
-- a paved processional path from the gate to her seat between paired carved stelae and lanterns, a
-- few distinctive ruins - a fallen pailou, banded pillars, broken stelae - with mossy outcrops among the
-- roots, lanterns along the front rim, and layered rock spurs under the edge in place of plain boxes.
-- Dressing stays near the path and landing and away from the pilgrim daises, so the open terrace and
-- every view of her remain clear. `centre` is the terrace centre on its top, +Z toward the plaza.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Props = require(script.Parent:WaitForChild("SanctuaryProps") :: ModuleScript)
local Leaves = require(script.Parent:WaitForChild("SanctuaryLeaves") :: ModuleScript)
local Frame = require(script.Parent:WaitForChild("SanctuaryFrame") :: ModuleScript)

local Terrace = {}

local M = Enum.Material
local function block(group: Instance, size: Vector3, cf: CFrame)
	Kit.part(group, "RuinCollision", size, cf * CFrame.new(0, size.Y / 2, 0), Color3.new(), M.SmoothPlastic,
		{ Collide = true, Query = false, Transparency = 1, Shadow = false })
end

-- x, z, yaw (degrees), scale, tilt (degrees)
local PILLARS = { { -40, 205, 10, 1.3, 0 }, { -48, 196, 40, 1.0, 9 }, { 46, 212, -20, 1.5, 0 }, { 104, 176, 0, 1.2, -6 },
	{ -108, 170, 25, 1.4, 0 }, { 150, 60, 0, 1.8, 0 }, { -155, 40, 15, 1.6, 7 }, { 60, -120, 0, 2.1, 0 }, { -84, -150, 30, 2.0, 0 } }
local GATES = { { -62, 150, 20, 1.15 }, { 74, 95, -35, 1.0 } }
local OUTCROPS = { { -56, 160, 1.2 }, { 80, 106, 1.0 }, { -30, 190, 0.9 }, { 112, 184, 1.1 }, { -150, 52, 1.8 }, { 156, 72, 2.0 }, { 20, 236, 0.7 } }

local function ruins(group: Instance, centre: CFrame)
	for _, p in PILLARS do
		local cf = centre * CFrame.new(p[1], -0.4, p[2]) * CFrame.Angles(0, math.rad(p[3]), math.rad(p[5]))
		if not Kit.place(group, "Ruin_Pillar", cf, p[4]) then
			Kit.slab(group, "RuinPillar", Vector3.new(2.2, 10, 2.2) * p[4], cf * CFrame.new(0, 5 * p[4], 0), "Stone")
		end
		block(group, Vector3.new(2.8, 11, 2.8) * p[4], cf)
	end
	for _, g in GATES do
		local cf = centre * CFrame.new(g[1], -0.3, g[2]) * CFrame.Angles(0, math.rad(g[3]), 0)
		Kit.place(group, "Ruin_Gate", cf, g[4])
		for _, x in { -4.5, 4.5 } do
			block(group, Vector3.new(2.4, 10, 2.4) * g[4], cf * CFrame.new(x * g[4], 0, 0))
		end
	end
	for _, o in OUTCROPS do
		local cf = centre * CFrame.new(o[1], -0.6, o[2]) * CFrame.Angles(0, o[1] * 0.07, 0)
		Kit.place(group, "Rock_Outcrop", cf, o[3])
		block(group, Vector3.new(8, 3.6, 5) * o[3], cf)
	end
end

local function processional(group: Instance, centre: CFrame, radius: number, seat: number)
	local near, far = radius - 3, seat + 22
	local length = near - far
	local mid = centre * CFrame.new(0, 0, (near + far) / 2)
	Kit.slab(group, "ProcessionalWay", Vector3.new(32, 0.4, length), mid * CFrame.new(0, -0.15, 0), "PavingPath")
	for side = -1, 1, 2 do
		Kit.slab(group, "WayInlay", Vector3.new(0.14, 0.05, length - 2), mid * CFrame.new(side * 15.6, 0.06, 0), "Bronze", Kit.decor())
		Kit.slab(group, "ProcessionalEdging", Vector3.new(0.55, 0.2, length), mid * CFrame.new(side * 16.28, -0.015, 0), "StoneDark", Kit.decor())
		Kit.slab(group, "WayOuterThread", Vector3.new(0.06, 0.025, length - 2), mid * CFrame.new(side * 15.25, 0.06, 0), "Bronze", Kit.decor())
		for _, z in { near - 8, near - 30, near - 52 } do
			Props.lantern(group, centre * CFrame.new(side * 20.5, 0.05, z))
		end
		local face = CFrame.Angles(0, math.rad(side * 90), 0) -- front panels turn to the path
		Props.stele(group, centre * CFrame.new(side * 27, 0, near - 19) * face, if side &lt; 0 then "SHE KEEPS\nTHE GATE" else "THE VEILED\nASCETIC")
		Props.stele(group, centre * CFrame.new(side * 27, 0, near - 41) * face, "", side &gt; 0)
	end
	Props.stele(group, centre * CFrame.new(-28, 0, near - 10) * CFrame.Angles(0, math.rad(160), math.rad(4)), "", true)
end

-- Two quiet gardens make a human-scale forecourt at the gate. They remain well outside the central
-- 32-stud procession and the pilgrim daises; the imported tree and roots keep all their space.
local function forecourt(group: Instance, centre: CFrame, radius: number)
	local near = radius - 3
	for side = -1, 1, 2 do
		local wing = centre * CFrame.new(side * 30, 0, near - 20)
		Kit.slab(group, "ForecourtWing", Vector3.new(26, 0.16, 11), wing * CFrame.new(0, -0.03, 0), "PavingPath", Kit.decor())
		Kit.slab(group, "ForecourtCrossInlay", Vector3.new(25.6, 0.025, 0.08), wing * CFrame.new(0, 0.065, 4.8), "Bronze", Kit.decor())
		local garden = centre * CFrame.new(side * 32, 0, near - 55)
		Kit.part(group, "GardenEarth", Vector3.new(17, 0.1, 26), garden, Color3.fromRGB(52, 62, 49), M.Ground, Kit.decor())
		for _, x in { -8.9, 8.9 } do
			Kit.slab(group, "GardenKerb", Vector3.new(0.65, 0.38, 27.2), garden * CFrame.new(x, 0.08, 0), "StoneDark", Kit.decor())
		end
		for _, z in { -13.3, 13.3 } do
			Kit.slab(group, "GardenKerb", Vector3.new(18.4, 0.38, 0.65), garden * CFrame.new(0, 0.08, z), "StoneDark", Kit.decor())
		end
		Kit.place(group, "Rock_Outcrop", garden * CFrame.new(-side * 1.6, -0.3, 1.4) * CFrame.Angles(0, side * 0.8, 0), 1.2)
		Props.tree(group, garden * CFrame.new(side * 3, 0, -4) * CFrame.Angles(0, side * 1.4, 0), 0.65, true)
		Props.shrub(group, garden * CFrame.new(-side * 4, 0, 7), 0.9)
		Leaves.Scatter(group, garden * CFrame.new(0, 0.1, 0), Vector2.new(8, 12), 36, 571 + side)
		Props.bench(group, centre * CFrame.new(side * 22, 0.05, near - 11) * CFrame.Angles(0, math.rad(side * 90), 0))
	end
end

-- Raised prayer courts, approached by broad five-step flights, give the foreground a clear second
-- level. Their clean roof silhouettes and low carved fronts frame the much taller goddess. Crags
-- and crimson planting occupy the outer half; the centre stays open for processional circulation.
local function landscapeGardens(group: Instance, centre: CFrame, seat: number)
	local gardens = Kit.folder("TerraceCragGardens", group)
	for side = -1, 1, 2 do
		local garden = Kit.folder(if side &lt; 0 then "WestCragGarden" else "EastCragGarden", gardens)
		local at = centre * CFrame.new(side * 68, 0, 208)
		local yaw = if side &lt; 0 then -0.24 else 0.38
		local top = 2.55
		Kit.slab(garden, "PrayerCourtFoundation", Vector3.new(48, 2.4, 44), at * CFrame.new(0, 1.2, 0), "StoneDark")
		Kit.slab(garden, "PrayerCourtPaving", Vector3.new(48.3, 0.3, 44.3), at * CFrame.new(0, 2.4, 0), "PavingPath")
		Kit.slab(garden, "PrayerCourtShadowCourse", Vector3.new(48.8, 0.3, 44.8), at * CFrame.new(0, 2.1, 0), "StoneDark", Kit.decor())
		for step = 1, 5 do
			local height = top * step / 5
			local cf = centre * CFrame.new(side * (33 + step * 2), height * 0.5, 223)
			Kit.slab(garden, "PrayerCourtStep", Vector3.new(2.05, height, 12), cf, "Stone")
			Kit.slab(garden, "PrayerCourtStepNosing", Vector3.new(0.18, 0.13, 12.2), cf * CFrame.new(-side * 0.94, height * 0.5, 0), "StoneDark", Kit.decor())
		end
		local shrine = at * CFrame.new(-side * 9, top, -2)
		Frame.pavilion(garden, shrine, 12, 10, 10.2, { Square = true, Rise = 0.86, Xs = { -6, 6 } })
		Props.stele(garden, shrine * CFrame.new(0, 0, -1.7), "", side &gt; 0)
		-- A mossy planted bed: plain dark Ground read as a black hole under the sacred tree's shadow.
		Kit.part(garden, "CragGardenEarth", Vector3.new(21, 0.12, 33), at * CFrame.new(side * 12, top + 0.03, -2),
			Color3.fromRGB(104, 112, 66), M.LeafyGrass, Kit.decor())
		local ledgeTop = top + (if side &lt; 0 then 4.8 else 5.9)
		Kit.place(garden, "Cliff_Ledge", at * CFrame.new(side * 13, ledgeTop, -6) * CFrame.Angles(0, yaw, 0), Vector3.new(0.43, 0.23, 0.51))
		Kit.place(garden, "Rock_Outcrop", at * CFrame.new(side * 14, top - 0.25, -5) * CFrame.Angles(0, yaw + 0.35, 0), Vector3.new(2.2, 2.4, 2.1))
		Kit.place(garden, "Rock_Outcrop", at * CFrame.new(side * 20, top - 0.2, 9) * CFrame.Angles(0, yaw - 0.7, 0), Vector3.new(1.5, 1.7, 1.5))
		for x = -21, 21, 6 do
			Kit.place(garden, "Rail_Bay", at * CFrame.new(x, top, 22), Vector3.new(6 / 5.1, 0.72, 1))
		end
		for z = -19, 17, 6 do
			Kit.place(garden, "Rail_Bay", at * CFrame.new(side * 24, top, z) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(6 / 5.1, 0.72, 1))
		end
		for _, x in { -18, 18 } do Props.lantern(garden, at * CFrame.new(x, top, 20.5)) end
		Props.tree(garden, at * CFrame.new(side * 13, ledgeTop - 0.12, -6) * CFrame.Angles(0, yaw + side * 0.8, 0),
			if side &lt; 0 then 1.18 else 1.12, side &gt; 0)
		for i, p in { { side * 20, top + 1.5, 9 }, { side * 7, top + 0.2, 16 }, { side * 19, ledgeTop - 0.2, -9 } } do
			Props.shrub(garden, at * CFrame.new(p[1], p[2], p[3]) * CFrame.Angles(0, i * 1.7 + side, 0), 1.4 + i * 0.12)
		end
		Leaves.Scatter(garden, at * CFrame.new(0, top + 0.06, 13), Vector2.new(20, 6), 35, 7621 + side)
	end
	-- A single cool stone bench looks diagonally toward her seat, outside the procession and beds.
	local foot = (centre * CFrame.new(-43, 0.12, 231)).Position
	local target = (centre * CFrame.new(0, 0.12, seat)).Position
	local bench = CFrame.lookAt(foot, target)
	Kit.slab(gardens, "PilgrimStoneSeat", Vector3.new(7.8, 0.38, 2.1), bench * CFrame.new(0, 1.82, 0), "Stone", Kit.decor())
	Kit.slab(gardens, "SeatShadowCourse", Vector3.new(7.9, 0.14, 2.2), bench * CFrame.new(0, 1.56, 0), "StoneDark", Kit.decor())
	for _, x in { -2.7, 2.7 } do
		Kit.slab(gardens, "StoneSeatTrestle", Vector3.new(0.95, 1.5, 1.6), bench * CFrame.new(x, 0.75, 0), "Stone", Kit.decor())
		Kit.slab(gardens, "StoneSeatFoot", Vector3.new(1.5, 0.24, 1.95), bench * CFrame.new(x, 0.12, 0), "StoneDark", Kit.decor())
	end
	gardens:SetAttribute("RaisedPrayerCourts", 2)
	gardens:SetAttribute("ProcessionalClearWidth", 32)
end

-- Lanterns along the front rim, either side of the landing.
local function rim(group: Instance, centre: CFrame, radius: number)
	for _, deg in { -58, -46, -34, -22, 22, 34, 46, 58 } do
		local a = math.rad(deg)
		Props.lantern(group, centre * CFrame.new(math.sin(a) * (radius - 9), 0, math.cos(a) * (radius - 9)))
	end
end

-- Floating karst is broad where it carries the sanctuary, then fractures downward into the clouds.
-- The vista meshes' closed, irregular feet form that plateau; their broken summits point down.
-- Eight overlapping outer masses and one central mass cover the complete support, so its smooth
-- collision cylinders and circular paving rim can disappear without leaving a hovering disc. The
-- three plaza-side masses stop at the terrace's front edge: none overhangs the Ascension Stairs.
type Cliff = { Name: string, Angle: number, Reach: number, Height: number, Width: number, Depth: number }
local CLIFFS: { Cliff } = {
	{ Name = "Vista_Ridge", Angle = 3, Reach = 0.55, Height = 286, Width = 2.2, Depth = 3.0 },
	{ Name = "Vista_Crown", Angle = 46, Reach = 0.66, Height = 310, Width = 2.65, Depth = 3.025 },
	{ Name = "Vista_Ridge", Angle = 92, Reach = 0.74, Height = 274, Width = 2.2, Depth = 3.8 },
	{ Name = "Vista_Crown", Angle = 136, Reach = 0.67, Height = 298, Width = 2.55, Depth = 2.97 },
	{ Name = "Vista_Ridge", Angle = 181, Reach = 0.74, Height = 326, Width = 2.2, Depth = 3.8 },
	{ Name = "Vista_Crown", Angle = 227, Reach = 0.66, Height = 282, Width = 2.5, Depth = 2.915 },
	{ Name = "Vista_Ridge", Angle = 272, Reach = 0.74, Height = 304, Width = 2.2, Depth = 3.8 },
	{ Name = "Vista_Crown", Angle = 316, Reach = 0.62, Height = 294, Width = 2.6, Depth = 3.08 },
	{ Name = "Vista_Crown", Angle = 19, Reach = 0, Height = 258, Width = 3.2, Depth = 3.63 },
}

-- Reuse the imported, baked collision shape as a thin wafer at the rock cap. The descending cliff
-- stays nonphysical: colliding its whole body would intrude into the main staircase below it.
local function groundWafer(parent: Instance, rock: BasePart, top: number, index: number)
	local support = rock:Clone()
	support:ClearAllChildren()
	support.Name = "KarstCapGround_" .. index
	support.Size = Vector3.new(rock.Size.X, 0.6, rock.Size.Z)
	support.CFrame = CFrame.new(rock.Position.X, top - 0.3, rock.Position.Z) * rock.CFrame.Rotation
	support.Anchored, support.CanCollide, support.CanQuery, support.CanTouch = true, true, true, false
	support.Transparency, support.CastShadow = 1, false
	support:SetAttribute("AsuraGroundSupport", true)
	support.Parent = parent
end

local function underside(group: Instance, centre: CFrame, radius: number): boolean
	local cliffs = Kit.folder("TerraceKarstCliffs", group)
	local supports = Kit.folder("TerraceCapGround", group)
	local placed = 0
	for index, s in CLIFFS do
		local authoredHeight = if s.Name == "Vista_Crown" then 173.40224 else 155.18605
		local scale = Vector3.new(s.Width, s.Height / authoredHeight, s.Depth)
		local top = -0.075 - (index % 3) * 0.025
		local frame = centre * CFrame.Angles(0, math.rad(s.Angle), 0)
			* CFrame.new(0, top, radius * s.Reach) * CFrame.Angles(math.pi, 0, 0)
		local cliff = Kit.place(cliffs, s.Name, frame, scale)
		if cliff then
			cliff.Name = "TerraceKarstShoulder_" .. index
			cliff:SetAttribute("CliffTopElevation", centre.Position.Y + top)
			cliff:SetAttribute("CliffHeight", s.Height)
			for _, p in cliff:GetDescendants() do
				if p:IsA("BasePart") then
					-- Native summit moss would hang underneath the inverted island. The clean scanned
					-- rock alone also keeps this complete foundation to nine opaque MeshParts.
					if p.Name:find("__Moss", 1, true) then
						p:Destroy()
					else
						p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
						local finish = p:FindFirstChildOfClass("SurfaceAppearance")
						if finish then finish.Color = Color3.fromRGB(176, 190, 202) end
						if s.Reach &gt; 0 then groundWafer(supports, p, centre.Position.Y + top, index) end
					end
				end
			end
			placed += 1
		end
	end
	cliffs:SetAttribute("CragMeshBudget", 9)
	cliffs:SetAttribute("CragTriangleBudget", 170352)
	cliffs:SetAttribute("CompletePlateauFoundation", placed == #CLIFFS)
	supports:SetAttribute("SupportBudget", 9)
	supports:SetAttribute("StairClearanceHalfWidth", 28)
	return placed == #CLIFFS
end

-- A few crimson maples among the outer ruins, well off the path, the statue's views and the daises.
local TREES = { { -78, 150, 1.0 }, { -146, 60, 1.3 }, { 120, 196, 0.9 }, { 150, 40, 1.2 } }

function Terrace.Dress(group: Instance, centre: CFrame, radius: number, seat: number)
	processional(group, centre, radius, seat)
	forecourt(group, centre, radius)
	landscapeGardens(group, centre, seat)
	for i, t in TREES do
		Props.tree(group, centre * CFrame.new(t[1], -0.2, t[2]) * CFrame.Angles(0, i * 1.3, 0), t[3], i % 2 == 0)
		Props.shrub(group, centre * CFrame.new(t[1] + 5, -0.2, t[2] - 3), 1.3)
	end
	ruins(group, centre)
	rim(group, centre, radius)
	return underside(group, centre, radius)
end

return table.freeze(Terrace)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="172">
          <Properties>
            <string name="Name">SanctuaryTitan</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryTitan
-- Mounts the fused tree and woman (ServerStorage.AsuraAssets.FusedTreeStatue, built by
-- tools/blender/fuse_tree_woman.py) on the colossus terrace. She stands on the root mass of a sacred
-- tree four times her height, clear of its trunk, its root flare planted on the terrace; roots coil round her hem and reach toward her
-- shoulders, crimson sap runs down the bark and the blood-red crown is solid leaf geometry. Every
-- piece is scaled together (her silhouette FIGURE_HEIGHT studs) so the composition never drifts apart.
-- Imported mesh references, UVs and PBR maps are retained.
local Leaves = require(script.Parent:WaitForChild("SanctuaryLeaves") :: ModuleScript)

local Titan = {}

local FIGURE_HEIGHT = 150
local SINK = 2 -- the root bed beds into the terrace so no root edge hovers
-- Terrace layout (SanctuaryColossus / SanctuaryRoutes): her place `Forward` studs in front of the terrace
-- centre, root platform `Radius`. fuse_tree_woman.py draws the low roots in about a bed centre exactly
-- `Forward` behind her (stats.json: Forward 150, floor reach 227), so the flare sits inside the rim.
Titan.TreeSpan = { Forward = 150, Radius = 240 }
-- The authored floor sits this many figure heights above the lowest point of the piece (buried root
-- stubs dive below it), so the floor, where the root flare meets it, lands on the terrace
-- (stats.json FloorAboveBottom).
local FLOOR_ABOVE_BOTTOM = 0.1476

local function group(model: Model, prefixes: { string }, name: string): Model
	local g = Instance.new("Model")
	g.Name = name
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			for _, prefix in prefixes do
				if p.Name:sub(1, #prefix) == prefix then
					p.Parent = g
					break
				end
			end
		end
	end
	g.Parent = model
	return g
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Centre of the root bed: the tree chunks that reach the lowest tenth of its height.
local function rootBed(tree: Model): Vector3
	local box, size = tree:GetBoundingBox()
	local floor = box.Position.Y - size.Y * 0.5
	local sum, n = Vector3.zero, 0
	for _, p in tree:GetChildren() do
		local part = p :: BasePart
		if part.Position.Y - part.Size.Y * 0.5 &lt; floor + size.Y * 0.1 then
			sum += part.Position
			n += 1
		end
	end
	return if n &gt; 0 then sum / n else box.Position
end

-- Only the trunk's walkable root base collides (PreciseConvexDecomposition, authored in Studio); boughs,
-- leaves, sap and the generated roots are decoration.
local function collisions(tree: Model, roots: Model)
	local box, size = tree:GetBoundingBox()
	local base = box.Position.Y - size.Y * 0.5 + size.Y * 0.15
	for _, p in tree:GetChildren() do
		local part = p :: BasePart
		local solid = not part.Name:find("Leaves") and part.Position.Y - part.Size.Y * 0.5 &lt; base
		part.CanCollide, part.CanQuery = solid, solid
	end
	for _, p in roots:GetChildren() do
		local part = p :: BasePart
		part.CanCollide, part.CanQuery = false, false
	end
end

-- `focus` is where visitors look from (the plaza); the tree ends up on the far side of her.
-- `anchor` is her place: the floor point under the centre of her figure on the terrace top.
function Titan.Mount(statue: Model, anchor: CFrame, focus: Vector3?): boolean
	local cards = statue:FindFirstChild("Titan_Leaves")
	if cards then
		cards:Destroy()
	end
	local figure = group(statue, { "Titan_Figure" }, "Figure")
	local tree = group(statue, { "Titan_Canopy" }, "Tree")
	local roots = group(statue, { "Titan_Roots", "Titan_Sap" }, "Roots")
	if #figure:GetChildren() == 0 or #tree:GetChildren() == 0 then
		return false
	end
	collisions(tree, roots)

	local height = figure:GetExtentsSize().Y
	if height &gt; 0 then
		statue:ScaleTo(statue:GetScale() * FIGURE_HEIGHT / height)
	end

	-- Away-from-plaza direction; turn the piece about her so the tree's root bed lies that way.
	local away = flat(anchor.Position - (focus or (anchor.Position + anchor.LookVector)))
	away = if away.Magnitude &gt; 1e-3 then away.Unit else Vector3.zAxis
	local fc = figure:GetBoundingBox().Position
	local back = flat(rootBed(tree) - fc)
	if back.Magnitude &gt; 1e-3 then
		local turn = math.atan2(away.X, away.Z) - math.atan2(back.X, back.Z)
		statue:PivotTo(CFrame.new(fc) * CFrame.Angles(0, turn, 0) * CFrame.new(-fc) * statue:GetPivot())
	end

	-- Her figure centred over the anchor; the authored floor on the terrace, sunk SINK.
	local box, size = statue:GetBoundingBox()
	local bottom = box.Position.Y - size.Y * 0.5
	local floor = bottom + FLOOR_ABOVE_BOTTOM * FIGURE_HEIGHT
	fc = figure:GetBoundingBox().Position
	statue:PivotTo(statue:GetPivot() + Vector3.new(anchor.X - fc.X, anchor.Y - SINK - floor, anchor.Z - fc.Z))

	local fbox, fsize = figure:GetBoundingBox()
	local depth = math.abs(away.X) * fsize.X + math.abs(away.Z) * fsize.Z
	statue:SetAttribute("FigureHeight", fsize.Y)
	statue:SetAttribute("SacredTreeHeight", tree:GetExtentsSize().Y)

	-- Leaves fall from the crown: the four highest tree chunks each shed a share.
	local parts = tree:GetChildren()
	table.sort(parts, function(a, b)
		return (a :: BasePart).Position.Y &gt; (b :: BasePart).Position.Y
	end)
	for i = 1, math.min(4, #parts) do
		Leaves.Emitter(parts[i] :: BasePart, { Rate = 2, Size = 0.45, Wind = Vector3.new(1.2, -0.5, 0.35) })
	end

	-- Key light from the plaza side: three spots (Roblox caps a light's range at 60 studs) on her
	-- hem, chest and veiled face so she reads against the pale bark instead of as a silhouette. The
	-- hem spot is the closest to her white robe, so it is the dimmest (no blown-out hotspot).
	for i, h in { 0.25, 0.55, 0.85 } do
		local target = fbox.Position + Vector3.yAxis * (fsize.Y * (h - 0.5))
		local lamp = Instance.new("Part")
		lamp.Name = "TitanKeyLight" .. i
		lamp.Anchored, lamp.CanCollide, lamp.CanQuery, lamp.CanTouch = true, false, false, false
		lamp.Transparency, lamp.Size = 1, Vector3.one
		local distance = math.clamp(depth * 0.5 + 10 - (h - 0.25) * 30, 32, 52)
		lamp.CFrame = CFrame.lookAt(target - away * distance - Vector3.yAxis * 4, target)
		local spot = Instance.new("SpotLight")
		spot.Color = Color3.fromRGB(255, 210, 172)
		spot.Range, spot.Brightness, spot.Angle, spot.Shadows = 60, if i == 1 then 0.9 else 2.6, 80, false
		spot.Parent = lamp
		lamp.Parent = statue
	end
	return true
end

return Titan
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="173">
          <Properties>
            <string name="Name">SanctuaryVista</string>
            <string name="Source">--!strict
-- Original Blender karst kit, placed at landscape scale with its authored foot pivots intact.
-- Real Sanctuary Atmosphere supplies aerial perspective; mountains remain opaque PBR geometry.
-- Waterfall ribbons are authored rippled meshes, never emissive rectangular wall parts.
local Kit = require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript)
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Vista = {}

type Peak = { Name: string, X: number, Z: number, Foot: number, Height: number, Width: number, Yaw: number, Shrine: boolean }
-- All eight peaks lie 1,000–3,000 studs from the plaza. Width and height scales remain similar,
-- Buried lower shafts extend beneath the cloud sea; each authored summit elevation stays fixed.
local PEAKS: { Peak } = {
	{ Name = "Vista_Crown", X = -1180, Z = -1120, Foot = -1100, Height = 1425, Width = 3.1, Yaw = 24, Shrine = true },
	{ Name = "Vista_Needle", X = 1120, Z = -1050, Foot = -1100, Height = 1510, Width = 2.7, Yaw = -24, Shrine = true },
	{ Name = "Vista_Ridge", X = -1920, Z = -980, Foot = -1100, Height = 1465, Width = 3.0, Yaw = 52, Shrine = false },
	{ Name = "Vista_Crown", X = 1870, Z = -1640, Foot = -1100, Height = 1660, Width = 4.1, Yaw = -38, Shrine = false },
	{ Name = "Vista_Needle", X = -920, Z = 890, Foot = -1100, Height = 1450, Width = 2.3, Yaw = -72, Shrine = false },
	{ Name = "Vista_Crown", X = 1320, Z = 640, Foot = -1100, Height = 1355, Width = 2.8, Yaw = 101, Shrine = true },
	{ Name = "Vista_Ridge", X = 400, Z = 2000, Foot = -1100, Height = 1495, Width = 3.6, Yaw = 32, Shrine = false },
	{ Name = "Vista_Needle", X = -980, Z = 2490, Foot = -1100, Height = 1630, Width = 3.2, Yaw = -25, Shrine = false },
}
-- A separate nearer layer remains legible through the mandated dense peach atmosphere. These
-- crags flank the tree outside the terrace footprint; no silhouette crosses the central procession.
-- Summit world heights at the canonical plaza are 950, 1020 and 860 studs; feet are buried at -400.
local INTERMEDIATE: { Peak } = {
	{ Name = "Vista_Crown", X = -430, Z = -365, Foot = -380, Height = 730, Width = 2.4, Yaw = 21, Shrine = true },
	{ Name = "Vista_Needle", X = 445, Z = -445, Foot = -380, Height = 800, Width = 2.7, Yaw = -31, Shrine = true },
	{ Name = "Vista_Needle", X = -715, Z = 75, Foot = -380, Height = 640, Width = 2.9, Yaw = -65, Shrine = true },
}
local HEIGHT: { [string]: number } = { Vista_Crown = 173.40224, Vista_Ridge = 155.18605, Vista_Needle = 223.92113 }
local SUMMIT: { [string]: Vector3 } = {
	Vista_Crown = Vector3.new(5, 173.1, 2), Vista_Ridge = Vector3.new(-6, 154.8, 9), Vista_Needle = Vector3.new(5, 223.4, 1),
}

local function nonphysical(model: Model, rockTint: Color3?)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
			if rockTint and string.find(p.Name, "__Rock", 1, true) then
				local surface = p:FindFirstChildOfClass("SurfaceAppearance")
				if surface then surface.Color = rockTint else p.Color = rockTint end
				p.Transparency = 0
			end
		end
	end
	model:SetAttribute("AsuraDecorative", true)
end

local function pagoda(parent: Instance, summit: CFrame, scale: number)
	local shrine = Kit.folder("CloudSummitShrine", parent)
	Kit.slab(shrine, "SummitPlinth", Vector3.new(18, 2.4, 18) * scale, summit * CFrame.new(0, 0.4 * scale, 0), "StoneDark", Kit.decor())
	for tier = 0, 1 do
		local s = scale * (1 - tier * 0.19)
		local base = summit * CFrame.new(0, (1.6 + tier * 12) * scale, 0)
		Kit.slab(shrine, "DistantChamber", Vector3.new(8.6, 8.6, 8.6) * s, base * CFrame.new(0, 4.3 * s, 0), "Timber", Kit.decor())
		for _, x in { -5.5, 5.5 } do
			for _, z in { -5.5, 5.5 } do
				Kit.place(shrine, "Column_Lacquer", base * CFrame.new(x * s, 0, z * s), Vector3.new(0.7, 0.9, 0.7) * s, false)
			end
		end
		Kit.place(shrine, "Roof_Square", base * CFrame.new(0, 10 * s, 0), s * 1.03, false)
		-- Inset paper windows are warm reflecting surfaces, with no unshaded neon blocks or distant lights.
		for _, x in { -2.4, 2.4 } do
			Kit.part(shrine, "DistantPaperWindow", Vector3.new(1.3, 2.7, 0.08) * s, base * CFrame.new(x * s, 5 * s, -4.34 * s),
				Color3.fromRGB(192, 135, 76), Enum.Material.SmoothPlastic, Kit.decor())
		end
	end
end

local function summitFoliage(parent: Instance, summit: CFrame, focus: Vector3)
	if Assets.Textures.CrimsonBranch == "" then return end
	for _, side in { -1, 1 } do
		local at = summit:PointToWorldSpace(Vector3.new(side * 23, 8, 9))
		local frame = CFrame.lookAt(at, Vector3.new(focus.X, at.Y, focus.Z)) * CFrame.Angles(0, side * 0.3, side * 0.07)
		if Kit.branchCard(parent, frame, 25, 14, Color3.fromRGB(183, 149, 155)) then continue end
		local card = Kit.hidden(parent, "SummitCrimsonBranch", Vector3.new(25, 14, 0.04), frame)
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Name, decal.Texture, decal.Face = "CrimsonSpray", Assets.Textures.CrimsonBranch, face
			decal.Color3, decal.Parent = Color3.fromRGB(183, 149, 155), card
		end
	end
end

local function waterRibbon(parent: Instance, label: string, cf: CFrame, scale: Vector3, color: Color3, transparency: number)
	local model = Kit.place(parent, "Vista_Waterfall", cf, scale, false)
	if not model then return end
	nonphysical(model)
	model.Name = label
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Color, p.Material, p.Transparency = color, Enum.Material.SmoothPlastic, transparency
		end
	end
end

local function spillway(parent: Instance, origin: CFrame, x: number, z: number, yaw: number, index: number, width: number)
	local length = 108 + (index % 2) * 9
	local top = origin * CFrame.new(x, -0.14, z) * CFrame.Angles(0, math.rad(yaw), 0)
	local foot = top * CFrame.new(0, -length, 0)
	-- The exported mesh rises 120 studs from its foot. Its thin rippled face lies across local X;
	-- +Z is out from the rock. Matching the whole frame keeps foam and splash on that visible face.
	waterRibbon(parent, "CourtyardWaterfall_" .. index, foot, Vector3.new(width / 12.5, length / 120, 0.8), Color3.fromRGB(179, 213, 217), 0.24)
	for _, side in { -1, 1 } do
		waterRibbon(parent, "WaterfallFoam_" .. index, foot * CFrame.new(side * width * 0.32, 0, 0.25),
			Vector3.new(0.055, length / 120, 0.75), Color3.fromRGB(237, 239, 224), 0.27)
	end
	-- A crisp carved lip makes the water belong to the flagstones rather than hover beside them.
	for _, side in { -1, 1 } do
		Kit.slab(parent, "SpillwayCheek", Vector3.new(0.7, 0.8, 3.4), top * CFrame.new(side * (width / 2 + 0.3), -0.2, -0.6), "StoneDark", Kit.decor())
	end
	Kit.slab(parent, "SpillwaySill", Vector3.new(width + 1.5, 0.5, 1.3), top * CFrame.new(0, -0.55, -0.1), "Stone", Kit.decor())
	if Assets.Textures.Smoke == "" then return end
	local anchor = Kit.hidden(parent, "WaterfallCloudMerge", Vector3.new(width + 6, 4, 12), foot * CFrame.new(0, 14, 1))
	local e = Instance.new("ParticleEmitter")
	e.Name, e.Texture, e.Rate = "WaterfallSpray", Assets.Textures.Smoke, 0.9
	e.Lifetime, e.Speed, e.Acceleration = NumberRange.new(6, 10), NumberRange.new(1.5, 3), Vector3.new(0.15, 0.35, 0)
	e.SpreadAngle, e.EmissionDirection = Vector2.new(70, 70), Enum.NormalId.Top
	e.Size = Kit.sequence({ { 0, 10 }, { 0.5, 23 }, { 1, 33 } })
	e.Transparency = Kit.sequence({ { 0, 0.9 }, { 0.2, 0.58 }, { 0.7, 0.7 }, { 1, 1 } })
	e.Color, e.LightInfluence, e.Rotation = ColorSequence.new(Color3.fromRGB(237, 231, 220)), 0.7, NumberRange.new(0, 360)
	e.Parent = anchor
	e:Emit(6)
end

function Vista.Build(parent: Instance, origin: CFrame): Folder
	local group = Kit.folder("KarstHorizon", parent)
	for i, peak in PEAKS do
		local scale = Vector3.new(peak.Width, peak.Height / HEIGHT[peak.Name], peak.Width * (if i % 2 == 0 then 0.96 else 1.06))
		local base = origin * CFrame.new(peak.X, peak.Foot, peak.Z) * CFrame.Angles(0, math.rad(peak.Yaw), 0)
		local mountain = Kit.place(group, peak.Name, base, scale, false)
		if mountain then
			nonphysical(mountain, Color3.fromRGB(184, 198, 217))
			mountain.Name = peak.Name .. "_" .. i
			mountain:SetAttribute("VistaFootElevation", origin.Position.Y + peak.Foot)
			mountain:SetAttribute("VistaDistance", math.sqrt(peak.X * peak.X + peak.Z * peak.Z))
			mountain:SetAttribute("VistaLayer", if i &lt;= 2 then "MiddleDistance" else "FarDistance")
			if peak.Shrine then
				local summit = base * CFrame.new(SUMMIT[peak.Name] * scale)
				pagoda(group, summit, 2.2)
				if i == 1 or i == 2 then summitFoliage(group, summit, origin.Position) end
			end
		end
	end
	local middle = Kit.folder("IntermediateKarst", group)
	for i, peak in INTERMEDIATE do
		local scale = Vector3.new(peak.Width, peak.Height / HEIGHT[peak.Name], peak.Width)
		local base = origin * CFrame.new(peak.X, peak.Foot, peak.Z) * CFrame.Angles(0, math.rad(peak.Yaw), 0)
		local mountain = Kit.place(middle, peak.Name, base, scale, false)
		if mountain then
			-- A cooler, darker mineral tint provides the silhouette contrast; atmospheric scattering
			-- supplies the peach fade naturally, without translucent rock or extra lights.
			nonphysical(mountain, Color3.fromRGB(74, 99, 133))
			mountain.Name = "Intermediate_" .. peak.Name .. "_" .. i
			mountain:SetAttribute("VistaFootElevation", origin.Position.Y + peak.Foot)
			mountain:SetAttribute("VistaDistance", math.sqrt(peak.X * peak.X + peak.Z * peak.Z))
			mountain:SetAttribute("VistaLayer", "Intermediate")
			local summit = base * CFrame.new(SUMMIT[peak.Name] * scale)
			pagoda(middle, summit, if i == 3 then 2.3 else 2.0)
		end
	end
	middle:SetAttribute("MountainBudget", 3)
	middle:SetAttribute("AddedMeshTriangleBudget", 89906)
	middle:SetAttribute("AddedBasePartBudget", 93)
	local falls = Kit.folder("CourtyardCascades", group)
	spillway(falls, origin, -33, 46.4, 0, 1, 7.5)
	spillway(falls, origin, 33, 46.4, 0, 2, 6.2)
	spillway(falls, origin, -58.4, -29, -90, 3, 5.4)
	spillway(falls, origin, 58.4, -29, 90, 4, 7.1)
	spillway(falls, origin, -104, -5, -90, 5, 4.8)
	group:SetAttribute("MountainBudget", 11)
	group:SetAttribute("RequiredFarMountainBudget", 8)
	group:SetAttribute("IntermediateMountainBudget", 3)
	group:SetAttribute("CascadeEmitterBudget", 5)
	group:SetAttribute("CascadeMeshBudget", 15)
	group:SetAttribute("CascadeTriangleBudget", 4800)
	group:SetAttribute("CascadeParticleSteadyStateCeiling", 45)
	group:SetAttribute("SummitFoliageCardBudget", 4)
	return group
end

return table.freeze(Vista)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="174">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source">--!strict
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Catalog: any=require(Shared.ShopCatalog)
local Schema=require(Shared.ProfileSchema)
local Config: any=require(Shared.Config)
local Persistence: any=require(script.Parent.PersistenceService)
local Shop={}
local rng=Random.new()
local policyCache: {[number]: {expires: number,allowed: boolean}}={}
local function canRoll(id: number): boolean
 if not Config.Release.PurchasesIntegrationPassed then return true end
 -- Cash/spins are potentially paid once product delivery is enabled. Fail closed on policy errors.
 local cached=policyCache[id]
 if cached and cached.expires&gt;os.clock() then return cached.allowed end
 local player=game:GetService("Players"):GetPlayerByUserId(id)
 if not player then return false end
 local ok,info=pcall(function() return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(player) end)
 local allowed=ok and type(info)=="table" and info.ArePaidRandomItemsRestricted==false
 policyCache[id]={allowed=allowed,expires=os.clock()+60}
 return allowed
end
function Shop.RollStyle(id: number,useToken: boolean)
 if not canRoll(id) then return false,"Random purchases are unavailable for this account" end
 local selected: any=nil
 local isDuplicate: boolean?=nil
 local seed=rng:NextNumber() -- Stable across UpdateAsync callback retries.
 local ok,err=Persistence.Transaction(id,function(p: any)
  if useToken then assert(p.styleSpins&gt;0,"No style spins remaining");p.styleSpins-=1
  else assert(p.qiEssence&gt;=Catalog.SpinCostCash,"Insufficient Qi essence");p.qiEssence-=Catalog.SpinCostCash end
  p.pityCounter+=1
  local pool,total={},0
  for _,s in Catalog.Styles do
   if p.pityCounter&lt;Catalog.PityThreshold or s.rarity=="Epic" or s.rarity=="Legendary" then
    table.insert(pool,s);total+=s.weight
   end
  end
  local roll=math.floor(seed*total)+1
  for _,s in pool do roll-=s.weight;if roll&lt;=0 then selected=s;break end end
  if selected.rarity=="Epic" or selected.rarity=="Legendary" then p.pityCounter=0 end
  local entry=assert(p.styles[selected.name]);isDuplicate=entry.unlocked
  if isDuplicate then
   entry.xp+=Catalog.DuplicateXpBonus*(if p.ownedCosmetics.VIP_Pass then 2 else 1)
   entry.level=Schema.Level(entry.xp)
  else entry.unlocked=true end
 end)
 return ok,err,if ok then selected else nil,if ok then isDuplicate else nil
end
function Shop.RollCrate(id: number,crateId: string)
 if not canRoll(id) then return false,"Random purchases are unavailable for this account" end
 local crate=Catalog.Crates[crateId]
 if not crate then return false,"Unknown crate" end
 local seed=rng:NextNumber()
 local selected: any=nil
 local duplicate: boolean?=nil
 local ok,err=Persistence.Transaction(id,function(p: any)
  assert(p.qiEssence&gt;=crate.cost,"Insufficient Qi essence")
  local roll=math.floor(seed*100)+1
  for _,drop in crate.drops do roll-=drop.weight;if roll&lt;=0 then selected=drop.id;break end end
  assert(selected,"Invalid crate odds")
  duplicate=p.ownedCosmetics[selected]==true
  p.qiEssence-=crate.cost
  if duplicate then p.qiEssence+=crate.refund else p.ownedCosmetics[selected]=true end
 end)
 return ok,err,if ok then selected else nil,if ok then duplicate else nil
end
function Shop.BuyCosmetic(id: number,itemId: string)
 local item=Catalog.Cosmetics[itemId];if not item then return false,"Unknown cosmetic" end
 return Persistence.Transaction(id,function(p: any)
  assert(not p.ownedCosmetics[itemId],"Already owned");assert(p.qiEssence&gt;=item.cashPrice,"Insufficient Qi essence")
  p.qiEssence-=item.cashPrice;p.ownedCosmetics[itemId]=true
 end)
end
function Shop.EquipCosmetic(id: number,itemId: string)
 local item=Catalog.Cosmetics[itemId];if not item then return false,"Unknown cosmetic" end
 return Persistence.Transaction(id,function(p: any) assert(p.ownedCosmetics[itemId],"Item is locked");p.equippedCosmetics[item.slot]=itemId end)
end
function Shop.EquipStyle(id: number,name: string)
 return Persistence.Transaction(id,function(p: any) assert(p.styles[name] and p.styles[name].unlocked,"Style is locked");p.activeStyle=name end)
end
function Shop.SaveSettings(id: number,settings: any)
 if settings.keybinds~=nil and not Schema.ValidKeybinds(settings.keybinds) then return false,"Invalid or conflicting keybinds" end
 return Persistence.Transaction(id,function(p: any)
  p.settings.fov=settings.fov;p.settings.sensitivity=settings.sensitivity;p.settings.leftHanded=settings.leftHanded
  if settings.keybinds then p.settings.keybinds=table.clone(settings.keybinds) end
  if settings.comfort then assert(Schema.ValidComfort(settings.comfort),"Invalid comfort settings");p.settings.comfort=table.clone(settings.comfort) end
 end)
end
function Shop.BuyBundle() return false,"Developer products require a durable receipt" end
-- Shared server-side grant body for real delivery and the isolated synthetic adapter.
function Shop.GrantBundle(p: any,bundle: any)
 if bundle.bundleType=="Cash" then p.qiEssence+=bundle.amount
 elseif bundle.bundleType=="Spins" then p.styleSpins+=bundle.amount
 elseif bundle.bundleType=="Pass" then p.ownedCosmetics.VIP_Pass=true
 else error("Unsupported product") end
end
function Shop.ProcessReceipt(receipt: any)
 local decision=Enum.ProductPurchaseDecision
 -- Delivery of outstanding receipts is independent of whether new purchase prompts are enabled.
 if not Config.Release.PurchasesIntegrationPassed then return decision.NotProcessedYet end
 if not Persistence.Get(receipt.PlayerId) then return decision.NotProcessedYet end
 local bundle
 for _,b in Catalog.Bundles do if b.productId==receipt.ProductId then bundle=b;break end end
 if not bundle then return decision.NotProcessedYet end
 local ok=Persistence.ProcessReceipt(receipt.PlayerId,receipt.PurchaseId,receipt.ProductId,function(p: any)
  Shop.GrantBundle(p,bundle)
 end)
 return if ok then decision.PurchaseGranted else decision.NotProcessedYet
end
local Forge=require(script.Parent.ForgeService)
Shop.UpgradeWeapon=Forge.Upgrade
Shop.InfuseWeapon=Forge.Infuse
Shop.Trade=Forge.Trade
return Shop
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="175">
          <Properties>
            <string name="Name">SpellEffects</string>
            <string name="Source">--!strict
-- Server-owned pulses and swept projectiles; no client can select a victim or damage amount.
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Spells=require(Shared.Simulation.SpellSchema)
local Rules=require(Shared.Simulation.SpellRules)
local Characters=require(script.Parent.CharacterService)
local Geometry=require(script.Parent.SpellGeometry)
local Effects={}
type Job={Source: any,Fighter: any,Duel: string?,Spell: any,Potency: number,Origin: Vector3,Direction: Vector3,Point: Vector3,At: number,Travel: number,Hits: {[number]: boolean}}
type Burn={Source: any,SourceFighter: any,Target: any,Fighter: any,Duel: string?,Stacks: number,At: number,Until: number}
local jobs: {Job}={}
local burns: {[string]: Burn}={}
local function valid(j: Job): boolean
 return Characters.GetActor(j.Source.Id)==j.Source and j.Source.Fighter==j.Fighter and j.Fighter.State~="KO" and j.Source.Duel==j.Duel and j.Source.Root.Parent~=nil
end
local function strike(j: Job,target: any,now: number)
 local s=j.Spell
 if not Characters.IsHostile(j.Source.Id,target.Id) or target.Duel~=j.Duel then return end
 if s.Speed&gt;0 and Rules.projectileParry(target.Fighter,now) then
  local held=target.Fighter.State=="Blocking"
  Characters.ApplyArea(j.Source.Id,target.Id,0,0,false)
  Characters.Cue("ProjectileParry",target.Id,{position=target.Root.Position})
  if held then target.Fighter.Qi=math.min(100,target.Fighter.Qi+15) end
  return
 end
 local outcome=Characters.ApplyArea(j.Source.Id,target.Id,s.Damage*j.Potency,s.Posture*j.Potency,s.Status.IgnoreGuard)
 if outcome~="Hit" and outcome~="KO" and outcome~="GuardBroken" then return end
 Rules.status(target.Fighter,s.Id,now)
 target.Model:SetAttribute("RootUntil",target.Fighter.RootUntil)
 if s.Status.Burn&gt;0 and outcome~="KO" then
  local key=j.Source.Id..":"..target.Id;local old=burns[key]
  burns[key]={Source=j.Source,SourceFighter=j.Fighter,Target=target,Fighter=target.Fighter,Duel=j.Duel,Stacks=math.min(5,(if old then old.Stacks else 0)+s.Status.Burn),At=now+1,Until=now+4}
 end
 Characters.Cue("SpellHit",j.Source.Id,{spell=s.Id,position=target.Root.Position,root=s.Status.Root})
end
local function pulse(j: Job,now: number)
 local s=j.Spell
 local pointed=s.Shape=="Pillars" or s.Shape=="Impact" or s.Shape=="Column"
 local origin=if pointed then j.Point else j.Origin
 local range=if pointed then s.Radius else s.Range
 for _,e in Geometry.targets(j.Source,origin,range) do
  local delta=e.Root.Position-origin
  local inside=s.Shape~="Cone" or delta.Magnitude&lt;0.1 or delta.Unit:Dot(j.Direction)&gt;=math.cos(math.rad(s.Arc/2))
  if inside then strike(j,e,now) end
 end
 Characters.Cue("SpellPulse",j.Source.Id,{spell=s.Id,position=origin,direction=j.Direction,range=range})
end
function Effects.release(source: any,id: string,potency: number,now: number)
 local s=Spells.get(id);if not s or not source.Root.Parent then return end
 local origin=source.Root.Position;local direction=source.Root.CFrame.LookVector
 -- A Column stands on the ground under the caster, so a levitating channel still reaches the floor.
 local point=if s.Shape=="Column" then Geometry.ground(origin) else Geometry.endpoint(origin,direction,s.Range)
 if s.Shape=="Self" then
  if s.Status.Ward then Rules.ward(source.Fighter,now);source.Model:SetAttribute("JadeAegisUntil",now+30) end
  if s.Status.Teleport then
   Geometry.teleport(source,point)
   if s.Status.Decoy then source.Model:SetAttribute("PhantomPosition",origin);source.Model:SetAttribute("PhantomUntil",now+2) end
  end
 end
 local targets=if s.Shape=="Pillars" then Geometry.targets(source,origin,s.Range) else {}
 for n=1,s.Pulses do
  local target=targets[((n-1)%math.max(1,#targets))+1]
  local impact=if target then target.Root.Position else point
  if s.Shape~="Self" then
   table.insert(jobs,{Source=source,Fighter=source.Fighter,Duel=source.Duel,Spell=s,Potency=potency,Origin=origin,Direction=direction,
    Point=if s.Shape=="Pillars" then impact else point,At=now+(if s.Shape=="Pillars" then n else n-1)*s.Delay,Travel=0,Hits={}})
  end
 end
 Characters.Cue("SpellRelease",source.Id,{spell=id,position=origin,destination=point,direction=direction,travel=if s.Speed&gt;0 then (point-origin).Magnitude/s.Speed else 0})
end
function Effects.step(now: number,dt: number)
 for index=#jobs,1,-1 do
  local j=jobs[index];local s=j.Spell;local remove=not valid(j)
  if not remove and now&gt;=j.At then
   if s.Speed&gt;0 or s.Shape=="Line" then
    local distance=(j.Point-j.Origin).Magnitude
    local previous=j.Origin+j.Direction*j.Travel
    j.Travel=math.min(distance,j.Travel+(if s.Speed&gt;0 then s.Speed*dt else distance))
    local current=j.Origin+j.Direction*j.Travel
    do
     local hitTargets=Geometry.targets(j.Source,(previous+current)/2,(current-previous).Magnitude/2+s.Radius+3)
     table.sort(hitTargets,function(a: any,b: any): boolean return (a.Root.Position-previous).Magnitude&lt;(b.Root.Position-previous).Magnitude end)
     for _,e in hitTargets do
      if not j.Hits[e.Id] and Geometry.segment(e.Root.Position,previous,current)&lt;=s.Radius+1.5 then
       j.Hits[e.Id]=true
       if s.Shape=="Impact" then
        j.Point=e.Root.Position;Geometry.teleport(j.Source,j.Point);pulse(j,now);remove=true;break
       else strike(j,e,now) end
       if not s.Pierces then remove=true;break end
      end
     end
    end
    if not remove and j.Travel&gt;=distance then
     if s.Shape=="Impact" then Geometry.teleport(j.Source,j.Point);pulse(j,now) end
     remove=true
    end
   else pulse(j,now);remove=true end
  end
  if remove then table.remove(jobs,index) end
 end
 for key,b in burns do
  if now&gt;b.Until or Characters.GetActor(b.Source.Id)~=b.Source or Characters.GetActor(b.Target.Id)~=b.Target or b.Target.Fighter~=b.Fighter
   or b.Source.Fighter~=b.SourceFighter or b.Source.Fighter.State=="KO" or b.Fighter.State=="KO" or b.Source.Duel~=b.Duel or b.Target.Duel~=b.Duel then burns[key]=nil
  elseif now&gt;=b.At then b.At=now+1;Characters.ApplyArea(b.Source.Id,b.Target.Id,b.Stacks*2,0,true) end
 end
end
function Effects.clear()
 table.clear(jobs);table.clear(burns)
end
return Effects
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="176">
          <Properties>
            <string name="Name">SpellGeometry</string>
            <string name="Source">--!strict
local Workspace=game:GetService("Workspace")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local World=require(Shared.Shared.WorldDefinitions)
local Characters=require(script.Parent.CharacterService)
local Geometry={}
function Geometry.params(): RaycastParams
 local excluded: {Instance}={}
 for _,e in Characters.Entities() do table.insert(excluded,e.Model) end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=excluded
 params.RespectCanCollide=true
 return params
end
function Geometry.endpoint(origin: Vector3,direction: Vector3,range: number): Vector3
 local hit=Workspace:Raycast(origin,direction*range,Geometry.params())
 return origin+direction*(if hit then math.max(0,(hit.Position-origin).Magnitude-2) else range)
end
function Geometry.ground(origin: Vector3): Vector3
 local hit=Workspace:Raycast(origin,Vector3.new(0,-40,0),Geometry.params())
 return if hit then hit.Position+Vector3.new(0,3,0) else origin
end
function Geometry.clear(a: Vector3,b: Vector3): boolean
 return (a-b).Magnitude&lt;0.01 or Workspace:Raycast(a,b-a,Geometry.params())==nil
end
function Geometry.targets(source: any,origin: Vector3,range: number): {any}
 local targets={}
 for _,e in Characters.Entities() do
  if e.Fighter.State~="KO" and e.Root.Parent and Characters.IsHostile(source.Id,e.Id) and (e.Root.Position-origin).Magnitude&lt;=range and Geometry.clear(origin,e.Root.Position) then
   table.insert(targets,e)
  end
 end
 table.sort(targets,function(a: any,b: any): boolean return (a.Root.Position-origin).Magnitude&lt;(b.Root.Position-origin).Magnitude end)
 return targets
end
function Geometry.segment(point: Vector3,a: Vector3,b: Vector3): number
 local delta=b-a
 local t=if delta:Dot(delta)&gt;0 then math.clamp((point-a):Dot(delta)/delta:Dot(delta),0,1) else 0
 return (point-(a+delta*t)).Magnitude
end
function Geometry.teleport(e: any,destination: Vector3): boolean
 local origin=e.Root.Position
 local clipped=Geometry.endpoint(origin,if (destination-origin).Magnitude&gt;0.01 then (destination-origin).Unit else e.Root.CFrame.LookVector,(destination-origin).Magnitude)
 local params=Geometry.params()
 local floor=Workspace:Raycast(clipped+Vector3.new(0,5,0),Vector3.new(0,-15,0),params)
 if not floor or floor.Normal.Y&lt;0.6 then return false end
 local point=floor.Position+Vector3.new(0,3,0)
 if World.regionAt(origin.X,origin.Y,origin.Z)~=World.regionAt(point.X,point.Y,point.Z) then return false end
 -- The full body must fit; narrow gaps and ceilings cannot be bypassed by a point ray.
 for _,offset in {Vector3.new(1.5,0,0),Vector3.new(-1.5,0,0),Vector3.new(0,2,0),Vector3.new(0,0,1.5),Vector3.new(0,0,-1.5)} do
  if Workspace:Raycast(point,offset,params) then return false end
 end
 Characters.Teleport(e.Id,CFrame.lookAt(point,point+e.Root.CFrame.LookVector))
 return true
end
return table.freeze(Geometry)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="177">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/TutorialService
-- Runs the opening training (TutorialRules) for fresh profiles. Steps advance only on proof judged
-- here from authoritative combat events, a drink that actually spent a gourd charge, or the two
-- client-only actions (lock-on, Air Glide) reported over TutorialIntent. Progress persists in the
-- souls record (world.tutorial) and is published as the AsuraTutorial attribute; Skip and Replay are
-- explicit requests. While training, the Sparring Phantom's ring is non-lethal for that player
-- (KOProtected floors health at 1) and the phantom returns after it falls. It drops no Essence.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Rules = require(Shared.Shared.TutorialRules)
local Budget = require(Shared.Shared.IntentProtocol)
local World = require(Shared.Shared.WorldDefinitions)
local Characters = require(script.Parent.CharacterService)
local AI = require(script.Parent.AIService)
local Persistence = require(script.Parent.PersistenceService) :: any
local remote = Shared.Net:WaitForChild("TutorialIntent") :: RemoteEvent

local Tutorial = {}
Tutorial.SpawnId = "DM_Sparring_Phantom"
Tutorial.RingRadius = 32 -- non-lethal sparring ground around the phantom's home
Tutorial.PERILOUS_WINDOW = 1.0 -- seconds around a published perilous impact
type State = { Done: { [string]: boolean }, Elixirs: number?, Protected: boolean, Bucket: Budget.Bucket }
local states: { [number]: State } = {}
local connections: { RBXScriptConnection } = {}
local disconnects: { () -&gt; () } = {}
local running = false
local home = assert(World.spawnById(Tutorial.SpawnId), "Sparring Phantom spawn missing")
local HOME = Vector3.new(home.Placement.X, home.Placement.Y, home.Placement.Z)

-- A profile with no training record that has already gone past the Monastery Gate predates the
-- tutorial: it starts complete. Pure.
function Tutorial.initial(souls: any): { [string]: boolean }
	local done: { [string]: boolean } = {}
	for id in souls.world.tutorial or {} do done[id] = true end
	if next(done) == nil and (souls.world.altars.Altar_DesecratedCloister or next(souls.world.bosses) ~= nil) then
		done[Rules.Complete] = true
	end
	return done
end

local function publish(player: Player, s: State)
	player:SetAttribute("AsuraTutorial", Rules.serialize(s.Done))
end

local function persist(player: Player, s: State)
	local snapshot = table.clone(s.Done)
	task.spawn(function()
		local ok, err = Persistence.Transaction(player.UserId, function(p: any)
			p.souls.world.tutorial = snapshot
		end)
		if not ok then warn("[TutorialService] progress not saved: " .. tostring(err)) end
	end)
end

local function record(player: Player, signal: string)
	local s = states[player.UserId]
	local step = if s then Rules.advance(s.Done, signal) else nil
	if not s or not step then return end
	s.Done[step] = true
	if Rules.finished(s.Done) then s.Done[Rules.Complete] = true end
	publish(player, s)
	persist(player, s)
	local upcoming = Rules.current(s.Done)
	Characters.Cue("TutorialStep", player.UserId, { step = step, nextStep = if upcoming then upcoming.Id else "", complete = upcoming == nil })
end

local function perilous(attackerId: number): boolean
	local e = Characters.GetEntity(attackerId)
	local tag = e and e.Model:GetAttribute("AsuraTelegraph")
	if type(tag) ~= "string" then return false end
	local class, _, impact = string.match(tag, "^(%a+)|([^|]*)|([%d%.%-]+)$")
	return class == "Perilous" and math.abs(Characters.Now() - (tonumber(impact) or -math.huge)) &lt;= Tutorial.PERILOUS_WINDOW
end

local function onEvent(event: any, _point: Vector3?)
	for _, player in Players:GetPlayers() do
		local id = player.UserId
		if states[id] and (event.Source == id or event.Target == id) then
			local f = Characters.GetEntity(id) -- what the player was doing decides what the event proves
			local own = f and { State = f.Fighter.State, Move = f.Fighter.Move and f.Fighter.Move.Kind }
			local signal = Rules.signal(event.Kind, event.Source, event.Target, id, perilous(event.Target), own)
			if signal then record(player, signal) end
		end
	end
end

local function handle(player: Player, packet: any)
	local s = states[player.UserId]
	if not s or type(packet) ~= "table" or not Budget.Take(s.Bucket, os.clock(), 1, 1, 6) then return end
	if packet.action == "Signal" and type(packet.signal) == "string" and Rules.ClientSignals[packet.signal] then
		record(player, packet.signal)
	elseif packet.action == "Skip" or packet.action == "Replay" then
		s.Done = if packet.action == "Skip" then { [Rules.Skipped] = true } else {}
		publish(player, s)
		persist(player, s)
	end
end

local function poll()
	local phantomNeeded = false
	for _, player in Players:GetPlayers() do
		local id = player.UserId
		local profile = Persistence.Get(id)
		local s: State? = states[id]
		if not s and profile and profile.souls then
			local created: State = { Done = Tutorial.initial(profile.souls), Elixirs = nil, Protected = false, Bucket = { tokens = 6, time = os.clock() } }
			states[id], s = created, created
			publish(player, created)
		end
		local e = Characters.GetEntity(id)
		if s and e then
			local training = Rules.current(s.Done) ~= nil
			local inRing = training and (e.Root.Position - HOME).Magnitude &lt;= Tutorial.RingRadius
			if inRing or s.Protected then e.Fighter.KOProtected = inRing end -- re-applied to a respawned body
			s.Protected = inRing
			phantomNeeded = phantomNeeded or (training and (e.Root.Position - HOME).Magnitude &lt;= Tutorial.RingRadius * 2)
			local elixirs = player:GetAttribute("AsuraElixirs")
			if type(elixirs) == "number" then
				if s.Elixirs and elixirs &lt; s.Elixirs then record(player, "Heal") end -- a charge is spent only on an accepted drink
				s.Elixirs = elixirs
			end
		end
	end
	if phantomNeeded then AI.SpawnMob(Tutorial.SpawnId) end -- returns the live phantom if it still stands
end

function Tutorial.Start()
	assert(not running, "TutorialService already started")
	running = true
	table.insert(disconnects, Characters.Subscribe(onEvent))
	table.insert(connections, remote.OnServerEvent:Connect(handle))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player) states[player.UserId] = nil end))
	task.spawn(function()
		while running do
			poll()
			task.wait(0.5)
		end
	end)
end

function Tutorial.Destroy()
	running = false
	for _, c in connections do c:Disconnect() end
	for _, d in disconnects do d() end
	table.clear(connections); table.clear(disconnects); table.clear(states)
end

return Tutorial
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="178">
          <Properties>
            <string name="Name">WagerLedger</string>
            <string name="Source">--!strict
local Run=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Config=require(Shared.Config) :: any
local Store=require(script.Parent.ProfileStore)
local Journal=require(script.Parent.MatchJournal) :: any
local mock: {[string]: any}={}
local db: any
if Run:IsStudio() and not Config.Backend.StudioLiveData then
 db={UpdateAsync=function(_: any,key: string,fn: (any)-&gt;any): any
  local result=fn(Store.Copy(mock[key]));if result then mock[key]=Store.Copy(result) end;return Store.Copy(result)
 end}
else db=game:GetService("DataStoreService"):GetDataStore("AsuraSpectatorWagers_v1") end
return Journal.new(db,function(fn: ()-&gt;any): (boolean,any)
 local last: any=nil
 for n=1,4 do local ok,result=pcall(fn);if ok then return true,result end;last=result;if n&lt;4 then task.wait(n*0.25) end end
 return false,last
end,os.time)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="179">
          <Properties>
            <string name="Name">WagerService</string>
            <string name="Source">--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Rules=require(Shared.Shared.ArenaRules)
local Budget=require(Shared.Shared.IntentProtocol)
local Persistence=require(script.Parent.PersistenceService) :: any
local Characters=require(script.Parent.CharacterService)
local Ledger=require(script.Parent.WagerLedger) :: any
local Build=require(script.Parent.WagerWorld)
local remote=Shared.Net:WaitForChild("WagerIntent") :: RemoteEvent
local Service={}
local matches: {[string]: any}={}
local outcomes: {[string]: any}={}
local links: {RBXScriptConnection}={}
local budgets: {[number]: Budget.Bucket}={}
local busy: {[number]: boolean}={}
local root: Folder?=nil
local arena: any=nil
local running=false
local function near(id: number): boolean
 local e=Characters.GetActor(id);return e~=nil and not e.Duel and e.Fighter.State=="Idle" and Build.near(e.Root.Position)
end
local function settle(id: number,matchId: string,result: any)
 local payout=0;local changed=false
 local ok=Persistence.Transaction(id,function(p: any)
  local bet=p.arenaWagers[matchId];changed=bet~=nil and bet.State=="Pending"
  payout=Rules.settle(p,matchId,result.Winner,result.Refund==true)
 end)
 local player=Players:GetPlayerByUserId(id)
 if ok and changed and player then remote:FireClient(player,{action="Settlement",payout=payout,refund=result.Refund==true}) end
end
function Service.Recover(id: number)
 if busy[id] then return end;busy[id]=true
 local p=Persistence.Get(id)
 if p then for matchId,bet in p.arenaWagers do if bet.State=="Pending" then
  if matches[matchId] and matches[matchId].Phase~="Resolved" then continue end
  local ok,record=Ledger:Read(matchId)
  if ok and record and record.state~="Active" then
   settle(id,matchId,record.results or {Refund=true})
  end
 end end end
 busy[id]=nil
end
function Service.Begin(id: string,a: number,b: number,an: string,bn: string,starts: number,ring: string)
 if not running or ring~="Ring_SanctuaryPromenade" then return end
 local m={Id=id,A=a,B=b,AN=an,BN=bn,Starts=starts,Phase="Countdown",Ready=false};matches[id]=m
 local ok=Ledger:Create(id,{a,b},game.JobId)
 if not ok then matches[id]=nil;return end
 m.Ready=true
 if not running then Service.Resolve(id,nil,true) elseif outcomes[id] then Service.Resolve(id,outcomes[id].Winner,outcomes[id].Refund) end
end
function Service.Resolve(id: string,winner: number?,refund: boolean)
 local result={Winner=winner,Refund=refund};outcomes[id]=result
 local m=matches[id];if not m or not m.Ready then return end
 m.Phase="Resolved"
 local ok=Ledger:Finish(id,result)
 if not ok then
  if running then task.delay(3,function() Service.Resolve(id,winner,refund) end) end;return
 end
 matches[id]=nil;outcomes[id]=nil
 for _,player in Players:GetPlayers() do task.spawn(Service.Recover,player.UserId) end
end
local function panel(player: Player,message: string?)
 local list={};for _,m in matches do
  if m.Ready and m.Phase~="Resolved" then table.insert(list,{id=m.Id,a=m.A,b=m.B,an=m.AN,bn=m.BN,starts=m.Starts,open=workspace:GetServerTimeNow()&lt;m.Starts}) end
 end
 local p=Persistence.Get(player.UserId)
 remote:FireClient(player,{action="Panel",matches=list,qi=if p then p.qiEssence else 0,message=message})
end
local function handle(player: Player,p: any)
 if not running or type(p)~="table" or (p.action~="Refresh" and p.action~="Wager") then return end
 local fields=if p.action=="Refresh" then {action=true} else {action=true,match=true,fighter=true,amount=true}
 local count=0;for key in p do if not fields[key] then return end;count+=1 end
 if count~=(if p.action=="Refresh" then 1 else 4) then return end
 local id=player.UserId;local now=os.clock();local b=budgets[id] or {tokens=4,time=now};budgets[id]=b
 if not Budget.Take(b,now,1,2,4) or not near(id) or busy[id] then return end
 if p.action=="Refresh" then panel(player);return end
 if type(p.match)~="string" or #p.match&gt;64 or type(p.fighter)~="number" or not Rules.validWager(p.amount) then return end
 local m=matches[p.match]
 if not m or not m.Ready or m.Phase=="Resolved" or workspace:GetServerTimeNow()&gt;=m.Starts or (p.fighter~=m.A and p.fighter~=m.B) or id==m.A or id==m.B then return end
 busy[id]=true
 local ok,err=Persistence.Transaction(id,function(profile: any)
  assert(near(id) and m.Phase~="Resolved" and workspace:GetServerTimeNow()&lt;m.Starts,"Wagering has closed")
  local n=0;for _ in profile.arenaWagers do n+=1 end
  if n&gt;=480 then for key,bet in profile.arenaWagers do if bet.State=="Settled" then profile.arenaWagers[key]=nil end end end
  Rules.place(profile,m.Id,p.fighter,p.amount)
 end)
 busy[id]=nil
 if near(id) then panel(player,if ok then "Wager sealed · winners receive 1.8× the stake." else tostring(err)) end
end
function Service.Start(colosseum: any)
 assert(not running,"WagerService already started");running=true;arena=colosseum
 arena.SpectatorBegin=function(...: any) task.spawn(Service.Begin,...) end
 arena.SpectatorResult=function(...: any) task.spawn(Service.Resolve,...) end
 local folder,connection=Build.make(function(p: Player) if near(p.UserId) then panel(p) end end);root=folder;table.insert(links,connection)
 table.insert(links,remote.OnServerEvent:Connect(handle))
 table.insert(links,Players.PlayerRemoving:Connect(function(p: Player) budgets[p.UserId]=nil;busy[p.UserId]=nil end))
 task.spawn(function()
  while running do
   task.wait(5);if not running then break end
   for _,p in Players:GetPlayers() do task.spawn(Service.Recover,p.UserId) end
  end
 end)
end
function Service.Close(deadline: number?)
 running=false
 local endsAt=deadline or os.clock()+5
 repeat
  for id in matches do
   local result=outcomes[id] or {Refund=true}
   Service.Resolve(id,result.Winner,result.Refund)
  end
  if next(matches)==nil then break end
  task.wait(0.15)
 until os.clock()&gt;=endsAt
end
function Service.Destroy()
 Service.Close();if arena then arena.SpectatorBegin=nil;arena.SpectatorResult=nil end
 for _,c in links do c:Disconnect() end;table.clear(links)
 if root then root:Destroy();root=nil end;table.clear(budgets)
end
return Service
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="180">
          <Properties>
            <string name="Name">WagerWorld</string>
            <string name="Source">--!strict
local Definitions=require(game:GetService("ReplicatedStorage").AsurasPath.Shared.WorldDefinitions)
local InputMap=require(game:GetService("ReplicatedStorage").AsurasPath.Shared.InputMap)
local Build={}
-- Cosmetic load paths only: the original balcony, stair shaft, rail collision and wager interaction
-- below retain their exact dimensions and positions. The kit is optional for detached fixtures.
local function supports(root: Folder,c: any)
 local styled,kit=pcall(function() return require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript) end)
 local visual=Instance.new("Folder");visual.Name="BalconySupports";visual.Parent=root
 local function decor(name: string,size: Vector3,cf: CFrame,surface: string): BasePart
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Anchored=true
  p.CanCollide,p.CanQuery,p.CanTouch,p.CastShadow=false,false,false,true
  if styled then
   local s=kit.Surface[surface];p.Material,p.MaterialVariant,p.Color=s.Material,s.Variant,s.Color
  else
   p.Material=if surface=="Lacquer" or surface=="Timber" then Enum.Material.Wood else Enum.Material.Slate
   p.MaterialVariant="Asura"..surface;p.Color=if surface=="Lacquer" then Color3.fromRGB(91,37,32) else Color3.fromRGB(120,133,146)
  end
  p.Parent=visual;return p
 end
 local function beam(name: string,a: Vector3,b: Vector3,width: number,surface: string)
  decor(name,Vector3.new(width,width,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),surface)
 end
 local function mesh(name: string,cf: CFrame,scale: (number|Vector3)?): Model?
  if not styled then return nil end
  local model=kit.place(visual,name,cf,scale)
  if model then
   for _,p in model:GetDescendants() do
    if p:IsA("BasePart") then p.CanCollide,p.CanQuery,p.CanTouch=false,false,false end
   end
  end
  return model
 end
 for _,z in {-12,12} do
  -- The outer pair sits on masonry corbels rooted under the existing terrace lip.
  beam("BalconyStoneCorbel",Vector3.new(c.X+27,c.Y-3.3,c.Z+z),Vector3.new(c.X+35,c.Y-0.5,c.Z+z),1.8,"StoneDark")
  decor("BalconyBearing",Vector3.new(14,0.8,1.3),CFrame.new(c.X+30,c.Y+11.1,c.Z+z),"Timber")
  for _,x in {25,35} do
   local foot=CFrame.new(c.X+x,c.Y,c.Z+z)
   if not mesh("Column_Base",foot) then decor("BalconyStoneFoot",Vector3.new(2.1,0.9,2.1),foot*CFrame.new(0,0.45,0),"Stone") end
   if not mesh("Column_Lacquer",foot*CFrame.new(0,0.9,0),Vector3.new(1,0.93,1)) then
    decor("BalconyLacquerPost",Vector3.new(1.2,9.3,1.2),foot*CFrame.new(0,5.55,0),"Lacquer")
   end
   mesh("Bracket_Set",foot*CFrame.new(0,10.15,0),Vector3.new(0.62,0.45,0.62))
  end
 end
 -- This stringer is outside the full eight-stud stair shaft (x+26..34, z+18..40).
 beam("SpectatorStairStoneCheek",Vector3.new(c.X+35,c.Y+0.2,c.Z+40.5),Vector3.new(c.X+35,c.Y+11.25,c.Z+18),0.9,"StoneDark")
 if styled and kit.available() then
  for _,rail in root:GetChildren() do
   if rail:IsA("BasePart") and (rail.Name=="Balustrade" or rail.Name=="OuterRail") then
    local along=if rail.Size.X&gt;rail.Size.Z then Vector3.new(1,0,0) else Vector3.new(0,0,1)
    local length=math.max(rail.Size.X,rail.Size.Z)
    local a=rail.Position-along*length/2-Vector3.yAxis*rail.Size.Y/2
    local cf=kit.along(a,a+along*length,a)
    local n=math.max(1,math.round(length/6));local step=length/n
    for i=0,n do mesh("Rail_Post",cf*CFrame.new(i*step,0,0),Vector3.new(1,3/4.16,1)) end
    for i=1,n do mesh("Rail_Bay",cf*CFrame.new((i-0.5)*step,0,0),Vector3.new((step-0.86)/5.1,1,1)) end
    rail.Transparency=1
   end
  end
 end
end
function Build.make(open: (Player)-&gt;()): (Folder,RBXScriptConnection)
 local c=Definitions.Sanctuary.Promenade
 local root=Instance.new("Folder");root.Name="SpectatorBalcony";root.Parent=workspace
 local function part(name: string,size: Vector3,position: Vector3): Part
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.Position=position;p.Anchored=true;p.Material=Enum.Material.Slate
  p.Color=Color3.fromRGB(150,156,160);p.MaterialVariant="AsuraStone";p.Parent=root;return p
 end
 part("Balcony",Vector3.new(14,1,32),Vector3.new(c.X+30,c.Y+12,c.Z))
 for _,z in {-16,16} do part("Balustrade",Vector3.new(14,3,0.6),Vector3.new(c.X+30,c.Y+14,c.Z+z)) end
 part("OuterRail",Vector3.new(0.6,3,32),Vector3.new(c.X+37,c.Y+14,c.Z))
 for n=1,12 do part("Stair"..n,Vector3.new(8,1,2),Vector3.new(c.X+30,c.Y+n,c.Z+42-n*2)) end
 local brazier=part("WagerBrazier",Vector3.new(1,3,1),Vector3.new(c.X+30,c.Y+14,c.Z+8))
 brazier.Material=Enum.Material.Slate;brazier.Transparency=1
 local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Watch &amp; Wager";prompt.ObjectText="Colosseum Balcony"
 prompt.MaxActivationDistance=14;InputMap.applyPrompt(prompt);prompt.Parent=brazier
 supports(root,c)
 local styled,kit=pcall(function() return require(script.Parent:WaitForChild("SanctuaryKit") :: ModuleScript) end)
 if styled then
  local lamp=CFrame.new(c.X+30,c.Y+12.5,c.Z+8)
  if not kit.place(root,"Lantern_Stone",lamp) then kit.lanternFallback(root,lamp,false) end
  kit.glow(root,lamp*CFrame.new(0,3.35,0),Vector3.new(1.04,1.12,1.04),15,1.35)
 end
 return root,prompt.Triggered:Connect(open)
end
function Build.near(position: Vector3): boolean
 local c=Definitions.Sanctuary.Promenade
 return math.abs(position.X-(c.X+30))&lt;=12 and math.abs(position.Z-c.Z)&lt;=20 and position.Y&gt;=c.Y+11 and position.Y&lt;=c.Y+24
end
return table.freeze(Build)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="181">
          <Properties>
            <string name="Name">WeaponEffects</string>
            <string name="Source">--!strict
local Debris=game:GetService("Debris")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Combat=require(Shared.Simulation.CombatRules)
local Characters=require(script.Parent.CharacterService)
local Magic=require(script.Parent.MagicService)
local Geometry=require(script.Parent.SpellGeometry)
local Effects={}
local seen: {[number]: number}={}
local telegraphs: {[number]: number}={}
local disconnect: (() -&gt; ())?=nil
local removed: (() -&gt; ())?=nil
local function pull(e: any,point: Vector3)
 local delta=point-e.Root.Position;if delta.Magnitude&lt;0.1 then return end
 local endpoint=Geometry.endpoint(e.Root.Position,delta.Unit,delta.Magnitude)
 local attachment=Instance.new("Attachment");attachment.Parent=e.Root
 local velocity=Instance.new("LinearVelocity");velocity.Attachment0=attachment;velocity.RelativeTo=Enum.ActuatorRelativeTo.World
 velocity.VectorVelocity=(endpoint-e.Root.Position)/0.18;velocity.MaxForce=math.max(50000,e.Root.AssemblyMass*6000);velocity.Parent=e.Root
 Debris:AddItem(velocity,0.18);Debris:AddItem(attachment,0.2)
 local root=e.Root
 task.delay(0.18,function()
  if root.Parent and e.Root==root then local v=root.AssemblyLinearVelocity;root.AssemblyLinearVelocity=Vector3.new(0,v.Y,0) end
 end)
end
function Effects.Start()
 assert(not disconnect,"WeaponEffects already started")
 removed=Characters.OnEntityRemoved(function(id: number) seen[id]=nil;telegraphs[id]=nil end)
 disconnect=Characters.OnStep(function(now: number,_dt: number)
  for id,e in Characters.Entities() do
   local f=e.Fighter;local move=f.Move
   if move and move.Effect and f.State=="Startup" and telegraphs[id]~=f.MoveStart then
    telegraphs[id]=f.MoveStart
    Characters.Cue("SpellStartup",id,{spell=move.Effect,release=f.MoveStart+move.Timing.StartupSeconds,finish=f.MoveStart+move.Timing.TotalSeconds,position=e.Root.Position})
    if move.Effect=="FissureSlam" then e.Root.AssemblyLinearVelocity+=Vector3.new(0,24,0) end
   end
   if not move or f.State~="Active" or not move.Effect or seen[id]==f.MoveStart then continue end
   seen[id]=f.MoveStart
   if move.Effect=="Pull" or move.Effect=="Launch" then
    for _,target in Geometry.targets(e,e.Root.Position,move.Reach+f.ReachBonus) do
     local delta=target.Root.Position-e.Root.Position
     if delta.Magnitude&gt;0.1 and delta.Unit:Dot(e.Root.CFrame.LookVector)&gt;0.5 and not Combat.isInvulnerable(target.Fighter,now) then
      local outcome=Characters.ResolveWeaponHit(e.Id,target.Id)
      if outcome~="Hit" and outcome~="CounterHit" and outcome~="Armored" then break end
      if move.Effect=="Pull" and not target.Boss then
       pull(target,e.Root.Position+e.Root.CFrame.LookVector*4)
      elseif move.Effect=="Pull" then
       pull(e,target.Root.Position-delta.Unit*4)
      else target.Root.AssemblyLinearVelocity+=Vector3.new(0,40,0) end
      break
     end
    end
   else
    Magic.ReleaseArt(e,move.Effect,now)
   end
  end
 end)
end
function Effects.Destroy()
 if disconnect then disconnect();disconnect=nil end
 if removed then removed();removed=nil end
 table.clear(seen);table.clear(telegraphs)
end
return Effects
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="182">
          <Properties>
            <string name="Name">WeaponModels</string>
            <string name="Source">--!strict
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Weapons=require(Shared.Simulation.WeaponSchema)
local Models={}
local STEEL=Color3.fromRGB(164,176,178)
local JADE=Color3.fromRGB(81,221,205)
local function piece(parent: Instance,hand: BasePart,name: string,size: Vector3,offset: CFrame,color: Color3,shape: Enum.PartType?): Part
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=hand.CFrame*offset;p.Color=color;p.Material=Enum.Material.Metal
 p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
 if shape then p.Shape=shape end
 local weld=Instance.new("WeldConstraint");weld.Part0=hand;weld.Part1=p;weld.Parent=p;p.Parent=parent
 return p
end
function Models.attach(model: Model,id: string): boolean
 local old=model:FindFirstChild("ArsenalWeapon");if old then old:Destroy() end
 local w=Weapons.Weapons[id]
 if not w or table.find({"Unarmed","Jian","Dao","Guandao"},id) then return false end
 local hand=model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
 if not hand or not hand:IsA("BasePart") then return true end
 local folder=Instance.new("Folder");folder.Name="ArsenalWeapon";folder.Parent=model
 if id=="PrayerOfTheDefiled" then
  piece(folder,hand,"BronzeCenser",Vector3.new(1.8,1.8,1.8),CFrame.new(0,-3.3,-0.6),Color3.fromRGB(105,82,44),Enum.PartType.Ball)
  for n=1,6 do piece(folder,hand,"ChainLink",Vector3.new(0.15,0.35,0.15),CFrame.new(0,-n*0.45,-0.6),STEEL) end
 elseif w.Type=="TwinDaggers" then
  for _,name in {"RightHand","LeftHand"} do
   local limb=model:FindFirstChild(name);if limb and limb:IsA("BasePart") then
    piece(folder,limb,"ShadowSai",Vector3.new(0.12,0.2,2.3),CFrame.new(0,-0.1,-1.1),STEEL)
    piece(folder,limb,"SaiGuard",Vector3.new(1,0.15,0.15),CFrame.new(0,-0.1,-0.5),STEEL)
   end
  end
 elseif w.Type=="WarFan" then
  for n=-3,3 do piece(folder,hand,"FanRib",Vector3.new(0.16,0.14,2.4),CFrame.Angles(0,math.rad(n*14),0)*CFrame.new(0,0,-1.2),STEEL) end
 elseif w.Type=="Catalyst" then
  piece(folder,hand,"JadeStaff",Vector3.new(0.25,5,0.25),CFrame.new(0,-0.3,-0.5),Color3.fromRGB(75,63,47))
  local gem=piece(folder,hand,"FocusJade",Vector3.new(0.8,0.8,0.8),CFrame.new(0,2.4,-0.5),JADE,Enum.PartType.Ball);gem.Material=Enum.Material.Neon
 elseif w.Type=="ChainScythe" then
  piece(folder,hand,"SickleBlade",Vector3.new(2,0.18,0.4),CFrame.new(0.9,0,-1.8),STEEL)
  piece(folder,hand,"SickleGrip",Vector3.new(0.2,0.2,2),CFrame.new(0,0,-0.8),STEEL)
  for n=1,8 do piece(folder,hand,"WeightedChain",Vector3.new(0.14,0.35,0.14),CFrame.new(0,-n*0.4,0),STEEL) end
 else
  local bone=id=="CalamityBoneCleaver";local guandao=w.Type=="Guandao"
  piece(folder,hand,"GreatBlade",Vector3.new(0.25,if guandao then 0.6 else 1.2,if guandao then 7 else 6),CFrame.new(0,0,-3),if bone then Color3.fromRGB(194,175,138) else STEEL)
  piece(folder,hand,"CrossGuard",Vector3.new(0.3,2,0.2),CFrame.new(0,0,-0.7),Color3.fromRGB(125,98,45))
  if guandao then local edge=piece(folder,hand,"LightningEdge",Vector3.new(0.3,0.7,2),CFrame.new(0,0,-6),JADE);edge.Material=Enum.Material.Neon end
 end
 return true
end
-- Batch 14: the stock jian, dao and guandao were single blocks. Their fittings (guard, wrapped
-- grip, pommel and tassel; the guandao's moon blade and dragon mouth) are welded to that blade part,
-- so its length (the trail anchor and reach read) is unchanged and they leave with it.
function Models.dress(blade: BasePart, id: string)
 local z,y=blade.Size.Z*0.5,blade.Size.Y*0.5
 local GOLD,WRAP,TASSEL=Color3.fromRGB(176,140,64),Color3.fromRGB(40,30,26),Color3.fromRGB(150,30,34)
 local function fit(name: string,size: Vector3,offset: CFrame,color: Color3,shape: Enum.PartType?): Part
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=blade.CFrame*offset;p.Color=color;p.Material=Enum.Material.Metal
  p.Massless=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;if shape then p.Shape=shape end
  local weld=Instance.new("WeldConstraint");weld.Part0=blade;weld.Part1=p;weld.Parent=p;p.Parent=blade
  return p
 end
 if id=="Jian" or id=="Dao" then
  fit("Guard",Vector3.new(if id=="Dao" then 0.6 else 0.9,0.16,0.2),CFrame.new(0,0,z-0.8),GOLD,if id=="Dao" then Enum.PartType.Ball else nil)
  local grip=fit("GripWrap",Vector3.new(0.2,0.22,0.8),CFrame.new(0,0,z-0.35),WRAP);grip.Material=Enum.Material.Fabric
  fit("Pommel",Vector3.new(0.26,0.26,0.26),CFrame.new(0,0,z+0.08),GOLD,Enum.PartType.Ball)
  local cord=fit("Tassel",Vector3.new(0.1,0.7,0.1),CFrame.new(0,-0.35,z+0.12),TASSEL);cord.Material=Enum.Material.Fabric
  if id=="Dao" then fit("BackSpine",Vector3.new(blade.Size.X+0.06,0.1,blade.Size.Z-1.2),CFrame.new(0,y,-0.4),Color3.fromRGB(120,112,104)) end
 elseif id=="Guandao" then
  fit("MoonBlade",Vector3.new(0.18,1.1,2.2),CFrame.new(0,0.4,-z-0.8),Color3.fromRGB(176,182,188)).Shape=Enum.PartType.Wedge
  fit("DragonMouth",Vector3.new(0.4,0.42,0.6),CFrame.new(0,0,-z+0.2),GOLD)
  local tuft=fit("Tassel",Vector3.new(0.24,0.7,0.24),CFrame.new(0,-0.4,-z+0.6),TASSEL);tuft.Material=Enum.Material.Fabric
  fit("Counterweight",Vector3.new(0.32,0.32,0.5),CFrame.new(0,0,z),Color3.fromRGB(90,88,86))
 end
end
return table.freeze(Models)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="183">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source">--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/WorldService
-- Story Mode world rules: Incense Altar checkpoints, elixir gourd, death penalty bloodstains and
-- boss fog gates. Live session state (unbanked essence, gourd charges) is committed to the profile
-- through a per-player serial queue so progression writes never overlap or race a release.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local World = require(Shared.Shared.WorldDefinitions)
local InputMap = require(Shared.Shared.InputMap)
local Settings = require(Shared.Shared.CombatSettings) :: any
local Weapons = require(Shared.Simulation.WeaponSchema) :: any
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local AI = require(script.Parent:WaitForChild("AIService") :: ModuleScript)
local BossArenas = require(script.Parent.BossArenas)
local EncounterHandoff = require(script.Parent.EncounterHandoff)
local BossRules = require(Shared.Shared.BossEncounterRules)
local Progression = require(Shared.Shared.ProgressionRules)
local Persistence = require(script.Parent:WaitForChild("PersistenceService") :: ModuleScript) :: any
local ProfileStore = require(script.Parent:WaitForChild("ProfileStore") :: ModuleScript)
local Recovery = require(script.Parent:WaitForChild("RecoveryRules") :: ModuleScript)

type Altar = World.Altar
type FogGate = World.FogGate
type Souls = ProfileStore.Souls

type Commit = { Label: string, Run: (engine: any) -&gt; (boolean, string?) }

type Session = {
	UserId: number,
	Player: Player,
	Elixirs: number,
	MaxElixirs: number,
	Potency: number,
	ElixirsDirty: boolean,
	Unbanked: number,
	ActiveAltar: string,
	Altars: { [string]: boolean },
	Bosses: { [string]: boolean },
	Region: string?,
	Fight: string?,
	Stain: BasePart?,
	StainDeath: number,
	Queue: { Commit },
	Processing: boolean,
	LastFlush: number,
	Life: number,
	DeathLife: number,
}

type Fight = {
	Gate: FogGate,
	BossId: string,
	BossEntity: number,
	Participants: { [number]: boolean },
	StartedAt: number,
}

local WorldService = {}

local TAG_ALTAR = "AsuraAltar"
local TAG_STAIN = "AsuraBloodstain"
local INTERACT_RADIUS = 6
-- Fog-gate prompt reach; the Interact fallback below uses the same reach as each visible prompt
-- plus a latency slack, so a key press never acts on something whose prompt is out of range.
local GATE_RADIUS = 18
local PROMPT_SLACK = 2
local FLUSH_INTERVAL = 20
local GATE_INTERVAL = 6 -- ticks (10 Hz)
local BUSY_RETRIES = 40
local POTENCY_STEP = 0.04
-- Static level geometry joins WorldGeometry; CameraProbe collides with nothing else, so client
-- camera spherecasts cast as CameraProbe see walls and floors but never characters or effects.
local WORLD_GROUP = "WorldGeometry"
local PROBE_GROUP = "CameraProbe"

local sessions: { [number]: Session } = {}
local fights: { [string]: Fight } = {}
local altarParts: { [string]: BasePart } = {}
local gateParts: { [string]: BasePart } = {}
local connections: { RBXScriptConnection } = {}
local disconnectors: { () -&gt; () } = {}
local worldFolder: Folder? = nil
-- Other services' interactables (e.g. the Sanctuary blacksmith) answer the Interact intent so a
-- press beside them is acknowledged instead of reporting "nothing nearby".
type Interactable = (userId: number, position: Vector3) -&gt; (boolean?, string?)
local interactables: { Interactable } = {}
local tickCounter = 0
local running = false

-------------------------------------------------------------------------------------------------
-- Geometry helpers
-------------------------------------------------------------------------------------------------

local function toCFrame(p: World.Placement): CFrame
	return CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, math.rad(p.Yaw), 0)
end

local function vec(v: World.Vec3): Vector3
	return Vector3.new(v.X, v.Y, v.Z)
end

local function inBounds(bounds: World.Bounds, position: Vector3): boolean
	return World.contains(bounds, position.X, position.Y, position.Z)
end

local function material(name: string): Enum.Material
	local ok, value = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return if ok and value then value else Enum.Material.Slate
end

local function folder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = name
	created.Parent = parent
	return created
end

local function entityPosition(userId: number): Vector3?
	local e = Characters.GetEntity(userId)
	return if e then e.Root.Position else nil
end

-------------------------------------------------------------------------------------------------
-- Sessions and the serial commit queue
-------------------------------------------------------------------------------------------------

local function engine(): any
	return Persistence.Engine
end

local function souls(userId: number): Souls?
	local profile = Persistence.Get(userId)
	return if profile then profile.souls else nil
end

local function session(userId: number): Session?
	local existing = sessions[userId]
	if existing then
		return existing
	end
	local player = Players:GetPlayerByUserId(userId)
	local record = souls(userId)
	if not player or not record then
		return nil
	end
	local created: Session = {
		UserId = userId,
		Player = player,
		Elixirs = record.inventory.elixirs.charges,
		MaxElixirs = record.inventory.elixirs.max,
		Potency = record.inventory.elixirs.potency,
		ElixirsDirty = false,
		Unbanked = 0,
		ActiveAltar = record.world.activeAltar,
		Altars = table.clone(record.world.altars),
		Bosses = table.clone(record.world.bosses),
		Region = nil,
		Fight = nil,
		Stain = nil,
		StainDeath = 0,
		Queue = {},
		Processing = false,
		LastFlush = os.clock(),
		Life = 1,
		DeathLife = 0,
	}
	sessions[userId] = created
	player:SetAttribute("AsuraElixirs", created.Elixirs)
	player:SetAttribute("AsuraElixirsMax", created.MaxElixirs)
	player:SetAttribute("AsuraUnbanked", 0)
	return created
end

local function publish(s: Session)
	local record = souls(s.UserId)
	local player = s.Player
	if not player.Parent then
		return
	end
	player:SetAttribute("AsuraElixirs", s.Elixirs)
	player:SetAttribute("AsuraElixirsMax", s.MaxElixirs)
	player:SetAttribute("AsuraUnbanked", s.Unbanked)
	if record then
		player:SetAttribute("AsuraEssence", record.essence)
		player:SetAttribute("AsuraLevel", record.level)
  player:SetAttribute("AsuraMaxQi",ProfileStore.DeriveStats(record).MaxQi)
		player:SetAttribute("AsuraLevelCost", ProfileStore.LevelCost(record.level))
		player:SetAttribute("AsuraActiveAltar", record.world.activeAltar)
		player:SetAttribute("AsuraMainhand", record.inventory.mainhand)
		player:SetAttribute("AsuraOffhand", record.inventory.offhand)
		local forged = ProfileStore.ReinforceLevel(record, record.inventory.mainhand)
		player:SetAttribute("AsuraReinforce", forged)
		player:SetAttribute("AsuraReinforceCost", if forged &gt;= ProfileStore.ReinforceMax then 0 else ProfileStore.ReinforceCost(forged))
		local altars: { string } = {}
		for id in record.world.altars do
			table.insert(altars, id)
		end
		table.sort(altars)
		player:SetAttribute("AsuraAltars", table.concat(altars, ","))
		-- Read-only progress mirror for the client objective tracker; never read back by the server.
		local bosses: { string } = {}
		for id, defeated in s.Bosses do
			if defeated then table.insert(bosses, id) end
		end
		table.sort(bosses)
		player:SetAttribute("AsuraBosses", table.concat(bosses, ","))
		-- Six-sovereign ending flags (batch 22): Released / Remained / Crossed, read by the objective tracker.
		local story: { string } = {}
		for id, on in record.world.story or {} do
			if on then table.insert(story, id) end
		end
		table.sort(story)
		player:SetAttribute("AsuraStory", table.concat(story, ","))
		for _, name in ProfileStore.Attributes do
			player:SetAttribute("Asura" .. name, record.attributes[name])
		end
	end
end

local function processQueue(s: Session)
	if s.Processing then
		return
	end
	s.Processing = true
	task.spawn(function()
		while #s.Queue &gt; 0 do
			local commit = table.remove(s.Queue, 1) :: Commit
			local ok, err = false, "Profile is busy"
			for _ = 1, BUSY_RETRIES do
				ok, err = commit.Run(engine())
				if ok or err ~= "Profile is busy" then
					break
				end
				task.wait(0.25)
			end
			if not ok then
				warn(string.format("[WorldService] %s for %d failed: %s", commit.Label, s.UserId, tostring(err)))
			end
		end
		s.Processing = false
		if s.Player.Parent then
			publish(s)
		elseif sessions[s.UserId] == s then
			sessions[s.UserId] = nil
		end
	end)
end

local function enqueue(s: Session, label: string, run: (engine: any) -&gt; (boolean, string?))
	table.insert(s.Queue, { Label = label, Run = run })
	processQueue(s)
end

-- Banks unbanked essence and gourd charges. Returns immediately; work is serialised per player.
local function flush(s: Session)
	s.LastFlush = os.clock()
	if s.Unbanked &gt; 0 then
		local amount = s.Unbanked
		s.Unbanked = 0
		enqueue(s, "BankEssence", function(store: any): (boolean, string?)
			local ok, err = store:GrantEssence(s.UserId, amount)
			if not ok and err ~= "Profile is busy" then
				s.Unbanked += amount
			end
			return ok, err
		end)
	end
	if s.ElixirsDirty then
		s.ElixirsDirty = false
		local charges = s.Elixirs
		enqueue(s, "Elixirs", function(store: any): (boolean, string?)
			return store:SetElixirCharges(s.UserId, charges)
		end)
	end
end

-- Blocking flush used on leave/shutdown before the profile lease is released.
function WorldService.Flush(userId: number, timeout: number?)
	local s = sessions[userId]
	if not s then
		return
	end
	flush(s)
	local deadline = os.clock() + (timeout or 8)
	while (s.Processing or #s.Queue &gt; 0) and os.clock() &lt; deadline do
		task.wait(0.05)
	end
end

function WorldService.FlushAll(timeout: number?)
	local deadline = os.clock() + (timeout or 10)
	for _, s in sessions do
		flush(s)
	end
	repeat
		local busy = false
		for _, s in sessions do
			if s.Processing or #s.Queue &gt; 0 then
				busy = true
			end
		end
		if busy then
			task.wait(0.05)
		end
	until not busy or os.clock() &gt;= deadline
end

-------------------------------------------------------------------------------------------------
-- World construction
-------------------------------------------------------------------------------------------------

local function registerGroups()
	for _, name in { WORLD_GROUP, PROBE_GROUP } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	for _, group in PhysicsService:GetRegisteredCollisionGroups() do
		PhysicsService:CollisionGroupSetCollidable(PROBE_GROUP, group.name, group.name == WORLD_GROUP)
	end
end

local function markGeometry(container: Instance)
	local function mark(instance: Instance)
		if instance:IsA("BasePart") and instance.Anchored and instance:FindFirstAncestorOfClass("Model") == nil then
			instance.CollisionGroup = WORLD_GROUP
		elseif instance:IsA("BasePart") and instance.Anchored then
			local model = instance:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") == nil then
				instance.CollisionGroup = WORLD_GROUP
			end
		end
	end
	for _, descendant in container:GetDescendants() do
		mark(descendant)
	end
	table.insert(connections, container.DescendantAdded:Connect(mark))
end

local function buildGreybox(root: Folder)
	local greybox = folder("Greybox", root)
	for _, id in World.RegionOrder do
		local region = World.Regions[id]
		if Workspace:FindFirstChild(region.MapFolder, true) == nil and greybox:FindFirstChild(id) == nil then
			local bounds = region.Bounds
			local floor = Instance.new("Part")
			floor.Name = id
			floor.Anchored = true
			floor.Size = Vector3.new(bounds.Size.X, 4, bounds.Size.Z)
			floor.CFrame = CFrame.new(bounds.Center.X, -2, bounds.Center.Z)
			floor.Material = material(region.Greybox.Material)
			floor.Color = Color3.fromRGB(region.Greybox.Color[1], region.Greybox.Color[2], region.Greybox.Color[3])
			floor.TopSurface = Enum.SurfaceType.Smooth
			floor:SetAttribute("AsuraRegion", id)
			floor.Parent = greybox
		end
	end
end

-- An authored part named AltarAnchor_&lt;id&gt; (e.g. the Sanctuary bonfire plinth) replaces the stock
-- censer: the rest prompt mounts on it and it becomes the altar's reference point.
local function anchoredAltar(altar: Altar): ProximityPrompt?
	local anchor = Workspace:FindFirstChild("AltarAnchor_" .. altar.Id, true)
	if not anchor or not anchor:IsA("BasePart") then
		return nil
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RestPrompt"
	prompt.ActionText = "Rest"
	prompt.ObjectText = altar.Name
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = altar.Radius
	prompt.RequiresLineOfSight = false
	InputMap.applyPrompt(prompt)
	prompt.Parent = anchor
	anchor:SetAttribute("AltarId", altar.Id)
	CollectionService:AddTag(anchor, TAG_ALTAR)
	altarParts[altar.Id] = anchor
	return prompt
end

local function buildAltar(altar: Altar, parent: Folder): ProximityPrompt
	local authored = anchoredAltar(altar)
	if authored then
		return authored
	end
	local model = Instance.new("Model")
	model.Name = "IncenseAltar_" .. altar.Id
	local base = Instance.new("Part")
	base.Name = "Base"
	base.Anchored = true
	base.Size = Vector3.new(4, 1.5, 4)
	base.CFrame = toCFrame(altar.Placement) * CFrame.new(0, 0.75, 0)
	base.Material = Enum.Material.Slate
	base.Color = Color3.fromRGB(64, 58, 54)
	base.Parent = model
	local censer = Instance.new("Part")
	censer.Name = "Censer"
	censer.Anchored = true
	censer.CanCollide = false
	censer.Shape = Enum.PartType.Cylinder
	censer.Size = Vector3.new(0.8, 1.6, 1.6)
	censer.CFrame = base.CFrame * CFrame.new(0, 1.15, 0) * CFrame.Angles(0, 0, math.rad(90))
	censer.Material = Enum.Material.Metal
	censer.Color = Color3.fromRGB(122, 92, 46)
	censer.Parent = model
	local incense = Instance.new("Part")
	incense.Name = "Incense"
	incense.Anchored = true
	incense.CanCollide = false
	incense.Size = Vector3.new(0.12, 1.8, 0.12)
	incense.CFrame = base.CFrame * CFrame.new(0, 2.4, 0)
	incense.Material = Enum.Material.Neon
	incense.Color = Color3.fromRGB(255, 140, 60)
	incense.Parent = model
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 80)
	light.Range = 14
	light.Brightness = 1.6
	light.Parent = incense
	local smoke = Instance.new("Smoke")
	smoke.Size = 0.4
	smoke.RiseVelocity = 2
	smoke.Opacity = 0.08
	smoke.Color = Color3.fromRGB(200, 196, 190)
	smoke.Parent = incense
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RestPrompt"
	prompt.ActionText = "Rest"
	prompt.ObjectText = altar.Name
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = altar.Radius
	prompt.RequiresLineOfSight = false
	InputMap.applyPrompt(prompt)
	prompt.Parent = base
	model.PrimaryPart = base
	model:SetAttribute("AltarId", altar.Id)
	CollectionService:AddTag(model, TAG_ALTAR)
	model.Parent = parent
	altarParts[altar.Id] = base
	return prompt
end

local function buildGate(gate: FogGate, parent: Folder)
	local wall = Instance.new("Part")
	wall.Name = "FogGate_" .. gate.Id
	wall.Anchored = true
	wall.CanCollide = false
	wall.CanQuery = false
	wall.CanTouch = false
	wall.Size = vec(gate.Size)
	wall.CFrame = toCFrame(gate.Placement)
	wall.Material = Enum.Material.ForceField
	wall.Color = Color3.fromRGB(220, 214, 200)
	wall.Transparency = 0.45
	wall:SetAttribute("Sealed", false)
	wall:SetAttribute("Boss", gate.Boss)
	wall.Parent = parent
	gateParts[gate.Id] = wall
end

local function setGate(gateId: string, sealed: boolean)
	BossArenas.seal(gateId, sealed)
	local wall = gateParts[gateId]
	if not wall then
		return
	end
	wall.CanCollide = sealed
	wall.Transparency = if sealed then 0.1 else 0.45
	wall.Color = if sealed then Color3.fromRGB(218, 181, 88) else Color3.fromRGB(220, 214, 200)
	wall:SetAttribute("Sealed", sealed)
end

-------------------------------------------------------------------------------------------------
-- Bloodstains
-------------------------------------------------------------------------------------------------

local function destroyStain(s: Session)
	if s.Stain then
		s.Stain:Destroy()
		s.Stain = nil
	end
	s.StainDeath = 0
	s.Player:SetAttribute("AsuraBloodstain", nil)
end

local recoverStain: (s: Session) -&gt; (boolean, string)

local function placeStain(s: Session, stain: ProfileStore.Bloodstain)
	destroyStain(s)
	local root = worldFolder
	if not root then
		return
	end
	local part = Instance.new("Part")
	part.Name = "Bloodstain_" .. s.UserId
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.15, 4, 4)
	part.CFrame = CFrame.new(stain.x, stain.y - 2.8, stain.z) * CFrame.Angles(0, 0, math.rad(90))
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(150, 12, 18)
	part.Transparency = 0.25
	part:SetAttribute("Owner", s.UserId)
	part:SetAttribute("Essence", stain.essence)
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(200, 30, 30)
	glow.Range = 10
	glow.Parent = part
 local attachment=Instance.new("Attachment");attachment.Parent=part
 local wraith=Instance.new("ParticleEmitter");wraith.Name="CrimsonWraith";wraith.Texture=require(Shared.Shared.PresentationAssets).Textures.Smoke;wraith.Enabled=wraith.Texture~=""
 wraith.Color=ColorSequence.new(Color3.fromRGB(205,24,42));wraith.Lifetime=NumberRange.new(1.2,2.2);wraith.Rate=12
 wraith.Speed=NumberRange.new(1,2);wraith.LightEmission=0.7;wraith.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.4),NumberSequenceKeypoint.new(0.5,1.5),NumberSequenceKeypoint.new(1,0)})
 wraith.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.4),NumberSequenceKeypoint.new(1,1)});wraith.Parent=attachment
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Recover Essence"
	prompt.ObjectText = s.Player.DisplayName .. "'s Bloodstain"
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = INTERACT_RADIUS
	prompt.RequiresLineOfSight = false
	InputMap.applyPrompt(prompt)
	prompt.Parent = part
	table.insert(connections, prompt.Triggered:Connect(function(player: Player)
		if player.UserId == s.UserId then
			recoverStain(s)
		end
	end))
	CollectionService:AddTag(part, TAG_STAIN)
	part.Parent = folder("Bloodstains", root)
	s.Stain = part
	s.StainDeath = stain.death
	s.Player:SetAttribute("AsuraBloodstain", Vector3.new(stain.x, stain.y, stain.z))
end

recoverStain = function(s: Session): (boolean, string)
	local part = s.Stain
	local position = entityPosition(s.UserId)
	if not part or not position or (position - part.Position).Magnitude &gt; INTERACT_RADIUS + 3 then
		return false, "NoBloodstain"
	end
	local death = s.StainDeath
	destroyStain(s)
	enqueue(s, "RecoverBloodstain", function(store: any): (boolean, string?)
		local ok, err, amount = store:RecoverBloodstain(s.UserId, death)
		if ok then
			Characters.Cue("EssenceRecovered", s.UserId, { amount = amount })
		end
		return ok, err
	end)
	return true, "Recovered"
end

local function onPlayerDeath(s: Session)
	local e = Characters.GetEntity(s.UserId)
	if not e or not Recovery.claimDeath(s) then
		return
	end
	local position = e.Root.Position
	local region = World.regionAt(position.X, position.Y, position.Z) or s.Region or World.startingAltar().Region
	local unbanked = s.Unbanked
	s.Unbanked = 0
	-- The previous bloodstain is forfeit the moment a new death occurs.
	destroyStain(s)
	enqueue(s, "RecordDeath", function(store: any): (boolean, string?)
		local ok, err, dropped = store:RecordDeath(s.UserId, region, position.X, position.Y, position.Z, unbanked)
		if ok then
			local record = souls(s.UserId)
			local stain = record and record.world.bloodstain
			if stain and dropped &gt; 0 then
				placeStain(s, stain)
			end
			Characters.Cue("EssenceLost", s.UserId, { amount = dropped })
		end
		return ok, err
	end)
	s.Elixirs = s.MaxElixirs
	s.ElixirsDirty = true
	local altar = World.Altars[s.ActiveAltar] or World.startingAltar()
	task.delay(Settings.Respawn.PlayerDelay, function()
		if running then
			AI.RespawnRegion(altar.Region, true)
		end
	end)
end

-------------------------------------------------------------------------------------------------
-- Altars, elixirs, progression
-------------------------------------------------------------------------------------------------

local function nearestAltar(position: Vector3): (Altar?, number)
	local best: Altar? = nil
	local bestDistance = math.huge
	for id, altar in World.Altars do
		local part = altarParts[id]
		if part then
			local distance = (part.Position - position).Magnitude
			if distance &lt; bestDistance then
				best, bestDistance = altar, distance
			end
		end
	end
	return best, bestDistance
end

local function restAt(s: Session, altar: Altar): (boolean, string)
	if s.Fight then
		return false, "InBossFight"
	end
	if Characters.IsInDuel(s.UserId) then
		return false, "InDuel"
	end
	if AI.IsHunting(s.UserId) then
		return false, "EnemiesNearby"
	end
	local position = entityPosition(s.UserId)
	local part = altarParts[altar.Id]
	if not position or not part or (position - part.Position).Magnitude &gt; altar.Radius + 2 then
		return false, "TooFar"
	end
	-- The proximity prompt and the Interact intent can both fire for one press; resting is idempotent.
	local fighter = Characters.GetFighter(s.UserId)
	if fighter and fighter.State == "RestingAtShrine" then
		return true, "Resting"
	end
	local ok, reason = Characters.Rest(s.UserId)
	if not ok or reason == "Rose" then
		return ok, reason
	end
	s.ActiveAltar = altar.Id
	s.Altars[altar.Id] = true
	s.Elixirs = s.MaxElixirs
	s.ElixirsDirty = false
	Characters.SetRespawnPoint(s.UserId, toCFrame(altar.Spawn))
	AI.RespawnRegion(altar.Region, true)
	Characters.Cue("AltarRest", s.UserId, { altar = altar.Id, name = altar.Name })
	flush(s)
	enqueue(s, "ActivateAltar", function(store: any): (boolean, string?)
		return store:ActivateAltar(s.UserId, altar.Id, true, true)
	end)
	return true, "Rest"
end

local function nearAltar(s: Session): Altar?
	local position = entityPosition(s.UserId)
	if not position then
		return nil
	end
	local altar, distance = nearestAltar(position)
	if altar and distance &lt;= altar.Radius + 2 and s.Altars[altar.Id] then
		return altar
	end
	return nil
end

local function drink(s: Session): (boolean, string)
	if s.Elixirs &lt;= 0 then
		return false, "GourdEmpty"
	end
	local ok, reason = Characters.TryHeal(s.UserId, Settings.Elixir.HealFraction + s.Potency * POTENCY_STEP)
	if not ok then
		-- Nothing below the ceiling to restore: the charge is kept; say so on every press.
		if reason == "FullHealth" or reason == "AtCeiling" then
			Characters.Cue("HealRefused", s.UserId, { reason = reason, charges = s.Elixirs })
		end
		return false, reason
	end
	s.Elixirs -= 1
	s.ElixirsDirty = true
	s.Player:SetAttribute("AsuraElixirs", s.Elixirs)
	return true, "Drink"
end

local function refreshStats(userId: number)
	local record = souls(userId)
	if record then
		local stats = ProfileStore.DeriveStats(record)
		Characters.ApplyStats(userId, stats, false)
	end
end

local function levelUp(s: Session, attribute: string): (boolean, string)
	if table.find(ProfileStore.Attributes, attribute :: any) == nil then
		return false, "UnknownAttribute"
	end
	if not nearAltar(s) then
		return false, "NotAtAltar"
	end
	flush(s)
	enqueue(s, "LevelUp", function(store: any): (boolean, string?)
		local ok, err = store:LevelAttribute(s.UserId, attribute)
		if ok then
			refreshStats(s.UserId)
			Characters.Cue("LevelUp", s.UserId, { attribute = attribute })
		elseif err == "Not enough essence" or err == "Attribute at maximum" or err == "Level refused" then
			Characters.Cue("LevelRefused", s.UserId, { reason = err })
			return true, nil
		end
		return ok, err
	end)
	return true, "LevelQueued"
end

-- Travel between activated altars: only while at an activated altar, then rest at the destination.
local function travel(s: Session, altarId: string): (boolean, string)
	local destination = World.Altars[altarId]
	if not destination or not s.Altars[altarId] then
		return false, "AltarNotKindled"
	end
	if s.Fight then
		return false, "InBossFight"
	end
	if AI.IsHunting(s.UserId) then
		return false, "EnemiesNearby"
	end
	local origin = nearAltar(s)
	if not origin then
		return false, "NotAtAltar"
	end
	if origin.Id == altarId then
		return false, "AlreadyHere"
	end
	-- Land within resting reach, facing the altar, so the rest below can set the checkpoint.
	local spawn, part = toCFrame(destination.Spawn), altarParts[altarId]
	local at = if part then Recovery.arrival(spawn.Position, part.Position, destination.Radius) else spawn.Position
	Characters.Teleport(s.UserId, if part and at ~= spawn.Position then CFrame.lookAt(at, Vector3.new(part.Position.X, at.Y, part.Position.Z)) else spawn)
	Characters.Cue("AltarTravel", s.UserId, { from = origin.Id, to = altarId })
	local fighter = Characters.GetFighter(s.UserId)
	if fighter and fighter.State == "RestingAtShrine" then
		fighter.State = "Idle"
		fighter.StateEnd = math.huge
	end
	return restAt(s, destination)
end

local function swap(s: Session): (boolean, string)
	local record = souls(s.UserId)
	if not record then
		return false, "Unavailable"
	end
	local inventory = record.inventory
	if inventory.offhand == "None" then
		return false, "NoOffhand"
	end
	local main, off = inventory.offhand, inventory.mainhand
	local ok, reason = Characters.EquipWeapon(s.UserId, main :: any)
	if not ok then
		return false, reason
	end
	enqueue(s, "Swap", function(store: any): (boolean, string?)
		local ok, err = store:EquipLoadout(s.UserId, main, off)
		if ok then
			-- Reinforcement follows the weapon in hand.
			Characters.RefreshProgression(s.UserId)
		end
		return ok, err
	end)
	return true, main
end

-------------------------------------------------------------------------------------------------
-- Boss fog gates
-------------------------------------------------------------------------------------------------

local function endFight(gateId: string, victory: boolean)
	local fight = fights[gateId]
	if not fight then
		return
	end
	fights[gateId] = nil
	setGate(gateId, false)
	EncounterHandoff.forget(fight.BossId) -- no cutscene lock outlives its fight
	local boss = World.Bosses[fight.BossId]
	for userId in fight.Participants do
		local s = sessions[userId]
		if s then
			s.Fight = nil
			s.Player:SetAttribute("AsuraEncounter", nil)
			if victory then
				s.Bosses[fight.BossId] = true
				publish(s)
				flush(s)
				enqueue(s, "BossDefeat", function(store: any): (boolean, string?)
					return store:RecordBossDefeat(userId, fight.BossId, boss.Essence)
				end)
			end
		end
	end
	local participants = {}
	for userId in fight.Participants do table.insert(participants, userId) end
	if victory then BossArenas.loot(Vector3.new(boss.Arena.Center.X, 3, boss.Arena.Center.Z), boss.Essence) end
	Characters.Cue(if victory then "BossDefeated" else "BossReset", fight.BossEntity,
		{ boss = fight.BossId, gate = gateId, participants = participants, banner = boss.Victory or "GREAT FOE VANQUISHED", essence = boss.Essence })
	if not victory then
		AI.DespawnBoss(fight.BossId)
	end
end

local function startFight(gate: FogGate, entrants: { number })
	local boss = World.Bosses[gate.Boss]
	local participants: { [number]: boolean } = {}
	local list: { number } = {}
	for _, userId in entrants do
		participants[userId] = true
		table.insert(list, userId)
	end
	for userId, s in sessions do
		local position = entityPosition(userId)
		local e = Characters.GetEntity(userId)
		if not participants[userId] and e and e.Fighter.State ~= "KO" and not e.Respawning and not Characters.IsInDuel(userId)
			and position and inBounds(boss.Arena, position) and not s.Bosses[boss.Id] and not s.Fight then
			participants[userId] = true
			table.insert(list, userId)
		end
	end
	local entity = AI.SpawnBoss(boss.Id, list)
	if not entity then
		return
	end
	fights[gate.Id] = { Gate = gate, BossId = boss.Id, BossEntity = entity, Participants = participants, StartedAt = Characters.Now() }
	for userId in participants do
		local s = sessions[userId]
		if s then
			s.Fight = gate.Id
			s.Player:SetAttribute("AsuraEncounter", boss.Id)
		end
	end
	setGate(gate.Id, true)
	Characters.Cue("FogGateSealed", entity, { gate = gate.Id, boss = boss.Id, title = boss.Title, participants = list })
end

local function traverseGate(userId: number, gate: FogGate): (boolean, string)
	local s, e = session(userId), Characters.GetEntity(userId)
	if not s or not e or e.Fighter.State == "KO" or e.Respawning then return false, "Unavailable" end
	if s.Fight or Characters.IsInDuel(userId) then return false, "InBossFight" end
	if s.Bosses[gate.Boss] then return false, "BossFelled" end
	if fights[gate.Id] then return false, "ArenaOccupied" end
	if (e.Root.Position - toCFrame(gate.Placement).Position).Magnitude &gt; 28 then return false, "TooFar" end
	Characters.Teleport(userId, toCFrame(gate.Inside))
	startFight(gate, { userId })
	if not fights[gate.Id] then
		Characters.Teleport(userId, toCFrame(gate.Outside))
		return false, "Unavailable"
	end
	return true, "FogTraversed"
end

local function updateGates()
	for gateId, gate in World.FogGates do
		local boss = World.Bosses[gate.Boss]
		local fight = fights[gateId]
		if fight == nil then
			local entrants: { number } = {}
			for userId, s in sessions do
				local e = Characters.GetEntity(userId)
				if e and e.Fighter.State ~= "KO" and not s.Bosses[boss.Id] and not s.Fight and not Characters.IsInDuel(userId)
					and inBounds(gate.Trigger, e.Root.Position) then
					table.insert(entrants, userId)
				end
			end
			if #entrants &gt; 0 then
				startFight(gate, entrants)
			end
		else
			local living = 0
			for userId in fight.Participants do
				local e = Characters.GetEntity(userId)
				local s = sessions[userId]
				if not s or not e or e.Fighter.State == "KO" or e.Respawning then
					fight.Participants[userId] = nil
					EncounterHandoff.release(userId)
					if s then
						s.Fight = nil
						s.Player:SetAttribute("AsuraEncounter", nil)
						Characters.Cue("BossParticipantLeft", userId, { boss = boss.Id })
					end
				else
					living += 1
					if not inBounds(boss.Arena, e.Root.Position) then
						Characters.Teleport(userId, toCFrame(gate.Inside))
					end
				end
			end
			for userId, s in sessions do
				if not fight.Participants[userId] then
					local position = entityPosition(userId)
					if position and inBounds(boss.Arena, position) and s.Fight == nil then
						Characters.Teleport(userId, toCFrame(gate.Outside))
					end
				end
			end
			local remaining: { number } = {}
			for userId in fight.Participants do
				table.insert(remaining, userId)
			end
			AI.SetBossTargets(fight.BossId, remaining)
			if BossRules.lifecycle(living, false, AI.GetBossEntity(fight.BossId) ~= nil) == "Reset" then
				endFight(gateId, false)
			end
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Event wiring
-------------------------------------------------------------------------------------------------

local function onEvent(event: any, _point: Vector3?)
	if event.Kind ~= "KO" then
		return
	end
	local victimSession = sessions[event.Target]
	if victimSession then
		if not Characters.IsInDuel(event.Target) then
			onPlayerDeath(victimSession)
		end
		return
	end
 local agent = AI.GetAgent(event.Target)
 if not agent or agent.Essence &lt;= 0 then return end -- the Sparring Phantom pays nothing (no farming)
 local killer=sessions[event.Source]
 if killer then
  local fighter=Characters.GetFighter(event.Source)
  local weapon=if fighter then fighter.Weapon else "Jian"
  enqueue(killer,"WeaponMastery",function(store: any): (boolean,string?)
   local unlocked=false
   local ok,err=store:Transaction(killer.UserId,function(p: any)
    local rank=Progression.masteryRank(p.weaponMastery[weapon] or 0)
    Progression.mastery(p,weapon,if agent.Kind=="Mob" then 30 else 250)
    unlocked=rank&lt;5 and Progression.masteryRank(p.weaponMastery[weapon] or 0)&gt;=5
    local m=p.inventory.Materials;m.SpiritIronOre=math.min(9007199254740991,(m.SpiritIronOre or 0)+1)
   end)
   if ok then
    Characters.RefreshProgression(killer.UserId)
    if unlocked then Characters.Cue("SignatureUnlocked",killer.UserId,{weapon=weapon}) end
   end
   return ok,err
  end)
  if agent.Kind=="Mob" then
   killer.Unbanked+=agent.Essence;killer.Player:SetAttribute("AsuraUnbanked",killer.Unbanked)
  end
 end
end

local function onBossDefeated(bossId: string, _entityId: number)
	for gateId, fight in fights do
		if fight.BossId == bossId then
			endFight(gateId, true)
		end
	end
end

local function onPlayerAdded(id: number, kind: Characters.EntityKind)
	if kind ~= "Player" then
		return
	end
	local s = session(id)
	if not s then
		return
	end
	local record = souls(id)
	local stain = record and record.world.bloodstain
	if stain and s.Stain == nil then
		placeStain(s, stain)
	end
	publish(s)
end

-- Every admission (respawn or rejoin) opens a new life and refreshes region and resource state.
local function onCharacterSpawned(id: number, kind: Characters.EntityKind)
	local s = if kind == "Player" then session(id) else nil
	if not s then
		return
	end
	Recovery.spawned(s)
	-- This runs inside CharacterAdded, before the engine parents the new body, so the live lookup is
	-- still nil; the placed root already stands at the wake point. A nil here cleared the region and
	-- replayed the region banner on every respawn.
	local placed = Characters.Entities()[id]
	local position = if placed then placed.Root.Position else nil
	local region = if position then World.regionAt(position.X, position.Y, position.Z) else nil
	if region ~= s.Region then
		s.Region = region
		s.Player:SetAttribute("AsuraRegion", region)
	end
	publish(s)
end

local function hooks(): Characters.Hooks
	return {
		RespawnPoint = function(userId: number): CFrame?
			local s = session(userId)
			local altar = if s then World.Altars[s.ActiveAltar] else nil
			return toCFrame((altar or World.startingAltar()).Spawn)
		end,
		Stats = function(userId: number): any
			local record = souls(userId)
			return if record then ProfileStore.DeriveStats(record) else nil
		end,
		Loadout = function(userId: number): (string?, string?)
			local record = souls(userId)
			if not record then
				return nil, nil
			end
			return record.inventory.mainhand, record.inventory.offhand
		end,
		CanEquip = function(userId: number, weapon: string): boolean
			local record = souls(userId)
			return record ~= nil and record.inventory.weapons[weapon] == true and Weapons.Weapons[weapon] ~= nil
		end,
		Skip = function(userId: number): (boolean, string)
			return EncounterHandoff.skip(userId)
		end,
		Rest = function(userId: number): (boolean, string)
			local s = session(userId)
			local position = entityPosition(userId)
			if not s or not position then
				return false, "Unavailable"
			end
			local altar = nearestAltar(position)
			if not altar then
				return false, "NoAltar"
			end
			return restAt(s, altar)
		end,
		Heal = function(userId: number): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return drink(s)
		end,
		Interact = function(userId: number): (boolean, string)
			local s = session(userId)
			local position = entityPosition(userId)
			if not s or not position then
				return false, "Unavailable"
			end
			local part = s.Stain
			if part and (position - part.Position).Magnitude &lt;= INTERACT_RADIUS + PROMPT_SLACK then
				return recoverStain(s)
			end
			for _, gate in World.FogGates do
				local gatePart = gateParts[gate.Id]
				if gatePart and (position - gatePart.Position).Magnitude &lt;= GATE_RADIUS + PROMPT_SLACK then return traverseGate(userId, gate) end
			end
			local altar, distance = nearestAltar(position)
			if altar and distance &lt;= altar.Radius + PROMPT_SLACK then
				return restAt(s, altar)
			end
			for _, handler in interactables do
				local ok, handled, reason = pcall(handler, userId, position)
				if ok and handled ~= nil then
					return handled, reason or "Interacted"
				end
			end
			return false, "NothingNearby"
		end,
		LevelUp = function(userId: number, attribute: string): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return levelUp(s, attribute)
		end,
		Swap = function(userId: number): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return swap(s)
		end,
		Travel = function(userId: number, altarId: string): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return travel(s, altarId)
		end,
	}
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function WorldService.Start()
	assert(not running, "WorldService already started")
	running = true
	local root = Workspace:FindFirstChild(Config.Names.Root) or Instance.new("Folder")
	if not root.Parent then
		root.Name = Config.Names.Root
		root.Parent = Workspace
	end
	local worldRoot = folder("World", root)
	worldFolder = worldRoot
	registerGroups()
	buildGreybox(worldRoot)
	local altarsFolder = folder("Altars", worldRoot)
	for id, altar in World.Altars do
		local prompt = buildAltar(altar, altarsFolder)
		table.insert(connections, prompt.Triggered:Connect(function(player: Player)
			local s = session(player.UserId)
			if s then
				local ok, reason = restAt(s, World.Altars[id])
				player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
			end
		end))
	end
	BossArenas.build(worldRoot)
	local gatesFolder = folder("FogGates", worldRoot)
	for _, gate in World.FogGates do
		buildGate(gate, gatesFolder)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText, prompt.ObjectText, prompt.HoldDuration = "Traverse the Mist", World.Bosses[gate.Boss].Name, 0.35
		InputMap.applyPrompt(prompt)
		prompt.MaxActivationDistance, prompt.Parent = GATE_RADIUS, gateParts[gate.Id]
		table.insert(connections, prompt.Triggered:Connect(function(player: Player) traverseGate(player.UserId, gate) end))
	end
	markGeometry(worldRoot)
	local arena = root:FindFirstChild(Config.Names.Arena)
	if arena then
		markGeometry(arena)
	end
	for _, id in World.RegionOrder do
		local map = Workspace:FindFirstChild(World.Regions[id].MapFolder, true)
		if map then
			markGeometry(map)
		end
	end
	pcall(function()
		(Workspace.Terrain :: any).CollisionGroup = WORLD_GROUP
	end)

	Characters.SetHooks(hooks())
	table.insert(disconnectors, Characters.Subscribe(onEvent))
	table.insert(disconnectors, Characters.OnEntityAdded(onPlayerAdded))
	table.insert(disconnectors, Characters.OnCharacterSpawned(onCharacterSpawned))
	table.insert(disconnectors, AI.OnBossDefeated(onBossDefeated))
	table.insert(disconnectors, Characters.OnStep(function(_now: number, _dt: number)
		tickCounter += 1
		if tickCounter % GATE_INTERVAL == 0 then
			updateGates()
		end
		if tickCounter % 60 == 0 then
			local clock = os.clock()
			for userId, s in sessions do
				local position = entityPosition(userId)
				if position then
					local region = World.regionAt(position.X, position.Y, position.Z)
					if region ~= s.Region then
						s.Region = region
						s.Player:SetAttribute("AsuraRegion", region)
					end
				end
				if clock - s.LastFlush &gt;= FLUSH_INTERVAL then
					flush(s)
				end
			end
		end
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		local s = sessions[player.UserId]
		if not s then
			return
		end
		for gateId, fight in fights do
			if fight.Participants[player.UserId] then
				fight.Participants[player.UserId] = nil
				if next(fight.Participants) == nil then
					endFight(gateId, false)
				end
			end
		end
		task.defer(function()
			if s.Stain then
				s.Stain:Destroy()
				s.Stain = nil
			end
			if not s.Processing and #s.Queue == 0 then
				sessions[player.UserId] = nil
			end
		end)
	end))

	-- Rig creation yields on asset loads; populate regions off the startup path.
	task.spawn(function()
		for _, id in World.RegionOrder do
			for _, entry in World.spawnsIn(id) do
				if running then
					AI.SpawnMob(entry.Id)
				end
			end
		end
	end)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player.UserId, "Player")
	end
end

function WorldService.Destroy()
	running = false
	for _, disconnect in disconnectors do
		disconnect()
	end
	table.clear(disconnectors)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for gateId in fights do
		endFight(gateId, false)
	end
	for _, s in sessions do
		if s.Stain then
			s.Stain:Destroy()
		end
	end
	table.clear(sessions)
	local root = worldFolder
	if root then
		root:Destroy()
		worldFolder = nil
	end
	table.clear(altarParts)
	table.clear(gateParts)
end

-- Blacksmith: reinforce the equipped weapon with banked essence (unbanked essence is banked first).
function WorldService.Refresh(userId: number)
 local s=session(userId);if s then publish(s) end
end

function WorldService.Reinforce(userId: number): (boolean, string)
	local s = session(userId)
	local record = souls(userId)
	if not s or not record then
		return false, "Unavailable"
	end
	if Characters.IsInDuel(userId) then
		return false, "InDuel"
	end
	local weapon = record.inventory.mainhand
	flush(s)
	enqueue(s, "Reinforce", function(store: any): (boolean, string?)
		local ok, err, level = store:ReinforceWeapon(userId, weapon)
		if ok then
			Characters.RefreshProgression(userId)
			Characters.Cue("WeaponReinforced", userId, { weapon = weapon, level = level })
		elseif err ~= "Profile is busy" and err ~= "Profile session unavailable" then
			local current = souls(userId)
			Characters.Cue("ReinforceRefused", userId, {
				reason = err,
				weapon = weapon,
				cost = if current then ProfileStore.ReinforceCost(ProfileStore.ReinforceLevel(current, weapon)) else 0,
			})
			return true, nil
		end
		return ok, err
	end)
	return true, "ReinforceQueued"
end

-- Blacksmith: refill the gourd outside the rest ritual (no enemy respawn, no checkpoint change).
function WorldService.RefillElixirs(userId: number): (boolean, string)
	local s = session(userId)
	if not s then
		return false, "Unavailable"
	end
	if s.Elixirs &gt;= s.MaxElixirs then
		return false, "GourdFull"
	end
	s.Elixirs = s.MaxElixirs
	s.ElixirsDirty = true
	s.Player:SetAttribute("AsuraElixirs", s.Elixirs)
	flush(s)
	Characters.Cue("GourdRefilled", userId, { charges = s.Elixirs })
	return true, "Refilled"
end

function WorldService.RegisterInteractable(handler: Interactable): () -&gt; ()
	table.insert(interactables, handler)
	return function()
		local index = table.find(interactables, handler)
		if index then
			table.remove(interactables, index)
		end
	end
end

function WorldService.GetSession(userId: number): any
	return sessions[userId]
end

function WorldService.IsInBossFight(userId: number): boolean
	local s = sessions[userId]
	return s ~= nil and s.Fight ~= nil
end

return WorldService
