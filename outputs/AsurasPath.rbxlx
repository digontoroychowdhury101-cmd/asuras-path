      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/ProfileSchema
-- Server-authoritative data schema, migration rules, and integrity validation for player persistence.

export type StyleEntry = {
	unlocked: boolean,
	xp: number,
	level: number,
}

export type Profile = {
	schemaVersion: number,
	userId: number,
	elo: number,
	peakElo: number,
	wins: number,
	losses: number,
	draws: number,
	winStreak: number,
	fightCash: number,
	styleSpins: number,
	pityCounter: number,
	activeStyle: string,
	styles: { [string]: StyleEntry },
	ownedCosmetics: { [string]: boolean },
	equippedCosmetics: {
		Trunks: string,
		Gloves: string,
		Taunt: string, Wrap: string, Accessory: string, Skin: string, Hair: string,
	},
	settings: {
		fov: number,
		sensitivity: number,
		leftHanded: boolean, keybinds: {[string]: string},
	},
	lastSaveTime: number,
 receipts: {[string]: number}, appliedMatches: {[string]: boolean}, pendingMatches: {[string]: boolean},
}

local ProfileSchema = {}

local CURRENT_SCHEMA_VERSION = 3
local DEFAULT_ELO = 1000

function ProfileSchema.Level(xp: number): number
 local level=1
 for i,threshold in {0,500,1500,3500,7500} do if xp>=threshold then level=i end end
 return level
end

function ProfileSchema.Default(userId: number): Profile
	return {
		schemaVersion = CURRENT_SCHEMA_VERSION,
		userId = userId,
		elo = DEFAULT_ELO,
		peakElo = DEFAULT_ELO,
		wins = 0,
		losses = 0,
		draws = 0,
		winStreak = 0,
		fightCash = 500, -- Welcome bonus
		styleSpins = 5,  -- 5 free initial rolls
		pityCounter = 0,
		activeStyle = "Ironline",
		styles = {
			Ironline = { unlocked = true, xp = 0, level = 1 },
			Groundforge = { unlocked = false, xp = 0, level = 1 },
			ApexStriker = { unlocked = false, xp = 0, level = 1 },
			CobraFlow = { unlocked = false, xp = 0, level = 1 },
			DragonClaw = { unlocked = false, xp = 0, level = 1 },
		},
		ownedCosmetics = {
			Trunks_Charcoal = true,
			Gloves_Black = true,
			Taunt_Bow = true, Wrap_White = true, Accessory_None = true, Skin_Tan = true, Skin_Light = true, Skin_Deep = true, Hair_Crop = true, Hair_None = true, Hair_Sweep = true,
		},
		equippedCosmetics = {
			Trunks = "Trunks_Charcoal",
			Gloves = "Gloves_Black",
			Taunt = "Taunt_Bow", Wrap="Wrap_White", Accessory="Accessory_None", Skin="Skin_Tan", Hair="Hair_Crop",
		},
		settings = {
			fov = 80,
			sensitivity = 1.0,
			leftHanded = false, keybinds = {},
		},
		lastSaveTime = 0, receipts = {}, appliedMatches = {}, pendingMatches = {},
	}
end

-- Storage bounds preserve exact integer arithmetic; these are not progression caps.
local MAX_SAFE_INTEGER = 9007199254740991
local MAX_ELO = 5000
local MAX_STYLE_LEVEL = 5
local MAX_IDENTIFIER_LENGTH = 64
local MIN_FOV, MAX_FOV = 70, 90
local MIN_SENSITIVITY, MAX_SENSITIVITY = 0.5, 2
local COUNTERS = table.freeze({
	"wins", "losses", "draws", "winStreak", "fightCash", "styleSpins", "pityCounter", "lastSaveTime",
})
local COSMETIC_SLOTS = table.freeze({ "Trunks", "Gloves", "Taunt", "Wrap", "Accessory", "Skin", "Hair" })

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function integer(value: any, minimum: number, maximum: number): boolean
	return finite(value) and value >= minimum and value <= maximum and value % 1 == 0
end

local function repairInteger(value: any, fallback: number, minimum: number, maximum: number): number
	return if integer(value, minimum, maximum) then value else fallback
end

local function identifier(value: any): boolean
	return type(value) == "string" and #value > 0 and #value <= MAX_IDENTIFIER_LENGTH
		and string.match(value, "^[%w_]+$") ~= nil
end

local ACTIONS={LeftHand=true,RightHand=true,LeftLeg=true,RightLeg=true,Alternate=true,Body=true,Guard=true,Grapple=true,Evade=true,Tap=true,Style=true}
local DEFAULT_KEYS: {[string]: string}={LeftHand="MouseLeftButton",RightHand="MouseRightButton",LeftLeg="Q",RightLeg="E",Alternate="LeftAlt",Body="LeftControl",Guard="Space",Grapple="F",Evade="LeftShift",Tap="T",Style="R"}
local VALID_KEYS={MouseLeftButton=true,MouseRightButton=true,Space=true,LeftAlt=true,RightAlt=true,LeftControl=true,RightControl=true,LeftShift=true,RightShift=true,One=true,Two=true,Three=true,Four=true,Five=true,Six=true,Seven=true,Eight=true,Nine=true,Zero=true,Minus=true,Equals=true,LeftBracket=true,RightBracket=true,Semicolon=true,Quote=true,Comma=true,Period=true,BackSlash=true}
for key in string.gmatch("C E F G H I J K L N O P Q R T U V X Y Z", "%S+") do VALID_KEYS[key]=true end
function ProfileSchema.ValidKeybinds(bindings: any): boolean
 if type(bindings)~="table" then return false end
 for name,key in bindings do if not ACTIONS[name] or type(key)~="string" or not VALID_KEYS[key] then return false end end
 local used: {[string]: boolean}={}
 for name,key in DEFAULT_KEYS do
  local chosen=bindings[name] or key
  if used[chosen] then return false end
  used[chosen]=true
 end
 return true
end
function ProfileSchema.Validate(raw: any): (boolean, string?)
	if type(raw) ~= "table" then return false, "Profile must be a table" end
	if raw.schemaVersion ~= CURRENT_SCHEMA_VERSION then return false, "Unsupported schemaVersion" end
	-- Negative user IDs are used by Studio's local multiplayer sessions.
	if not integer(raw.userId, -MAX_SAFE_INTEGER, MAX_SAFE_INTEGER) then return false, "Invalid userId" end
	if not integer(raw.elo, 0, MAX_ELO) then return false, "Invalid elo rating" end
	if not integer(raw.peakElo, raw.elo, MAX_ELO) then return false, "Invalid peakElo rating" end
	for _, field in COUNTERS do
		if not integer(raw[field], 0, MAX_SAFE_INTEGER) then return false, "Invalid " .. field end
	end
	if type(raw.styles) ~= "table" then return false, "Missing styles table" end
	local defaults = ProfileSchema.Default(raw.userId)
	for name in defaults.styles do
		if type(raw.styles[name]) ~= "table" then return false, "Missing style: " .. name end
	end
	for name, entry in pairs(raw.styles) do
		if type(name) ~= "string" or defaults.styles[name] == nil or type(entry) ~= "table" then
			return false, "Unknown or malformed style"
		end
		local data = entry :: { [string]: any }
		if type(data.unlocked) ~= "boolean" or not integer(data.xp, 0, MAX_SAFE_INTEGER)
			or not integer(data.level, 1, MAX_STYLE_LEVEL) or data.level ~= ProfileSchema.Level(data.xp) then
			return false, "Invalid style stats: " .. name
		end
	end
	if not identifier(raw.activeStyle) or not raw.styles[raw.activeStyle]
		or not raw.styles[raw.activeStyle].unlocked then return false, "Active style must be unlocked" end
	if type(raw.ownedCosmetics) ~= "table" or type(raw.equippedCosmetics) ~= "table" then
		return false, "Missing cosmetics table"
	end
	for id, owned in pairs(raw.ownedCosmetics) do
		if not identifier(id) or type(owned) ~= "boolean" then return false, "Invalid cosmetic ownership" end
	end
	for _, slot in COSMETIC_SLOTS do
		local id = raw.equippedCosmetics[slot]
		if not identifier(id) or raw.ownedCosmetics[id] ~= true then
			return false, "Equipped cosmetic must be owned: " .. slot
		end
	end
	if type(raw.settings) ~= "table" or type(raw.settings.leftHanded) ~= "boolean" then
		return false, "Invalid settings"
	end
	if not finite(raw.settings.fov) or raw.settings.fov < MIN_FOV or raw.settings.fov > MAX_FOV then
		return false, "Invalid fov"
	end
	if not finite(raw.settings.sensitivity) or raw.settings.sensitivity < MIN_SENSITIVITY
		or raw.settings.sensitivity > MAX_SENSITIVITY then return false, "Invalid sensitivity" end
	if not ProfileSchema.ValidKeybinds(raw.settings.keybinds) then return false,"Invalid keybinds" end
	for _, field in {"receipts", "appliedMatches", "pendingMatches"} do
  if type(raw[field])~="table" then return false,"Missing ledger: "..field end
  local count=0
  for id,value in raw[field] do
   count+=1
   if type(id)~="string" or #id==0 or #id>200 or count>10000 then return false,"Invalid ledger" end
   if field=="receipts" then
    if not integer(value,1,MAX_SAFE_INTEGER) then return false,"Invalid receipt product" end
   elseif value~=true then return false,"Invalid result ledger" end
  end
 end
 return true, nil
end

function ProfileSchema.Migrate(raw: any, userId: number): Profile
	assert(integer(userId, -MAX_SAFE_INTEGER, MAX_SAFE_INTEGER), "Invalid profile owner")
	local migrated = ProfileSchema.Default(userId)
	if type(raw) ~= "table" then return migrated end
	-- An older server must never rewrite a newer schema with missing fields.
	if finite(raw.schemaVersion) and raw.schemaVersion > CURRENT_SCHEMA_VERSION then
		error("Profile schema is newer than this server supports", 0)
	end
	migrated.elo = repairInteger(raw.elo, migrated.elo, 0, MAX_ELO)
	migrated.peakElo = math.max(migrated.elo, repairInteger(raw.peakElo, migrated.elo, 0, MAX_ELO))
	for _, field in COUNTERS do
		(migrated :: any)[field] = repairInteger(raw[field], (migrated :: any)[field], 0, MAX_SAFE_INTEGER)
	end
	-- Build fresh nested tables; neither the input nor another profile shares these entries.
	if type(raw.styles) == "table" then
		for name, entry in migrated.styles do
			local saved = raw.styles[name]
			if type(saved) == "table" then
				entry.unlocked = if type(saved.unlocked) == "boolean" then saved.unlocked else entry.unlocked
				entry.xp = repairInteger(saved.xp, entry.xp, 0, MAX_SAFE_INTEGER)
				entry.level = ProfileSchema.Level(entry.xp)
			end
		end
	end
	if identifier(raw.activeStyle) and migrated.styles[raw.activeStyle]
		and migrated.styles[raw.activeStyle].unlocked then
		migrated.activeStyle = raw.activeStyle
	else
		migrated.styles.Ironline.unlocked = true
	end
	if type(raw.ownedCosmetics) == "table" then
		for id, owned in pairs(raw.ownedCosmetics) do
			if type(id) == "string" and identifier(id) and owned == true then migrated.ownedCosmetics[id] = true end
		end
	end
	if type(raw.equippedCosmetics) == "table" then
		for _, slot in COSMETIC_SLOTS do
			local id = raw.equippedCosmetics[slot]
			if identifier(id) and migrated.ownedCosmetics[id] then
				(migrated.equippedCosmetics :: any)[slot] = id
			end
		end
	end
	if type(raw.settings) == "table" then
		if finite(raw.settings.fov) then migrated.settings.fov = math.clamp(raw.settings.fov, MIN_FOV, MAX_FOV) end
		if finite(raw.settings.sensitivity) then
			migrated.settings.sensitivity = math.clamp(raw.settings.sensitivity, MIN_SENSITIVITY, MAX_SENSITIVITY)
		end
		if type(raw.settings.leftHanded) == "boolean" then migrated.settings.leftHanded = raw.settings.leftHanded end
  if raw.settings.keybinds~=nil then
   assert(ProfileSchema.ValidKeybinds(raw.settings.keybinds),"Corrupt keybinds")
   for name,key in raw.settings.keybinds do migrated.settings.keybinds[name]=key end
  end
	end
 -- Durable ledgers are never silently repaired/dropped: losing a key could duplicate a grant.
 for _,field in {"receipts","appliedMatches","pendingMatches"} do
  if raw[field]~=nil then
   assert(type(raw[field])=="table","Corrupt durable ledger")
   for id,value in raw[field] do (migrated :: any)[field][id]=value end
  end
 end
 assert(ProfileSchema.Validate(migrated))
 return migrated
end

return table.freeze(ProfileSchema)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Shared</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">AnimationCatalog</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/AnimationCatalog
-- Single source of truth for every animation slot in Asura's Path.
--
-- SWAPPING IN CUSTOM ANIMATIONS
--   1. Publish the animation to Roblox (Avatar > Animation Editor > Publish to Roblox) under the
--      account or group that owns this experience; Roblox only plays animations the owner can use.
--   2. Paste its id into that slot's `Custom` field below, e.g. Custom = "rbxassetid://1234567890".
--      Leave `Custom = nil` to keep the stock fallback.
--   3. Run `work/bin/luau/luau tools/test_asura_stage1.luau` (which loads this module) or start
--      Play: the catalog validates every id at require time and reports the slot that is wrong.
--
-- FALLBACKS
--   `Fallback` ids are Roblox's own R15 Animate-script animations (idle, tool hold/slash/lunge,
--   fall, jump, sit, cheer); `FallbackR6` are the R6 equivalents. They exist so no rig ever
--   T-poses while custom work is pending. They are stand-ins only: the stock library contains
--   no rolls, parries or glaive strings, so each fallback is the closest stock motion.
--
-- Callers should resolve through `Catalog.resolve`/`Catalog.weapon` rather than reading fields,
-- so custom ids, rig type and weapon fallbacks are applied consistently.

export type Priority = "Core" | "Idle" | "Movement" | "Action" | "Action2" | "Action3" | "Action4"
export type Rig = "R15" | "R6"
export type WeaponName = "Unarmed" | "Jian" | "Dao" | "Guandao"

export type Slot = {
	Name: string,
	-- Your published animation ("rbxassetid://<id>"). nil plays the stock fallback.
	Custom: string?,
	Fallback: string,
	FallbackR6: string,
	Looped: boolean,
	Priority: Priority,
	-- Playback speed applied to the fallback only; custom animations play at their authored speed.
	FallbackSpeed: number,
}

export type UniversalKey =
	"Roll"
	| "Backdash"
	| "Deflect"
	| "Hitstun_Light"
	| "Hitstun_Heavy"
	| "StanceBroken"
	| "Deathblow_Attacker"
	| "Deathblow_Victim"
	| "AltarRest"

export type WeaponKey = "Idle" | "Equip" | "Light1" | "Light2" | "Light3" | "Light4" | "Heavy" | "WeaponArt"

export type EnemyKey = "Shen_Phase1_Idle" | "Shen_Phase1_SwordCombo" | "Shen_Phase2_Transform" | "Shen_Phase2_GlaiveCombo"

local Catalog = {}

-------------------------------------------------------------------------------------------------
-- Stock Roblox animations (owned by Roblox, playable in every experience)
-------------------------------------------------------------------------------------------------

type StockName = "Idle" | "IdleLook" | "Jump" | "Fall" | "ToolHold" | "ToolSlash" | "ToolLunge" | "Sit" | "Cheer"
type StockSet = { [StockName]: string }

local STOCK: { R15: StockSet, R6: StockSet } = table.freeze({
	R15 = table.freeze({
		Idle = "rbxassetid://507766666",
		IdleLook = "rbxassetid://507766951",
		Jump = "rbxassetid://507765000",
		Fall = "rbxassetid://507767968",
		ToolHold = "rbxassetid://507768375",
		ToolSlash = "rbxassetid://522635514",
		ToolLunge = "rbxassetid://522638767",
		Sit = "rbxassetid://2506281703",
		Cheer = "rbxassetid://507770677",
	}),
	R6 = table.freeze({
		Idle = "rbxassetid://180435571",
		IdleLook = "rbxassetid://180435792",
		Jump = "rbxassetid://125750702",
		Fall = "rbxassetid://180436148",
		ToolHold = "rbxassetid://182393478",
		ToolSlash = "rbxassetid://129967390",
		ToolLunge = "rbxassetid://129967478",
		Sit = "rbxassetid://178130996",
		Cheer = "rbxassetid://129423030",
	}),
}) :: any

local function slot(name: string, custom: string?, stock: StockName, looped: boolean, priority: Priority, speed: number?): Slot
	return {
		Name = name,
		Custom = custom,
		Fallback = STOCK.R15[stock],
		FallbackR6 = STOCK.R6[stock],
		Looped = looped,
		Priority = priority,
		FallbackSpeed = speed or 1,
	}
end

-------------------------------------------------------------------------------------------------
-- Universal actions (every fighter, any weapon)
-- Swap ids in the second argument.
-------------------------------------------------------------------------------------------------

Catalog.Universal = {
	Roll = slot("Roll", nil, "Fall", false, "Action2", 1.6),
	Backdash = slot("Backdash", nil, "Jump", false, "Action2", 1.4),
	Deflect = slot("Deflect", nil, "ToolHold", false, "Action3", 1.8),
	Hitstun_Light = slot("Hitstun_Light", nil, "Fall", false, "Action3", 2.0),
	Hitstun_Heavy = slot("Hitstun_Heavy", nil, "Fall", false, "Action3", 1.2),
	StanceBroken = slot("StanceBroken", nil, "Sit", true, "Action4", 1),
	Deathblow_Attacker = slot("Deathblow_Attacker", nil, "ToolLunge", false, "Action4", 0.7),
	Deathblow_Victim = slot("Deathblow_Victim", nil, "Sit", false, "Action4", 1),
	AltarRest = slot("AltarRest", nil, "Sit", true, "Action", 1),
} :: { [UniversalKey]: Slot }

-------------------------------------------------------------------------------------------------
-- Per-weapon movesets. Guandao's light string is three hits; its Light4 slot is reserved for a
-- future fourth hit and is never requested by the current move data.
-------------------------------------------------------------------------------------------------

Catalog.Weapons = {
	Unarmed = {
		Idle = slot("Unarmed.Idle", nil, "Idle", true, "Idle"),
		Equip = slot("Unarmed.Equip", nil, "IdleLook", false, "Action", 1.5),
		Light1 = slot("Unarmed.Light1", nil, "ToolSlash", false, "Action", 1.6),
		Light2 = slot("Unarmed.Light2", nil, "ToolLunge", false, "Action", 1.6),
		Light3 = slot("Unarmed.Light3", nil, "ToolSlash", false, "Action", 1.5),
		Light4 = slot("Unarmed.Light4", nil, "ToolLunge", false, "Action", 1.3),
		Heavy = slot("Unarmed.Heavy", nil, "ToolLunge", false, "Action", 0.9),
		WeaponArt = slot("Unarmed.WeaponArt", nil, "ToolSlash", false, "Action2", 0.8),
	},
	Jian = {
		Idle = slot("Jian.Idle", nil, "ToolHold", true, "Idle"),
		Equip = slot("Jian.Equip", nil, "ToolHold", false, "Action", 1.5),
		Light1 = slot("Jian.Light1", nil, "ToolSlash", false, "Action", 1.4),
		Light2 = slot("Jian.Light2", nil, "ToolSlash", false, "Action", 1.5),
		Light3 = slot("Jian.Light3", nil, "ToolLunge", false, "Action", 1.4),
		Light4 = slot("Jian.Light4", nil, "ToolSlash", false, "Action", 1.2),
		Heavy = slot("Jian.Heavy", nil, "ToolLunge", false, "Action", 0.85),
		WeaponArt = slot("Jian.WeaponArt", nil, "ToolLunge", false, "Action2", 0.7),
	},
	Dao = {
		Idle = slot("Dao.Idle", nil, "ToolHold", true, "Idle"),
		Equip = slot("Dao.Equip", nil, "ToolHold", false, "Action", 1.4),
		Light1 = slot("Dao.Light1", nil, "ToolSlash", false, "Action", 1.3),
		Light2 = slot("Dao.Light2", nil, "ToolSlash", false, "Action", 1.35),
		Light3 = slot("Dao.Light3", nil, "ToolSlash", false, "Action", 1.25),
		Light4 = slot("Dao.Light4", nil, "ToolLunge", false, "Action", 1.1),
		Heavy = slot("Dao.Heavy", nil, "ToolSlash", false, "Action", 0.8),
		WeaponArt = slot("Dao.WeaponArt", nil, "ToolSlash", false, "Action2", 0.65),
	},
	Guandao = {
		Idle = slot("Guandao.Idle", nil, "ToolHold", true, "Idle"),
		Equip = slot("Guandao.Equip", nil, "ToolHold", false, "Action", 1.2),
		Light1 = slot("Guandao.Light1", nil, "ToolSlash", false, "Action", 1.1),
		Light2 = slot("Guandao.Light2", nil, "ToolLunge", false, "Action", 1.1),
		Light3 = slot("Guandao.Light3", nil, "ToolSlash", false, "Action", 1.0),
		Light4 = slot("Guandao.Light4", nil, "ToolLunge", false, "Action", 1.0),
		Heavy = slot("Guandao.Heavy", nil, "ToolLunge", false, "Action", 0.7),
		WeaponArt = slot("Guandao.WeaponArt", nil, "ToolSlash", false, "Action2", 0.6),
	},
} :: { [WeaponName]: { [WeaponKey]: Slot } }

-------------------------------------------------------------------------------------------------
-- Enemy-specific animations
-------------------------------------------------------------------------------------------------

Catalog.Enemies = {
	Shen_Phase1_Idle = slot("Shen_Phase1_Idle", nil, "ToolHold", true, "Idle"),
	Shen_Phase1_SwordCombo = slot("Shen_Phase1_SwordCombo", nil, "ToolSlash", false, "Action", 1.25),
	Shen_Phase2_Transform = slot("Shen_Phase2_Transform", nil, "Cheer", false, "Action4", 0.6),
	Shen_Phase2_GlaiveCombo = slot("Shen_Phase2_GlaiveCombo", nil, "ToolLunge", false, "Action", 1.0),
} :: { [EnemyKey]: Slot }

Catalog.UniversalKeys = table.freeze({
	"Roll",
	"Backdash",
	"Deflect",
	"Hitstun_Light",
	"Hitstun_Heavy",
	"StanceBroken",
	"Deathblow_Attacker",
	"Deathblow_Victim",
	"AltarRest",
} :: { UniversalKey })
Catalog.WeaponNames = table.freeze({ "Unarmed", "Jian", "Dao", "Guandao" } :: { WeaponName })
Catalog.WeaponKeys = table.freeze({ "Idle", "Equip", "Light1", "Light2", "Light3", "Light4", "Heavy", "WeaponArt" } :: { WeaponKey })
Catalog.EnemyKeys = table.freeze({
	"Shen_Phase1_Idle",
	"Shen_Phase1_SwordCombo",
	"Shen_Phase2_Transform",
	"Shen_Phase2_GlaiveCombo",
} :: { EnemyKey })

-------------------------------------------------------------------------------------------------
-- Resolution
-------------------------------------------------------------------------------------------------

-- The id to load for a slot on the given rig: the custom id when set, else the stock fallback.
function Catalog.resolve(entry: Slot, rig: Rig?): string
	local custom = entry.Custom
	if custom then
		return custom
	end
	return if rig == "R6" then entry.FallbackR6 else entry.Fallback
end

-- Playback speed for a slot: authored speed for custom ids, tuned speed for stock stand-ins.
function Catalog.speed(entry: Slot): number
	return if entry.Custom then 1 else entry.FallbackSpeed
end

function Catalog.isCustom(entry: Slot): boolean
	return entry.Custom ~= nil
end

function Catalog.universal(key: UniversalKey): Slot
	return Catalog.Universal[key]
end

-- Weapon slot lookup; unknown weapons use the Unarmed set so a new weapon never T-poses.
function Catalog.weapon(weapon: string, key: WeaponKey): Slot
	local set = Catalog.Weapons[weapon :: WeaponName] or Catalog.Weapons.Unarmed
	return set[key]
end

-- Light-string slot for a 1-based combo index, clamped to the four authored hits.
function Catalog.light(weapon: string, index: number): Slot
	local clamped = math.clamp(math.floor(index), 1, 4)
	return Catalog.weapon(weapon, ("Light" .. clamped) :: any)
end

function Catalog.enemy(key: EnemyKey): Slot
	return Catalog.Enemies[key]
end

-- Every slot still playing a stock fallback, for content audits.
function Catalog.pending(): { string }
	local result: { string } = {}
	for _, key in Catalog.UniversalKeys do
		if not Catalog.Universal[key].Custom then
			table.insert(result, Catalog.Universal[key].Name)
		end
	end
	for _, weapon in Catalog.WeaponNames do
		for _, key in Catalog.WeaponKeys do
			local entry = Catalog.Weapons[weapon][key]
			if not entry.Custom then
				table.insert(result, entry.Name)
			end
		end
	end
	for _, key in Catalog.EnemyKeys do
		if not Catalog.Enemies[key].Custom then
			table.insert(result, Catalog.Enemies[key].Name)
		end
	end
	return result
end

-- Every distinct id the catalog can resolve to on a rig, for ContentProvider preloading.
function Catalog.allIds(rig: Rig?): { string }
	local seen: { [string]: boolean } = {}
	local result: { string } = {}
	local function add(entry: Slot)
		local id = Catalog.resolve(entry, rig)
		if not seen[id] then
			seen[id] = true
			table.insert(result, id)
		end
	end
	for _, entry in Catalog.Universal do
		add(entry)
	end
	for _, set in Catalog.Weapons do
		for _, entry in set do
			add(entry)
		end
	end
	for _, entry in Catalog.Enemies do
		add(entry)
	end
	table.sort(result)
	return result
end

-------------------------------------------------------------------------------------------------
-- Validation (runs at require time)
-------------------------------------------------------------------------------------------------

local PRIORITIES: { [string]: boolean } = {
	Core = true,
	Idle = true,
	Movement = true,
	Action = true,
	Action2 = true,
	Action3 = true,
	Action4 = true,
}

local function validId(id: any): boolean
	return type(id) == "string" and string.match(id, "^rbxassetid://%d+$") ~= nil
end

local function check(entry: Slot?, label: string)
	assert(entry ~= nil, "AnimationCatalog is missing slot " .. label)
	assert(entry.Custom == nil or validId(entry.Custom), "AnimationCatalog." .. label .. ".Custom must be \"rbxassetid://<digits>\"")
	assert(validId(entry.Fallback) and validId(entry.FallbackR6), "AnimationCatalog." .. label .. " has an invalid fallback id")
	assert(PRIORITIES[entry.Priority], "AnimationCatalog." .. label .. " has an unknown priority")
	assert(entry.FallbackSpeed > 0 and entry.FallbackSpeed <= 4, "AnimationCatalog." .. label .. " fallback speed out of range")
end

for _, key in Catalog.UniversalKeys do
	check(Catalog.Universal[key], "Universal." .. key)
end
for _, weapon in Catalog.WeaponNames do
	assert(Catalog.Weapons[weapon] ~= nil, "AnimationCatalog is missing weapon " .. weapon)
	for _, key in Catalog.WeaponKeys do
		check(Catalog.Weapons[weapon][key], "Weapons." .. weapon .. "." .. key)
	end
end
for _, key in Catalog.EnemyKeys do
	check(Catalog.Enemies[key], "Enemies." .. key)
end

local function deepFreeze(value: any)
	if type(value) ~= "table" or table.isfrozen(value) then
		return
	end
	for _, child in value do
		deepFreeze(child)
	end
	table.freeze(value)
end
deepFreeze(Catalog.Universal)
deepFreeze(Catalog.Weapons)
deepFreeze(Catalog.Enemies)

return table.freeze(Catalog)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">CombatSettings</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/CombatSettings
-- Asura's Path combat tuning. Durations and rates here are real-time values; frame data in
-- WeaponSchema is authored at baseline and scaled through Simulation/Tempo.

export type InjuryTier = "None" | "Impaired" | "Injured" | "Severe"
export type InjuryRegion = "Head" | "Torso" | "LeftArm" | "RightArm" | "LeftLeg" | "RightLeg"
export type InjuryGroup = "Head" | "Torso" | "Arm" | "Leg"
export type Range = { Min: number, Max: number }
export type Thresholds = { Impaired: number, Injured: number, Severe: number }

local function freeze(value: any)
	if type(value) ~= "table" or table.isfrozen(value) then
		return
	end
	for _, child in value do
		freeze(child)
	end
	table.freeze(value)
end

local Settings = {
	SchemaVersion = 2,

	Tempo = {
		Scalar = 1.4,
		TickRate = 60,
		TickSeconds = 1 / 60,
		Telegraph = {
			HeavyMinSeconds = 0.210,
			LightTargetSeconds = 0.085,
		},
	},

	Health = {
		MaxHP = 100,
		Layers = { "ActiveHP", "RecoverableHP", "PermanentDeficit" },
		-- Fraction of each hit's damage that becomes RecoverableHP debt rather than a clean loss.
		RecoverableFraction = {
			Chip = 1.0,
			Light = 0.6,
			Heavy = 0.35,
			RunningAttack = 0.4,
			WeaponArt = 0.25,
			Bleed = 0.0,
			Deathblow = 0.0,
		},
		-- Fraction of each hit's damage that permanently lowers effective max HP until a shrine rest.
		PermanentFraction = {
			Chip = 0.0,
			Light = 0.0,
			Heavy = 0.08,
			RunningAttack = 0.05,
			WeaponArt = 0.12,
			Bleed = 0.5,
			Deathblow = 0.25,
		},
		MaxPermanentDeficit = 60,
		MinEffectiveMaxHP = 40,
		Rally = {
			Window = 3.0,
			ReturnRatio = 0.85,
			DecayDelay = 3.0,
			DecayRate = 8.0,
			DeflectBonus = 4.0,
		},
		Shrine = {
			RestoresActiveHP = true,
			ClearsRecoverableHP = true,
			ClearsPermanentDeficit = true,
			ClearsInjuries = true,
			RestDuration = 1.6,
		},
	},

	Bleed = {
		Max = 100,
		DecayRate = 6.0,
		DecayDelay = 1.5,
		-- Buildup per hit = BaseDamage * move.Bleed * weapon.BleedMultiplier * BuildupScale.
		BuildupScale = 3.0,
		ProcDamageFraction = 0.15,
		ResetOnProc = true,
	},

	Posture = {
		MaxPosture = 100,
		DecayRate = 14.0,
		GuardingDecayMultiplier = 0.35,
		DecayDelay = 0.9,
		LowHealthDecayScale = { AtFullHP = 1.0, AtZeroHP = 0.35 },
		DeflectWindow = 0.10,
		DeflectWindowMin = 0.060,
		DeflectRecovery = 0.20,
		DeflectSpamLockout = 0.30,
		DeflectSpamDecay = 0.45,
		DeflectReflectScale = 0.6,
		DeflectMinimumReflect = 8,
		DeflectChainFloor = 0.030,
		DeflectSelfScale = 0.35,
		BlockScale = 1.0,
		BlockDamageScale = 0.0,
		UnblockableBlockScale = 1.6,
		StanceBreakThreshold = 100,
		StanceBreakResetValue = 0,
		HitScale = 0.5,
	},

	Stamina = {
		Max = 100,
		RegenRate = 32.0,
		RegenDelay = 0.45,
		GuardRegenMultiplier = 0.5,
		BrokenRegenMultiplier = 1.5,
		BreakThreshold = 0,
		RecoverToFraction = 0.6,
		SprintCostPerSecond = 9.0,
		SprintMinimum = 5.0,
		Costs = {
			Light = 3.5,
			Heavy = 9.0,
			Roll = 6.0,
			Dash = 6.0,
			RunningAttack = 6.0,
			WeaponArt = 12.0,
			DeflectSuccess = 0.0,
			DeflectMiss = 12.0,
			Block = 12.0,
			Feint = 4.0,
			Heal = 0.0,
		},
		LightRange = { Min = 3.0, Max = 4.0 },
		HeavyRange = { Min = 8.0, Max = 10.0 },
	},

	Qi = {
		Max = 100,
		Initial = 0,
		GainOnHit = 6,
		GainOnDeflect = 10,
		GainOnDeathblow = 25,
		DecayRate = 0,
		ClearOnShrine = false,
	},

	Stun = {
		StaminaBroken = 1.4,
		GuardBroken = 1.4,
		StanceBroken = 2.5,
		HitstunLight = 0.28,
		HitstunHeavy = 0.48,
		Blockstun = 0.18,
		DeflectRecoil = 0.32,
		DeathblowAttacker = 1.1,
		DeathblowVictim = 1.6,
	},

	Deathblow = {
		DamageFraction = 0.6,
		MinimumDamage = 30,
		Range = 5.0,
		FacingDot = 0.2,
		InvulnerableToOthers = true,
		ClearsPosture = true,
	},

	Counter = {
		HitMultiplier = 1.25,
		PostureMultiplier = 1.25,
	},

	Feint = {
		-- Seconds after Startup begins during which a Heavy or Weapon Art may be feinted.
		Window = 0.15,
		Kinds = { Heavy = true, WeaponArt = true },
	},

	-- Rapid Roll/Dash spam shortens distance and i-frames; a landed strike or a quiet gap resets it.
	Backdash = {
		SpamWindow = 1.2,
		DecayPerUse = 0.18,
		MinDistanceScale = 0.45,
		IFrameDecayPerUse = 0.25,
		MinIFrameScale = 0.0,
		CancelFraction = 0.6,
	},

	Elixir = {
		HealFraction = 0.4,
		DrinkDuration = 0.9,
		BaseCharges = 3,
		MaxCharges = 8,
	},

	-- Attribute-derived poise: armor >= LightThreshold shrugs off light hitstun, >= HeavyThreshold every hit.
	Poise = {
		LightThreshold = 0.5,
		HeavyThreshold = 0.9,
		PostureReduction = 0.5,
	},

	Respawn = {
		PlayerDelay = 3.5,
		EnemyCorpseTime = 4.0,
		DuelResetDelay = 3.0,
	},

	Enemy = {
		ThinkRate = 10,
		AggroRange = 60,
		LeashRange = 140,
		ReactionTime = 0.22,
		DeflectChance = 0.45,
		HeavyChance = 0.2,
		ArtChance = 0.1,
		Aggression = 0.65,
		ComboContinueChance = 0.7,
		TimingJitter = 0.035,
	},

	Movement = {
		WalkSpeed = 16 * 1.4,
		SprintSpeed = 24 * 1.4,
		DashDistance = 14,
		DashDuration = 0.22,
		RollDistance = 11,
		RollDuration = 0.36,
		RollInvulnerable = { Start = 0.04, Finish = 0.24 },
		DashInvulnerable = { Start = 0.0, Finish = 0.10 },
	},

	Input = {
		BufferWindow = 0.10,
		BufferCapacity = 16,
		DuplicateWindow = 0.033,
		Priority = {
			Deflect = 100,
			Roll = 85,
			Dash = 80,
			WeaponArt = 70,
			Heavy = 60,
			RunningAttack = 55,
			Light = 40,
			Block = 30,
			Heal = 20,
			Equip = 10,
		},
	},

	Injury = {
		Tiers = { "None", "Impaired", "Injured", "Severe" } :: { InjuryTier },
		TierIndex = { None = 0, Impaired = 1, Injured = 2, Severe = 3 } :: { [InjuryTier]: number },
		Regions = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" } :: { InjuryRegion },
		Group = {
			Head = "Head",
			Torso = "Torso",
			LeftArm = "Arm",
			RightArm = "Arm",
			LeftLeg = "Leg",
			RightLeg = "Leg",
		} :: { [InjuryRegion]: InjuryGroup },
		-- Accumulated trauma coefficient (0..1) at which each tier begins.
		Thresholds = {
			Head = { Impaired = 0.20, Injured = 0.45, Severe = 0.75 },
			Torso = { Impaired = 0.30, Injured = 0.60, Severe = 0.90 },
			Arm = { Impaired = 0.25, Injured = 0.55, Severe = 0.85 },
			Leg = { Impaired = 0.25, Injured = 0.55, Severe = 0.85 },
		} :: { [InjuryGroup]: Thresholds },
		RecoveryPerSecond = {
			Head = 0.010,
			Torso = 0.008,
			Arm = 0.008,
			Leg = 0.008,
		} :: { [InjuryGroup]: number },
		RecoveryDelay = 6.0,
		-- Once a region reaches this tier, natural recovery stops at its threshold; only a shrine clears it.
		PersistentTier = "Injured" :: InjuryTier,
		BluntHeadConcussionScale = 1.5,
		-- Penalty ranges: Impaired uses Min, Severe uses Max, Injured interpolates the midpoint.
		Penalties = {
			Arm = {
				StaminaCostIncrease = { Min = 0.30, Max = 0.50 },
				DamageReduction = { Min = 0.20, Max = 0.35 },
			},
			Leg = {
				SpeedReduction = { Min = 0.15, Max = 0.30 },
				DashDistanceReduction = { Min = 0.15, Max = 0.30 },
			},
			Head = {
				DeflectWindowReduction = { Min = 0.10, Max = 0.30 },
				PostureDecayReduction = { Min = 0.15, Max = 0.45 },
				VisionBlur = { Min = 0.20, Max = 0.75 },
				EyeVignette = { Min = 0.15, Max = 0.60 },
			},
			Torso = {
				StaminaRegenReduction = { Min = 0.10, Max = 0.30 },
				MaxPostureReduction = { Min = 0.05, Max = 0.15 },
			},
		},
	},
	Colosseum = {
		-- Studio sessions open the ranked queue without the release gate or a Workspace override.
		-- Studio runs on mock persistence (Config.Backend.StudioLiveData = false), so test duels
		-- never touch live ratings. Live servers still require Config.Features.Matchmaking and
		-- Config.Release.RankedIntegrationPassed. Set Workspace attribute AsuraColosseumQA = false
		-- in Studio to rehearse the sealed-league path.
		RankedInDevelopment = true,
	},
}

freeze(Settings)
return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ConfigValidator</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/ConfigValidator
-- Validation runs before the preview is replaced or runtime instances are allocated.
local Validator = {}
local function numberIn(value: any, minimum: number, maximum: number, name: string)
	assert(type(value)=="number" and value==value and value>=minimum and value<=maximum,
		name.." must be finite and between "..minimum.." and "..maximum)
end
local function vector(value: any, minimum: number, maximum: number, name: string)
	assert(type(value)=="table" and #value==3,name.." must have exactly three components")
	for index=1,3 do numberIn(value[index],minimum,maximum,name.."["..index.."]") end
end
function Validator.Validate(config: any)
	assert(type(config)=="table","Config must be a table")
	assert(config.Project.Phase>=5 and config.Project.Phase<=12,"This bootstrap implements Phase 5 through Phase 12")
	assert(config.Arena.Sides==8,"The current mat decomposition requires eight sides")
	local a=config.Arena
	numberIn(a.AcrossFlats,24,64,"Arena.AcrossFlats")
	numberIn(a.FloorThickness,0.1,3,"Arena.FloorThickness")
	numberIn(a.FenceHeight,6,14,"Arena.FenceHeight")
	numberIn(a.WireSpacing,0.75,3,"Arena.WireSpacing")
	numberIn(a.WireDiameter,0.025,0.1,"Arena.WireDiameter")
	numberIn(a.PostDiameter,0.2,1.5,"Arena.PostDiameter")
	numberIn(a.RailDiameter,0.1,0.8,"Arena.RailDiameter")
	numberIn(a.WallThickness,0.1,1,"Arena.WallThickness")
	numberIn(a.WireBottom,0.1,1,"Arena.WireBottom")
	numberIn(a.WireTopInset,0.1,1,"Arena.WireTopInset")
	numberIn(a.LowerRailHeight,0.1,1,"Arena.LowerRailHeight")
	numberIn(a.GateSide,1,8,"Arena.GateSide")
	assert(a.GateSide%1==0,"GateSide must be an integer")
	numberIn(a.GateWidth,2,5,"Arena.GateWidth")
	numberIn(a.GateBarDiameter,0.1,0.4,"Arena.GateBarDiameter")
	numberIn(a.GateLatchHeight,1,a.FenceHeight-1,"Arena.GateLatchHeight")
	numberIn(a.GateLatchLength,0.2,1,"Arena.GateLatchLength")
	numberIn(a.SpawnDistance,2,a.AcrossFlats/2-3,"Arena.SpawnDistance")
	vector(a.SpawnSize,0.1,4,"Arena.SpawnSize")
	numberIn(a.VoidWidth,120,240,"Arena.VoidWidth")
	numberIn(a.VoidHeight,60,120,"Arena.VoidHeight")
	numberIn(a.VoidCenterY,10,30,"Arena.VoidCenterY")
	numberIn(a.VoidWallThickness,0.5,3,"Arena.VoidWallThickness")
	numberIn(a.LightHeight,a.FenceHeight+4,24,"Arena.LightHeight")
	numberIn(a.LightOffset,4,a.AcrossFlats/3,"Arena.LightOffset")
	vector(a.FixtureSize,0.1,6,"Arena.FixtureSize")
	vector(a.DiffuserSize,0.02,6,"Arena.DiffuserSize")
	numberIn(a.DiffuserGap,0.01,0.2,"Arena.DiffuserGap")
	numberIn(a.GeometryEpsilon,1e-8,1e-4,"Arena.GeometryEpsilon")
	numberIn(a.SpotLight.Brightness,0.1,10,"SpotLight.Brightness")
	numberIn(a.SpotLight.Range,a.LightHeight+4,60,"SpotLight.Range")
	numberIn(a.SpotLight.Angle,60,120,"SpotLight.Angle")
	vector(a.SpotLight.Color,0,255,"SpotLight.Color")
	assert(type(a.SpotLight.Shadows)=="boolean","SpotLight.Shadows must be boolean")
	local materials: {[string]: boolean}={Concrete=true,Metal=true,SmoothPlastic=true,Neon=true}
	for key,material in pairs(config.Materials :: {[string]: any}) do
		assert(materials[material.Material],"Unsupported material: "..tostring(material.Material))
		vector(material.Color,0,255,"Materials."..key..".Color")
		numberIn(material.Reflectance,0,0.1,"Materials."..key..".Reflectance")
	end
	for _,key in ipairs({"Ambient","OutdoorAmbient","ColorShiftTop","ColorShiftBottom","FogColor"}) do
		vector(config.Lighting[key],0,255,"Lighting."..key)
	end
	local l=config.Lighting
	assert(l.LightingStyle=="Realistic","Phase 1 targets Realistic lighting")
	assert(type(l.PrioritizeLightingQuality)=="boolean","PrioritizeLightingQuality must be boolean")
	numberIn(l.Brightness,0,10,"Lighting.Brightness")
	numberIn(l.ClockTime,0,24,"Lighting.ClockTime")
	numberIn(l.GeographicLatitude,-90,90,"Lighting.GeographicLatitude")
	numberIn(l.EnvironmentDiffuseScale,0,1,"Lighting.EnvironmentDiffuseScale")
	numberIn(l.EnvironmentSpecularScale,0,1,"Lighting.EnvironmentSpecularScale")
	numberIn(l.ShadowSoftness,0,1,"Lighting.ShadowSoftness")
	numberIn(l.ExposureCompensation,-1,1,"Lighting.ExposureCompensation")
	numberIn(l.FogStart,0,100000,"Lighting.FogStart")
	numberIn(l.FogEnd,l.FogStart+1,100000,"Lighting.FogEnd")
	numberIn(l.Atmosphere.Density,0,1,"Atmosphere.Density")
	numberIn(l.Atmosphere.Offset,0,1,"Atmosphere.Offset")
	numberIn(l.Atmosphere.Haze,0,10,"Atmosphere.Haze")
	numberIn(l.Atmosphere.Glare,0,10,"Atmosphere.Glare")
	vector(l.Atmosphere.Color,0,255,"Atmosphere.Color")
	vector(l.Atmosphere.Decay,0,255,"Atmosphere.Decay")
	assert(type(l.SunRays.Enabled)=="boolean","SunRays.Enabled must be boolean")
	numberIn(l.SunRays.Intensity,0,1,"SunRays.Intensity")
	numberIn(l.SunRays.Spread,0,1,"SunRays.Spread")
	assert(type(l.GlobalShadows)=="boolean","Lighting.GlobalShadows must be boolean")
	assert(type(l.ColorCorrection.Enabled)=="boolean","ColorCorrection.Enabled must be boolean")
	numberIn(l.ColorCorrection.Brightness,-1,1,"ColorCorrection.Brightness")
	numberIn(l.ColorCorrection.Contrast,-1,1,"ColorCorrection.Contrast")
	numberIn(l.ColorCorrection.Saturation,-1,1,"ColorCorrection.Saturation")
	vector(l.ColorCorrection.TintColor,0,255,"ColorCorrection.TintColor")
	assert(type(l.Bloom.Enabled)=="boolean","Bloom.Enabled must be boolean")
	numberIn(l.Bloom.Intensity,0,1,"Bloom.Intensity")
	numberIn(l.Bloom.Size,0,56,"Bloom.Size")
	numberIn(l.Bloom.Threshold,0,10,"Bloom.Threshold")
	assert(type(l.DepthOfField.Enabled)=="boolean","DepthOfField.Enabled must be boolean")
	numberIn(l.DepthOfField.FarIntensity,0,1,"DepthOfField.FarIntensity")
	numberIn(l.DepthOfField.NearIntensity,0,1,"DepthOfField.NearIntensity")
	numberIn(l.DepthOfField.FocusDistance,0,1000,"DepthOfField.FocusDistance")
	numberIn(l.DepthOfField.InFocusRadius,0,1000,"DepthOfField.InFocusRadius")
	vector(config.Workspace.GlobalWind,-100,100,"Workspace.GlobalWind")
	numberIn(config.Workspace.Gravity,0,300,"Workspace.Gravity")
	numberIn(config.Workspace.FallenPartsDestroyHeight,-50000,-20,"Workspace.FallenPartsDestroyHeight")
	assert(config.Workspace.StreamingEnabled==false,"Compact Phase 1 arena expects streaming off")
	numberIn(config.Runtime.MaximumArenaParts,100,2000,"Runtime.MaximumArenaParts")
	assert(config.PresentationIntensity=="ModerateTarget" or config.PresentationIntensity=="Off","Unsupported presentation preset")
	for feature,enabled in pairs(config.Features :: {[string]: boolean}) do
		assert(enabled==(feature=="Combat" or feature=="StyleRolls" or feature=="Injuries" or feature=="Persistence"  or feature=="CustomFighter"),"Unsupported feature configuration: "..feature)
	end
	if config.Injury then
		numberIn(config.Injury.ArmDamagePenalty,0.1,1.0,"Injury.ArmDamagePenalty")
		numberIn(config.Injury.ArmStaminaPenalty,1.0,3.0,"Injury.ArmStaminaPenalty")
		numberIn(config.Injury.LegMovePenaltyPerLeg,0.01,0.5,"Injury.LegMovePenaltyPerLeg")
		numberIn(config.Injury.LegMovePenaltyCap,0.05,0.8,"Injury.LegMovePenaltyCap")
		numberIn(config.Injury.LegDamagePenalty,0.1,1.0,"Injury.LegDamagePenalty")
	end
	local combat=config.Combat
	for _,key in {"MaxHealth","MaxStamina","StaminaRegenPerSecond","GuardDrainPerSecond","MaxBodyDamage","GrappleDrainPerSecond","GrappleBreakCost","GrappleSeparation","CounterDamageScale","FeintStaminaCost","GroundDrainPerSecond","GroundSeparation","MountDamageScale","GroundTransitionCost","SweepCost","StandUpCost","TakedownStaminaCost","SubmissionDrainPerSecond","SubmissionDamagePerSecond","SubmissionEscapeCost","SubmissionStaminaCost","GroundStrikeDamage","GroundStrikeStamina"} do
		numberIn(combat[key],0.1,200,"Combat."..key)
	end
	for _,key in {"RegenDelayTicks","GuardBreakTicks","BlockStunTicks","HitStunTicks","KOResetTicks","DisplayExtrapolationTicks","GrappleMaxTicks","CounterStunTicks","GroundMaxTicks","SubmissionMaxTicks"} do
		numberIn(combat[key],1,600,"Combat."..key);assert(combat[key]%1==0,"Combat ticks must be integers")
	end
	for _,key in {"GuardDamageScale","GuardMoveScale","AttackMoveScale","HitMoveScale","AttackTurnScale","GuardTurnScale"} do
		numberIn(combat[key],0,1,"Combat."..key)
	end
	numberIn(combat.GuardArcCos,-1,1,"Combat.GuardArcCos")
	numberIn(combat.GrappleArcCos,-1,1,"Combat.GrappleArcCos")
	numberIn(combat.InputBufferTicks,1,12,"Combat.InputBufferTicks")
	numberIn(combat.PreviewTimeoutSeconds,0.1,0.5,"Combat.PreviewTimeoutSeconds")
	numberIn(combat.SweepEpsilon,1e-8,1e-4,"Combat.SweepEpsilon")
	numberIn(combat.DummyGuardResumeStamina,1,combat.MaxStamina,"Combat.DummyGuardResumeStamina")
	assert(type(combat.PracticeDummyGuard)=="boolean","Dummy guard flag")
	assert(#combat.Parts==6 and #combat.Hurtboxes==6,"Six calibrated body parts required")
	for _,h in combat.Hurtboxes do
		assert(table.find(combat.Parts,h.Part),"Unknown hurtbox part")
		numberIn(h.X,-2,2,"Hurtbox.X");numberIn(h.Y,0,6,"Hurtbox.Y")
		numberIn(h.Z,-2,2,"Hurtbox.Z");numberIn(h.Radius,0.1,1,"Hurtbox.Radius")
	end
	local m,n,c,i=config.Movement,config.Network,config.Camera,config.Input
	assert(m.TickRate==60 and n.SendRate==30 and n.SnapshotRate==30,"Timing contract is 60/30/30 Hz")
	numberIn(m.Speed,1,12,"Movement.Speed")
	numberIn(m.Acceleration,1,100,"Movement.Acceleration")
	numberIn(m.Deceleration,1,100,"Movement.Deceleration")
	numberIn(m.Radius,1,2,"Movement.Radius")
	numberIn(m.TurnRate,0.5,10,"Movement.TurnRate")
	assert(m.RootHeight==3 and m.MaxFighters==2,"Calibration contract: 3-stud root, two fighters")
	assert(m.CollisionPasses==4 and m.MaxCatchupSteps==6,"Bounded simulation contract changed")
	numberIn(m.MaxFrameDelta,1/m.TickRate,0.1,"Movement.MaxFrameDelta")
	numberIn(m.BackwardScale,0.1,1,"Movement.BackwardScale")
	numberIn(m.StrafeScale,0.1,1,"Movement.StrafeScale")
	numberIn(m.Epsilon,1e-8,1e-4,"Movement.Epsilon")
	for _,key in {"MaxBatch","MaxQueue","MaxPending","MaxSequence","MessageBurst","FrameBurst","ActionBurst","SnapshotHistory","MaxSequenceGap"} do
		numberIn(n[key],1,2147483647,"Network."..key);assert(n[key]%1==0,"Integer required: "..key)
	end
	assert(n.MaxBatch<=6 and n.MaxQueue<=18 and n.MaxPending<=120,"Network buffers exceed tested caps")
	assert(n.MaxQueue>=n.MaxBatch and n.MaxPending>=n.MaxQueue,"Network buffer ordering")
	for _,key in {"MessagesPerSecond","FramesPerSecond","ActionsPerSecond","ActionCooldown","InputTimeout","DisconnectWarning","InterpolationDelay"} do
		numberIn(n[key],0.01,120,"Network."..key)
	end
	assert(n.Protocol==4 and n.SessionLength==36,"Protocol contract mismatch")
	numberIn(c.FOV,c.MinFOV,c.MaxFOV,"Camera.FOV")
	assert(c.MinFOV==70 and c.MaxFOV==90,"Supported FOV range is 70 to 90")
	numberIn(c.EyeHeight,5,5.8,"Camera.EyeHeight")
	numberIn(c.EyeForward,0,0.3,"Camera.EyeForward")
	numberIn(c.Clearance,0.1,0.5,"Camera.Clearance")
	numberIn(c.PitchLimit,0.5,1.4,"Camera.PitchLimit")
	for _,key in {"MouseSensitivity","TouchSensitivity","GamepadSensitivity","CorrectionSpeed","SnapDistance","FocusDistance","FOVStep","SensitivityStep","TraumaDecay","MaxTraumaYaw","MaxTraumaPitch","MaxTraumaRoll","MaxFovKick"} do
		numberIn(c[key],0.0001,100,"Camera."..key)
	end
	numberIn(i.StickDeadzone,0.05,0.4,"Input.StickDeadzone")
	assert(i.BufferCapacity==8 and i.BufferSeconds==0.2,"Input buffer contract")
	numberIn(i.SwipePixels,10,100,"Input.SwipePixels")
	numberIn(i.TouchStickPixels,30,100,"Input.TouchStickPixels")
	numberIn(i.SwipeMaxSeconds,0.1,1,"Input.SwipeMaxSeconds")
	numberIn(i.TapHoldSeconds,0.5,3,"Input.TapHoldSeconds")
	numberIn(i.ContextPriority,2000,5000,"Input.ContextPriority")
	numberIn(c.SensitivityMin,0.1,1,"Camera.SensitivityMin")
	numberIn(c.SensitivityMax,1,4,"Camera.SensitivityMax")
	numberIn(config.Runtime.DependencyTimeoutSeconds,1,60,"Runtime.DependencyTimeoutSeconds")
	for _,key in {"Color","GloveColor","ShortsColor"} do vector(config.Rig[key],0,255,"Rig."..key) end
	for _,key in {"HeadSize","UpperTorsoSize","LowerTorsoSize","UpperArmSize","ForearmSize","HandSize","ThighSize","ShinSize","FootSize"} do
		vector(config.Rig[key],0.1,2,"Rig."..key)
	end
	for _,key in {"StrideRate","LegSwing","GuardShoulder","GuardElbow"} do numberIn(config.Rig[key],0,10,"Rig."..key) end
end
return table.freeze(Validator)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">IntentProtocol</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/IntentProtocol
-- Pure validation; all client tables have exact keys and bounded flat payloads.
export type Frame = {seq: number,x: number,z: number,yaw: number,guard: boolean,body: boolean}
export type Bucket = { tokens: number, time: number }
local Protocol = {}
local LIMBS: {[string]: boolean}={LeftHand=true,RightHand=true,LeftLeg=true,RightLeg=true,Evade=true,Tap=true,Guard=true,Style=true}
local VARIANTS: {[string]: boolean}={Primary=true,Alternate=true,Up=true,Down=true,Left=true,Right=true,Roll=true,Ironline=true,ApexStriker=true,Groundforge=true,Pass=true,TakeBack=true,Sweep=true,Armbar=true,RNC=true,Guillotine=true,StandUp=true,Takedown=true}
local function finite(v: any,low: number,high: number): boolean
	return type(v)=="number" and v==v and v>=low and v<=high
end
local function keys(t: any,allowed: {[string]: boolean},expected: number): boolean
	if type(t)~="table" then return false end
	local count=0
	for k in pairs(t) do
		count+=1
		if count>expected or type(k)~="string" or not allowed[k] then return false end
	end
	return count==expected
end
function Protocol.Take(bucket: Bucket,now: number,cost: number,rate: number,burst: number): boolean
	bucket.tokens=math.min(burst,bucket.tokens+math.max(0,now-bucket.time)*rate)
	bucket.time=math.max(bucket.time,now)
	if bucket.tokens<cost then return false end
	bucket.tokens-=cost
	return true
end
function Protocol.Movement(packet: any,session: string,lastSequence: number,c: any): ({Frame}?,string?)
	if not keys(packet,{version=true,session=true,frames=true},3) then return nil,"shape" end
	if packet.version~=c.Protocol or packet.session~=session then return nil,"session" end
	if type(packet.frames)~="table" then return nil,"frames" end
	local count=0
	for k in pairs(packet.frames) do
		count+=1
		if count>c.MaxBatch or type(k)~="number" or not finite(k,1,c.MaxBatch) or k%1~=0 then return nil,"batch" end
	end
	if count==0 then return nil,"empty" end
	local result: {Frame}={}
	for i=1,count do
		local f=packet.frames[i]
		if not keys(f,{seq=true,x=true,z=true,yaw=true,guard=true,body=true},6) or type(f.guard)~="boolean" or type(f.body)~="boolean" then return nil,"frame shape" end
		if not finite(f.seq,lastSequence+1,math.min(c.MaxSequence,lastSequence+c.MaxSequenceGap)) or f.seq%1~=0 then return nil,"sequence" end
		if i>1 and f.seq~=result[i-1].seq+1 then return nil,"order" end
		if not finite(f.x,-1,1) or not finite(f.z,-1,1) or f.x*f.x+f.z*f.z>1.00001 then return nil,"axes" end
		if not finite(f.yaw,-math.pi,math.pi) then return nil,"yaw" end
		result[i]={seq=f.seq,x=f.x,z=f.z,yaw=f.yaw,guard=f.guard,body=f.body}
	end
	return result,nil
end
function Protocol.Action(packet: any,session: string,lastSequence: number,c: any): boolean
	if not keys(packet,{version=true,session=true,seq=true,action=true,variant=true,body=true,grapple=true,pressed=true},8) then return false end
	return packet.version==c.Protocol and packet.session==session
		and finite(packet.seq,lastSequence+1,math.min(c.MaxSequence,lastSequence+c.MaxSequenceGap)) and packet.seq%1==0
		and type(packet.action)=="string" and LIMBS[packet.action]==true
		and type(packet.variant)=="string" and VARIANTS[packet.variant]==true
		and type(packet.body)=="boolean" and type(packet.grapple)=="boolean" and type(packet.pressed)=="boolean"
end
local SHOP_FIELDS: {[string]: {[string]: boolean}}={
 SaveSettings={action=true,settings=true},GetProfile={action=true},RollStyle={action=true,useToken=true},
 RollCrate={action=true,crateId=true},BuyCosmetic={action=true,itemId=true},EquipCosmetic={action=true,itemId=true},
 EquipStyle={action=true,styleName=true},BuyBundle={action=true,bundleId=true},
}
function Protocol.Shop(packet: any): boolean
 if type(packet)~="table" or type(packet.action)~="string" then return false end
 local allowed=SHOP_FIELDS[packet.action]
 if not allowed then return false end
 local expected=if packet.action=="GetProfile" then 1 else 2
 if not keys(packet,allowed,expected) then return false end
 if packet.action=="GetProfile" then return true end
 if packet.action=="SaveSettings" then
  local s=packet.settings
  local count=if type(s)=="table" and s.keybinds~=nil then 4 else 3
  if not keys(s,{fov=true,sensitivity=true,leftHanded=true,keybinds=true},count) then return false end
  if s.keybinds~=nil then
   if type(s.keybinds)~="table" then return false end
   local n=0
   for k,v in s.keybinds do n+=1;if n>11 or type(k)~="string" or #k>16 or type(v)~="string" or #v>32 then return false end end
  end
  return finite(s.fov,70,90)
   and finite(s.sensitivity,0.5,2) and type(s.leftHanded)=="boolean"
 end
 if packet.action=="RollStyle" then return type(packet.useToken)=="boolean" end
 local id=packet.itemId or packet.styleName or packet.bundleId or packet.crateId
 return type(id)=="string" and #id>0 and #id<=64 and string.match(id,"^[%w_]+$")~=nil
end
function Protocol.QueueEnabled(mode: string,feature: boolean,rankedPassed: boolean,studioQA: boolean): boolean
 return mode=="Casual1v1" or (mode=="Ranked1v1" and ((feature and rankedPassed) or studioQA))
end
function Protocol.Matchmaking(packet: any): boolean
 if type(packet)~="table" then return false end
 if packet.action=="Dequeue" then return keys(packet,{action=true},1) end
 return keys(packet,{action=true,mode=true},2) and packet.action=="Enqueue"
  and (packet.mode=="Ranked1v1" or packet.mode=="Casual1v1")
end
return table.freeze(Protocol)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">WorldDefinitions</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/WorldDefinitions
-- Story Mode world manifest. Engine-free data (plain numbers, yaw in degrees) so the manifest is
-- validated identically by the server, the client and the local Luau runner.

export type Vec3 = { X: number, Y: number, Z: number }
export type Placement = { X: number, Y: number, Z: number, Yaw: number }
export type Bounds = { Center: Vec3, Size: Vec3 }
export type RegionId = "Sanctuary" | "DesecratedMonastery" | "BambooPass" | "AshColosseum"
export type WeaponType = "Unarmed" | "Jian" | "Dao" | "Guandao"

export type Stats = {
	MaxHP: number?,
	MaxStamina: number?,
	PostureCapacity: number?,
	StrengthScale: number?,
	DexterityScale: number?,
	PoiseArmor: number?,
	ReachBonus: number?,
}

export type AIProfile = {
	SightRange: number,
	FieldOfView: number,
	HearingRange: number,
	AlertTime: number,
	SearchTime: number,
	Aggression: number,
	DeflectChance: number,
	GuardChance: number,
	ReactionTime: number,
	TimingJitter: number,
	PatrolRadius: number,
	LeashRange: number,
	ComboContinueChance: number,
	HeavyChance: number,
	ArtChance: number,
	StrafeChance: number,
	RetreatStamina: number,
	PostureGuard: number,
	ThinkRate: number,
}

export type Region = {
	Id: RegionId,
	Name: string,
	Bounds: Bounds,
	MapFolder: string,
	Greybox: { Color: { number }, Material: string },
	Ambience: string,
	-- Region-scoped view of World.Altars keyed without the "Altar_" prefix, e.g.
	-- World.Regions.DesecratedMonastery.Altars.MonasteryGate. Filled from World.Altars at load.
	Altars: { [string]: Altar },
}

export type Altar = {
	Id: string,
	Name: string,
	Region: RegionId,
	Placement: Placement,
	Spawn: Placement,
	Radius: number,
	Starting: boolean,
}

export type MobDef = {
	Id: string,
	Name: string,
	Weapon: WeaponType,
	Stats: Stats,
	AI: AIProfile,
	Essence: number,
	BodyColor: { number },
}

export type MobSpawn = {
	Id: string,
	Mob: string,
	Region: RegionId,
	Placement: Placement,
	Patrol: { Placement },
}

export type Shockwave = {
	Windup: number,
	Radius: number,
	Damage: number,
	Posture: number,
	Unblockable: boolean,
}

export type BossPhase = {
	Index: number,
	Name: string,
	Weapon: WeaponType,
	-- Enter this phase when HP falls to this fraction of max (nil for the opening phase).
	HPFraction: number?,
	-- Enter this phase on the first Deathblow received in the previous phase.
	OnDeathblow: boolean,
	Stats: Stats,
	AI: AIProfile,
	Transition: { Duration: number, Shockwave: Shockwave, BodyColor: { number } }?,
	Special: { IntervalMin: number, IntervalMax: number, Shockwave: Shockwave }?,
}

export type BossDef = {
	Id: string,
	Name: string,
	Title: string,
	Region: RegionId,
	Arena: Bounds,
	Spawn: Placement,
	FogGate: string,
	Essence: number,
	Phases: { BossPhase },
	BodyColor: { number },
}

export type FogGate = {
	Id: string,
	Boss: string,
	Placement: Placement,
	Size: Vec3,
	-- Crossing into this volume (inside the arena) starts the encounter.
	Trigger: Bounds,
	-- Where trapped fighters are returned when they leave the arena, and where outsiders are ejected to.
	Inside: Placement,
	Outside: Placement,
}

-- Layout anchors for the Shrine of the Ascendant, the sky lobby above the sea of clouds. The
-- SanctuaryService builds around these points; the Colosseum ring and the bonfire altar read them.
export type SanctuaryLayout = {
	Origin: Vec3, -- Plaza centre at flagstone level
	PlazaRadius: number,
	PlinthHeight: number,
	Loggia: Vec3, -- West alcove centre (Blacksmith)
	Promenade: Vec3, -- East balcony centre (Colosseum ring)
	StairSteps: number,
	StairRise: number,
	StairRun: number,
	StairWidth: number,
	PortalDestination: string, -- Altar the Ascension Gateway delivers to
	CloudRadius: number,
}

local World = {}

local function v(x: number, y: number, z: number): Vec3
	return { X = x, Y = y, Z = z }
end

local function at(x: number, y: number, z: number, yaw: number?): Placement
	return { X = x, Y = y, Z = z, Yaw = yaw or 0 }
end

local function profile(overrides: { [string]: number }): AIProfile
	local base: AIProfile = {
		SightRange = 60,
		FieldOfView = 110,
		HearingRange = 28,
		AlertTime = 0.9,
		SearchTime = 6,
		Aggression = 0.6,
		DeflectChance = 0.3,
		GuardChance = 0.4,
		ReactionTime = 0.24,
		TimingJitter = 0.035,
		PatrolRadius = 12,
		LeashRange = 100,
		ComboContinueChance = 0.65,
		HeavyChance = 0.2,
		ArtChance = 0.06,
		StrafeChance = 0.35,
		RetreatStamina = 20,
		PostureGuard = 0.8,
		ThinkRate = 10,
	}
	local writable = base :: any
	for key, value in overrides do
		assert(writable[key] ~= nil, "Unknown AI profile field " .. key)
		writable[key] = value
	end
	return base
end

local SANCTUARY_ORIGIN = v(0, 600, 900)
local PLINTH_HEIGHT = 1.2

World.Sanctuary = {
	Origin = SANCTUARY_ORIGIN,
	PlazaRadius = 46,
	PlinthHeight = PLINTH_HEIGHT,
	Loggia = v(SANCTUARY_ORIGIN.X - 84, SANCTUARY_ORIGIN.Y, SANCTUARY_ORIGIN.Z),
	Promenade = v(SANCTUARY_ORIGIN.X + 94, SANCTUARY_ORIGIN.Y, SANCTUARY_ORIGIN.Z),
	StairSteps = 20,
	StairRise = 1,
	StairRun = 2,
	StairWidth = 14,
	PortalDestination = "Altar_MonasteryGate",
	CloudRadius = 1200,
} :: SanctuaryLayout

World.Regions = {
	Sanctuary = {
		Id = "Sanctuary",
		Name = "The Shrine of the Ascendant",
		Bounds = { Center = v(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + 20, SANCTUARY_ORIGIN.Z), Size = v(420, 260, 420) },
		-- Built at runtime by SanctuaryService as Workspace.Sanctuary; its presence suppresses greybox.
		MapFolder = "Sanctuary",
		Greybox = { Color = { 120, 112, 104 }, Material = "Slate" },
		Ambience = "SkyShrine",
		Altars = {},
	},
	DesecratedMonastery = {
		Id = "DesecratedMonastery",
		Name = "Desecrated Monastery",
		Bounds = { Center = v(0, 40, -900), Size = v(400, 200, 440) },
		MapFolder = "Map_DesecratedMonastery",
		Greybox = { Color = { 74, 66, 60 }, Material = "Slate" },
		Ambience = "TempleBells",
		Altars = {},
	},
	BambooPass = {
		Id = "BambooPass",
		Name = "Bamboo Pass",
		Bounds = { Center = v(0, 40, -1400), Size = v(240, 200, 560) },
		MapFolder = "Map_BambooPass",
		Greybox = { Color = { 68, 92, 58 }, Material = "Grass" },
		Ambience = "WindReeds",
		Altars = {},
	},
	AshColosseum = {
		Id = "AshColosseum",
		Name = "Ash Colosseum",
		Bounds = { Center = v(0, 40, -1900), Size = v(360, 200, 440) },
		MapFolder = "Map_AshColosseum",
		Greybox = { Color = { 58, 54, 52 }, Material = "Basalt" },
		Ambience = "EmberCrowd",
		Altars = {},
	},
} :: { [RegionId]: Region }

World.RegionOrder = { "Sanctuary", "DesecratedMonastery", "BambooPass", "AshColosseum" } :: { RegionId }

World.Altars = {
	-- First-time players kneel here: the spawn stands before the bonfire, facing the staircase (-Z).
	Altar_SanctuaryBonfire = {
		Id = "Altar_SanctuaryBonfire",
		Name = "Primal Bonfire",
		Region = "Sanctuary",
		Placement = at(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + PLINTH_HEIGHT, SANCTUARY_ORIGIN.Z),
		Spawn = at(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + 3, SANCTUARY_ORIGIN.Z + 20, 0),
		Radius = 9,
		Starting = true,
	},
	Altar_MonasteryGate = {
		Id = "Altar_MonasteryGate",
		Name = "Monastery Gate",
		Region = "DesecratedMonastery",
		Placement = at(0, 0, -720),
		Spawn = at(0, 3, -728, 0),
		Radius = 9,
		Starting = false,
	},
	Altar_DesecratedCloister = {
		Id = "Altar_DesecratedCloister",
		Name = "Desecrated Cloister",
		Region = "DesecratedMonastery",
		Placement = at(60, 0, -1010),
		Spawn = at(60, 3, -1018, 0),
		Radius = 9,
		Starting = false,
	},
	Altar_BambooShrine = {
		Id = "Altar_BambooShrine",
		Name = "Whispering Bamboo Shrine",
		Region = "BambooPass",
		Placement = at(-30, 0, -1380),
		Spawn = at(-30, 3, -1388, 0),
		Radius = 9,
		Starting = false,
	},
	Altar_ColosseumAntechamber = {
		Id = "Altar_ColosseumAntechamber",
		Name = "Colosseum Antechamber",
		Region = "AshColosseum",
		Placement = at(0, 0, -1730),
		Spawn = at(0, 3, -1738, 0),
		Radius = 9,
		Starting = false,
	},
} :: { [string]: Altar }

for id, altar in World.Altars do
	local short = string.gsub(id, "^Altar_", "")
	local region = World.Regions[altar.Region]
	assert(region ~= nil, "Altar region missing " .. id)
	assert(region.Altars[short] == nil, "Duplicate region altar name " .. short)
	region.Altars[short] = altar
end

World.Mobs = {
	CorruptWanderingMonk = {
		Id = "CorruptWanderingMonk",
		Name = "Corrupt Wandering Monk",
		Weapon = "Unarmed",
		Stats = { MaxHP = 85, MaxStamina = 90, PostureCapacity = 80, StrengthScale = 0.9, DexterityScale = 0.9, PoiseArmor = 0.1 },
		AI = profile({
			SightRange = 55,
			HearingRange = 26,
			Aggression = 0.55,
			DeflectChance = 0.2,
			GuardChance = 0.45,
			ReactionTime = 0.28,
			PatrolRadius = 14,
			LeashRange = 90,
			ComboContinueChance = 0.6,
			HeavyChance = 0.25,
			ArtChance = 0.05,
			StrafeChance = 0.3,
		}),
		Essence = 45,
		BodyColor = { 112, 84, 60 },
	},
	CursedSwordsman = {
		Id = "CursedSwordsman",
		Name = "Cursed Swordsman",
		Weapon = "Dao",
		Stats = { MaxHP = 120, MaxStamina = 110, PostureCapacity = 110, StrengthScale = 1.0, DexterityScale = 1.0, PoiseArmor = 0.2 },
		AI = profile({
			SightRange = 65,
			FieldOfView = 100,
			HearingRange = 30,
			Aggression = 0.7,
			DeflectChance = 0.4,
			GuardChance = 0.35,
			ReactionTime = 0.22,
			PatrolRadius = 10,
			LeashRange = 110,
			ComboContinueChance = 0.75,
			HeavyChance = 0.2,
			ArtChance = 0.08,
			StrafeChance = 0.4,
		}),
		Essence = 80,
		BodyColor = { 46, 50, 62 },
	},
} :: { [string]: MobDef }

local function patrol(x: number, z: number, radius: number): { Placement }
	return {
		at(x + radius, 3, z),
		at(x, 3, z + radius),
		at(x - radius, 3, z),
		at(x, 3, z - radius),
	}
end

local function spawn(id: string, mob: string, region: RegionId, x: number, z: number, yaw: number, radius: number): MobSpawn
	return { Id = id, Mob = mob, Region = region, Placement = at(x, 3, z, yaw), Patrol = patrol(x, z, radius) }
end

World.Spawns = {
	spawn("DM_Monk_Courtyard_A", "CorruptWanderingMonk", "DesecratedMonastery", -30, -790, 180, 10),
	spawn("DM_Monk_Courtyard_B", "CorruptWanderingMonk", "DesecratedMonastery", 34, -812, 200, 12),
	spawn("DM_Monk_Hall_A", "CorruptWanderingMonk", "DesecratedMonastery", -70, -900, 90, 8),
	spawn("DM_Monk_Hall_B", "CorruptWanderingMonk", "DesecratedMonastery", 78, -920, 270, 8),
	spawn("DM_Swordsman_Bridge", "CursedSwordsman", "DesecratedMonastery", 0, -960, 180, 6),
	spawn("DM_Monk_Cloister", "CorruptWanderingMonk", "DesecratedMonastery", 40, -1060, 180, 10),
	spawn("DM_Swordsman_Cloister", "CursedSwordsman", "DesecratedMonastery", 90, -1080, 220, 8),
	spawn("BP_Swordsman_Trail_A", "CursedSwordsman", "BambooPass", 20, -1200, 180, 10),
	spawn("BP_Monk_Trail", "CorruptWanderingMonk", "BambooPass", -40, -1270, 160, 12),
	spawn("BP_Swordsman_Grove_A", "CursedSwordsman", "BambooPass", 50, -1450, 200, 8),
	spawn("BP_Swordsman_Grove_B", "CursedSwordsman", "BambooPass", -60, -1500, 140, 8),
	spawn("BP_Monk_Ridge", "CorruptWanderingMonk", "BambooPass", 10, -1590, 180, 10),
	spawn("AC_Swordsman_Gate_A", "CursedSwordsman", "AshColosseum", -24, -1800, 180, 6),
	spawn("AC_Swordsman_Gate_B", "CursedSwordsman", "AshColosseum", 24, -1810, 180, 6),
} :: { MobSpawn }

World.Bosses = {
	GrandmasterShen = {
		Id = "GrandmasterShen",
		Name = "Grandmaster Shen",
		Title = "Grandmaster Shen, the Fallen Abbot",
		Region = "AshColosseum",
		Arena = { Center = v(0, 20, -1960), Size = v(120, 60, 130) },
		Spawn = at(0, 3, -1995, 180),
		FogGate = "Gate_AshColosseum",
		Essence = 4000,
		BodyColor = { 210, 196, 168 },
		Phases = {
			{
				Index = 1,
				Name = "Disciplined Master",
				Weapon = "Jian",
				HPFraction = nil,
				OnDeathblow = false,
				Stats = {
					MaxHP = 900,
					MaxStamina = 220,
					PostureCapacity = 240,
					StrengthScale = 1.4,
					DexterityScale = 1.6,
					PoiseArmor = 0.3,
					ReachBonus = 0,
				},
				AI = profile({
					SightRange = 200,
					FieldOfView = 360,
					HearingRange = 200,
					AlertTime = 0.2,
					Aggression = 0.75,
					DeflectChance = 0.75,
					GuardChance = 0.6,
					ReactionTime = 0.16,
					TimingJitter = 0.02,
					PatrolRadius = 0,
					LeashRange = 1000,
					ComboContinueChance = 0.85,
					HeavyChance = 0.2,
					ArtChance = 0.12,
					StrafeChance = 0.5,
					RetreatStamina = 40,
					PostureGuard = 0.7,
					ThinkRate = 15,
				}),
				Transition = nil,
				Special = nil,
			},
			{
				Index = 2,
				Name = "Demonic Chimera",
				Weapon = "Guandao",
				HPFraction = 0.5,
				OnDeathblow = true,
				Stats = {
					PostureCapacity = 280,
					StrengthScale = 1.8,
					DexterityScale = 1.7,
					PoiseArmor = 0.65,
					ReachBonus = 2.5,
				},
				AI = profile({
					SightRange = 200,
					FieldOfView = 360,
					HearingRange = 200,
					AlertTime = 0.1,
					Aggression = 0.9,
					DeflectChance = 0.35,
					GuardChance = 0.25,
					ReactionTime = 0.2,
					TimingJitter = 0.03,
					PatrolRadius = 0,
					LeashRange = 1000,
					ComboContinueChance = 0.9,
					HeavyChance = 0.3,
					ArtChance = 0.25,
					StrafeChance = 0.25,
					RetreatStamina = 25,
					PostureGuard = 0.9,
					ThinkRate = 15,
				}),
				Transition = {
					Duration = 2.4,
					Shockwave = { Windup = 1.6, Radius = 22, Damage = 28, Posture = 45, Unblockable = true },
					BodyColor = { 120, 22, 24 },
				},
				Special = {
					IntervalMin = 12,
					IntervalMax = 18,
					Shockwave = { Windup = 0.9, Radius = 16, Damage = 22, Posture = 38, Unblockable = true },
