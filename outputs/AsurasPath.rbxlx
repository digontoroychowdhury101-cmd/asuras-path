      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/ProfileSchema
-- Server-authoritative data schema, migration rules, and integrity validation for player persistence.

local hasScript = pcall(function() return script.Parent end)
local RPG: any = if hasScript then require(script.Parent.Shared.RPGProfile) else require("./RPGProfile")

export type StyleEntry = {
	unlocked: boolean,
	xp: number,
	level: number,
}

export type Profile = {
	schemaVersion: number,
	userId: number,
	elo: number,
	peakElo: number,
	wins: number,
	losses: number,
	draws: number,
	winStreak: number,
	qiEssence: number,
	attributes: {[string]: number},
	inventory: {Weapons: {[string]: {Level: number, Infusion: string?}}, Spells: {[string]: boolean}, Materials: {[string]: number}, LoreEntries: {[string]: boolean}},
	equippedLoadout: {MainWeapon: string, OffWeapon: string?, SpellSlot1: string?, SpellSlot2: string?, ArmorSet: string?},
	defeatedBosses: {[string]: boolean}, unlockedAltars: {[string]: boolean},
	colosseum: {Elo: number, Rank: string, Wins: number, Losses: number, WinStreak: number},
	weaponMastery: {[string]: number}, arenaWagers: {[string]: {Fighter: number, Amount: number, State: string}},
	styleSpins: number,
	pityCounter: number,
	activeStyle: string,
	styles: { [string]: StyleEntry },
	ownedCosmetics: { [string]: boolean },
	equippedCosmetics: {
		Trunks: string,
		Gloves: string,
		Taunt: string, Wrap: string, Accessory: string, Skin: string, Hair: string,
	},
	settings: {
		fov: number,
		sensitivity: number,
		leftHanded: boolean, keybinds: {[string]: string},
		comfort: { ReducedEffects: boolean, ReducedMotion: boolean, ReducedFlashes: boolean, TextScale: number }?,
	},
	lastSaveTime: number,
 receipts: {[string]: number}, appliedMatches: {[string]: boolean}, pendingMatches: {[string]: boolean},
}

local ProfileSchema = {}

local CURRENT_SCHEMA_VERSION = 4
local DEFAULT_ELO = 1000

function ProfileSchema.Level(xp: number): number
 local level=1
 for i,threshold in {0,500,1500,3500,7500} do if xp&gt;=threshold then level=i end end
 return level
end

function ProfileSchema.Default(userId: number): Profile
	local profile: any = {
		schemaVersion = CURRENT_SCHEMA_VERSION,
		userId = userId,
		elo = DEFAULT_ELO,
		peakElo = DEFAULT_ELO,
		wins = 0,
		losses = 0,
		draws = 0,
		winStreak = 0,
		styleSpins = 5,  -- 5 free initial rolls
		pityCounter = 0,
		activeStyle = "Ironline",
		styles = {
			Ironline = { unlocked = true, xp = 0, level = 1 },
			Groundforge = { unlocked = false, xp = 0, level = 1 },
			ApexStriker = { unlocked = false, xp = 0, level = 1 },
			CobraFlow = { unlocked = false, xp = 0, level = 1 },
			DragonClaw = { unlocked = false, xp = 0, level = 1 },
		},
		ownedCosmetics = {
			Trunks_Charcoal = true,
			Gloves_Black = true,
			Taunt_Bow = true, Wrap_White = true, Accessory_None = true, Skin_Tan = true, Skin_Light = true, Skin_Deep = true, Hair_Crop = true, Hair_None = true, Hair_Sweep = true,
		},
		equippedCosmetics = {
			Trunks = "Trunks_Charcoal",
			Gloves = "Gloves_Black",
			Taunt = "Taunt_Bow", Wrap="Wrap_White", Accessory="Accessory_None", Skin="Skin_Tan", Hair="Hair_Crop",
		},
		settings = {
			fov = 70,
			sensitivity = 1.0,
			leftHanded = false, keybinds = {},
			comfort = { ReducedEffects = false, ReducedMotion = false, ReducedFlashes = false, TextScale = 1 },
		},
		lastSaveTime = 0, receipts = {}, appliedMatches = {}, pendingMatches = {},
	}
	RPG.apply(profile, nil)
	return profile
end

-- Storage bounds preserve exact integer arithmetic; these are not progression caps.
local MAX_SAFE_INTEGER = 9007199254740991
local MAX_ELO = 5000
local MAX_STYLE_LEVEL = 5
local MAX_IDENTIFIER_LENGTH = 64
local MIN_FOV, MAX_FOV = 70, 90
local MIN_SENSITIVITY, MAX_SENSITIVITY = 0.5, 2
local COUNTERS = table.freeze({
	"wins", "losses", "draws", "winStreak", "styleSpins", "pityCounter", "lastSaveTime",
})
local COSMETIC_SLOTS = table.freeze({ "Trunks", "Gloves", "Taunt", "Wrap", "Accessory", "Skin", "Hair" })

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

local function integer(value: any, minimum: number, maximum: number): boolean
	return finite(value) and value &gt;= minimum and value &lt;= maximum and value % 1 == 0
end

local function repairInteger(value: any, fallback: number, minimum: number, maximum: number): number
	return if integer(value, minimum, maximum) then value else fallback
end

local function identifier(value: any): boolean
	return type(value) == "string" and #value &gt; 0 and #value &lt;= MAX_IDENTIFIER_LENGTH
		and string.match(value, "^[%w_]+$") ~= nil
end

local ACTIONS={LeftHand=true,RightHand=true,LeftLeg=true,RightLeg=true,Alternate=true,Body=true,Guard=true,Grapple=true,Evade=true,Tap=true,Style=true}
local DEFAULT_KEYS: {[string]: string}={LeftHand="MouseLeftButton",RightHand="MouseRightButton",LeftLeg="Q",RightLeg="E",Alternate="LeftAlt",Body="LeftControl",Guard="Space",Grapple="F",Evade="LeftShift",Tap="T",Style="R"}
local VALID_KEYS={MouseLeftButton=true,MouseRightButton=true,Space=true,LeftAlt=true,RightAlt=true,LeftControl=true,RightControl=true,LeftShift=true,RightShift=true,One=true,Two=true,Three=true,Four=true,Five=true,Six=true,Seven=true,Eight=true,Nine=true,Zero=true,Minus=true,Equals=true,LeftBracket=true,RightBracket=true,Semicolon=true,Quote=true,Comma=true,Period=true,BackSlash=true}
for key in string.gmatch("C E F G H I J K L N O P Q R T U V X Y Z", "%S+") do VALID_KEYS[key]=true end
-- Comfort and readability (batch 25; EffectsPreference.sanitize is the client-side twin).
local TEXT_SCALES = { [1] = true, [1.15] = true, [1.3] = true }
function ProfileSchema.ValidComfort(c: any): boolean
	if type(c) ~= "table" then return false end
	local n = 0
	for key, value in c do
		n += 1
		if key == "TextScale" then
			if not TEXT_SCALES[value] then return false end
		elseif (key ~= "ReducedEffects" and key ~= "ReducedMotion" and key ~= "ReducedFlashes") or type(value) ~= "boolean" then
			return false
		end
	end
	return n == 4
end
function ProfileSchema.ValidKeybinds(bindings: any): boolean
 if type(bindings)~="table" then return false end
 for name,key in bindings do if not ACTIONS[name] or type(key)~="string" or not VALID_KEYS[key] then return false end end
 local used: {[string]: boolean}={}
 for name,key in DEFAULT_KEYS do
  local chosen=bindings[name] or key
  if used[chosen] then return false end
  used[chosen]=true
 end
 return true
end
function ProfileSchema.Validate(raw: any): (boolean, string?)
	if type(raw) ~= "table" then return false, "Profile must be a table" end
	if raw.schemaVersion ~= CURRENT_SCHEMA_VERSION then return false, "Unsupported schemaVersion" end
	-- Negative user IDs are used by Studio's local multiplayer sessions.
	if not integer(raw.userId, -MAX_SAFE_INTEGER, MAX_SAFE_INTEGER) then return false, "Invalid userId" end
	if not integer(raw.elo, 0, MAX_ELO) then return false, "Invalid elo rating" end
	if not integer(raw.peakElo, raw.elo, MAX_ELO) then return false, "Invalid peakElo rating" end
	for _, field in COUNTERS do
		if not integer(raw[field], 0, MAX_SAFE_INTEGER) then return false, "Invalid " .. field end
	end
	if type(raw.styles) ~= "table" then return false, "Missing styles table" end
	local defaults = ProfileSchema.Default(raw.userId)
	for name in defaults.styles do
		if type(raw.styles[name]) ~= "table" then return false, "Missing style: " .. name end
	end
	for name, entry in pairs(raw.styles) do
		if type(name) ~= "string" or defaults.styles[name] == nil or type(entry) ~= "table" then
			return false, "Unknown or malformed style"
		end
		local data = entry :: { [string]: any }
		if type(data.unlocked) ~= "boolean" or not integer(data.xp, 0, MAX_SAFE_INTEGER)
			or not integer(data.level, 1, MAX_STYLE_LEVEL) or data.level ~= ProfileSchema.Level(data.xp) then
			return false, "Invalid style stats: " .. name
		end
	end
	if not identifier(raw.activeStyle) or not raw.styles[raw.activeStyle]
		or not raw.styles[raw.activeStyle].unlocked then return false, "Active style must be unlocked" end
	if type(raw.ownedCosmetics) ~= "table" or type(raw.equippedCosmetics) ~= "table" then
		return false, "Missing cosmetics table"
	end
	for id, owned in pairs(raw.ownedCosmetics) do
		if not identifier(id) or type(owned) ~= "boolean" then return false, "Invalid cosmetic ownership" end
	end
	for _, slot in COSMETIC_SLOTS do
		local id = raw.equippedCosmetics[slot]
		if not identifier(id) or raw.ownedCosmetics[id] ~= true then
			return false, "Equipped cosmetic must be owned: " .. slot
		end
	end
	if type(raw.settings) ~= "table" or type(raw.settings.leftHanded) ~= "boolean" then
		return false, "Invalid settings"
	end
	if not finite(raw.settings.fov) or raw.settings.fov &lt; MIN_FOV or raw.settings.fov &gt; MAX_FOV then
		return false, "Invalid fov"
	end
	if not finite(raw.settings.sensitivity) or raw.settings.sensitivity &lt; MIN_SENSITIVITY
		or raw.settings.sensitivity &gt; MAX_SENSITIVITY then return false, "Invalid sensitivity" end
	if not ProfileSchema.ValidKeybinds(raw.settings.keybinds) then return false,"Invalid keybinds" end
	if raw.settings.comfort ~= nil and not ProfileSchema.ValidComfort(raw.settings.comfort) then return false, "Invalid comfort settings" end
	for _, field in {"receipts", "appliedMatches", "pendingMatches"} do
  if type(raw[field])~="table" then return false,"Missing ledger: "..field end
  local count=0
  for id,value in raw[field] do
   count+=1
   if type(id)~="string" or #id==0 or #id&gt;200 or count&gt;10000 then return false,"Invalid ledger" end
   if field=="receipts" then
    if not integer(value,1,MAX_SAFE_INTEGER) then return false,"Invalid receipt product" end
   elseif value~=true then return false,"Invalid result ledger" end
  end
 end
 return RPG.validate(raw)
end

function ProfileSchema.Migrate(raw: any, userId: number): Profile
	assert(integer(userId, -MAX_SAFE_INTEGER, MAX_SAFE_INTEGER), "Invalid profile owner")
	local migrated = ProfileSchema.Default(userId)
	if type(raw) ~= "table" then return migrated end
	-- An older server must never rewrite a newer schema with missing fields.
	if finite(raw.schemaVersion) and raw.schemaVersion &gt; CURRENT_SCHEMA_VERSION then
		error("Profile schema is newer than this server supports", 0)
	end
	migrated.elo = repairInteger(raw.elo, migrated.elo, 0, MAX_ELO)
	migrated.peakElo = math.max(migrated.elo, repairInteger(raw.peakElo, migrated.elo, 0, MAX_ELO))
	for _, field in COUNTERS do
		(migrated :: any)[field] = repairInteger(raw[field], (migrated :: any)[field], 0, MAX_SAFE_INTEGER)
	end
	-- Build fresh nested tables; neither the input nor another profile shares these entries.
	if type(raw.styles) == "table" then
		for name, entry in migrated.styles do
			local saved = raw.styles[name]
			if type(saved) == "table" then
				entry.unlocked = if type(saved.unlocked) == "boolean" then saved.unlocked else entry.unlocked
				entry.xp = repairInteger(saved.xp, entry.xp, 0, MAX_SAFE_INTEGER)
				entry.level = ProfileSchema.Level(entry.xp)
			end
		end
	end
	if identifier(raw.activeStyle) and migrated.styles[raw.activeStyle]
		and migrated.styles[raw.activeStyle].unlocked then
		migrated.activeStyle = raw.activeStyle
	else
		migrated.styles.Ironline.unlocked = true
	end
	if type(raw.ownedCosmetics) == "table" then
		for id, owned in pairs(raw.ownedCosmetics) do
			if type(id) == "string" and identifier(id) and owned == true then migrated.ownedCosmetics[id] = true end
		end
	end
	if type(raw.equippedCosmetics) == "table" then
		for _, slot in COSMETIC_SLOTS do
			local id = raw.equippedCosmetics[slot]
			if identifier(id) and migrated.ownedCosmetics[id] then
				(migrated.equippedCosmetics :: any)[slot] = id
			end
		end
	end
	if type(raw.settings) == "table" then
		if finite(raw.settings.fov) then migrated.settings.fov = math.clamp(raw.settings.fov, MIN_FOV, MAX_FOV) end
		if finite(raw.settings.sensitivity) then
			migrated.settings.sensitivity = math.clamp(raw.settings.sensitivity, MIN_SENSITIVITY, MAX_SENSITIVITY)
		end
		if type(raw.settings.leftHanded) == "boolean" then migrated.settings.leftHanded = raw.settings.leftHanded end
		if ProfileSchema.ValidComfort(raw.settings.comfort) then migrated.settings.comfort = table.clone(raw.settings.comfort) end
  if raw.settings.keybinds~=nil then
   assert(ProfileSchema.ValidKeybinds(raw.settings.keybinds),"Corrupt keybinds")
   for name,key in raw.settings.keybinds do migrated.settings.keybinds[name]=key end
  end
	end
 -- Durable ledgers are never silently repaired/dropped: losing a key could duplicate a grant.
 for _,field in {"receipts","appliedMatches","pendingMatches"} do
  if raw[field]~=nil then
   assert(type(raw[field])=="table","Corrupt durable ledger")
   for id,value in raw[field] do (migrated :: any)[field][id]=value end
  end
 end
 RPG.apply(migrated, raw)
 assert(ProfileSchema.Validate(migrated))
 return migrated
end

return table.freeze(ProfileSchema)
</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Shared</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">AnimationCatalog</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/AnimationCatalog
-- Single source of truth for every animation slot in Asura's Path.
--
-- SWAPPING IN CUSTOM ANIMATIONS
--   1. Publish the animation to Roblox (Avatar &gt; Animation Editor &gt; Publish to Roblox) under the
--      account or group that owns this experience; Roblox only plays animations the owner can use.
--   2. Paste its id into that slot's `Custom` field below, e.g. Custom = "rbxassetid://1234567890".
--      Leave `Custom = nil` to keep the stock fallback.
--   3. Run `work/bin/luau/luau tools/test_asura_stage1.luau` (which loads this module) or start
--      Play: the catalog validates every id at require time and reports the slot that is wrong.
--
-- FALLBACKS
--   `Fallback` ids are Roblox's own R15 Animate-script animations (idle, tool hold/slash/lunge,
--   fall, jump, sit, cheer); `FallbackR6` are the R6 equivalents. They exist so no rig ever
--   T-poses while custom work is pending. They are stand-ins only: the stock library contains
--   no rolls, parries or glaive strings, so each fallback is the closest stock motion.
--
-- Callers should resolve through `Catalog.resolve`/`Catalog.weapon` rather than reading fields,
-- so custom ids, rig type and weapon fallbacks are applied consistently.

export type Priority = "Core" | "Idle" | "Movement" | "Action" | "Action2" | "Action3" | "Action4"
export type Rig = "R15" | "R6"
export type WeaponName = "Unarmed" | "Jian" | "Dao" | "Guandao"

export type Slot = {
	Name: string,
	-- Your published animation ("rbxassetid://&lt;id&gt;"). nil plays the stock fallback.
	Custom: string?,
	Fallback: string,
	FallbackR6: string,
	Looped: boolean,
	Priority: Priority,
	-- Playback speed applied to the fallback only; custom animations play at their authored speed.
	FallbackSpeed: number,
}

export type UniversalKey =
	"Roll"
	| "Backdash"
	| "Deflect"
	| "Hitstun_Light"
	| "Hitstun_Heavy"
	| "StanceBroken"
	| "Deathblow_Attacker"
	| "Deathblow_Victim"
	| "AltarRest"

export type WeaponKey = "Idle" | "Equip" | "Light1" | "Light2" | "Light3" | "Light4" | "Heavy" | "WeaponArt"

export type EnemyKey = "Shen_Phase1_Idle" | "Shen_Phase1_SwordCombo" | "Shen_Phase2_Transform" | "Shen_Phase2_GlaiveCombo"

local Catalog = {}

-------------------------------------------------------------------------------------------------
-- Stock Roblox animations (owned by Roblox, playable in every experience)
-------------------------------------------------------------------------------------------------

type StockName = "Idle" | "IdleLook" | "Jump" | "Fall" | "ToolHold" | "ToolSlash" | "ToolLunge" | "Sit" | "Cheer"
type StockSet = { [StockName]: string }

local STOCK: { R15: StockSet, R6: StockSet } = table.freeze({
	R15 = table.freeze({
		Idle = "rbxassetid://507766666",
		IdleLook = "rbxassetid://507766951",
		Jump = "rbxassetid://507765000",
		Fall = "rbxassetid://507767968",
		ToolHold = "rbxassetid://507768375",
		ToolSlash = "rbxassetid://522635514",
		ToolLunge = "rbxassetid://522638767",
		Sit = "rbxassetid://2506281703",
		Cheer = "rbxassetid://507770677",
	}),
	R6 = table.freeze({
		Idle = "rbxassetid://180435571",
		IdleLook = "rbxassetid://180435792",
		Jump = "rbxassetid://125750702",
		Fall = "rbxassetid://180436148",
		ToolHold = "rbxassetid://182393478",
		ToolSlash = "rbxassetid://129967390",
		ToolLunge = "rbxassetid://129967478",
		Sit = "rbxassetid://178130996",
		Cheer = "rbxassetid://129423030",
	}),
}) :: any

local function slot(name: string, custom: string?, stock: StockName, looped: boolean, priority: Priority, speed: number?): Slot
	return {
		Name = name,
		Custom = custom,
		Fallback = STOCK.R15[stock],
		FallbackR6 = STOCK.R6[stock],
		Looped = looped,
		Priority = priority,
		FallbackSpeed = speed or 1,
	}
end

-------------------------------------------------------------------------------------------------
-- Universal actions (every fighter, any weapon)
-- Swap ids in the second argument.
-------------------------------------------------------------------------------------------------

Catalog.Universal = {
	Roll = slot("Roll", nil, "Fall", false, "Action2", 1.6),
	Backdash = slot("Backdash", nil, "Jump", false, "Action2", 1.4),
	Deflect = slot("Deflect", nil, "ToolHold", false, "Action3", 1.8),
	Hitstun_Light = slot("Hitstun_Light", nil, "Fall", false, "Action3", 2.0),
	Hitstun_Heavy = slot("Hitstun_Heavy", nil, "Fall", false, "Action3", 1.2),
	StanceBroken = slot("StanceBroken", nil, "Sit", true, "Action4", 1),
	Deathblow_Attacker = slot("Deathblow_Attacker", nil, "ToolLunge", false, "Action4", 0.7),
	Deathblow_Victim = slot("Deathblow_Victim", nil, "Sit", false, "Action4", 1),
	AltarRest = slot("AltarRest", nil, "Sit", true, "Action", 1),
} :: { [UniversalKey]: Slot }

-------------------------------------------------------------------------------------------------
-- Per-weapon movesets. Guandao's light string is three hits; its Light4 slot is reserved for a
-- future fourth hit and is never requested by the current move data.
-------------------------------------------------------------------------------------------------

Catalog.Weapons = {
	Unarmed = {
		Idle = slot("Unarmed.Idle", nil, "Idle", true, "Idle"),
		Equip = slot("Unarmed.Equip", nil, "IdleLook", false, "Action", 1.5),
		Light1 = slot("Unarmed.Light1", nil, "ToolSlash", false, "Action", 1.6),
		Light2 = slot("Unarmed.Light2", nil, "ToolLunge", false, "Action", 1.6),
		Light3 = slot("Unarmed.Light3", nil, "ToolSlash", false, "Action", 1.5),
		Light4 = slot("Unarmed.Light4", nil, "ToolLunge", false, "Action", 1.3),
		Heavy = slot("Unarmed.Heavy", nil, "ToolLunge", false, "Action", 0.9),
		WeaponArt = slot("Unarmed.WeaponArt", nil, "ToolSlash", false, "Action2", 0.8),
	},
	Jian = {
		Idle = slot("Jian.Idle", nil, "ToolHold", true, "Idle"),
		Equip = slot("Jian.Equip", nil, "ToolHold", false, "Action", 1.5),
		Light1 = slot("Jian.Light1", nil, "ToolSlash", false, "Action", 1.4),
		Light2 = slot("Jian.Light2", nil, "ToolSlash", false, "Action", 1.5),
		Light3 = slot("Jian.Light3", nil, "ToolLunge", false, "Action", 1.4),
		Light4 = slot("Jian.Light4", nil, "ToolSlash", false, "Action", 1.2),
		Heavy = slot("Jian.Heavy", nil, "ToolLunge", false, "Action", 0.85),
		WeaponArt = slot("Jian.WeaponArt", nil, "ToolLunge", false, "Action2", 0.7),
	},
	Dao = {
		Idle = slot("Dao.Idle", nil, "ToolHold", true, "Idle"),
		Equip = slot("Dao.Equip", nil, "ToolHold", false, "Action", 1.4),
		Light1 = slot("Dao.Light1", nil, "ToolSlash", false, "Action", 1.3),
		Light2 = slot("Dao.Light2", nil, "ToolSlash", false, "Action", 1.35),
		Light3 = slot("Dao.Light3", nil, "ToolSlash", false, "Action", 1.25),
		Light4 = slot("Dao.Light4", nil, "ToolLunge", false, "Action", 1.1),
		Heavy = slot("Dao.Heavy", nil, "ToolSlash", false, "Action", 0.8),
		WeaponArt = slot("Dao.WeaponArt", nil, "ToolSlash", false, "Action2", 0.65),
	},
	Guandao = {
		Idle = slot("Guandao.Idle", nil, "ToolHold", true, "Idle"),
		Equip = slot("Guandao.Equip", nil, "ToolHold", false, "Action", 1.2),
		Light1 = slot("Guandao.Light1", nil, "ToolSlash", false, "Action", 1.1),
		Light2 = slot("Guandao.Light2", nil, "ToolLunge", false, "Action", 1.1),
		Light3 = slot("Guandao.Light3", nil, "ToolSlash", false, "Action", 1.0),
		Light4 = slot("Guandao.Light4", nil, "ToolLunge", false, "Action", 1.0),
		Heavy = slot("Guandao.Heavy", nil, "ToolLunge", false, "Action", 0.7),
		WeaponArt = slot("Guandao.WeaponArt", nil, "ToolSlash", false, "Action2", 0.6),
	},
} :: { [WeaponName]: { [WeaponKey]: Slot } }

-------------------------------------------------------------------------------------------------
-- Enemy-specific animations
-------------------------------------------------------------------------------------------------

Catalog.Enemies = {
	Shen_Phase1_Idle = slot("Shen_Phase1_Idle", nil, "ToolHold", true, "Idle"),
	Shen_Phase1_SwordCombo = slot("Shen_Phase1_SwordCombo", nil, "ToolSlash", false, "Action", 1.25),
	Shen_Phase2_Transform = slot("Shen_Phase2_Transform", nil, "Cheer", false, "Action4", 0.6),
	Shen_Phase2_GlaiveCombo = slot("Shen_Phase2_GlaiveCombo", nil, "ToolLunge", false, "Action", 1.0),
} :: { [EnemyKey]: Slot }

Catalog.UniversalKeys = table.freeze({
	"Roll",
	"Backdash",
	"Deflect",
	"Hitstun_Light",
	"Hitstun_Heavy",
	"StanceBroken",
	"Deathblow_Attacker",
	"Deathblow_Victim",
	"AltarRest",
} :: { UniversalKey })
Catalog.WeaponNames = table.freeze({ "Unarmed", "Jian", "Dao", "Guandao" } :: { WeaponName })
Catalog.WeaponKeys = table.freeze({ "Idle", "Equip", "Light1", "Light2", "Light3", "Light4", "Heavy", "WeaponArt" } :: { WeaponKey })
Catalog.EnemyKeys = table.freeze({
	"Shen_Phase1_Idle",
	"Shen_Phase1_SwordCombo",
	"Shen_Phase2_Transform",
	"Shen_Phase2_GlaiveCombo",
} :: { EnemyKey })

-------------------------------------------------------------------------------------------------
-- Resolution
-------------------------------------------------------------------------------------------------

-- The id to load for a slot on the given rig: the custom id when set, else the stock fallback.
function Catalog.resolve(entry: Slot, rig: Rig?): string
	local custom = entry.Custom
	if custom then
		return custom
	end
	return if rig == "R6" then entry.FallbackR6 else entry.Fallback
end

-- Playback speed for a slot: authored speed for custom ids, tuned speed for stock stand-ins.
function Catalog.speed(entry: Slot): number
	return if entry.Custom then 1 else entry.FallbackSpeed
end

function Catalog.isCustom(entry: Slot): boolean
	return entry.Custom ~= nil
end

function Catalog.universal(key: UniversalKey): Slot
	return Catalog.Universal[key]
end

-- Weapon slot lookup; unknown weapons use the Unarmed set so a new weapon never T-poses.
function Catalog.weapon(weapon: string, key: WeaponKey): Slot
	local family = ({Odachi="Guandao",TwinDaggers="Jian",ChainScythe="Guandao",WarFan="Dao",Catalyst="Guandao",PrayerOfTheDefiled="Guandao",CalamityBoneCleaver="Guandao",HeavenPiercingGuandao="Guandao"} :: {[string]: string})[weapon] or weapon
	local set = Catalog.Weapons[family :: WeaponName] or Catalog.Weapons.Unarmed
	return set[key]
end

-- Light-string slot for a 1-based combo index, clamped to the four authored hits.
function Catalog.light(weapon: string, index: number): Slot
	local clamped = math.clamp(math.floor(index), 1, 4)
	return Catalog.weapon(weapon, ("Light" .. clamped) :: any)
end

function Catalog.enemy(key: EnemyKey): Slot
	return Catalog.Enemies[key]
end

-- Every slot still playing a stock fallback, for content audits.
function Catalog.pending(): { string }
	local result: { string } = {}
	for _, key in Catalog.UniversalKeys do
		if not Catalog.Universal[key].Custom then
			table.insert(result, Catalog.Universal[key].Name)
		end
	end
	for _, weapon in Catalog.WeaponNames do
		for _, key in Catalog.WeaponKeys do
			local entry = Catalog.Weapons[weapon][key]
			if not entry.Custom then
				table.insert(result, entry.Name)
			end
		end
	end
	for _, key in Catalog.EnemyKeys do
		if not Catalog.Enemies[key].Custom then
			table.insert(result, Catalog.Enemies[key].Name)
		end
	end
	return result
end

-- Every distinct id the catalog can resolve to on a rig, for ContentProvider preloading.
function Catalog.allIds(rig: Rig?): { string }
	local seen: { [string]: boolean } = {}
	local result: { string } = {}
	local function add(entry: Slot)
		local id = Catalog.resolve(entry, rig)
		if not seen[id] then
			seen[id] = true
			table.insert(result, id)
		end
	end
	for _, entry in Catalog.Universal do
		add(entry)
	end
	for _, set in Catalog.Weapons do
		for _, entry in set do
			add(entry)
		end
	end
	for _, entry in Catalog.Enemies do
		add(entry)
	end
	table.sort(result)
	return result
end

-------------------------------------------------------------------------------------------------
-- Validation (runs at require time)
-------------------------------------------------------------------------------------------------

local PRIORITIES: { [string]: boolean } = {
	Core = true,
	Idle = true,
	Movement = true,
	Action = true,
	Action2 = true,
	Action3 = true,
	Action4 = true,
}

local function validId(id: any): boolean
	return type(id) == "string" and string.match(id, "^rbxassetid://%d+$") ~= nil
end

local function check(entry: Slot?, label: string)
	assert(entry ~= nil, "AnimationCatalog is missing slot " .. label)
	assert(entry.Custom == nil or validId(entry.Custom), "AnimationCatalog." .. label .. ".Custom must be \"rbxassetid://&lt;digits&gt;\"")
	assert(validId(entry.Fallback) and validId(entry.FallbackR6), "AnimationCatalog." .. label .. " has an invalid fallback id")
	assert(PRIORITIES[entry.Priority], "AnimationCatalog." .. label .. " has an unknown priority")
	assert(entry.FallbackSpeed &gt; 0 and entry.FallbackSpeed &lt;= 4, "AnimationCatalog." .. label .. " fallback speed out of range")
end

for _, key in Catalog.UniversalKeys do
	check(Catalog.Universal[key], "Universal." .. key)
end
for _, weapon in Catalog.WeaponNames do
	assert(Catalog.Weapons[weapon] ~= nil, "AnimationCatalog is missing weapon " .. weapon)
	for _, key in Catalog.WeaponKeys do
		check(Catalog.Weapons[weapon][key], "Weapons." .. weapon .. "." .. key)
	end
end
for _, key in Catalog.EnemyKeys do
	check(Catalog.Enemies[key], "Enemies." .. key)
end

local function deepFreeze(value: any)
	if type(value) ~= "table" or table.isfrozen(value) then
		return
	end
	for _, child in value do
		deepFreeze(child)
	end
	table.freeze(value)
end
deepFreeze(Catalog.Universal)
deepFreeze(Catalog.Weapons)
deepFreeze(Catalog.Enemies)

return table.freeze(Catalog)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ArenaLightPlan</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/ArenaLightPlan
-- Where boss-arena lights go. The four corner braziers are the arena's character light but
-- leave the centre of every arena (where the duel actually happens) outside their reach, so a
-- grid of shadowless overhead fill lanterns guarantees neutral light on every floor point.
-- Shared and pure so the coverage can be checked without the engine.
local Plan = {}

Plan.FloorY = 0 -- arena floors sit at Y 0 (spawns at Y 3)
Plan.Brazier = table.freeze({ Inset = 0.34, Height = 3, Range = 55, Brightness = 3 })
Plan.Fill = table.freeze({ Height = 18, Range = 60, Brightness = 0.9, MaxSpacing = 80 })
-- A floor point counts as lit when it lies inside this share of a light's range; Roblox point
-- light falloff makes the last stretch of the range too dim to separate actors from the floor.
Plan.Reach = 0.85

type Arena = { Center: { X: number, Y: number, Z: number }, Size: { X: number, Y: number, Z: number } }

function Plan.braziers(arena: Arena): { Vector3 }
	local c, s, inset = arena.Center, arena.Size, Plan.Brazier.Inset
	local result: { Vector3 } = {}
	for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		table.insert(result, Vector3.new(c.X + corner[1] * s.X * inset, Plan.FloorY + 0.35, c.Z + corner[2] * s.Z * inset))
	end
	return result
end

local function axis(center: number, size: number): { number }
	local count = math.max(1, math.ceil(size / Plan.Fill.MaxSpacing))
	local result: { number } = {}
	for i = 1, count do
		table.insert(result, center + (i - (count + 1) / 2) * size / count)
	end
	return result
end

function Plan.fills(arena: Arena): { Vector3 }
	local result: { Vector3 } = {}
	for _, x in axis(arena.Center.X, arena.Size.X) do
		for _, z in axis(arena.Center.Z, arena.Size.Z) do
			table.insert(result, Vector3.new(x, Plan.FloorY + Plan.Fill.Height, z))
		end
	end
	return result
end

-- Worst distance from any sampled floor point to its nearest light, as a share of that light's
-- range (&lt;= Plan.Reach means fully lit). `step` is the sampling pitch in studs.
function Plan.worstReach(arena: Arena, lights: { Vector3 }, range: number, step: number): (number, Vector3?)
	local c, s = arena.Center, arena.Size
	local worst, at = 0, nil :: Vector3?
	local x = c.X - s.X / 2
	while x &lt;= c.X + s.X / 2 + 1e-6 do
		local z = c.Z - s.Z / 2
		while z &lt;= c.Z + s.Z / 2 + 1e-6 do
			local point = Vector3.new(x, Plan.FloorY + 3, z) -- chest height of a standing fighter
			local nearest = math.huge
			for _, light in lights do
				nearest = math.min(nearest, (light - point).Magnitude)
			end
			if nearest / range &gt; worst then
				worst, at = nearest / range, point
			end
			z += step
		end
		x += step
	end
	return worst, at
end

return table.freeze(Plan)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ArenaRules</string>
            <string name="Source">--!strict
local Rules={}
function Rules.rank(elo: number,games: number): string
 if games==0 then return "Unranked" end
 if elo&lt;1100 then return "Ash Disciple" elseif elo&lt;1400 then return "Iron Vanguard"
 elseif elo&lt;1800 then return "Sword Saint" else return "Asura Sovereign" end
end
function Rules.normalized(): {[string]: number}
 return {Vigor=20,Endurance=20,Strength=20,Dexterity=20,ArcaneQi=20}
end
function Rules.validWager(amount: any): boolean
 return type(amount)=="number" and amount==amount and amount&gt;=50 and amount&lt;=500 and amount%1==0
end
function Rules.place(p: any,matchId: string,fighter: number,amount: number)
 assert(Rules.validWager(amount),"Wager must be 50–500 Qi")
 assert(not p.arenaWagers[matchId],"One wager per duel");assert(p.qiEssence&gt;=amount,"Not enough Qi")
 p.qiEssence-=amount;p.arenaWagers[matchId]={Fighter=fighter,Amount=amount,State="Pending"}
end
function Rules.settle(p: any,matchId: string,winner: number?,refund: boolean): number
 local bet=p.arenaWagers[matchId];if not bet or bet.State~="Pending" then return 0 end
 local payout=if refund then bet.Amount elseif bet.Fighter==winner then math.floor(bet.Amount*1.8) else 0
 bet.State="Settled";p.qiEssence+=payout;return payout
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ArsenalCatalog</string>
            <string name="Source">--!strict
-- Discovery and transmutation rewards are authored here, never supplied by clients.
export type Recipe={Boss: string,Kind: string,Reward: string,Name: string}
export type Cache={Name: string,Region: string,X: number,Y: number,Z: number,Weapon: string,Spells: {string},Extras: {string}?}
local Catalog={}
Catalog.Recipes={
 -- Every sovereign's remembrance offers one weapon or one sorcery (One soul, one choice). Shen's
 -- duel also yields the Demonic Chimera token for his second phase. Recipe ids are stable.
 PrayerOfTheDefiled={Boss="GrandmasterShen",Kind="Weapon",Reward="PrayerOfTheDefiled",Name="Prayer of the Defiled"},
 AbbotDirge={Boss="GrandmasterShen",Kind="Spell",Reward="AbbotDirge",Name="Abbot's Dirge"},
 CalamityBoneCleaver={Boss="DemonicChimera",Kind="Weapon",Reward="CalamityBoneCleaver",Name="Calamity Bone Cleaver"},
 FissureSlam={Boss="DemonicChimera",Kind="Spell",Reward="FissureSlam",Name="Fissure Slam"},
 BaizeTessen={Boss="VenerableBaize",Kind="Weapon",Reward="WarFan",Name="Iron Tessen of the Frosted Ridge"},
 BaizeWindSlash={Boss="VenerableBaize",Kind="Spell",Reward="WindSlash",Name="Wind-Cutting Slash"},
 TitanOdachi={Boss="SlumberingTitan",Kind="Weapon",Reward="Odachi",Name="Colossal Odachi of the Crypt"},
 TitanGraveTendrils={Boss="SlumberingTitan",Kind="Spell",Reward="GraveTendrils",Name="Grave Tendrils"},
 WuSpellStaff={Boss="SovereignWu",Kind="Weapon",Reward="Catalyst",Name="Starless Jade Spell Staff"},
 WuBlackflameSurge={Boss="SovereignWu",Kind="Spell",Reward="BlackflameSurge",Name="Blackflame Surge"},
 HeavenPiercingGuandao={Boss="TwinSentinels",Kind="Weapon",Reward="HeavenPiercingGuandao",Name="Heaven-Piercing Guandao"},
 Thunderfall={Boss="TwinSentinels",Kind="Spell",Reward="Thunderfall",Name="Thunderfall"},
 WyrmChainScythe={Boss="AzureWyrm",Kind="Weapon",Reward="ChainScythe",Name="Azure Chain Scythe"},
 WyrmDragonsMaw={Boss="AzureWyrm",Kind="Spell",Reward="DragonsMaw",Name="Dragon's Maw"},
} :: {[string]: Recipe}
-- Batch 16: the two Sanctuary caches moved onto deliberate routes (SanctuaryRoutes): the eaves deck
-- past the loggia roof line (it sat inside the roof ridge) and the cloud isle off the descent pavilion.
Catalog.Caches={
 WaterfallAlcove={Name="Waterfall Alcove",Region="DesecratedMonastery",X=-140,Y=5,Z=-840,Weapon="ChainScythe",Spells={"HeavenlyLightningSpear"}},
 PagodaRafters={Name="High Pagoda Rafters",Region="DesecratedMonastery",X=92,Y=30,Z=-1000,Weapon="TwinDaggers",Spells={"DragonsMaw"},Extras={"Dao"}},
 SealedMausoleum={Name="Sealed Mausoleum",Region="DesecratedMonastery",X=-110,Y=3,Z=-1060,Weapon="Odachi",Spells={"GraveTendrils","BlackflameSurge"},Extras={"Guandao"}},
 SanctuaryEaves={Name="Loggia Eaves",Region="Sanctuary",X=-76,Y=617,Z=923,Weapon="WarFan",Spells={"JadeAegis","CelestialSupernova"}},
 SanctuaryReliquary={Name="Cloud Reliquary",Region="Sanctuary",X=46,Y=605,Z=988,Weapon="Catalyst",Spells={"EmberCataclysm","BlazingSunAwakening"}},
} :: {[string]: Cache}
-- Practical use, authored as words only: every number on an Arsenal card is derived from
-- SpellSchema / WeaponSchema and the scaling rules (ArsenalFacts), never written here.
Catalog.SpellUses={
 ThunderclapPalm="Close-range burst that staggers whoever is in front of you; punishes a foe mid-swing.",
 HeavenlyLightningSpear="Long piercing bolt for picking off foes at range or lining up several at once.",
 DragonsMaw="Short flame cone that keeps burning; best against foes who stay in front of you.",
 EmberCataclysm="Calls fire pillars onto nearby foes in turn; strong against groups, slow to come out.",
 BlackflameSurge="Wide void sweep that hits through a raised guard.",
 GraveTendrils="Roots foes where they stand, opening them to follow-up strikes or escape.",
 JadeAegis="Defensive seal on yourself that saves you from one posture break.",
 GaleStep="Instant dash that leaves a phantom behind; repositions or escapes a combo.",
 AbbotDirge="Lingering dirge around you that interrupts and saps stamina from anyone close.",
 FissureSlam="Ground-splitting line that breaks posture hard and leaves burning ground.",
 Thunderfall="Hurls lightning at a distant point and carries you to it.",
 WindSlash="Cheap ranged cut for chip damage between melee exchanges.",
 CelestialSupernova="Rise into the void and call a column of starlight down on everything around you; a long, punishable channel.",
 BlazingSunAwakening="Clench, ignite and blast a fire shockwave, then keep burning heat rings pulsing where you stood.",
} :: {[string]: string}
Catalog.WeaponUses={
 Unarmed="Fast, close palm strikes; scales with Strength.",
 Jian="Balanced one-handed sword with quick strings; a reliable all-rounder.",
 Dao="Heavier one-handed sabre: slightly slower, harder-hitting cuts.",
 Guandao="Two-handed glaive that controls space with long sweeps; scales with Strength.",
 Odachi="Colossal blade: slow, very long reach and crushing hits; scales with Strength.",
 TwinDaggers="Light, fast sai built for aggression and devastating rear strikes.",
 ChainScythe="Longest reach in the arsenal; whips foes from a safe distance.",
 WarFan="Light defensive fan whose guard can turn projectiles aside.",
 Catalyst="Spell staff: strengthens and quickens sorcery, light in melee.",
 PrayerOfTheDefiled="Shen's two-handed relic; reflects posture damage back at attackers.",
 CalamityBoneCleaver="The Chimera's colossal cleaver: slow, enormous hits; scales with Strength.",
 HeavenPiercingGuandao="General Zhao's lightning glaive; long reach, scales with Strength.",
} :: {[string]: string}
Catalog.BossTokens={GrandmasterShen={"GrandmasterShen","DemonicChimera"}} :: {[string]: {string}}
-- Retired encounter ids still found in old profiles map to the sovereign that now carries their
-- rewards: the Ash Pagoda General's lightning glaive and Thunderfall belong to General Zhao.
Catalog.LegacyBosses={AshPagodaGeneral="TwinSentinels"} :: {[string]: string}
-- Forge card state lines (words only; %s is the sovereign's name).
Catalog.ForgeStates={Ready="Remembrance held: forging is permanent and spends it",Spent="Already forged from this remembrance",
 Owned="Already yours: choose this soul's other gift",Locked="Defeat %s to earn its remembrance"} :: {[string]: string}
-- Display order in Gao's forge: the six sovereigns, Shen's Chimera token after Shen.
Catalog.TokenOrder={"GrandmasterShen","DemonicChimera","VenerableBaize","SlumberingTitan","SovereignWu","TwinSentinels","AzureWyrm"} :: {string}
local function freeze(t: any)
 for _,v in t do if type(v)=="table" then freeze(v) end end
 table.freeze(t)
end
freeze(Catalog)
return Catalog
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ArsenalFacts</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/ArsenalFacts
-- Text for Arsenal cards, derived from the live schemas and the same scaling the server applies:
-- spell targeting/effects/cost from SpellSchema (+ SpellRules focus, LevelPreview SpellScale), and
-- weapon style plus a comparison with the wielded weapon from WeaponSchema, MoveSchema.damage and
-- CombatRules.scalingAttribute with the player's attributes and per-weapon forge tier. Words that
-- describe a spell's or weapon's role live in ArsenalCatalog; numbers never do.
local hasScript = pcall(function() return script.Parent end)
local function load(name: string, sim: boolean): any
	if hasScript then
		local root = (script :: any).Parent
		return require(if sim then root.Parent.Simulation[name] else root[name])
	end
	return nil
end
local Spells: any = load("SpellSchema", true) or require("../simulation/SpellSchema")
local Weapons: any = load("WeaponSchema", true) or require("../simulation/WeaponSchema")
local Moves: any = load("MoveSchema", true) or require("../simulation/MoveSchema")
local Combat: any = load("CombatRules", true) or require("../simulation/CombatRules")
local SpellRules: any = load("SpellRules", true) or require("../simulation/SpellRules")
local Preview: any = load("LevelPreview", false) or require("./LevelPreview")
local Catalog: any = load("ArsenalCatalog", false) or require("./ArsenalCatalog")

local Facts = {}

export type Context = { Attributes: { [string]: number }, Reinforcement: { [string]: number }, Mainhand: string, Offhand: string? }
export type Lines = { Use: string, Detail: string, Effects: string }

local GRIP: { [string]: string } = { Fist = "bare-handed", OneHanded = "one-handed", TwoHanded = "two-handed" }

local function num(n: number): string
	local r = math.floor(n * 10 + 0.5) / 10
	return if r % 1 == 0 then string.format("%d", r) else string.format("%.1f", r)
end

-- Spell potency exactly as SpellRules.begin computes it: weapon focus × Arcane Qi SpellScale.
function Facts.potency(ctx: Context): (number, boolean)
	local focus, quick = SpellRules.focus({ Weapon = ctx.Mainhand }, if ctx.Offhand ~= "None" then ctx.Offhand else nil)
	local tier = ctx.Reinforcement[ctx.Mainhand] or 0
	return focus * Preview.derived(ctx.Attributes, tier).SpellScale, quick
end

function Facts.targeting(s: any): string
	if s.Shape == "Self" then
		return if s.Status.Teleport then "Self · dash " .. num(s.Range) .. " studs" else "Self"
	elseif s.Shape == "Cone" then
		return string.format("Cone %d° · %s studs", s.Arc, num(s.Range))
	elseif s.Shape == "Line" then
		return (if s.Speed &gt; 0 then "Projectile · " else "Line · ") .. num(s.Range) .. " studs" .. (if s.Pierces then " · pierces" else "")
	elseif s.Shape == "Pillars" then
		return string.format("%d pillar%s on foes within %s studs", s.Pulses, if s.Pulses == 1 then "" else "s", num(s.Range))
	elseif s.Shape == "Column" then
		return "Column of light around you · radius " .. num(s.Radius)
	elseif s.Shape == "Aura" then
		return "Aura around you · radius " .. num(s.Range)
	end
	return "Strike " .. num(s.Range) .. " studs away · blast radius " .. num(s.Radius)
end

function Facts.effects(s: any, potency: number): string
	local parts: { string } = {}
	if s.Damage &gt; 0 then
		local hits = if s.Pulses &gt; 1 then string.format(" × %d", s.Pulses) else ""
		table.insert(parts, num(s.Damage * potency) .. " damage" .. hits)
		table.insert(parts, num(s.Posture * potency) .. " posture")
	end
	local st = s.Status
	if st.Burn &gt; 0 then table.insert(parts, "+" .. st.Burn .. " burn") end
	if st.Root &gt; 0 then table.insert(parts, "roots " .. num(st.Root) .. "s") end
	if st.Interrupt then table.insert(parts, "interrupts (" .. num(SpellRules.InterruptSeconds) .. "s stagger)") end
	if st.IgnoreGuard then table.insert(parts, "ignores guard") end
	if st.Drain &gt; 0 then table.insert(parts, "−" .. num(st.Drain) .. " stamina per hit") end
	if st.Ward then table.insert(parts, "blocks your next posture break for " .. SpellRules.WardSeconds .. "s") end
	if st.Teleport and s.Shape ~= "Self" then table.insert(parts, "carries you to the target") end
	if st.Decoy then table.insert(parts, "leaves a phantom decoy") end
	return table.concat(parts, " · ")
end

function Facts.spell(id: string, ctx: Context): Lines
	local s = assert(Spells.get(id), "Unknown spell")
	local potency, quick = Facts.potency(ctx)
	local cast = Spells.timing(s, quick).Startup
	return {
		Use = Catalog.SpellUses[id] or "",
		Detail = string.format("%s  ·  %d Qi  ·  %ss cooldown  ·  %ss cast", Facts.targeting(s), s.QiCost, num(s.Cooldown), string.format("%.2f", cast)),
		Effects = Facts.effects(s, potency),
	}
end

-- Damage a facing hit deals with this weapon in hand, before infusion and injuries.
function Facts.hit(id: string, move: any, ctx: Context): number
	local derived = Preview.derived(ctx.Attributes, ctx.Reinforcement[id] or 0)
	local scale = if Combat.scalingAttribute(id) == "Strength" then derived.StrengthScale else derived.DexterityScale
	return Moves.damage(move.BaseDamage, nil) * scale
end

-- Seconds keep two decimals (swings differ by hundredths); other values one.
local function versus(label: string, mine: number, theirs: number, unit: string, better: boolean): string
	local fine = unit == "s"
	local function show(n: number): string return if fine then string.format("%.2f", n) else num(n) end
	local delta = mine - theirs
	local same = math.abs(delta) &lt; (if fine then 0.005 else 0.05)
	local sign = if same then "=" elseif delta &gt; 0 then "+" .. show(delta) else "−" .. show(-delta)
	return string.format("%s %s%s (%s)", label, show(mine), unit, sign) .. (if same then "" elseif better then " ▲" else " ▼")
end

-- Special properties a weapon has beyond the defaults WeaponSchema.build fills in.
function Facts.traits(w: any): { string }
	local list: { string } = {}
	if (w.CriticalMultiplier or 1.5) ~= 1.5 then table.insert(list, "rear hits ×" .. num(w.CriticalMultiplier)) end
	if (w.SpellPotency or 1) &gt; 1 then table.insert(list, "spells ×" .. string.format("%.2f", w.SpellPotency)) end
	if w.QuickCast then table.insert(list, "faster casting") end
	if w.ProjectileParry then table.insert(list, "guard turns projectiles") end
	if (w.PostureReflect or 0) &gt; 0 then table.insert(list, "reflects " .. num(w.PostureReflect * 100) .. "% posture damage") end
	return list
end

function Facts.weapon(id: string, ctx: Context): Lines
	local w = Weapons.get(id)
	local light, heavy = w.Light[1], w.Heavy
	local attribute = Combat.scalingAttribute(id)
	local detail = string.format("%s · %s · %s weight · reach %s · %d-hit string · scales with %s",
		w.Stance or "Balanced", GRIP[w.Grip] or w.Grip, w.WeightClass or "Medium", num(w.Reach), #w.Light, attribute)
	local traits = Facts.traits(w)
	if #traits &gt; 0 then detail ..= " · " .. table.concat(traits, " · ") end
	local mine = { Facts.hit(id, light, ctx), Facts.hit(id, heavy, ctx), w.Reach, light.Timing.TotalSeconds }
	local effects: string
	if id == ctx.Mainhand then
		effects = string.format("Wielded · light %s · heavy %s · light swing %.2fs · art %s (%d Qi)", num(mine[1]), num(mine[2]), mine[4], w.WeaponArt.Name, w.WeaponArt.QiCost)
	else
		local e = Weapons.get(ctx.Mainhand)
		local theirs = { Facts.hit(ctx.Mainhand, e.Light[1], ctx), Facts.hit(ctx.Mainhand, e.Heavy, ctx), e.Reach, e.Light[1].Timing.TotalSeconds }
		effects = "vs " .. e.Name .. ": " .. table.concat({
			versus("light", mine[1], theirs[1], "", mine[1] &gt; theirs[1]),
			versus("heavy", mine[2], theirs[2], "", mine[2] &gt; theirs[2]),
			versus("reach", mine[3], theirs[3], "", mine[3] &gt; theirs[3]),
			versus("swing", mine[4], theirs[4], "s", mine[4] &lt; theirs[4]),
		}, " · ")
	end
	return { Use = Catalog.WeaponUses[id] or "", Detail = detail, Effects = effects }
end

-- Context from an ArsenalIntent inventory packet and the player's published attributes.
function Facts.context(inv: any, attributes: { [string]: number }): Context
	return { Attributes = attributes, Reinforcement = inv.reinforcement or {}, Mainhand = inv.mainhand or "Unarmed", Offhand = inv.offhand }
end

return table.freeze(Facts)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ArsenalProtocol</string>
            <string name="Source">--!strict
local Protocol={}
local FIELDS: {[string]: {[string]: boolean}}={State={action=true},UseTalisman={action=true},Cast={action=true,slot=true},Forge={action=true,id=true},
 EquipSpell={action=true,id=true,slot=true},EquipWeapon={action=true,id=true,offhand=true}}
function Protocol.valid(packet: any): boolean
 if type(packet)~="table" or type(packet.action)~="string" then return false end
 local fields=FIELDS[packet.action];if not fields then return false end
 local count=0;for key in packet do if not fields[key] then return false end;count+=1 end
 local expected=if (packet.action=="State" or packet.action=="UseTalisman") then 1 elseif packet.action=="EquipSpell" or packet.action=="EquipWeapon" then 3 else 2
 if count~=expected then return false end
 if fields.slot and packet.slot~=1 and packet.slot~=2 then return false end
 if fields.id and (type(packet.id)~="string" or #packet.id&lt;1 or #packet.id&gt;48 or not string.match(packet.id,"^[%w_]+$")) then return false end
 if fields.offhand and type(packet.offhand)~="boolean" then return false end
 return true
end
return table.freeze(Protocol)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">AshColosseumLayout</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/AshColosseumLayout
-- Grandmaster Shen's campaign colosseum (batch 18, findings #22 #27 #28 #32) - the ruined martial
-- arena of his order, distinct from the Sanctuary's PvP rings. Walked north to south (-Z):
--   Bamboo Pass join -&gt; ash road between toppled champion statues -&gt; Colosseum Antechamber (a roofless
--   gatehouse raised three steps: altar pocket) -&gt; Hall of Champions colonnade (two swordsmen, one
--   per half, a broken wall between) -&gt; the facade and fog gate -&gt; Shen's arena (BossArenas floor,
--   x -60..60, z -1895..-2025) inside a five-tier cavea -&gt; Victor's gate through the south tiers -&gt;
--   ashen causeway -&gt; the Celestial Pagoda's cloud stair.
-- The podium wall is low (3) and the first tier starts 12 studs beyond the arena edge, so the camera
-- keeps its distance on both of Shen's forms (the facade stands 18 north of the arena); the fog
-- gate, phases and IDs are unchanged.
-- Batch 24: the Proving Court east of the ash road encloses the existing PvP ring Ring_OctagonOfAsh
-- (ColosseumService, centre 118,0,-1770, threshold apothem 28), which the batch 18 veil had shut out.
local hasScript = pcall(function() return script.Parent end)
local L: any = if hasScript then (require(script.Parent.RegionLayout) :: any) else (require("./RegionLayout") :: any)

local r = L.region("AshColosseum")
local VEIL_H = 220
local AX, AS = 60, -2025 -- arena half-width and south edge (its north edge is z -1895)

L.slab(r, "AshGround", "Ash", -180, 180, -1680, -2120, -0.1, 6)
L.slab(r, "AshRoad", "Basalt", -8, 8, -1680, -1704, 0.2, 1)
-- Antechamber: raised floor, three steps in and out, broken side and end walls with doorways.
L.slab(r, "AntechamberFloor", "Basalt", -36, 36, -1712, -1768, 3, 4)
L.stairs(r, "AntechamberSteps", "Basalt", 0, -1704, 0, -1712, 0.2, 3, 16, 0.95)
L.stairs(r, "AntechamberSteps", "Basalt", 0, -1768, 0, -1776, 3, 0.2, 16, 0.95)
for _, side in { -1, 1 } do
	L.wall(r, "AnteWall", "Stone", side * 37, -1710, side * 37, -1770, 0, 12, 2)
	L.wall(r, "AnteFront", "Stone", side * 8, -1711, side * 37, -1711, 3, 10, 2)
	L.wall(r, "AnteBack", "Stone", side * 8, -1769, side * 37, -1769, 3, 10, 2)
	L.box(r, "Pillar", "Stone", side * 9.5, 11, -1711, 3, 16, 3) -- doorway jambs
	L.box(r, "Pillar", "Stone", side * 9.5, 11, -1769, 3, 16, 3)
	L.box(r, "StatuePlinth", "Basalt", side * 20, 2, -1694, 6, 4, 6)
end
-- Hall of Champions: colonnade, toppled columns as cover, and a broken wall between the two foes.
L.slab(r, "HallFlags", "Basalt", -8, 8, -1776, -1880, 0.2, 1)
for _, side in { -1, 1 } do
	for _, z in { -1792, -1816, -1840, -1864 } do
		L.box(r, "Pillar", "Stone", side * 30, 8, z, 3, 16, 3)
	end
	L.wall(r, "BrokenWall", "Stone", side * 12, -1814, side * 40, -1814, 0, 3, 2)
	L.wall(r, "HallWall", "Stone", side * 52, -1772, side * 52, -1876, 0, 14, 2)
end
L.box(r, "ToppledColumn", "Stone", -18, 1.5, -1800, 3, 3, 16, 64)
L.box(r, "ToppledColumn", "Stone", 26, 1.5, -1834, 3, 3, 16, 118)
-- The facade, 18 studs north of the arena so the camera keeps its distance, with the fog gate's
-- passage (30 wide) through its centre bay.
for _, side in { -1, 1 } do
	L.wall(r, "Facade", "Stone", side * 15, -1877, side * 116, -1877, 0, 22, 3)
	L.box(r, "GateTower", "Stone", side * 18, 14, -1874, 6, 28, 6)
	L.wall(r, "GatePassage", "Stone", side * 16, -1878, side * 16, -1892, 0, 14, 2)
end
-- Cavea: a low podium wall, then five tiers (4 high, 8 deep) starting 12 beyond the arena edge;
-- the south tiers part for Victor's gate.
for _, side in { -1, 1 } do
	L.wall(r, "Podium", "Basalt", side * (AX + 3), -1879, side * (AX + 3), AS - 3, 0, 3, 1.5)
	L.wall(r, "Podium", "Basalt", side * 14, AS - 3, side * (AX + 3), AS - 3, 0, 3, 1.5)
	for k = 1, 5 do
		local inner, top = 12 + (k - 1) * 8, 4 * k
		local x0, z1 = AX + inner, AS - inner - 8
		L.box(r, "Tier", "Basalt", side * (x0 + 4), top / 2, (-1879 + z1) / 2, 8, top, -1879 - z1)
		L.box(r, "Tier", "Basalt", side * (14 + x0) / 2, top / 2, AS - inner - 4, x0 - 14, top, 8)
	end
	L.box(r, "VictorJamb", "Stone", side * 16, 10, AS - 10, 4, 20, 4)
end
L.slab(r, "Causeway", "Basalt", -10, 10, AS - 3, -2120, 0.2, 1)
L.slab(r, "CourtLane", "Basalt", 30, 84, -1686, -1702, 0.2, 1)

for _, l in { { -14, -0.1, -1692 }, { 14, -0.1, -1692 }, { -28, 3, -1720 }, { 28, 3, -1720 }, { -28, 3, -1760 }, { 28, 3, -1760 },
	{ -12, -0.1, -1872 }, { 12, -0.1, -1872 }, { -13, -0.1, -2052 }, { 13, -0.1, -2052 },
	{ 84, -0.1, -1712 }, { 152, -0.1, -1712 }, { 84, -0.1, -1804 }, { 152, -0.1, -1804 } } do
	L.lantern(r, l[1], l[2], l[3])
end

L.fence(r, "Veil", "Veil", { { -30, -1680 }, { -30, -1708 }, { -40, -1708 }, { -40, -1772 }, { -54, -1772 }, { -54, -1876 }, { -116, -1876 },
	{ -116, -2080 }, { -16, -2080 }, { -16, -2120 } }, -10, VEIL_H, 2)
L.fence(r, "Veil", "Veil", { { 30, -1680 }, { 156, -1680 }, { 156, -1808 }, { 80, -1808 }, { 80, -1708 }, { 40, -1708 }, { 40, -1772 }, { 54, -1772 }, { 54, -1876 }, { 116, -1876 },
	{ 116, -2080 }, { 16, -2080 }, { 16, -2120 } }, -10, VEIL_H, 2)

L.mark(r, "Altar", "Colosseum Antechamber", 0, 3, -1736)
L.mark(r, "ArenaMouth", "Shen's fog gate", 0, 0.2, -1880)
L.mark(r, "VictorGate", "Victor's gate", 0, 0.2, -2040)
L.mark(r, "NorthJoin", "Ash road", 0, 0.2, -1682)
L.mark(r, "SouthJoin", "Cloud stair", 0, 0.2, -2118)
L.mark(r, "ProvingRing", "The Octagonal Ring of Ash", 118, 0, -1770)

L.zone(r, "AC_Road", "the ash road", -30, 30, -1680, -1708)
L.zone(r, "AC_Ante", "the antechamber", -40, 40, -1708, -1774)
L.zone(r, "AC_HallN", "the hall of champions", -52, 52, -1774, -1814)
L.zone(r, "AC_HallS", "the hall of champions", -52, 52, -1814, -1877)
L.zone(r, "AC_Arena", "Shen's arena", -116, 116, -1877, AS - 3)
L.zone(r, "AC_South", "the ashen causeway", -16, 16, AS - 3, -2120)
-- The court is L-shaped (its veil turns at x 80): the walk along the north wall, then the ring yard.
L.zone(r, "AC_CourtWalk", "the proving court", 30, 156, -1680, -1708)
L.zone(r, "AC_Court", "the proving court", 80, 156, -1708, -1808)
L.door(r, "AC_Road", "AC_Ante", 0, 0.2, -1708, "Antechamber steps")
L.door(r, "AC_Ante", "AC_HallN", 0, 0.2, -1774, "Hall of Champions")
L.door(r, "AC_HallN", "AC_HallS", 0, 0.2, -1814, "Broken wall")
L.door(r, "AC_HallS", "AC_Arena", 0, 0.2, -1877, "Shen's fog gate")
L.door(r, "AC_Arena", "AC_South", 0, 0.2, AS - 3, "Victor's gate")
L.door(r, "AC_South", "CP_Stair", 0, 0.2, -2120, "Cloud stair")
L.door(r, "AC_Road", "AC_CourtWalk", 30, 0.2, -1694, "Proving court")
L.door(r, "AC_CourtWalk", "AC_Court", 118, 0.2, -1708, "Ring yard")
r.SpawnZones = { AC_Swordsman_Gate_A = "AC_HallN", AC_Swordsman_Gate_B = "AC_HallS" }

r.Groves = {} -- no bamboo here: ash, basalt and ruin

return L.freeze(r)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">BambooPassLayout</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/BambooPassLayout
-- Bamboo Pass (batch 17, findings #22 #27 #28 #32 #44). Walked north to south (-Z):
--   Monastery road -&gt; Bamboo Gate clearing (tablet V, first swordsman) -&gt; ridge stairs to the
--   frosted crest (y 12, monk) -&gt; shrine stairs -&gt; Whispering Bamboo Shrine pocket (altar) -&gt;
--   Baize's mouth -&gt; Baize's arena (BossArenas floor, frost pillars) -&gt; south moon gate -&gt; ash
--   descent (monk) -&gt; Ash Colosseum road.
-- Optional: three frost stones off the crest's east lip climb to the Frost Ridge (y 18), which
-- walls the arena's east side: two swordsmen, an overlook into the arena and tablet VI; the way
-- back is a one-way drop onto the shrine ground. Everything outside the walked network is bamboo
-- thicket behind an invisible veil (collides, ignored by cameras), so double jump and glide stay
-- inside the pass. Arena floors stay at y 0 (boss motion and attacks assume it).
local hasScript = pcall(function() return script.Parent end)
local L: any = if hasScript then (require(script.Parent.RegionLayout) :: any) else (require("./RegionLayout") :: any)

local r = L.region("BambooPass")
local VEIL_H = 220

-- Ground and the raised crest/ridge masses.
L.slab(r, "PassGround", "Grass", -200, 200, -1120, -1680, -0.1, 6) -- just under the arena floor (top 0)
L.slab(r, "TrailFlags", "Path", -6, 6, -1120, -1226, 0.2, 1)
L.slab(r, "FrostedCrest", "Snow", -40, 34, -1250, -1292, 12, 14)
L.slab(r, "CrestButtress", "Rock", 34, 42, -1244, -1252, 12, 14) -- closes the stone pocket's north end
L.stairs(r, "RidgeStair", "Path", 0, -1226, 0, -1250, 0, 12, 12)
L.stairs(r, "ShrineStair", "Path", 0, -1292, 0, -1316, 12, 0, 12)
L.slab(r, "ShrineFlags", "Path", -50, -22, -1316, -1340, 0.2, 1)
L.slab(r, "MouthFlags", "Path", -14, 14, -1340, -1378, 0.2, 1)
L.slab(r, "MoonGateFlags", "Path", -14, 14, -1562, -1680, 0.2, 1)
-- Frost Ridge: north ledge (y 18), the ridge above the arena's east side, the high shoulder that
-- closes it to the south (y 36, not climbable without the double jump that the veil then stops).
L.slab(r, "RidgeNorth", "Snow", 58, 160, -1246, -1290, 18, 20)
L.slab(r, "RidgeMass", "Rock", 106, 160, -1290, -1440, 18, 20)
L.slab(r, "RidgeShoulder", "Rock", 106, 160, -1440, -1582, 36, 38)
for i, s in { { 39, 13.5, -1268 }, { 46, 15, -1270 }, { 53, 16.5, -1268 } } do
	L.box(r, "FrostStone" .. i, "Snow", s[1], s[2] - 2, s[3], 4, 4, 4, i * 17)
end
L.slab(r, "OverlookFlags", "Path", 108, 150, -1392, -1432, 18.2, 1)
L.wall(r, "OverlookParapet", "Stone", 106.8, -1388, 106.8, -1436, 18, 2.6, 1.4)

-- Arena surround, 14+ studs off the arena edge so the camera keeps its distance: the bamboo palisade
-- (west, north and south), the ridge face (east), the north mouth and the south moon gate.
for _, w in { { -104, -1366, -104, -1574 }, { -104, -1366, -16, -1366 }, { 16, -1366, 106, -1366 }, { -104, -1574, -16, -1574 }, { 16, -1574, 106, -1574 } } do
	L.wall(r, "Palisade", "Timber", w[1], w[2], w[3], w[4], 0, 7, 1.6)
end
-- Gates: the Bamboo Gate (timber torii posts), the shrine posts, the moon gate jambs.
for _, x in { -9, 9 } do
	L.box(r, "GatePost", "Lacquer", x, 8, -1150, 1.6, 16, 1.6)
	L.box(r, "MoonJamb", "Stone", x * 1.9, 9, -1577, 3, 18, 3)
	L.box(r, "MouthPost", "Lacquer", x * 1.75, 7, -1366, 2, 14, 2)
end
L.box(r, "ShrineHall", "Timber", -36, 4.5, -1346, 18, 9, 1.4) -- back screen of the shrine pocket

-- Boundary veil around the walked network.
L.fence(r, "Veil", "Veil", { { -40, -1120 }, { -40, -1296 }, { -66, -1296 }, { -66, -1344 }, { -108, -1344 }, { -108, -1582 }, { -30, -1582 }, { -30, -1680 } }, -10, VEIL_H, 2)
L.fence(r, "Veil", "Veil", { { 40, -1120 }, { 40, -1246 }, { 162, -1246 }, { 162, -1582 }, { 30, -1582 }, { 30, -1680 } }, -10, VEIL_H, 2)

-- Lantern posts at the turns: gate, crest stair head, shrine, Baize's mouth, moon gate, overlook.
for _, l in { { -12, -0.1, -1166 }, { 12, -0.1, -1166 }, { -14, 12, -1254 }, { 14, 12, -1254 }, { -52, 0.2, -1320 }, { -22, -0.1, -1358 },
	{ 22, -0.1, -1358 }, { -20, -0.1, -1590 }, { 20, -0.1, -1590 }, { 112, 18.2, -1430 } } do
	L.lantern(r, l[1], l[2], l[3])
end

-- Points the server and the suite read.
L.mark(r, "Lore_Bamboo", "V · Jade in the Roots", -18, 3, -1140)
L.mark(r, "Lore_Wraith", "VI · What Death Cannot Keep", 128, 21.2, -1428)
L.mark(r, "Altar", "Whispering Bamboo Shrine", -36, 0.2, -1328)
L.mark(r, "Overlook", "Frost Ridge overlook", 112, 18.2, -1410, 270)
L.mark(r, "ArenaMouth", "Baize's mouth", 0, 0.2, -1362)
L.mark(r, "SouthJoin", "Ash road", 0, 0.2, -1678)
L.mark(r, "NorthJoin", "Monastery road", 0, 0.2, -1122)

-- Wayfinding zones (Z0 north edge &gt; Z1 south edge) and doors.
L.zone(r, "BP_Gate", "the bamboo gate", -40, 40, -1120, -1226)
L.zone(r, "BP_Crest", "the frosted crest", -40, 34, -1226, -1292)
L.zone(r, "BP_Shrine", "the whispering shrine", -66, 106, -1292, -1366)
L.zone(r, "BP_Arena", "Baize's arena", -108, 106, -1366, -1582)
L.zone(r, "BP_South", "the ash descent", -30, 30, -1582, -1680)
L.zone(r, "BP_Ridge", "the frost ridge", 34, 160, -1246, -1440)
L.door(r, "DM:Road", "BP_Gate", 0, 0.2, -1120, "Bamboo Gate")
L.door(r, "BP_Gate", "BP_Crest", 0, 0.2, -1226, "Ridge stairs")
L.door(r, "BP_Crest", "BP_Shrine", 0, 0.2, -1316, "Shrine stairs")
L.door(r, "BP_Shrine", "BP_Arena", 0, 0.2, -1366, "Baize's mouth")
L.door(r, "BP_Arena", "BP_South", 0, 0.2, -1580, "Moon gate")
L.door(r, "BP_South", "AC_Road", 0, 0.2, -1680, "Ash road")
L.door(r, "BP_Crest", "BP_Ridge", 36, 12, -1268, "Frost stones", nil, true)
L.door(r, "BP_Ridge", "BP_Shrine", 70, 0.2, -1292, "Ridge drop", true)
r.SpawnZones = {
	BP_Swordsman_Trail_A = "BP_Gate", BP_Monk_Trail = "BP_Crest", BP_Swordsman_Grove_A = "BP_Ridge",
	BP_Swordsman_Grove_B = "BP_Ridge", BP_Monk_Ridge = "BP_South",
}

-- Bamboo scatter {x0, x1, z0, z1, floor, stalks}: thickets hug the veil so the edge reads as a wall.
r.Groves = {
	{ -200, -44, -1120, -1294, 0, 150 }, { -200, -112, -1300, -1680, 0, 150 }, { -104, -34, -1586, -1680, 0, 40 },
	{ 44, 200, -1120, -1242, 0, 110 }, { 166, 200, -1242, -1680, 0, 70 }, { 34, 200, -1586, -1680, 0, 60 },
	{ 146, 158, -1300, -1386, 18, 20 }, { 110, 158, -1444, -1578, 36, 40 },
}

return L.freeze(r)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">BossAnimationRules</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/BossAnimationRules
-- The boss animation contract (F10): one resolver for every boss actor, phase and attack. A slot
-- key is "&lt;LookKey&gt;_P&lt;phase&gt;_&lt;Action&gt;" where Action is Idle, Strike (ordinary weapon moves),
-- Transform (phase change / Twins' oath) or a BossAttackCatalog move id. Each request walks
--   &lt;Look&gt;_P&lt;n&gt;_&lt;Action&gt;, &lt;Look&gt;_&lt;Action&gt;, then (attacks only) &lt;Look&gt;_P&lt;n&gt;_Strike, &lt;Look&gt;_Strike
-- and at each key takes, in order: the actor's AsuraBossAnimation_&lt;key&gt; attribute (copied by
-- BossAppearance from ServerStorage.AsuraAssets.AsuraBossAnimations, so it survives phase changes
-- and retries), then an authored id in `Custom` below (Shen's four legacy AnimationCatalog slots
-- count too). With nothing authored a humanoid plays the stock stand-in for the move's kind and a
-- creature keeps its procedural CreatureMotion pose. Animation is cosmetic only: no gameplay
-- reads tracks or markers; damage stays on the server's impact times.
local hasScript = pcall(function() return script.Parent end)
local Catalog: any, Attacks: any
if hasScript then
	Catalog, Attacks = require(script.Parent.AnimationCatalog), require(script.Parent.BossAttackCatalog)
else
	Catalog, Attacks = require("./AnimationCatalog"), require("./BossAttackCatalog")
end

local Rules = {}

export type Source = "Override" | "Custom" | "Stock" | "Procedural"
export type Resolved = { Key: string, Id: string?, Source: Source, Speed: number, Looped: boolean, Priority: string }

-- Paste published ids here ("rbxassetid://&lt;digits&gt;") under the slot key, e.g.
-- ["SovereignWu_P1_SoulSpears"] = "rbxassetid://1234567890". Empty means nothing is authored yet.
Rules.Custom = table.freeze({} :: { [string]: string })

-- Move lists per look and phase (the Twins' survivor also borrows the partner's on the oath).
Rules.Moves = table.freeze({
	GrandmasterShen = { "Shen", "Chimera" }, GeneralZhao = { "Zhao" }, IronBull = { "Bull" },
	VenerableBaize = { "Baize", "Baize" }, SlumberingTitan = { "Titan", "Titan" },
	SovereignWu = { "Wu", "Wu" }, AzureWyrm = { "Wyrm", "Wyrm" },
} :: { [string]: { string } })
Rules.Oath = table.freeze({ GeneralZhao = true, IronBull = true } :: { [string]: boolean })

-- Shen's original catalog slots (and their AsuraBossAnimation_&lt;legacy&gt; attributes) still count.
local LEGACY: { [string]: { Slot: string, Speed: number } } = {
	GrandmasterShen_P1_Idle = { Slot = "Shen_Phase1_Idle", Speed = 1 },
	GrandmasterShen_P2_Idle = { Slot = "Shen_Phase1_Idle", Speed = 1.4 },
	GrandmasterShen_P1_Strike = { Slot = "Shen_Phase1_SwordCombo", Speed = 1 },
	GrandmasterShen_P2_Strike = { Slot = "Shen_Phase2_GlaiveCombo", Speed = 1 },
	GrandmasterShen_P2_Transform = { Slot = "Shen_Phase2_Transform", Speed = 1 },
}

-- Stock stand-in per action/kind: { stock slot in AnimationCatalog.Enemies style, speed }.
local STOCK: { [string]: { string | number } } = {
	Idle = { "ToolHold", 1 }, Transform = { "Cheer", 0.6 }, Strike = { "ToolSlash", 1.25 },
	PerilousThrust = { "ToolLunge", 1.1 }, PerilousGrab = { "ToolLunge", 0.9 }, ShieldCharge = { "ToolLunge", 1 },
	PerilousSweep = { "ToolSlash", 1 }, Tail = { "ToolSlash", 0.9 }, Shockwave = { "ToolSlash", 0.8 }, Leap = { "ToolSlash", 0.8 },
	Barrage = { "Cheer", 1.2 }, Gravity = { "Cheer", 0.8 }, Ritual = { "Cheer", 0.7 }, Breath = { "Cheer", 0.9 },
}
local STOCK_IDS = {
	R15 = { ToolHold = Catalog.Enemies.Shen_Phase1_Idle.Fallback, ToolSlash = Catalog.Enemies.Shen_Phase1_SwordCombo.Fallback,
		ToolLunge = Catalog.Enemies.Shen_Phase2_GlaiveCombo.Fallback, Cheer = Catalog.Enemies.Shen_Phase2_Transform.Fallback },
	R6 = { ToolHold = Catalog.Enemies.Shen_Phase1_Idle.FallbackR6, ToolSlash = Catalog.Enemies.Shen_Phase1_SwordCombo.FallbackR6,
		ToolLunge = Catalog.Enemies.Shen_Phase2_GlaiveCombo.FallbackR6, Cheer = Catalog.Enemies.Shen_Phase2_Transform.FallbackR6 },
}

function Rules.validId(id: any): boolean
	return type(id) == "string" and string.match(id, "^rbxassetid://%d+$") ~= nil
end
for key, id in Rules.Custom do assert(Rules.validId(id), "BossAnimationRules.Custom." .. key .. " must be \"rbxassetid://&lt;digits&gt;\"") end

-- The kind of a catalogued boss move, for stock fallbacks when a cue does not carry it.
local KINDS: { [string]: string } = {}
for _, list in Attacks do for _, move in list do KINDS[move.Id] = move.Kind end end
function Rules.kind(move: string): string? return KINDS[move] end

local function keys(look: string, phase: number, action: string): { string }
	local list = { look .. "_P" .. phase .. "_" .. action, look .. "_" .. action }
	if action ~= "Idle" and action ~= "Transform" and action ~= "Strike" then
		table.insert(list, look .. "_P" .. phase .. "_Strike"); table.insert(list, look .. "_Strike")
	end
	return list
end

-- rig: "R15" | "R6" | "Creature"; attribute reads the actor (nil-safe for pure use).
function Rules.resolve(look: string, phase: number, action: string, kind: string?, rig: string, attribute: (string) -&gt; any): Resolved
	local looped = action == "Idle"
	local priority = if looped then "Idle" elseif action == "Transform" then "Action4" else "Action"
	for _, key in keys(look, phase, action) do
		local legacy = LEGACY[key]
		local override = attribute("AsuraBossAnimation_" .. key)
		if not Rules.validId(override) and legacy then override = attribute("AsuraBossAnimation_" .. legacy.Slot) end
		if Rules.validId(override) then
			return { Key = key, Id = override, Source = "Override", Speed = 1, Looped = looped, Priority = priority }
		end
		local custom = Rules.Custom[key] or (legacy and Catalog.Enemies[legacy.Slot].Custom)
		if custom then
			return { Key = key, Id = custom, Source = "Custom", Speed = if legacy and not Rules.Custom[key] then legacy.Speed else 1, Looped = looped, Priority = priority }
		end
	end
	local key = keys(look, phase, action)[1]
	if rig == "Creature" then
		return { Key = key, Id = nil, Source = "Procedural", Speed = 1, Looped = looped, Priority = priority }
	end
	local stock = STOCK[action] or STOCK[kind or Rules.kind(action) or "Strike"] or STOCK.Strike
	local legacy = LEGACY[look .. "_P" .. phase .. "_" .. action]
	local ids = if rig == "R6" then STOCK_IDS.R6 else STOCK_IDS.R15
	return { Key = key, Id = (ids :: any)[stock[1]], Source = "Stock", Speed = if legacy then legacy.Speed else stock[2] :: number,
		Looped = looped, Priority = priority }
end

-- Every slot this actor can request in a phase.
function Rules.slots(look: string, phase: number): { string }
	local list = { "Idle", "Strike" }
	if phase &gt; 1 or Rules.Oath[look] then table.insert(list, "Transform") end
	local sets = Rules.Moves[look]
	local set = sets and Attacks[sets[math.clamp(phase, 1, #sets)]]
	for _, move in set or {} do table.insert(list, move.Id) end
	return list
end

-- Honest one-line status for the AsuraAnimationStatus attribute.
function Rules.status(look: string, phase: number, rig: string, attribute: (string) -&gt; any): string
	local slots = Rules.slots(look, phase)
	local authored, missing = 0, nil
	for _, action in slots do
		local r = Rules.resolve(look, phase, action, nil, rig, attribute)
		if r.Source == "Override" or r.Source == "Custom" then authored += 1 elseif not missing then missing = r.Key end
	end
	if authored == #slots then return string.format("Authored %d/%d", authored, #slots) end
	return string.format("Fallback:%s %d/%d authored (first missing %s)", if rig == "Creature" then "CreatureMotion" else "Stock",
		authored, #slots, tostring(missing))
end

return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">BossArmaments</string>
            <string name="Source">--!strict
-- Apply signature loadouts after the campaign roster has finished authoring its phases.
local Armaments={}
function Armaments.apply(world: any)
 local shen=world.Bosses.GrandmasterShen
 -- The campaign duel retains its Jian -&gt; Guandao transformation; remembrance rewards remain available.
 if shen.Archetype~="Duelist" then
  shen.Phases[1].Weapon="PrayerOfTheDefiled"
  shen.Phases[2].Weapon="CalamityBoneCleaver"
 end
 -- The former "General of the Ash Pagoda" (a thunder clone of Shen's first phase in the Bamboo Pass)
 -- is retired: General Zhao of the Twin Sentinels now carries its glaive and Thunderfall, and
 -- ArsenalCatalog.LegacyBosses re-keys its old remembrance tokens and defeat records.
 world.Bosses.AshPagodaGeneral=nil
 world.FogGates.Gate_AshPagoda=nil
end
return table.freeze(Armaments)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">BossAttackCatalog</string>
            <string name="Source">--!strict
type AttackKind = "PerilousSweep" | "PerilousThrust" | "PerilousGrab" | "Shockwave" | "Barrage" | "Gravity" | "Ritual" | "Leap" | "Breath" | "Tail" | "ShieldCharge"
type Motion = "Pillar" | "Aerial" | "Lunge" | "Teleport"
type BossAttack = {
	Id: string, Kind: AttackKind, Windup: number, Radius: number, Damage: number, Posture: number,
	Height: number?, Speed: number?, Repeats: number?, Interval: number?, Duration: number?,
	Count: number?, Motion: Motion?, Element: string?, Unblockable: boolean?,
}
type GapCloser = { Range: number, Delay: number, Cooldown: number, Motion: Motion }
local function move(id: string, kind: AttackKind, radius: number, damage: number, windup: number, options: { [string]: any }?): BossAttack
	local result: any = { Id = id, Kind = kind, Radius = radius, Damage = damage, Posture = damage * 1.6, Windup = windup, Unblockable = kind ~= "Barrage" and kind ~= "ShieldCharge" }
	for key, value in options or {} do result[key] = value end
	return result :: BossAttack
end
local Catalog = {
	Shen = {
		move("FlowingJian", "PerilousThrust", 18, 15, 0.8, { Repeats = 4, Interval = 0.65, Motion = "Lunge" }),
		move("PrayerBeads", "Barrage", 90, 12, 1.1, { Count = 7, Speed = 34 }),
		move("AbbotSweep", "PerilousSweep", 16, 24, 1),
	},
	Chimera = {
		move("BloodWave", "Shockwave", 90, 30, 1.1, { Speed = 38, Height = 7, Element = "Blood" }),
		move("GuandaoSkyfall", "Leap", 28, 35, 1.5, { Motion = "Aerial", Speed = 45 }),
		move("CrimsonEmbrace", "PerilousGrab", 12, 40, 1.2),
	},
	Baize = {
		move("MeteorPounce", "Leap", 100, 32, 2.1, { Motion = "Pillar", Speed = 32, Height = 9, Duration = 2.6, Element = "Frost" }),
		move("FeralClaws", "PerilousSweep", 18, 23, 0.9),
		move("RidgeMaw", "PerilousGrab", 13, 38, 1.15),
	},
	Titan = {
		move("WorldTremor", "Shockwave", 240, 34, 1.5, { Repeats = 2, Interval = 1.15, Speed = 30, Height = 11, Element = "Earth" }),
		move("CryptHand", "PerilousGrab", 22, 48, 1.6),
		move("MagmaWake", "Ritual", 135, 25, 2, { Duration = 4, Height = 9, Element = "Magma" }),
	},
	Wu = {
		move("SoulSpears", "Barrage", 140, 19, 1.25, { Count = 5, Speed = 26, Element = "Void" }),
		move("StarlessSingularity", "Gravity", 32, 18, 1.8, { Duration = 4, Height = 10, Element = "Void" }),
		move("BloodflameRitual", "Ritual", 130, 27, 2.5, { Duration = 3.5, Height = 9, Element = "Bloodflame" }),
	},
	Zhao = {
		move("LightningSpear", "PerilousThrust", 30, 24, 0.8, { Motion = "Lunge", Repeats = 3, Interval = 0.7, Element = "Lightning" }),
		move("ThunderQuickstep", "ShieldCharge", 35, 26, 1, { Motion = "Lunge" }),
	},
	Bull = {
		move("IronCharge", "ShieldCharge", 50, 35, 1.5, { Motion = "Lunge", Element = "Iron" }),
		move("ColossalHammer", "Shockwave", 65, 34, 1.8, { Speed = 26, Height = 7, Element = "Iron" }),
	},
	Wyrm = {
		move("HeavenlyBreathRun", "Breath", 140, 36, 2, { Motion = "Aerial", Duration = 3, Height = 10, Element = "Thunder" }),
		move("AzureTail", "Tail", 28, 32, 1.15),
		move("DescendingThunder", "Leap", 110, 42, 1.8, { Motion = "Aerial", Speed = 42, Height = 9, Element = "Thunder" }),
	},
}
return Catalog
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">BossBodies</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/BossBodies
-- Authoritative body shapes for the bosses that are not upright humanoids (batches 12-13). The
-- capsules are root-relative studs at scale 1 (CharacterService.ScaleEnemy multiplies them with the
-- model), use the existing injury regions, and are what the visual creature looks are authored
-- around, so a hit that lands on the body is a hit the server sees. Also holds the arena pillar
-- layout and the pure path maths that keep the beast from clipping through it.
local Bodies = {}

export type Capsule = { Region: string, A: { number }, B: { number }, Radius: number }
export type Shape = { Capsules: { Capsule }, Box: { number }, Reach: number }
export type Pillar = { X: number, Z: number, Half: number, Top: number }

local function c(region: string, a: { number }, b: { number }, radius: number): Capsule
	return { Region = region, A = a, B = b, Radius = radius }
end

-- Box = { centreY, halfX, halfY, halfZ } broad phase; Reach = furthest capsule surface from the root.
Bodies.Shapes = table.freeze({
	-- Venerable Baize: a low frost beast, head forward, forelegs as the "arms".
	Beast = { Capsules = {
		c("Head", { 0, 0.35, -2.25 }, { 0, 0.55, -2.75 }, 0.62),
		c("Torso", { 0, -0.55, -1.25 }, { 0, -0.45, 1.45 }, 1.05),
		c("LeftArm", { -0.75, -1.2, -1.2 }, { -0.75, -2.62, -1.3 }, 0.38),
		c("RightArm", { 0.75, -1.2, -1.2 }, { 0.75, -2.62, -1.3 }, 0.38),
		c("LeftLeg", { -0.8, -1.15, 1.25 }, { -0.8, -2.58, 1.4 }, 0.42),
		c("RightLeg", { 0.8, -1.15, 1.25 }, { 0.8, -2.58, 1.4 }, 0.42),
	}, Box = { -1.0, 1.8, 2.1, 3.6 }, Reach = 3.6 },
	-- Azure Wyrm: a horned dragon on four short legs; the tail is part of the body.
	Dragon = { Capsules = {
		c("Head", { 0, 0.55, -2.55 }, { 0, 1.05, -3.35 }, 0.7),
		c("Torso", { 0, -0.6, -1.7 }, { 0, -0.4, 1.7 }, 1.15),
		c("Torso", { 0, -0.6, 2.2 }, { 0, -1.5, 5.2 }, 0.5),
		c("LeftArm", { -0.9, -1.3, -1.2 }, { -0.95, -2.6, -1.35 }, 0.4),
		c("RightArm", { 0.9, -1.3, -1.2 }, { 0.95, -2.6, -1.35 }, 0.4),
		c("LeftLeg", { -0.95, -1.3, 1.2 }, { -1.0, -2.55, 1.35 }, 0.45),
		c("RightLeg", { 0.95, -1.3, 1.2 }, { 1.0, -2.55, 1.35 }, 0.45),
	}, Box = { -0.6, 2.1, 2.4, 4.9 }, Reach = 5.8 },
})

-- World-geometry hulls (size x,y,z then centre x,y,z) that stop the long bodies at pillars and walls.
Bodies.Hulls = table.freeze({ Beast = { 2.2, 1.5, 5.0, 0, -0.45, 0.05 }, Dragon = { 2.6, 1.7, 6.2, 0, -0.45, 0.4 } })
Bodies.RootHeight = 3 -- root above the ground at scale 1 (HipHeight 2 + half the root)

function Bodies.shape(archetype: string?): Shape?
	return if archetype then (Bodies.Shapes :: any)[archetype] else nil
end

-- The frost pillars of Baize's arena (BossArenas builds them; AI and BossMotion avoid them).
function Bodies.pillars(boss: any): { Pillar }
	if not boss or boss.Archetype ~= "Beast" then return {} end
	local list: { Pillar } = {}
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			table.insert(list, { X = boss.Arena.Center.X + x * 60, Z = boss.Arena.Center.Z + z * 50, Half = 4, Top = 30 })
		end
	end
	return list
end

-- Root height standing on a pillar top: top + root height + a small gap so feet never sink.
function Bodies.perchY(pillar: Pillar, scale: number): number
	return pillar.Top + Bodies.RootHeight * scale + 0.2
end

-- Walking: if the straight line to (tx,tz) passes within `clear` of a pillar's footprint, return
-- the tangent point round the nearest such pillar on the shorter side (a path to a tangent point
-- never cuts the column's corner); otherwise the goal itself.
function Bodies.steer(fx: number, fz: number, tx: number, tz: number, pillars: { Pillar }, clear: number): (number, number)
	local dx, dz = tx - fx, tz - fz
	local length = math.sqrt(dx * dx + dz * dz)
	if length &lt; 0.5 then return tx, tz end
	local ux, uz = dx / length, dz / length
	local best, bx, bz = math.huge, tx, tz
	for _, p in pillars do
		local radius = p.Half * math.sqrt(2) + clear
		local along = (p.X - fx) * ux + (p.Z - fz) * uz
		local side = (p.X - fx) * -uz + (p.Z - fz) * ux
		if along &gt; -radius and along &lt; length + radius and math.abs(side) &lt; radius and along &lt; best then
			best = along
			local rx, rz = fx - p.X, fz - p.Z
			local d = math.sqrt(rx * rx + rz * rz)
			local wide = radius + 1
			local options: { { number } } = {}
			if d &lt;= wide then -- already in the margin: slide round the column
				for _, s in { -1, 1 } do table.insert(options, { fx - rz / d * s * wide, fz + rx / d * s * wide }) end
			else
				local base, turn = math.atan2(rz, rx), math.acos(wide / d)
				for _, s in { -1, 1 } do table.insert(options, { p.X + math.cos(base + s * turn) * wide, p.Z + math.sin(base + s * turn) * wide }) end
			end
			local cost = math.huge
			for _, o in options do
				local c = math.sqrt((o[1] - fx) ^ 2 + (o[2] - fz) ^ 2) + math.sqrt((tx - o[1]) ^ 2 + (tz - o[2]) ^ 2)
				if c &lt; cost then cost, bx, bz = c, o[1], o[2] end
			end
		end
	end
	return bx, bz
end

local function smooth(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

-- A leap that must stay at height `high` while within `clear` horizontal studs of the pillar it
-- leaves (`fromPillar`) or lands on (`toPillar`), so the body rises before it crosses the column
-- and leaves the top before it falls. u runs 0..1; points are { x, y, z }.
-- F07/F08: where a melee foe walks to engage: `stop` studs short of its target on the side it comes
-- from. Steered at the target's own root, a humanoid pushed into the player and climbed onto their
-- head (Studio: the Sparring Phantom stood 4 studs up at 0.8 flat and every swing passed beneath it).
function Bodies.closeIn(fx: number, fz: number, tx: number, tz: number, stop: number): (number, number)
	local dx, dz = fx - tx, fz - tz
	local d = math.sqrt(dx * dx + dz * dz)
	if d &lt; 1e-3 then dx, dz, d = 0, 1, 1 end
	return tx + dx / d * stop, tz + dz / d * stop
end

-- The engage point for one of two bodies closing on the same target (the Twins, F10: Zhao and the
-- Bull both stood on the same closeIn point, 0.6 studs apart): the closeIn point, swung round the
-- target until it is at least `gap` from the partner at (ox, oz).
function Bodies.flank(fx: number, fz: number, tx: number, tz: number, stop: number, ox: number, oz: number, gap: number): (number, number)
	local x, z = Bodies.closeIn(fx, fz, tx, tz, stop)
	if (x - ox) ^ 2 + (z - oz) ^ 2 &gt;= gap * gap then return x, z end
	local po = math.max(math.sqrt((ox - tx) ^ 2 + (oz - tz) ^ 2), 1e-3)
	local c = (stop * stop + po * po - gap * gap) / (2 * stop * po)
	local delta = if c &lt;= -1 then math.pi else math.acos(math.min(c, 1))
	local other = math.atan2(oz - tz, ox - tx)
	local diff = (math.atan2(z - tz, x - tx) - other + math.pi) % (2 * math.pi) - math.pi
	local angle = other + (if diff &gt;= 0 then 1 else -1) * delta
	return tx + math.cos(angle) * stop, tz + math.sin(angle) * stop
end

function Bodies.arc(from: { number }, to: { number }, high: number, clear: number, fromPillar: boolean, toPillar: boolean, u: number): { number }
	local dx, dz = to[1] - from[1], to[3] - from[3]
	local distance = math.sqrt(dx * dx + dz * dz)
	local cramped = (fromPillar or toPillar) and distance &lt;= clear * 1.05
	if cramped then
		-- Too close for a slope: rise then cross (landing), or cross then drop (leaving).
		local first, second = smooth(u * 2), smooth(u * 2 - 1)
		if toPillar then
			return { from[1] + dx * second, from[2] + (high - from[2]) * first, from[3] + dz * second }
		end
		return { from[1] + dx * first, high + (to[2] - high) * second, from[3] + dz * first }
	end
	local s = smooth(u)
	local travelled = distance * s
	local y: number
	if toPillar then
		y = from[2] + (high - from[2]) * math.clamp(travelled / math.max(distance - clear, 0.01), 0, 1) ^ 0.55
	elseif fromPillar then
		y = high + (to[2] - high) * math.clamp((travelled - clear) / math.max(distance - clear, 0.01), 0, 1) ^ 1.6
	else
		y = from[2] + (to[2] - from[2]) * s
	end
	return { from[1] + dx * s, y, from[3] + dz * s }
end

return table.freeze(Bodies)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">BossEncounterRules</string>
            <string name="Source">--!strict
local Rules = {}
Rules.ThrustWindow = 0.1
Rules.MinimumWarning = 0.65
Rules.AttackKinds = table.freeze({ PerilousSweep = true, PerilousThrust = true, PerilousGrab = true,
	Shockwave = true, Barrage = true, Gravity = true, Ritual = true, Leap = true, Breath = true, Tail = true, ShieldCharge = true })
function Rules.classify(kind: string): (boolean, string)
	if kind == "PerilousSweep" or kind == "Tail" then return true, "Double Jump" end
	if kind == "PerilousThrust" then return true, "Deflect" end
	if kind == "PerilousGrab" then return true, "Slide Dash" end
	if kind == "Gravity" then return false, "Bullet Jump" end
	if kind == "Shockwave" or kind == "Leap" or kind == "Ritual" or kind == "Breath" then return true, "Air Glide" end
	return false, "Evade"
end
-- How each named counter is performed, as TutorialRules.text templates of live key captions; the
-- first few boss warnings of each kind carry this hint (#13).
Rules.CounterKeys = table.freeze({ ["Air Glide"] = "{Jump} {Jump}, hold {Jump}", ["Double Jump"] = "{Jump} then {Jump} in the air",
	Deflect = "tap {Guard} on impact", ["Slide Dash"] = "{Slide} away, then {Dash}", ["Bullet Jump"] = "{Slide} + {Jump}", Evade = "{Dash} through it" })
Rules.CounterHintCount = 3
function Rules.impact(now: number, windup: number): number
	return now + math.max(Rules.MinimumWarning, windup)
end
function Rules.tightDeflect(pressedAt: number, impactAt: number): boolean
	local delta = impactAt - pressedAt
	return delta &gt;= 0 and delta &lt;= Rules.ThrustWindow + 1e-9
end
-- Swept annulus: remains correct when a frame steps across a fast moving ring.
function Rules.waveHit(distance: number, height: number, elapsed: number, previous: number, speed: number, radius: number, clearance: number): boolean
	return height &lt;= clearance and distance &lt;= radius and distance &gt;= math.max(0, previous * speed - 3)
		and distance &lt;= math.min(radius, elapsed * speed + 3)
end
function Rules.segmentHit(px: number, pz: number, ax: number, az: number, bx: number, bz: number, width: number): boolean
	local dx, dz = bx - ax, bz - az
	local t = math.clamp(((px - ax) * dx + (pz - az) * dz) / math.max(dx * dx + dz * dz, 0.001), 0, 1)
	return (px - ax - dx * t)^2 + (pz - az - dz * t)^2 &lt;= width^2
end
function Rules.shouldClose(distance: number, farSince: number, now: number, range: number, delay: number): boolean
	return distance &gt; range and now - farSince &gt;= delay
end
function Rules.enrage(alive: number, alreadyEnraged: boolean): boolean
	return alive == 1 and not alreadyEnraged
end
function Rules.lifecycle(living: number, defeated: boolean, entityPresent: boolean): string
	if defeated then return "Victory" end
	if living == 0 or not entityPresent then return "Reset" end
	return "Sealed"
end
function Rules.loot(essence: number, count: number): { { X: number, Z: number, Amount: number } }
	local drops = {}
	for i = 1, count do
		local angle = (i - 1) * math.pi * 2 / count
		table.insert(drops, { X = math.cos(angle) * 7, Z = math.sin(angle) * 7,
			Amount = math.floor(essence / count) + (if i &lt;= essence % count then 1 else 0) })
	end
	return drops
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">BossHandoff</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/BossHandoff
-- The shared boss-entry contract (#16). Whenever an encounter takes the camera (entry framing, a
-- phase metamorphosis, the surviving Twin's oath) the player is locked and protected for exactly
-- the shot plus the camera's return blend; the boss holds for the same window; and no boss impact
-- may land sooner than Lead seconds after readable control resumes. Skipping ends the lock early
-- (the lead then counts from the skip); death, reset and leaving release it at once. Pure timing,
-- shared by the server scheduler and the client camera so both agree on when control returns.
local Handoff = {}

Handoff.Shots = table.freeze({ Intro = 2.4, Phase = 1.2, Enrage = 1.1 }) -- seconds the camera is held
Handoff.Blend = 0.35 -- the follow camera's return to the player after a shot
Handoff.Lead = 0.9 -- minimum readable warning between control returning and the first impact

export type Window = { Kind: string, Start: number, Lock: number, Ends: number, Skipped: boolean }

function Handoff.shot(kind: string): number
	return Handoff.Shots[kind] or Handoff.Shots.Phase
end

-- A new window opening at `now`: locked until Lock, protected until Ends (= Lock + Blend).
function Handoff.window(kind: string, now: number): Window
	local lock = now + Handoff.shot(kind)
	return { Kind = kind, Start = now, Lock = lock, Ends = lock + Handoff.Blend, Skipped = false }
end

function Handoff.protected(window: Window?, now: number): boolean
	return window ~= nil and now &lt; window.Ends
end

-- The earliest moment a boss strike may connect once this window has opened.
function Handoff.earliest(window: Window): number
	return window.Ends + Handoff.Lead
end

-- Pushes an impact scheduled during a handoff out to the readable minimum; never earlier.
function Handoff.defer(impact: number, window: Window?): number
	if not window then return impact end
	return math.max(impact, Handoff.earliest(window))
end

-- Skipping closes the shot now; protection keeps only the camera's return blend.
function Handoff.skip(window: Window, now: number): Window
	if now &gt;= window.Lock then return window end
	return { Kind = window.Kind, Start = window.Start, Lock = now, Ends = now + Handoff.Blend, Skipped = true }
end

-- Seconds of lock (shot + blend) left for a fighter, for Combat.cinematic.
function Handoff.remaining(window: Window, now: number): number
	return math.max(window.Ends - now, 0)
end

return table.freeze(Handoff)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">BossRoster</string>
            <string name="Source">--!strict
-- Appends the campaign without a circular dependency on WorldDefinitions.
local hasScript = pcall(function() return script.Parent end)
local Attacks: any
if hasScript then Attacks = require(script.Parent.BossAttackCatalog) else Attacks = require("./BossAttackCatalog") end
local Roster = {}
local function vec(x: number, y: number, z: number): any return { X = x, Y = y, Z = z } end
local function at(x: number, z: number): any return { X = x, Y = 3, Z = z, Yaw = 180 } end
function Roster.apply(world: any, profile: ({ [string]: number }) -&gt; any)
	-- Bounds (centre z, depth) and the incense altar's authored pocket {placement, spawn yaw, exit}
	-- per region (batches 19-21: SunkenCryptLayout, CelestialPagodaLayout, SkyCitadelLayout marks).
	-- The Pagoda and Citadel bounds now reach north to take in the cloud stair and the summit bridge.
	local regions = {
		{ "SanctuaryDepths", "Sanctuary Depths", 520, 900, 360, { 455, 15, 1046 }, { 455, 1038, 0 }, { 455, 1022 } },
		{ "CelestialPagoda", "Celestial Pagoda Rafters", 0, -2330, 420, { -46, 0, -2268 }, { -38, -2268, 270 }, { -10, -2272 } },
		{ "SkyCitadel", "Sky Citadel", 0, -2760, 440, { -40, 0, -2690 }, { -32, -2690, 270 }, { -10, -2712 } },
	}
	for _, entry in regions do
		local id, name, x, z, depth = entry[1] :: string, entry[2] :: string, entry[3] :: number, entry[4] :: number, entry[5] :: number
		local p, s, e = entry[6] :: { number }, entry[7] :: { number }, entry[8] :: { number }
		world.Regions[id] = { Id = id, Name = name, Bounds = { Center = vec(x, 40, z), Size = vec(360, 200, depth) },
			MapFolder = "Map_" .. id, Greybox = { Color = { 47, 48, 62 }, Material = "Slate" }, Ambience = "StarlessWind", Altars = {} }
		table.insert(world.RegionOrder, id)
		local altarId = "Altar_" .. id
		local altar = { Id = altarId, Name = name .. " Incense", Region = id, Placement = { X = p[1], Y = p[2], Z = p[3], Yaw = 0 },
			Spawn = { X = s[1], Y = p[2] + 3, Z = s[2], Yaw = s[3] }, Radius = 12, Starting = false, Exit = { X = e[1], Y = p[2] + 3, Z = e[2], Yaw = 0 } }
		world.Altars[altarId] = altar
		world.Regions[id].Altars[id] = altar
	end
	-- A side courtyard leaves the authored monastery route intact.
	world.Regions.DesecratedMonastery.Bounds.Size.X = 900
	local ai = profile({ SightRange = 220, FieldOfView = 360, HearingRange = 200, LeashRange = 1000,
		AlertTime = 0.15, Aggression = 0.85, PatrolRadius = 0, ThinkRate = 15, ComboContinueChance = 0.8 })
	local function phase(index: number, name: string, weapon: string, hp: number, moves: any, motion: string): any
		return { Index = index, Name = name, Weapon = weapon, HPFraction = if index == 2 then 0.5 else nil,
			OnDeathblow = index == 2, Stats = { MaxHP = hp, MaxStamina = 260, PostureCapacity = hp * 0.24,
				StrengthScale = 1.6, DexterityScale = 1.5, PoiseArmor = 0.5 }, AI = table.clone(ai),
			AnimationSet = name, Attacks = moves, AttackInterval = if index == 2 then 2.2 else 3.2,
			GapCloser = { Range = 40, Delay = 2.5, Cooldown = 7, Motion = motion },
			Transition = if index == 2 then { Duration = 2.8, BodyColor = { 80, 110, 160 },
				Shockwave = { Windup = 1.8, Radius = 32, Damage = 24, Posture = 40, Unblockable = true } } else nil }
	end
	local function boss(id: string, name: string, title: string, region: string, x: number, z: number, hp: number, weapon: string, moves: any, archetype: string, scale: number, motion: string)
		local gateId = "Gate_" .. id
		world.Bosses[id] = { Id = id, Name = name, Title = title, Region = region, Archetype = archetype, Scale = scale,
			Arena = { Center = vec(x, 36, z), Size = vec(180, 100, 180) }, Spawn = at(x, z - 25), FogGate = gateId,
			Essence = hp * 4, BodyColor = { 140, 154, 178 }, Victory = "LEGEND FELLED",
			Phases = { phase(1, "Ancient Oath", weapon, hp, moves, motion), phase(2, "Unbound", weapon, hp, moves, motion) } }
		world.FogGates[gateId] = { Id = gateId, Boss = id, Placement = { X = x, Y = 12, Z = z + 90, Yaw = 0 }, Size = vec(26, 24, 2),
			Trigger = { Center = vec(x, 10, z + 78), Size = vec(24, 20, 12) }, Inside = at(x, z + 70), Outside = at(x, z + 108) }
	end
	boss("VenerableBaize", "Venerable Baize", "Beast of the Frosted Ridge", "BambooPass", 0, -1470, 1100, "Unarmed", Attacks.Baize, "Beast", 1.5, "Pillar")
	boss("SlumberingTitan", "The Slumbering Titan", "Ancient of the Sunken Crypt", "SanctuaryDepths", 520, 880, 1600, "Guandao", Attacks.Titan, "Colossus", 3, "Lunge")
	boss("SovereignWu", "Sovereign Wu", "The Starless Oracle", "CelestialPagoda", 0, -2380, 1250, "Catalyst", Attacks.Wu, "Sorcerer", 1.2, "Teleport")
	boss("TwinSentinels", "General Zhao", "The Twin Sentinels: Zhao &amp; the Iron Bull", "DesecratedMonastery", 300, -930, 1000, "Guandao", Attacks.Zhao, "Duo", 1.2, "Lunge")
	boss("AzureWyrm", "Azure Wyrm", "Overlord of the Heavenly Summit", "SkyCitadel", 0, -2830, 1600, "Guandao", Attacks.Wyrm, "Dragon", 2.2, "Aerial")
	local duo = world.Bosses.TwinSentinels
	duo.Phases = { duo.Phases[1] }
	duo.Partner = { Name = "The Iron Bull", Weapon = "Guandao", Stats = { MaxHP = 1600, MaxStamina = 320, PostureCapacity = 460, PoiseArmor = 0.9 },
		Attacks = Attacks.Bull, Affinity = "Iron", Scale = 1.7 }
	duo.Affinity = "Lightning"
	local shen = world.Bosses.GrandmasterShen
	shen.Archetype, shen.Victory = "Duelist", "GREAT FOE VANQUISHED"
	for i, p in shen.Phases do
		p.Attacks, p.AttackInterval, p.AnimationSet = if i == 1 then Attacks.Shen else Attacks.Chimera, 3, if i == 1 then "DisciplinedMaster" else "DemonicChimera"
		p.GapCloser = { Range = 36, Delay = 2.5, Cooldown = 7, Motion = "Lunge" }
	end
	shen.Phases[2].Special = nil
end
return Roster
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">BossTypes</string>
            <string name="Source">--!strict
-- Engine-free contracts shared by authored encounters, the server and verification.
export type AttackKind = "PerilousSweep" | "PerilousThrust" | "PerilousGrab" | "Shockwave" | "Barrage" | "Gravity" | "Ritual" | "Leap" | "Breath" | "Tail" | "ShieldCharge"
export type Motion = "Pillar" | "Aerial" | "Lunge" | "Teleport"
export type Attack = {
	Id: string, Kind: AttackKind, Windup: number, Radius: number, Damage: number, Posture: number,
	Height: number?, Speed: number?, Repeats: number?, Interval: number?, Duration: number?,
	Count: number?, Motion: Motion?, Element: string?, Unblockable: boolean?,
}
export type GapCloser = { Range: number, Delay: number, Cooldown: number, Motion: Motion }
return table.freeze({})
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">CampaignZones</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/CampaignZones
-- One walked graph for the authored campaign regions (batches 17-21): every layout's zones and doors,
-- the Monastery's south road as the shared join ("DM:Road"), and each regional spawn's fighting zone.
-- Zones may carry a height band, so the Pagoda's gorge, galleries and loft are separate places even
-- where they overlap on the map; one-way doors are drops that wayfinding never sends anyone up.
-- Pure data and maths: read by RouteGuide (objective marker) and AIService (leash).
local hasScript = pcall(function() return script.Parent end)
local function load(name: string): any
	if hasScript then return (require :: any)((script.Parent :: any)[name]) end
	return (require :: any)("./" .. name)
end
local Layouts = {
	load("BambooPassLayout"), load("AshColosseumLayout"), load("SunkenCryptLayout"),
	load("CelestialPagodaLayout"), load("SkyCitadelLayout"),
}

export type Zone = { Id: string, Name: string, X0: number, X1: number, Z0: number, Z1: number, Y0: number?, Y1: number?, Region: string? }
export type Door = { A: string, B: string, X: number, Y: number, Z: number, Name: string, OneWay: boolean?, Optional: boolean? }

local Campaign = {}
local list: { Zone } = { { Id = "DM:Road", Name = "the south road", X0 = -14, X1 = 14, Z0 = -988, Z1 = -1120, Region = "DesecratedMonastery" } }
local doors: { Door } = {}
local spawns: { [string]: string } = {}
Campaign.Layouts = Layouts
for _, layout in Layouts do
	for _, z in layout.Zones do
		local copy = table.clone(z) :: any
		copy.Region = layout.Region
		table.insert(list, copy)
	end
	for _, d in layout.Doors do table.insert(doors, d) end
	for spawnId, zoneId in layout.SpawnZones do spawns[spawnId] = zoneId end
end
Campaign.List = table.freeze(list)
Campaign.Doors = table.freeze(doors)
Campaign.Spawns = table.freeze(spawns)
Campaign.Grace = 6

function Campaign.get(id: string): Zone?
	for _, zone in list do
		if zone.Id == id then return zone end
	end
	return nil
end

function Campaign.contains(zone: Zone, x: number, y: number?, z: number, margin: number?): boolean
	local m = margin or 0
	if x &lt; zone.X0 - m or x &gt; zone.X1 + m or z &gt; zone.Z0 + m or z &lt; zone.Z1 - m then return false end
	if y and zone.Y0 and y &lt; zone.Y0 then return false end
	if y and zone.Y1 and y &gt; zone.Y1 then return false end
	return true
end

-- The smallest zone holding a point (height bands decide between stacked levels).
function Campaign.at(x: number, y: number, z: number): Zone?
	local best: Zone? = nil
	local bestArea = math.huge
	for _, zone in list do
		local area = (zone.X1 - zone.X0) * (zone.Z0 - zone.Z1)
		if Campaign.contains(zone, x, y, z) and area &lt; bestArea then
			best, bestArea = zone, area
		end
	end
	return best
end

-- Doorways from zone `from` to zone `to` along the fewest crossings, never up a one-way drop. Optional
-- mobility doors (the Pagoda's rafter-end jumps, the frost stones) are used only when nothing else
-- connects, so main progress never asks for an untaught jump chain (Studio F19).
local function search(from: string, to: string, optional: boolean): { Door }
	local previous: { [string]: { Door: Door, From: string } } = {}
	local seen, queue = { [from] = true }, { from }
	while #queue &gt; 0 do
		local here = table.remove(queue, 1) :: string
		for _, door in doors do
			local usable = optional or not door.Optional
			local other = if not usable then nil elseif door.A == here then door.B elseif door.B == here and not door.OneWay then door.A else nil
			if other and not seen[other] then
				seen[other], previous[other] = true, { Door = door, From = here }
				table.insert(queue, other)
			end
		end
	end
	local result: { Door } = {}
	local cursor = to
	while cursor ~= from do
		local step = previous[cursor]
		if not step then return {} end
		table.insert(result, 1, step.Door)
		cursor = step.From
	end
	return result
end

function Campaign.path(from: string, to: string): { Door }
	if from == to then return {} end
	local plain = search(from, to, false)
	return if #plain &gt; 0 then plain else search(from, to, true)
end

-- Fighting zone for a regional spawn (Monastery spawns keep MonasteryZones).
function Campaign.zoneForSpawn(spawnId: string): Zone?
	local id = spawns[spawnId]
	return if id then Campaign.get(id) else nil
end

-- A layout's named point, e.g. Campaign.mark("SanctuaryDepths", "Arrival").
function Campaign.mark(region: string, key: string): any
	for _, layout in Layouts do
		if layout.Region == region then return layout.Marks[key] end
	end
	return nil
end

return table.freeze(Campaign)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CelestialPagodaLayout</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/CelestialPagodaLayout
-- Celestial Pagoda Rafters (batch 20, findings #22 #27 #28 #32 #44). The pagoda's upper storey was
-- torn open; Wu holds its top hall (the arena floor stays at y 0). Walked north to south (-Z):
--   Colosseum causeway -&gt; cloud stair down into the lotus gorge (the light well, y -26) -&gt; the west
--   stair -&gt; the west eave gallery (y -6, monk) -&gt; the rafter beam -&gt; the lantern rafter hub (swordsman)
--   -&gt; the rafter stair up to the forecourt (y 0: incense altar, Wu's fog gate) -&gt; Wu's hall -&gt; the
--   dawn terrace (tablet VIII, the final lore) -&gt; the summit bridge to the Sky Citadel.
-- Optional and bounded: four rafter ends climb off the gallery (single jumps, 4.5 each) to the Throne
-- Loft above the west forecourt - the empty throne and tablet VII. Every fall from the rafters lands
-- on the gorge floor and every fall from the loft on the forecourt; nothing is a mandatory jump.
local hasScript = pcall(function() return script.Parent end)
local L: any = if hasScript then (require(script.Parent.RegionLayout) :: any) else (require("./RegionLayout") :: any)

local r = L.region("CelestialPagoda")

-- Gorge: cliffs either side of the cloud stair, the gorge floor, the forecourt mass at its south.
L.slab(r, "NorthCliff", "Rock", -154, -6, -2120, -2172, 0, 30)
L.slab(r, "NorthCliff", "Rock", 6, 154, -2120, -2172, 0, 30)
L.stairs(r, "CloudStair", "Marble", 0, -2120, 0, -2172, 0.2, -26, 12)
L.slab(r, "GorgeFloor", "Stone", -154, 154, -2172, -2252, -26, 6)
L.slab(r, "Forecourt", "Tile", -154, 90, -2252, -2290, 0, 30)
L.slab(r, "DawnTerrace", "Tile", -30, 30, -2470, -2540, 0, 30)
-- Ascent: west stair, west eave gallery on posts, rafter beam, lantern hub, rafter stair.
L.stairs(r, "WestStair", "Timber", -14, -2184, -60, -2184, -26, -6, 10)
L.slab(r, "EaveGallery", "Timber", -116, -60, -2176, -2240, -6, 2)
for _, x in { -114, -92, -62 } do
	for _, z in { -2178, -2208, -2238 } do
		L.box(r, "GalleryPost", "Lacquer", x, -17, z, 1.6, 18, 1.6)
	end
end
L.slab(r, "RafterBeam", "Timber", -60, -14, -2225, -2231, -6, 1.6)
L.slab(r, "LanternRafter", "Timber", -14, 14, -2216, -2240, -6, 2)
L.box(r, "RafterPost", "Lacquer", -12, -17, -2218, 1.6, 18, 1.6)
L.box(r, "RafterPost", "Lacquer", 12, -17, -2218, 1.6, 18, 1.6)
L.stairs(r, "RafterStair", "Timber", 0, -2240, 0, -2252, -6, 0, 10)
L.wall(r, "GalleryRail", "Lacquer", -60.5, -2190, -60.5, -2224, -6, 2.6, 0.8)
L.wall(r, "GalleryRail", "Lacquer", -115.5, -2177, -115.5, -2239, -6, 2.6, 0.8)
-- Optional: rafter ends (adjacent, each 4.5 higher) to the Throne Loft (y 14) over the west forecourt.
for k, top in { -1.5, 3, 7.5, 12 } do
	L.slab(r, "RafterEnd", "Timber", -114, -110, -2241 - (k - 1) * 4, -2245 - (k - 1) * 4, top, 1.5)
end
L.slab(r, "ThroneLoft", "Timber", -150, -114, -2250, -2290, 14, 2)
for _, x in { -148, -116 } do
	for _, z in { -2252, -2288 } do
		L.box(r, "LoftPost", "Lacquer", x, 6, z, 1.6, 12, 1.6)
	end
end
L.wall(r, "LoftRail", "Lacquer", -150, -2289.5, -114, -2289.5, 14, 2.6, 0.8)
L.wall(r, "LoftRail", "Lacquer", -114.5, -2257, -114.5, -2289, 14, 2.6, 0.8)
L.box(r, "EmptyThrone", "Lacquer", -140, 17, -2280, 6, 6, 4)
-- Hall frame around Wu's floor (outside the arena, behind the veil) and the dawn gate posts.
for _, side in { -1, 1 } do
	for _, z in { -2296, -2340, -2384, -2428, -2466 } do
		L.box(r, "HallColumn", "Lacquer", side * 106, 15, z, 4, 30, 4)
	end
	L.box(r, "DawnPost", "Lacquer", side * 18, 9, -2486, 2.4, 18, 2.4)
	L.box(r, "GateTower", "Tile", side * 20, 12, -2274, 6, 24, 6)
end

for _, l in { { -14, -26, -2178 }, { 14, -26, -2178 }, { -70, 0, -2258 }, { 60, 0, -2258 }, { -24, 0, -2490 }, { 24, 0, -2490 }, { -146, 14, -2284 } } do
	L.lantern(r, l[1], l[2], l[3])
end
for _, l in { { -88, -1, -2208 }, { -38, -1, -2228 }, { 0, 0, -2228 }, { -100, -1, -2236 } } do
	L.light(r, l[1], l[2], l[3]) -- paper lanterns hung from the rafters
end

L.fence(r, "Veil", "Veil", { { -8, -2120 }, { -8, -2172 }, { -156, -2172 }, { -156, -2292 }, { -92, -2292 }, { -92, -2472 }, { -30, -2472 }, { -30, -2540 } }, -40, 260, 2)
L.fence(r, "Veil", "Veil", { { 8, -2120 }, { 8, -2172 }, { 156, -2172 }, { 156, -2254 }, { 92, -2254 }, { 92, -2472 }, { 30, -2472 }, { 30, -2540 } }, -40, 260, 2)

L.mark(r, "Altar", "Celestial Pagoda Rafters Incense", -46, 0, -2268)
L.mark(r, "Lore_Pagoda", "VII · The Empty Throne", -132, 17, -2262)
L.mark(r, "Lore_Dawn", "VIII · The Unwritten Dawn", -20, 3, -2500)
L.mark(r, "ArenaMouth", "Wu's fog gate", 0, 0, -2272)
L.mark(r, "Gorge", "Lotus gorge", 0, -26, -2180)
L.mark(r, "Hub", "Lantern rafter", 0, -6, -2228)
L.mark(r, "NorthJoin", "Cloud stair", 0, 0.2, -2122)
L.mark(r, "SouthJoin", "Summit bridge", 0, 0, -2538)

L.zone(r, "CP_Stair", "the cloud stair", -8, 8, -2120, -2172)
L.zone(r, "CP_Well", "the lotus gorge", -156, 156, -2172, -2252, -40, -16)
L.zone(r, "CP_GalleryW", "the eave gallery", -116, -60, -2176, -2244, -16, -1) -- the gallery slab only
L.zone(r, "CP_Beam", "the rafter beam", -60, -14, -2225, -2231, -16, -1) -- the gorge lies either side (Studio F19)
L.zone(r, "CP_Rafter", "the lantern rafter", -14, 14, -2216, -2240, -16, -1)
L.zone(r, "CP_RafterStair", "the rafter stair", -5, 5, -2240, -2252, -8, 4) -- the gorge lies either side (Studio F19)
L.zone(r, "CP_WestStair", "the west stair", -60, -14, -2179, -2189, -27, -4) -- climbs west (Studio F19)
L.zone(r, "CP_Forecourt", "the pagoda forecourt", -156, 92, -2252, -2292, -4, 10)
L.zone(r, "CP_Loft", "the throne loft", -152, -108, -2238, -2292, 10, 30)
L.zone(r, "CP_Arena", "Wu's hall", -92, 92, -2292, -2470)
L.zone(r, "CP_Dawn", "the dawn terrace", -30, 30, -2470, -2540)
L.door(r, "CP_Stair", "CP_Well", 0, -26, -2172, "Lotus gorge")
L.door(r, "CP_Well", "CP_WestStair", -12, -26, -2184, "West stair")
L.door(r, "CP_WestStair", "CP_GalleryW", -62, -6, -2184, "Stair head")
L.door(r, "CP_GalleryW", "CP_Beam", -61, -6, -2228, "Rafter beam")
L.door(r, "CP_Beam", "CP_Rafter", -14, -6, -2228, "Lantern rafter")
L.door(r, "CP_Rafter", "CP_RafterStair", 0, -6, -2239, "Rafter stair")
L.door(r, "CP_RafterStair", "CP_Forecourt", 0, 0, -2253, "Forecourt")
L.door(r, "CP_Forecourt", "CP_Arena", 0, 0, -2292, "Wu's fog gate")
L.door(r, "CP_Arena", "CP_Dawn", 0, 0, -2470, "Dawn gate")
L.door(r, "CP_Dawn", "SC_Bridge", 0, 0, -2540, "Summit bridge")
L.door(r, "CP_GalleryW", "CP_Loft", -112, 3, -2246, "Rafter ends", nil, true)
L.door(r, "CP_Loft", "CP_Forecourt", -130, 0, -2270, "Loft drop", true)
L.door(r, "CP_GalleryW", "CP_Well", -88, -26, -2210, "Gallery drop", true)
r.SpawnZones = { CP_Monk_Gallery = "CP_GalleryW", CP_Swordsman_Rafter = "CP_Rafter" }
r.Groves = {}

return L.freeze(r)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">CombatSettings</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/CombatSettings
-- Asura's Path combat tuning. Durations and rates here are real-time values; frame data in
-- WeaponSchema is authored at baseline and scaled through Simulation/Tempo.

export type InjuryTier = "None" | "Impaired" | "Injured" | "Severe"
export type InjuryRegion = "Head" | "Torso" | "LeftArm" | "RightArm" | "LeftLeg" | "RightLeg"
export type InjuryGroup = "Head" | "Torso" | "Arm" | "Leg"
export type Range = { Min: number, Max: number }
export type Thresholds = { Impaired: number, Injured: number, Severe: number }

local function freeze(value: any)
	if type(value) ~= "table" or table.isfrozen(value) then
		return
	end
	for _, child in value do
		freeze(child)
	end
	table.freeze(value)
end

local Settings = {
	SchemaVersion = 2,

	Tempo = {
		Scalar = 1.4,
		TickRate = 60,
		TickSeconds = 1 / 60,
		Telegraph = {
			HeavyMinSeconds = 0.210,
			LightTargetSeconds = 0.085,
		},
	},

	Health = {
		MaxHP = 100,
		Layers = { "ActiveHP", "RecoverableHP", "PermanentDeficit" },
		-- Fraction of each hit's damage that becomes RecoverableHP debt rather than a clean loss.
		RecoverableFraction = {
			Chip = 1.0,
			Light = 0.6,
			Heavy = 0.35,
			RunningAttack = 0.4,
			WeaponArt = 0.25,
			Bleed = 0.0,
			Deathblow = 0.0,
		},
		-- Fraction of each hit's damage that permanently lowers effective max HP until a shrine rest.
		PermanentFraction = {
			Chip = 0.0,
			Light = 0.0,
			Heavy = 0.08,
			RunningAttack = 0.05,
			WeaponArt = 0.12,
			Bleed = 0.5,
			Deathblow = 0.25,
		},
		MaxPermanentDeficit = 60,
		MinEffectiveMaxHP = 40,
		Rally = {
			Window = 3.0,
			ReturnRatio = 0.85,
			DecayDelay = 3.0,
			DecayRate = 8.0,
			DeflectBonus = 4.0,
		},
		Shrine = {
			RestoresActiveHP = true,
			ClearsRecoverableHP = true,
			ClearsPermanentDeficit = true,
			ClearsInjuries = true,
			RestDuration = 1.6,
		},
	},

	Bleed = {
		Max = 100,
		DecayRate = 6.0,
		DecayDelay = 1.5,
		-- Buildup per hit = BaseDamage * move.Bleed * weapon.BleedMultiplier * BuildupScale.
		BuildupScale = 3.0,
		ProcDamageFraction = 0.15,
		ResetOnProc = true,
	},

	Posture = {
		MaxPosture = 100,
		DecayRate = 14.0,
		GuardingDecayMultiplier = 0.35,
		DecayDelay = 0.9,
		LowHealthDecayScale = { AtFullHP = 1.0, AtZeroHP = 0.35 },
		DeflectWindow = 0.10,
		DeflectWindowMin = 0.060,
		DeflectRecovery = 0.20,
		DeflectSpamLockout = 0.30,
		DeflectSpamDecay = 0.45,
		DeflectReflectScale = 0.6,
		DeflectMinimumReflect = 8,
		DeflectChainFloor = 0.030,
		DeflectSelfScale = 0.35,
		BlockScale = 1.0,
		BlockDamageScale = 0.0,
		UnblockableBlockScale = 1.6,
		StanceBreakThreshold = 100,
		StanceBreakResetValue = 0,
		HitScale = 0.5,
	},

	Stamina = {
		Max = 100,
		RegenRate = 32.0,
		RegenDelay = 0.45,
		GuardRegenMultiplier = 0.5,
		BrokenRegenMultiplier = 1.5,
		BreakThreshold = 0,
		RecoverToFraction = 0.6,
		SprintCostPerSecond = 9.0,
		SprintMinimum = 5.0,
		Costs = {
			Light = 3.5,
			Heavy = 9.0,
			Roll = 6.0,
			Dash = 6.0,
			RunningAttack = 6.0,
			WeaponArt = 12.0,
			DeflectSuccess = 0.0,
			DeflectMiss = 12.0,
			Block = 12.0,
			Feint = 4.0,
			Heal = 0.0,
		},
		LightRange = { Min = 3.0, Max = 4.0 },
		HeavyRange = { Min = 8.0, Max = 10.0 },
	},

	Qi = {
		Max = 100,
		Initial = 100,
		GainOnHit = 8,
		GainOnDeflect = 15,
		GainOnDeathblow = 25,
		DecayRate = 0,
		PassiveRegen = 2,
		ClearOnShrine = false,
	},

	Stun = {
		StaminaBroken = 1.4,
		GuardBroken = 1.4,
		StanceBroken = 2.5,
		HitstunLight = 0.28,
		HitstunHeavy = 0.48,
		Blockstun = 0.18,
		DeflectRecoil = 0.32,
		DeathblowAttacker = 1.1,
		DeathblowVictim = 1.6,
	},

	Deathblow = {
		DamageFraction = 0.6,
		MinimumDamage = 30,
		Range = 5.0,
		FacingDot = 0.2,
		InvulnerableToOthers = true,
		ClearsPosture = true,
	},

	Counter = {
		HitMultiplier = 1.25,
		PostureMultiplier = 1.25,
	},

	Feint = {
		-- Seconds after Startup begins during which a Heavy or Weapon Art may be feinted.
		Window = 0.15,
		Kinds = { Heavy = true, WeaponArt = true },
	},

	-- Rapid Roll/Dash spam shortens distance and i-frames; a landed strike or a quiet gap resets it.
	Backdash = {
		SpamWindow = 1.2,
		DecayPerUse = 0.18,
		MinDistanceScale = 0.45,
		IFrameDecayPerUse = 0.25,
		MinIFrameScale = 0.0,
		CancelFraction = 0.6,
	},

	Elixir = {
		HealFraction = 0.4,
		DrinkDuration = 0.9,
		BaseCharges = 3,
		MaxCharges = 8,
	},

	-- Attribute-derived poise: armor &gt;= LightThreshold shrugs off light hitstun, &gt;= HeavyThreshold every hit.
	Poise = {
		LightThreshold = 0.5,
		HeavyThreshold = 0.9,
		PostureReduction = 0.5,
	},

	Respawn = {
		PlayerDelay = 3.5,
		EnemyCorpseTime = 4.0,
		DuelResetDelay = 3.0,
	},

	Enemy = {
		ThinkRate = 10,
		AggroRange = 60,
		LeashRange = 140,
		ReactionTime = 0.22,
		DeflectChance = 0.45,
		HeavyChance = 0.2,
		ArtChance = 0.1,
		Aggression = 0.65,
		ComboContinueChance = 0.7,
		TimingJitter = 0.035,
	},

	Movement = {
		SlideBoost = 1.4,
		SlideFriction = 14,
		SlideMaxSpeed = 95,
		SlideMinSpeed = 8,
		SlideHipDrop = 0.6,
		SlideGroundGrace = 0.16,
		BulletSpeed = 75,
		DoubleJumpUp = 50,
		DoubleJumpForward = 25,
		GlideFallSpeed = 6,
		GlideDuration = 3.5,
		GlideSteering = 4,
		WalkSpeed = 16 * 1.4,
		SprintSpeed = 24 * 1.4,
		DashDistance = 14,
		DashDuration = 0.22,
		RollDistance = 11,
		RollDuration = 0.36,
		RollInvulnerable = { Start = 0.04, Finish = 0.24 },
		DashInvulnerable = { Start = 0.0, Finish = 0.10 },
	},

	-- One facing rule for players, enemies, bosses and grounded duels (StrikeGeometry, post-F26 step 2).
	-- Seconds are already at the 1.4x tempo; frame data is unchanged.
	Tracking = {
		-- Degrees per second an attacker may turn while winding up or recovering.
		StartupTurnRate = 240,
		-- Tracking stops this long before the first active frame, so a late sidestep makes it whiff.
		CommitLeadSeconds = 9 / 60,
		-- AI aims where its target will be this far ahead (steady circling is read, reversals are not).
		AimLeadSeconds = 0.1,
		-- Airborne: one light attack and one dodge per airtime; heavier moves wait for the ground.
		AerialAttacks = 1,
		AirDodges = 1,
		LandingRecoverySeconds = 10 / 60,
		-- Feet this far above the floor count as airborne (a step or slope edge does not).
		AirborneClearance = 1.2,
	},

	Input = {
		BufferWindow = 0.10,
		BufferCapacity = 16,
		DuplicateWindow = 0.033,
		Priority = {
			Deflect = 100,
			Roll = 85,
			Dash = 80,
			WeaponArt = 70,
			Heavy = 60,
			RunningAttack = 55,
			Light = 40,
			Block = 30,
			Heal = 20,
			Equip = 10,
		},
	},

	Injury = {
		Tiers = { "None", "Impaired", "Injured", "Severe" } :: { InjuryTier },
		TierIndex = { None = 0, Impaired = 1, Injured = 2, Severe = 3 } :: { [InjuryTier]: number },
		Regions = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" } :: { InjuryRegion },
		Group = {
			Head = "Head",
			Torso = "Torso",
			LeftArm = "Arm",
			RightArm = "Arm",
			LeftLeg = "Leg",
			RightLeg = "Leg",
		} :: { [InjuryRegion]: InjuryGroup },
		-- Accumulated trauma coefficient (0..1) at which each tier begins.
		Thresholds = {
			Head = { Impaired = 0.20, Injured = 0.45, Severe = 0.75 },
			Torso = { Impaired = 0.30, Injured = 0.60, Severe = 0.90 },
			Arm = { Impaired = 0.25, Injured = 0.55, Severe = 0.85 },
			Leg = { Impaired = 0.25, Injured = 0.55, Severe = 0.85 },
		} :: { [InjuryGroup]: Thresholds },
		RecoveryPerSecond = {
			Head = 0.010,
			Torso = 0.008,
			Arm = 0.008,
			Leg = 0.008,
		} :: { [InjuryGroup]: number },
		RecoveryDelay = 6.0,
		-- Once a region reaches this tier, natural recovery stops at its threshold; only a shrine clears it.
		PersistentTier = "Injured" :: InjuryTier,
		BluntHeadConcussionScale = 1.5,
		-- Penalty ranges: Impaired uses Min, Severe uses Max, Injured interpolates the midpoint.
		Penalties = {
			Arm = {
				StaminaCostIncrease = { Min = 0.30, Max = 0.50 },
				DamageReduction = { Min = 0.20, Max = 0.35 },
			},
			Leg = {
				SpeedReduction = { Min = 0.15, Max = 0.30 },
				DashDistanceReduction = { Min = 0.15, Max = 0.30 },
			},
			Head = {
				DeflectWindowReduction = { Min = 0.10, Max = 0.30 },
				PostureDecayReduction = { Min = 0.15, Max = 0.45 },
				VisionBlur = { Min = 0.20, Max = 0.75 },
				EyeVignette = { Min = 0.15, Max = 0.60 },
			},
			Torso = {
				StaminaRegenReduction = { Min = 0.10, Max = 0.30 },
				MaxPostureReduction = { Min = 0.05, Max = 0.15 },
			},
		},
	},
	Colosseum = {
		-- Studio sessions open the ranked queue without the release gate or a Workspace override.
		-- Studio runs on mock persistence (Config.Backend.StudioLiveData = false), so test duels
		-- never touch live ratings. Live servers still require Config.Features.Matchmaking and
		-- Config.Release.RankedIntegrationPassed. Set Workspace attribute AsuraColosseumQA = false
		-- in Studio to rehearse the sealed-league path.
		RankedInDevelopment = true,
	},
}

freeze(Settings)
return Settings
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">ConfigValidator</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/ConfigValidator
-- Validation runs before the preview is replaced or runtime instances are allocated.
local Validator = {}
local function numberIn(value: any, minimum: number, maximum: number, name: string)
	assert(type(value)=="number" and value==value and value&gt;=minimum and value&lt;=maximum,
		name.." must be finite and between "..minimum.." and "..maximum)
end
local function vector(value: any, minimum: number, maximum: number, name: string)
	assert(type(value)=="table" and #value==3,name.." must have exactly three components")
	for index=1,3 do numberIn(value[index],minimum,maximum,name.."["..index.."]") end
end
function Validator.Validate(config: any)
	assert(type(config)=="table","Config must be a table")
	assert(config.Project.Phase&gt;=5 and config.Project.Phase&lt;=12,"This bootstrap implements Phase 5 through Phase 12")
	assert(config.Arena.Sides==8,"The current mat decomposition requires eight sides")
	local a=config.Arena
	numberIn(a.AcrossFlats,24,64,"Arena.AcrossFlats")
	numberIn(a.FloorThickness,0.1,3,"Arena.FloorThickness")
	numberIn(a.FenceHeight,6,14,"Arena.FenceHeight")
	numberIn(a.WireSpacing,0.75,3,"Arena.WireSpacing")
	numberIn(a.WireDiameter,0.025,0.1,"Arena.WireDiameter")
	numberIn(a.PostDiameter,0.2,1.5,"Arena.PostDiameter")
	numberIn(a.RailDiameter,0.1,0.8,"Arena.RailDiameter")
	numberIn(a.WallThickness,0.1,1,"Arena.WallThickness")
	numberIn(a.WireBottom,0.1,1,"Arena.WireBottom")
	numberIn(a.WireTopInset,0.1,1,"Arena.WireTopInset")
	numberIn(a.LowerRailHeight,0.1,1,"Arena.LowerRailHeight")
	numberIn(a.GateSide,1,8,"Arena.GateSide")
	assert(a.GateSide%1==0,"GateSide must be an integer")
	numberIn(a.GateWidth,2,5,"Arena.GateWidth")
	numberIn(a.GateBarDiameter,0.1,0.4,"Arena.GateBarDiameter")
	numberIn(a.GateLatchHeight,1,a.FenceHeight-1,"Arena.GateLatchHeight")
	numberIn(a.GateLatchLength,0.2,1,"Arena.GateLatchLength")
	numberIn(a.SpawnDistance,2,a.AcrossFlats/2-3,"Arena.SpawnDistance")
	vector(a.SpawnSize,0.1,4,"Arena.SpawnSize")
	numberIn(a.VoidWidth,120,240,"Arena.VoidWidth")
	numberIn(a.VoidHeight,60,120,"Arena.VoidHeight")
	numberIn(a.VoidCenterY,10,30,"Arena.VoidCenterY")
	numberIn(a.VoidWallThickness,0.5,3,"Arena.VoidWallThickness")
	numberIn(a.LightHeight,a.FenceHeight+4,24,"Arena.LightHeight")
	numberIn(a.LightOffset,4,a.AcrossFlats/3,"Arena.LightOffset")
	vector(a.FixtureSize,0.1,6,"Arena.FixtureSize")
	vector(a.DiffuserSize,0.02,6,"Arena.DiffuserSize")
	numberIn(a.DiffuserGap,0.01,0.2,"Arena.DiffuserGap")
	numberIn(a.GeometryEpsilon,1e-8,1e-4,"Arena.GeometryEpsilon")
	numberIn(a.SpotLight.Brightness,0.1,10,"SpotLight.Brightness")
	numberIn(a.SpotLight.Range,a.LightHeight+4,60,"SpotLight.Range")
	numberIn(a.SpotLight.Angle,60,120,"SpotLight.Angle")
	vector(a.SpotLight.Color,0,255,"SpotLight.Color")
	assert(type(a.SpotLight.Shadows)=="boolean","SpotLight.Shadows must be boolean")
	local materials: {[string]: boolean}={Concrete=true,Metal=true,SmoothPlastic=true,Neon=true}
	for key,material in pairs(config.Materials :: {[string]: any}) do
		assert(materials[material.Material],"Unsupported material: "..tostring(material.Material))
		vector(material.Color,0,255,"Materials."..key..".Color")
		numberIn(material.Reflectance,0,0.1,"Materials."..key..".Reflectance")
	end
	for _,key in ipairs({"Ambient","OutdoorAmbient","ColorShiftTop","ColorShiftBottom","FogColor"}) do
		vector(config.Lighting[key],0,255,"Lighting."..key)
	end
	local l=config.Lighting
	assert(l.LightingStyle=="Realistic","Phase 1 targets Realistic lighting")
	assert(type(l.PrioritizeLightingQuality)=="boolean","PrioritizeLightingQuality must be boolean")
	numberIn(l.Brightness,0,10,"Lighting.Brightness")
	numberIn(l.ClockTime,0,24,"Lighting.ClockTime")
	numberIn(l.GeographicLatitude,-90,90,"Lighting.GeographicLatitude")
	numberIn(l.EnvironmentDiffuseScale,0,1,"Lighting.EnvironmentDiffuseScale")
	numberIn(l.EnvironmentSpecularScale,0,1,"Lighting.EnvironmentSpecularScale")
	numberIn(l.ShadowSoftness,0,1,"Lighting.ShadowSoftness")
	numberIn(l.ExposureCompensation,-1,1,"Lighting.ExposureCompensation")
	numberIn(l.FogStart,0,100000,"Lighting.FogStart")
	numberIn(l.FogEnd,l.FogStart+1,100000,"Lighting.FogEnd")
	numberIn(l.Atmosphere.Density,0,1,"Atmosphere.Density")
	numberIn(l.Atmosphere.Offset,0,1,"Atmosphere.Offset")
	numberIn(l.Atmosphere.Haze,0,10,"Atmosphere.Haze")
	numberIn(l.Atmosphere.Glare,0,10,"Atmosphere.Glare")
	vector(l.Atmosphere.Color,0,255,"Atmosphere.Color")
	vector(l.Atmosphere.Decay,0,255,"Atmosphere.Decay")
	assert(type(l.SunRays.Enabled)=="boolean","SunRays.Enabled must be boolean")
	numberIn(l.SunRays.Intensity,0,1,"SunRays.Intensity")
	numberIn(l.SunRays.Spread,0,1,"SunRays.Spread")
	assert(type(l.GlobalShadows)=="boolean","Lighting.GlobalShadows must be boolean")
	assert(type(l.ColorCorrection.Enabled)=="boolean","ColorCorrection.Enabled must be boolean")
	numberIn(l.ColorCorrection.Brightness,-1,1,"ColorCorrection.Brightness")
	numberIn(l.ColorCorrection.Contrast,-1,1,"ColorCorrection.Contrast")
	numberIn(l.ColorCorrection.Saturation,-1,1,"ColorCorrection.Saturation")
	vector(l.ColorCorrection.TintColor,0,255,"ColorCorrection.TintColor")
	assert(type(l.Bloom.Enabled)=="boolean","Bloom.Enabled must be boolean")
	numberIn(l.Bloom.Intensity,0,1,"Bloom.Intensity")
	numberIn(l.Bloom.Size,0,56,"Bloom.Size")
	numberIn(l.Bloom.Threshold,0,10,"Bloom.Threshold")
	assert(type(l.DepthOfField.Enabled)=="boolean","DepthOfField.Enabled must be boolean")
	numberIn(l.DepthOfField.FarIntensity,0,1,"DepthOfField.FarIntensity")
	numberIn(l.DepthOfField.NearIntensity,0,1,"DepthOfField.NearIntensity")
	numberIn(l.DepthOfField.FocusDistance,0,1000,"DepthOfField.FocusDistance")
	numberIn(l.DepthOfField.InFocusRadius,0,1000,"DepthOfField.InFocusRadius")
	vector(config.Workspace.GlobalWind,-100,100,"Workspace.GlobalWind")
	numberIn(config.Workspace.Gravity,0,300,"Workspace.Gravity")
	numberIn(config.Workspace.FallenPartsDestroyHeight,-50000,-20,"Workspace.FallenPartsDestroyHeight")
	assert(config.Workspace.StreamingEnabled==false,"Compact Phase 1 arena expects streaming off")
	numberIn(config.Runtime.MaximumArenaParts,100,2000,"Runtime.MaximumArenaParts")
	assert(config.PresentationIntensity=="ModerateTarget" or config.PresentationIntensity=="Off","Unsupported presentation preset")
	for feature,enabled in pairs(config.Features :: {[string]: boolean}) do
		assert(enabled==(feature=="Combat" or feature=="StyleRolls" or feature=="Injuries" or feature=="Persistence"  or feature=="CustomFighter"),"Unsupported feature configuration: "..feature)
	end
	if config.Injury then
		numberIn(config.Injury.ArmDamagePenalty,0.1,1.0,"Injury.ArmDamagePenalty")
		numberIn(config.Injury.ArmStaminaPenalty,1.0,3.0,"Injury.ArmStaminaPenalty")
		numberIn(config.Injury.LegMovePenaltyPerLeg,0.01,0.5,"Injury.LegMovePenaltyPerLeg")
		numberIn(config.Injury.LegMovePenaltyCap,0.05,0.8,"Injury.LegMovePenaltyCap")
		numberIn(config.Injury.LegDamagePenalty,0.1,1.0,"Injury.LegDamagePenalty")
	end
	local combat=config.Combat
	for _,key in {"MaxHealth","MaxStamina","StaminaRegenPerSecond","GuardDrainPerSecond","MaxBodyDamage","GrappleDrainPerSecond","GrappleBreakCost","GrappleSeparation","CounterDamageScale","FeintStaminaCost","GroundDrainPerSecond","GroundSeparation","MountDamageScale","GroundTransitionCost","SweepCost","StandUpCost","TakedownStaminaCost","SubmissionDrainPerSecond","SubmissionDamagePerSecond","SubmissionEscapeCost","SubmissionStaminaCost","GroundStrikeDamage","GroundStrikeStamina"} do
		numberIn(combat[key],0.1,200,"Combat."..key)
	end
	for _,key in {"RegenDelayTicks","GuardBreakTicks","BlockStunTicks","HitStunTicks","KOResetTicks","DisplayExtrapolationTicks","GrappleMaxTicks","CounterStunTicks","GroundMaxTicks","SubmissionMaxTicks"} do
		numberIn(combat[key],1,600,"Combat."..key);assert(combat[key]%1==0,"Combat ticks must be integers")
	end
	for _,key in {"GuardDamageScale","GuardMoveScale","AttackMoveScale","HitMoveScale","AttackTurnScale","GuardTurnScale"} do
		numberIn(combat[key],0,1,"Combat."..key)
	end
	numberIn(combat.GuardArcCos,-1,1,"Combat.GuardArcCos")
	numberIn(combat.GrappleArcCos,-1,1,"Combat.GrappleArcCos")
	numberIn(combat.InputBufferTicks,1,12,"Combat.InputBufferTicks")
	numberIn(combat.PreviewTimeoutSeconds,0.1,0.5,"Combat.PreviewTimeoutSeconds")
	numberIn(combat.SweepEpsilon,1e-8,1e-4,"Combat.SweepEpsilon")
	numberIn(combat.DummyGuardResumeStamina,1,combat.MaxStamina,"Combat.DummyGuardResumeStamina")
	assert(type(combat.PracticeDummyGuard)=="boolean","Dummy guard flag")
	assert(#combat.Parts==6 and #combat.Hurtboxes==6,"Six calibrated body parts required")
	for _,h in combat.Hurtboxes do
		assert(table.find(combat.Parts,h.Part),"Unknown hurtbox part")
		numberIn(h.X,-2,2,"Hurtbox.X");numberIn(h.Y,0,6,"Hurtbox.Y")
		numberIn(h.Z,-2,2,"Hurtbox.Z");numberIn(h.Radius,0.1,1,"Hurtbox.Radius")
	end
	local m,n,c,i=config.Movement,config.Network,config.Camera,config.Input
	assert(m.TickRate==60 and n.SendRate==30 and n.SnapshotRate==30,"Timing contract is 60/30/30 Hz")
	numberIn(m.Speed,1,12,"Movement.Speed")
	numberIn(m.Acceleration,1,100,"Movement.Acceleration")
	numberIn(m.Deceleration,1,100,"Movement.Deceleration")
	numberIn(m.Radius,1,2,"Movement.Radius")
	numberIn(m.TurnRate,0.5,10,"Movement.TurnRate")
	assert(m.RootHeight==3 and m.MaxFighters==2,"Calibration contract: 3-stud root, two fighters")
	assert(m.CollisionPasses==4 and m.MaxCatchupSteps==6,"Bounded simulation contract changed")
	numberIn(m.MaxFrameDelta,1/m.TickRate,0.1,"Movement.MaxFrameDelta")
	numberIn(m.BackwardScale,0.1,1,"Movement.BackwardScale")
	numberIn(m.StrafeScale,0.1,1,"Movement.StrafeScale")
	numberIn(m.Epsilon,1e-8,1e-4,"Movement.Epsilon")
	for _,key in {"MaxBatch","MaxQueue","MaxPending","MaxSequence","MessageBurst","FrameBurst","ActionBurst","SnapshotHistory","MaxSequenceGap"} do
		numberIn(n[key],1,2147483647,"Network."..key);assert(n[key]%1==0,"Integer required: "..key)
	end
	assert(n.MaxBatch&lt;=6 and n.MaxQueue&lt;=18 and n.MaxPending&lt;=120,"Network buffers exceed tested caps")
	assert(n.MaxQueue&gt;=n.MaxBatch and n.MaxPending&gt;=n.MaxQueue,"Network buffer ordering")
	for _,key in {"MessagesPerSecond","FramesPerSecond","ActionsPerSecond","ActionCooldown","InputTimeout","DisconnectWarning","InterpolationDelay"} do
		numberIn(n[key],0.01,120,"Network."..key)
	end
	assert(n.Protocol==4 and n.SessionLength==36,"Protocol contract mismatch")
	numberIn(c.FOV,c.MinFOV,c.MaxFOV,"Camera.FOV")
	assert(c.MinFOV==70 and c.MaxFOV==90,"Supported FOV range is 70 to 90")
	numberIn(c.EyeHeight,5,5.8,"Camera.EyeHeight")
	numberIn(c.EyeForward,0,0.3,"Camera.EyeForward")
	numberIn(c.Clearance,0.1,0.5,"Camera.Clearance")
	numberIn(c.PitchLimit,0.5,1.4,"Camera.PitchLimit")
	for _,key in {"MouseSensitivity","TouchSensitivity","GamepadSensitivity","CorrectionSpeed","SnapDistance","FocusDistance","FOVStep","SensitivityStep","TraumaDecay","MaxTraumaYaw","MaxTraumaPitch","MaxTraumaRoll","MaxFovKick"} do
		numberIn(c[key],0.0001,100,"Camera."..key)
	end
	numberIn(i.StickDeadzone,0.05,0.4,"Input.StickDeadzone")
	assert(i.BufferCapacity==8 and i.BufferSeconds==0.2,"Input buffer contract")
	numberIn(i.SwipePixels,10,100,"Input.SwipePixels")
	numberIn(i.TouchStickPixels,30,100,"Input.TouchStickPixels")
	numberIn(i.SwipeMaxSeconds,0.1,1,"Input.SwipeMaxSeconds")
	numberIn(i.TapHoldSeconds,0.5,3,"Input.TapHoldSeconds")
	numberIn(i.ContextPriority,2000,5000,"Input.ContextPriority")
	numberIn(c.SensitivityMin,0.1,1,"Camera.SensitivityMin")
	numberIn(c.SensitivityMax,1,4,"Camera.SensitivityMax")
	numberIn(config.Runtime.DependencyTimeoutSeconds,1,60,"Runtime.DependencyTimeoutSeconds")
	for _,key in {"Color","GloveColor","ShortsColor"} do vector(config.Rig[key],0,255,"Rig."..key) end
	for _,key in {"HeadSize","UpperTorsoSize","LowerTorsoSize","UpperArmSize","ForearmSize","HandSize","ThighSize","ShinSize","FootSize"} do
		vector(config.Rig[key],0.1,2,"Rig."..key)
	end
	for _,key in {"StrideRate","LegSwing","GuardShoulder","GuardElbow"} do numberIn(config.Rig[key],0,10,"Rig."..key) end
end
return table.freeze(Validator)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ContactCues</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/ContactCues
-- How attack contact reads to the local player, from authoritative combat events only. Beside
-- the existing block / parry / hit / deathblow calls it names the three outcomes that used to be
-- silent: a whiff (the attack window closed touching no one; the server reports how many studs
-- short of the nearest foe it fell), an evade (the strike met dodge i-frames) and a feint (an
-- attack abandoned during its startup, which pressing guard does on purpose). Hitboxes are not
-- changed: this only describes what the 60 Hz server already decided.
local Cues = {}

Cues.NoticeRange = 8 -- a whiff further than this from every foe was swung at nothing; stay quiet
Cues.BodyRadius = 1.2 -- flat distance from a fighter's root to the surface a blade must reach
Cues.Short = 0.5 -- below this the swing reached the foe's position but missed it (arc / facing)

export type Tone = "Muted" | "Ivory" | "Gold" | "Crimson"
-- Text: what to say; Over: whose head the popup floats over ("Source" | "Target" | nil for a centre
-- callout); Arc: draw the attack's real reach around the attacker.
export type Cue = { Text: string, Tone: Tone, Over: ("Source" | "Target")?, Arc: boolean }

-- Studs a strike of `reach` fell short of a body standing at `to` (0 when within reach).
function Cues.gap(from: Vector3, to: Vector3, reach: number): number
	local flat = math.sqrt((to.X - from.X) ^ 2 + (to.Z - from.Z) ^ 2)
	return math.max(0, flat - Cues.BodyRadius - reach)
end

-- `own` is the local fighter id; `near` says the event's source is a nearby fighter (opponent feints).
function Cues.describe(kind: string, source: number, target: number, value: number, own: number, near: boolean): Cue?
	if kind == "Whiff" then
		if source ~= own or target == 0 then return nil end
		if value &gt;= Cues.Short then
			return { Text = string.format("OUT OF REACH  +%.1f", value), Tone = "Muted", Over = "Target", Arc = true }
		end
		return { Text = "MISSED", Tone = "Muted", Over = "Target", Arc = true }
	elseif kind == "Evade" then -- Source dodged Target's strike
		if source == own then return { Text = "EVADED", Tone = "Ivory", Over = nil, Arc = false } end
		if target == own then return { Text = "DODGED", Tone = "Muted", Over = "Source", Arc = false } end
	elseif kind == "Feint" then
		if source == own then return { Text = "FEINT · attack cancelled", Tone = "Ivory", Over = nil, Arc = false } end
		if near then return { Text = "FEINT", Tone = "Muted", Over = "Source", Arc = false } end
	end
	return nil
end

return table.freeze(Cues)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">CostumeSchema</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/CostumeSchema
-- Data contract for authored character looks (batches 11-14). A Look is a list of welded pieces,
-- each bound to one rig limb (R15 name) or, for creatures, to the HumanoidRootPart; offsets are
-- studs from that limb's centre at scale 1 (CostumeKit builds before Model:ScaleTo, so a boss
-- scales with its costume). `Fit` pieces grow the live limb's size; `Face` places a piece on the
-- live limb's surface. Phase-tagged pieces show only in that phase; Joint names the procedural
-- role a creature controller animates. Production skins replace a look through BossSkin using the
-- template names below; the look stays as the diagnosed fallback.
local Schema = {}

export type Piece = {
	Name: string, Bone: string, Size: { number }, At: { number }?, Rot: { number }?, Face: { number }?,
	Color: { number }, Material: string, Shape: string?, Phase: number?, Joint: string?, Glow: number?,
	Fit: boolean?, Role: string?, Transparency: number?, Pivot: { number }?, Pivot2: { number }?, -- hinge (and parent hinge for a wing tip), same space as At
}
export type Look = {
	Key: string, Rig: string, HideBody: boolean?, OwnWeapon: boolean?, Phases: number?, Pieces: { Piece },
	Hull: { number }?, Budget: number?, Body: { { number } }?, Body2: { { number } }?, -- { skin, cloth } per phase
	Look: { number }?, -- standing figures: the ground point (x, z) they face
}

Schema.Bones = table.freeze({ "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm",
	"RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "HumanoidRootPart" })
Schema.Materials = table.freeze({ "Fabric", "Metal", "Wood", "SmoothPlastic", "Neon", "Slate", "Rock", "Basalt", "Granite", "Marble", "Leather",
	"Ice", "Glass", "Foil", "DiamondPlate", "CorrodedMetal", "Pebble", "Sand", "Limestone", "Plastic", "Cobblestone", "Grass", "LeafyGrass", "CrackedLava" })
Schema.Shapes = table.freeze({ "Block", "Ball", "Cylinder", "Wedge" })
Schema.Joints = table.freeze({ "LegFL", "LegFR", "LegHL", "LegHR", "WingL", "WingR", "WingTipL", "WingTipR", "Tail1", "Tail2", "Tail3",
	"Tail4", "Tail5", "Neck", "Jaw", "Mane", "Orbit", "Sleeve" })
-- What a production skin must cover before it may hide the rig (BossSkin).
Schema.RequiredBones = table.freeze({
	Humanoid = table.freeze({ "Head", "UpperTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg" }),
	Creature = table.freeze({ "HumanoidRootPart" }),
})
Schema.DefaultBudget = 160 -- welded pieces per actor; normal enemies and NPCs set lower budgets

-- Nominal default-R15 limb sizes and rest centres relative to the root (scale 1); offline checks
-- use them, the live kit reads the real limbs. Feet rest on Schema.Ground below the root.
Schema.Ground = -3
Schema.R15 = table.freeze({
	HumanoidRootPart = { Size = { 2, 2, 1 }, At = { 0, 0, 0 } }, Head = { Size = { 1.2, 1.2, 1.2 }, At = { 0, 1.8, 0 } },
	UpperTorso = { Size = { 2, 1.6, 1 }, At = { 0, 0.6, 0 } }, LowerTorso = { Size = { 2, 0.4, 1 }, At = { 0, -0.4, 0 } },
	LeftUpperArm = { Size = { 1, 1.17, 1 }, At = { -1.5, 0.75, 0 } }, RightUpperArm = { Size = { 1, 1.17, 1 }, At = { 1.5, 0.75, 0 } },
	LeftLowerArm = { Size = { 1, 1.05, 1 }, At = { -1.5, -0.25, 0 } }, RightLowerArm = { Size = { 1, 1.05, 1 }, At = { 1.5, -0.25, 0 } },
	LeftHand = { Size = { 1, 0.3, 1 }, At = { -1.5, -0.95, 0 } }, RightHand = { Size = { 1, 0.3, 1 }, At = { 1.5, -0.95, 0 } },
	LeftUpperLeg = { Size = { 1, 1.22, 1 }, At = { -0.5, -1.2, 0 } }, RightUpperLeg = { Size = { 1, 1.22, 1 }, At = { 0.5, -1.2, 0 } },
	LeftLowerLeg = { Size = { 1, 1.19, 1 }, At = { -0.5, -2.2, 0 } }, RightLowerLeg = { Size = { 1, 1.19, 1 }, At = { 0.5, -2.2, 0 } },
	LeftFoot = { Size = { 1, 0.3, 1 }, At = { -0.5, -2.85, 0 } }, RightFoot = { Size = { 1, 0.3, 1 }, At = { 0.5, -2.85, 0 } },
})

-- Compact constructor for look tables: P(name, bone, {sx,sy,sz}, {x,y,z}, color, material, extra).
function Schema.P(name: string, bone: string, size: { number }, at: { number }?, color: { number }, material: string, extra: { [string]: any }?): Piece
	local piece: any = { Name = name, Bone = bone, Size = size, At = at, Color = color, Material = material }
	local options: { [string]: any } = extra or {}
	for key, value in options do piece[key] = value end
	return piece :: Piece
end

function Schema.visible(piece: Piece, phase: number): boolean
	return piece.Phase == nil or piece.Phase == phase
end

-- Production template names, most specific first. `key` is the actor's look key (each Twin has
-- its own); legacy encounter/animation-set names stay accepted.
function Schema.templates(key: string, phase: number, encounter: string?, set: string?): { string }
	local names = { "AsuraBoss_" .. key .. "_P" .. phase, "AsuraBoss_" .. key }
	if encounter and encounter ~= key then
		if set then table.insert(names, "AsuraBoss_" .. encounter .. "_" .. set) end
		table.insert(names, "AsuraBoss_" .. encounter)
	end
	return names
end

-- Offline size of a piece: Fit pieces grow the nominal limb.
function Schema.size(piece: Piece): { number }
	if not piece.Fit then return piece.Size end
	local limb = Schema.R15[piece.Bone]
	local base = if limb then limb.Size else { 1, 1, 1 }
	return { base[1] + piece.Size[1], base[2] + piece.Size[2], base[3] + piece.Size[3] }
end

-- Offline centre of a piece relative to the root at scale 1 (rotation about its own centre only).
function Schema.centre(piece: Piece): { number }
	local limb = Schema.R15[piece.Bone]
	local base, half = limb.At, { limb.Size[1] / 2, limb.Size[2] / 2, limb.Size[3] / 2 }
	local at, face = piece.At or { 0, 0, 0 }, piece.Face or { 0, 0, 0 }
	return { base[1] + at[1] + face[1] * half[1], base[2] + at[2] + face[2] * half[2], base[3] + at[3] + face[3] * half[3] }
end

local function member(list: { string }, value: string?): boolean
	return value ~= nil and table.find(list, value) ~= nil
end

function Schema.validate(look: Look): (boolean, { string })
	local problems: { string } = {}
	local function fail(text: string) table.insert(problems, look.Key .. ": " .. text) end
	if look.Rig ~= "Humanoid" and look.Rig ~= "Creature" then fail("unknown rig " .. tostring(look.Rig)) end
	if look.Rig == "Creature" and not look.HideBody then fail("creature looks must hide the humanoid body") end
	if #look.Pieces &gt; (look.Budget or Schema.DefaultBudget) then fail(string.format("%d pieces over budget %d", #look.Pieces, look.Budget or Schema.DefaultBudget)) end
	for _, piece in look.Pieces do
		local label = piece.Name
		if not member(Schema.Bones, piece.Bone) then fail(label .. " has unknown bone " .. tostring(piece.Bone)) end
		if look.Rig == "Creature" and piece.Bone ~= "HumanoidRootPart" then fail(label .. " must bind to the root") end
		if not member(Schema.Materials, piece.Material) then fail(label .. " has unknown material " .. tostring(piece.Material)) end
		if piece.Shape and not member(Schema.Shapes, piece.Shape) then fail(label .. " has unknown shape") end
		if piece.Joint and not member(Schema.Joints, piece.Joint) then fail(label .. " has unknown joint " .. piece.Joint) end
		if piece.Phase and (piece.Phase &lt; 1 or piece.Phase &gt; (look.Phases or 1)) then fail(label .. " phase out of range") end
		local size = Schema.size(piece)
		for axis = 1, 3 do
			if type(size[axis]) ~= "number" or size[axis] &lt; 0.04 or size[axis] &gt; 60 then fail(label .. " has an invalid size") end
		end
		for channel = 1, 3 do
			local c = piece.Color[channel]
			if type(c) ~= "number" or c &lt; 0 or c &gt; 255 then fail(label .. " has an invalid colour") end
		end
	end
	return #problems == 0, problems
end

return table.freeze(Schema)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">DialogueRules</string>
            <string name="Source">--!strict
local hasScript=pcall(function() return script.Parent end)
local Catalog: any=if hasScript then require(script.Parent.NarrativeCatalog) else require("./NarrativeCatalog")
local Rules={}
function Rules.node(npc: string,node: string): any
 local n=Catalog.NPCs[npc];return if n then n.Nodes[node] else nil
end
function Rules.choose(npc: string,node: string,index: number): any
 local n=Rules.node(npc,node);if not n or index%1~=0 then return nil end
 local c=n.Choices[index];if not c then return nil end
 if c.Close then return {Close=true} end
 if not Rules.node(npc,c.Next) then return nil end
 return {Next=c.Next,Action=c.Action}
end
function Rules.valid(packet: any): boolean
 if type(packet)~="table" or type(packet.action)~="string" then return false end
 local shapes={Choose={action="string",index="number",revision="number"},Close={action="string"},
  Upgrade={action="string",revision="number"},Infuse={action="string",id="string",revision="number"},
  Level={action="string",id="string",revision="number"},Summon={action="string",id="string"},Trade={action="string",id="string",revision="number"},Codex={action="string"}}
 local shape=shapes[packet.action];if not shape then return false end
 local count=0;local expected=0;for _ in shape do expected+=1 end
 for key,v in packet do
  count+=1;if type(v)~=shape[key] then return false end
  if type(v)=="string" and #v&gt;64 then return false end
  if type(v)=="number" and (v~=v or v%1~=0 or math.abs(v)&gt;2147483647) then return false end
 end
 return count==expected
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">EffectsPreference</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/EffectsPreference
-- The one shared switch for comfort and decoration. Decoration thins out during active fights so
-- telegraphs, damage numbers and counter prompts stay dominant; "reduced effects" thins it further
-- everywhere (screen petals, drifting ash, particle density). Batch 25 adds reduced motion (camera
-- shake/kick and scripted camera moves), reduced flashes (screen blooms and impact flashes) and a
-- text scale. Warnings and hit feedback are never removed by these, only calmed. The values are
-- persisted in profile.settings.comfort (ProfileSchema) and applied by the bootstrap; `sanitize`
-- is the single validator for both sides.
local Effects = {}

export type Prefs = { ReducedEffects: boolean, ReducedMotion: boolean, ReducedFlashes: boolean, TextScale: number }

-- Share of the authored decorative density that stays visible.
Effects.Decor = table.freeze({ Explore = 1, Combat = 0.25, ReducedExplore = 0.3, ReducedCombat = 0 })
-- Decorative petals lose contrast in fights as well as count.
Effects.CombatContrast = 0.45
Effects.TextScales = table.freeze({ 1, 1.15, 1.3 })
Effects.FlashFloor = 0.35 -- reduced flashes keep this share of a bloom's strength (still visible)
Effects.MotionFloor = 0.25 -- reduced motion keeps this share of shake / kick (impacts still felt)
Effects.Default = table.freeze({ ReducedEffects = false, ReducedMotion = false, ReducedFlashes = false, TextScale = 1 })

local prefs: Prefs = table.clone(Effects.Default) :: Prefs
local listeners: { (boolean) -&gt; () } = {}

-- Accepts anything (a saved table, a client packet) and returns valid preferences.
function Effects.sanitize(raw: any): Prefs
	local source = if type(raw) == "table" then raw else {}
	local scale = 1
	for _, allowed in Effects.TextScales do
		if source.TextScale == allowed then scale = allowed end
	end
	return {
		ReducedEffects = source.ReducedEffects == true,
		ReducedMotion = source.ReducedMotion == true,
		ReducedFlashes = source.ReducedFlashes == true,
		TextScale = scale,
	}
end

function Effects.get(): Prefs
	return table.clone(prefs)
end

-- Applies a (partial) preference table; listeners hear about any change.
function Effects.set(partial: any)
	local merged = table.clone(prefs) :: any
	if type(partial) == "table" then
		for key, value in partial do merged[key] = value end
	end
	local nextPrefs = Effects.sanitize(merged)
	local changed = false
	for key, value in nextPrefs :: any do
		if (prefs :: any)[key] ~= value then changed = true end
	end
	if not changed then return end
	prefs = nextPrefs
	for _, listener in table.clone(listeners) do
		task.spawn(listener, prefs.ReducedEffects)
	end
end

function Effects.reduced(): boolean
	return prefs.ReducedEffects
end

function Effects.setReduced(value: boolean)
	Effects.set({ ReducedEffects = value })
end

function Effects.reducedMotion(): boolean
	return prefs.ReducedMotion
end

function Effects.reducedFlashes(): boolean
	return prefs.ReducedFlashes
end

function Effects.textScale(): number
	return prefs.TextScale
end

-- Listener receives the reduced-effects flag; read the other getters inside it as needed.
function Effects.onChanged(listener: (boolean) -&gt; ()): () -&gt; ()
	table.insert(listeners, listener)
	return function()
		local index = table.find(listeners, listener)
		if index then
			table.remove(listeners, index)
		end
	end
end

-- Decorative density multiplier (0..1) for the current situation.
function Effects.decor(engaged: boolean): number
	local d = Effects.Decor
	if prefs.ReducedEffects then
		return if engaged then d.ReducedCombat else d.ReducedExplore
	end
	return if engaged then d.Combat else d.Explore
end

-- Screen bloom / flash strength after the comfort setting.
function Effects.flash(strength: number): number
	return if prefs.ReducedFlashes then strength * Effects.FlashFloor else strength
end

-- Camera shake / kick magnitude after the comfort setting.
function Effects.motion(magnitude: number): number
	return if prefs.ReducedMotion then magnitude * Effects.MotionFloor else magnitude
end

return table.freeze(Effects)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">EndingCredits</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/EndingCredits
-- Concise credits for the crossing (batch 22), transcribed from the project's own record,
-- assets/CREDITS.md. Every third-party row there appears here with its source and licence, and
-- nothing here is absent there (tools/test_progression_runtime.py compares the two). Work made for
-- the project is credited as the record words it; no names are added that the record lacks.
local Credits = {}

export type Entry = { Work: string, By: string, License: string, Source: string }

Credits.Title = "ASURA'S PATH"
Credits.Closing = "Thank you for walking the path."

Credits.ThirdParty = table.freeze({
	{ Work = "Gothic Statue · the Sanctuary colossus", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/gothic_statue" },
	{ Work = "Large Iron Gate · the Ascension Gateway", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/large_iron_gate" },
	{ Work = "Dead Tree Trunk 02 · the sacred tree", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/dead_tree_trunk_02" },
	{ Work = "Pine Roots", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/pine_roots" },
	{ Work = "Rock Face 03 texture", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/rock_face_03" },
	{ Work = "Bark Platanus texture", By = "Poly Haven", License = "CC0", Source = "https://polyhaven.com/a/bark_platanus" },
	{ Work = "Leaf Set 024 texture", By = "ambientCG", License = "CC0", Source = "https://ambientcg.com/view?id=LeafSet024" },
	{ Work = "Stone 01", By = "Poly Haven", License = "CC0-1.0", Source = "https://polyhaven.com/a/stone_01" },
	{ Work = "Stone Fire Pit", By = "Poly Haven", License = "CC0-1.0", Source = "https://polyhaven.com/a/stone_fire_pit" },
	{ Work = "Brass Diya Lantern", By = "Poly Haven", License = "CC0-1.0", Source = "https://polyhaven.com/a/brass_diya_lantern" },
	{ Work = "Fantasy Ruins", By = "Ron Kapaun / 3TD Studios", License = "CC0-1.0", Source = "https://opengameart.org/content/3td-fantasy-ruins-pack" },
	{ Work = "Impact Sounds", By = "Kenney", License = "CC0-1.0", Source = "https://kenney.nl/assets/impact-sounds" },
	{ Work = "RPG Audio", By = "Kenney", License = "CC0-1.0", Source = "https://kenney.nl/assets/rpg-audio" },
} :: { Entry })

-- Made for the project, in the record's own words (each phrase appears in CREDITS.md).
Credits.Project = table.freeze({
	"Veiled Ascetic: base sculpt generated by the creator",
	"Wind, bronze bell, droplets, bass impulse and bowed-harmonic drone were synthesized for this project",
	"Custom ember, ribbon, blood, smoke, ash, flame, shockwave, seal masks and six seamless charcoal sky faces",
})

-- Short display lines, one per entry: "Work — By · License".
function Credits.lines(): { string }
	local out: { string } = {}
	for _, entry in Credits.ThirdParty do
		table.insert(out, entry.Work .. " — " .. entry.By .. " · " .. entry.License)
	end
	for _, line in Credits.Project do
		table.insert(out, line)
	end
	return out
end

return table.freeze(Credits)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">EndingRules</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/EndingRules
-- The six-sovereign ending (batch 22, #10). The story stage comes from the server-owned defeated-boss
-- flags plus the persisted story flags (souls.world.story). Flags only ever gain entries and the
-- ending grants nothing, so repeating a choice, dying, rejoining or an interrupted scene cannot
-- duplicate a reward or lose progress. Crossing is made in person beside Lin's bonfire; her altar
-- projection only summons the Emissary home. Pure: read by DialogueService, Objectives, CodexView
-- and EndingController.
local Ending = {}

export type Stage = "Bound" | "Release" | "Remained" | "Crossed"
export type Story = { [string]: boolean }

Ending.Sovereigns = table.freeze({ "GrandmasterShen", "VenerableBaize", "SlumberingTitan", "SovereignWu", "TwinSentinels", "AzureWyrm" })
Ending.Flags = table.freeze({ Released = "Released", Crossed = "Crossed", Remained = "Remained" })
-- Lady Lin beside the Primal Bonfire (NarrativeCatalog.NPCs.Lin; checked by the runtime test).
Ending.Lin = Vector3.new(8, 603, 918)
-- Portals that already lead home from a region (SunkenCryptLayout / SkyCitadelLayout ReturnPortal marks).
Ending.HomePortals = table.freeze({ -- region -&gt; portal

	SanctuaryDepths = { Position = Vector3.new(520, 30, 1074), Name = "the crypt's return portal" },
	SkyCitadel = { Position = Vector3.new(44, 0, -2690), Name = "the bastion's return portal" },
})

function Ending.rested(bosses: { [string]: boolean }?): number
	local count = 0
	for _, id in Ending.Sovereigns do
		if bosses and bosses[id] == true then count += 1 end
	end
	return count
end

function Ending.stage(bosses: { [string]: boolean }?, story: Story?): Stage
	if Ending.rested(bosses) &lt; #Ending.Sovereigns then return "Bound" end
	local s: Story = story or {}
	if s.Crossed then return "Crossed" end
	if s.Remained then return "Remained" end
	return "Release"
end

-- Lin's opening node: before six she greets; after, in person she offers the choice, as a
-- projection she calls the Emissary home; once crossed she welcomes the returned Emissary.
function Ending.linNode(stage: Stage, projection: boolean): string
	if stage == "Bound" then return "Greeting" end
	if stage == "Crossed" then return "Postgame" end
	return if projection then "Summons" else "Release"
end

-- Applies a choice to the story flags in place. Returns ok, refusal reason, and whether this was
-- the first time (the scene still replays; nothing is granted either way).
function Ending.decide(story: Story, stage: Stage, choice: string, projection: boolean): (boolean, string?, boolean)
	if stage == "Bound" then return false, "The six chains still bind you", false end
	if projection then return false, "Cross beside Lady Lin at the Primal Bonfire", false end
	if choice == "Cross" then
		local first = story.Crossed ~= true
		story.Released, story.Crossed = true, true
		return true, nil, first
	elseif choice == "Remain" then
		local first = story.Remained ~= true and story.Crossed ~= true
		story.Released, story.Remained = true, true
		return true, nil, first
	end
	return false, "Choice unavailable", false
end

function Ending.serialize(story: Story?): string
	local list: { string } = {}
	for id, on in story or {} do
		if on then table.insert(list, id) end
	end
	table.sort(list)
	return table.concat(list, ",")
end

export type Objective = { Key: string, Title: string, Detail: string, Target: any }

-- The post-six objective. `homeAltar` is a kindled altar in the current region (travel leg).
-- PvP stays an optional mention, never the conclusion.
function Ending.objective(stage: Stage, region: string?, homeAltar: string?): Objective?
	if stage == "Bound" then return nil end
	if stage == "Crossed" then
		return { Key = "Postgame", Title = "The Asura's Path is walked",
			Detail = "Roam, forge and read as you wish · replay the crossing with Lady Lin · Colosseum duels are optional", Target = nil }
	end
	if stage == "Remained" then
		return { Key = "Ending:Remain", Title = "Carry their names",
			Detail = "Roam freely · Lady Lin opens the crossing at the Primal Bonfire · Colosseum duels are optional", Target = nil }
	end
	local title = "Return to Lady Lin"
	if region == "Sanctuary" or region == nil then
		return { Key = "Ending:Return", Title = title, Detail = "Six chains are silent · she waits beside the Primal Bonfire",
			Target = { Kind = "Point", Position = Ending.Lin } }
	end
	local portal = if region then (Ending.HomePortals :: { [string]: { Position: Vector3, Name: string } })[region] else nil
	if portal then
		return { Key = "Ending:Return", Title = title, Detail = "Take " .. portal.Name .. " to the Primal Bonfire",
			Target = { Kind = "Point", Position = portal.Position } }
	end
	if homeAltar then
		return { Key = "Ending:Return", Title = title, Detail = "Rest at this region's altar and travel to the Primal Bonfire",
			Target = { Kind = "Altar", Id = homeAltar } }
	end
	return { Key = "Ending:Return", Title = title, Detail = "Rest at any altar and travel to the Primal Bonfire", Target = nil }
end

-- The crossing scene: world-fixed Sanctuary shots (Lin and the bonfire, the colossus, the dawn
-- beyond the tree), then the completion card, credits and the return. Lines reuse the authored
-- narrative (lore IV and VIII, Lin's Release). Kind "Card"/"Credits"/"Return" draw over a veil.
export type Beat = { Kind: string, Duration: number, From: Vector3?, To: Vector3?, Look: Vector3?, Line: string, Sub: string }
Ending.Scene = table.freeze({
	{ Kind = "Shot", Duration = 6, From = Vector3.new(26, 610, 944), To = Vector3.new(11, 610, 940), Look = Vector3.new(8, 605, 918),
		Line = "Six chains have fallen silent.", Sub = "The incense remembers every name the Emissary carried home." },
	-- Studio F21: shot 1 ended inside a plaza lantern's collision box; aimed at y 700 the seated figure's head left the frame, and the dawn shot sat inside the
	-- FusedTreeStatue's robe (its bounds reach z 844); the figure now fills shot 2 and shot 3 pulls back past it.
	{ Kind = "Shot", Duration = 7, From = Vector3.new(0, 614, 900), To = Vector3.new(0, 632, 868), Look = Vector3.new(0, 770, 705),
		Line = "\"Return them to rest,\" he said, \"and I shall return for you.\"", Sub = "The ferryman keeps his word." },
	{ Kind = "Shot", Duration = 7, From = Vector3.new(0, 628, 960), To = Vector3.new(0, 640, 1000), Look = Vector3.new(10, 880, 600),
		Line = "Beyond the jade dawn, the river of souls lies open.", Sub = "Some endings must be chosen by the dead." },
	{ Kind = "Card", Duration = 6, Line = "THE ASURA'S PATH", Sub = "Six sovereigns at rest · the crossing is made" },
	{ Kind = "Credits", Duration = 14, Line = "CREDITS", Sub = "" },
	{ Kind = "Return", Duration = 5, Line = "THE EMISSARY RETURNS",
		Sub = "Everything you earned remains · the world, the forge and the Colosseum stay open" },
} :: { Beat })
Ending.CardBeat = 4 -- a skip jumps here once; a second skip ends the scene
Ending.SkipGuard = 0.8 -- seconds before input can skip (the choosing click must not skip)

-- Camera frame for a beat at `t` seconds in; reduced motion holds the beat's final framing.
function Ending.frame(beat: Beat, t: number, reducedMotion: boolean): (Vector3?, Vector3?)
	if not beat.From or not beat.To or not beat.Look then return nil, nil end
	local alpha = if reducedMotion then 1 else math.clamp(t / beat.Duration, 0, 1)
	alpha = alpha * alpha * (3 - 2 * alpha)
	return beat.From + (beat.To - beat.From) * alpha, beat.Look
end

return table.freeze(Ending)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">EnvironmentProfiles</string>
            <string name="Source">--!strict
-- Shared authoring values. The server supplies the shrine baseline; each client blends its biome.
-- Boss fights use the arena biome's own combat treatment ("Combat:&lt;Region&gt;"), and the second
-- phase deepens it atmospherically ("Unbound:&lt;Region&gt;") without lowering the neutral fill floor.
local rgb = Color3.fromRGB
local Profiles = {}
local function profile(clock: number, ambient: Color3, outdoor: Color3, tint: Color3, mist: Color3,
	density: number, haze: number, exposure: number, rays: number, saturation: number): any
	return {
		Lighting = { ClockTime = clock, Ambient = ambient, OutdoorAmbient = outdoor, Brightness = 2,
			ExposureCompensation = exposure, EnvironmentDiffuseScale = 0.55, EnvironmentSpecularScale = 1,
			ColorShift_Top = tint, ColorShift_Bottom = rgb(16, 18, 25), ShadowSoftness = 0.24 },
		CB_Atmosphere = { Density = density, Haze = haze, Color = mist, Decay = ambient, Glare = 0.15, Offset = 0.1 },
		CB_ColorCorrection = { TintColor = tint, Saturation = saturation, Contrast = 0.2, Brightness = 0 },
		CB_SunRays = { Spread = 0.4, Intensity = rays },
		CB_Bloom = { Intensity = 0.15, Threshold = 2.2, Size = 24 },
	}
end
-- The Shrine at golden hour (lobby rebuild 2026-10-21): low sun in the west, warm haze over the sea of
-- clouds under the Sanctuary skybox, and enough neutral fill to read floors, faces and the pale statue.
-- Real aerial perspective separates the carved courtyard, the sacred terrace and the remote peaks.
-- Future / Realistic lighting is baked into default.project.json (the runtime cannot change it).
Profiles.Sanctuary = profile(17.4, rgb(60, 70, 92), rgb(105, 117, 139), rgb(255, 245, 226), rgb(250, 215, 185), 0.38, 2.2, -0.12, 0.12, 0.05)
Profiles.Sanctuary.Lighting.Brightness, Profiles.Sanctuary.Lighting.EnvironmentDiffuseScale = 2.2, 0.65
Profiles.Sanctuary.Lighting.ColorShift_Bottom = rgb(32, 40, 53)
Profiles.Sanctuary.CB_Atmosphere.Decay, Profiles.Sanctuary.CB_Atmosphere.Glare, Profiles.Sanctuary.CB_Atmosphere.Offset = rgb(120, 130, 165), 0.35, 0.2
Profiles.Sanctuary.CB_ColorCorrection.TintColor, Profiles.Sanctuary.CB_ColorCorrection.Contrast = rgb(255, 246, 236), 0.15
Profiles.Sanctuary.CB_SunRays.Spread = 0.45
Profiles.Sanctuary.CB_Bloom = { Intensity = 0.25, Threshold = 2.0, Size = 24 }
Profiles.DesecratedMonastery = profile(15, rgb(38, 43, 52), rgb(67, 73, 83), rgb(206, 220, 238), rgb(143, 155, 170), 0.4, 2.5, -0.22, 0.015, -0.45)
Profiles.BambooPass = profile(16, rgb(34, 48, 44), rgb(76, 91, 79), rgb(219, 235, 221), rgb(158, 181, 165), 0.38, 2.2, -0.1, 0.06, -0.22)
-- Night stays night (ashen sky), but walking it needs crypt-level fill: at 27/47 fill, -0.3 exposure and
-- 3.8 haze the road, court and arena walls read near-black at character height (Studio F17).
Profiles.AshColosseum = profile(0.15, rgb(52, 45, 50), rgb(88, 76, 80), rgb(217, 191, 184), rgb(84, 74, 80), 0.42, 2.8, -0.12, 0, -0.4)
-- The Sunken Crypt (batch 19) reads by pale, cool fill and its lanterns instead of near-black mist.
Profiles.SanctuaryDepths = profile(0, rgb(48, 56, 64), rgb(74, 86, 94), rgb(186, 214, 224), rgb(72, 94, 102), 0.4, 2.6, -0.12, 0, -0.28)
Profiles.CelestialPagoda = profile(17.5, rgb(46, 34, 39), rgb(81, 61, 65), rgb(245, 208, 190), rgb(153, 111, 108), 0.4, 2.4, -0.08, 0.08, -0.22)
Profiles.SkyCitadel = profile(18.4, rgb(31, 38, 57), rgb(64, 75, 101), rgb(211, 219, 250), rgb(123, 139, 182), 0.38, 2.5, -0.1, 0.06, -0.26)

-- Combat readability floor: every fight keeps this much neutral fill and this little mist, so
-- actors, weapons and the arena edge read at play distance without any attack effect active.
Profiles.Floor = table.freeze({ Ambient = 60, Outdoor = 95, Exposure = -0.1, Density = 0.34, Haze = 2.2 })
function Profiles.luminance(c: Color3): number
	return (0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B) * 255
end
-- Warm a colour toward blood red while keeping its luminance (phase two must not get darker).
local function crimson(c: Color3, amount: number): Color3
	local shifted = Color3.new(c.R * (1 + 0.6 * amount), c.G * (1 - 0.35 * amount), c.B * (1 - 0.3 * amount))
	local scale = Profiles.luminance(c) / math.max(Profiles.luminance(shifted), 1e-3)
	return Color3.new(math.min(shifted.R * scale, 1), math.min(shifted.G * scale, 1), math.min(shifted.B * scale, 1))
end
local function unbound(base: any): any
	local l, a, c = base.Lighting, base.CB_Atmosphere, base.CB_ColorCorrection
	local p = profile(l.ClockTime, crimson(l.Ambient, 0.5), crimson(l.OutdoorAmbient, 0.4), crimson(l.ColorShift_Top, 0.55),
		crimson(a.Color, 0.7), math.min(a.Density + 0.03, Profiles.Floor.Density), math.min(a.Haze + 0.3, Profiles.Floor.Haze),
		l.ExposureCompensation, 0, c.Saturation + 0.12)
	p.CB_ColorCorrection.Contrast = 0.24
	return p
end

-- Per-biome fight treatment: same palette family as the exploration profile, raised fill, thinner
-- mist. Fill/Brazier colour the arena lanterns (ArenaLighting); night arenas stay night.
local combat: { [string]: any } = {
	Sanctuary = profile(17.4, rgb(100, 104, 119), rgb(143, 150, 166), rgb(255, 225, 190), rgb(250, 215, 185), 0.32, 2, 0.02, 0.12, 0.05),
	DesecratedMonastery = profile(14.5, rgb(66, 72, 82), rgb(112, 118, 128), rgb(218, 226, 238), rgb(150, 160, 172), 0.3, 1.8, -0.05, 0.02, -0.3),
	BambooPass = profile(15.5, rgb(62, 76, 70), rgb(110, 126, 114), rgb(226, 238, 226), rgb(166, 186, 170), 0.28, 1.6, -0.02, 0.05, -0.15),
	AshColosseum = profile(0.15, rgb(80, 70, 72), rgb(122, 108, 108), rgb(232, 206, 198), rgb(92, 80, 84), 0.3, 1.8, 0, 0, -0.3),
	SanctuaryDepths = profile(0, rgb(66, 80, 90), rgb(100, 118, 128), rgb(196, 222, 230), rgb(64, 88, 96), 0.32, 2, -0.02, 0, -0.22),
	CelestialPagoda = profile(17.3, rgb(76, 62, 66), rgb(124, 104, 106), rgb(248, 220, 204), rgb(166, 128, 124), 0.3, 1.8, 0, 0.06, -0.12),
	SkyCitadel = profile(17.8, rgb(62, 70, 92), rgb(110, 120, 150), rgb(222, 228, 252), rgb(136, 150, 190), 0.28, 1.8, -0.02, 0.05, -0.15),
}
combat.Sanctuary.CB_Atmosphere.Decay = rgb(120, 130, 165)
combat.Sanctuary.CB_Atmosphere.Offset, combat.Sanctuary.CB_Atmosphere.Glare = 0.2, 0.35
local arenas: { [string]: { Fill: Color3, Brazier: Color3 } } = {
	Sanctuary = { Fill = rgb(255, 236, 214), Brazier = rgb(255, 170, 96) },
	DesecratedMonastery = { Fill = rgb(214, 224, 240), Brazier = rgb(255, 161, 84) },
	BambooPass = { Fill = rgb(226, 240, 222), Brazier = rgb(255, 176, 104) },
	AshColosseum = { Fill = rgb(246, 226, 210), Brazier = rgb(255, 150, 76) },
	SanctuaryDepths = { Fill = rgb(206, 230, 240), Brazier = rgb(255, 168, 110) },
	CelestialPagoda = { Fill = rgb(255, 232, 214), Brazier = rgb(255, 160, 96) },
	SkyCitadel = { Fill = rgb(220, 228, 255), Brazier = rgb(255, 172, 112) },
}
Profiles.UnboundBrazier = rgb(255, 64, 72)
local byKey: { [string]: any } = {}
for region, values in combat do
	byKey["Combat:" .. region] = values
	byKey["Unbound:" .. region] = unbound(values)
end
Profiles.Biomes = table.freeze(table.clone(combat))

function Profiles.get(key: string): any
	return byKey[key] or (Profiles :: any)[key]
end
function Profiles.arena(region: string?): { Fill: Color3, Brazier: Color3 }
	return arenas[region or ""] or arenas.Sanctuary
end
-- `arena` is the boss arena's region; the fight's look follows the arena, not the camera's spot.
function Profiles.resolve(region: string?, encounter: boolean, phase: number, arena: string?): string
	if encounter then
		local biome = arena or region
		local id = if biome and combat[biome] then biome else "Sanctuary"
		return (if phase &gt;= 2 then "Unbound:" else "Combat:") .. id
	end
	return if region and type((Profiles :: any)[region]) == "table" and combat[region] then region else "Sanctuary"
end
function Profiles.isUnbound(key: string): boolean
	return string.sub(key, 1, 8) == "Unbound:"
end
-- The ashen night skybox: the Colosseum itself and every second phase.
function Profiles.nightSky(key: string): boolean
	return Profiles.isUnbound(key) or key == "AshColosseum" or key == "Combat:AshColosseum"
end
-- Which skybox a profile uses: the ashen night set, the Shrine's golden hour, or the place default.
function Profiles.skyFor(key: string): string?
	if Profiles.nightSky(key) then return "Night" end
	if key == "Sanctuary" or key == "Combat:Sanctuary" then return "Sunset" end
	return nil
end
-- Drifting ash belongs to the Colosseum only (it competes with telegraphs elsewhere).
function Profiles.ashFall(key: string): boolean
	return key == "AshColosseum" or key == "Combat:AshColosseum" or key == "Unbound:AshColosseum"
end
function Profiles.acoustics(region: string, position: Vector3): string
	if region == "SanctuaryDepths" then return "Cloister" end
	if region == "DesecratedMonastery" then
		if position.Z &lt; -940 and position.Z &gt; -985 then return "Ravine" end
		if position.Z &lt; -990 or (position.Z &lt; -870 and position.Z &gt; -940) then return "Cloister" end
	end
	return "Open"
end
return table.freeze(Profiles)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">InputMap</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/InputMap
-- The one authoritative control scheme. Every binding (combat, spells, menus), every in-world
-- ProximityPrompt key, the action bar, spell badges and the controls reference read from here, so
-- a displayed key can never differ from the key that is accepted. Keys are Enum names so the map
-- stays testable outside Roblox; `Interact` is also the key every world prompt uses.
local InputMap = {}

export type Command =
	"Light" | "Heavy" | "WeaponArt" | "Guard" | "Roll" | "Dash" | "Sprint" | "Lock" | "Swap" | "Heal"
	| "Interact" | "Shoulder" | "Cursor" | "Jump" | "Slide" | "Aim"
	| "SpellOne" | "SpellTwo" | "Arsenal" | "Codex" | "Controls" | "Pause"
export type Owner = "Combat" | "Spell" | "Interface"
export type Binding = {
	Command: Command,
	Owner: Owner,
	Keys: { string }, -- Enum.KeyCode names (keyboard)
	Mouse: { string }, -- Enum.UserInputType names
	Pad: { string }, -- Enum.KeyCode names (gamepad)
	Key: string, -- keyboard caption
	PadKey: string, -- gamepad caption ("—" when unbound)
	Touch: string?, -- on-screen control caption, nil when touch has no equivalent
	Help: string?, -- controls reference row; nil keeps it off the card
}

local function bind(command: Command, owner: Owner, keys: { string }, mouse: { string }, pad: { string }, key: string, padKey: string, touch: string?, help: string?): Binding
	return { Command = command, Owner = owner, Keys = keys, Mouse = mouse, Pad = pad, Key = key, PadKey = padKey, Touch = touch, Help = help }
end

-- Order is the order a newcomer needs them on the controls reference.
InputMap.Bindings = {
	bind("Light", "Combat", {}, { "MouseButton1" }, { "ButtonR1" }, "M1", "R1", "ATK", "Light attack"),
	bind("Heavy", "Combat", { "V" }, {}, { "ButtonR2" }, "V", "R2", "HVY", "Heavy attack · Deathblow"),
	bind("Guard", "Combat", { "F" }, {}, { "ButtonL1" }, "F", "L1", "GUARD", "Guard · tap on impact to deflect"),
	bind("Jump", "Combat", { "Space" }, {}, { "ButtonA" }, "Space", "A", "JUMP", "Jump · double jump"),
	bind("Dash", "Combat", { "LeftShift", "Q" }, {}, { "ButtonB" }, "Shift/Q", "B", "DASH", "Dash · stamina + brief i-frames"),
	bind("Slide", "Combat", { "C", "LeftControl" }, {}, { "ButtonL3" }, "C/Ctrl", "L3", "SLIDE", "Hold slide · + Jump: bullet jump"),
	bind("Aim", "Combat", {}, { "MouseButton2" }, { "ButtonL2" }, "RMB", "L2", "GLIDE", "Hold in air to glide (3.5 s)"),
	bind("Lock", "Combat", { "X" }, { "MouseButton3" }, { "ButtonR3" }, "X", "R3", "LOCK", "Lock on to a foe"),
	bind("Heal", "Combat", { "R" }, {}, { "ButtonStart" }, "R", "Start", "HEAL", "Drink from the gourd"),
	bind("Interact", "Combat", { "Z" }, {}, { "ButtonX" }, "Z", "X", "USE", "Interact · rest, recover, read, speak"),
	bind("WeaponArt", "Combat", { "G" }, {}, { "ButtonY" }, "G", "Y", "SKILL", "Weapon art"),
	bind("Swap", "Combat", { "K" }, {}, { "DPadRight" }, "K", "D-Right", "SWAP", "Swap weapon"),
	bind("SpellOne", "Spell", { "One" }, {}, { "DPadUp" }, "1", "D-Up", "SPELL", "Cast spell slot 1"),
	bind("SpellTwo", "Spell", { "E" }, {}, { "DPadDown" }, "E", "D-Down", "SPELL", "Cast spell slot 2"),
	bind("Arsenal", "Spell", { "B" }, {}, { "ButtonSelect" }, "B", "Select", "ARSENAL", "Open the Arsenal"),
	bind("Sprint", "Combat", { "CapsLock" }, {}, { "DPadLeft" }, "Caps", "D-Left", nil, "Toggle sprint"),
	bind("Codex", "Interface", { "J" }, {}, {}, "J", "—", "CODEX", "Open the Codex"),
	bind("Shoulder", "Combat", { "T" }, {}, {}, "T", "—", nil, "Switch camera shoulder"),
	bind("Cursor", "Combat", { "LeftAlt" }, {}, {}, "Alt", "—", nil, "Hold to release the mouse cursor"),
	bind("Controls", "Interface", { "H" }, {}, {}, "H", "—", nil, nil),
	bind("Pause", "Interface", { "P" }, {}, {}, "P", "—", nil, nil),
}

-- Evasion uses the dash input; it has no key of its own.
local ALIASES: { [string]: Command } = { Roll = "Dash" }

local byCommand: { [string]: Binding } = {}
for _, binding in InputMap.Bindings do
	byCommand[binding.Command] = binding
end

function InputMap.get(command: string): Binding?
	return byCommand[ALIASES[command] or command]
end

-- Caption for a device; touch answers its on-screen label (or "—" when it has none).
function InputMap.label(command: string, device: string): string
	local binding = InputMap.get(command)
	if not binding then
		return "?"
	end
	if device == "Gamepad" then
		return binding.PadKey
	elseif device == "Touch" then
		return binding.Touch or "—"
	end
	return binding.Key
end

-- Lookup tables { [keyName]: Command } for one owner, built from the map.
function InputMap.lookup(owner: Owner, field: "Keys" | "Mouse" | "Pad"): { [string]: Command }
	local result: { [string]: Command } = {}
	for _, binding in InputMap.Bindings do
		if binding.Owner == owner then
			for _, name in (binding :: any)[field] :: { string } do
				result[name] = binding.Command
			end
		end
	end
	return result
end

-- Every in-world prompt answers the Interact binding: one key for altars, NPCs, caches, lore,
-- fog gates, bloodstains, portals and the smith.
InputMap.PromptKey = (byCommand.Interact :: Binding).Keys[1]
InputMap.PromptPad = (byCommand.Interact :: Binding).Pad[1]

function InputMap.applyPrompt(prompt: ProximityPrompt)
	prompt.KeyboardKeyCode = (Enum.KeyCode :: any)[InputMap.PromptKey]
	prompt.GamepadKeyCode = (Enum.KeyCode :: any)[InputMap.PromptPad]
end

export type PromptView = { Enabled: boolean, Key: string, Pad: string }
export type Route = "Blocked" | "Prompt" | "Intent"

-- Who owns an Interact press. Open menus and focused text boxes own every key; otherwise the
-- newest visible prompt on this device's Interact input owns it (touch USE drives any prompt),
-- and only with no such prompt does the press become the server Interact intent.
function InputMap.routeInteract(device: string, prompts: { PromptView }, blocked: boolean): (Route, number?)
	if blocked then
		return "Blocked", nil
	end
	for index = #prompts, 1, -1 do
		local prompt = prompts[index]
		if prompt.Enabled and (device == "Touch"
			or (device == "Keyboard" and prompt.Key == InputMap.PromptKey)
			or (device == "Gamepad" and prompt.Pad == InputMap.PromptPad)) then
			return "Prompt", index
		end
	end
	return "Intent", nil
end

-- Inputs claimed by more than one command on the same device ({} when the scheme is clean).
function InputMap.conflicts(): { string }
	local found: { string } = {}
	for _, field in { "Keys", "Mouse", "Pad" } do
		local seen: { [string]: string } = {}
		for _, binding in InputMap.Bindings do
			for _, name in (binding :: any)[field] :: { string } do
				local other = seen[name]
				if other and other ~= binding.Command then
					table.insert(found, string.format("%s %s: %s / %s", field, name, other, binding.Command))
				end
				seen[name] = binding.Command
			end
		end
	end
	return found
end

return table.freeze(InputMap)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">IntentProtocol</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/IntentProtocol
-- Pure validation; all client tables have exact keys and bounded flat payloads.
export type Frame = {seq: number,x: number,z: number,yaw: number,guard: boolean,body: boolean}
export type Bucket = { tokens: number, time: number }
local Protocol = {}
local LIMBS: {[string]: boolean}={LeftHand=true,RightHand=true,LeftLeg=true,RightLeg=true,Evade=true,Tap=true,Guard=true,Style=true}
local VARIANTS: {[string]: boolean}={Primary=true,Alternate=true,Up=true,Down=true,Left=true,Right=true,Roll=true,Ironline=true,ApexStriker=true,Groundforge=true,Pass=true,TakeBack=true,Sweep=true,Armbar=true,RNC=true,Guillotine=true,StandUp=true,Takedown=true}
local function finite(v: any,low: number,high: number): boolean
	return type(v)=="number" and v==v and v&gt;=low and v&lt;=high
end
local function keys(t: any,allowed: {[string]: boolean},expected: number): boolean
	if type(t)~="table" then return false end
	local count=0
	for k in pairs(t) do
		count+=1
		if count&gt;expected or type(k)~="string" or not allowed[k] then return false end
	end
	return count==expected
end
function Protocol.Take(bucket: Bucket,now: number,cost: number,rate: number,burst: number): boolean
	bucket.tokens=math.min(burst,bucket.tokens+math.max(0,now-bucket.time)*rate)
	bucket.time=math.max(bucket.time,now)
	if bucket.tokens&lt;cost then return false end
	bucket.tokens-=cost
	return true
end
function Protocol.Movement(packet: any,session: string,lastSequence: number,c: any): ({Frame}?,string?)
	if not keys(packet,{version=true,session=true,frames=true},3) then return nil,"shape" end
	if packet.version~=c.Protocol or packet.session~=session then return nil,"session" end
	if type(packet.frames)~="table" then return nil,"frames" end
	local count=0
	for k in pairs(packet.frames) do
		count+=1
		if count&gt;c.MaxBatch or type(k)~="number" or not finite(k,1,c.MaxBatch) or k%1~=0 then return nil,"batch" end
	end
	if count==0 then return nil,"empty" end
	local result: {Frame}={}
	for i=1,count do
		local f=packet.frames[i]
		if not keys(f,{seq=true,x=true,z=true,yaw=true,guard=true,body=true},6) or type(f.guard)~="boolean" or type(f.body)~="boolean" then return nil,"frame shape" end
		if not finite(f.seq,lastSequence+1,math.min(c.MaxSequence,lastSequence+c.MaxSequenceGap)) or f.seq%1~=0 then return nil,"sequence" end
		if i&gt;1 and f.seq~=result[i-1].seq+1 then return nil,"order" end
		if not finite(f.x,-1,1) or not finite(f.z,-1,1) or f.x*f.x+f.z*f.z&gt;1.00001 then return nil,"axes" end
		if not finite(f.yaw,-math.pi,math.pi) then return nil,"yaw" end
		result[i]={seq=f.seq,x=f.x,z=f.z,yaw=f.yaw,guard=f.guard,body=f.body}
	end
	return result,nil
end
function Protocol.Action(packet: any,session: string,lastSequence: number,c: any): boolean
	if not keys(packet,{version=true,session=true,seq=true,action=true,variant=true,body=true,grapple=true,pressed=true},8) then return false end
	return packet.version==c.Protocol and packet.session==session
		and finite(packet.seq,lastSequence+1,math.min(c.MaxSequence,lastSequence+c.MaxSequenceGap)) and packet.seq%1==0
		and type(packet.action)=="string" and LIMBS[packet.action]==true
		and type(packet.variant)=="string" and VARIANTS[packet.variant]==true
		and type(packet.body)=="boolean" and type(packet.grapple)=="boolean" and type(packet.pressed)=="boolean"
end
local SHOP_FIELDS: {[string]: {[string]: boolean}}={
 SaveSettings={action=true,settings=true},GetProfile={action=true},RollStyle={action=true,useToken=true},
 RollCrate={action=true,crateId=true},BuyCosmetic={action=true,itemId=true},EquipCosmetic={action=true,itemId=true},
 EquipStyle={action=true,styleName=true},BuyBundle={action=true,bundleId=true},
}
function Protocol.Shop(packet: any): boolean
 if type(packet)~="table" or type(packet.action)~="string" then return false end
 local allowed=SHOP_FIELDS[packet.action]
 if not allowed then return false end
 local expected=if packet.action=="GetProfile" then 1 else 2
 if not keys(packet,allowed,expected) then return false end
 if packet.action=="GetProfile" then return true end
 if packet.action=="SaveSettings" then
  local s=packet.settings
  local count=if type(s)=="table" then 3+(if s.keybinds~=nil then 1 else 0)+(if s.comfort~=nil then 1 else 0) else 3
  if not keys(s,{fov=true,sensitivity=true,leftHanded=true,keybinds=true,comfort=true},count) then return false end
  if s.comfort~=nil then -- comfort/readability toggles (batch 25)
   local c=s.comfort
   if not keys(c,{ReducedEffects=true,ReducedMotion=true,ReducedFlashes=true,TextScale=true},4) then return false end
   if type(c.ReducedEffects)~="boolean" or type(c.ReducedMotion)~="boolean" or type(c.ReducedFlashes)~="boolean" then return false end
   if c.TextScale~=1 and c.TextScale~=1.15 and c.TextScale~=1.3 then return false end
  end
  if s.keybinds~=nil then
   if type(s.keybinds)~="table" then return false end
   local n=0
   for k,v in s.keybinds do n+=1;if n&gt;11 or type(k)~="string" or #k&gt;16 or type(v)~="string" or #v&gt;32 then return false end end
  end
  return finite(s.fov,70,90)
   and finite(s.sensitivity,0.5,2) and type(s.leftHanded)=="boolean"
 end
 if packet.action=="RollStyle" then return type(packet.useToken)=="boolean" end
 local id=packet.itemId or packet.styleName or packet.bundleId or packet.crateId
 return type(id)=="string" and #id&gt;0 and #id&lt;=64 and string.match(id,"^[%w_]+$")~=nil
end
function Protocol.QueueEnabled(mode: string,feature: boolean,rankedPassed: boolean,studioQA: boolean): boolean
 return mode=="Casual1v1" or (mode=="Ranked1v1" and ((feature and rankedPassed) or studioQA))
end
function Protocol.Matchmaking(packet: any): boolean
 if type(packet)~="table" then return false end
 if packet.action=="Dequeue" then return keys(packet,{action=true},1) end
 return keys(packet,{action=true,mode=true},2) and packet.action=="Enqueue"
  and (packet.mode=="Ranked1v1" or packet.mode=="Casual1v1")
end
return table.freeze(Protocol)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">LevelPreview</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/LevelPreview
-- Concrete before/after results of raising one attribute, derived from the same formulas the
-- server applies (ProgressionRules.stats + CombatSettings base values, as ProfileStore.DeriveStats
-- does), plus readable labels and the Essence cost/remaining line. Essence is the currency spent
-- here; Qi is the regenerating spell resource, so the two words never share a label.
local hasScript = pcall(function() return script.Parent end)
local Rules: any = if hasScript then require((script :: any).Parent.ProgressionRules) else require("./ProgressionRules")
local Settings: any = if hasScript then require((script :: any).Parent.CombatSettings) else require("./CombatSettings")

local Preview = {}

Preview.Max = 99 -- mirrors ProfileStore ATTRIBUTE_MAX and the dialogue level assert
Preview.Currency = "Essence"
Preview.Labels = table.freeze({
	Vigor = "Vigor", Endurance = "Endurance", Strength = "Strength", Dexterity = "Dexterity", ArcaneQi = "Arcane Qi",
})
Preview.Summary = table.freeze({
	Vigor = "Health and Blood Rally recovery",
	Endurance = "Stamina and posture",
	Strength = "Heavy and unarmed strike damage",
	Dexterity = "Bladed technique damage",
	ArcaneQi = "Qi pool and spell damage",
})

export type Benefit = { Label: string, Before: number, After: number, Percent: boolean }

-- Stat rows each attribute moves, read from the derived-stat table.
local ROWS: { [string]: { { any } } } = {
	Vigor = { { "Max HP", "MaxHP" }, { "Rally recovery", "RallyScale", true } },
	Endurance = { { "Stamina", "MaxStamina" }, { "Posture", "PostureCapacity" } },
	Strength = { { "Strength damage", "StrengthScale", true } },
	Dexterity = { { "Blade damage", "DexterityScale", true } },
	ArcaneQi = { { "Max Qi", "MaxQi" }, { "Spell damage", "SpellScale", true } },
}

-- The derived values ProfileStore.DeriveStats produces for these attributes and forge tier.
function Preview.derived(attributes: { [string]: number }, tier: number): { [string]: number }
	local s = Rules.stats(attributes, tier)
	return {
		MaxHP = Settings.Health.MaxHP + s.HPBonus, MaxStamina = Settings.Stamina.Max + s.StaminaBonus,
		PostureCapacity = Settings.Posture.StanceBreakThreshold + s.PostureBonus, MaxQi = s.MaxQi,
		RallyScale = s.RallyScale, SpellScale = s.SpellScale, StrengthScale = s.StrengthScale, DexterityScale = s.DexterityScale,
	}
end

function Preview.benefits(attributes: { [string]: number }, attribute: string, tier: number): { Benefit }
	local rows = ROWS[attribute]
	if not rows then return {} end
	local after = table.clone(attributes)
	after[attribute] = (after[attribute] or 10) + 1
	local a, b = Preview.derived(attributes, tier), Preview.derived(after, tier)
	local result: { Benefit } = {}
	for _, row in rows do
		table.insert(result, { Label = row[1], Before = a[row[2]], After = b[row[2]], Percent = row[3] == true })
	end
	return result
end

local function number(value: number, percent: boolean): string
	if percent then return string.format("%.1f%%", value * 100) end
	local rounded = math.floor(value * 10 + 0.5) / 10
	return if rounded % 1 == 0 then string.format("%d", rounded) else string.format("%.1f", rounded)
end

function Preview.format(b: Benefit): string
	return b.Label .. " " .. number(b.Before, b.Percent) .. " → " .. number(b.After, b.Percent)
end

-- One line for a menu row: every changed stat, or why the attribute cannot grow.
function Preview.line(attributes: { [string]: number }, attribute: string, tier: number): string
	if (attributes[attribute] or 10) &gt;= Preview.Max then return "At its peak" end
	local parts = {}
	for _, b in Preview.benefits(attributes, attribute, tier) do table.insert(parts, Preview.format(b)) end
	return table.concat(parts, "  ·  ")
end

-- Cost line: what this level costs and what is left, or how much more Essence is needed.
function Preview.quote(essence: number, cost: number): (boolean, string)
	if essence &gt;= cost then
		return true, string.format("Cost %d %s  ·  %d left after", cost, Preview.Currency, essence - cost)
	end
	return false, string.format("Need %d more %s  (%d / %d)", cost - essence, Preview.Currency, essence, cost)
end

return table.freeze(Preview)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">LooksBeasts</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/LooksBeasts
-- Batch 12 looks. Venerable Baize: a low white frost beast (horned head, third eye, gold-white mane,
-- watchful eyes along its flanks, plumed tail) authored on the root around the BossBodies "Beast"
-- capsules, paws on the ground at y = -3; legs, jaw, mane and tail are joints CreatureMotion poses.
-- Phase 2 (Unbound) ices the mane and raises crystal spines. The Slumbering Titan: a scale-3
-- stone ancient (antlered root-bearded head, shoulder boulders, bronze gorget, slung broken haft)
-- whose lower legs stay slim so the camera keeps clear at the ankles; its glowing shackles mark the
-- ankle weak point. Phase 2 splits it with magma. Positions are studs at scale 1 (CostumeSchema).
local Schema = require(script.Parent.CostumeSchema)
local P = Schema.P
local R = "HumanoidRootPart"

local FUR, MANE, ICE, HORN, EYE = { 228, 232, 236 }, { 240, 232, 206 }, { 150, 212, 244 }, { 196, 214, 228 }, { 110, 220, 255 }
local STONE, ROCK, BRONZE, ROOT, MOSS = { 92, 90, 86 }, { 70, 66, 62 }, { 120, 92, 56 }, { 58, 44, 34 }, { 72, 88, 52 }
local EMBER, MAGMA = { 255, 170, 60 }, { 255, 96, 30 }

local function mirror(list: { Schema.Piece }, name: string, size: { number }, at: { number }, color: { number }, material: string, extra: { [string]: any }?)
	-- `at`, Rot, Pivot and Joint are authored for the left (-x) piece; the right mirrors them.
	for side = -1, 1, 2 do
		local e: { [string]: any } = table.clone(extra or {})
		local m = -side
		if e.Rot then e.Rot = { e.Rot[1], e.Rot[2] * m, e.Rot[3] * m } end
		if e.Pivot then e.Pivot = { e.Pivot[1] * m, e.Pivot[2], e.Pivot[3] } end
		if e.Joint and side &gt; 0 then e.Joint = string.gsub(e.Joint, "L$", "R") end
		table.insert(list, P(name .. (if side &lt; 0 then "L" else "R"), e.Bone or R, size, { at[1] * m, at[2], at[3] }, color, material, e))
	end
end

local function baize(): Schema.Look
	local list: { Schema.Piece } = {
		P("Chest", R, { 2.15, 2, 2 }, { 0, -0.35, -1.15 }, FUR, "SmoothPlastic", { Shape = "Ball", Role = "Body" }),
		P("Barrel", R, { 2, 1.85, 2.4 }, { 0, -0.5, 0.15 }, FUR, "SmoothPlastic", { Role = "Body" }),
		P("Haunch", R, { 2, 1.9, 1.9 }, { 0, -0.5, 1.3 }, FUR, "SmoothPlastic", { Shape = "Ball", Role = "Body" }),
		P("Neck", R, { 1, 1.1, 1 }, { 0, 0.05, -1.85 }, FUR, "SmoothPlastic", { Rot = { -35, 0, 0 }, Role = "Body" }),
		P("Skull", R, { 1.1, 1, 1.25 }, { 0, 0.45, -2.5 }, FUR, "SmoothPlastic", { Joint = "Neck", Pivot = { 0, 0.1, -1.9 }, Role = "Body" }),
		P("Muzzle", R, { 0.8, 0.6, 0.7 }, { 0, 0.25, -3.1 }, FUR, "SmoothPlastic", { Joint = "Neck", Pivot = { 0, 0.1, -1.9 }, Role = "Body" }),
		P("Jaw", R, { 0.74, 0.24, 0.8 }, { 0, -0.07, -2.95 }, { 200, 196, 196 }, "SmoothPlastic", { Joint = "Jaw", Pivot = { 0, -0.05, -2.5 } }),
		P("ThirdEye", R, { 0.2, 0.12, 0.05 }, { 0, 0.78, -3.15 }, EYE, "Neon", { Joint = "Neck", Pivot = { 0, 0.1, -1.9 }, Glow = 5 }),
		P("ManeCrest", R, { 1.6, 1.5, 1.2 }, { 0, 0.5, -1.7 }, MANE, "Fabric", { Joint = "Mane", Pivot = { 0, 0.2, -1.4 }, Phase = 1 }),
		P("FrostMane", R, { 1.7, 1.6, 1.25 }, { 0, 0.55, -1.7 }, ICE, "Ice", { Joint = "Mane", Pivot = { 0, 0.2, -1.4 }, Phase = 2, Glow = 7 }),
		P("Tail1", R, { 0.4, 0.4, 1 }, { 0, -0.1, 2.75 }, FUR, "SmoothPlastic", { Rot = { -30, 0, 0 }, Joint = "Tail1", Pivot = { 0, -0.35, 2.3 } }),
		P("Tail2", R, { 0.35, 0.35, 1 }, { 0, 0.4, 3.45 }, FUR, "SmoothPlastic", { Rot = { -40, 0, 0 }, Joint = "Tail2", Pivot = { 0, 0.15, 3.1 } }),
		P("TailPlume", R, { 0.8, 0.8, 1.2 }, { 0, 0.9, 4 }, MANE, "Fabric", { Rot = { -45, 0, 0 }, Joint = "Tail3", Pivot = { 0, 0.6, 3.6 } }),
	}
	mirror(list, "Horn", { 0.18, 1.2, 0.18 }, { -0.35, 1.1, -2.3 }, HORN, "Marble", { Rot = { -30, 0, 15 }, Joint = "Neck", Pivot = { 0, 0.1, -1.9 } })
	mirror(list, "Eye", { 0.18, 0.1, 0.05 }, { -0.3, 0.6, -3.15 }, EYE, "Neon", { Joint = "Neck", Pivot = { 0, 0.1, -1.9 } })
	mirror(list, "Ear", { 0.15, 0.5, 0.35 }, { -0.55, 0.85, -2.2 }, FUR, "SmoothPlastic", { Rot = { 0, 0, 30 }, Joint = "Neck", Pivot = { 0, 0.1, -1.9 } })
	mirror(list, "SideMane", { 0.35, 1.3, 1.4 }, { -0.95, 0.1, -1.65 }, MANE, "Fabric", { Rot = { 0, 0, 10 }, Phase = 1 })
	mirror(list, "IceSideMane", { 0.38, 1.4, 1.45 }, { -0.97, 0.12, -1.65 }, ICE, "Ice", { Rot = { 0, 0, 10 }, Phase = 2 })
	for k = 0, 2 do
		mirror(list, "FlankEye" .. k, { 0.06, 0.14, 0.26 }, { -1.02, -0.3, -0.5 + k * 0.55 }, EYE, "Neon", {})
		table.insert(list, P("FrostSpine" .. k, R, { 0.3, 0.9, 0.3 }, { 0, 0.55, -0.6 + k * 0.7 }, ICE, "Ice", { Rot = { 15, 0, 0 }, Phase = 2 }))
	end
	-- Legs: hinge at the shoulder/hip, paws flat on the ground (bottom at y = -3).
	mirror(list, "Foreleg", { 0.6, 1.6, 0.6 }, { -0.75, -1.85, -1.25 }, FUR, "SmoothPlastic", { Joint = "LegFL", Pivot = { -0.75, -1.05, -1.25 }, Role = "Body" })
	mirror(list, "ForePaw", { 0.75, 0.3, 0.85 }, { -0.75, -2.85, -1.4 }, HORN, "SmoothPlastic", { Joint = "LegFL", Pivot = { -0.75, -1.05, -1.25 }, Role = "Foot" })
	mirror(list, "HindThigh", { 0.75, 1, 0.9 }, { -0.8, -1.35, 1.3 }, FUR, "SmoothPlastic", { Joint = "LegHL", Pivot = { -0.8, -1, 1.3 }, Role = "Body" })
	mirror(list, "HindShank", { 0.5, 1.25, 0.5 }, { -0.8, -2.25, 1.45 }, FUR, "SmoothPlastic", { Joint = "LegHL", Pivot = { -0.8, -1, 1.3 }, Role = "Body" })
	mirror(list, "HindPaw", { 0.75, 0.3, 0.85 }, { -0.8, -2.85, 1.35 }, HORN, "SmoothPlastic", { Joint = "LegHL", Pivot = { -0.8, -1, 1.3 }, Role = "Foot" })
	return { Key = "VenerableBaize", Rig = "Creature", HideBody = true, OwnWeapon = true, Phases = 2, Pieces = list }
end

local function titan(): Schema.Look
	local list: { Schema.Piece } = {
		P("StoneHelm", "Head", { 1.5, 1.3, 1.5 }, { 0, 0.1, 0 }, STONE, "Slate"),
		P("BrowRidge", "Head", { 1.6, 0.3, 0.4 }, { 0, 0.2, -0.7 }, ROCK, "Rock"),
		P("RootBeard", "Head", { 1, 0.9, 0.3 }, { 0, -0.7, -0.6 }, ROOT, "Wood"),
		P("Carapace", "UpperTorso", { 0.6, 0.5, 0.6 }, nil, STONE, "Slate", { Fit = true }),
		P("BronzeGorget", "UpperTorso", { 2.4, 0.4, 1.4 }, { 0, 0.75, 0 }, BRONZE, "CorrodedMetal"),
		P("ChestRune", "UpperTorso", { 0.6, 0.6, 0.08 }, { 0, 0.1, -0.86 }, EMBER, "Neon", { Rot = { 0, 0, 45 }, Glow = 6, Phase = 1 }),
		P("BackMoss", "UpperTorso", { 2.2, 1, 0.3 }, { 0, 0.3, 0.86 }, MOSS, "LeafyGrass"),
		P("SlungHaft", "UpperTorso", { 0.3, 4, 0.3 }, { 0.3, 0.3, 1.05 }, ROOT, "Wood", { Rot = { 0, 0, -35 }, Role = "Trim" }),
		P("StoneBelt", "LowerTorso", { 0.5, 0.4, 0.5 }, nil, ROCK, "Rock", { Fit = true }),
		P("LoinCloth", "LowerTorso", { 1.4, 1, 0.15 }, { 0, -0.7, -0.6 }, MOSS, "Fabric"),
		-- Phase 2: the stone splits; magma shows through.
		P("MagmaCore", "UpperTorso", { 0.7, 0.7, 0.08 }, { 0, 0.1, -0.87 }, MAGMA, "Neon", { Rot = { 0, 0, 45 }, Glow = 9, Phase = 2 }),
		P("ChestFissure", "UpperTorso", { 0.15, 1.4, 0.06 }, { 0.35, 0.05, -0.87 }, MAGMA, "Neon", { Rot = { 0, 0, 20 }, Phase = 2 }),
		P("BackFissure", "UpperTorso", { 0.15, 1.5, 0.06 }, { -0.2, 0.1, 0.87 }, MAGMA, "Neon", { Rot = { 0, 0, -15 }, Phase = 2 }),
	}
	mirror(list, "Eye", { 0.25, 0.1, 0.06 }, { -0.3, 0.05, -0.78 }, EMBER, "Neon", { Bone = "Head", Phase = 1 })
	mirror(list, "MoltenEye", { 0.28, 0.12, 0.06 }, { -0.3, 0.05, -0.78 }, MAGMA, "Neon", { Bone = "Head", Phase = 2, Glow = 4 })
	mirror(list, "Antler", { 0.25, 1.8, 0.25 }, { -0.6, 1.3, 0 }, ROOT, "Wood", { Bone = "Head", Rot = { 0, 0, 25 } })
	mirror(list, "AntlerTine", { 0.2, 0.9, 0.2 }, { -1.1, 1.6, -0.2 }, ROOT, "Wood", { Bone = "Head", Rot = { 0, 0, 60 } })
	mirror(list, "ShoulderBoulder", { 1.6, 1.4, 1.6 }, { -1.2, 0.95, 0.1 }, ROCK, "Rock", { Bone = "UpperTorso", Shape = "Ball" })
	for _, side in { "Left", "Right" } do
		local function on(bone: string, name: string, size: { number }, color: { number }, material: string, extra: { [string]: any }?)
			local e = table.clone(extra or {})
			e.Fit = if e.Fit == nil then true else e.Fit
			table.insert(list, P(side .. name, side .. bone, size, e.At, color, material, e))
		end
		on("UpperArm", "ArmStone", { 0.4, 0.1, 0.4 }, ROCK, "Rock")
		on("LowerArm", "Forearm", { 0.5, 0.1, 0.5 }, STONE, "Slate")
		on("LowerArm", "Bracer", { 1.55, 0.5, 1.55 }, BRONZE, "CorrodedMetal", { Fit = false, At = { 0, -0.3, 0 } })
		on("LowerArm", "ArmFissure", { 0.12, 0.8, 0.06 }, MAGMA, "Neon", { Fit = false, At = { 0, 0.2, -0.78 }, Phase = 2 })
		on("Hand", "StoneFist", { 0.5, 0.5, 0.5 }, ROCK, "Rock", { Role = "Weapon" })
		on("UpperLeg", "ThighStone", { 0.3, 0.05, 0.3 }, ROCK, "Rock")
		on("LowerLeg", "Shin", { 0.12, 0, 0.12 }, STONE, "Slate")
		on("LowerLeg", "AnkleShackle", { 1.3, 0.35, 1.3 }, BRONZE, "CorrodedMetal", { Fit = false, At = { 0, -0.35, 0 } })
		on("LowerLeg", "ShackleGlow", { 1.33, 0.08, 1.33 }, EMBER, "Neon", { Fit = false, At = { 0, -0.35, 0 }, Glow = 6 })
		on("Foot", "StoneFoot", { 0.3, 0.1, 0.5 }, ROCK, "Rock", { At = { 0, 0.05, -0.15 }, Role = "Foot" })
	end
	return { Key = "SlumberingTitan", Rig = "Humanoid", OwnWeapon = true, Phases = 2, Pieces = list,
		Body = { STONE, ROCK }, Body2 = { { 110, 70, 58 }, ROCK } }
end

return table.freeze({ VenerableBaize = baize(), SlumberingTitan = titan() })
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">LooksCast</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/LooksCast
-- Batch 14 looks for the speaking cast, each readable as a portrait subject and as a silhouette
-- across a courtyard: Lady Lin (long black hair with a sakura pin, rose outer robe over a white
-- floor-length skirt, a floating shawl and a glowing soul lantern), the Wandering Hermit (bald,
-- long white brows and beard, patched moss robe, bamboo pack with scrolls, gourd, tall knotted
-- staff) and Master Smith Gao (blindfold, grey topknot, leather apron and bracers, belt hammer;
-- built on his live rig). Studs from each limb's centre at scale 1 (CostumeSchema). `Look` is the
-- ground point a standing figure faces.
local Schema = require(script.Parent.CostumeSchema)
local P = Schema.P

local HAIR, ROSE, WHITE, CRIMSON, PINK, JADE = { 22, 18, 22 }, { 196, 150, 160 }, { 236, 230, 226 }, { 150, 36, 48 }, { 244, 168, 190 }, { 96, 200, 160 }
local MOSS, PATCH, BAMBOO, GOURD, SNOW, WOOD = { 77, 86, 70 }, { 112, 86, 58 }, { 168, 140, 84 }, { 176, 110, 50 }, { 236, 234, 228 }, { 90, 64, 40 }
local LEATHER, SOOT, GREY, IRON = { 92, 60, 40 }, { 24, 19, 18 }, { 120, 116, 110 }, { 80, 78, 76 }

local function pair(list: { Schema.Piece }, name: string, bone: string, size: { number }, at: { number }, color: { number }, material: string, extra: { [string]: any }?)
	-- Authored for the left piece; a "Left..." bone is routed to its "Right..." twin.
	for side = -1, 1, 2 do
		local e: { [string]: any } = table.clone(extra or {})
		if e.Rot then e.Rot = { e.Rot[1], -e.Rot[2] * side, -e.Rot[3] * side } end
		local limb = if side &gt; 0 and string.sub(bone, 1, 4) == "Left" then "Right" .. string.sub(bone, 5) else bone
		table.insert(list, P(name .. (if side &lt; 0 then "L" else "R"), limb, size, { -at[1] * side, at[2], at[3] }, color, material, e))
	end
end

local function face(list: { Schema.Piece }, eye: { number }, brow: { number })
	pair(list, "Eye", "Head", { 0.16, 0.07, 0.04 }, { -0.22, 0.06, -0.61 }, eye, "SmoothPlastic")
	pair(list, "Brow", "Head", { 0.3, 0.06, 0.04 }, { -0.22, 0.2, -0.61 }, brow, "Fabric")
end

