  <Item class="StarterPlayer" referent="48">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="49">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">AsurasPath</string>
        </Properties>
        <Item class="Folder" referent="51">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/CameraController
-- Third-person over-the-shoulder camera with lock-on. Yaw/pitch/distance are driven by critically
-- damped springs; a spherecast cast as the CameraProbe collision group (which only collides with
-- WorldGeometry) pulls the camera in front of walls and cage bars.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)

type WorldState = WorldState.WorldState
type Entity = WorldState.Entity

local Controller = {}
Controller.__index = Controller

local BASE_OFFSET = Vector3.new(1.8, 1.4, 10.5)
local CORRECTION_SPEED = 22
local MIN_DISTANCE, MAX_DISTANCE = 8, 16
local LOCK_RANGE = 60
local LOCK_BREAK_RANGE = 80
local PITCH_MIN, PITCH_MAX = math.rad(-70), math.rad(55)
local PROBE_RADIUS = 0.6
local PROBE_GROUP = "CameraProbe"
local OCCLUSION_RECOVER = 6
local SWITCH_COOLDOWN = 0.25
local SWITCH_MOUSE = 45
local SWITCH_STICK = 0.85

-- Rotational drag on lock tracking per head injury tier (concussion / eye trauma).
local TRAUMA_DRAG: { [string]: number } = { None = 1, Impaired = 0.75, Injured = 0.5, Severe = 0.3 }
local TRAUMA_WOBBLE: { [string]: number } = { None = 0, Impaired = 0.004, Injured = 0.01, Severe = 0.02 }

type Spring = { Value: number, Velocity: number }

type Fields = {
	State: WorldState,
	Camera: Camera,
	Yaw: Spring,
	Pitch: Spring,
	Distance: Spring,
	TargetYaw: number,
	TargetPitch: number,
	Occluded: number,
	Shoulder: number,
	ShoulderSpring: Spring,
	Locked: number?,
	LastSwitch: number,
	SwitchAccumulator: number,
	Fov: number,
	Sensitivity: number,
	FovPunch: Spring,
	FovClamp: number,
	Shake: Vector3,
	ShakeVelocity: Vector3,
	Roll: number,
	Sway: number,
	HeadTier: string,
	Clock: number,
	Params: RaycastParams,
	Enabled: boolean,
	OnLockChanged: ((id: number?) -> ())?,
}

export type CameraController = typeof(setmetatable({} :: Fields, Controller))

local function spring(value: number): Spring
	return { Value = value, Velocity = 0 }
end

-- Critically damped spring step (semi-implicit, stable at any frame rate up to 1/15 s).
local function stepSpring(s: Spring, target: number, omega: number, dt: number)
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for _ = 1, steps do
		local acceleration = omega * omega * (target - s.Value) - 2 * omega * s.Velocity
		s.Velocity += acceleration * h
		s.Value += s.Velocity * h
	end
end

local function wrap(angle: number): number
	return (angle + math.pi) % (2 * math.pi) - math.pi
end

local function yawOf(direction: Vector3): number
	return math.atan2(-direction.X, -direction.Z)
end

function Controller.new(state: WorldState): CameraController
	local camera = Workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local fields: Fields = {
		State = state,
		Camera = camera,
		Yaw = spring(0),
		Pitch = spring(math.rad(-12)),
		Distance = spring(BASE_OFFSET.Z),
		TargetYaw = 0,
		TargetPitch = math.rad(-12),
		Occluded = BASE_OFFSET.Z,
		Shoulder = 1,
		ShoulderSpring = spring(1),
		Locked = nil,
		LastSwitch = 0,
		SwitchAccumulator = 0,
		Fov = Config.Camera.FOV,
		Sensitivity = 1,
		FovPunch = spring(0),
		FovClamp = 0,
		Shake = Vector3.zero,
		ShakeVelocity = Vector3.zero,
		Roll = 0,
		Sway = 0,
		HeadTier = "None",
		Clock = 0,
		Params = params,
		Enabled = true,
		OnLockChanged = nil,
	}
	local self = setmetatable(fields, Controller)
	camera.CameraType = Enum.CameraType.Scriptable
	return self
end

-------------------------------------------------------------------------------------------------
-- Lock-on
-------------------------------------------------------------------------------------------------

local function targetPoint(entity: Entity): Vector3?
	local root = entity.Root
	if not root then
		return nil
	end
	local height = if entity.Boss then 2.4 else 1.2
	return root.Position + Vector3.new(0, height, 0)
end

function Controller.Candidates(self: CameraController): { Entity }
	local own = self.State:Own()
	local origin = if own and own.Root then own.Root.Position else self.Camera.CFrame.Position
	local list: { Entity } = {}
	for _, entity in self.State.Entities do
		if self.State:IsHostile(entity) and self.State:IsAlive(entity) and entity.Root then
			local root = entity.Root :: BasePart
			if (root.Position - origin).Magnitude <= LOCK_RANGE then
				local _, onScreen = self.Camera:WorldToViewportPoint(root.Position)
				if onScreen then
					table.insert(list, entity)
				end
			end
		end
	end
	return list
end

function Controller.SetLock(self: CameraController, id: number?)
	if self.Locked == id then
		return
	end
	self.Locked = id
	local callback = self.OnLockChanged
	if callback then
		callback(id)
	end
end

function Controller.ToggleLock(self: CameraController)
	if self.Locked then
		self:SetLock(nil)
		return
	end
	local viewport = self.Camera.ViewportSize
	local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
	local best: Entity? = nil
	local bestScore = math.huge
	for _, entity in self:Candidates() do
		local root = entity.Root :: BasePart
		local screen = self.Camera:WorldToViewportPoint(root.Position)
		local score = (Vector2.new(screen.X, screen.Y) - center).Magnitude + screen.Z * 4
		if score < bestScore then
			best, bestScore = entity, score
		end
	end
	if best then
		self:SetLock(best.Id)
	end
end

-- Switch to the nearest candidate on the requested screen side (-1 left, +1 right).
function Controller.SwitchTarget(self: CameraController, side: number)
	local current = if self.Locked then self.State:Get(self.Locked) else nil
	if not current or not current.Root then
		return
	end
	local now = os.clock()
	if now - self.LastSwitch < SWITCH_COOLDOWN then
		return
	end
	local origin = self.Camera:WorldToViewportPoint((current.Root :: BasePart).Position)
	local best: Entity? = nil
	local bestGap = math.huge
	for _, entity in self:Candidates() do
		if entity.Id ~= current.Id then
			local screen = self.Camera:WorldToViewportPoint((entity.Root :: BasePart).Position)
			local dx = screen.X - origin.X
			if dx * side > 0 and math.abs(dx) < bestGap then
				best, bestGap = entity, math.abs(dx)
			end
		end
	end
	if best then
		self.LastSwitch = now
		self:SetLock(best.Id)
	end
end

function Controller.LockedEntity(self: CameraController): Entity?
	local id = self.Locked
	if not id then
		return nil
	end
	return self.State:Get(id)
end

-------------------------------------------------------------------------------------------------
-- Input, feel and trauma hooks
-------------------------------------------------------------------------------------------------

-- Mouse/stick delta in pixels (or stick units scaled by the caller). While locked, horizontal
-- flicks switch targets instead of rotating.
function Controller.Look(self: CameraController, delta: Vector2, fromStick: boolean?)
	if self.Locked then
		if fromStick then
			if math.abs(delta.X) >= SWITCH_STICK then
				self:SwitchTarget(if delta.X > 0 then 1 else -1)
			end
			return
		end
		self.SwitchAccumulator = self.SwitchAccumulator * 0.85 + delta.X
		if math.abs(self.SwitchAccumulator) >= SWITCH_MOUSE then
			self:SwitchTarget(if self.SwitchAccumulator > 0 then 1 else -1)
			self.SwitchAccumulator = 0
		end
		return
	end
	local scale = Config.Camera.MouseSensitivity * self.Sensitivity
	self.TargetYaw -= delta.X * scale
	self.TargetPitch = math.clamp(self.TargetPitch - delta.Y * scale, PITCH_MIN, PITCH_MAX)
end

function Controller.ToggleShoulder(self: CameraController)
	self.Shoulder = -self.Shoulder
end

-- Directional shake and FOV punch. `direction` is world-space (the shake pushes along it).
function Controller.Impulse(self: CameraController, direction: Vector3?, magnitude: number, fovPunch: number?)
	local push = if direction and direction.Magnitude > 1e-3 then direction.Unit else Vector3.new(0, 1, 0)
	local localPush = self.Camera.CFrame:VectorToObjectSpace(push)
	self.ShakeVelocity += Vector3.new(localPush.X, localPush.Y, 0) * magnitude * 6
	self.Roll += (math.random() - 0.5) * magnitude * 0.05
	if fovPunch then
		self.FovPunch.Velocity += fovPunch * 18
	end
end

function Controller.SetHeadTrauma(self: CameraController, tier: string)
	self.HeadTier = if TRAUMA_DRAG[tier] then tier else "None"
end

function Controller.SetSway(self: CameraController, amplitude: number)
	self.Sway = amplitude
end

function Controller.SetFovClamp(self: CameraController, degrees: number)
	self.FovClamp = math.max(degrees, 0)
end

-------------------------------------------------------------------------------------------------
-- Frame update
-------------------------------------------------------------------------------------------------

function Controller.Update(self: CameraController, dt: number)
	local camera = Workspace.CurrentCamera
	self.Camera = camera
	camera.CameraType = Enum.CameraType.Scriptable
	self.Clock += dt
	local own = self.State:Own()
	local root = own and own.Root
	if not own or not root then
		return
	end

	local target = self:LockedEntity()
	if self.Locked and (not target or not self.State:IsAlive(target) or not target.Root
		or ((target.Root :: BasePart).Position - root.Position).Magnitude > LOCK_BREAK_RANGE) then
		self:SetLock(nil)
		target = nil
	end

	local pivot = root.Position + Vector3.new(0, BASE_OFFSET.Y, 0)
	local omega = CORRECTION_SPEED
	local desiredDistance = BASE_OFFSET.Z
	local humanoid = own.Humanoid
	if target and target.Root then
		local point = targetPoint(target) :: Vector3
		local midpoint = pivot:Lerp(point, 0.5)
		local flat = Vector3.new(midpoint.X - pivot.X, 0, midpoint.Z - pivot.Z)
		if flat.Magnitude > 0.1 then
			self.TargetYaw = yawOf(flat)
		end
		local separation = (point - pivot).Magnitude
		local elevation = point.Y - pivot.Y
		self.TargetPitch = math.clamp(math.atan2(elevation * 0.5, math.max(flat.Magnitude, 1)) - math.rad(10), PITCH_MIN, PITCH_MAX)
		desiredDistance = math.clamp(MIN_DISTANCE + separation * 0.28 + math.max(elevation, 0) * 0.6, MIN_DISTANCE, MAX_DISTANCE)
		omega = CORRECTION_SPEED * TRAUMA_DRAG[self.HeadTier]
		if humanoid then
			humanoid.AutoRotate = false
		end
		local snapshot = own.Snapshot
		local canTurn = snapshot == nil or (snapshot.State ~= "KO" and snapshot.State ~= "Dashing" and snapshot.State ~= "DeathblowVictim")
		if canTurn and flat.Magnitude > 0.1 then
			local look = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
			if look.Magnitude > 0.1 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
			end
		end
	elseif humanoid then
		humanoid.AutoRotate = true
	end

	self.Yaw.Value = self.TargetYaw + wrap(self.Yaw.Value - self.TargetYaw)
	stepSpring(self.Yaw, self.TargetYaw, omega, dt)
	stepSpring(self.Pitch, self.TargetPitch, omega, dt)
	stepSpring(self.Distance, desiredDistance, 8, dt)
	stepSpring(self.ShoulderSpring, self.Shoulder, 10, dt)
	stepSpring(self.FovPunch, 0, 14, dt)

	-- Shake: damped oscillator around zero in camera space.
	local shakeAcceleration = -self.Shake * 900 - self.ShakeVelocity * 30
	self.ShakeVelocity += shakeAcceleration * dt
	self.Shake += self.ShakeVelocity * dt
	self.Roll *= math.exp(-dt * 8)

	local wobble = TRAUMA_WOBBLE[self.HeadTier]
	local swayRoll = self.Sway * math.sin(self.Clock * 0.6) + wobble * math.sin(self.Clock * 2.3)
	local swayPitch = self.Sway * 0.5 * math.sin(self.Clock * 0.45 + 1.3) + wobble * math.cos(self.Clock * 1.7)
	local rotation = CFrame.fromEulerAnglesYXZ(self.Pitch.Value + swayPitch, self.Yaw.Value, self.Roll + swayRoll)
	local shoulder = BASE_OFFSET.X * self.ShoulderSpring.Value
	local origin = pivot + rotation:VectorToWorldSpace(Vector3.new(shoulder * 0.35, 0, 0))
	local desired = pivot + rotation:VectorToWorldSpace(Vector3.new(shoulder, 0, self.Distance.Value))

	-- Occlusion: snap in immediately, ease back out. CameraProbe only collides with WorldGeometry;
	-- before the server registers the groups, fall back to excluding every fighter model.
	local params = self.Params
	if PhysicsService:IsCollisionGroupRegistered(PROBE_GROUP) then
		params.CollisionGroup = PROBE_GROUP
		params.FilterDescendantsInstances = {}
	else
		local ignore: { Instance } = {}
		for _, entity in self.State.Entities do
			table.insert(ignore, entity.Model)
		end
		params.FilterDescendantsInstances = ignore
	end
	local offset = desired - origin
	local length = offset.Magnitude
	local allowed = length
	if length > 1e-3 then
		local hit = Workspace:Spherecast(origin, PROBE_RADIUS, offset, params)
		if hit then
			allowed = math.max(hit.Distance - 0.15, 0.5)
		end
	end
	if allowed < self.Occluded then
		self.Occluded = allowed
	else
		self.Occluded = math.min(allowed, self.Occluded + (allowed - self.Occluded) * math.min(1, dt * OCCLUSION_RECOVER) + dt)
	end
	local position = if length > 1e-3 then origin + offset.Unit * math.min(self.Occluded, length) else desired

	local shake = rotation:VectorToWorldSpace(Vector3.new(self.Shake.X, self.Shake.Y, 0))
	camera.CFrame = CFrame.new(position + shake) * rotation
	camera.Focus = CFrame.new(pivot)
	local fov = math.clamp(self.Fov + self.FovPunch.Value - self.FovClamp, Config.Camera.MinFOV - 20, Config.Camera.MaxFOV + 10)
	camera.FieldOfView = fov
end

function Controller.Destroy(self: CameraController)
	self.Enabled = false
	self:SetLock(nil)
	local own = self.State:Own()
	if own and own.Humanoid then
		own.Humanoid.AutoRotate = true
	end
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local player = Players.LocalPlayer
	if player.Character then
		camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
	end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">ColosseumController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ColosseumController
-- Colosseum matchmaking surface: the threshold panel (ranked queue, casual spar roster), incoming
-- challenge prompts, the duel countdown/clock and spectator notices. All authority stays on the
-- server; this controller only renders ColosseumIntent payloads and sends bounded requests.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local InputController = require(script.Parent:WaitForChild("InputController") :: ModuleScript)
local InterfaceController = require(script.Parent:WaitForChild("InterfaceController") :: ModuleScript)

type WorldState = WorldState.WorldState
type Cue = WorldState.Cue
type InputController = InputController.InputController
type Interface = InterfaceController.Interface

local Controller = {}
Controller.__index = Controller

local INK = Color3.fromRGB(14, 10, 9)
local IVORY = Color3.fromRGB(236, 226, 206)
local MUTED = Color3.fromRGB(150, 140, 126)
local EMBER = Color3.fromRGB(232, 132, 52)
local BLOOD = Color3.fromRGB(176, 22, 24)
local JADE = Color3.fromRGB(86, 168, 92)
local BORDER = Color3.fromRGB(120, 40, 32)

local TITLE_FONT = Enum.Font.Antique
local BODY_FONT = Enum.Font.Garamond
local NUMBER_FONT = Enum.Font.GothamMedium

local SPECTATOR_RADIUS = 110
local MAX_ROSTER = 24

local REASONS: { [string]: string } = {
	StepOnThreshold = "Stand upon the ember threshold.",
	AlreadyQueued = "You already await a ranked rival.",
	HighLatency = "Your connection is too slow for ranked duels.",
	RecoveryPending = "A previous duel is still being settled. Try again shortly.",
	AlreadyAssigned = "You have already been matched.",
	ProfileBusy = "Your record is busy. Try again.",
	RankedClosed = "The ranked league has not opened yet.",
	ColosseumClosed = "The Colosseum is closing.",
	InDuel = "Already in a duel.",
	Fallen = "Rise before you duel.",
	InBossFight = "The fog binds you to a fight.",
	EnemiesNearby = "Enemies still hunt you.",
	Unavailable = "Unavailable right now.",
	TargetInDuel = "They are already dueling.",
	TargetFallen = "They have fallen.",
	TargetInBossFight = "They are bound in a boss fight.",
	TargetEnemiesNearby = "They are being hunted.",
	TargetUnavailable = "They are unavailable.",
	TargetColosseumClosed = "The Colosseum is closing.",
	ChallengeExpired = "The challenge has lapsed.",
	ChallengeDeclined = "Your challenge was declined.",
	RingsOccupied = "Every ring is occupied. Try again soon.",
	RingOccupied = "The ring is occupied.",
	StartRefused = "The duel could not begin.",
	JournalUnavailable = "The ranked ledger is unavailable. Try again.",
	AlreadyChallenged = "They have already challenged you.",
	InvalidTarget = "Choose another opponent.",
}

local STATUS_TEXT: { [string]: string } = {
	Ready = "Ready",
	InDuel = "Dueling",
	Fallen = "Fallen",
	InBossFight = "In a boss fight",
	EnemiesNearby = "Hunted",
	Unavailable = "Away",
	ColosseumClosed = "Away",
}

type Row = { Frame: Frame, Name: TextLabel, Detail: TextLabel, Button: TextButton, Id: number }

type Fields = {
	State: WorldState,
	Input: InputController,
	Interface: Interface,
	Remote: RemoteEvent,
	Player: Player,
	Gui: ScreenGui,
	Panel: Frame,
	PanelTitle: TextLabel,
	PanelGlyph: TextLabel,
	PanelStatus: TextLabel,
	RankedButton: TextButton,
	RankedDetail: TextLabel,
	Roster: ScrollingFrame,
	RosterEmpty: TextLabel,
	Rows: { Row },
	Prompt: Frame,
	PromptText: TextLabel,
	PromptTimer: TextLabel,
	MatchFrame: Frame,
	MatchNames: TextLabel,
	MatchClock: TextLabel,
	MatchMode: TextLabel,
	Countdown: TextLabel,
	PanelOpen: boolean,
	MenuHeld: boolean,
	RankedOpen: boolean,
	Queued: boolean,
	QueuedAt: number,
	ChallengeId: string?,
	ChallengeExpires: number,
	MatchId: string?,
	MatchStarts: number,
	MatchEnds: number,
	LastCount: number,
	Connections: { RBXScriptConnection },
	Disconnects: { () -> () },
}

export type ColosseumController = typeof(setmetatable({} :: Fields, Controller))

-------------------------------------------------------------------------------------------------
-- Instance helpers
-------------------------------------------------------------------------------------------------

local function make<T>(className: string, parent: Instance?, properties: { [string]: any }): T
	local instance = Instance.new(className :: any)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance :: any
end

local function label(parent: Instance, text: string, size: number, font: Enum.Font, color: Color3, properties: { [string]: any }?): TextLabel
	local result = make("TextLabel", parent, {
		Text = text,
		TextSize = size,
		Font = font,
		TextColor3 = color,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = INK,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel
	if properties then
		for key, value in properties do
			(result :: any)[key] = value
		end
	end
	return result
end

local function decorate(frame: GuiObject, radius: number, thickness: number)
	make("UICorner", frame, { CornerRadius = UDim.new(0, radius) })
	make("UIStroke", frame, { Color = BORDER, Thickness = thickness, Transparency = 0.1 })
end

local function button(parent: Instance, text: string, size: UDim2, callback: () -> ()): TextButton
	local result = make("TextButton", parent, {
		Text = text,
		Font = BODY_FONT,
		TextSize = 20,
		TextColor3 = IVORY,
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.2,
		AutoButtonColor = true,
		Size = size,
		BorderSizePixel = 0,
		Selectable = true,
	}) :: TextButton
	decorate(result, 4, 1)
	result.Activated:Connect(callback)
	return result
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function clockText(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

-------------------------------------------------------------------------------------------------
-- Construction
-------------------------------------------------------------------------------------------------

function Controller.new(state: WorldState, input: InputController, ui: Interface, net: Instance): ColosseumController
	local player = Players.LocalPlayer
	local remote = net:WaitForChild("ColosseumIntent") :: RemoteEvent
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "AsuraColosseum",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 11,
	}) :: ScreenGui

	-- Threshold panel
	local panel = make("Frame", gui, {
		Name = "ColosseumPanel",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -60, 0.5, 0),
		Size = UDim2.fromOffset(400, 500),
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.12,
		Visible = false,
	}) :: Frame
	decorate(panel, 6, 2)
	make("UIPadding", panel, {
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
		PaddingTop = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 14),
	})
	local panelTitle = label(panel, "Colosseum", 26, TITLE_FONT, IVORY, {
		Size = UDim2.new(1, -40, 0, 32),
		TextWrapped = true,
		TextScaled = true,
	})
	local panelGlyph = label(panel, "", 30, TITLE_FONT, EMBER, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(36, 32),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local panelStatus = label(panel, "", 16, BODY_FONT, MUTED, {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 20),
	})
	label(panel, "Ranked Duel", 20, TITLE_FONT, EMBER, {
		Position = UDim2.fromOffset(0, 66),
		Size = UDim2.new(1, 0, 0, 24),
	})
	local rankedDetail = label(panel, "", 15, BODY_FONT, MUTED, {
		Position = UDim2.fromOffset(0, 90),
		Size = UDim2.new(1, 0, 0, 34),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local rankedButton: TextButton = nil :: any -- built below once `self` exists

	label(panel, "Casual Spar", 20, TITLE_FONT, EMBER, {
		Position = UDim2.fromOffset(0, 184),
		Size = UDim2.new(1, 0, 0, 24),
	})
	local roster = make("ScrollingFrame", panel, {
		Name = "Roster",
		Position = UDim2.fromOffset(0, 212),
		Size = UDim2.new(1, 0, 1, -270),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = BORDER,
	}) :: ScrollingFrame
	make("UIListLayout", roster, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	local rosterEmpty = label(roster, "No other warriors walk these lands.", 16, BODY_FONT, MUTED, {
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 0,
	})

	-- Incoming challenge prompt
	local prompt = make("Frame", gui, {
		Name = "ChallengePrompt",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(460, 132),
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.1,
		Visible = false,
	}) :: Frame
	decorate(prompt, 6, 2)
	make("UIPadding", prompt, {
		PaddingLeft = UDim.new(0, 16),
		PaddingRight = UDim.new(0, 16),
		PaddingTop = UDim.new(0, 12),
	})
	local promptText = label(prompt, "", 20, BODY_FONT, IVORY, {
		Size = UDim2.new(1, -60, 0, 52),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local promptTimer = label(prompt, "", 22, NUMBER_FONT, EMBER, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(56, 28),
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	-- Duel clock
	local matchFrame = make("Frame", gui, {
		Name = "DuelClock",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 24),
		Size = UDim2.fromOffset(520, 76),
		BackgroundTransparency = 1,
		Visible = false,
	}) :: Frame
	local matchMode = label(matchFrame, "", 16, TITLE_FONT, EMBER, {
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local matchNames = label(matchFrame, "", 22, TITLE_FONT, IVORY, {
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local matchClock = label(matchFrame, "", 26, NUMBER_FONT, IVORY, {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local countdown = label(gui, "", 120, TITLE_FONT, IVORY, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(600, 140),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		TextTransparency = 1,
	})

	local fields: Fields = {
		State = state,
		Input = input,
		Interface = ui,
		Remote = remote,
		Player = player,
		Gui = gui,
		Panel = panel,
		PanelTitle = panelTitle,
		PanelGlyph = panelGlyph,
		PanelStatus = panelStatus,
		RankedButton = rankedButton,
		RankedDetail = rankedDetail,
		Roster = roster,
		RosterEmpty = rosterEmpty,
		Rows = {},
		Prompt = prompt,
		PromptText = promptText,
		PromptTimer = promptTimer,
		MatchFrame = matchFrame,
		MatchNames = matchNames,
		MatchClock = matchClock,
		MatchMode = matchMode,
		Countdown = countdown,
		PanelOpen = false,
		MenuHeld = false,
		RankedOpen = false,
		Queued = false,
		QueuedAt = 0,
		ChallengeId = nil,
		ChallengeExpires = 0,
		MatchId = nil,
		MatchStarts = 0,
		MatchEnds = 0,
		LastCount = -1,
		Connections = {},
		Disconnects = {},
	}
	local self = setmetatable(fields, Controller)

	self.RankedButton = button(panel, "Enter the Ranked Queue", UDim2.new(1, 0, 0, 42), function()
		if not self.RankedOpen then
			self.Interface:ShowToast(REASONS.RankedClosed)
			return
		end
		self:Send({ action = if self.Queued then "Dequeue" else "Enqueue" })
	end)
	self.RankedButton.Position = UDim2.fromOffset(0, 130)
	button(panel, "Step Away", UDim2.new(1, 0, 0, 40), function()
		self:Send({ action = "Dismiss" })
		self:ClosePanel()
	end).Position = UDim2.new(0, 0, 1, -44)

	local accept = button(prompt, "Accept", UDim2.new(0.5, -6, 0, 40), function()
		self:Respond(true)
	end)
	accept.Position = UDim2.fromOffset(0, 70)
	accept.TextColor3 = JADE
	local decline = button(prompt, "Decline", UDim2.new(0.5, -6, 0, 40), function()
		self:Respond(false)
	end)
	decline.Position = UDim2.new(0.5, 6, 0, 70)

	table.insert(self.Connections, remote.OnClientEvent:Connect(function(payload: any)
		if type(payload) == "table" and type(payload.action) == "string" then
			self:Receive(payload)
		end
	end))
	table.insert(self.Disconnects, state:OnCue(function(cue: Cue)
		self:OnCue(cue)
	end))
	return self
end

-------------------------------------------------------------------------------------------------
-- Requests
-------------------------------------------------------------------------------------------------

function Controller.Send(self: ColosseumController, payload: { [string]: any })
	self.Remote:FireServer(payload)
end

function Controller.Respond(self: ColosseumController, accept: boolean)
	local id = self.ChallengeId
	if id then
		self:Send({ action = "Respond", challenge = id, accept = accept })
	end
	self.ChallengeId = nil
	self.Prompt.Visible = false
	self:HoldMenu(self.PanelOpen)
end

function Controller.Toast(self: ColosseumController, reason: any)
	local text = if type(reason) == "string" then REASONS[reason] or reason else nil
	if text then
		self.Interface:ShowToast(text)
	end
end

-------------------------------------------------------------------------------------------------
-- Panel
-------------------------------------------------------------------------------------------------

function Controller.HoldMenu(self: ColosseumController, held: boolean)
	if self.MenuHeld ~= held then
		self.MenuHeld = held
		self.Input:SetMenu(held)
	end
end

function Controller.OpenPanel(self: ColosseumController)
	if self.MatchId then
		return
	end
	self.PanelOpen = true
	self.Panel.Visible = true
	self:HoldMenu(true)
end

function Controller.ClosePanel(self: ColosseumController)
	self.PanelOpen = false
	self.Panel.Visible = false
	self:HoldMenu(self.Prompt.Visible)
end

function Controller.RefreshRanked(self: ColosseumController)
	local rankedButton = self.RankedButton
	if not self.RankedOpen then
		rankedButton.Text = "Ranked League Sealed"
		rankedButton.TextColor3 = MUTED
	elseif self.Queued then
		rankedButton.Text = "Leave the Queue  ·  " .. clockText(os.clock() - self.QueuedAt)
		rankedButton.TextColor3 = EMBER
	else
		rankedButton.Text = "Enter the Ranked Queue"
		rankedButton.TextColor3 = IVORY
	end
end

function Controller.Populate(self: ColosseumController, payload: any)
	self.PanelTitle.Text = tostring(payload.name or "Colosseum")
	self.PanelGlyph.Text = tostring(payload.glyph or "")
	self.RankedOpen = payload.rankedOpen == true
	local queued = payload.queued == true
	if queued and not self.Queued then
		self.QueuedAt = os.clock()
	end
	self.Queued = queued
	local ping = tonumber(payload.ping) or 0
	local limit = tonumber(payload.pingLimit) or 0
	local elo = tonumber(payload.elo)
	self.PanelStatus.Text = string.format(
		"%sLatency %d ms%s",
		if elo then string.format("Rating %d  ·  ", elo) else "",
		ping,
		if payload.occupied == true then "  ·  Ring in use" else ""
	)
	self.PanelStatus.TextColor3 = if limit > 0 and ping > limit then BLOOD else MUTED
	self.RankedDetail.Text = string.format(
		"Attributes are balanced to Soul Level %d in your build's proportions. Ranked requires latency under %d ms.",
		tonumber(payload.level) or 1,
		limit
	)
	self:RefreshRanked()

	local players = if type(payload.players) == "table" then payload.players else {}
	local count = math.min(#players, MAX_ROSTER)
	self.RosterEmpty.Visible = count == 0
	for index = 1, count do
		local entry = players[index]
		local row = self.Rows[index]
		if not row then
			local frame = make("Frame", self.Roster, {
				Size = UDim2.new(1, -8, 0, 44),
				BackgroundColor3 = INK,
				BackgroundTransparency = 0.4,
				LayoutOrder = index,
			}) :: Frame
			make("UICorner", frame, { CornerRadius = UDim.new(0, 4) })
			local nameLabel = label(frame, "", 18, BODY_FONT, IVORY, {
				Position = UDim2.fromOffset(10, 2),
				Size = UDim2.new(1, -120, 0, 22),
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			local detail = label(frame, "", 14, BODY_FONT, MUTED, {
				Position = UDim2.fromOffset(10, 22),
				Size = UDim2.new(1, -120, 0, 18),
			})
			local created: Row = { Frame = frame, Name = nameLabel, Detail = detail, Button = nil :: any, Id = 0 }
			created.Button = button(frame, "Challenge", UDim2.fromOffset(100, 32), function()
				if created.Id ~= 0 then
					self:Send({ action = "Challenge", target = created.Id })
				end
			end)
			created.Button.AnchorPoint = Vector2.new(1, 0.5)
			created.Button.Position = UDim2.new(1, -6, 0.5, 0)
			created.Button.TextSize = 16
			row = created
			self.Rows[index] = created
		end
		local ready = entry.status == "Ready"
		row.Id = tonumber(entry.id) or 0
		row.Name.Text = tostring(entry.name or "?")
		row.Detail.Text = string.format("Soul Level %d  ·  %s", tonumber(entry.level) or 1, STATUS_TEXT[tostring(entry.status)] or "Away")
		row.Detail.TextColor3 = if ready then JADE else MUTED
		row.Button.Visible = ready
		row.Frame.Visible = true
	end
	for index = count + 1, #self.Rows do
		self.Rows[index].Frame.Visible = false
		self.Rows[index].Id = 0
	end
end

-------------------------------------------------------------------------------------------------
-- Duel presentation
-------------------------------------------------------------------------------------------------

function Controller.Pulse(self: ColosseumController, text: string, color: Color3)
	local countdown = self.Countdown
	countdown.Text = text
	countdown.TextColor3 = color
	countdown.TextTransparency = 0
	countdown.TextStrokeTransparency = 0.3
	countdown.Size = UDim2.fromOffset(660, 160)
	TweenService:Create(countdown, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Size = UDim2.fromOffset(600, 140),
	}):Play()
end

function Controller.BeginMatch(self: ColosseumController, payload: any)
	self.Prompt.Visible = false
	self.ChallengeId = nil
	self:ClosePanel()
	self.Queued = false
	self.MatchId = tostring(payload.matchId)
	self.MatchStarts = tonumber(payload.starts) or serverNow()
	self.MatchEnds = tonumber(payload.ends) or (self.MatchStarts + 120)
	self.LastCount = -1
	local ranked = payload.mode == "Ranked1v1"
	self.MatchMode.Text = if ranked then "RANKED DUEL" else "CASUAL SPAR"
	local opponent = tostring(payload.opponentName or "Rival")
	if ranked and payload.opponentElo then
		opponent ..= string.format("  (%d)", tonumber(payload.opponentElo) or 0)
	end
	self.MatchNames.Text = string.format("%s   VS   %s", self.Player.DisplayName, opponent)
	self.MatchClock.Text = ""
	self.MatchFrame.Visible = true
	self.Interface:ShowBanner(string.upper(tostring(payload.name or "The Colosseum")), if ranked
		then string.format("Balanced to Soul Level %d", tonumber(payload.level) or 1)
		else "A spar between warriors", 2.6)
end

function Controller.EndMatch(self: ColosseumController, payload: any)
	self.MatchId = nil
	self.MatchFrame.Visible = false
	local outcome = tostring(payload.outcome or "")
	local opponent = tostring(payload.opponentName or "your rival")
	local delta = tonumber(payload.eloDelta)
	local subtitle = if delta then string.format("Rating %s%d", if delta >= 0 then "+" else "", delta) else ""
	if payload.reason == "Forfeit" then
		subtitle = (if subtitle ~= "" then subtitle .. "  ·  " else "") .. "by forfeit"
	elseif payload.reason == "Time" then
		subtitle = (if subtitle ~= "" then subtitle .. "  ·  " else "") .. "on time"
	end
	if outcome == "Win" then
		self.Interface:ShowBanner("VICTORY", if subtitle ~= "" then subtitle else "over " .. opponent, 4)
	elseif outcome == "Loss" then
		self.Interface:ShowBanner("DEFEAT", if subtitle ~= "" then subtitle else "to " .. opponent, 4)
	elseif outcome == "Draw" then
		self.Interface:ShowBanner("STALEMATE", subtitle, 4)
	else
		self.Interface:ShowBanner("DUEL ABANDONED", "", 3)
	end
end

-------------------------------------------------------------------------------------------------
-- Network
-------------------------------------------------------------------------------------------------

function Controller.Receive(self: ColosseumController, payload: any)
	local action: string = payload.action
	if action == "Open" then
		self:Populate(payload)
		self:OpenPanel()
	elseif action == "Roster" then
		self:Populate(payload)
	elseif action == "Close" then
		self:ClosePanel()
	elseif action == "Queue" then
		local queued = payload.queued == true
		if queued and not self.Queued then
			self.QueuedAt = os.clock()
		end
		self.Queued = queued
		if type(payload.rankedOpen) == "boolean" then
			self.RankedOpen = payload.rankedOpen
		end
		self:RefreshRanked()
		if payload.ok ~= true then
			self:Toast(payload.err)
		elseif queued then
			self.Interface:ShowToast("You await a worthy rival.")
		end
	elseif action == "Challenge" then
		self.ChallengeId = tostring(payload.challenge)
		self.ChallengeExpires = tonumber(payload.expires) or (serverNow() + 15)
		self.PromptText.Text = string.format("%s challenges you to a spar at %s.", tostring(payload.fromName or "A warrior"), tostring(payload.name or "the Colosseum"))
		self.Prompt.Visible = true
		self:HoldMenu(true)
	elseif action == "ChallengeWithdrawn" then
		if self.ChallengeId == payload.challenge then
			self.ChallengeId = nil
			self.Prompt.Visible = false
			if not self.PanelOpen then
				self:HoldMenu(false)
			end
		end
	elseif action == "ChallengeResult" then
		if payload.ok == true and payload.sent == true then
			self.Interface:ShowToast(string.format("Challenge sent to %s.", tostring(payload.name or "your rival")))
		elseif payload.ok ~= true then
			self:Toast(payload.err)
		end
	elseif action == "MatchFound" then
		self:BeginMatch(payload)
	elseif action == "MatchState" then
		if type(payload.ends) == "number" then
			self.MatchEnds = payload.ends
		end
	elseif action == "MatchResult" then
		self:EndMatch(payload)
	end
end

function Controller.OnCue(self: ColosseumController, cue: Cue)
	if cue.Kind ~= "ColosseumBegin" and cue.Kind ~= "ColosseumResult" then
		return
	end
	local data = cue.Data
	local own = self.State.LocalId
	if data.a == own or data.b == own then
		return
	end
	local root = self.State:Own()
	local part = root and root.Root
	local x, z = tonumber(data.x), tonumber(data.z)
	if not part or not x or not z or (Vector3.new(x, part.Position.Y, z) - part.Position).Magnitude > SPECTATOR_RADIUS then
		return
	end
	if cue.Kind == "ColosseumBegin" then
		self.Interface:ShowToast(string.format("%s faces %s in %s.", tostring(data.an or "?"), tostring(data.bn or "?"), tostring(data.name or "the ring")))
	elseif data.draw == true then
		self.Interface:ShowToast(string.format("%s and %s fight to a stalemate.", tostring(data.an or "?"), tostring(data.bn or "?")))
	elseif data.wn then
		self.Interface:ShowToast(string.format("%s prevails in %s.", tostring(data.wn), tostring(data.name or "the ring")))
	end
end

-------------------------------------------------------------------------------------------------
-- Frame
-------------------------------------------------------------------------------------------------

function Controller.Update(self: ColosseumController, _dt: number)
	local current = serverNow()
	if self.Prompt.Visible then
		local remaining = self.ChallengeExpires - current
		if remaining <= 0 then
			self.ChallengeId = nil
			self.Prompt.Visible = false
			if not self.PanelOpen then
				self:HoldMenu(false)
			end
		else
			self.PromptTimer.Text = tostring(math.ceil(remaining))
		end
	end
	if self.PanelOpen and self.Queued then
		self:RefreshRanked()
	end
	if self.MatchId then
		if current < self.MatchStarts then
			local count = math.ceil(self.MatchStarts - current)
			if count ~= self.LastCount then
				self.LastCount = count
				self:Pulse(tostring(count), IVORY)
			end
			self.MatchClock.Text = clockText(self.MatchEnds - self.MatchStarts)
		else
			if self.LastCount ~= 0 then
				self.LastCount = 0
				self:Pulse("FIGHT!", BLOOD)
			end
			local remaining = self.MatchEnds - current
			self.MatchClock.Text = clockText(remaining)
			self.MatchClock.TextColor3 = if remaining <= 10 then BLOOD else IVORY
		end
	end
end

function Controller.Destroy(self: ColosseumController)
	for _, disconnect in self.Disconnects do
		disconnect()
	end
	table.clear(self.Disconnects)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	self:HoldMenu(false)
	self.Gui:Destroy()
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">GameFeelController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/GameFeelController
-- Presentation-only combat feedback driven by the authoritative event stream: deflect sparks and
-- clang, animation hit-stop, weighted camera impulses and concussion (head/eye trauma) visuals.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Schema = require(Shared:WaitForChild("Simulation"):WaitForChild("MoveSchema") :: ModuleScript) :: any
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local CameraController = require(script.Parent:WaitForChild("CameraController") :: ModuleScript)

type WorldState = WorldState.WorldState
type CombatEvent = WorldState.CombatEvent
type Cue = WorldState.Cue
type CameraController = CameraController.CameraController

local Controller = {}
Controller.__index = Controller

-- Engine-bundled sounds only (the project ships no uploaded assets).
local SOUNDS = {
	Clang = "rbxasset://sounds/unsheath.wav",
	Slash = "rbxasset://sounds/swordslash.wav",
	Lunge = "rbxasset://sounds/swordlunge.wav",
	Blunt = "rbxasset://sounds/action_jump_land.mp3",
	Guard = "rbxasset://sounds/action_footsteps_plastic.mp3",
}

-- Hit-stop seconds and camera weight per event kind.
local HITSTOP: { [string]: number } = {
	Hit = 0.04,
	Armored = 0.04,
	CounterHit = 0.07,
	DeflectSpark = 0.05,
	GuardBreak = 0.06,
	StanceBreak = 0.07,
	Deathblow = 0.08,
}
local WEIGHT: { [string]: number } = {
	Hit = 0.18,
	Armored = 0.12,
	Block = 0.1,
	CounterHit = 0.4,
	DeflectSpark = 0.25,
	GuardBreak = 0.5,
	StanceBreak = 0.55,
	Deathblow = 0.9,
	KO = 0.6,
}
local FOV_PUNCH: { [string]: number } = {
	CounterHit = 2.5,
	GuardBreak = 3,
	StanceBreak = -3,
	Deathblow = -8,
	DeflectSpark = 1.2,
}
local BLUR_BY_TIER: { [string]: number } = { None = 0, Impaired = 4, Injured = 8, Severe = 14 }
local FOV_CLAMP_BY_TIER: { [string]: number } = { None = 0, Impaired = 4, Injured = 8, Severe = 14 }
local SWAY_BY_TIER: { [string]: number } = { None = 0, Impaired = 0.004, Injured = 0.009, Severe = 0.016 }
local FEEL_RANGE = 70

type Frozen = { Track: AnimationTrack, Speed: number, Until: number }

type Fields = {
	State: WorldState,
	Camera: CameraController,
	Folder: Folder,
	Blur: BlurEffect,
	Vignette: ScreenGui,
	VignetteEdges: { Frame },
	Frozen: { [AnimationTrack]: Frozen },
	Disconnects: { () -> () },
	BlurTarget: number,
	VignetteTarget: number,
	Tier: string,
}

export type GameFeel = typeof(setmetatable({} :: Fields, Controller))

local function vignetteEdge(parent: Instance, name: string, size: UDim2, position: UDim2, rotation: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = Color3.fromRGB(8, 0, 0)
	frame.BorderSizePixel = 0
	frame.BackgroundTransparency = 1
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = frame
	frame.Parent = parent
	return frame
end

function Controller.new(state: WorldState, camera: CameraController): GameFeel
	local folder = Instance.new("Folder")
	folder.Name = "AsuraFeel"
	folder.Parent = Workspace
	local blur = Instance.new("BlurEffect")
	blur.Name = "AsuraConcussion"
	blur.Size = 0
	blur.Parent = Lighting
	local gui = Instance.new("ScreenGui")
	gui.Name = "AsuraVignette"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local edges = {
		vignetteEdge(gui, "Left", UDim2.fromScale(0.28, 1), UDim2.fromScale(0, 0), 0),
		vignetteEdge(gui, "Right", UDim2.fromScale(0.28, 1), UDim2.fromScale(0.72, 0), 180),
		vignetteEdge(gui, "Top", UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), 90),
		vignetteEdge(gui, "Bottom", UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.7), 270),
	}
	local fields: Fields = {
		State = state,
		Camera = camera,
		Folder = folder,
		Blur = blur,
		Vignette = gui,
		VignetteEdges = edges,
		Frozen = {},
		Disconnects = {},
		BlurTarget = 0,
		VignetteTarget = 1,
		Tier = "None",
	}
	local self = setmetatable(fields, Controller)
	table.insert(self.Disconnects, state:OnEvent(function(event: CombatEvent)
		self:OnEvent(event)
	end))
	table.insert(self.Disconnects, state:OnCue(function(cue: Cue)
		self:OnCue(cue)
	end))
	return self
end

-------------------------------------------------------------------------------------------------
-- Sparks and audio
-------------------------------------------------------------------------------------------------

local function playSound(parent: Instance, id: string, volume: number, pitch: number)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = pitch
	sound.RollOffMaxDistance = 120
	sound.Parent = parent
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(4, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

function Controller.Spark(self: GameFeel, point: Vector3, direction: Vector3, color: Color3, count: number, speed: number)
	local anchor = Instance.new("Part")
	anchor.Name = "Spark"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	local facing = if direction.Magnitude > 1e-3 then direction.Unit else Vector3.new(0, 1, 0)
	anchor.CFrame = CFrame.lookAt(point, point + facing)
	local emitter = Instance.new("ParticleEmitter")
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Brightness = 3
	emitter.Speed = NumberRange.new(speed * 0.6, speed)
	emitter.SpreadAngle = Vector2.new(38, 38)
	emitter.Lifetime = NumberRange.new(0.08, 0.24)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emitter.Acceleration = Vector3.new(0, -60, 0)
	emitter.Drag = 4
	emitter.Rate = 0
	emitter.Parent = anchor
	local flash = Instance.new("PointLight")
	flash.Color = color
	flash.Range = 12
	flash.Brightness = 6
	flash.Parent = anchor
	anchor.Parent = self.Folder
	emitter:Emit(count)
	TweenService:Create(flash, TweenInfo.new(0.12), { Brightness = 0 }):Play()
	task.delay(0.6, function()
		anchor:Destroy()
	end)
	return anchor
end

-------------------------------------------------------------------------------------------------
-- Hit-stop
-------------------------------------------------------------------------------------------------

local function animator(model: Model): Animator?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return if humanoid then humanoid:FindFirstChildOfClass("Animator") else nil
end

function Controller.HitStop(self: GameFeel, models: { Model }, duration: number)
	local release = os.clock() + duration
	for _, model in models do
		local anim = animator(model)
		if anim then
			for _, track in anim:GetPlayingAnimationTracks() do
				local frozen = self.Frozen[track]
				if frozen then
					frozen.Until = math.max(frozen.Until, release)
				else
					self.Frozen[track] = { Track = track, Speed = track.Speed, Until = release }
					track:AdjustSpeed(0)
				end
			end
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Event handling
-------------------------------------------------------------------------------------------------

local function involves(self: GameFeel, event: CombatEvent): boolean
	local id = self.State.LocalId
	if event.Source == id or event.Target == id then
		return true
	end
	local locked = self.Camera.Locked
	return locked ~= nil and (event.Source == locked or event.Target == locked)
end

function Controller.OnEvent(self: GameFeel, event: CombatEvent)
	local source = self.State:Get(event.Source)
	local target = self.State:Get(event.Target)
	local point = event.Point or (if target and target.Root then target.Root.Position else nil)
	local own = self.State:Own()
	if not point or not own or not own.Root or (point - own.Root.Position).Magnitude > FEEL_RANGE then
		return
	end
	local kind = event.Kind
	local direction = Vector3.new(0, 1, 0)
	if source and source.Root and target and target.Root then
		direction = (target.Root.Position - source.Root.Position)
	end

	if kind == "DeflectSpark" then
		-- Source is the defender; sparks fly back toward the attacker.
		local back = if target and target.Root and source and source.Root then (target.Root.Position - source.Root.Position) else direction
		local anchor = self:Spark(point, back + Vector3.new(0, 0.6, 0), Color3.fromRGB(255, 196, 92), 48, 46)
		playSound(anchor, SOUNDS.Clang, 0.9, 1.25 + math.random() * 0.15)
		playSound(anchor, SOUNDS.Slash, 0.4, 1.8)
	elseif kind == "Block" then
		local anchor = self:Spark(point, -direction, Color3.fromRGB(200, 200, 210), 10, 22)
		playSound(anchor, SOUNDS.Guard, 0.7, 1.1)
	elseif kind == "GuardBreak" or kind == "StanceBreak" then
		local anchor = self:Spark(point, Vector3.new(0, 1, 0), Color3.fromRGB(255, 120, 40), 60, 34)
		playSound(anchor, SOUNDS.Clang, 1, 0.8)
	elseif kind == "Hit" or kind == "CounterHit" or kind == "Armored" or kind == "BleedProc" then
		local blunt = target ~= nil and source ~= nil and source.Snapshot ~= nil and source.Snapshot.Weapon == "Unarmed"
		local color = if blunt then Color3.fromRGB(230, 220, 200) else Color3.fromRGB(150, 10, 14)
		local anchor = self:Spark(point, direction, color, if kind == "CounterHit" then 34 else 18, 18)
		playSound(anchor, if blunt then SOUNDS.Blunt else SOUNDS.Slash, if kind == "CounterHit" then 1 else 0.7, 0.9 + math.random() * 0.2)
	elseif kind == "Deathblow" then
		local anchor = self:Spark(point, Vector3.new(0, 1, 0), Color3.fromRGB(170, 0, 0), 90, 30)
		playSound(anchor, SOUNDS.Lunge, 1, 0.7)
		playSound(anchor, SOUNDS.Clang, 0.6, 0.6)
	end

	if not involves(self, event) then
		return
	end
	local stop = HITSTOP[kind]
	if stop then
		local models: { Model } = {}
		if source then
			table.insert(models, source.Model)
		end
		if target then
			table.insert(models, target.Model)
		end
		self:HitStop(models, stop)
	end
	local weight = WEIGHT[kind]
	if weight then
		local scale = if event.Target == self.State.LocalId then 1 else 0.6
		self.Camera:Impulse(direction, weight * scale, FOV_PUNCH[kind])
	end
end

function Controller.OnCue(self: GameFeel, cue: Cue)
	local own = self.State:Own()
	if not own or not own.Root then
		return
	end
	if cue.Kind == "Shockwave" then
		local data = cue.Data
		local origin = Vector3.new(tonumber(data.x) or 0, tonumber(data.y) or 0, tonumber(data.z) or 0)
		local distance = (own.Root.Position - origin).Magnitude
		local radius = tonumber(data.radius) or 16
		local strength = math.clamp(1.2 - distance / (radius * 2.5), 0, 1)
		if strength > 0 then
			self.Camera:Impulse(own.Root.Position - origin, strength, 4 * strength)
			local anchor = self:Spark(origin, Vector3.new(0, 1, 0), Color3.fromRGB(190, 30, 30), 120, 60)
			playSound(anchor, SOUNDS.Lunge, 1, 0.45)
		end
	elseif cue.Kind == "BossPhase" then
		self.Camera:Impulse(Vector3.new(0, 1, 0), 0.7, -5)
	end
end

-------------------------------------------------------------------------------------------------
-- Per-frame: hit-stop release and concussion visuals
-------------------------------------------------------------------------------------------------

function Controller.Update(self: GameFeel, dt: number)
	local now = os.clock()
	for track, frozen in self.Frozen do
		if now >= frozen.Until then
			self.Frozen[track] = nil
			if track.IsPlaying then
				track:AdjustSpeed(frozen.Speed)
			end
		end
	end

	local snapshot = self.State:OwnSnapshot()
	local tier = "None"
	local blur = 0
	local vignette = 0
	if snapshot and snapshot.State ~= "KO" then
		tier = snapshot.Injuries.Head
		local penalties = Schema.penalties(snapshot.Injuries, false, "Right")
		-- Eye trauma (VisionBlur 0.2..0.75) maps onto Blur 4..14 alongside the concussion tier.
		local vision = if penalties.VisionBlur > 0 then 4 + (penalties.VisionBlur - 0.2) / 0.55 * 10 else 0
		blur = math.max(BLUR_BY_TIER[tier] or 0, vision)
		vignette = penalties.EyeVignette
	end
	if tier ~= self.Tier then
		self.Tier = tier
		self.Camera:SetHeadTrauma(tier)
		self.Camera:SetFovClamp(FOV_CLAMP_BY_TIER[tier] or 0)
		self.Camera:SetSway(SWAY_BY_TIER[tier] or 0)
	end
	-- Low-frequency pulse so heavy concussion "breathes" rather than sitting static.
	local pulse = if blur > 0 then 1 + 0.15 * math.sin(now * 1.4) else 1
	self.BlurTarget = math.clamp(blur * pulse, 0, 14)
	self.Blur.Size += (self.BlurTarget - self.Blur.Size) * math.min(1, dt * 4)
	local transparency = 1 - math.clamp(vignette * 1.1, 0, 0.85)
	for _, edge in self.VignetteEdges do
		edge.BackgroundTransparency += (transparency - edge.BackgroundTransparency) * math.min(1, dt * 3)
	end
end

function Controller.Destroy(self: GameFeel)
	for _, disconnect in self.Disconnects do
		disconnect()
	end
	table.clear(self.Disconnects)
	for track, frozen in self.Frozen do
		if track.IsPlaying then
			track:AdjustSpeed(frozen.Speed)
		end
	end
	table.clear(self.Frozen)
	self.Folder:Destroy()
	self.Blur:Destroy()
	self.Vignette:Destroy()
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/InputController
-- Hybrid Souls control scheme for keyboard/mouse, gamepad and touch. Presses are stamped with
-- server time, deduplicated and priority-ordered through the shared InputBuffer, then sent as
-- ActionIntent packets. The server buffers again and re-validates every action.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local InputBuffer = require(Shared:WaitForChild("Simulation"):WaitForChild("InputBuffer") :: ModuleScript)
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local CameraController = require(script.Parent:WaitForChild("CameraController") :: ModuleScript)

type WorldState = WorldState.WorldState
type CameraController = CameraController.CameraController

export type Device = "Keyboard" | "Gamepad" | "Touch"
export type Command =
	"Light"
	| "Heavy"
	| "WeaponArt"
	| "Guard"
	| "Roll"
	| "Dash"
	| "Sprint"
	| "Lock"
	| "Swap"
	| "Heal"
	| "Interact"
	| "Shoulder"
	| "Cursor"

local Controller = {}
Controller.__index = Controller

local KEYBOARD: { [Enum.KeyCode]: Command } = {
	[Enum.KeyCode.F] = "Guard",
	[Enum.KeyCode.LeftControl] = "Dash",
	[Enum.KeyCode.LeftShift] = "Sprint",
	[Enum.KeyCode.X] = "Lock",
	[Enum.KeyCode.Q] = "Swap",
	[Enum.KeyCode.R] = "Heal",
	[Enum.KeyCode.E] = "Interact",
	[Enum.KeyCode.G] = "WeaponArt",
	[Enum.KeyCode.T] = "Shoulder",
	[Enum.KeyCode.LeftAlt] = "Cursor",
}
local MOUSE: { [Enum.UserInputType]: Command } = {
	[Enum.UserInputType.MouseButton1] = "Light",
	[Enum.UserInputType.MouseButton2] = "Heavy",
	[Enum.UserInputType.MouseButton3] = "Lock",
}
local GAMEPAD: { [Enum.KeyCode]: Command } = {
	[Enum.KeyCode.ButtonR1] = "Light",
	[Enum.KeyCode.ButtonR2] = "Heavy",
	[Enum.KeyCode.ButtonL1] = "Guard",
	[Enum.KeyCode.ButtonL2] = "Roll",
	[Enum.KeyCode.ButtonB] = "Roll",
	[Enum.KeyCode.ButtonR3] = "Lock",
	[Enum.KeyCode.ButtonL3] = "Sprint",
	[Enum.KeyCode.DPadDown] = "Swap",
	[Enum.KeyCode.DPadUp] = "Heal",
	[Enum.KeyCode.ButtonX] = "Interact",
	[Enum.KeyCode.ButtonY] = "WeaponArt",
	[Enum.KeyCode.DPadRight] = "Shoulder",
}

local LABELS: { [Command]: { Keyboard: string, Gamepad: string } } = {
	Light = { Keyboard = "M1", Gamepad = "R1" },
	Heavy = { Keyboard = "M2", Gamepad = "R2" },
	Guard = { Keyboard = "F", Gamepad = "L1" },
	Roll = { Keyboard = "Space", Gamepad = "B" },
	Lock = { Keyboard = "X", Gamepad = "R3" },
	Swap = { Keyboard = "Q", Gamepad = "D-Down" },
	Heal = { Keyboard = "R", Gamepad = "D-Up" },
	Interact = { Keyboard = "E", Gamepad = "X" },
	WeaponArt = { Keyboard = "G", Gamepad = "Y" },
	Dash = { Keyboard = "Ctrl", Gamepad = "—" },
	Sprint = { Keyboard = "Shift", Gamepad = "L3" },
	Shoulder = { Keyboard = "T", Gamepad = "D-Right" },
	Cursor = { Keyboard = "Alt", Gamepad = "—" },
}

local TOUCH_LAYOUT: { { Command: Command, Label: string, Position: UDim2, Size: number } } = {
	{ Command = "Light", Label = "ATK", Position = UDim2.new(1, -96, 1, -150), Size = 84 },
	{ Command = "Heavy", Label = "HVY", Position = UDim2.new(1, -190, 1, -110), Size = 72 },
	{ Command = "Guard", Label = "GUARD", Position = UDim2.new(1, -110, 1, -250), Size = 72 },
	{ Command = "Roll", Label = "DODGE", Position = UDim2.new(1, -205, 1, -205), Size = 64 },
	{ Command = "WeaponArt", Label = "SKILL", Position = UDim2.new(1, -280, 1, -150), Size = 56 },
	{ Command = "Lock", Label = "LOCK", Position = UDim2.new(1, -70, 1, -330), Size = 52 },
	{ Command = "Heal", Label = "HEAL", Position = UDim2.new(1, -150, 1, -320), Size = 52 },
	{ Command = "Interact", Label = "USE", Position = UDim2.new(1, -230, 1, -290), Size = 52 },
	{ Command = "Swap", Label = "SWAP", Position = UDim2.new(1, -300, 1, -230), Size = 48 },
}

-- Space is the default jump key; the roll binding sinks it so a dodge never also hops.
local ROLL_ACTION = "AsuraRollSinkJump"
local STICK_DEADZONE = 0.18
local STICK_SPEED = 900
local TOUCH_SCALE = 1.4

export type Sender = (action: string, variant: string?, x: number?, z: number?, held: boolean?, time: number?) -> ()

type Fields = {
	State: WorldState,
	Camera: CameraController,
	Send: Sender,
	Buffer: InputBuffer.Buffer,
	Device: Device,
	Connections: { RBXScriptConnection },
	GuardHeld: boolean,
	SprintHeld: boolean,
	CursorFree: boolean,
	MenuOpen: boolean,
	Stick: Vector2,
	TouchLook: Vector2,
	TouchGui: ScreenGui,
	TouchButtons: { [Command]: TextButton },
	LookTouch: InputObject?,
	OnCommand: ((command: Command) -> ())?,
	OnDeviceChanged: ((device: Device) -> ())?,
}

export type InputController = typeof(setmetatable({} :: Fields, Controller))

local function deviceFor(inputType: Enum.UserInputType): Device?
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.sub(inputType.Name, 1, 7) == "Gamepad" then
		return "Gamepad"
	elseif inputType == Enum.UserInputType.Keyboard or string.sub(inputType.Name, 1, 5) == "Mouse" then
		return "Keyboard"
	end
	return nil
end

local function buildTouchGui(self: InputController)
	local gui = self.TouchGui
	for _, entry in TOUCH_LAYOUT do
		local button = Instance.new("TextButton")
		button.Name = entry.Command
		button.Text = entry.Label
		button.Font = Enum.Font.Antique
		button.TextScaled = true
		button.TextColor3 = Color3.fromRGB(236, 226, 206)
		button.BackgroundColor3 = Color3.fromRGB(20, 14, 12)
		button.BackgroundTransparency = 0.3
		button.AutoButtonColor = false
		button.Size = UDim2.fromOffset(entry.Size, entry.Size)
		button.Position = entry.Position
		button.AnchorPoint = Vector2.new(0.5, 0.5)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = button
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(150, 32, 28)
		stroke.Thickness = 2
		stroke.Parent = button
		local padding = Instance.new("UIPadding")
		padding.PaddingTop = UDim.new(0.18, 0)
		padding.PaddingBottom = UDim.new(0.18, 0)
		padding.Parent = button
		local command = entry.Command
		button.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.Touch then
				button.BackgroundTransparency = 0.05
				self:Press(command)
			end
		end)
		button.InputEnded:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.Touch then
				button.BackgroundTransparency = 0.3
				self:Release(command)
			end
		end)
		button.Parent = gui
		self.TouchButtons[command] = button
	end
end

function Controller.new(state: WorldState, camera: CameraController, send: Sender): InputController
	local gui = Instance.new("ScreenGui")
	gui.Name = "AsuraTouchControls"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 8
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local fields: Fields = {
		State = state,
		Camera = camera,
		Send = send,
		Buffer = InputBuffer.new(),
		Device = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Touch" else "Keyboard",
		Connections = {},
		GuardHeld = false,
		SprintHeld = false,
		CursorFree = false,
		MenuOpen = false,
		Stick = Vector2.zero,
		TouchLook = Vector2.zero,
		TouchGui = gui,
		TouchButtons = {},
		LookTouch = nil,
		OnCommand = nil,
		OnDeviceChanged = nil,
	}
	local self = setmetatable(fields, Controller)
	buildTouchGui(self)
	self:SetDevice(self.Device)

	table.insert(self.Connections, UserInputService.LastInputTypeChanged:Connect(function(inputType: Enum.UserInputType)
		local device = deviceFor(inputType)
		if device then
			self:SetDevice(device)
		end
	end))
	table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		self:Began(input, processed)
	end))
	table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input: InputObject, _processed: boolean)
		self:Ended(input)
	end))
	table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		self:Changed(input, processed)
	end))
	ContextActionService:BindActionAtPriority(ROLL_ACTION, function(_name: string, inputState: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
		if inputState == Enum.UserInputState.Begin and UserInputService:GetFocusedTextBox() == nil then
			self:SetDevice("Keyboard")
			self:Press("Roll")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)
	return self
end

function Controller.SetDevice(self: InputController, device: Device)
	if self.Device == device and self.TouchGui.Enabled == (device == "Touch") then
		return
	end
	self.Device = device
	self.TouchGui.Enabled = device == "Touch" and not self.MenuOpen
	local callback = self.OnDeviceChanged
	if callback then
		callback(device)
	end
end

function Controller.Label(self: InputController, command: Command): string
	local entry = LABELS[command]
	if self.Device == "Gamepad" then
		return entry.Gamepad
	elseif self.Device == "Touch" then
		return ""
	end
	return entry.Keyboard
end

function Controller.SetMenu(self: InputController, open: boolean)
	self.MenuOpen = open
	self.TouchGui.Enabled = self.Device == "Touch" and not open
	if open and self.GuardHeld then
		self:Release("Guard")
	end
	if open and self.SprintHeld then
		self:Release("Sprint")
	end
end

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- Movement intent in world space for evasions: stick/keys direction, else straight back.
function Controller.EvadeDirection(self: InputController): Vector3
	local own = self.State:Own()
	local humanoid = own and own.Humanoid
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
		local direction = humanoid.MoveDirection
		return Vector3.new(direction.X, 0, direction.Z).Unit
	end
	local look = Workspace.CurrentCamera.CFrame.LookVector
	local back = -Vector3.new(look.X, 0, look.Z)
	return if back.Magnitude > 1e-3 then back.Unit else Vector3.new(0, 0, 1)
end

function Controller.Press(self: InputController, command: Command)
	local callback = self.OnCommand
	if callback then
		callback(command)
	end
	if self.MenuOpen and command ~= "Interact" and command ~= "Cursor" then
		return
	end
	local stamp = now()
	if command == "Light" or command == "Heavy" or command == "WeaponArt" then
		InputBuffer.push(self.Buffer, command, stamp)
	elseif command == "Guard" then
		-- Sekiro rule: a guard press during a feintable windup feints; otherwise it deflects, and
		-- holding it keeps the guard raised once the deflect window closes.
		local snapshot = self.State:OwnSnapshot()
		if snapshot and snapshot.State == "Startup" then
			self.Send("Feint", nil, nil, nil, nil, stamp)
		end
		InputBuffer.push(self.Buffer, "Deflect", stamp)
		if not self.GuardHeld then
			self.GuardHeld = true
			self.Send("Block", nil, nil, nil, true, stamp)
		end
	elseif command == "Roll" or command == "Dash" then
		local direction = self:EvadeDirection()
		InputBuffer.push(self.Buffer, command, stamp, nil, direction.X, direction.Z)
	elseif command == "Sprint" then
		if self.Device == "Gamepad" then
			self.SprintHeld = not self.SprintHeld
		else
			self.SprintHeld = true
		end
		self.Send("Sprint", nil, nil, nil, self.SprintHeld, stamp)
	elseif command == "Lock" then
		self.Camera:ToggleLock()
	elseif command == "Shoulder" then
		self.Camera:ToggleShoulder()
	elseif command == "Swap" then
		self.Send("Swap", nil, nil, nil, nil, stamp)
	elseif command == "Heal" then
		self.Send("Heal", nil, nil, nil, nil, stamp)
	elseif command == "Interact" then
		self.Send("Interact", nil, nil, nil, nil, stamp)
	elseif command == "Cursor" then
		self.CursorFree = not self.CursorFree
	end
end

function Controller.Release(self: InputController, command: Command)
	if command == "Guard" and self.GuardHeld then
		self.GuardHeld = false
		self.Send("Block", nil, nil, nil, false, now())
	elseif command == "Sprint" and self.Device ~= "Gamepad" and self.SprintHeld then
		self.SprintHeld = false
		self.Send("Sprint", nil, nil, nil, false, now())
	end
end

function Controller.Began(self: InputController, input: InputObject, processed: boolean)
	local device = deviceFor(input.UserInputType)
	if device then
		self:SetDevice(device)
	end
	if input.UserInputType == Enum.UserInputType.Touch then
		if not processed and self.LookTouch == nil and input.Position.X > Workspace.CurrentCamera.ViewportSize.X * 0.4 then
			self.LookTouch = input
		end
		return
	end
	if processed or UserInputService:GetFocusedTextBox() ~= nil then
		return
	end
	local command: Command? = nil
	if input.UserInputType == Enum.UserInputType.Keyboard then
		command = KEYBOARD[input.KeyCode]
	elseif MOUSE[input.UserInputType] then
		command = MOUSE[input.UserInputType]
	elseif device == "Gamepad" then
		command = GAMEPAD[input.KeyCode]
	end
	if command ~= nil then
		self:Press(command :: Command)
	end
end

function Controller.Ended(self: InputController, input: InputObject)
	if input == self.LookTouch then
		self.LookTouch = nil
		return
	end
	local command: Command? = nil
	if input.UserInputType == Enum.UserInputType.Keyboard then
		command = KEYBOARD[input.KeyCode]
	elseif MOUSE[input.UserInputType] then
		command = MOUSE[input.UserInputType]
	elseif deviceFor(input.UserInputType) == "Gamepad" then
		command = GAMEPAD[input.KeyCode]
	end
	if command ~= nil then
		self:Release(command :: Command)
	end
end

function Controller.Changed(self: InputController, input: InputObject, processed: boolean)
	if input.KeyCode == Enum.KeyCode.Thumbstick2 then
		local value = Vector2.new(input.Position.X, -input.Position.Y)
		self.Stick = if value.Magnitude > STICK_DEADZONE then value else Vector2.zero
	elseif input == self.LookTouch and not processed then
		self.TouchLook += Vector2.new(input.Delta.X, input.Delta.Y) * TOUCH_SCALE
	end
end

-- Per frame: route look input to the camera, then flush buffered presses in priority order.
function Controller.Step(self: InputController, dt: number)
	local gameplay = not self.MenuOpen and not self.CursorFree and self.Device ~= "Touch"
	UserInputService.MouseBehavior = if gameplay then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = not gameplay
	if not self.MenuOpen then
		if self.Device == "Keyboard" and gameplay then
			local delta = UserInputService:GetMouseDelta()
			if delta.Magnitude > 0 then
				self.Camera:Look(delta)
			end
		elseif self.Device == "Gamepad" then
			if self.Camera.Locked then
				self.Camera:Look(self.Stick, true)
			elseif self.Stick.Magnitude > 0 then
				self.Camera:Look(self.Stick * STICK_SPEED * dt)
			end
		elseif self.Device == "Touch" and self.TouchLook.Magnitude > 0 then
			self.Camera:Look(self.TouchLook)
		end
	end
	self.TouchLook = Vector2.zero
	if GuiService.MenuIsOpen then
		return
	end
	local stamp = now()
	for _ = 1, self.Buffer.Capacity do
		local action, time, variant, x, z = InputBuffer.pop(self.Buffer, stamp)
		if action == nil then
			break
		end
		local hasDirection = action == "Roll" or action == "Dash"
		self.Send(action, if variant ~= "" then variant else nil, if hasDirection then x else nil, if hasDirection then z else nil, nil, time)
	end
end

function Controller.Destroy(self: InputController)
	ContextActionService:UnbindAction(ROLL_ACTION)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	self.TouchGui:Destroy()
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

return Controller
]]></string>
