local WEAPONS: { [WeaponType]: Weapon } = {
	Unarmed = Schema.build(UNARMED),
	Jian = Schema.build(JIAN),
	Dao = Schema.build(DAO),
	Guandao = Schema.build(GUANDAO),
}
local BY_ID: { [string]: Weapon } = {}
for _, weapon in WEAPONS do
	assert(BY_ID[weapon.Id] == nil, "Duplicate weapon id " .. weapon.Id)
	BY_ID[weapon.Id] = weapon
end
table.freeze(WEAPONS)
table.freeze(BY_ID)

Schema.Weapons = WEAPONS
Schema.ById = BY_ID

function Schema.get(weaponType: WeaponType): Weapon
	local weapon = WEAPONS[weaponType]
	assert(weapon ~= nil, "Unknown weapon type")
	return weapon
end

function Schema.getById(id: string): Weapon?
	return BY_ID[id]
end

function Schema.findMove(weapon: Weapon, moveId: string): Move?
	return weapon.Moves[moveId]
end

-- Next light in the string; wraps to the opener once the finisher has played.
function Schema.nextLight(weapon: Weapon, current: Move?): Move
	if current == nil or current.Kind ~= "Light" or current.ComboIndex >= #weapon.Light then
		return weapon.Light[1]
	end
	return weapon.Light[current.ComboIndex + 1]
end

function Schema.moveForKind(weapon: Weapon, kind: MoveKind, current: Move?): Move
	if kind == "Light" then
		return Schema.nextLight(weapon, current)
	elseif kind == "Heavy" then
		return weapon.Heavy
	elseif kind == "RunningAttack" then
		return weapon.RunningAttack
	end
	return weapon.WeaponArt
end

function Schema.isTwoHanded(weapon: Weapon): boolean
	return weapon.Grip == "TwoHanded"
end

function Schema.postureDamage(move: Move, attacker: Weapon): number
	return move.PostureDamage * attacker.PostureMultiplier
end

function Schema.bleedBuildup(move: Move, attacker: Weapon): number
	return move.BaseDamage * move.Bleed * attacker.BleedMultiplier * Settings.Bleed.BuildupScale
end

-- Successful deflect: the attacker absorbs reflected posture, the defender pays a small share and no stamina.
function Schema.deflectOutcome(move: Move, attacker: Weapon, defender: Weapon): DeflectOutcome
	local posture = Schema.postureDamage(move, attacker)
	local p = Settings.Posture
	local outcome: DeflectOutcome = {
		AttackerPosture = posture * move.DeflectVulnerability * defender.DeflectEfficiency * p.DeflectReflectScale,
		DefenderPosture = posture * p.DeflectSelfScale / defender.DeflectEfficiency,
		DefenderStamina = Settings.Stamina.Costs.DeflectSuccess,
	}
	return table.freeze(outcome) :: DeflectOutcome
end

-- Held guard: full posture pressure, guard-chip into RecoverableHP and the block stamina cost.
function Schema.blockOutcome(move: Move, attacker: Weapon, defender: Weapon, defenderStamina: number): BlockOutcome
	local p = Settings.Posture
	local scale = if move.Unblockable then p.UnblockableBlockScale else p.BlockScale
	local posture = Schema.postureDamage(move, attacker) * scale / defender.BlockPostureResistance
	local stamina: number = Settings.Stamina.Costs.Block
	local outcome: BlockOutcome = {
		DefenderPosture = posture,
		DefenderChip = if move.Unblockable then move.BaseDamage else move.BaseDamage * attacker.GuardChip,
		DefenderStamina = stamina,
		GuardBreak = move.Unblockable or defenderStamina - stamina <= Settings.Stamina.BreakThreshold,
	}
	return table.freeze(outcome) :: BlockOutcome
end

return table.freeze(Schema)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="32">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="33">
      <Properties>
        <string name="Name">AsurasPath</string>
      </Properties>
      <Item class="Script" referent="34">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Script: ServerScriptService/AsurasPath/Bootstrap
-- Asura's Path master server entry. Brings services up in dependency order:
--   Environment -> LagCompensation -> ProfileStore (Persistence) -> CharacterService -> AIService
--   -> SanctuaryService -> WorldService -> ColosseumService
-- SanctuaryService precedes WorldService: the Sanctuary map folder suppresses greybox and its
-- bonfire anchor receives the starting altar's rest prompt.
-- then owns the player lifecycle: leased profile hydration, durable ranked-result recovery,
-- character admission, death/respawn telemetry and an ordered, deadline-bounded shutdown save.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local Validator = require(Shared.Shared.ConfigValidator) :: any
local Protocol = require(Shared.Shared.IntentProtocol)
local ShopCatalog = require(Shared.ShopCatalog) :: any
local Services = script.Parent:WaitForChild("Services")

local READY_ATTRIBUTE: string = Config.Names.ReadyAttribute
Workspace:SetAttribute(READY_ATTRIBUTE, false)
Workspace:SetAttribute("AsuraReady", false)

-- Dependency order. Each require is a hard dependency of the next layer.
local Environment = require(Services:WaitForChild("EnvironmentService") :: ModuleScript)
local Lag = require(Services:WaitForChild("LagCompensation") :: ModuleScript)
local ProfileStore = require(Services:WaitForChild("ProfileStore") :: ModuleScript)
local Persistence = require(Services:WaitForChild("PersistenceService") :: ModuleScript) :: any
local Characters = require(Services:WaitForChild("CharacterService") :: ModuleScript)
local AI = require(Services:WaitForChild("AIService") :: ModuleScript)
local Sanctuary = require(Services:WaitForChild("SanctuaryService") :: ModuleScript)
local WorldService = require(Services:WaitForChild("WorldService") :: ModuleScript)
local Colosseum = require(Services:WaitForChild("ColosseumService") :: ModuleScript)
local Shop = require(Services:WaitForChild("ShopService") :: ModuleScript) :: any

type Bucket = Protocol.Bucket

local SHUTDOWN_BUDGET = 25
local FLUSH_BUDGET = 8
local LOAD_RETRY_DELAY = 2

local connections: { RBXScriptConnection } = {}
local disconnectors: { () -> () } = {}
local shopBudgets: { [number]: Bucket } = {}
local shopBusy: { [number]: boolean } = {}
local loading: { [number]: boolean } = {}
local started: { [string]: boolean } = {}
local shuttingDown = false

local net = Shared:WaitForChild("Net")
local shopRemote = net:WaitForChild("ShopIntent") :: RemoteEvent

local MarketplaceService: any = nil
pcall(function()
	MarketplaceService = game:GetService("MarketplaceService")
	MarketplaceService.ProcessReceipt = Shop.ProcessReceipt
end)

local function trace(problem: any): string
	return debug.traceback(tostring(problem), 2)
end

local function teardown()
	for _, disconnect in disconnectors do
		pcall(disconnect)
	end
	table.clear(disconnectors)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	if started.Colosseum then
		pcall(Colosseum.Destroy)
	end
	if started.World then
		pcall(WorldService.Destroy)
	end
	if started.Sanctuary then
		pcall(Sanctuary.Destroy)
	end
	if started.AI then
		pcall(AI.Destroy)
	end
	if started.Characters then
		pcall(Characters.Destroy)
	end
	table.clear(started)
end

local function syncProfile(player: Player)
	if player.Parent and player:GetAttribute("AsuraClientReady") == true then
		shopRemote:FireClient(player, { action = "ProfileSync", profile = Persistence.PublicProfile(player.UserId) })
	end
end

-------------------------------------------------------------------------------------------------
-- Player lifecycle
-------------------------------------------------------------------------------------------------

-- Hydrates the leased profile (Souls section included), settles ranked results that finished
-- while the player was away, then admits their character to the world.
local function hydrate(player: Player)
	local userId = player.UserId
	if loading[userId] or shuttingDown then
		return
	end
	loading[userId] = true
	local loaded, problem = pcall(Persistence.Load, userId)
	if not loaded then
		loading[userId] = nil
		warn("[Asura] Profile load refused for " .. userId .. ": " .. tostring(problem))
		if player.Parent then
			player:Kick("Your warrior's record could not be safely loaded. Please rejoin shortly.")
		end
		return
	end
	if not player.Parent then
		loading[userId] = nil
		Persistence.Unload(userId)
		return
	end
	local profile = Persistence.Get(userId)
	if not profile or type(profile.souls) ~= "table" then
		loading[userId] = nil
		warn("[Asura] Profile for " .. userId .. " has no Souls record")
		Persistence.Unload(userId)
		player:Kick("Your warrior's record is incomplete. Please rejoin.")
		return
	end
	-- Ranked inbox: a result committed elsewhere is applied exactly once before play resumes.
	local recovered = false
	for _ = 1, 3 do
		recovered = Colosseum.Recover(userId)
		if recovered or not player.Parent then
			break
		end
		task.wait(LOAD_RETRY_DELAY)
	end
	if not recovered then
		warn("[Asura] Ranked recovery deferred for " .. userId .. "; it retries at the next queue entry")
	end
	loading[userId] = nil
	if not player.Parent then
		return
	end
	Characters.RefreshRoster()
	syncProfile(player)
end

local function release(player: Player)
	local userId = player.UserId
	Colosseum.Disconnect(userId)
	WorldService.Flush(userId, FLUSH_BUDGET)
	local ok, problem = Persistence.Unload(userId)
	if not ok and problem then
		warn("[Asura] Release for " .. userId .. ": " .. tostring(problem))
	end
	shopBudgets[userId] = nil
	shopBusy[userId] = nil
	loading[userId] = nil
end

-- Death and respawn: penalties live in WorldService and timing in CharacterService; the
-- bootstrap publishes the lifecycle so clients and analytics see one consistent record.
local function onCombatEvent(event: any, _point: Vector3?)
	if event.Kind ~= "KO" then
		return
	end
	local player = Players:GetPlayerByUserId(event.Target)
	if not player then
		return
	end
	player:SetAttribute("AsuraDowned", true)
	if not Characters.IsInDuel(event.Target) then
		player:SetAttribute("AsuraDeaths", (tonumber(player:GetAttribute("AsuraDeaths")) or 0) + 1)
	end
end

local function onEntityAdded(id: number, kind: Characters.EntityKind)
	if kind ~= "Player" then
		return
	end
	local player = Players:GetPlayerByUserId(id)
	if player then
		player:SetAttribute("AsuraDowned", false)
	end
end

local function watchCharacters(player: Player)
	table.insert(connections, player.CharacterAdded:Connect(function()
		player:SetAttribute("AsuraDowned", false)
	end))
end

-------------------------------------------------------------------------------------------------
-- Account remote (settings, cosmetics, style rolls, receipts)
-------------------------------------------------------------------------------------------------

local function onShop(player: Player, payload: any)
	if not Protocol.Shop(payload) then
		return
	end
	local userId = player.UserId
	if payload.action == "GetProfile" then
		player:SetAttribute("AsuraClientReady", true)
	end
	if not Persistence.Get(userId) then
		shopRemote:FireClient(player, { action = "ShopError", err = "Profile unavailable" })
		return
	end
	local clock = os.clock()
	local budget = shopBudgets[userId]
	if not budget then
		budget = { tokens = Config.Network.ShopBurst, time = clock }
		shopBudgets[userId] = budget
	end
	if shopBusy[userId] or not Protocol.Take(budget, clock, 1, Config.Network.ShopPerSecond, Config.Network.ShopBurst) then
		return
	end
	shopBusy[userId] = true
	local handled, problem = xpcall(function(): boolean
		local action: string = payload.action
		if action == "GetProfile" then
			shopRemote:FireClient(player, { action = "ProfileSync", profile = Persistence.PublicProfile(userId) })
		elseif action == "SaveSettings" then
			local saved, err = Shop.SaveSettings(userId, payload.settings)
			shopRemote:FireClient(player, { action = "SettingsResult", ok = saved, err = err, profile = Persistence.PublicProfile(userId) })
		elseif action == "RollStyle" then
			local ok, err, drop, duplicate = Shop.RollStyle(userId, payload.useToken == true)
			shopRemote:FireClient(player, {
				action = "RollResult",
				ok = ok,
				err = err,
				drop = drop,
				isDuplicate = duplicate,
				profile = Persistence.PublicProfile(userId),
			})
		elseif action == "RollCrate" then
			local ok, err, itemId, duplicate = Shop.RollCrate(userId, payload.crateId)
			shopRemote:FireClient(player, {
				action = "CrateResult",
				ok = ok,
				err = err,
				itemId = itemId,
				isDuplicate = duplicate,
				crateId = payload.crateId,
				profile = Persistence.PublicProfile(userId),
			})
		elseif action == "BuyCosmetic" then
			local ok, err = Shop.BuyCosmetic(userId, payload.itemId)
			shopRemote:FireClient(player, { action = "BuyResult", ok = ok, err = err, profile = Persistence.PublicProfile(userId) })
		elseif action == "EquipCosmetic" then
			local ok, err = Shop.EquipCosmetic(userId, payload.itemId)
			local profile = Persistence.PublicProfile(userId)
			shopRemote:FireClient(player, { action = "EquipResult", ok = ok, err = err, profile = profile })
			if ok and profile and profile.equippedCosmetics then
				Characters.UpdateCosmetics(userId, profile.equippedCosmetics.Trunks, profile.equippedCosmetics.Gloves, profile.equippedCosmetics)
			end
		elseif action == "EquipStyle" then
			local ok, err = false, "Finish your duel and leave the queue before changing style"
			if Colosseum.CanEquip(userId) and Characters.CanSetStyle(userId) then
				ok, err = Shop.EquipStyle(userId, payload.styleName)
				if ok then
					Characters.SetPlayerStyle(userId, payload.styleName)
				end
			end
			shopRemote:FireClient(player, { action = "EquipStyleResult", ok = ok, err = err, profile = Persistence.PublicProfile(userId) })
		elseif action == "BuyBundle" then
			if not Config.Features.PaidPurchases or not Config.Release.PurchasesIntegrationPassed then
				shopRemote:FireClient(player, { action = "BuyBundleResult", ok = false, err = "Purchases are not enabled" })
				return false
			end
			local bundle = ShopCatalog.Bundles[payload.bundleId]
			if bundle and MarketplaceService and not RunService:IsStudio() then
				pcall(function()
					MarketplaceService:PromptProductPurchase(player, bundle.productId)
				end)
			end
		end
		return true
	end, trace)
	shopBusy[userId] = nil
	Characters.RefreshProgression(userId)
	if not handled then
		warn("[Asura] Account operation failed: " .. tostring(problem))
		shopRemote:FireClient(player, { action = "ShopError", err = "Your record is unavailable. Please retry shortly." })
	end
end

-------------------------------------------------------------------------------------------------
-- Shutdown
-------------------------------------------------------------------------------------------------

-- Ordered so nothing is lost: duels settle (ranked journals close), live world state (essence,
-- gourd charges, bloodstains) commits through the serial queues, then every lease is released.
local function shutdown()
	if shuttingDown then
		return
	end
	shuttingDown = true
	Workspace:SetAttribute(READY_ATTRIBUTE, false)
	Workspace:SetAttribute("AsuraReady", false)
	local deadline = os.clock() + SHUTDOWN_BUDGET
	local steps: { { Name: string, Run: () -> () } } = {
		{ Name = "Colosseum", Run = function()
			Colosseum.Close(deadline)
		end },
		{ Name = "World", Run = function()
			WorldService.FlushAll(math.min(FLUSH_BUDGET, math.max(deadline - os.clock(), 1)))
		end },
		{ Name = "Persistence", Run = function()
			Persistence.Close(deadline)
		end },
	}
	for _, item in steps do
		local ok, problem = xpcall(function(): boolean
			item.Run()
			return true
		end, trace)
		if not ok then
			warn("[Asura] Shutdown step " .. item.Name .. " failed: " .. tostring(problem))
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Startup
-------------------------------------------------------------------------------------------------

local ok, problem = xpcall(function(): boolean
	Validator.Validate(Config)
	Environment.Apply()
	assert(type(Lag.MAX_REWIND) == "number" and Lag.MAX_REWIND > 0, "LagCompensation rewind budget missing")
	assert(getmetatable(Persistence.Engine) == ProfileStore, "Persistence must run on the ProfileStore engine")

	Persistence.Start()
	Characters.Start()
	started.Characters = true
	AI.Start()
	started.AI = true
	Sanctuary.Start()
	started.Sanctuary = true
	WorldService.Start()
	started.World = true
	Colosseum.Start()
	started.Colosseum = true

	table.insert(disconnectors, Characters.Subscribe(onCombatEvent))
	table.insert(disconnectors, Characters.OnEntityAdded(onEntityAdded))
	table.insert(connections, Players.PlayerAdded:Connect(function(player: Player)
		watchCharacters(player)
		hydrate(player)
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(release))
	table.insert(connections, shopRemote.OnServerEvent:Connect(onShop))
	game:BindToClose(shutdown)
	for _, player in Players:GetPlayers() do
		watchCharacters(player)
		task.spawn(hydrate, player)
	end

	Workspace:SetAttribute(READY_ATTRIBUTE, true)
	Workspace:SetAttribute("AsuraReady", true)
	local rings = Colosseum.GetRings()
	print(string.format(
		"[Asura's Path] Server ready: 60 Hz authority, %.0f ms rewind budget, %d Colosseum rings; ranked league %s.",
		Lag.MAX_REWIND * 1000,
		#rings,
		if not Colosseum.RankedOpen() then "sealed (release gate)"
			elseif RunService:IsStudio() and not (Config.Features.Matchmaking and Config.Release.RankedIntegrationPassed) then "open (development)"
			else "open"
	))
	return true
end, trace)

if not ok then
	Workspace:SetAttribute(READY_ATTRIBUTE, false)
	Workspace:SetAttribute("AsuraReady", false)
	teardown()
	error("[Asura's Path] Server startup failed.\n" .. tostring(problem), 0)
end

script.Destroying:Connect(teardown)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">AIService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/AIService
-- PvE combat coordinator. Every agent drives the same CombatRules fighter as a player does, through
-- CharacterService intents; nothing here applies damage directly except authored boss shockwaves,
-- which are telegraphed and routed through CombatRules.applyArea.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local World = require(Shared.Shared.WorldDefinitions)
local Settings = require(Shared.Shared.CombatSettings) :: any
local Weapons = require(Shared.Simulation.WeaponSchema) :: any
local Tempo = require(Shared.Simulation.Tempo) :: any
local Schema = require(Shared.Simulation.MoveSchema) :: any
local Combat = require(Shared.Simulation.CombatRules)
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)

type Entity = Characters.Entity
type MobDef = World.MobDef
type BossDef = World.BossDef
type AIProfile = World.AIProfile
type Shockwave = World.Shockwave

export type Mode = "Idle" | "Patrol" | "Alert" | "Engage" | "Combat" | "StanceBroken" | "Return" | "Cinematic" | "Dead"
export type TelegraphClass = "Light" | "Heavy" | "Perilous"
export type AgentInfo = { Kind: "Mob" | "Boss", Definition: string, SpawnId: string?, Region: string, Essence: number }

type PendingAttack = { Action: "Light" | "Heavy" | "WeaponArt", At: number }
type PendingShockwave = { At: number, Wave: Shockwave, Cancelable: boolean }

type Agent = {
	Id: number,
	Kind: "Mob" | "Boss",
	Definition: string,
	SpawnId: string?,
	Region: string,
	Essence: number,
	Home: CFrame,
	Patrol: { Vector3 },
	PatrolIndex: number,
	Profile: AIProfile,
	Rng: Random,
	Mode: Mode,
	ModeSince: number,
	Target: number,
	LastSeen: number,
	LastKnown: Vector3?,
	Suspicion: number,
	NextThink: number,
	PlannedFor: number,
	DeflectAt: number,
	GuardUntil: number,
	RecomposeUntil: number,
	Pending: PendingAttack?,
	StrafeSign: number,
	StrafeUntil: number,
	-- Boss only
	Boss: BossDef?,
	Phase: number,
	Deathblows: number,
	Allowed: { [number]: boolean }?,
	Shockwave: PendingShockwave?,
	TransitionEnd: number,
	NextSpecial: number,
}

type Noise = { Position: Vector3, Time: number }

local AIService = {}

local PLAYER_REACTION = 0.25
local PERILOUS_LEAD = 0.45
local NOISE_LIFETIME = 1.5
local LOS_HEIGHT = Vector3.new(0, 1.5, 0)
local CLOSE_DETECT = 6

local agents: { [number]: Agent } = {}
local spawnAgents: { [string]: number } = {}
local bossAgents: { [string]: number } = {}
local noises: { Noise } = {}
local bossListeners: { (bossId: string, entityId: number) -> () } = {}
local disconnectors: { () -> () } = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local ignoreDirty = true
local running = false

-------------------------------------------------------------------------------------------------
-- Telegraphing (pure): schedules attacks so a warning always precedes impact by a fair margin.
-------------------------------------------------------------------------------------------------

local Telegraph = {}

function Telegraph.classify(move: Combat.MoveData): TelegraphClass
	if move.Unblockable then
		return "Perilous"
	elseif move.Kind == "Heavy" or move.Kind == "WeaponArt" or move.Kind == "RunningAttack" then
		return "Heavy"
	end
	return "Light"
end

function Telegraph.lead(class: TelegraphClass, reactionFloor: number): number
	if class == "Perilous" then
		return math.max(PERILOUS_LEAD, reactionFloor)
	elseif class == "Heavy" then
		return math.max(Tempo.HeavyMinSeconds, reactionFloor)
	end
	return Tempo.LightMinSeconds
end

-- Returns (attackAt, warnAt, impactAt). The warning is published at `now`; if the move's own startup
-- is shorter than the required lead the attack itself is delayed so impact - warn >= lead.
function Telegraph.plan(move: Combat.MoveData, now: number, reactionFloor: number): (number, number, number)
	local class = Telegraph.classify(move)
	local lead = Telegraph.lead(class, reactionFloor)
	local startup = move.Timing.StartupSeconds
	local attackAt = Tempo.quantizeUp(now + math.max(0, lead - startup))
	return attackAt, now, attackAt + startup
end

function Telegraph.shockwave(wave: Shockwave, now: number): (number, number)
	return now, Tempo.quantizeUp(now + math.max(wave.Windup, PERILOUS_LEAD))
end

AIService.Telegraph = table.freeze(Telegraph)

-------------------------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------------------------

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatUnit(v: Vector3): Vector3
	local f = flat(v)
	local m = f.Magnitude
	return if m > 1e-5 then f / m else Vector3.zero
end

local function toCFrame(p: World.Placement): CFrame
	return CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, math.rad(p.Yaw), 0)
end

local function setMode(agent: Agent, mode: Mode, now: number)
	if agent.Mode == mode then
		return
	end
	agent.Mode = mode
	agent.ModeSince = now
	local e = Characters.GetEntity(agent.Id)
	if e then
		e.Model:SetAttribute("AsuraAIMode", mode)
	end
end

local function rebuildIgnore()
	local list: { Instance } = {}
	for _, e in Characters.Entities() do
		table.insert(list, e.Model)
	end
	rayParams.FilterDescendantsInstances = list
	ignoreDirty = false
end

local function lineOfSight(from: Vector3, to: Vector3): boolean
	if ignoreDirty then
		rebuildIgnore()
	end
	local direction = to - from
	return Workspace:Raycast(from, direction, rayParams) == nil
end

local function isTargetable(agent: Agent, e: Entity): boolean
	if e.Kind ~= "Player" or e.Fighter.State == "KO" or e.Respawning or e.Duel ~= nil then
		return false
	end
	local allowed = agent.Allowed
	return allowed == nil or allowed[e.Id] == true
end

local function noisy(e: Entity): boolean
	local state = e.Fighter.State
	return e.Fighter.Sprinting or state == "Startup" or state == "Active" or state == "Dashing"
end

local function reachOf(agent: Agent, f: Combat.Fighter): number
	local weapon = Weapons.get(f.Weapon)
	return weapon.Light[1].Reach + f.ReachBonus
end

-------------------------------------------------------------------------------------------------
-- Perception
-------------------------------------------------------------------------------------------------

-- Returns the best visible target and whether any target was only heard.
local function perceive(agent: Agent, self: Entity, now: number): (Entity?, Vector3?)
	local profile = agent.Profile
	local origin = self.Root.Position
	local look = flatUnit(self.Root.CFrame.LookVector)
	local cosHalf = math.cos(math.rad(profile.FieldOfView) * 0.5)
	local best: Entity? = nil
	local bestDistance = math.huge
	local heard: Vector3? = nil
	for _, e in Characters.Entities() do
		if isTargetable(agent, e) and e.Model.Parent then
			local offset = e.Root.Position - origin
			local distance = offset.Magnitude
			if distance <= profile.SightRange then
				local inCone = profile.FieldOfView >= 360 or distance <= CLOSE_DETECT or look:Dot(flatUnit(offset)) >= cosHalf
				if inCone and distance < bestDistance and lineOfSight(origin + LOS_HEIGHT, e.Root.Position + LOS_HEIGHT) then
					best, bestDistance = e, distance
				end
			end
			if heard == nil and distance <= profile.HearingRange and noisy(e) then
				heard = e.Root.Position
			end
		end
	end
	if heard == nil then
		for _, noise in noises do
			if now - noise.Time <= NOISE_LIFETIME and (noise.Position - origin).Magnitude <= profile.HearingRange then
				heard = noise.Position
				break
			end
		end
	end
	return best, heard
end

-------------------------------------------------------------------------------------------------
-- Combat behaviour
-------------------------------------------------------------------------------------------------

local function publishTelegraph(agent: Agent, move: Combat.MoveData, class: TelegraphClass, impactAt: number)
	local e = Characters.GetEntity(agent.Id)
	if e then
		e.Model:SetAttribute("AsuraTelegraph", string.format("%s|%s|%.3f", class, move.Id, impactAt))
	end
	if class ~= "Light" then
		Characters.Cue("Telegraph", agent.Id, { class = class, move = move.Id, impact = impactAt })
	end
end

local function queueAttack(agent: Agent, f: Combat.Fighter, action: "Light" | "Heavy" | "WeaponArt", now: number)
	local move = Combat.selectMove(f, action, now)
	local attackAt, _, impactAt = Telegraph.plan(move, now, PLAYER_REACTION)
	publishTelegraph(agent, move, Telegraph.classify(move), impactAt)
	if attackAt <= now + 1e-6 then
		Characters.PushIntent(agent.Id, action)
	else
		agent.Pending = { Action = action, At = attackAt }
	end
end

local function react(agent: Agent, self: Entity, target: Entity, now: number)
	local f = self.Fighter
	local tf = target.Fighter
	local profile = agent.Profile
	if now >= agent.DeflectAt then
		agent.DeflectAt = math.huge
		Characters.PushIntent(agent.Id, "Deflect")
	end
	if f.GuardHeld and now >= agent.GuardUntil then
		Characters.SetGuard(agent.Id, false)
	end
	local move = tf.Move
	if tf.State ~= "Startup" or move == nil or tf.MoveStart == agent.PlannedFor then
		return
	end
	local distance = (target.Root.Position - self.Root.Position).Magnitude
	if distance > move.Reach + tf.ReachBonus + 4 then
		return
	end
	agent.PlannedFor = tf.MoveStart
	local impact = tf.MoveStart + move.Timing.StartupSeconds
	local press = impact - f.DeflectWindow * 0.5 + agent.Rng:NextNumber(-profile.TimingJitter, profile.TimingJitter)
	local readable = press >= tf.MoveStart + profile.ReactionTime
	if move.Unblockable then
		-- Perilous: deflect only (guarding is useless); otherwise evade backwards.
		if readable and agent.Rng:NextNumber() < profile.DeflectChance then
			agent.DeflectAt = math.max(press, now)
		elseif f.Stamina > Settings.Stamina.Costs.Dash then
			local away = flatUnit(self.Root.Position - target.Root.Position)
			Characters.PushIntent(agent.Id, "Dash", nil, away.X, away.Z)
		end
		return
	end
	if readable and agent.Rng:NextNumber() < profile.DeflectChance then
		agent.DeflectAt = math.max(press, now)
	elseif agent.Rng:NextNumber() < profile.GuardChance then
		agent.GuardUntil = impact + move.Timing.ActiveSeconds + 0.1
		Characters.SetGuard(agent.Id, true)
	end
end

local function strafePoint(agent: Agent, self: Entity, target: Entity, spacing: number, now: number): Vector3
	if now >= agent.StrafeUntil then
		agent.StrafeSign = if agent.Rng:NextNumber() < 0.5 then -1 else 1
		agent.StrafeUntil = now + agent.Rng:NextNumber(1.2, 2.6)
	end
	local away = flatUnit(self.Root.Position - target.Root.Position)
	if away.Magnitude == 0 then
		away = Vector3.new(0, 0, 1)
	end
	local perpendicular = Vector3.new(-away.Z, 0, away.X) * agent.StrafeSign
	return target.Root.Position + away * spacing + perpendicular * 3
end

local function decide(agent: Agent, self: Entity, target: Entity, now: number)
	local f = self.Fighter
	local tf = target.Fighter
	local profile = agent.Profile
	local distance = (target.Root.Position - self.Root.Position).Magnitude
	local reach = reachOf(agent, f)

	Characters.Face(agent.Id, target.Root.Position)

	if tf.State == "StanceBroken" and distance <= Settings.Deathblow.Range then
		Characters.PushIntent(agent.Id, "Heavy")
		return
	end

	-- Posture management: back off and let the bar drain before it breaks.
	local postureRatio = f.Posture / math.max(Combat.maxPosture(f), 1)
	if postureRatio >= profile.PostureGuard and now >= agent.RecomposeUntil then
		agent.RecomposeUntil = now + agent.Rng:NextNumber(1.2, 2.0)
		if f.Stamina > Settings.Stamina.Costs.Dash then
			local away = flatUnit(self.Root.Position - target.Root.Position)
			Characters.PushIntent(agent.Id, "Dash", nil, away.X, away.Z)
		end
	end
	if now < agent.RecomposeUntil then
		Characters.MoveTo(agent.Id, strafePoint(agent, self, target, reach * 1.8, now))
		return
	end

	if distance > reach * 0.95 then
		Characters.MoveTo(agent.Id, target.Root.Position)
		return
	end

	if f.Stamina < profile.RetreatStamina and agent.Rng:NextNumber() < 0.3 then
		local away = flatUnit(self.Root.Position - target.Root.Position)
		Characters.PushIntent(agent.Id, "Dash", nil, away.X, away.Z)
		return
	end
	if f.GuardHeld or agent.DeflectAt < math.huge or agent.Pending ~= nil then
		Characters.StopMoving(agent.Id)
		return
	end

	local comboOpen = Combat.comboWindowOpen(f, now)
	if f.State ~= "Idle" and not comboOpen then
		return
	end
	if comboOpen then
		if agent.Rng:NextNumber() <= profile.ComboContinueChance then
			queueAttack(agent, f, "Light", now)
		end
		return
	end
	if agent.Rng:NextNumber() < profile.StrafeChance * (1 - profile.Aggression) then
		Characters.MoveTo(agent.Id, strafePoint(agent, self, target, reach * 0.8, now))
		return
	end
	Characters.StopMoving(agent.Id)
	if agent.Rng:NextNumber() > profile.Aggression then
		return
	end
	local weapon = Weapons.get(f.Weapon)
	local roll = agent.Rng:NextNumber()
	if roll < profile.ArtChance and f.Qi >= weapon.WeaponArt.QiCost then
		queueAttack(agent, f, "WeaponArt", now)
	elseif roll < profile.ArtChance + profile.HeavyChance then
		queueAttack(agent, f, "Heavy", now)
	else
		queueAttack(agent, f, "Light", now)
	end
end

-------------------------------------------------------------------------------------------------
-- Boss multi-phase manager
-------------------------------------------------------------------------------------------------

local function scheduleShockwave(agent: Agent, wave: Shockwave, now: number, cancelable: boolean)
	local _, impactAt = Telegraph.shockwave(wave, now)
	agent.Shockwave = { At = impactAt, Wave = wave, Cancelable = cancelable }
	Characters.Cue("Telegraph", agent.Id, { class = "Perilous", move = "Shockwave", impact = impactAt, radius = wave.Radius })
	local e = Characters.GetEntity(agent.Id)
	if e then
		e.Model:SetAttribute("AsuraTelegraph", string.format("Perilous|Shockwave|%.3f", impactAt))
	end
end

local function releaseShockwave(agent: Agent, self: Entity)
	local pending = agent.Shockwave
	agent.Shockwave = nil
	if not pending then
		return
	end
	local wave = pending.Wave
	local origin = self.Root.Position
	Characters.Cue("Shockwave", agent.Id, { radius = wave.Radius, x = origin.X, y = origin.Y, z = origin.Z })
	for _, e in Characters.Entities() do
		if e.Kind == "Player" and e.Model.Parent and (e.Root.Position - origin).Magnitude <= wave.Radius then
			Characters.ApplyArea(agent.Id, e.Id, wave.Damage, wave.Posture, wave.Unblockable)
		end
	end
end

local function applyPhase(agent: Agent, boss: BossDef, index: number, self: Entity)
	local phase = boss.Phases[index]
	agent.Phase = index
	agent.Profile = phase.AI
	agent.Deathblows = 0
	Characters.ForceWeapon(agent.Id, phase.Weapon)
	Characters.ApplyStats(agent.Id, phase.Stats, false)
	local f = self.Fighter
	f.Posture = 0
	f.KOProtected = index < #boss.Phases
	if phase.Transition then
		Characters.Tint(agent.Id, phase.Transition.BodyColor)
	end
	self.Model:SetAttribute("AsuraBossPhase", index)
	self.Model:SetAttribute("AsuraBossPhaseName", phase.Name)
end

local function beginTransition(agent: Agent, boss: BossDef, index: number, self: Entity, now: number)
	local phase = boss.Phases[index]
	local transition = phase.Transition
	agent.Pending = nil
	agent.DeflectAt = math.huge
	if not transition then
		applyPhase(agent, boss, index, self)
		return
	end
	setMode(agent, "Cinematic", now)
	Characters.Cinematic(agent.Id, transition.Duration)
	Characters.Cue("BossPhase", agent.Id, { boss = boss.Id, phase = index, name = phase.Name, duration = transition.Duration })
	scheduleShockwave(agent, transition.Shockwave, now, false)
	agent.TransitionEnd = now + transition.Duration
	agent.Phase = index
end

local function finishTransition(agent: Agent, boss: BossDef, self: Entity, now: number)
	applyPhase(agent, boss, agent.Phase, self)
	agent.TransitionEnd = math.huge
	local special = boss.Phases[agent.Phase].Special
	agent.NextSpecial = if special then now + agent.Rng:NextNumber(special.IntervalMin, special.IntervalMax) else math.huge
	setMode(agent, "Combat", now)
end

local function updateBoss(agent: Agent, boss: BossDef, self: Entity, now: number): boolean
	local f = self.Fighter
	if agent.TransitionEnd < math.huge then
		if agent.Shockwave and now >= agent.Shockwave.At then
			releaseShockwave(agent, self)
		end
		if now >= agent.TransitionEnd then
			finishTransition(agent, boss, self, now)
		end
		return true
	end
	if f.State ~= "DeathblowVictim" and f.State ~= "KO" then
		local fraction = f.ActiveHP / math.max(f.MaxHP, 1)
		local nextPhase = World.phaseFor(boss, agent.Phase, fraction, agent.Deathblows)
		if nextPhase > agent.Phase then
			beginTransition(agent, boss, nextPhase, self, now)
			return true
		end
	end
	local pending = agent.Shockwave
	if pending then
		if pending.Cancelable and (Schema.isStunned(f.State) or f.State == "KO") then
			agent.Shockwave = nil
		elseif now >= pending.At then
			releaseShockwave(agent, self)
		end
		return pending ~= nil and agent.Shockwave ~= nil
	end
	local special = boss.Phases[agent.Phase].Special
	if special and now >= agent.NextSpecial and f.State == "Idle" and agent.Mode == "Combat" then
		agent.NextSpecial = now + agent.Rng:NextNumber(special.IntervalMin, special.IntervalMax)
		Characters.StopMoving(agent.Id)
		scheduleShockwave(agent, special.Shockwave, now, true)
		return true
	end
	return false
end

-------------------------------------------------------------------------------------------------
-- Agent loop
-------------------------------------------------------------------------------------------------

local function update(agent: Agent, now: number)
	local self = Characters.GetEntity(agent.Id)
	if not self then
		return
	end
	local f = self.Fighter
	if f.State == "KO" then
		setMode(agent, "Dead", now)
		return
	end

	local boss = agent.Boss
	if boss and updateBoss(agent, boss, self, now) then
		return
	end

	if f.State == "StanceBroken" or f.State == "DeathblowVictim" then
		if agent.Mode ~= "StanceBroken" then
			agent.Pending = nil
			agent.DeflectAt = math.huge
			setMode(agent, "StanceBroken", now)
		end
		return
	elseif agent.Mode == "StanceBroken" then
		setMode(agent, "Combat", now)
	end

	local pending = agent.Pending
	if pending and now >= pending.At then
		agent.Pending = nil
		Characters.PushIntent(agent.Id, pending.Action)
	end

	local target = if agent.Target ~= 0 then Characters.GetEntity(agent.Target) else nil
	if target and not isTargetable(agent, target) then
		target = nil
		agent.Target = 0
	end
	if target and (agent.Mode == "Combat" or agent.Mode == "Engage") then
		react(agent, self, target, now)
	end

	if now < agent.NextThink then
		return
	end
	local profile = agent.Profile
	agent.NextThink = now + 1 / profile.ThinkRate

	local homeDistance = (self.Root.Position - agent.Home.Position).Magnitude
	if agent.Mode ~= "Return" and homeDistance > profile.LeashRange then
		agent.Target = 0
		Characters.SetGuard(agent.Id, false)
		Characters.SetSprint(agent.Id, false)
		setMode(agent, "Return", now)
	end

	if agent.Mode == "Return" then
		Characters.MoveTo(agent.Id, agent.Home.Position)
		if homeDistance <= 4 then
			Characters.RestoreFighter(agent.Id)
			setMode(agent, if #agent.Patrol > 0 then "Patrol" else "Idle", now)
		end
		return
	end

	local seen, heard = perceive(agent, self, now)
	if seen then
		agent.LastSeen = now
		agent.LastKnown = seen.Root.Position
	end

	if agent.Mode == "Idle" or agent.Mode == "Patrol" then
		if seen then
			agent.Target = seen.Id
			local close = (seen.Root.Position - self.Root.Position).Magnitude <= CLOSE_DETECT
			agent.Suspicion = if close then 1 else 0
			setMode(agent, if close then "Engage" else "Alert", now)
		elseif heard then
			agent.LastKnown = heard
			agent.Suspicion = 0
			setMode(agent, "Alert", now)
		elseif agent.Mode == "Idle" and #agent.Patrol > 0 and now - agent.ModeSince > agent.Rng:NextNumber(1, 3) then
			setMode(agent, "Patrol", now)
		elseif agent.Mode == "Patrol" then
			local point = agent.Patrol[agent.PatrolIndex]
			if (flat(self.Root.Position - point)).Magnitude <= 2.5 then
				agent.PatrolIndex = agent.PatrolIndex % #agent.Patrol + 1
				setMode(agent, "Idle", now)
				Characters.StopMoving(agent.Id)
			else
				Characters.MoveTo(agent.Id, point)
			end
		end
		return
	end

	if agent.Mode == "Alert" then
		local known = agent.LastKnown
		if known then
			Characters.Face(agent.Id, known)
		end
		if seen then
			agent.Target = seen.Id
			agent.Suspicion += (1 / profile.ThinkRate) / math.max(profile.AlertTime, 0.05)
			if agent.Suspicion >= 1 then
				setMode(agent, "Engage", now)
			end
		elseif known then
			agent.Suspicion += (0.5 / profile.ThinkRate) / math.max(profile.AlertTime, 0.05)
			Characters.MoveTo(agent.Id, known)
		end
		if not seen and now - math.max(agent.LastSeen, agent.ModeSince) > profile.SearchTime then
			setMode(agent, "Return", now)
		end
		return
	end

	if not target then
		target = seen
		agent.Target = if seen then seen.Id else 0
	end
	if not target then
		if now - agent.LastSeen > profile.SearchTime then
			Characters.SetSprint(agent.Id, false)
			setMode(agent, "Return", now)
		elseif agent.LastKnown then
			Characters.MoveTo(agent.Id, agent.LastKnown :: Vector3)
		end
		return
	end

	local distance = (target.Root.Position - self.Root.Position).Magnitude
	local reach = reachOf(agent, f)
	if agent.Mode == "Engage" then
		Characters.Face(agent.Id, target.Root.Position)
		Characters.MoveTo(agent.Id, target.Root.Position)
		Characters.SetSprint(agent.Id, distance > reach * 3 and f.Stamina > profile.RetreatStamina * 2)
		if distance <= reach * 1.1 then
			Characters.SetSprint(agent.Id, false)
			setMode(agent, "Combat", now)
		end
		return
	end

	if agent.Mode == "Combat" then
		if distance > reach * 1.8 then
			setMode(agent, "Engage", now)
			return
		end
		decide(agent, self, target, now)
	end
end

local function newAgent(entityId: number, kind: "Mob" | "Boss", definition: string, profile: AIProfile, region: string, essence: number, home: CFrame, patrol: { Vector3 }): Agent
	local agent: Agent = {
		Id = entityId,
		Kind = kind,
		Definition = definition,
		SpawnId = nil,
		Region = region,
		Essence = essence,
		Home = home,
		Patrol = patrol,
		PatrolIndex = 1,
		Profile = profile,
		Rng = Random.new(math.abs(entityId) * 7919 + os.time()),
		Mode = if #patrol > 0 then "Patrol" else "Idle",
		ModeSince = Characters.Now(),
		Target = 0,
		LastSeen = -math.huge,
		LastKnown = nil,
		Suspicion = 0,
		NextThink = Characters.Now(),
		PlannedFor = -math.huge,
		DeflectAt = math.huge,
		GuardUntil = -math.huge,
		RecomposeUntil = -math.huge,
		Pending = nil,
		StrafeSign = 1,
		StrafeUntil = -math.huge,
		Boss = nil,
		Phase = 1,
		Deathblows = 0,
		Allowed = nil,
		Shockwave = nil,
		TransitionEnd = math.huge,
		NextSpecial = math.huge,
	}
	agents[entityId] = agent
	return agent
end

-------------------------------------------------------------------------------------------------
-- Spawning
-------------------------------------------------------------------------------------------------

function AIService.SpawnMob(spawnId: string): number?
	local existing = spawnAgents[spawnId]
	if existing and agents[existing] and Characters.GetEntity(existing) then
		return existing
	end
	local entry = World.spawnById(spawnId)
	if not entry then
		warn("[AIService] Unknown spawn " .. spawnId)
		return nil
	end
	local mob = World.Mobs[entry.Mob]
	local home = toCFrame(entry.Placement)
	local id = Characters.SpawnEnemy({
		Name = mob.Name,
		Weapon = mob.Weapon,
		CFrame = home,
		Stats = mob.Stats,
		Definition = mob.Id,
		BodyColor = mob.BodyColor,
	})
	if not id then
		return nil
	end
	local patrol: { Vector3 } = {}
	for _, point in entry.Patrol do
		table.insert(patrol, Vector3.new(point.X, point.Y, point.Z))
	end
	local agent = newAgent(id, "Mob", mob.Id, mob.AI, entry.Region, mob.Essence, home, patrol)
	agent.SpawnId = spawnId
	spawnAgents[spawnId] = id
	return id
end

function AIService.ResetMob(spawnId: string): boolean
	local id = spawnAgents[spawnId]
	local agent = if id then agents[id] else nil
	if not id or not agent or not Characters.GetEntity(id) then
		return false
	end
	Characters.SetGuard(id, false)
	Characters.Teleport(id, agent.Home)
	Characters.RestoreFighter(id)
	agent.Target = 0
	agent.Pending = nil
	agent.DeflectAt = math.huge
	agent.PatrolIndex = 1
	setMode(agent, if #agent.Patrol > 0 then "Patrol" else "Idle", Characters.Now())
	return true
end

-- Respawns every non-boss mob in a region. Engaged mobs can be left alone so another player's
-- fight is not reset underneath them.
function AIService.RespawnRegion(region: string, skipEngaged: boolean)
	for _, entry in World.Spawns do
		if entry.Region == region then
			local id = spawnAgents[entry.Id]
			local agent = if id then agents[id] else nil
			local entity = if id then Characters.GetEntity(id) else nil
			if agent and entity and entity.Fighter.State ~= "KO" then
				local engaged = agent.Mode == "Engage" or agent.Mode == "Combat" or agent.Mode == "StanceBroken"
				if not (skipEngaged and engaged) then
					AIService.ResetMob(entry.Id)
				end
			else
				if id and entity then
					Characters.DespawnEnemy(id)
				end
				spawnAgents[entry.Id] = nil
				AIService.SpawnMob(entry.Id)
			end
		end
	end
end

function AIService.SpawnBoss(bossId: string, participants: { number }?): number?
	local existing = bossAgents[bossId]
	if existing then
		local current = Characters.GetEntity(existing)
		if current and current.Fighter.State ~= "KO" then
			return existing
		end
		-- A lingering corpse from the previous encounter is cleared before the next one starts.
		bossAgents[bossId] = nil
		agents[existing] = nil
		Characters.DespawnEnemy(existing)
	end
	local boss = World.Bosses[bossId]
	if not boss then
		warn("[AIService] Unknown boss " .. bossId)
		return nil
	end
	local opening = boss.Phases[1]
	local home = toCFrame(boss.Spawn)
	local id = Characters.SpawnEnemy({
		Name = boss.Name,
		Weapon = opening.Weapon,
		CFrame = home,
		Stats = opening.Stats,
		Definition = boss.Id,
		BodyColor = boss.BodyColor,
		Boss = true,
	})
	if not id then
		return nil
	end
	local agent = newAgent(id, "Boss", boss.Id, opening.AI, boss.Region, boss.Essence, home, {})
	agent.Boss = boss
	agent.Mode = "Engage"
	if participants then
		AIService.SetBossTargets(bossId, participants)
	end
	local entity = Characters.GetEntity(id)
	if entity then
		applyPhase(agent, boss, 1, entity)
		entity.Model:SetAttribute("AsuraBossTitle", boss.Title)
	end
	bossAgents[bossId] = id
	Characters.Cue("BossIntro", id, { boss = boss.Id, title = boss.Title, phase = 1, name = opening.Name })
	return id
end

function AIService.SetBossTargets(bossId: string, participants: { number })
	local id = bossAgents[bossId]
	local agent = if id then agents[id] else nil
	if not agent then
		return
	end
	local allowed: { [number]: boolean } = {}
	for _, participant in participants do
		allowed[participant] = true
	end
	agent.Allowed = allowed
	if agent.Target ~= 0 and not allowed[agent.Target] then
		agent.Target = 0
	end
end

function AIService.DespawnBoss(bossId: string)
	local id = bossAgents[bossId]
	bossAgents[bossId] = nil
	if id then
		agents[id] = nil
		Characters.DespawnEnemy(id)
	end
end

function AIService.GetBossEntity(bossId: string): number?
	local id = bossAgents[bossId]
	if id and Characters.GetEntity(id) then
		return id
	end
	return nil
end

function AIService.GetAgent(entityId: number): AgentInfo?
	local agent = agents[entityId]
	if not agent then
		return nil
	end
	return { Kind = agent.Kind, Definition = agent.Definition, SpawnId = agent.SpawnId, Region = agent.Region, Essence = agent.Essence }
end

function AIService.GetMode(entityId: number): Mode?
	local agent = agents[entityId]
	return if agent then agent.Mode else nil
end

-- True while any agent is actively fighting or chasing this player (blocks resting at an altar).
function AIService.IsHunting(playerId: number): boolean
	for _, agent in agents do
		if agent.Target == playerId and (agent.Mode == "Engage" or agent.Mode == "Combat" or agent.Mode == "Cinematic") then
			return true
		end
	end
	return false
end

function AIService.OnBossDefeated(listener: (bossId: string, entityId: number) -> ()): () -> ()
	table.insert(bossListeners, listener)
	return function()
		local index = table.find(bossListeners, listener)
		if index then
			table.remove(bossListeners, index)
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

local function onEvent(event: Combat.Event, point: Vector3?)
	if point and (event.Kind == "Hit" or event.Kind == "DeflectSpark" or event.Kind == "Block" or event.Kind == "CounterHit" or event.Kind == "GuardBreak") then
		table.insert(noises, { Position = point, Time = Characters.Now() })
		if #noises > 32 then
			table.remove(noises, 1)
		end
	end
	local victim = agents[event.Target]
	if not victim then
		return
	end
	if event.Kind == "Deathblow" and victim.Boss then
		victim.Deathblows += 1
	elseif (event.Kind == "Hit" or event.Kind == "CounterHit") and victim.Mode ~= "Combat" and victim.Mode ~= "Cinematic" then
		local source = Characters.GetEntity(event.Source)
		if source and isTargetable(victim, source) then
			victim.Target = source.Id
			victim.LastSeen = Characters.Now()
			victim.LastKnown = source.Root.Position
			setMode(victim, "Engage", Characters.Now())
		end
	elseif event.Kind == "KO" then
		setMode(victim, "Dead", Characters.Now())
		local boss = victim.Boss
		if boss then
			for _, listener in table.clone(bossListeners) do
				local ok, problem = pcall(listener, boss.Id, victim.Id)
				if not ok then
					warn("[AIService] Boss listener failed: " .. tostring(problem))
				end
			end
		end
	end
end

local function onRemoved(id: number, _kind: Characters.EntityKind)
	ignoreDirty = true
	local agent = agents[id]
	if not agent then
		return
	end
	agents[id] = nil
	if agent.SpawnId and spawnAgents[agent.SpawnId] == id then
		spawnAgents[agent.SpawnId] = nil
	end
	local boss = agent.Boss
	if boss and bossAgents[boss.Id] == id then
		bossAgents[boss.Id] = nil
	end
end

local function onAdded(id: number, kind: Characters.EntityKind)
	ignoreDirty = true
	if kind ~= "Enemy" or agents[id] then
		return
	end
	-- Hand-placed tagged models carry a Definition attribute naming a mob archetype.
	task.defer(function()
		if agents[id] then
			return
		end
		local e = Characters.GetEntity(id)
		if not e then
			return
		end
		local definition = e.Definition
		local mob = if definition then World.Mobs[definition] else nil
		if not mob then
			return
		end
		Characters.ApplyStats(id, mob.Stats, true)
		local position = e.Root.Position
		local region = World.regionAt(position.X, position.Y, position.Z) or "DesecratedMonastery"
		newAgent(id, "Mob", mob.Id, mob.AI, region, mob.Essence, e.Root.CFrame, {})
	end)
end

function AIService.Start()
	assert(not running, "AIService already started")
	running = true
	table.insert(disconnectors, Characters.OnStep(function(now: number, _dt: number)
		for i = #noises, 1, -1 do
			if now - noises[i].Time > NOISE_LIFETIME then
				table.remove(noises, i)
			end
		end
		for _, agent in agents do
			update(agent, now)
		end
	end))
	table.insert(disconnectors, Characters.Subscribe(onEvent))
	table.insert(disconnectors, Characters.OnEntityRemoved(onRemoved))
	table.insert(disconnectors, Characters.OnEntityAdded(onAdded))
end

function AIService.Destroy()
	running = false
	for _, disconnect in disconnectors do
		disconnect()
	end
	table.clear(disconnectors)
	for id in agents do
		Characters.DespawnEnemy(id)
	end
	table.clear(agents)
	table.clear(spawnAgents)
	table.clear(bossAgents)
	table.clear(noises)
end

return AIService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/CharacterService
-- Authoritative entity coordinator for player characters and PvE humanoids. Runs CombatRules on a
-- fixed 60 Hz clock, resolves weapon contact through LagCompensation and replicates each fighter as
-- a packed base64 attribute plus a batched event stream. Behaviour (AI) and world rules (altars,
-- bloodstains, progression) attach through step listeners, event subscriptions and hooks.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local Settings = require(Shared.Shared.CombatSettings) :: any
local Schema = require(Shared.Simulation.MoveSchema) :: any
local Weapons = require(Shared.Simulation.WeaponSchema) :: any
local Combat = require(Shared.Simulation.CombatRules)
local InputBuffer = require(Shared.Simulation.InputBuffer)
local Tempo = require(Shared.Simulation.Tempo) :: any
local Protocol = require(Shared.Shared.IntentProtocol)
local Lag = require(script.Parent:WaitForChild("LagCompensation") :: ModuleScript)

local Persistence: any = nil
pcall(function()
	Persistence = require(script.Parent:WaitForChild("PersistenceService", 5) :: ModuleScript)
end)

type Fighter = Combat.Fighter
type Event = Combat.Event
type History = Lag.History
type Bucket = Protocol.Bucket
type WeaponType = Combat.WeaponType
export type EntityKind = "Player" | "Enemy"

export type EnemySpec = {
	Name: string,
	Weapon: WeaponType,
	CFrame: CFrame,
	Template: Model?,
	Stats: Combat.Stats?,
	Definition: string?,
	BodyColor: { number }?,
	Boss: boolean?,
}

export type Hooks = {
	RespawnPoint: ((userId: number) -> CFrame?)?,
	Stats: ((userId: number) -> Combat.Stats?)?,
	Loadout: ((userId: number) -> (string?, string?))?,
	CanEquip: ((userId: number, weapon: string) -> boolean)?,
	Rest: ((userId: number) -> (boolean, string))?,
	Heal: ((userId: number) -> (boolean, string))?,
	Interact: ((userId: number) -> (boolean, string))?,
	LevelUp: ((userId: number, attribute: string) -> (boolean, string))?,
	Swap: ((userId: number) -> (boolean, string))?,
	Travel: ((userId: number, altarId: string) -> (boolean, string))?,
}

export type Entity = {
	Id: number,
	Kind: EntityKind,
	Player: Player?,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Fighter: Fighter,
	History: History,
	Buffer: InputBuffer.Buffer,
	Eligible: InputBuffer.Filter,
	Actions: Bucket,
	LastSeq: number,
	Scratch: buffer,
	Packed: string,
	MirroredHealth: number,
	WalkSpeed: number,
	JumpHeight: number,
	AppliedDashSeq: number,
	WeaponPart: BasePart?,
	Connections: { RBXScriptConnection },
	RespawnAt: number,
	DespawnAt: number,
	Respawning: boolean,
	Shrine: CFrame?,
	Duel: string?,
	SpawnOverride: CFrame?,
	Definition: string?,
	Boss: boolean,
	LastMoveTo: Vector3,
	Style: string,
	Elo: number,
	Vip: boolean,
	Cosmetics: any,
}

type Duel = {
	Id: string,
	Mode: string,
	A: number,
	B: number,
	Complete: (string, number?, boolean, number, { [number]: number }) -> any,
	Finished: boolean,
	Spawns: { CFrame }?,
	Xp: { [number]: number },
}

type EventListener = (event: Event, point: Vector3?) -> ()
type StepListener = (now: number, dt: number) -> ()
type EntityListener = (id: number, kind: EntityKind) -> ()

local Service = {}
local Appearance = require(script.Parent:WaitForChild("FighterAppearance") :: ModuleScript)

local TICK: number = Tempo.TickSeconds
local MAX_CATCHUP: number = Config.Movement.MaxCatchupSteps
local MAX_FRAME_DELTA: number = Config.Movement.MaxFrameDelta
local SNAPSHOT_INTERVAL = math.max(1, math.floor(Tempo.TickRate / Config.Network.SnapshotRate + 0.5))
local STATE_ATTRIBUTE = "AsuraState"
local ID_ATTRIBUTE = "AsuraId"
local ENEMY_TAG = "AsuraEnemy"
local FACING_DOT = 0.15
local PROTOCOL_TAG = "Asura1"
local MAX_SEQUENCE_GAP = 4096
local DEFAULT_JUMP = 7.2

local INTENT_ACTIONS: { [string]: boolean } = {
	Light = true,
	Heavy = true,
	WeaponArt = true,
	Roll = true,
	Dash = true,
	Deflect = true,
	Block = true,
	Sprint = true,
	Feint = true,
	Equip = true,
	Swap = true,
	Rest = true,
	Heal = true,
	Interact = true,
	LevelUp = true,
	Travel = true,
}
local BUFFERED: { [string]: boolean } = { Light = true, Heavy = true, WeaponArt = true, Roll = true, Dash = true, Deflect = true }
local INTENT_KEYS: { [string]: string } = {
	seq = "number",
	action = "string",
	time = "number",
	variant = "string",
	x = "number",
	z = "number",
	held = "boolean",
}

local WEAPON_VISUALS: { [string]: { Size: Vector3, Color: Color3, Material: Enum.Material } } = {
	Jian = { Size = Vector3.new(0.12, 0.28, 4.2), Color = Color3.fromRGB(196, 202, 210), Material = Enum.Material.Metal },
	Dao = { Size = Vector3.new(0.16, 0.5, 3.6), Color = Color3.fromRGB(170, 160, 150), Material = Enum.Material.Metal },
	Guandao = { Size = Vector3.new(0.22, 0.22, 8.5), Color = Color3.fromRGB(92, 70, 52), Material = Enum.Material.Wood },
}

local entities: { [number]: Entity } = {}
local byModel: { [Model]: Entity } = {}
local playerConnections: { [number]: { RBXScriptConnection } } = {}
local pendingSpawn: { [number]: boolean } = {}
local retryAt: { [number]: number } = {}
local connections: { RBXScriptConnection } = {}
local frameEvents: { Event } = {}
local eventPoints: { [Event]: Vector3 } = {}
local stepTimes: { number } = {}
local eventListeners: { EventListener } = {}
local stepListeners: { StepListener } = {}
local addedListeners: { EntityListener } = {}
local removedListeners: { EntityListener } = {}
local hooks: Hooks = {}
local stepTimeIndex = 0
local droppedSteps = 0
local running = false
local accumulator = 0
local tickCount = 0
local simTime = 0
local nextEnemyId = -1
local duels: { [string]: Duel } = {}

local net = Shared:WaitForChild("Net")
local actionRemote = net:WaitForChild("ActionIntent") :: RemoteEvent
local eventRemote = net:WaitForChild("StateSnapshots") :: RemoteEvent

local function rootFolder(name: string): Folder
	local root = Workspace:FindFirstChild(Config.Names.Root)
	if not root then
		local folder = Instance.new("Folder")
		folder.Name = Config.Names.Root
		folder.Parent = Workspace
		root = folder
	end
	local child = (root :: Instance):FindFirstChild(name)
	if not child then
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = root
		child = folder
	end
	return child :: Folder
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function notify(list: { EntityListener }, id: number, kind: EntityKind)
	for _, listener in table.clone(list) do
		local ok, problem = pcall(listener, id, kind)
		if not ok then
			warn("[CharacterService] Entity listener failed: " .. tostring(problem))
		end
	end
end

local function subscribe<T>(list: { T }, listener: T): () -> ()
	table.insert(list, listener)
	return function()
		local index = table.find(list, listener)
		if index then
			table.remove(list, index)
		end
	end
end

local function awardXp(e: Entity, amount: number)
	local duelId = e.Duel
	local active = if duelId then duels[duelId] else nil
	if not active or active.Finished or active.Mode ~= "Ranked1v1" or e.Kind ~= "Player" then
		return
	end
	active.Xp[e.Id] = (active.Xp[e.Id] or 0) + amount
end

local function hostile(a: Entity, b: Entity): boolean
	if a.Id == b.Id then
		return false
	end
	-- Duelists are sealed inside their match: nothing outside it can strike in, nor they out.
	if (a.Duel ~= nil) ~= (b.Duel ~= nil) then
		return false
	end
	if a.Kind ~= b.Kind then
		return true
	end
	if a.Kind == "Enemy" then
		return false
	end
	if a.Duel ~= nil and a.Duel == b.Duel then
		return true
	end
	return Workspace:GetAttribute("AsuraOpenPvP") == true and a.Duel == nil and b.Duel == nil
end

local function flatUnit(v: Vector3): Vector3
	local flat = Vector3.new(v.X, 0, v.Z)
	local magnitude = flat.Magnitude
	if magnitude < 1e-5 then
		return Vector3.zero
	end
	return flat / magnitude
end

local function facingDot(from: Entity, toward: Entity): number
	local look = flatUnit(from.Root.CFrame.LookVector)
	local direction = flatUnit(toward.Root.Position - from.Root.Position)
	return look:Dot(direction)
end

local function alive(e: Entity): boolean
	return e.Model.Parent ~= nil and e.Humanoid.Parent ~= nil and e.Root.Parent ~= nil
end

-------------------------------------------------------------------------------------------------
-- Weapon visuals, tint and procedural weapon volumes
-------------------------------------------------------------------------------------------------

local function attachWeapon(e: Entity)
	if e.WeaponPart then
		e.WeaponPart:Destroy()
		e.WeaponPart = nil
	end
	local visual = WEAPON_VISUALS[e.Fighter.Weapon]
	e.Model:SetAttribute("AsuraWeapon", e.Fighter.Weapon)
	if visual == nil then
		return
	end
	local hand = e.Model:FindFirstChild("RightHand") or e.Model:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local part = Instance.new("Part")
	part.Name = "AsuraWeapon"
	part.Size = visual.Size
	part.Color = visual.Color
	part.Material = visual.Material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Anchored = false
	part.CFrame = hand.CFrame * CFrame.new(0, -hand.Size.Y * 0.5, -visual.Size.Z * 0.5 + 0.4)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = part
	weld.Parent = part
	part.Parent = e.Model
	e.WeaponPart = part
end

local function tint(model: Model, rgb: { number })
	local color = Color3.fromRGB(rgb[1] or 255, rgb[2] or 255, rgb[3] or 255)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" and descendant.Name ~= "AsuraWeapon" then
			descendant.Color = color
		end
	end
end

-- World-space weapon segment for a move at `progress` through its active frames. Slashes sweep the
-- authored arc around the root; thrusts extend along the facing. Lunge and fighter reach bonus are
-- folded into the tip.
local function weaponSegment(rootCFrame: CFrame, move: Combat.MoveData, progress: number, bonus: number): (Vector3, Vector3)
	local reach = move.Reach + bonus + move.Lunge * 0.35 * progress
	if move.Arc > 40 then
		local angle = math.rad(move.Arc) * (progress - 0.5)
		local direction = Vector3.new(math.sin(angle), 0, -math.cos(angle))
		local shoulder = Vector3.new(0, 0.6, 0)
		return rootCFrame:PointToWorldSpace(shoulder + direction * 0.8), rootCFrame:PointToWorldSpace(shoulder + direction * reach)
	end
	local extension = reach * (0.55 + 0.45 * progress)
	return rootCFrame:PointToWorldSpace(Vector3.new(0, 0.6, -0.8)), rootCFrame:PointToWorldSpace(Vector3.new(0, 0.6, -extension))
end

local function weaponRadius(f: Fighter): number
	return if f.Weapon == "Unarmed" then 0.55 else 0.3
end

-------------------------------------------------------------------------------------------------
-- Entity construction
-------------------------------------------------------------------------------------------------

local function eligibleFor(e: Entity): InputBuffer.Filter
	return function(action: InputBuffer.BufferedAction, _variant: string): boolean
		local f = e.Fighter
		local now = simTime
		if action == "Light" then
			local kind: Combat.MoveKind = if f.Sprinting and f.State == "Idle" then "RunningAttack" else "Light"
			local move = Combat.selectMove(f, kind, now)
			return (Schema.canAct(f.State, kind, f.Stamina, f.Posture, Combat.context(f, now, { StaminaCost = move.StaminaCost })))
		elseif action == "Heavy" or action == "WeaponArt" then
			local move = Combat.selectMove(f, action :: Combat.MoveKind, now)
			local extra = { StaminaCost = move.StaminaCost, QiCost = if move.QiCost > 0 then move.QiCost else nil, TargetDeathblowable = true }
			return (Schema.canAct(f.State, action, f.Stamina, f.Posture, Combat.context(f, now, extra)))
				or (action == "Heavy" and (Schema.canAct(f.State, "Deathblow", f.Stamina, f.Posture, Combat.context(f, now, extra))))
		end
		return (Schema.canAct(f.State, action, f.Stamina, f.Posture, Combat.context(f, now)))
	end
end

local function disconnectAll(list: { RBXScriptConnection })
	for _, connection in list do
		connection:Disconnect()
	end
	table.clear(list)
end

local function mirrorHealth(e: Entity)
	local f = e.Fighter
	local health = if f.State == "KO" then 0 else math.max(f.ActiveHP, 0.01)
	local maximum = f.MaxHP
	if math.abs(e.Humanoid.MaxHealth - maximum) > 0.005 then
		e.Humanoid.MaxHealth = maximum
	end
	if math.abs(health - e.MirroredHealth) > 0.005 then
		e.MirroredHealth = health
		e.Humanoid.Health = health
	end
end

local function bindModel(e: Entity)
	local humanoid = e.Humanoid
	humanoid.MaxHealth = e.Fighter.MaxHP
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = DEFAULT_JUMP
	humanoid.WalkSpeed = Settings.Movement.WalkSpeed
	e.WalkSpeed = Settings.Movement.WalkSpeed
	e.JumpHeight = DEFAULT_JUMP
	e.MirroredHealth = -1
	mirrorHealth(e)
	local regen = e.Model:FindFirstChild("Health")
	if regen and regen:IsA("Script") then
		regen:Destroy()
	end
	e.Model:SetAttribute(ID_ATTRIBUTE, e.Id)
	e.Model:SetAttribute("AsuraKind", e.Kind)
	e.Model:SetAttribute("AsuraStyle", e.Style)
	if e.Definition then
		e.Model:SetAttribute("AsuraDefinition", e.Definition)
	end
	byModel[e.Model] = e
	if e.Kind == "Player" then
		Appearance.Apply(e.Model, e.Connections)
		local player = e.Player
		local model = e.Model
		if player then
			table.insert(e.Connections, player.CharacterAppearanceLoaded:Connect(function(loaded: Model)
				if loaded == model and e.Model == model then
					Appearance.Apply(model, e.Connections)
					attachWeapon(e)
				end
			end))
		end
	end
	table.insert(e.Connections, humanoid.HealthChanged:Connect(function(health: number)
		-- Health only falls below the mirror through outside sources (void, hazards, scripts).
		if health < e.MirroredHealth - 0.5 and e.Fighter.State ~= "KO" then
			local loss = e.MirroredHealth - health
			e.MirroredHealth = health
			Combat.applyExternalDamage(e.Fighter, loss, simTime, frameEvents)
		end
	end))
	table.insert(e.Connections, humanoid.Died:Connect(function()
		Combat.knockOut(e.Fighter, simTime, frameEvents)
	end))
	attachWeapon(e)
	e.Packed = ""
end

local function newEntity(id: number, kind: EntityKind, player: Player?, model: Model, humanoid: Humanoid, root: BasePart, weapon: WeaponType): Entity
	local e: Entity = {
		Id = id,
		Kind = kind,
		Player = player,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Fighter = Combat.new(id, weapon, simTime),
		History = Lag.newHistory(),
		Buffer = InputBuffer.new(),
		Eligible = function()
			return false
		end,
		Actions = { tokens = Config.Network.ActionBurst, time = os.clock() },
		LastSeq = 0,
		Scratch = buffer.create(Combat.PACKET_SIZE),
		Packed = "",
		MirroredHealth = -1,
		WalkSpeed = 0,
		JumpHeight = 0,
		AppliedDashSeq = 0,
		WeaponPart = nil,
		Connections = {},
		RespawnAt = math.huge,
		DespawnAt = math.huge,
		Respawning = false,
		Shrine = nil,
		Duel = nil,
		SpawnOverride = nil,
		Definition = nil,
		Boss = false,
		LastMoveTo = Vector3.new(math.huge, 0, 0),
		Style = "Unarmed",
		Elo = 1000,
		Vip = false,
		Cosmetics = nil,
	}
	e.Eligible = eligibleFor(e)
	return e
end

local function releaseModel(e: Entity)
	disconnectAll(e.Connections)
	byModel[e.Model] = nil
	if e.WeaponPart then
		e.WeaponPart:Destroy()
		e.WeaponPart = nil
	end
end

local function removeEntity(id: number, destroyModel: boolean)
	local e = entities[id]
	if not e then
		return
	end
	releaseModel(e)
	entities[id] = nil
	if destroyModel and e.Model.Parent then
		e.Model:Destroy()
	end
	for _, other in entities do
		if other.Fighter.DeathblowPartner == id then
			other.Fighter.DeathblowPartner = 0
		end
	end
	notify(removedListeners, id, e.Kind)
end

-------------------------------------------------------------------------------------------------
-- Spawning: players, enemies, duels
-------------------------------------------------------------------------------------------------

local function defaultSpawn(): CFrame
	local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then
		return spawn.CFrame * CFrame.new(0, spawn.Size.Y * 0.5 + 3, 0)
	end
	return CFrame.new(0, Config.Movement.RootHeight + 2, 0)
end

local function duelSpawn(slot: number): CFrame
	local z = if slot == 1 then Config.Arena.SpawnDistance else -Config.Arena.SpawnDistance
	local position = Vector3.new(0, Config.Movement.RootHeight, z)
	return CFrame.lookAt(position, Vector3.new(0, Config.Movement.RootHeight, 0))
end

local function spawnCFrameFor(e: Entity): CFrame
	local override = e.SpawnOverride
	if override then
		e.SpawnOverride = nil
		return override
	end
	local duelId = e.Duel
	local active = if duelId then duels[duelId] else nil
	if active then
		local slot = if e.Id == active.A then 1 else 2
		local spawns = active.Spawns
		return if spawns and spawns[slot] then spawns[slot] else duelSpawn(slot)
	end
	local resolver = hooks.RespawnPoint
	if resolver and e.Kind == "Player" then
		local ok, point = pcall(resolver, e.Id)
		if ok and point then
			return point
		end
	end
	return e.Shrine or defaultSpawn()
end

local function loadProfile(e: Entity)
	local player = e.Player
	if not player or not Persistence then
		return
	end
	local ok, profile = pcall(Persistence.Get, player.UserId)
	if not ok or not profile then
		return
	end
	e.Elo = profile.elo or e.Elo
	e.Vip = profile.ownedCosmetics ~= nil and profile.ownedCosmetics.VIP_Pass == true
	e.Style = if type(profile.activeStyle) == "string" and profile.activeStyle ~= "" then profile.activeStyle else e.Style
	e.Cosmetics = profile.equippedCosmetics
end

local function applyPlayerProgression(e: Entity)
	local statsHook = hooks.Stats
	if statsHook then
		local ok, stats = pcall(statsHook, e.Id)
		if ok and stats then
			Combat.applyStats(e.Fighter, stats, true)
		end
	end
	local loadoutHook = hooks.Loadout
	if loadoutHook then
		local ok, mainhand = pcall(loadoutHook, e.Id)
		if ok and type(mainhand) == "string" and Weapons.Weapons[mainhand] then
			Combat.forceWeapon(e.Fighter, mainhand :: WeaponType)
		end
	end
end

local function onCharacter(player: Player, model: Model)
	local humanoid = model:WaitForChild("Humanoid", 10)
	local root = model:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") or not player.Parent then
		return
	end
	-- CharacterAdded can precede the body assembly. The outfit and held weapon need the limbs.
	local r15 = humanoid.RigType == Enum.HumanoidRigType.R15
	local head = model:WaitForChild("Head", 10)
	local torso = model:WaitForChild(if r15 then "UpperTorso" else "Torso", 10)
	local hand = model:WaitForChild(if r15 then "RightHand" else "Right Arm", 10)
	if not head or not torso or not hand or player.Character ~= model then return end
	local id = player.UserId
	local existing = entities[id]
	local created = existing == nil
	local e: Entity
	if existing then
		releaseModel(existing)
		existing.Model = model
		existing.Humanoid = humanoid
		existing.Root = root
		e = existing
	else
		e = newEntity(id, "Player", player, model, humanoid, root, "Unarmed")
		entities[id] = e
		loadProfile(e)
	end
	Combat.restore(e.Fighter, simTime, true)
	applyPlayerProgression(e)
	Combat.restore(e.Fighter, simTime, true)
	e.Fighter.State = "Idle"
	e.Fighter.StateStart = simTime
	e.Fighter.StateEnd = math.huge
	e.RespawnAt = math.huge
	e.Respawning = false
	Lag.clear(e.History)
	InputBuffer.clear(e.Buffer)
	bindModel(e)
	model:SetAttribute("AsuraDuel", e.Duel)
	model:PivotTo(spawnCFrameFor(e))
	if e.Cosmetics then
		model:SetAttribute("Trunks", e.Cosmetics.Trunks)
		model:SetAttribute("Gloves", e.Cosmetics.Gloves)
	end
	if created then
		notify(addedListeners, id, "Player")
	end
end

local function requestCharacter(player: Player)
	local id = player.UserId
	if pendingSpawn[id] or not player.Parent then
		return
	end
	pendingSpawn[id] = true
	task.spawn(function()
		local ok, problem = pcall(function()
			player:LoadCharacter()
			-- Avatar assembly may replace early cosmetic parts while applying its description.
			local current = entities[id]
			if current and current.Model == player.Character then
				Appearance.Apply(current.Model, current.Connections)
				attachWeapon(current)
			end
		end)
		pendingSpawn[id] = nil
		if not ok then
			warn("[CharacterService] LoadCharacter failed for " .. tostring(id) .. ": " .. tostring(problem))
			retryAt[id] = os.clock() + 2
			local e = entities[id]
			if e then
				e.Respawning = false
			end
		end
	end)
end

local function trackPlayer(player: Player)
	local id = player.UserId
	if playerConnections[id] then
		return
	end
	local list: { RBXScriptConnection } = {}
	playerConnections[id] = list
	table.insert(list, player.CharacterAdded:Connect(function(model: Model)
		onCharacter(player, model)
	end))
	table.insert(list, player.CharacterRemoving:Connect(function(model: Model)
		local e = entities[id]
		if e and e.Model == model then
			releaseModel(e)
		end
	end))
end

local function profileReady(player: Player): boolean
	if not Persistence then
		return true
	end
	local ok, profile = pcall(Persistence.Get, player.UserId)
	return ok and profile ~= nil
end

local function ensurePlayer(player: Player)
	trackPlayer(player)
	local e = entities[player.UserId]
	if e and alive(e) then
		return
	end
	if player.Character and player.Character.Parent then
		task.spawn(onCharacter, player, player.Character)
		return
	end
	requestCharacter(player)
end

local function buildEnemyModel(spec: EnemySpec): Model?
	if spec.Template then
		return spec.Template:Clone()
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok then
		warn("[CharacterService] Enemy rig creation failed: " .. tostring(model))
		return nil
	end
	return model
end

local function spawnEnemy(spec: EnemySpec, existing: Model?): number?
	local model = existing or buildEnemyModel(spec)
	if not model then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		warn("[CharacterService] Enemy model lacks Humanoid/HumanoidRootPart: " .. spec.Name)
		if not existing then
			model:Destroy()
		end
		return nil
	end
	local id = nextEnemyId
	nextEnemyId -= 1
	model.Name = spec.Name
	humanoid.DisplayName = spec.Name
	if spec.BodyColor then
		tint(model, spec.BodyColor)
	end
	if not existing then
		model.Parent = rootFolder("Entities")
	end
	model:PivotTo(spec.CFrame)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local e = newEntity(id, "Enemy", nil, model, humanoid, root, spec.Weapon)
	e.Style = spec.Weapon
	e.Definition = spec.Definition
	e.Boss = spec.Boss == true
	if spec.Stats then
		Combat.applyStats(e.Fighter, spec.Stats, true)
	end
	entities[id] = e
	bindModel(e)
	model:SetAttribute("AsuraBoss", e.Boss)
	notify(addedListeners, id, "Enemy")
	return id
end

local function registerTagged(instance: Instance)
	if not instance:IsA("Model") or byModel[instance] or not instance:IsDescendantOf(Workspace) then
		return
	end
	local weaponName = instance:GetAttribute("Weapon")
	local weapon: WeaponType = if type(weaponName) == "string" and Weapons.Weapons[weaponName] then weaponName :: WeaponType else "Unarmed"
	local definition = instance:GetAttribute("Definition")
	spawnEnemy({
		Name = instance.Name,
		Weapon = weapon,
		CFrame = instance:GetPivot(),
		Definition = if type(definition) == "string" then definition else nil,
	}, instance)
end

-------------------------------------------------------------------------------------------------
-- Intent handling
-------------------------------------------------------------------------------------------------

local function validIntent(packet: any, lastSeq: number): boolean
	if type(packet) ~= "table" then
		return false
	end
	local count = 0
	for key, value in packet do
		count += 1
		if count > 7 or type(key) ~= "string" then
			return false
		end
		local expected = INTENT_KEYS[key]
		if expected == nil or type(value) ~= expected then
			return false
		end
		if expected == "number" and (value ~= value or math.abs(value) == math.huge) then
			return false
		end
	end
	local seq, action = packet.seq, packet.action
	if type(seq) ~= "number" or seq % 1 ~= 0 or seq <= lastSeq or seq > lastSeq + MAX_SEQUENCE_GAP then
		return false
	end
	if type(action) ~= "string" or not INTENT_ACTIONS[action] or type(packet.time) ~= "number" then
		return false
	end
	if packet.variant ~= nil and #packet.variant > 32 then
		return false
	end
	if packet.x ~= nil and math.abs(packet.x) > 1.001 then
		return false
	end
	if packet.z ~= nil and math.abs(packet.z) > 1.001 then
		return false
	end
	return true
end

local function report(e: Entity, seq: number, ok: boolean, reason: string)
	local player = e.Player
	if player then
		player:SetAttribute("AsuraAck", seq)
		player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
	end
end

local function findDeathblowTarget(attacker: Entity, now: number): Entity?
	local best: Entity? = nil
	local bestDistance = math.huge
	for _, other in entities do
		if other.Fighter.State == "StanceBroken" and hostile(attacker, other) and alive(other) then
			local distance = (other.Root.Position - attacker.Root.Position).Magnitude
			if distance < bestDistance then
				local ok = Combat.canDeathblow(attacker.Fighter, other.Fighter, distance, facingDot(attacker, other), now)
				if ok then
					best, bestDistance = other, distance
				end
			end
		end
	end
	return best
end

local function applyDash(e: Entity)
	local f = e.Fighter
	if f.DashSeq == e.AppliedDashSeq then
		return
	end
	e.AppliedDashSeq = f.DashSeq
	if e.Kind ~= "Enemy" or f.DashDuration <= 0 then
		-- Players own their assembly; the client executes the granted displacement from the replicated record.
		return
	end
	local direction = Vector3.new(f.DashDirX, 0, f.DashDirZ)
	if direction.Magnitude < 1e-3 then
		direction = -flatUnit(e.Root.CFrame.LookVector)
	end
	local velocity = direction * (f.DashDistance / f.DashDuration)
	e.Root.AssemblyLinearVelocity = Vector3.new(velocity.X, e.Root.AssemblyLinearVelocity.Y, velocity.Z)
end

local function perform(e: Entity, action: string, pressTime: number, dirX: number, dirZ: number): (boolean, string)
	local f = e.Fighter
	local now = simTime
	if action == "Light" then
		local kind: Combat.MoveKind = if f.Sprinting and f.State == "Idle" then "RunningAttack" else "Light"
		return Combat.tryAttack(f, kind, now)
	elseif action == "Heavy" then
		local victim = findDeathblowTarget(e, now)
		if victim then
			local dealt = Combat.executeDeathblow(f, victim.Fighter, now, frameEvents)
			eventPoints[frameEvents[#frameEvents]] = victim.Root.Position
			awardXp(e, 60)
			local look = flatUnit(victim.Root.Position - e.Root.Position)
			if e.Kind == "Enemy" and look.Magnitude > 0 then
				e.Root.CFrame = CFrame.lookAt(e.Root.Position, e.Root.Position + look)
			end
			return true, "Deathblow:" .. string.format("%.1f", dealt)
		end
		return Combat.tryAttack(f, "Heavy", now)
	elseif action == "WeaponArt" then
		return Combat.tryAttack(f, "WeaponArt", now)
	elseif action == "Roll" or action == "Dash" then
		local grant, reason = Combat.tryDash(f, action :: "Roll" | "Dash", now, dirX, dirZ, frameEvents)
		if grant then
			applyDash(e)
			return true, reason
		end
		return false, reason
	elseif action == "Deflect" then
		return Combat.tryDeflect(f, now, pressTime)
	end
	return false, "UnknownAction"
end

local function callHook(name: string, ...: any): (boolean, string)
	local hook = (hooks :: any)[name]
	if hook == nil then
		return false, "Unavailable"
	end
	local ok, accepted, reason = pcall(hook, ...)
	if not ok then
		warn("[CharacterService] " .. name .. " hook failed: " .. tostring(accepted))
		return false, "Error"
	end
	return accepted == true, if type(reason) == "string" then reason else name
end

local function immediate(e: Entity, packet: any): (boolean, string)
	local f = e.Fighter
	local now = simTime
	local action: string = packet.action
	if action == "Block" then
		return Combat.setGuard(f, packet.held == true, now)
	elseif action == "Sprint" then
		local ok = Combat.setSprint(f, packet.held == true, now)
		return ok, if ok then "Sprint" else "SprintRefused"
	elseif action == "Feint" then
		return Combat.tryFeint(f, now, frameEvents)
	elseif action == "Equip" then
		local weapon = packet.variant
		if type(weapon) ~= "string" or Weapons.Weapons[weapon] == nil then
			return false, "UnknownWeapon"
		end
		local guard = hooks.CanEquip
		if guard and not guard(e.Id, weapon) then
			return false, "WeaponLocked"
		end
		local ok, reason = Combat.tryEquip(f, weapon :: WeaponType, now)
		if ok then
			attachWeapon(e)
		end
		return ok, reason
	elseif action == "Swap" then
		return callHook("Swap", e.Id)
	elseif action == "Rest" then
		if e.Duel then
			return false, "InDuel"
		end
		return callHook("Rest", e.Id)
	elseif action == "Heal" then
		return callHook("Heal", e.Id)
	elseif action == "Interact" then
		return callHook("Interact", e.Id)
	elseif action == "LevelUp" then
		return callHook("LevelUp", e.Id, packet.variant or "")
	elseif action == "Travel" then
		if e.Duel then
			return false, "InDuel"
		end
		return callHook("Travel", e.Id, packet.variant or "")
	end
	return false, "UnknownAction"
end

local function onIntent(player: Player, packet: any)
	if not running then
		return
	end
	local e = entities[player.UserId]
	if not e or e.Respawning then
		return
	end
	if not Protocol.Take(e.Actions, os.clock(), 1, Config.Network.ActionsPerSecond, Config.Network.ActionBurst) then
		return
	end
	if not validIntent(packet, e.LastSeq) then
		return
	end
	e.LastSeq = packet.seq
	local action: string = packet.action
	if BUFFERED[action] then
		local pressTime = Tempo.reconcile(packet.time, simTime, Lag.MAX_REWIND)
		InputBuffer.push(e.Buffer, action :: InputBuffer.BufferedAction, pressTime, packet.variant, packet.x, packet.z)
		report(e, packet.seq, true, "Buffered")
		return
	end
	local ok, reason = immediate(e, packet)
	report(e, packet.seq, ok, reason)
end

local function drainBuffer(e: Entity)
	if InputBuffer.count(e.Buffer) == 0 then
		return
	end
	local action, pressTime, _variant, dirX, dirZ = InputBuffer.pop(e.Buffer, simTime, e.Eligible)
	if action == nil then
		return
	end
	local ok, reason = perform(e, action, pressTime or simTime, dirX or 0, dirZ or 0)
	local player = e.Player
	if player then
		player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
	end
end

-------------------------------------------------------------------------------------------------
-- Simulation step
-------------------------------------------------------------------------------------------------

local function resolveContacts(attacker: Entity, now: number)
	local f = attacker.Fighter
	local move = f.Move
	local progress = Combat.activeProgress(f, now)
	if move == nil or progress == nil then
		return
	end
	local previous = math.max(0, progress - TICK / math.max(move.Timing.ActiveSeconds, TICK))
	local rootCFrame = attacker.Root.CFrame
	local prevA, prevB = weaponSegment(rootCFrame, move, previous, f.ReachBonus)
	local curA, curB = weaponSegment(rootCFrame, move, progress, f.ReachBonus)
	local radius = weaponRadius(f)
	local player = attacker.Player
	local rewindTo = if player then Lag.rewindTime(now, nil, player:GetNetworkPing()) else now
	for _, defender in entities do
		if defender ~= attacker and not f.HitRegistry[defender.Id] and defender.Fighter.State ~= "KO" and alive(defender) and hostile(attacker, defender) then
			local hit = Lag.queryHit(prevA, prevB, curA, curB, radius, defender.History, rewindTo, TICK)
			if hit then
				local before = #frameEvents
				local outcome = Combat.resolveHit(f, defender.Fighter, now, {
					Facing = facingDot(defender, attacker) >= FACING_DOT,
					Region = hit.Region :: any,
				}, frameEvents)
				for index = before + 1, #frameEvents do
					eventPoints[frameEvents[index]] = hit.Point
				end
				if outcome == "Deflected" then
					awardXp(defender, 15)
				elseif outcome == "Hit" or outcome == "CounterHit" or outcome == "Armored" then
					awardXp(attacker, if outcome == "CounterHit" then 20 else 10)
				elseif outcome == "KO" then
					awardXp(attacker, 100)
				end
			end
		end
	end
end

local function finishDuel(loser: Entity)
	local duelId = loser.Duel
	local active = if duelId then duels[duelId] else nil
	if not active or active.Finished then
		return
	end
	active.Finished = true
	local winner = if loser.Id == active.A then active.B else active.A
	local results = table.clone(active.Xp)
	local complete = active.Complete
	local matchId = active.Id
	task.spawn(function()
		local ok, problem = pcall(complete, matchId, winner, false, 1, results)
		if not ok then
			warn("[CharacterService] Duel completion failed: " .. tostring(problem))
		end
	end)
end

local function handleDefeat(e: Entity, now: number)
	local f = e.Fighter
	if f.State ~= "KO" then
		return
	end
	if e.Kind == "Enemy" then
		if e.DespawnAt == math.huge then
			e.DespawnAt = now + Settings.Respawn.EnemyCorpseTime
			e.Humanoid:MoveTo(e.Root.Position)
		elseif now >= e.DespawnAt then
			removeEntity(e.Id, true)
		end
		return
	end
	if e.Duel then
		finishDuel(e)
		return
	end
	if e.RespawnAt == math.huge then
		e.RespawnAt = now + Settings.Respawn.PlayerDelay
	elseif now >= e.RespawnAt and not e.Respawning then
		local player = e.Player
		if player and player.Parent then
			e.Respawning = true
			requestCharacter(player)
		end
	end
end

local function applyLocomotion(e: Entity)
	local f = e.Fighter
	local speed = Settings.Movement.WalkSpeed * Combat.speedMultiplier(f)
	if math.abs(speed - e.WalkSpeed) > 0.01 then
		e.WalkSpeed = speed
		e.Humanoid.WalkSpeed = speed
	end
	local jump = if speed > 0 and (f.State == "Idle" or f.State == "Blocking") then DEFAULT_JUMP else 0
	if jump ~= e.JumpHeight then
		e.JumpHeight = jump
		e.Humanoid.JumpHeight = jump
	end
end

local function replicate(e: Entity, now: number)
	local packed = Combat.packString(e.Fighter, now, e.Scratch)
	if packed ~= e.Packed then
		e.Packed = packed
		e.Model:SetAttribute(STATE_ATTRIBUTE, packed)
	end
end

local function flushEvents(now: number)
	if #frameEvents == 0 then
		return
	end
	local batch = table.create(#frameEvents)
	for index, event in frameEvents do
		local point = eventPoints[event]
		for _, listener in eventListeners do
			local ok, problem = pcall(listener, event, point)
			if not ok then
				warn("[CharacterService] Event listener failed: " .. tostring(problem))
			end
		end
		batch[index] = {
			k = Combat.EventCodes[event.Kind],
			s = event.Source,
			t = event.Target,
			v = math.floor(event.Value * 100 + 0.5) / 100,
			r = event.Region,
			p = point,
		}
	end
	table.clear(frameEvents)
	table.clear(eventPoints)
	eventRemote:FireAllClients({ v = PROTOCOL_TAG, t = now, e = batch })
end

local function step()
	tickCount += 1
	simTime += TICK
	local drift = serverNow() - simTime
	if math.abs(drift) > 0.25 then
		simTime += drift
	end
	local now = simTime

	local live: { Entity } = {}
	local clock = os.clock()
	for _, e in entities do
		if alive(e) then
			table.insert(live, e)
			Lag.record(e.History, now, e.Root.CFrame, e.Root.AssemblyLinearVelocity)
		elseif e.Kind == "Player" and not e.Respawning and not pendingSpawn[e.Id] and clock >= (retryAt[e.Id] or 0) then
			-- Character vanished outside the combat flow (destroyed, reset): restore one.
			local player = e.Player
			if player and player.Parent then
				e.Respawning = true
				requestCharacter(player)
			end
		end
	end
	table.sort(live, function(a: Entity, b: Entity): boolean
		return a.Id > b.Id
	end)

	for _, listener in stepListeners do
		local ok, problem = pcall(listener, now, TICK)
		if not ok then
			warn("[CharacterService] Step listener failed: " .. tostring(problem))
		end
	end

	for _, e in live do
		if entities[e.Id] == e then
			local f = e.Fighter
			Combat.step(f, now, TICK, frameEvents)
			if f.GuardHeld and f.State == "Idle" then
				Combat.setGuard(f, true, now)
			end
			drainBuffer(e)
		end
	end

	for _, e in live do
		if entities[e.Id] == e and e.Fighter.State == "Active" then
			resolveContacts(e, now)
		end
	end

	local replicateNow = tickCount % SNAPSHOT_INTERVAL == 0
	for _, e in live do
		if entities[e.Id] == e then
			handleDefeat(e, now)
		end
		if entities[e.Id] == e then
			applyDash(e)
			applyLocomotion(e)
			mirrorHealth(e)
			if replicateNow then
				replicate(e, now)
			end
		end
	end

	flushEvents(now)
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function Service.Start()
	assert(not running, "CharacterService already started")
	running = true
	accumulator = 0
	tickCount = 0
	simTime = serverNow()
	Players.CharacterAutoLoads = false
	rootFolder("Entities")

	table.insert(connections, Players.PlayerAdded:Connect(function(player: Player)
		trackPlayer(player)
		if not Persistence then
			ensurePlayer(player)
		end
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		local id = player.UserId
		removeEntity(id, false)
		pendingSpawn[id] = nil
		retryAt[id] = nil
		local list = playerConnections[id]
		if list then
			disconnectAll(list)
			playerConnections[id] = nil
		end
	end))
	for _, player in Players:GetPlayers() do
		trackPlayer(player)
		if profileReady(player) then
			ensurePlayer(player)
		end
	end

	for _, instance in CollectionService:GetTagged(ENEMY_TAG) do
		registerTagged(instance)
	end
	table.insert(connections, CollectionService:GetInstanceAddedSignal(ENEMY_TAG):Connect(registerTagged))
	table.insert(connections, actionRemote.OnServerEvent:Connect(onIntent))
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		accumulator += math.min(dt, MAX_FRAME_DELTA)
		local steps = 0
		while accumulator >= TICK and steps < MAX_CATCHUP do
			accumulator -= TICK
			steps += 1
			local started = os.clock()
			step()
			stepTimeIndex = stepTimeIndex % 7200 + 1
			stepTimes[stepTimeIndex] = (os.clock() - started) * 1000
		end
		if accumulator >= TICK then
			droppedSteps += math.floor(accumulator / TICK)
			accumulator %= TICK
		end
	end))
end

function Service.Destroy()
	running = false
	disconnectAll(connections)
	for id, e in entities do
		removeEntity(id, e.Kind == "Enemy")
	end
	for id, list in playerConnections do
		disconnectAll(list)
		playerConnections[id] = nil
	end
	table.clear(frameEvents)
	table.clear(eventPoints)
	table.clear(duels)
end

-------------------------------------------------------------------------------------------------
-- Extension points
-------------------------------------------------------------------------------------------------

function Service.SetHooks(newHooks: Hooks)
	hooks = newHooks
end

function Service.GetHooks(): Hooks
	return hooks
end

function Service.Subscribe(listener: EventListener): () -> ()
	return subscribe(eventListeners, listener)
end

function Service.OnStep(listener: StepListener): () -> ()
	return subscribe(stepListeners, listener)
end

function Service.OnEntityAdded(listener: EntityListener): () -> ()
	return subscribe(addedListeners, listener)
end

function Service.OnEntityRemoved(listener: EntityListener): () -> ()
	return subscribe(removedListeners, listener)
end

function Service.Now(): number
	return simTime
end

function Service.GetEntity(id: number): Entity?
	local e = entities[id]
	if e and alive(e) then
		return e
	end
	return nil
end

function Service.Entities(): { [number]: Entity }
	return entities
end

function Service.IsHostile(a: number, b: number): boolean
	local first, second = entities[a], entities[b]
	return first ~= nil and second ~= nil and hostile(first, second)
end

function Service.IsInDuel(id: number): boolean
	local e = entities[id]
	return e ~= nil and e.Duel ~= nil
end

function Service.GetDuel(id: number): string?
	local e = entities[id]
	return if e then e.Duel else nil
end

-------------------------------------------------------------------------------------------------
-- Control surface for AI and world services
-------------------------------------------------------------------------------------------------

function Service.PushIntent(id: number, action: InputBuffer.BufferedAction, variant: string?, dirX: number?, dirZ: number?): boolean
	local e = entities[id]
	if not e or not alive(e) then
		return false
	end
	return InputBuffer.push(e.Buffer, action, simTime, variant, dirX, dirZ)
end

function Service.SetGuard(id: number, held: boolean): boolean
	local e = entities[id]
	if not e then
		return false
	end
	return (Combat.setGuard(e.Fighter, held, simTime))
end

function Service.SetSprint(id: number, on: boolean): boolean
	local e = entities[id]
	if not e then
		return false
	end
	return Combat.setSprint(e.Fighter, on, simTime)
end

function Service.MoveTo(id: number, position: Vector3)
	local e = entities[id]
	if not e or not alive(e) or e.Kind ~= "Enemy" then
		return
	end
	if (position - e.LastMoveTo).Magnitude > 0.75 then
		e.LastMoveTo = position
		e.Humanoid:MoveTo(position)
	end
end

function Service.StopMoving(id: number)
	local e = entities[id]
	if e and alive(e) and e.Kind == "Enemy" then
		e.LastMoveTo = e.Root.Position
		e.Humanoid:MoveTo(e.Root.Position)
	end
end

function Service.Face(id: number, position: Vector3)
	local e = entities[id]
	if not e or not alive(e) or e.Kind ~= "Enemy" then
		return
	end
	local f = e.Fighter
	if f.State == "Dashing" or f.State == "Active" or Schema.isStunned(f.State) or Schema.isLocked(f.State) then
		return
	end
	local origin = e.Root.Position
	local direction = flatUnit(position - origin)
	if direction.Magnitude > 0 then
		e.Root.CFrame = CFrame.lookAt(origin, origin + direction)
	end
end

function Service.Teleport(id: number, cframe: CFrame)
	local e = entities[id]
	if e and alive(e) then
		e.Model:PivotTo(cframe)
		e.Root.AssemblyLinearVelocity = Vector3.zero
		e.LastMoveTo = Vector3.new(math.huge, 0, 0)
		Lag.clear(e.History)
	end
end

function Service.SetRespawnPoint(id: number, cframe: CFrame)
	local e = entities[id]
	if e then
		e.Shrine = cframe
	end
end

function Service.ApplyStats(id: number, stats: Combat.Stats, refill: boolean?)
	local e = entities[id]
	if e then
		Combat.applyStats(e.Fighter, stats, refill)
		mirrorHealth(e)
	end
end

function Service.ForceWeapon(id: number, weapon: WeaponType)
	local e = entities[id]
	if e then
		Combat.forceWeapon(e.Fighter, weapon)
		attachWeapon(e)
		e.Style = weapon
	end
end

function Service.Tint(id: number, rgb: { number })
	local e = entities[id]
	if e and alive(e) then
		tint(e.Model, rgb)
	end
end

-- Full restore outside the shrine flow (leash reset, encounter reset).
function Service.RestoreFighter(id: number)
	local e = entities[id]
	if not e or e.Fighter.State == "KO" then
		return
	end
	Combat.restore(e.Fighter, simTime, true)
	e.Fighter.State = "Idle"
	e.Fighter.StateStart = simTime
	e.Fighter.StateEnd = math.huge
	InputBuffer.clear(e.Buffer)
end

function Service.Rest(id: number): (boolean, string)
	local e = entities[id]
	if not e or not alive(e) then
		return false, "Unavailable"
	end
	return Combat.tryRest(e.Fighter, simTime, true, frameEvents)
end

function Service.TryHeal(id: number, fraction: number?): (boolean, string)
	local e = entities[id]
	if not e or not alive(e) then
		return false, "Unavailable"
	end
	return Combat.tryHeal(e.Fighter, simTime, fraction)
end

function Service.Cinematic(id: number, duration: number)
	local e = entities[id]
	if e then
		Combat.cinematic(e.Fighter, simTime, duration)
		InputBuffer.clear(e.Buffer)
		if e.Kind == "Enemy" and alive(e) then
			e.Humanoid:MoveTo(e.Root.Position)
		end
	end
end

function Service.ApplyArea(sourceId: number, targetId: number, damage: number, posture: number, unblockable: boolean): string
	local source, target = entities[sourceId], entities[targetId]
	if not source or not target or not alive(target) or not hostile(source, target) then
		return "Ignored"
	end
	local before = #frameEvents
	local outcome = Combat.applyArea(source.Fighter, target.Fighter, simTime, damage, posture, unblockable, facingDot(target, source) >= FACING_DOT, frameEvents)
	for index = before + 1, #frameEvents do
		eventPoints[frameEvents[index]] = target.Root.Position
	end
	return outcome
end

-- Broadcast a presentation cue (telegraph, boss phase, fog gate) on the shared event stream.
function Service.Cue(kind: string, sourceId: number, payload: { [string]: any })
	eventRemote:FireAllClients({ v = PROTOCOL_TAG, t = simTime, cue = kind, s = sourceId, d = payload })
end

function Service.SpawnEnemy(spec: EnemySpec): number?
	assert(Weapons.Weapons[spec.Weapon] ~= nil, "Unknown enemy weapon")
	return spawnEnemy(spec, nil)
end

function Service.DespawnEnemy(id: number)
	local e = entities[id]
	if e and e.Kind == "Enemy" then
		removeEntity(id, true)
	end
end

function Service.EquipWeapon(id: number, weapon: WeaponType): (boolean, string)
	local e = entities[id]
	if not e then
		return false, "Entity not found"
	end
	local ok, reason = Combat.tryEquip(e.Fighter, weapon, simTime)
	if ok then
		attachWeapon(e)
	end
	return ok, reason
end

function Service.GetFighter(id: number): Fighter?
	local e = entities[id]
	return if e then e.Fighter else nil
end

function Service.GetActor(id: number): any
	return entities[id]
end

function Service.GetEntityByModel(model: Model): number?
	local e = byModel[model]
	return if e then e.Id else nil
end

-------------------------------------------------------------------------------------------------
-- Account, progression and match API used by Bootstrap and Matchmaking
-------------------------------------------------------------------------------------------------

function Service.RefreshRoster()
	for id, e in entities do
		local player = e.Player
		if e.Kind == "Player" and player and not profileReady(player) then
			removeEntity(id, false)
			if player.Character then
				player.Character:Destroy()
			end
		end
	end
	for _, player in Players:GetPlayers() do
		if profileReady(player) then
			ensurePlayer(player)
		end
	end
end

function Service.RefreshProgression(id: number)
	local e = entities[id]
	if not e or not Persistence then
		return
	end
	loadProfile(e)
	e.Model:SetAttribute("AsuraStyle", e.Style)
	local statsHook = hooks.Stats
	if statsHook and e.Kind == "Player" then
		local ok, stats = pcall(statsHook, id)
		if ok and stats then
			Combat.applyStats(e.Fighter, stats, false)
		end
	end
end

function Service.UpdateCosmetics(userId: number, trunks: string?, gloves: string?, cosmetics: any?)
	local e = entities[userId]
	if not e then
		return
	end
	if cosmetics then
		e.Cosmetics = cosmetics
	end
	if trunks then
		e.Model:SetAttribute("Trunks", trunks)
	end
	if gloves then
		e.Model:SetAttribute("Gloves", gloves)
	end
end

function Service.CanSetStyle(id: number): boolean
	local e = entities[id]
	return e == nil or (e.Duel == nil and (e.Fighter.State == "Idle" or e.Fighter.State == "RestingAtShrine"))
end

-- Profile style is kept as an identity tag; combat moves come from the equipped weapon.
function Service.SetPlayerStyle(userId: number, styleName: string): (boolean, string?)
	local e = entities[userId]
	if not e then
		return false, "Player entity not found"
	end
	local profile = if Persistence then Persistence.Get(userId) else nil
	if Persistence and (not profile or not profile.styles or not profile.styles[styleName] or not profile.styles[styleName].unlocked) then
		return false, "Style is locked"
	end
	e.Style = styleName
	e.Model:SetAttribute("AsuraStyle", styleName)
	return true, nil
end

function Service.GetPerformance()
	local times = table.clone(stepTimes)
	table.sort(times)
	local count = 0
	for _ in entities do
		count += 1
	end
	return {
		samples = #times,
		p95StepMs = times[math.max(1, math.ceil(#times * 0.95))] or 0,
		maxStepMs = times[#times] or 0,
		droppedSteps = droppedSteps,
		entities = count,
	}
end

function Service.GetMatchXp(id: string?): { [number]: number }
	local active = if id then duels[id] else nil
	return if active then table.clone(active.Xp) else {}
end

function Service.GetRound(): number
	return 1
end

-- Seals two players into a duel. `spawns` places them (slot 1, slot 2); duels run concurrently.
function Service.StartAllocatedMatch(id: string, p1: number, p2: number, mode: string, complete: any, spawns: { CFrame }?): boolean
	if duels[id] or p1 == p2 then
		return false
	end
	local a, b = entities[p1], entities[p2]
	if not a or not b or a.Kind ~= "Player" or b.Kind ~= "Player" or a.Duel ~= nil or b.Duel ~= nil then
		return false
	end
	if not alive(a) or not alive(b) or a.Respawning or b.Respawning then
		return false
	end
	if Persistence and (not Persistence.Get(p1) or not Persistence.Get(p2)) then
		return false
	end
	duels[id] = { Id = id, Mode = mode, A = p1, B = p2, Complete = complete, Finished = false, Spawns = spawns, Xp = {} }
	for _, e in { a, b } do
		e.Duel = id
		e.SpawnOverride = nil
		Combat.restore(e.Fighter, simTime, true)
		e.Fighter.State = "Idle"
		e.Fighter.StateStart = simTime
		e.Fighter.StateEnd = math.huge
		InputBuffer.clear(e.Buffer)
		Lag.clear(e.History)
		e.RespawnAt = math.huge
		e.Model:SetAttribute("AsuraDuel", id)
		e.Model:PivotTo(spawnCFrameFor(e))
		e.Root.AssemblyLinearVelocity = Vector3.zero
	end
	return true
end

-- Releases a duel. Standing fighters are restored and moved to `returns[userId]`; fallen ones
-- respawn there (or at their respawn point when no destination is given).
function Service.EndAllocatedMatch(id: string, returns: { [number]: CFrame }?)
	local active = duels[id]
	if not active then
		return
	end
	duels[id] = nil
	for _, userId in { active.A, active.B } do
		local e = entities[userId]
		if e and e.Duel == id then
			e.Duel = nil
			e.Model:SetAttribute("AsuraDuel", nil)
			local destination = if returns then returns[userId] else nil
			local player = e.Player
			if destination and alive(e) and e.Fighter.State ~= "KO" then
				Combat.restore(e.Fighter, simTime, true)
				e.Fighter.State = "Idle"
				e.Fighter.StateStart = simTime
				e.Fighter.StateEnd = math.huge
				InputBuffer.clear(e.Buffer)
				e.RespawnAt = math.huge
				e.Model:PivotTo(destination)
				e.Root.AssemblyLinearVelocity = Vector3.zero
				e.LastMoveTo = Vector3.new(math.huge, 0, 0)
				Lag.clear(e.History)
			elseif player and player.Parent then
				e.SpawnOverride = destination
				e.Respawning = true
				requestCharacter(player)
			end
		end
	end
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ColosseumService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/ColosseumService
-- Overworld PvP Colosseums. Each ring is an octagon sealed by an invisible barrier and bordered by
-- an ember threshold; standing on that threshold opens matchmaking for the player:
--   * Ranked 1v1 duels: ELO-bracketed queue, gated on round-trip latency so every hit stays inside
--     the LagCompensation rewind budget, journaled before start and settled through the durable
--     match inbox (exactly-once ELO, recoverable after a crash or disconnect).
--   * Casual spars: an instant challenge to any player on the server, sealed on acceptance.
-- Ranked fighters are normalised to a fixed competitive attribute budget that preserves their
-- build's proportions, so story-mode grinding never decides a ranked duel.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local Settings = require(Shared.Shared.CombatSettings) :: any
local World = require(Shared.Shared.WorldDefinitions)
local Protocol = require(Shared.Shared.IntentProtocol)
local Rules = require(Shared.Simulation.MatchmakingRules) :: any
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local Lag = require(script.Parent:WaitForChild("LagCompensation") :: ModuleScript)
local AI = require(script.Parent:WaitForChild("AIService") :: ModuleScript)
local WorldService = require(script.Parent:WaitForChild("WorldService") :: ModuleScript)
local Persistence = require(script.Parent:WaitForChild("PersistenceService") :: ModuleScript) :: any
local ProfileStore = require(script.Parent:WaitForChild("ProfileStore") :: ModuleScript)
local Journal = require(script.Parent:WaitForChild("MatchJournal") :: ModuleScript) :: any

type Bucket = Protocol.Bucket
type Souls = ProfileStore.Souls
type Attributes = ProfileStore.Attributes
type AttributeName = ProfileStore.AttributeName

export type Mode = "Ranked1v1" | "Casual1v1"
export type Phase = "Countdown" | "Fighting" | "Resolving"

export type RingDefinition = {
	Id: string,
	Name: string,
	Glyph: string,
	Region: string,
	Center: Vector3,
	Apothem: number,
	Band: number,
	Yaw: number,
}

type Ring = {
	Definition: RingDefinition,
	Model: Model?,
	Owned: boolean,
	Match: Match?,
	CooldownUntil: number,
	Directions: { Vector3 },
}

type Match = {
	Id: string,
	Ring: Ring,
	Mode: Mode,
	A: number,
	B: number,
	Names: { [number]: string },
	Profiles: { [number]: any },
	Phase: Phase,
	PhaseEnds: number,
	Winner: number?,
	Draw: boolean,
	Reason: string,
	Results: { [string]: any }?,
	Journaled: boolean,
	Busy: boolean,
	ReleaseAt: number,
}

type QueueEntry = {
	userId: number,
	mode: Mode,
	elo: number,
	enteredAt: number,
	ring: string,
}

type Challenge = {
	Id: string,
	From: number,
	To: number,
	Ring: string,
	Expires: number,
}

type Remainder = { Name: AttributeName, Fraction: number }

type Presence = {
	Ring: string?,
	Dismissed: string?,
	Ping: number,
	LastRoster: number,
}

local ColosseumService = {}

-------------------------------------------------------------------------------------------------
-- Tuning
-------------------------------------------------------------------------------------------------

local POLL_INTERVAL = 0.25
local ROSTER_INTERVAL = 2
local COUNTDOWN_SECONDS: number = Config.Match.CountdownSeconds
local FIGHT_SECONDS: number = Config.Match.RoundSeconds
local RESULT_HOLD = 3
local RING_COOLDOWN = 2
local CHALLENGE_SECONDS = 15
local DRAW_EPSILON = 0.01
local ESCAPE_MARGIN = 1.5
local FLOOR_TOP = 0.4
local ROOT_OFFSET = 3
local WALL_HEIGHT = 3.2
local BARRIER_HEIGHT = 34
local PILLAR_HEIGHT = 9
-- Ranked hit validation rewinds at most Lag.MAX_REWIND; a round trip beyond it would leave the
-- slower duelist's strikes judged against positions the server can no longer reconstruct.
local RANKED_ENTRY_PING: number = Lag.MAX_REWIND
local RANKED_DROP_PING: number = Lag.MAX_REWIND * 1.6
local PING_SMOOTHING = 0.2
-- Competitive baseline: every ranked fighter carries exactly this many points above base,
-- distributed in the proportions of their own build and clamped per attribute.
local RANKED_POINT_BUDGET = 60
local RANKED_ATTRIBUTE_CAP = 40
local ATTRIBUTE_BASE = 10
local ATTRIBUTE_ORDER: { AttributeName } = { "Vitality", "Qi", "Strength", "Dexterity" }

local INTENT_RATE = 3
local INTENT_BURST = 6
local INTENT_SHAPES: { [string]: { [string]: string } } = {
	Enqueue = { action = "string" },
	Dequeue = { action = "string" },
	Refresh = { action = "string" },
	Dismiss = { action = "string" },
	Challenge = { action = "string", target = "number" },
	Respond = { action = "string", challenge = "string", accept = "boolean" },
}
local LOCKED_HOOKS = { "Heal", "Rest", "Travel", "LevelUp", "Interact" }

local ASH = Color3.fromRGB(46, 40, 38)
local STONE = Color3.fromRGB(74, 68, 64)
local EMBER = Color3.fromRGB(232, 118, 46)
local CHAR = Color3.fromRGB(28, 22, 20)

local PROMENADE = World.Sanctuary.Promenade

local RING_DEFINITIONS: { RingDefinition } = {
	{
		Id = "Ring_SanctuaryPromenade",
		Name = "The Colosseum Promenade",
		Glyph = "昇",
		Region = "Sanctuary",
		Center = Vector3.new(PROMENADE.X, PROMENADE.Y, PROMENADE.Z),
		Apothem = 16,
		Band = 6,
		Yaw = 0,
	},
	{
		Id = "Ring_OctagonOfAsh",
		Name = "The Octagonal Ring of Ash",
		Glyph = "灰",
		Region = "AshColosseum",
		Center = Vector3.new(118, 0, -1770),
		Apothem = 20,
		Band = 7,
		Yaw = 0,
	},
	{
		Id = "Ring_GatehouseCircle",
		Name = "The Gatehouse Sparring Ring",
		Glyph = "武",
		Region = "DesecratedMonastery",
		Center = Vector3.new(-130, 0, -745),
		Apothem = 16,
		Band = 6,
		Yaw = 0,
	},
}

-------------------------------------------------------------------------------------------------
-- State
-------------------------------------------------------------------------------------------------

local rings: { [string]: Ring } = {}
local ringOrder: { Ring } = {}
local matches: { [string]: Match } = {}
local matchOf: { [number]: Match } = {}
local normalized: { [number]: boolean } = {}
local queue: { QueueEntry } = {}
local challenges: { [string]: Challenge } = {}
local outgoing: { [number]: string } = {}
local presence: { [number]: Presence } = {}
local budgets: { [number]: Bucket } = {}
local connections: { RBXScriptConnection } = {}
local baseHooks: Characters.Hooks? = nil
local colosseumFolder: Folder? = nil
local running = false
local closing = false
local pairing = false
local accumulator = 0

local net = Shared:WaitForChild("Net")
local remote = net:WaitForChild("ColosseumIntent") :: RemoteEvent

local journalBacking: { [string]: any } = {}
local journalStore: any = if Persistence.IsMock
	then {
		UpdateAsync = function(_self: any, key: string, transform: (any) -> any): any
			local value = transform(ProfileStore.Copy(journalBacking[key]))
			if value ~= nil then
				journalBacking[key] = ProfileStore.Copy(value)
			end
			return ProfileStore.Copy(value)
		end,
	}
	else game:GetService("DataStoreService"):GetDataStore("AsuraMatches_v1")
local journal: any = Journal.new(journalStore, function(fn: () -> any): (boolean, any)
	return Persistence.Engine:Retry(fn)
end, os.time)

-------------------------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------------------------

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function trace(problem: any): string
	return debug.traceback(tostring(problem), 2)
end

local function notify(userId: number, payload: { [string]: any })
	local player = Players:GetPlayerByUserId(userId)
	if player then
		remote:FireClient(player, payload)
	end
end

local function displayName(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	return if player then player.DisplayName else "Unknown"
end

local function presenceOf(userId: number): Presence
	local existing = presence[userId]
	if existing then
		return existing
	end
	local created: Presence = { Ring = nil, Dismissed = nil, Ping = 0, LastRoster = 0 }
	presence[userId] = created
	return created
end

local function soulsOf(userId: number): Souls?
	local profile = Persistence.Get(userId)
	return if profile then profile.souls else nil
end

-- Development (Studio) opens ranked by default; the Workspace attribute AsuraColosseumQA
-- overrides either way. Live servers stay behind the release gate.
local function developmentRanked(): boolean
	if not RunService:IsStudio() then
		return false
	end
	local override = Workspace:GetAttribute("AsuraColosseumQA")
	if type(override) == "boolean" then
		return override
	end
	return Settings.Colosseum.RankedInDevelopment == true
end

local function rankedOpen(): boolean
	return Protocol.QueueEnabled("Ranked1v1", Config.Features.Matchmaking == true, Config.Release.RankedIntegrationPassed == true, developmentRanked())
end

local function inQueue(userId: number): boolean
	for _, entry in queue do
		if entry.userId == userId then
			return true
		end
	end
	return false
end

local function dequeue(userId: number): boolean
	for index, entry in queue do
		if entry.userId == userId then
			table.remove(queue, index)
			return true
		end
	end
	return false
end

-- Octagonal distance: the largest projection onto the eight edge normals (equals the apothem
-- exactly on an edge), so the ring, its threshold and its interior share one metric.
local function octagonDistance(ring: Ring, position: Vector3): number
	local offset = position - ring.Definition.Center
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local best = 0
	for _, direction in ring.Directions do
		best = math.max(best, flat:Dot(direction))
	end
	return best
end

local function verticalOk(ring: Ring, position: Vector3): boolean
	return math.abs(position.Y - ring.Definition.Center.Y) <= 14
end

local function onThreshold(ring: Ring, position: Vector3): boolean
	local d = octagonDistance(ring, position)
	local definition = ring.Definition
	return verticalOk(ring, position) and d >= definition.Apothem + 0.5 and d <= definition.Apothem + 1.5 + definition.Band
end

local function insideRing(ring: Ring, position: Vector3): boolean
	return verticalOk(ring, position) and octagonDistance(ring, position) < ring.Definition.Apothem
end

local function ringFrame(ring: Ring): CFrame
	local definition = ring.Definition
	return CFrame.new(definition.Center) * CFrame.Angles(0, math.rad(definition.Yaw), 0)
end

-- Slot 1 stands on the ring's local +Z side, slot 2 on -Z; both face the centre.
local function duelSpawn(ring: Ring, slot: number): CFrame
	local frame = ringFrame(ring)
	local distance = ring.Definition.Apothem * 0.55
	local position = (frame * CFrame.new(0, FLOOR_TOP + ROOT_OFFSET, if slot == 1 then distance else -distance)).Position
	local centre = Vector3.new(frame.Position.X, position.Y, frame.Position.Z)
	return CFrame.lookAt(position, centre)
end

local function thresholdPoint(ring: Ring, slot: number): CFrame
	local frame = ringFrame(ring)
	local definition = ring.Definition
	local distance = definition.Apothem + 1 + definition.Band * 0.5
	local position = (frame * CFrame.new(if slot == 1 then 3 else -3, ROOT_OFFSET + 0.2, if slot == 1 then distance else -distance)).Position
	local centre = Vector3.new(frame.Position.X, position.Y, frame.Position.Z)
	return CFrame.lookAt(position, centre)
end

local function ringOfPlayer(userId: number): Ring?
	local e = Characters.GetEntity(userId)
	if not e then
		return nil
	end
	local position = e.Root.Position
	for _, ring in ringOrder do
		if onThreshold(ring, position) then
			return ring
		end
	end
	return nil
end

local function freeRing(preferred: string?): Ring?
	local clock = now()
	local first = if preferred then rings[preferred] else nil
	if first and first.Match == nil and clock >= first.CooldownUntil then
		return first
	end
	for _, ring in ringOrder do
		if ring.Match == nil and clock >= ring.CooldownUntil then
			return ring
		end
	end
	return nil
end

-- Whether a player may be pulled into a duel right now.
local function available(userId: number): (boolean, string?)
	if closing then
		return false, "ColosseumClosed"
	end
	local player = Players:GetPlayerByUserId(userId)
	if not player or not Persistence.Get(userId) or Persistence.Engine.busy[userId] then
		return false, "Unavailable"
	end
	if matchOf[userId] or Characters.IsInDuel(userId) then
		return false, "InDuel"
	end
	local e = Characters.GetEntity(userId)
	if not e or e.Respawning or e.Fighter.State == "KO" or e.Fighter.State == "DeathblowVictim" then
		return false, "Fallen"
	end
	if WorldService.IsInBossFight(userId) then
		return false, "InBossFight"
	end
	if AI.IsHunting(userId) then
		return false, "EnemiesNearby"
	end
	return true, nil
end

-------------------------------------------------------------------------------------------------
-- Stat normalisation
-------------------------------------------------------------------------------------------------

-- Redistributes a fixed point budget across the four attributes in the proportions the player
-- invested, clamped per attribute; an uninvested build is spread evenly. Largest-remainder
-- rounding keeps the total exact.
function ColosseumService.NormalizeAttributes(attributes: Attributes): Attributes
	local spent: { [AttributeName]: number } = {} :: any
	local total = 0
	for _, name in ATTRIBUTE_ORDER do
		local points = math.max((attributes[name] or ATTRIBUTE_BASE) - ATTRIBUTE_BASE, 0)
		spent[name] = points
		total += points
	end
	local headroom = RANKED_ATTRIBUTE_CAP - ATTRIBUTE_BASE
	local allocation: { [AttributeName]: number } = {} :: any
	local remainders: { Remainder } = {}
	local assigned = 0
	for _, name in ATTRIBUTE_ORDER do
		local share = if total > 0 then spent[name] / total else 1 / #ATTRIBUTE_ORDER
		local exact = math.min(RANKED_POINT_BUDGET * share, headroom)
		local whole = math.floor(exact)
		allocation[name] = whole
		assigned += whole
		table.insert(remainders, { Name = name, Fraction = exact - whole })
	end
	table.sort(remainders, function(a: Remainder, b: Remainder): boolean
		if a.Fraction ~= b.Fraction then
			return a.Fraction > b.Fraction
		end
		return (table.find(ATTRIBUTE_ORDER, a.Name) :: number) < (table.find(ATTRIBUTE_ORDER, b.Name) :: number)
	end)
	-- Hand out the remaining points; capped attributes overflow to the next in line.
	local guard = 0
	while assigned < RANKED_POINT_BUDGET and guard < 64 do
		guard += 1
		local granted = false
		for _, item in remainders do
			if assigned >= RANKED_POINT_BUDGET then
				break
			end
			if allocation[item.Name] < headroom then
				allocation[item.Name] += 1
				assigned += 1
				granted = true
			end
		end
		if not granted then
			break
		end
	end
	local result: Attributes = {} :: any
	for _, name in ATTRIBUTE_ORDER do
		result[name] = ATTRIBUTE_BASE + allocation[name]
	end
	return result
end

local function rankedStats(userId: number): any
	local record = soulsOf(userId)
	if not record then
		return nil
	end
	local view = table.clone(record) :: any
	view.attributes = ColosseumService.NormalizeAttributes(record.attributes)
	-- Blacksmith reinforcement is story progression too; ranked fighters carry unforged steel.
	view.inventory = table.clone(record.inventory)
	view.inventory.reinforcement = {}
	return ProfileStore.DeriveStats(view)
end

local function normalizedLevel(userId: number): number
	local record = soulsOf(userId)
	if not record then
		return 1
	end
	return ProfileStore.SoulLevel(ColosseumService.NormalizeAttributes(record.attributes))
end

-------------------------------------------------------------------------------------------------
-- Ranked durability (match journal + participant inbox)
-------------------------------------------------------------------------------------------------

-- Settles every pending ranked match recorded in the player's inbox. Yields.
function ColosseumService.Recover(userId: number): boolean
	local profile = Persistence.Get(userId)
	if not profile then
		return false
	end
	for matchId in profile.pendingMatches do
		if matches[matchId] then
			continue
		end
		local ok, record = journal:Read(matchId)
		if not ok or not record then
			return false
		end
		if record.state == "Active" then
			return false
		end
		if record.state == "Complete" then
			local result = record.results and record.results[tostring(userId)]
			if not result or not Persistence.ApplyResult(userId, matchId, result) then
				return false
			end
		elseif not Persistence.Transaction(userId, function(p: any)
			p.pendingMatches[matchId] = nil
		end) then
			return false
		end
	end
	return true
end

local function rankedResults(match: Match): { [string]: any }
	local first, second = match.Profiles[match.A], match.Profiles[match.B]
	local score = if match.Draw then 0.5 elseif match.Winner == match.A then 1 else 0
	local newA, newB = Rules.CalculateEloChange(first.elo, second.elo, score)
	local xp = Characters.GetMatchXp(match.Id)
	local results: { [string]: any } = {}
	for index, userId in { match.A, match.B } do
		local profile = if index == 1 then first else second
		local win = match.Winner == userId
		results[tostring(userId)] = {
			userId = userId,
			mode = "Ranked1v1",
			eloDelta = if index == 1 then newA - first.elo else newB - second.elo,
			cash = 135 + (if win then 150 elseif match.Draw then 50 else 0),
			outcome = if match.Draw then "Draw" elseif win then "Win" else "Loss",
			style = profile.activeStyle,
			xp = (if win then 150 elseif match.Draw then 75 else 50) + (xp[userId] or 0),
		}
	end
	return results
end

local function clearInbox(userId: number, matchId: string)
	if Persistence.Get(userId) then
		Persistence.Transaction(userId, function(p: any)
			p.pendingMatches[matchId] = nil
		end)
	end
end

-------------------------------------------------------------------------------------------------
-- Match lifecycle
-------------------------------------------------------------------------------------------------

local function broadcast(kind: string, match: Match, extra: { [string]: any }?)
	local payload: { [string]: any } = {
		ring = match.Ring.Definition.Id,
		name = match.Ring.Definition.Name,
		mode = match.Mode,
		a = match.A,
		b = match.B,
		an = match.Names[match.A],
		bn = match.Names[match.B],
		x = match.Ring.Definition.Center.X,
		z = match.Ring.Definition.Center.Z,
	}
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	Characters.Cue(kind, 0, payload)
end

local function conclude(match: Match, winner: number?, draw: boolean, reason: string)
	if match.Phase == "Resolving" then
		return
	end
	match.Phase = "Resolving"
	match.Winner = winner
	match.Draw = draw
	match.Reason = reason
	match.ReleaseAt = now() + RESULT_HOLD
	match.Results = if match.Mode == "Ranked1v1" and not closing then rankedResults(match) else nil
	broadcast("ColosseumResult", match, {
		winner = winner,
		draw = draw,
		reason = reason,
		wn = if winner then match.Names[winner] else nil,
	})
end

local function onDuelComplete(matchId: string, winner: number?, isDraw: boolean, _rounds: number, _xp: any)
	local match = matches[matchId]
	if match then
		conclude(match, winner, isDraw, "KO")
	end
end

local function decideOnTime(match: Match)
	local fa, fb = Characters.GetFighter(match.A), Characters.GetFighter(match.B)
	local ra = if fa then fa.ActiveHP / math.max(fa.MaxHP, 1) else 0
	local rb = if fb then fb.ActiveHP / math.max(fb.MaxHP, 1) else 0
	if math.abs(ra - rb) < DRAW_EPSILON then
		conclude(match, nil, true, "Time")
	else
		conclude(match, if ra > rb then match.A else match.B, false, "Time")
	end
end

local function cancelBeforeStart(id: string, mode: Mode, a: number, b: number)
	if mode == "Ranked1v1" then
		journal:Finish(id, nil)
		clearInbox(a, id)
		clearInbox(b, id)
	end
end

-- Seals two players into a ring. Yields while the ranked journal is written.
local function begin(ring: Ring, a: number, b: number, mode: Mode): (boolean, string?)
	if ring.Match then
		return false, "RingOccupied"
	end
	local id = HttpService:GenerateGUID(false)
	local match: Match = {
		Id = id,
		Ring = ring,
		Mode = mode,
		A = a,
		B = b,
		Names = { [a] = displayName(a), [b] = displayName(b) },
		Profiles = { [a] = Persistence.Get(a), [b] = Persistence.Get(b) },
		Phase = "Countdown",
		PhaseEnds = math.huge,
		Winner = nil,
		Draw = false,
		Reason = "",
		Results = nil,
		Journaled = false,
		Busy = false,
		ReleaseAt = math.huge,
	}
	-- Reserve the ring and both fighters before yielding so no second pairing can claim them.
	ring.Match = match
	matchOf[a] = match
	matchOf[b] = match
	local function abandon(reason: string): (boolean, string?)
		ring.Match = nil
		matchOf[a] = nil
		matchOf[b] = nil
		normalized[a] = nil
		normalized[b] = nil
		return false, reason
	end
	if not match.Profiles[a] or not match.Profiles[b] then
		return abandon("Unavailable")
	end
	if mode == "Ranked1v1" then
		local saved = journal:Create(id, { a, b }, game.JobId)
		if not saved then
			return abandon("JournalUnavailable")
		end
		for _, userId in { a, b } do
			local registered = Persistence.Transaction(userId, function(p: any)
				p.pendingMatches[id] = true
			end)
			if not registered then
				cancelBeforeStart(id, mode, a, b)
				return abandon("ProfileBusy")
			end
		end
		match.Journaled = true
	end
	-- Persistence yields: either fighter may have left, died or been pulled into a boss fight.
	for _, userId in { a, b } do
		local e = Characters.GetEntity(userId)
		if closing or not Players:GetPlayerByUserId(userId) or not e or e.Respawning or e.Fighter.State == "KO"
			or WorldService.IsInBossFight(userId) then
			cancelBeforeStart(id, mode, a, b)
			return abandon("Unavailable")
		end
	end
	if mode == "Ranked1v1" then
		normalized[a] = true
		normalized[b] = true
	end
	matches[id] = match
	local started = Characters.StartAllocatedMatch(id, a, b, mode, onDuelComplete, { duelSpawn(ring, 1), duelSpawn(ring, 2) })
	if not started then
		matches[id] = nil
		cancelBeforeStart(id, mode, a, b)
		return abandon("StartRefused")
	end
	for slot, userId in { a, b } do
		dequeue(userId)
		local pending = outgoing[userId]
		if pending then
			challenges[pending] = nil
			outgoing[userId] = nil
		end
		if mode == "Ranked1v1" then
			local stats = rankedStats(userId)
			if stats then
				Characters.ApplyStats(userId, stats, true)
			end
		end
		Characters.Cinematic(userId, COUNTDOWN_SECONDS)
		local player = Players:GetPlayerByUserId(userId)
		if player then
			player:SetAttribute("AsuraColosseum", ring.Definition.Id)
		end
		local opponent = if slot == 1 then b else a
		local profile = match.Profiles[opponent]
		notify(userId, {
			action = "MatchFound",
			matchId = id,
			ring = ring.Definition.Id,
			name = ring.Definition.Name,
			mode = mode,
			opponent = opponent,
			opponentName = match.Names[opponent],
			opponentElo = if mode == "Ranked1v1" and profile then profile.elo else nil,
			level = if mode == "Ranked1v1" then normalizedLevel(userId) else nil,
			starts = now() + COUNTDOWN_SECONDS,
			ends = now() + COUNTDOWN_SECONDS + FIGHT_SECONDS,
		})
	end
	match.PhaseEnds = now() + COUNTDOWN_SECONDS
	broadcast("ColosseumBegin", match, { starts = match.PhaseEnds })
	return true, nil
end

-- Releases a resolved match: journal, settle, restore story stats and return both to the threshold.
local function release(match: Match)
	if match.Busy then
		return
	end
	match.Busy = true
	local ok, problem = xpcall(function(): boolean
		local record: any = nil
		if match.Journaled then
			local saved, written = journal:Finish(match.Id, match.Results)
			if not saved then
				return false -- Retry on the next poll; never award before the journal commits.
			end
			record = written
			match.Journaled = false
		end
		if record and record.state == "Complete" then
			for _, userId in { match.A, match.B } do
				if Persistence.Get(userId) then
					local result = record.results[tostring(userId)]
					if result and not Persistence.ApplyResult(userId, match.Id, result) then
						warn("[Colosseum] Result for " .. userId .. " deferred to the durable inbox")
					end
				end
			end
		elseif record then
			clearInbox(match.A, match.Id)
			clearInbox(match.B, match.Id)
		end
		local ring = match.Ring
		local returns: { [number]: CFrame } = {
			[match.A] = thresholdPoint(ring, 1),
			[match.B] = thresholdPoint(ring, 2),
		}
		for _, userId in { match.A, match.B } do
			normalized[userId] = nil
			Characters.RefreshProgression(userId)
		end
		Characters.EndAllocatedMatch(match.Id, returns)
		matches[match.Id] = nil
		ring.Match = nil
		ring.CooldownUntil = now() + RING_COOLDOWN
		for _, userId in { match.A, match.B } do
			if matchOf[userId] == match then
				matchOf[userId] = nil
			end
			local result = if match.Results then match.Results[tostring(userId)] else nil
			local opponent = if userId == match.A then match.B else match.A
			notify(userId, {
				action = "MatchResult",
				matchId = match.Id,
				mode = match.Mode,
				outcome = if match.Draw then "Draw" elseif match.Winner == userId then "Win" elseif match.Winner == nil then "Cancelled" else "Loss",
				reason = match.Reason,
				opponentName = match.Names[opponent],
				eloDelta = if result then result.eloDelta else nil,
				profile = Persistence.PublicProfile(userId),
			})
			local p = presence[userId]
			if p then
				p.Ring = nil
				p.Dismissed = nil
			end
		end
		return true
	end, trace)
	match.Busy = false
	if not ok then
		warn("[Colosseum] Release failed: " .. tostring(problem))
	end
end

local function stepMatch(match: Match, clock: number)
	if match.Phase == "Countdown" then
		if clock >= match.PhaseEnds then
			match.Phase = "Fighting"
			match.PhaseEnds = clock + FIGHT_SECONDS
			broadcast("ColosseumFight", match, { ends = match.PhaseEnds })
			for _, userId in { match.A, match.B } do
				notify(userId, { action = "MatchState", phase = "Fighting", ends = match.PhaseEnds })
			end
		end
	elseif match.Phase == "Fighting" then
		if clock >= match.PhaseEnds then
			decideOnTime(match)
			return
		end
		-- Duelists that slip the barrier (lag, physics) are placed back on their mark.
		for slot, userId in { match.A, match.B } do
			local e = Characters.GetEntity(userId)
			if e and e.Fighter.State ~= "KO" then
				local position = e.Root.Position
				if octagonDistance(match.Ring, position) > match.Ring.Definition.Apothem + ESCAPE_MARGIN
					or position.Y < match.Ring.Definition.Center.Y - 8 then
					Characters.Teleport(userId, duelSpawn(match.Ring, slot))
				end
			end
		end
	end
	if match.Phase == "Resolving" and clock >= match.ReleaseAt and not match.Busy then
		task.spawn(release, match)
	end
end

-------------------------------------------------------------------------------------------------
-- Queue and challenges
-------------------------------------------------------------------------------------------------

local function queueStatus(userId: number, ok: boolean, err: string?)
	notify(userId, { action = "Queue", ok = ok, err = err, queued = inQueue(userId), rankedOpen = rankedOpen() })
end

local function enqueue(userId: number): (boolean, string?)
	if closing then
		return false, "ColosseumClosed"
	end
	if not rankedOpen() then
		return false, "RankedClosed"
	end
	local ring = ringOfPlayer(userId)
	if not ring then
		return false, "StepOnThreshold"
	end
	if inQueue(userId) then
		return false, "AlreadyQueued"
	end
	local ready, reason = available(userId)
	if not ready then
		return false, reason
	end
	if presenceOf(userId).Ping > RANKED_ENTRY_PING then
		return false, "HighLatency"
	end
	if not ColosseumService.Recover(userId) then
		return false, "RecoveryPending"
	end
	-- Recover yields: repeat occupancy checks before touching the queue.
	if inQueue(userId) or matchOf[userId] then
		return false, "AlreadyAssigned"
	end
	local profile = Persistence.Get(userId)
	if not profile or Persistence.Engine.busy[userId] then
		return false, "ProfileBusy"
	end
	table.insert(queue, { userId = userId, mode = "Ranked1v1" :: Mode, elo = profile.elo, enteredAt = os.clock(), ring = ring.Definition.Id })
	return true, nil
end

local function pairRanked()
	if pairing or closing or #queue < 2 then
		return
	end
	pairing = true
	local ok, problem = xpcall(function(): boolean
		for index = #queue, 1, -1 do
			local entry = queue[index]
			local userId = entry.userId
			if not Players:GetPlayerByUserId(userId) or not Persistence.Get(userId) then
				table.remove(queue, index)
			elseif presenceOf(userId).Ping > RANKED_DROP_PING then
				table.remove(queue, index)
				queueStatus(userId, false, "HighLatency")
			end
		end
		-- Only fighters who can be sealed right now take part in this pairing pass.
		local eligible: { QueueEntry } = {}
		for _, entry in queue do
			if available(entry.userId) then
				table.insert(eligible, entry)
			end
		end
		local first, second = Rules.FindMatch(eligible :: any, os.clock())
		if not first or not second then
			return false
		end
		local a, b = eligible[first], eligible[second]
		local ring = freeRing(a.ring) or freeRing(b.ring)
		if not ring then
			return false
		end
		local started, reason = begin(ring, a.userId, b.userId, "Ranked1v1" :: Mode)
		if not started then
			warn("[Colosseum] Ranked pairing refused: " .. tostring(reason))
		end
		return true
	end, trace)
	pairing = false
	if not ok then
		warn("[Colosseum] Pairing failed: " .. tostring(problem))
	end
end

local function challenge(from: number, target: number): (boolean, string?)
	if from == target then
		return false, "InvalidTarget"
	end
	local ring = ringOfPlayer(from)
	if not ring then
		return false, "StepOnThreshold"
	end
	local ready, reason = available(from)
	if not ready then
		return false, reason
	end
	local targetReady, targetReason = available(target)
	if not targetReady then
		return false, "Target" .. (targetReason or "Unavailable")
	end
	local previous = outgoing[from]
	if previous then
		local old = challenges[previous]
		challenges[previous] = nil
		if old then
			notify(old.To, { action = "ChallengeWithdrawn", challenge = previous })
		end
	end
	for _, existing in challenges do
		if existing.From == target and existing.To == from then
			return false, "AlreadyChallenged"
		end
	end
	local id = HttpService:GenerateGUID(false)
	local expires = now() + CHALLENGE_SECONDS
	challenges[id] = { Id = id, From = from, To = target, Ring = ring.Definition.Id, Expires = expires }
	outgoing[from] = id
	notify(target, {
		action = "Challenge",
		challenge = id,
		from = from,
		fromName = displayName(from),
		ring = ring.Definition.Id,
		name = ring.Definition.Name,
		expires = expires,
	})
	return true, nil
end

local function respond(userId: number, id: string, accept: boolean)
	local pending = challenges[id]
	if not pending or pending.To ~= userId then
		notify(userId, { action = "ChallengeResult", ok = false, err = "ChallengeExpired" })
		return
	end
	challenges[id] = nil
	if outgoing[pending.From] == id then
		outgoing[pending.From] = nil
	end
	if not accept then
		notify(pending.From, { action = "ChallengeResult", ok = false, err = "ChallengeDeclined", name = displayName(userId) })
		return
	end
	if now() > pending.Expires then
		notify(userId, { action = "ChallengeResult", ok = false, err = "ChallengeExpired" })
		return
	end
	local fromReady, fromReason = available(pending.From)
	local toReady, toReason = available(userId)
	if not fromReady or not toReady then
		local err = if not fromReady then "Target" .. (fromReason or "Unavailable") else toReason
		notify(userId, { action = "ChallengeResult", ok = false, err = err })
		notify(pending.From, { action = "ChallengeResult", ok = false, err = if not toReady then "Target" .. (toReason or "Unavailable") else fromReason })
		return
	end
	local ring = freeRing(pending.Ring)
	if not ring then
		notify(userId, { action = "ChallengeResult", ok = false, err = "RingsOccupied" })
		notify(pending.From, { action = "ChallengeResult", ok = false, err = "RingsOccupied" })
		return
	end
	local started, reason = begin(ring, pending.From, userId, "Casual1v1" :: Mode)
	if not started then
		notify(userId, { action = "ChallengeResult", ok = false, err = reason })
		notify(pending.From, { action = "ChallengeResult", ok = false, err = reason })
	end
end

local function roster(userId: number): { any }
	local list: { any } = {}
	for _, player in Players:GetPlayers() do
		local other = player.UserId
		if other ~= userId and Persistence.Get(other) then
			local record = soulsOf(other)
			local ready, reason = available(other)
			table.insert(list, {
				id = other :: any,
				name = player.DisplayName,
				level = if record then record.level else 1,
				status = if ready then "Ready" else (reason or "Unavailable"),
			})
		end
	end
	table.sort(list, function(x: any, y: any): boolean
		if (x.status == "Ready") ~= (y.status == "Ready") then
			return x.status == "Ready"
		end
		return tostring(x.name) < tostring(y.name)
	end)
	return list
end

local function sendPanel(userId: number, ring: Ring, action: string)
	local profile = Persistence.Get(userId)
	local p = presenceOf(userId)
	p.LastRoster = os.clock()
	notify(userId, {
		action = action,
		ring = ring.Definition.Id,
		name = ring.Definition.Name,
		glyph = ring.Definition.Glyph,
		rankedOpen = rankedOpen(),
		queued = inQueue(userId),
		elo = if profile then profile.elo else nil,
		ping = math.floor(p.Ping * 1000 + 0.5),
		pingLimit = math.floor(RANKED_ENTRY_PING * 1000 + 0.5),
		level = normalizedLevel(userId),
		players = roster(userId),
		occupied = ring.Match ~= nil,
	})
end

-------------------------------------------------------------------------------------------------
-- Intents
-------------------------------------------------------------------------------------------------

local function validIntent(payload: any): boolean
	if type(payload) ~= "table" or type(payload.action) ~= "string" then
		return false
	end
	local shape = INTENT_SHAPES[payload.action]
	if not shape then
		return false
	end
	local count = 0
	for key, value in payload do
		count += 1
		if type(key) ~= "string" or shape[key] == nil or type(value) ~= shape[key] then
			return false
		end
	end
	local expected = 0
	for _ in shape do
		expected += 1
	end
	if count ~= expected then
		return false
	end
	if payload.action == "Challenge" then
		return payload.target == payload.target and payload.target % 1 == 0 and math.abs(payload.target) < 2 ^ 53
	elseif payload.action == "Respond" then
		return #payload.challenge <= 40 and string.match(payload.challenge, "^[%x%-]+$") ~= nil
	end
	return true
end

local function onIntent(player: Player, payload: any)
	if not running or not validIntent(payload) then
		return
	end
	local userId = player.UserId
	local clock = os.clock()
	local budget = budgets[userId]
	if not budget then
		budget = { tokens = INTENT_BURST, time = clock }
		budgets[userId] = budget
	end
	if not Protocol.Take(budget, clock, 1, INTENT_RATE, INTENT_BURST) then
		return
	end
	local action: string = payload.action
	if action == "Enqueue" then
		task.spawn(function()
			local ok, err = enqueue(userId)
			queueStatus(userId, ok, err)
		end)
	elseif action == "Dequeue" then
		dequeue(userId)
		queueStatus(userId, true, nil)
	elseif action == "Refresh" then
		local ring = ringOfPlayer(userId)
		if ring then
			sendPanel(userId, ring, "Roster")
		end
	elseif action == "Dismiss" then
		local p = presenceOf(userId)
		p.Dismissed = p.Ring
	elseif action == "Challenge" then
		local ok, err = challenge(userId, payload.target)
		notify(userId, { action = "ChallengeResult", ok = ok, err = err, sent = ok, name = displayName(payload.target) })
	elseif action == "Respond" then
		task.spawn(respond, userId, payload.challenge, payload.accept)
	end
end

-------------------------------------------------------------------------------------------------
-- Ring geometry
-------------------------------------------------------------------------------------------------

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, geometry: boolean): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	if geometry then
		pcall(function()
			p.CollisionGroup = "WorldGeometry"
		end)
	end
	p.Parent = parent
	return p
end

local function buildRing(ring: Ring, parent: Folder): Model
	local definition = ring.Definition
	local frame = ringFrame(ring)
	local model = Instance.new("Model")
	model.Name = definition.Id
	model:SetAttribute("AsuraColosseum", definition.Name)
	local apothem = definition.Apothem
	local outer = apothem + 1 + definition.Band
	local edge = 2 * math.tan(math.rad(22.5))

	-- Two squares rotated 45° share an apothem and union into a regular octagon.
	for index = 0, 1 do
		local yaw = CFrame.Angles(0, math.rad(45 * index), 0)
		part(model, "Threshold" .. index, Vector3.new(outer * 2, 0.4, outer * 2), frame * yaw * CFrame.new(0, 0.0, 0), STONE, Enum.Material.Slate, true)
		part(model, "Floor" .. index, Vector3.new(apothem * 2, 0.8, apothem * 2), frame * yaw * CFrame.new(0, 0, 0), ASH, Enum.Material.Basalt, true)
	end
	local sigil = part(model, "Sigil", Vector3.new(0.05, apothem * 1.1, apothem * 1.1), frame * CFrame.new(0, FLOOR_TOP + 0.03, 0) * CFrame.Angles(0, 0, math.rad(90)), CHAR, Enum.Material.Slate, false)
	sigil.Shape = Enum.PartType.Cylinder
	sigil.CanCollide = false
	sigil.CanQuery = false
	local inner = part(model, "SigilCore", Vector3.new(0.06, apothem * 0.35, apothem * 0.35), frame * CFrame.new(0, FLOOR_TOP + 0.04, 0) * CFrame.Angles(0, 0, math.rad(90)), EMBER, Enum.Material.Neon, false)
	inner.Shape = Enum.PartType.Cylinder
	inner.CanCollide = false
	inner.CanQuery = false
	inner.Transparency = 0.55

	for k = 0, 7 do
		local yaw = frame * CFrame.Angles(0, math.rad(45 * k), 0)
		local length = apothem * edge
		part(model, "Wall" .. k, Vector3.new(length + 0.9, WALL_HEIGHT, 1), yaw * CFrame.new(0, FLOOR_TOP + WALL_HEIGHT * 0.5, -apothem - 0.5), STONE, Enum.Material.Slate, true)
		local glow = part(model, "Ember" .. k, Vector3.new(length * 0.9, 0.12, 0.6), yaw * CFrame.new(0, 0.22, -(apothem + 1 + definition.Band * 0.5)), EMBER, Enum.Material.Neon, false)
		glow.CanCollide = false
		glow.CanQuery = false
		glow.Transparency = 0.35
		local barrier = part(model, "Barrier" .. k, Vector3.new(length + 1.2, BARRIER_HEIGHT, 1), yaw * CFrame.new(0, FLOOR_TOP + BARRIER_HEIGHT * 0.5, -apothem - 0.5), CHAR, Enum.Material.SmoothPlastic, false)
		barrier.Transparency = 1
		barrier.CanQuery = false
		barrier.CastShadow = false

		local vertex = frame * CFrame.Angles(0, math.rad(45 * k + 22.5), 0) * CFrame.new(0, 0, -(apothem / math.cos(math.rad(22.5)) + 0.6))
		local pillar = part(model, "Pillar" .. k, Vector3.new(1.6, PILLAR_HEIGHT, 1.6), vertex * CFrame.new(0, FLOOR_TOP + PILLAR_HEIGHT * 0.5, 0), CHAR, Enum.Material.Basalt, true)
		local brazier = part(model, "Brazier" .. k, Vector3.new(1.2, 0.8, 1.2), pillar.CFrame * CFrame.new(0, PILLAR_HEIGHT * 0.5 + 0.4, 0), EMBER, Enum.Material.Neon, false)
		brazier.CanCollide = false
		brazier.CanQuery = false
		local light = Instance.new("PointLight")
		light.Color = EMBER
		light.Range = 18
		light.Brightness = 1.4
		light.Shadows = k % 2 == 0
		light.Parent = brazier
	end

	local signPost = part(model, "Sign", Vector3.new(1, 1, 1), frame * CFrame.new(0, FLOOR_TOP + PILLAR_HEIGHT + 3, 0), CHAR, Enum.Material.SmoothPlastic, false)
	signPost.Transparency = 1
	signPost.CanCollide = false
	signPost.CanQuery = false
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(420, 90)
	billboard.MaxDistance = 140
	billboard.LightInfluence = 0
	billboard.Parent = signPost
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0.62, 0)
	title.Font = Enum.Font.Antique
	title.TextScaled = true
	title.Text = definition.Glyph .. "  " .. string.upper(definition.Name)
	title.TextColor3 = Color3.fromRGB(236, 226, 206)
	title.TextStrokeTransparency = 0.4
	title.Parent = billboard
	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.Position = UDim2.fromScale(0, 0.62)
	hint.Size = UDim2.new(1, 0, 0.38, 0)
	hint.Font = Enum.Font.Garamond
	hint.TextScaled = true
	hint.Text = "Step upon the ember threshold to duel"
	hint.TextColor3 = EMBER
	hint.TextStrokeTransparency = 0.5
	hint.Parent = billboard

	model.PrimaryPart = model:FindFirstChild("Floor0") :: BasePart
	model.Parent = parent
	return model
end

local function validateDefinitions()
	local seen: { [string]: boolean } = {}
	for _, definition in RING_DEFINITIONS do
		assert(not seen[definition.Id], "Duplicate Colosseum ring " .. definition.Id)
		seen[definition.Id] = true
		local region = World.Regions[definition.Region :: any]
		assert(region, "Unknown Colosseum region " .. definition.Region)
		local reach = (definition.Apothem + 1 + definition.Band) / math.cos(math.rad(22.5))
		for _, corner in { Vector3.new(reach, 0, reach), Vector3.new(-reach, 0, reach), Vector3.new(reach, 0, -reach), Vector3.new(-reach, 0, -reach) } do
			local point = definition.Center + corner
			assert(World.contains(region.Bounds, point.X, point.Y, point.Z), "Colosseum ring leaves its region: " .. definition.Id)
		end
		for _, altar in World.Altars do
			local p = altar.Placement
			assert((Vector3.new(p.X, p.Y, p.Z) - definition.Center).Magnitude > reach + altar.Radius + 4, "Colosseum ring overlaps altar " .. altar.Id)
		end
		for _, entry in World.Spawns do
			local p = entry.Placement
			assert((Vector3.new(p.X, 0, p.Z) - definition.Center).Magnitude > reach + 12, "Colosseum ring overlaps spawn " .. entry.Id)
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Poll
-------------------------------------------------------------------------------------------------

local function poll()
	local clock = now()
	for _, match in matches do
		stepMatch(match, clock)
	end
	for id, pending in challenges do
		if clock > pending.Expires then
			challenges[id] = nil
			if outgoing[pending.From] == id then
				outgoing[pending.From] = nil
			end
			notify(pending.From, { action = "ChallengeResult", ok = false, err = "ChallengeExpired", name = displayName(pending.To) })
			notify(pending.To, { action = "ChallengeWithdrawn", challenge = id })
		end
	end
	local wall = os.clock()
	for _, player in Players:GetPlayers() do
		local userId = player.UserId
		local p = presenceOf(userId)
		local okPing, sample = pcall(function()
			return player:GetNetworkPing()
		end)
		if okPing and type(sample) == "number" then
			p.Ping = if p.Ping <= 0 then sample else p.Ping + (sample - p.Ping) * PING_SMOOTHING
		end
		local match = matchOf[userId]
		if match then
			continue
		end
		-- Clear the Colosseum flag once a returned duelist is standing again.
		if player:GetAttribute("AsuraColosseum") ~= nil then
			local e = Characters.GetEntity(userId)
			if e and e.Fighter.State ~= "KO" and not e.Respawning and not Characters.IsInDuel(userId) then
				player:SetAttribute("AsuraColosseum", nil)
			end
		end
		local e = Characters.GetEntity(userId)
		local position = if e then e.Root.Position else nil
		-- Nobody outside a match stands inside a sealed ring.
		if position and e and e.Fighter.State ~= "KO" then
			for _, ring in ringOrder do
				if insideRing(ring, position) then
					Characters.Teleport(userId, thresholdPoint(ring, if (position - ring.Definition.Center):Dot(ringFrame(ring).LookVector) < 0 then 1 else 2))
					position = nil
					break
				end
			end
		end
		local current: Ring? = nil
		if position then
			for _, ring in ringOrder do
				if onThreshold(ring, position) then
					current = ring
					break
				end
			end
		end
		local currentId = if current then current.Definition.Id else nil
		if currentId ~= p.Ring then
			p.Ring = currentId
			if current then
				if p.Dismissed ~= currentId then
					sendPanel(userId, current, "Open")
				end
			else
				p.Dismissed = nil
				notify(userId, { action = "Close" })
			end
		elseif current and p.Dismissed ~= currentId and wall - p.LastRoster >= ROSTER_INTERVAL then
			sendPanel(userId, current, "Roster")
		end
	end
	if not pairing and #queue >= 2 then
		task.spawn(pairRanked)
	end
end

-------------------------------------------------------------------------------------------------
-- Hooks: duel rules layered over the story-mode world hooks
-------------------------------------------------------------------------------------------------

local function invoke(fn: any, ...: any): ...any
	return fn(...)
end

local function installHooks()
	local base = Characters.GetHooks() :: any
	baseHooks = base
	local wrapped = table.clone(base) :: any
	local baseStats: any = base.Stats
	wrapped.Stats = function(userId: number): any
		if normalized[userId] then
			return rankedStats(userId)
		end
		return if baseStats ~= nil then invoke(baseStats, userId) else nil
	end
	local baseEquip: any = base.CanEquip
	wrapped.CanEquip = function(userId: number, weapon: string): boolean
		local match = matchOf[userId]
		if match and match.Mode == "Ranked1v1" then
			return false
		end
		return if baseEquip ~= nil then invoke(baseEquip, userId, weapon) == true else true
	end
	local baseSwap: any = base.Swap
	wrapped.Swap = function(userId: number): (boolean, string)
		local match = matchOf[userId]
		if match and match.Mode == "Ranked1v1" then
			return false, "InColosseum"
		end
		if baseSwap ~= nil then
			return invoke(baseSwap, userId)
		end
		return false, "Unavailable"
	end
	for _, name in LOCKED_HOOKS do
		local original: any = base[name]
		wrapped[name] = function(userId: number, ...: any): (boolean, string)
			if matchOf[userId] then
				return false, "InColosseum"
			end
			if original ~= nil then
				return invoke(original, userId, ...)
			end
			return false, "Unavailable"
		end
	end
	Characters.SetHooks(wrapped)
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function ColosseumService.Start()
	assert(not running, "ColosseumService already started")
	validateDefinitions()
	running = true
	closing = false
	local root = Workspace:FindFirstChild(Config.Names.Root)
	if not root then
		root = Instance.new("Folder")
		root.Name = Config.Names.Root
		root.Parent = Workspace
	end
	local container = (root :: Instance):FindFirstChild("Colosseums")
	local owned = false
	if not container then
		container = Instance.new("Folder")
		container.Name = "Colosseums"
		container.Parent = root
		owned = true
	end
	colosseumFolder = if owned then container :: Folder else nil
	for _, definition in RING_DEFINITIONS do
		local directions: { Vector3 } = {}
		for k = 0, 7 do
			local look = (CFrame.Angles(0, math.rad(definition.Yaw + 45 * k), 0)).LookVector
			table.insert(directions, -Vector3.new(look.X, 0, look.Z).Unit)
		end
		local ring: Ring = {
			Definition = definition,
			Model = nil,
			Owned = false,
			Match = nil,
			CooldownUntil = 0,
			Directions = directions,
		}
		-- An authored model with the ring's id replaces the procedural build.
		local authored = Workspace:FindFirstChild(definition.Id, true)
		if authored and authored:IsA("Model") then
			ring.Model = authored
		else
			ring.Model = buildRing(ring, container :: Folder)
			ring.Owned = true
		end
		rings[definition.Id] = ring
		table.insert(ringOrder, ring)
	end
	installHooks()
	table.insert(connections, remote.OnServerEvent:Connect(onIntent))
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator >= POLL_INTERVAL then
			accumulator = 0
			local ok, problem = pcall(poll)
			if not ok then
				warn("[Colosseum] Poll failed: " .. tostring(problem))
			end
		end
	end))
end

-- Forfeits any match the leaving player is part of and withdraws their queue and challenges.
function ColosseumService.Disconnect(userId: number)
	dequeue(userId)
	local pending = outgoing[userId]
	if pending then
		local old = challenges[pending]
		challenges[pending] = nil
		if old then
			notify(old.To, { action = "ChallengeWithdrawn", challenge = pending })
		end
		outgoing[userId] = nil
	end
	for id, entry in challenges do
		if entry.To == userId then
			challenges[id] = nil
			if outgoing[entry.From] == id then
				outgoing[entry.From] = nil
			end
			notify(entry.From, { action = "ChallengeResult", ok = false, err = "TargetUnavailable", name = displayName(userId) })
		end
	end
	local match = matchOf[userId]
	if match and match.Phase ~= "Resolving" then
		conclude(match, if match.A == userId then match.B else match.A, false, "Forfeit")
		match.ReleaseAt = now()
	end
	presence[userId] = nil
	budgets[userId] = nil
end

function ColosseumService.IsInMatch(userId: number): boolean
	return matchOf[userId] ~= nil
end

function ColosseumService.CanEquip(userId: number): boolean
	return matchOf[userId] == nil and not inQueue(userId)
end

function ColosseumService.RankedOpen(): boolean
	return rankedOpen()
end

function ColosseumService.GetRings(): { RingDefinition }
	return RING_DEFINITIONS
end

-- Shutdown: cancels every unfinished match (ranked journals close as Cancelled, so no ELO moves)
-- and releases fighters before persistence closes.
function ColosseumService.Close(deadline: number?)
	closing = true
	table.clear(queue)
	table.clear(challenges)
	table.clear(outgoing)
	for _, match in matches do
		if match.Phase ~= "Resolving" then
			conclude(match, nil, false, "Shutdown")
		end
		match.Results = nil
		match.ReleaseAt = 0
	end
	local limit = math.min(deadline or math.huge, os.clock() + 10)
	while next(matches) ~= nil and os.clock() < limit do
		for _, match in matches do
			if not match.Busy then
				task.spawn(release, match)
			end
		end
		task.wait(0.1)
	end
end

function ColosseumService.Destroy()
	running = false
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for id, match in matches do
		Characters.EndAllocatedMatch(id, nil)
		for _, userId in { match.A, match.B } do
			normalized[userId] = nil
			matchOf[userId] = nil
		end
	end
	table.clear(matches)
	local base = baseHooks
	if base then
		Characters.SetHooks(base)
		baseHooks = nil
	end
	for _, ring in ringOrder do
		if ring.Owned and ring.Model then
			ring.Model:Destroy()
		end
	end
	if colosseumFolder then
		colosseumFolder:Destroy()
		colosseumFolder = nil
	end
	table.clear(rings)
	table.clear(ringOrder)
	table.clear(queue)
	table.clear(challenges)
	table.clear(outgoing)
	table.clear(presence)
	table.clear(budgets)
end

return ColosseumService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">EnvironmentService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/EnvironmentService
-- Applies Config.Lighting at runtime so the place file and the live server always agree: the
-- Overcast sanctuary sun, colour shift, Atmosphere, SunRays, Bloom, colour correction and
-- depth of field. Effects are created by name if missing and updated in place if present.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("AsurasPath"):WaitForChild("Config") :: ModuleScript) :: any

local Environment = {}

local function color(rgb: { number }): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function effect(name: string, className: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing then
		assert(existing.ClassName == className, "Unexpected class at Lighting/" .. name)
		return existing
	end
	local created = Instance.new(className :: any)
	created.Name = name
	created.Parent = Lighting
	return created
end

function Environment.Apply()
	local l = Config.Lighting
	Workspace.Gravity = Config.Workspace.Gravity
	local wind = Config.Workspace.GlobalWind
	Workspace.GlobalWind = Vector3.new(wind[1], wind[2], wind[3])

	Lighting.Brightness = l.Brightness
	Lighting.ClockTime = l.ClockTime
	Lighting.GeographicLatitude = l.GeographicLatitude
	Lighting.Ambient = color(l.Ambient)
	Lighting.OutdoorAmbient = color(l.OutdoorAmbient)
	Lighting.ColorShift_Top = color(l.ColorShiftTop)
	Lighting.ColorShift_Bottom = color(l.ColorShiftBottom)
	Lighting.EnvironmentDiffuseScale = l.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = l.EnvironmentSpecularScale
	Lighting.GlobalShadows = l.GlobalShadows
	Lighting.ShadowSoftness = l.ShadowSoftness
	Lighting.ExposureCompensation = l.ExposureCompensation
	Lighting.FogColor = color(l.FogColor)
	Lighting.FogStart = l.FogStart
	Lighting.FogEnd = l.FogEnd
	-- Technology and quality are baked into the place; Studio restricts writing them at runtime.
	if Lighting.LightingStyle ~= Enum.LightingStyle.Realistic or Lighting.PrioritizeLightingQuality ~= l.PrioritizeLightingQuality then
		warn("[AsurasPath] In Studio set LightingStyle=Realistic and PrioritizeLightingQuality=true.")
	end
	if Workspace.StreamingEnabled ~= Config.Workspace.StreamingEnabled then
		warn("[AsurasPath] In Studio set Workspace.StreamingEnabled to the Config value.")
	end
	if Workspace.FallenPartsDestroyHeight ~= Config.Workspace.FallenPartsDestroyHeight then
		warn("[AsurasPath] In Studio set Workspace.FallenPartsDestroyHeight to the Config value.")
	end

	local cc = effect("CB_ColorCorrection", "ColorCorrectionEffect") :: ColorCorrectionEffect
	cc.Enabled = l.ColorCorrection.Enabled
	cc.Brightness = l.ColorCorrection.Brightness
	cc.Contrast = l.ColorCorrection.Contrast
	cc.Saturation = l.ColorCorrection.Saturation
	cc.TintColor = color(l.ColorCorrection.TintColor)

	local bloom = effect("CB_Bloom", "BloomEffect") :: BloomEffect
	bloom.Enabled = l.Bloom.Enabled
	bloom.Intensity = l.Bloom.Intensity
	bloom.Size = l.Bloom.Size
	bloom.Threshold = l.Bloom.Threshold

	local dof = effect("CB_DepthOfField", "DepthOfFieldEffect") :: DepthOfFieldEffect
	dof.Enabled = l.DepthOfField.Enabled
	dof.FarIntensity = l.DepthOfField.FarIntensity
	dof.NearIntensity = l.DepthOfField.NearIntensity
	dof.FocusDistance = l.DepthOfField.FocusDistance
	dof.InFocusRadius = l.DepthOfField.InFocusRadius

	local atmosphere = effect("CB_Atmosphere", "Atmosphere") :: Atmosphere
	atmosphere.Density = l.Atmosphere.Density
	atmosphere.Offset = l.Atmosphere.Offset
	atmosphere.Haze = l.Atmosphere.Haze
	atmosphere.Glare = l.Atmosphere.Glare
	atmosphere.Color = color(l.Atmosphere.Color)
	atmosphere.Decay = color(l.Atmosphere.Decay)

	local rays = effect("CB_SunRays", "SunRaysEffect") :: SunRaysEffect
	rays.Enabled = l.SunRays.Enabled
	rays.Intensity = l.SunRays.Intensity
	rays.Spread = l.SunRays.Spread

	-- Only one Atmosphere renders; a second authored one would fight the configured sky.
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") and child ~= atmosphere then
			warn("[AsurasPath] Extra Atmosphere in Lighting overrides the configured sky: " .. child.Name)
		end
	end
end

return table.freeze(Environment)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">FighterAppearance</string>
            <string name="Source"><![CDATA[--!strict
-- Server-authored wanderer silhouette. Uses local geometry and materials only; combat rigs,
-- joints and movement animations remain owned by the character system.
local Appearance = {}

local CLOTH = Color3.fromRGB(32, 39, 41)
local HEM = Color3.fromRGB(45, 51, 49)
local WRAP = Color3.fromRGB(96, 94, 80)
local SKIN = Color3.fromRGB(137, 116, 94)
local SASH = Color3.fromRGB(88, 35, 33)
local STRAW = Color3.fromRGB(85, 76, 54)

local function gear(parent: Instance, limb: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, cylinder: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	if cylinder then p.Shape = Enum.PartType.Cylinder end
	p.CFrame = limb.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = limb
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent
	return p
end

local function imported(item: Instance): boolean
	return item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants")
		or item:IsA("ShirtGraphic") or item:IsA("BodyColors")
end

local function colorBody(model: Model)
	for _, item in model:GetChildren() do
		if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" and item.Name ~= "AsuraWeapon" then
			local skin = item.Name == "Head" or string.find(item.Name, "Hand") ~= nil
			item.Color = if skin then SKIN else CLOTH
			item.Material = if skin then Enum.Material.SmoothPlastic else Enum.Material.Fabric
			if item:IsA("MeshPart") then item.TextureID = "" end
			for _, child in item:GetChildren() do
				if child:IsA("Decal") or child:IsA("SurfaceAppearance") then child:Destroy() end
			end
		end
	end
end

function Appearance.Apply(model: Model, connections: { RBXScriptConnection })
	-- Account accessories can arrive after CharacterAdded; remove them only from this game rig.
	for _, child in model:GetChildren() do
		if imported(child) then child:Destroy() end
	end
	colorBody(model)
	local existing = model:FindFirstChild("AsuraAttire")
	if existing and #existing:GetChildren() > 0 then return end
	if existing then existing:Destroy() end
	table.insert(connections, model.ChildAdded:Connect(function(child)
		if imported(child) then
			task.defer(function()
				if child.Parent == model then child:Destroy() end
				if model.Parent then colorBody(model) end
			end)
		end
	end))
	local head = model:FindFirstChild("Head")
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	local waist = model:FindFirstChild("LowerTorso") or torso
	if not head or not head:IsA("BasePart") or not torso or not torso:IsA("BasePart")
		or not waist or not waist:IsA("BasePart") then return end
	local outfit = Instance.new("Folder")
	outfit.Name = "AsuraAttire"
	outfit.Parent = model
	-- Closely spaced round courses read as the weave of a low travelling hat.
	for tier = 0, 13 do
		local radius = 1.48 * (1-tier/15)
		gear(outfit, head, "WovenHat", Vector3.new(0.065, radius*2, radius*2),
			CFrame.new(0, head.Size.Y*0.4+tier*0.048, 0)*CFrame.Angles(0,0,math.pi*0.5),
			if tier%3==0 then STRAW else STRAW:Lerp(CLOTH,0.15), Enum.Material.Wood, true)
	end
	gear(outfit, head, "ShadowedFaceWrap", Vector3.new(head.Size.X*0.92,head.Size.Y*0.36,0.12),
		CFrame.new(0,-head.Size.Y*0.18,-head.Size.Z*0.5),CLOTH,Enum.Material.Fabric)
	gear(outfit, torso, "CrossedLapel", Vector3.new(0.18,torso.Size.Y*1.05,0.1),
		CFrame.new(-0.15,0,-torso.Size.Z*0.5-0.06)*CFrame.Angles(0,0,math.rad(-28)),WRAP,Enum.Material.Fabric)
	gear(outfit, waist, "OxBloodSash", Vector3.new(waist.Size.X+0.15,0.32,waist.Size.Z+0.14),
		CFrame.new(0,0,0),SASH,Enum.Material.Fabric)
	gear(outfit, waist, "SashKnot", Vector3.new(0.32,0.4,0.2),
		CFrame.new(-waist.Size.X*0.3,-0.08,-waist.Size.Z*0.5-0.12),WRAP,Enum.Material.Fabric)
	for side=-1,1,2 do
		gear(outfit, waist, "SplitRobeBack", Vector3.new(waist.Size.X*0.49,1.3,0.12),
			CFrame.new(side*waist.Size.X*0.27,-0.72,waist.Size.Z*0.5+0.08)*CFrame.Angles(math.rad(-8),0,side*math.rad(5)),HEM,Enum.Material.Fabric)
		gear(outfit, waist, "SplitRobeFront", Vector3.new(waist.Size.X*0.4,0.95,0.12),
			CFrame.new(side*waist.Size.X*0.3,-0.58,-waist.Size.Z*0.5-0.08)*CFrame.Angles(math.rad(8),0,side*math.rad(-7)),CLOTH,Enum.Material.Fabric)
	end
	for _, name in {"LeftLowerArm", "RightLowerArm"} do
		local arm = model:FindFirstChild(name)
		if arm and arm:IsA("BasePart") then
			gear(outfit, arm, "LinenBracer", arm.Size+Vector3.new(0.07,-0.15,0.07),CFrame.new(),WRAP,Enum.Material.Fabric)
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
end

return table.freeze(Appearance)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">LagCompensation</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/LagCompensation
-- 60 Hz pose history per entity and continuous weapon-vs-hurtbox queries against rewound poses.
-- Ring slots are allocated once; recording overwrites in place and sampling returns multiple values.

export type Capsule = { Region: string, A: Vector3, B: Vector3, Radius: number }
export type Profile = { Capsules: { Capsule }, BoxOffset: CFrame, BoxHalfSize: Vector3, Reach: number }

export type History = {
	Capacity: number,
	Head: number,
	Count: number,
	Times: { number },
	CFrames: { CFrame },
	Velocities: { Vector3 },
	WeaponA: { Vector3 },
	WeaponB: { Vector3 },
	WeaponRadius: { number },
	Profile: Profile,
}

export type Hit = { Region: string, Point: Vector3, Fraction: number, Distance: number }

local LagCompensation = {}

LagCompensation.TICK_RATE = 60
LagCompensation.TICK = 1 / 60
LagCompensation.HISTORY_FRAMES = 30
LagCompensation.MAX_REWIND = 0.15
LagCompensation.INTERPOLATION_DELAY = 1 / 30
LagCompensation.MAX_SWEEP_STEPS = 12

local EPSILON = 1e-9
local ZERO = Vector3.zero
local GOLDEN = (math.sqrt(5) - 1) / 2

-- Root-part-relative capsules for a standard R15 humanoid (HumanoidRootPart at the hip line).
LagCompensation.HumanoidProfile = table.freeze({
	Capsules = table.freeze({
		table.freeze({ Region = "Head", A = Vector3.new(0, 1.55, 0), B = Vector3.new(0, 2.05, 0), Radius = 0.6 }),
		table.freeze({ Region = "Torso", A = Vector3.new(0, -0.15, 0), B = Vector3.new(0, 1.05, 0), Radius = 0.95 }),
		table.freeze({ Region = "LeftArm", A = Vector3.new(-1.5, 1.05, 0), B = Vector3.new(-1.5, -0.55, 0), Radius = 0.45 }),
		table.freeze({ Region = "RightArm", A = Vector3.new(1.5, 1.05, 0), B = Vector3.new(1.5, -0.55, 0), Radius = 0.45 }),
		table.freeze({ Region = "LeftLeg", A = Vector3.new(-0.5, -0.95, 0), B = Vector3.new(-0.5, -2.75, 0), Radius = 0.5 }),
		table.freeze({ Region = "RightLeg", A = Vector3.new(0.5, -0.95, 0), B = Vector3.new(0.5, -2.75, 0), Radius = 0.5 }),
	}),
	BoxOffset = CFrame.new(0, -0.3, 0),
	BoxHalfSize = Vector3.new(2.05, 2.95, 1.0),
	Reach = 3.6,
}) :: Profile

function LagCompensation.newHistory(profile: Profile?, capacity: number?): History
	local size = capacity or LagCompensation.HISTORY_FRAMES
	assert(size % 1 == 0 and size >= 2 and size <= 240, "History capacity must be an integer in 2..240")
	local times: { number } = table.create(size, -math.huge)
	local cframes: { CFrame } = table.create(size, CFrame.identity)
	local velocities: { Vector3 } = table.create(size, ZERO)
	local weaponA: { Vector3 } = table.create(size, ZERO)
	local weaponB: { Vector3 } = table.create(size, ZERO)
	local weaponRadius: { number } = table.create(size, 0)
	return {
		Capacity = size,
		Head = 0,
		Count = 0,
		Times = times,
		CFrames = cframes,
		Velocities = velocities,
		WeaponA = weaponA,
		WeaponB = weaponB,
		WeaponRadius = weaponRadius,
		Profile = profile or LagCompensation.HumanoidProfile,
	}
end

function LagCompensation.clear(history: History)
	history.Head = 0
	history.Count = 0
end

local function slot(history: History, logical: number): number
	-- logical 0 = oldest, Count-1 = newest
	return (history.Head - history.Count + logical) % history.Capacity + 1
end

function LagCompensation.record(history: History, time: number, cframe: CFrame, velocity: Vector3, weaponA: Vector3?, weaponB: Vector3?, weaponRadius: number?)
	local index: number
	if history.Count > 0 and time <= history.Times[history.Head] + EPSILON then
		-- Same or older tick: refresh the newest sample rather than breaking monotonic order.
		index = history.Head
		time = history.Times[index]
	else
		history.Head = history.Head % history.Capacity + 1
		history.Count = math.min(history.Count + 1, history.Capacity)
		index = history.Head
	end
	history.Times[index] = time
	history.CFrames[index] = cframe
	history.Velocities[index] = velocity
	history.WeaponA[index] = weaponA or cframe.Position
	history.WeaponB[index] = weaponB or cframe.Position
	history.WeaponRadius[index] = weaponRadius or 0
end

function LagCompensation.newestTime(history: History): number?
	if history.Count == 0 then
		return nil
	end
	return history.Times[history.Head]
end

function LagCompensation.oldestTime(history: History): number?
	if history.Count == 0 then
		return nil
	end
	return history.Times[slot(history, 0)]
end

-- Largest logical index whose time is <= t (bisection); -1 when t predates the history.
local function bisect(history: History, t: number): number
	local low, high = 0, history.Count - 1
	if t < history.Times[slot(history, 0)] then
		return -1
	end
	if t >= history.Times[slot(history, high)] then
		return high
	end
	while high - low > 1 do
		local mid = (low + high) // 2
		if history.Times[slot(history, mid)] <= t then
			low = mid
		else
			high = mid
		end
	end
	return low
end

-- Interpolated pose at t, clamped to the stored range: (cframe, velocity, weaponA, weaponB, weaponRadius).
function LagCompensation.samplePoseAt(history: History, timestamp: number): (CFrame?, Vector3, Vector3, Vector3, number)
	if history.Count == 0 then
		return nil, ZERO, ZERO, ZERO, 0
	end
	local lower = bisect(history, timestamp)
	if lower < 0 then
		local i = slot(history, 0)
		return history.CFrames[i], history.Velocities[i], history.WeaponA[i], history.WeaponB[i], history.WeaponRadius[i]
	end
	local i = slot(history, lower)
	if lower >= history.Count - 1 then
		return history.CFrames[i], history.Velocities[i], history.WeaponA[i], history.WeaponB[i], history.WeaponRadius[i]
	end
	local j = slot(history, lower + 1)
	local t0, t1 = history.Times[i], history.Times[j]
	local alpha = if t1 - t0 > EPSILON then math.clamp((timestamp - t0) / (t1 - t0), 0, 1) else 0
	if alpha <= EPSILON then
		return history.CFrames[i], history.Velocities[i], history.WeaponA[i], history.WeaponB[i], history.WeaponRadius[i]
	end
	return history.CFrames[i]:Lerp(history.CFrames[j], alpha),
		history.Velocities[i]:Lerp(history.Velocities[j], alpha),
		history.WeaponA[i]:Lerp(history.WeaponA[j], alpha),
		history.WeaponB[i]:Lerp(history.WeaponB[j], alpha),
		history.WeaponRadius[i] + (history.WeaponRadius[j] - history.WeaponRadius[i]) * alpha
end

-- Server time to rewind a target to for an attacker. Client claims are trusted only inside the
-- MAX_REWIND ceiling and never beyond measured round-trip plus interpolation delay.
function LagCompensation.rewindTime(now: number, claimedTime: number?, ping: number?): number
	local budget = LagCompensation.MAX_REWIND
	if ping ~= nil and ping == ping and ping >= 0 then
		budget = math.min(budget, ping + LagCompensation.INTERPOLATION_DELAY + LagCompensation.TICK)
	end
	local earliest = now - budget
	if claimedTime == nil or claimedTime ~= claimedTime then
		return earliest
	end
	return math.clamp(claimedTime, earliest, now)
end

-- Closest points between segments p1q1 and p2q2: (distanceSquared, s, t, closest1, closest2).
function LagCompensation.segmentSegment(p1: Vector3, q1: Vector3, p2: Vector3, q2: Vector3): (number, number, number, Vector3, Vector3)
	local d1 = q1 - p1
	local d2 = q2 - p2
	local r = p1 - p2
	local a = d1:Dot(d1)
	local e = d2:Dot(d2)
	local f = d2:Dot(r)
	local s, t
	if a <= EPSILON and e <= EPSILON then
		local diff = p1 - p2
		return diff:Dot(diff), 0, 0, p1, p2
	end
	if a <= EPSILON then
		s = 0
		t = math.clamp(f / e, 0, 1)
	else
		local c = d1:Dot(r)
		if e <= EPSILON then
			t = 0
			s = math.clamp(-c / a, 0, 1)
		else
			local b = d1:Dot(d2)
			local denom = a * e - b * b
			s = if denom > EPSILON then math.clamp((b * f - c * e) / denom, 0, 1) else 0
			t = (b * s + f) / e
			if t < 0 then
				t = 0
				s = math.clamp(-c / a, 0, 1)
			elseif t > 1 then
				t = 1
				s = math.clamp((b - c) / a, 0, 1)
			end
		end
	end
	local c1 = p1 + d1 * s
	local c2 = p2 + d2 * t
	local diff = c1 - c2
	return diff:Dot(diff), s, t, c1, c2
end

function LagCompensation.capsuleCapsule(a0: Vector3, a1: Vector3, ra: number, b0: Vector3, b1: Vector3, rb: number): (boolean, number, Vector3)
	local distSq, _, _, c1, c2 = LagCompensation.segmentSegment(a0, a1, b0, b1)
	local radius = ra + rb
	local distance = math.sqrt(distSq)
	local point = if distance > EPSILON then c2 + (c1 - c2) * ((rb) / distance) else c2
	return distSq <= radius * radius, distance - radius, point
end

local function pointBoxDistanceSq(localPoint: Vector3, half: Vector3): number
	local dx = math.max(math.abs(localPoint.X) - half.X, 0)
	local dy = math.max(math.abs(localPoint.Y) - half.Y, 0)
	local dz = math.max(math.abs(localPoint.Z) - half.Z, 0)
	return dx * dx + dy * dy + dz * dz
end

-- Segment-to-OBB distance. Distance to a convex set is convex along the segment, so a golden-section
-- search converges to the true minimum; 24 iterations resolve well below 1e-4 studs on weapon lengths.
function LagCompensation.segmentBoxDistance(p: Vector3, q: Vector3, box: CFrame, half: Vector3): (number, Vector3)
	local lp = box:PointToObjectSpace(p)
	local lq = box:PointToObjectSpace(q)
	local delta = lq - lp
	local low, high = 0, 1
	local x1 = high - GOLDEN * (high - low)
	local x2 = low + GOLDEN * (high - low)
	local f1 = pointBoxDistanceSq(lp + delta * x1, half)
	local f2 = pointBoxDistanceSq(lp + delta * x2, half)
	for _ = 1, 24 do
		if f1 <= f2 then
			high = x2
			x2 = x1
			f2 = f1
			x1 = high - GOLDEN * (high - low)
			f1 = pointBoxDistanceSq(lp + delta * x1, half)
		else
			low = x1
			x1 = x2
			f1 = f2
			x2 = low + GOLDEN * (high - low)
			f2 = pointBoxDistanceSq(lp + delta * x2, half)
		end
	end
	local best = (low + high) * 0.5
	local bestSq = pointBoxDistanceSq(lp + delta * best, half)
	local startSq = pointBoxDistanceSq(lp, half)
	local endSq = pointBoxDistanceSq(lq, half)
	if startSq < bestSq then
		best, bestSq = 0, startSq
	end
	if endSq < bestSq then
		best, bestSq = 1, endSq
	end
	return math.sqrt(bestSq), p + (q - p) * best
end

local function sweepSteps(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, targetTravel: number): number
	local travel = math.max((curA - prevA).Magnitude, (curB - prevB).Magnitude) + targetTravel
	local spacing = math.max(radius, 0.25)
	return math.clamp(math.ceil(travel / spacing), 1, LagCompensation.MAX_SWEEP_STEPS)
end

-- Swept weapon capsule vs a target OBB moving from boxFrom to boxTo over the same interval.
function LagCompensation.sweptCapsuleVsBox(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, boxFrom: CFrame, boxTo: CFrame, half: Vector3): (boolean, number, Vector3)
	local steps = sweepSteps(prevA, prevB, curA, curB, radius, (boxTo.Position - boxFrom.Position).Magnitude)
	for step = 0, steps do
		local alpha = step / steps
		local a = prevA:Lerp(curA, alpha)
		local b = prevB:Lerp(curB, alpha)
		local box = if alpha <= 0 then boxFrom elseif alpha >= 1 then boxTo else boxFrom:Lerp(boxTo, alpha)
		local distance, point = LagCompensation.segmentBoxDistance(a, b, box, half)
		if distance <= radius then
			return true, alpha, point
		end
	end
	return false, 1, curB
end

-- Swept weapon capsule vs a target capsule moving with its root between two poses.
function LagCompensation.sweptCapsuleVsCapsule(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, capsule: Capsule, rootFrom: CFrame, rootTo: CFrame): (boolean, number, Vector3, number)
	local steps = sweepSteps(prevA, prevB, curA, curB, radius, (rootTo.Position - rootFrom.Position).Magnitude)
	local closest = math.huge
	for step = 0, steps do
		local alpha = step / steps
		local a = prevA:Lerp(curA, alpha)
		local b = prevB:Lerp(curB, alpha)
		local root = if alpha <= 0 then rootFrom elseif alpha >= 1 then rootTo else rootFrom:Lerp(rootTo, alpha)
		local hit, gap, point = LagCompensation.capsuleCapsule(a, b, radius, root:PointToWorldSpace(capsule.A), root:PointToWorldSpace(capsule.B), capsule.Radius)
		closest = math.min(closest, gap)
		if hit then
			return true, alpha, point, gap
		end
	end
	return false, 1, curB, closest
end

-- Full query: swept-box broadphase then per-region swept capsules against the target rewound to
-- `rewindTo`. Returns the earliest-contact region (ties broken by deepest penetration).
function LagCompensation.queryHit(prevA: Vector3, prevB: Vector3, curA: Vector3, curB: Vector3, radius: number, target: History, rewindTo: number, interval: number?): Hit?
	if target.Count == 0 then
		return nil
	end
	local span = interval or LagCompensation.TICK
	local rootTo = LagCompensation.samplePoseAt(target, rewindTo)
	local rootFrom = LagCompensation.samplePoseAt(target, rewindTo - span)
	if rootTo == nil or rootFrom == nil then
		return nil
	end
	local profile = target.Profile
	local reachSq = (profile.Reach + radius + (curB - curA).Magnitude + (curB - prevB).Magnitude) ^ 2
	local offset = rootTo.Position - curA
	if offset:Dot(offset) > reachSq then
		return nil
	end
	local broad = LagCompensation.sweptCapsuleVsBox(prevA, prevB, curA, curB, radius, rootFrom * profile.BoxOffset, rootTo * profile.BoxOffset, profile.BoxHalfSize)
	if not broad then
		return nil
	end
	local bestRegion: string? = nil
	local bestFraction, bestGap = math.huge, math.huge
	local bestPoint = curB
	for _, capsule in profile.Capsules do
		local hit, fraction, point, gap = LagCompensation.sweptCapsuleVsCapsule(prevA, prevB, curA, curB, radius, capsule, rootFrom, rootTo)
		if hit and (fraction < bestFraction - EPSILON or (math.abs(fraction - bestFraction) <= EPSILON and gap < bestGap)) then
			bestRegion, bestFraction, bestGap, bestPoint = capsule.Region, fraction, gap, point
		end
	end
	if bestRegion == nil then
		return nil
	end
	return { Region = bestRegion, Point = bestPoint, Fraction = bestFraction, Distance = bestGap }
end

return table.freeze(LagCompensation)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">MatchJournal</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Durable immutable match results, discoverable through each participant's pre-start inbox.
local Journal={};Journal.__index=Journal
function Journal.new(store,retry,now) return setmetatable({store=store,retry=retry,now=now},Journal) end
function Journal:Create(id,players,owner)
 return self.retry(function()
  return self.store:UpdateAsync("Match_"..id,function(old)
   return old or {id=id,players=players,owner=owner,state="Active",expires=self.now()+1200}
  end)
 end)
end
function Journal:Finish(id,results)
 return self.retry(function()
  return self.store:UpdateAsync("Match_"..id,function(old)
   assert(old,"Missing match journal")
   if old.state~="Active" then return old end
   old.state=if results then "Complete" else "Cancelled";old.results=results
   return old
  end)
 end)
end
function Journal:Read(id)
 return self.retry(function()
  return self.store:UpdateAsync("Match_"..id,function(old)
   if old and old.state=="Active" and old.expires<=self.now() then old.state="Cancelled" end
   return old
  end)
 end)
end
return Journal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PersistenceService</string>
            <string name="Source"><![CDATA[--!nonstrict
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Schema=require(Shared.ProfileSchema)
local Engine=require(script.Parent.ProfileStore)
local RunService=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Config=require(Shared.Config)
local mock={}
local dataStore
if RunService:IsStudio() and not Config.Backend.StudioLiveData then
 dataStore={UpdateAsync=function(_,key,callback)
  local value=callback(Engine.Copy(mock[key]))
  if value~=nil then mock[key]=Engine.Copy(value) end
  return Engine.Copy(value)
 end}
else
 dataStore=game:GetService("DataStoreService"):GetDataStore("AsuraProfiles_v1")
end
local engine=Engine.new(dataStore,Schema,{owner=game.JobId..":"..Http:GenerateGUID(false),now=os.time,wait=task.wait,
 attempts=4,leaseSeconds=Config.Backend.LeaseSeconds})
local Service={Engine=engine,IsMock=RunService:IsStudio() and not Config.Backend.StudioLiveData}
function Service.Load(id)
 local deadline=os.clock()+20
 local ownershipAttempts=0
 repeat
  local p,err=engine:Load(id)
  if p then return p end
  if os.clock()>=deadline then error(err,0) end
  if err=="Profile is active on another server" then
   -- Teleport/rejoin can arrive before PlayerRemoving finishes its release.
   -- Wait for that normal release; never force an active owner's lease.
   ownershipAttempts+=1
   if ownershipAttempts>=8 then error(err,0) end
   task.wait(math.min(ownershipAttempts,3,math.max(0,deadline-os.clock())))
  elseif err=="Profile is busy" then task.wait(0.05)
  else error(err,0) end
 until false
end
function Service.Get(id) return engine:Get(id) end
function Service.Transaction(id,fn) return engine:Transaction(id,fn) end
function Service.Save(id) return engine:Save(id) end
function Service.Unload(id)
 local deadline=os.clock()+20
 repeat
  local ok,err=engine:Release(id)
  if ok or err~="Profile is busy" then return ok,err end
  task.wait(0.05)
 until os.clock()>deadline
 return false,"Release timed out"
end
function Service.ProcessReceipt(id,purchaseId,productId,grant) return engine:Receipt(id,purchaseId,productId,grant) end
function Service.ApplyResult(id,matchId,result) return engine:ApplyResult(id,matchId,result) end
function Service.PublicProfile(id)
 local p=Service.Get(id)
 if p then p.receipts=nil;p.appliedMatches=nil;p.pendingMatches=nil end
 return p
end
function Service.Start()
 task.spawn(function()
  while not engine.closed do
   task.wait(Config.Backend.AutosaveSeconds)
   if engine.closed then break end
   for id in engine.profiles do task.spawn(function()
    local ok,err=Service.Save(id)
    if not ok then
     warn("[Persistence] Autosave "..id..": "..tostring(err))
     if not Service.Get(id) then
      local player=game:GetService("Players"):GetPlayerByUserId(id)
      if player then player:Kick("Your fighter session expired. Please rejoin safely.") end
     end
    end
   end) end
  end
 end)
end
function Service.Close(deadline)
 engine.closed=true
 local pending=0
 for id in engine.profiles do pending+=1;task.spawn(function() Service.Unload(id);pending-=1 end) end
 deadline=deadline or os.clock()+25
 repeat task.wait(0.05) until pending==0 or os.clock()>deadline
 if pending>0 then warn("[Persistence] Shutdown deadline; remaining leases expire safely") end
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/ProfileStore
-- Pure, injectable storage engine plus the Asura's Path Souls progression record. Update callbacks
-- never yield or grant outside the stored record. Every profile carries a `souls` section that the
-- engine migrates and validates alongside the account schema it is constructed with.
local hasScript = pcall(function()
	return script.Parent
end)
local Settings: any, Weapons: any, World: any
if hasScript then
	local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
	Settings = require(Shared.Shared.CombatSettings)
	Weapons = require(Shared.Simulation.WeaponSchema)
	World = require(Shared.Shared.WorldDefinitions)
else
	Settings = require("../shared/CombatSettings")
	Weapons = require("../simulation/WeaponSchema")
	World = require("../shared/WorldDefinitions")
end

export type AttributeName = "Vitality" | "Qi" | "Strength" | "Dexterity"
export type Attributes = { [AttributeName]: number }
export type Bloodstain = { region: string, x: number, y: number, z: number, essence: number, death: number }
export type Elixirs = { charges: number, max: number, potency: number }
-- reinforcement: blacksmith upgrade level per weapon (absent = 0), 1..Store.ReinforceMax.
export type Inventory = {
	weapons: { [string]: boolean },
	mainhand: string,
	offhand: string,
	elixirs: Elixirs,
	reinforcement: { [string]: number },
}
export type WorldState = { altars: { [string]: boolean }, activeAltar: string, bosses: { [string]: boolean }, bloodstain: Bloodstain? }
export type Souls = {
	version: number,
	level: number,
	attributes: Attributes,
	essence: number,
	inventory: Inventory,
	world: WorldState,
	deaths: number,
}
export type DerivedStats = {
	MaxHP: number,
	MaxStamina: number,
	PostureCapacity: number,
	StrengthScale: number,
	DexterityScale: number,
}

type Schema = {
	Migrate: (raw: any, id: number) -> any,
	Validate: (profile: any) -> (boolean, string?),
	Level: (xp: number) -> number,
}

type Options = {
	owner: string,
	now: () -> number,
	wait: (seconds: number) -> any,
	attempts: number,
	leaseSeconds: number,
	startingAltar: string?,
}

type DataStore = { UpdateAsync: (self: any, key: string, transform: (old: any) -> any) -> any }

local Store = {}
Store.__index = Store

export type Engine = typeof(setmetatable(
	{} :: {
		dataStore: DataStore,
		schema: Schema,
		options: Options,
		profiles: { [number]: any },
		busy: { [number]: boolean },
		closed: boolean,
		operation: number,
	},
	Store
))

local function copy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, child in v do
		out[k] = copy(child)
	end
	return out
end
Store.Copy = copy

-- Conservative JSON upper bound: even fully escaped keys fit below the platform
-- record limit. Never remove deduplication keys to make a record fit.
local MAX_RECORD_BYTES = 3500000
local function jsonBound(value: any): number
	if type(value) == "string" then
		return #value * 6 + 2
	end
	if type(value) ~= "table" then
		return 32
	end
	local bytes = 2
	for key, child in value do
		bytes += jsonBound(key) + 1 + jsonBound(child) + 1
		if bytes > MAX_RECORD_BYTES then
			break
		end
	end
	return bytes
end
Store.JsonByteUpperBound = jsonBound

local function bounded(record: any): any
	assert(jsonBound(record) <= MAX_RECORD_BYTES, "Profile byte budget exceeded; archival required")
	return record
end

-------------------------------------------------------------------------------------------------
-- Souls progression schema
-------------------------------------------------------------------------------------------------

-- v2: weapon reinforcement levels.
local SOULS_VERSION = 2
local MAX_SAFE_INTEGER = 9007199254740991
local ATTRIBUTE_BASE = 10
local ATTRIBUTE_MAX = 99
local ATTRIBUTES: { AttributeName } = { "Vitality", "Qi", "Strength", "Dexterity" }
local MAX_IDENTIFIER = 64
local MAX_WORLD_ENTRIES = 512
local COORDINATE_LIMIT = 1e6
-- New records begin at the Sanctuary bonfire; the id lives only in WorldDefinitions.
local DEFAULT_ALTAR: string = World.Regions.Sanctuary.Altars.SanctuaryBonfire.Id
assert(DEFAULT_ALTAR == (World :: any).startingAltar().Id, "The Sanctuary bonfire must remain the starting altar")
local STARTING_WEAPONS = { "Unarmed", "Jian" }
local REINFORCE_MAX = 5
local REINFORCE_STEP = 0.06
local ELIXIR = Settings.Elixir

Store.Attributes = table.freeze(table.clone(ATTRIBUTES))
Store.AttributeBase = ATTRIBUTE_BASE
Store.AttributeMax = ATTRIBUTE_MAX

local WEAPON_SET: { [string]: boolean } = {}
for _, name in Weapons.WeaponTypes do
	WEAPON_SET[name] = true
end

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function integer(value: any, low: number, high: number): boolean
	return finite(value) and value >= low and value <= high and value % 1 == 0
end

local function identifier(value: any): boolean
	return type(value) == "string" and #value > 0 and #value <= MAX_IDENTIFIER and string.match(value, "^[%w_]+$") ~= nil
end

function Store.SoulLevel(attributes: Attributes): number
	local total = 0
	for _, name in ATTRIBUTES do
		total += attributes[name]
	end
	return total - ATTRIBUTE_BASE * #ATTRIBUTES + 1
end

-- Essence required to advance from `level` to `level + 1`.
function Store.LevelCost(level: number): number
	return math.floor(220 * 1.045 ^ (level - 1) + 12 * level)
end

-- Piecewise soft caps: full value per point to 40, reduced to 60, minimal beyond.
local function softCap(points: number, early: number, mid: number, late: number): number
	local spent = math.max(points - ATTRIBUTE_BASE, 0)
	local first = math.min(spent, 30)
	local second = math.clamp(spent - 30, 0, 20)
	local third = math.max(spent - 50, 0)
	return first * early + second * mid + third * late
end

Store.ReinforceMax = REINFORCE_MAX

-- Essence the blacksmith asks to raise a weapon from `level` to `level + 1`.
function Store.ReinforceCost(level: number): number
	return math.floor(600 * 1.75 ^ level)
end

function Store.ReinforceLevel(souls: Souls, weapon: string): number
	local levels = souls.inventory.reinforcement
	return if levels then levels[weapon] or 0 else 0
end

function Store.DeriveStats(souls: Souls): DerivedStats
	local a = souls.attributes
	-- The equipped weapon's reinforcement multiplies both damage scalings.
	local forged = 1 + REINFORCE_STEP * Store.ReinforceLevel(souls, souls.inventory.mainhand)
	return {
		MaxHP = Settings.Health.MaxHP + softCap(a.Vitality, 6, 3, 1),
		MaxStamina = Settings.Stamina.Max + softCap(a.Qi, 2.5, 1.2, 0.4),
		PostureCapacity = Settings.Posture.StanceBreakThreshold + softCap(a.Qi, 1.5, 0.8, 0.3),
		StrengthScale = (1 + softCap(a.Strength, 0.018, 0.009, 0.003)) * forged,
		DexterityScale = (1 + softCap(a.Dexterity, 0.018, 0.009, 0.003)) * forged,
	}
end

function Store.DefaultSouls(startingAltar: string?): Souls
	local weapons: { [string]: boolean } = {}
	for _, name in STARTING_WEAPONS do
		weapons[name] = true
	end
	local altar = startingAltar or DEFAULT_ALTAR
	return {
		version = SOULS_VERSION,
		level = 1,
		attributes = { Vitality = ATTRIBUTE_BASE, Qi = ATTRIBUTE_BASE, Strength = ATTRIBUTE_BASE, Dexterity = ATTRIBUTE_BASE },
		essence = 0,
		inventory = {
			weapons = weapons,
			mainhand = "Jian",
			offhand = "Unarmed",
			elixirs = { charges = ELIXIR.BaseCharges, max = ELIXIR.BaseCharges, potency = 0 },
			reinforcement = {},
		},
		world = { altars = { [altar] = true }, activeAltar = altar, bosses = {}, bloodstain = nil },
		deaths = 0,
	}
end

local function validBloodstain(stain: any): boolean
	if type(stain) ~= "table" then
		return false
	end
	for key in stain do
		if key ~= "region" and key ~= "x" and key ~= "y" and key ~= "z" and key ~= "essence" and key ~= "death" then
			return false
		end
	end
	return identifier(stain.region)
		and finite(stain.x) and math.abs(stain.x) <= COORDINATE_LIMIT
		and finite(stain.y) and math.abs(stain.y) <= COORDINATE_LIMIT
		and finite(stain.z) and math.abs(stain.z) <= COORDINATE_LIMIT
		and integer(stain.essence, 0, MAX_SAFE_INTEGER)
		and integer(stain.death, 0, MAX_SAFE_INTEGER)
end

local function validFlagSet(set: any): boolean
	if type(set) ~= "table" then
		return false
	end
	local count = 0
	for key, value in set do
		count += 1
		if count > MAX_WORLD_ENTRIES or not identifier(key) or value ~= true then
			return false
		end
	end
	return true
end

function Store.ValidateSouls(raw: any): (boolean, string?)
	if type(raw) ~= "table" then
		return false, "Missing souls record"
	end
	if raw.version ~= SOULS_VERSION then
		return false, "Unsupported souls version"
	end
	local attributes = raw.attributes
	if type(attributes) ~= "table" then
		return false, "Missing attributes"
	end
	for _, name in ATTRIBUTES do
		if not integer(attributes[name], ATTRIBUTE_BASE, ATTRIBUTE_MAX) then
			return false, "Invalid attribute " .. name
		end
	end
	for key in attributes do
		if table.find(ATTRIBUTES, key) == nil then
			return false, "Unknown attribute"
		end
	end
	if raw.level ~= Store.SoulLevel(attributes) then
		return false, "Level does not match attributes"
	end
	if not integer(raw.essence, 0, MAX_SAFE_INTEGER) or not integer(raw.deaths, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid essence or deaths"
	end
	local inventory = raw.inventory
	if type(inventory) ~= "table" or type(inventory.weapons) ~= "table" then
		return false, "Missing inventory"
	end
	for name, owned in inventory.weapons do
		if not WEAPON_SET[name] or owned ~= true then
			return false, "Invalid weapon ownership"
		end
	end
	if inventory.weapons.Unarmed ~= true then
		return false, "Unarmed discipline must remain unlocked"
	end
	if type(inventory.mainhand) ~= "string" or inventory.weapons[inventory.mainhand] ~= true then
		return false, "Mainhand must be unlocked"
	end
	if inventory.offhand ~= "None" and (type(inventory.offhand) ~= "string" or inventory.weapons[inventory.offhand] ~= true) then
		return false, "Offhand must be unlocked or None"
	end
	local elixirs = inventory.elixirs
	if type(elixirs) ~= "table" or not integer(elixirs.max, ELIXIR.BaseCharges, ELIXIR.MaxCharges)
		or not integer(elixirs.charges, 0, elixirs.max) or not integer(elixirs.potency, 0, 10) then
		return false, "Invalid elixirs"
	end
	if type(inventory.reinforcement) ~= "table" then
		return false, "Missing reinforcement"
	end
	for name, level in inventory.reinforcement do
		if not WEAPON_SET[name] or not integer(level, 1, REINFORCE_MAX) then
			return false, "Invalid reinforcement"
		end
	end
	local world = raw.world
	if type(world) ~= "table" or not validFlagSet(world.altars) or not validFlagSet(world.bosses) then
		return false, "Invalid world state"
	end
	if not identifier(world.activeAltar) or world.altars[world.activeAltar] ~= true then
		return false, "Active altar must be activated"
	end
	if world.bloodstain ~= nil and not validBloodstain(world.bloodstain) then
		return false, "Invalid bloodstain"
	end
	return true, nil
end

function Store.MigrateSouls(raw: any, startingAltar: string?): Souls
	local souls = Store.DefaultSouls(startingAltar)
	if type(raw) ~= "table" then
		return souls
	end
	if finite(raw.version) and raw.version > SOULS_VERSION then
		error("Souls record is newer than this server supports", 0)
	end
	if type(raw.attributes) == "table" then
		for _, name in ATTRIBUTES do
			local value = raw.attributes[name]
			if integer(value, ATTRIBUTE_BASE, ATTRIBUTE_MAX) then
				souls.attributes[name] = value
			end
		end
	end
	souls.level = Store.SoulLevel(souls.attributes)
	if integer(raw.essence, 0, MAX_SAFE_INTEGER) then
		souls.essence = raw.essence
	end
	if integer(raw.deaths, 0, MAX_SAFE_INTEGER) then
		souls.deaths = raw.deaths
	end
	local inventory = raw.inventory
	if type(inventory) == "table" then
		if type(inventory.weapons) == "table" then
			for name, owned in inventory.weapons do
				if WEAPON_SET[name] and owned == true then
					souls.inventory.weapons[name] = true
				end
			end
		end
		if type(inventory.mainhand) == "string" and souls.inventory.weapons[inventory.mainhand] then
			souls.inventory.mainhand = inventory.mainhand
		end
		if inventory.offhand == "None" or (type(inventory.offhand) == "string" and souls.inventory.weapons[inventory.offhand]) then
			souls.inventory.offhand = inventory.offhand
		end
		local elixirs = inventory.elixirs
		if type(elixirs) == "table" then
			if integer(elixirs.max, ELIXIR.BaseCharges, ELIXIR.MaxCharges) then
				souls.inventory.elixirs.max = elixirs.max
			end
			if integer(elixirs.charges, 0, souls.inventory.elixirs.max) then
				souls.inventory.elixirs.charges = elixirs.charges
			else
				souls.inventory.elixirs.charges = souls.inventory.elixirs.max
			end
			if integer(elixirs.potency, 0, 10) then
				souls.inventory.elixirs.potency = elixirs.potency
			end
		end
		if type(inventory.reinforcement) == "table" then
			for name, level in inventory.reinforcement do
				if WEAPON_SET[name] and integer(level, 1, REINFORCE_MAX) then
					souls.inventory.reinforcement[name] = level
				end
			end
		end
	end
	local world = raw.world
	if type(world) == "table" then
		if validFlagSet(world.altars) then
			for id in world.altars do
				souls.world.altars[id] = true
			end
		end
		if validFlagSet(world.bosses) then
			for id in world.bosses do
				souls.world.bosses[id] = true
			end
		end
		if identifier(world.activeAltar) and souls.world.altars[world.activeAltar] then
			souls.world.activeAltar = world.activeAltar
		end
		-- A corrupt bloodstain is dropped rather than repaired: its essence was already forfeit.
		if world.bloodstain ~= nil and validBloodstain(world.bloodstain) then
			souls.world.bloodstain = copy(world.bloodstain)
		end
	end
	assert(Store.ValidateSouls(souls))
	return souls
end

-- Wraps an account schema so every migrated profile carries a validated `souls` section.
function Store.WithSouls(schema: Schema, startingAltar: string?): Schema
	return {
		Migrate = function(raw: any, id: number): any
			local profile = schema.Migrate(raw, id)
			profile.souls = Store.MigrateSouls(if type(raw) == "table" then raw.souls else nil, startingAltar)
			return profile
		end,
		Validate = function(profile: any): (boolean, string?)
			local ok, err = schema.Validate(profile)
			if not ok then
				return ok, err
			end
			return Store.ValidateSouls(profile.souls)
		end,
		Level = schema.Level,
	}
end

-------------------------------------------------------------------------------------------------
-- Storage engine
-------------------------------------------------------------------------------------------------

function Store.new(dataStore: DataStore, schema: Schema, options: Options): Engine
	local self = {
		dataStore = dataStore,
		schema = Store.WithSouls(schema, options.startingAltar),
		options = options,
		profiles = {},
		busy = {},
		closed = false,
		operation = 0,
	}
	return setmetatable(self, Store) :: any
end

function Store.Retry(self: Engine, fn: () -> any): (boolean, any)
	local err: any
	for attempt = 1, self.options.attempts do
		local ok, value = pcall(fn)
		if ok then
			return true, value
		end
		err = value
		if attempt < self.options.attempts then
			self.options.wait(math.min(2 ^ (attempt - 1), 4))
		end
	end
	return false, tostring(err)
end

function Store.Load(self: Engine, id: number): (any, string?)
	if self.closed then
		return nil, "Server is closing"
	end
	if self.profiles[id] then
		return self:Get(id), nil
	end
	if self.busy[id] then
		return nil, "Profile is busy"
	end
	self.busy[id] = true
	local now = self.options.now
	local ok, record = self:Retry(function()
		return self.dataStore:UpdateAsync("Player_" .. id, function(old: any): any
			if old ~= nil and type(old) ~= "table" then
				error("Corrupt profile record")
			end
			local envelope = old and old.storageVersion ~= nil
			if envelope and old.storageVersion ~= 2 then
				error("Unsupported storage version")
			end
			if envelope and (type(old.profile) ~= "table" or type(old.revision) ~= "number") then
				error("Invalid storage envelope")
			end
			local lease = envelope and old.session
			if lease and (type(lease) ~= "table" or type(lease.id) ~= "string" or type(lease.expires) ~= "number") then
				error("Invalid lease")
			end
			if lease and lease.id ~= self.options.owner and lease.expires > now() then
				return nil
			end
			local raw = if envelope then old.profile else old
			if raw and raw.userId ~= nil and raw.userId ~= id then
				error("Profile owner mismatch")
			end
			local profile = self.schema.Migrate(raw, id)
			assert(self.schema.Validate(profile))
			return bounded({
				storageVersion = 2,
				revision = (if envelope then old.revision else 0) + 1,
				profile = profile,
				session = { id = self.options.owner, expires = now() + self.options.leaseSeconds },
			})
		end)
	end)
	self.busy[id] = nil
	if not ok or not record then
		return nil, if ok then "Profile is active on another server" else record
	end
	self.profiles[id] = record
	return self:Get(id), nil
end

function Store.Get(self: Engine, id: number): any
	local record = self.profiles[id]
	if not record or not record.session or record.session.expires <= self.options.now() then
		return nil
	end
	return copy(record.profile)
end

-- One transaction per user. Failed/ambiguous writes never expose speculative rewards to gameplay.
function Store.Transaction(self: Engine, id: number, mutate: (profile: any) -> (), release: boolean?): (boolean, string?)
	local localRecord = self.profiles[id]
	if not localRecord or not self:Get(id) then
		return false, "Profile session unavailable"
	end
	if self.busy[id] then
		return false, "Profile is busy"
	end
	self.busy[id] = true
	self.operation += 1
	local operationId = self.options.owner .. ":" .. self.operation
	local ok, result = self:Retry(function()
		return self.dataStore:UpdateAsync("Player_" .. id, function(old: any): any
			if not old or old.storageVersion ~= 2 or not old.session or old.session.id ~= self.options.owner
				or old.session.expires <= self.options.now() then
				return nil
			end
			if old.lastOperation == operationId then
				return old
			end
			local candidate = self.schema.Migrate(old.profile, id)
			mutate(candidate)
			candidate.lastSaveTime = self.options.now()
			assert(self.schema.Validate(candidate))
			return bounded({
				storageVersion = 2,
				revision = old.revision + 1,
				profile = candidate,
				lastOperation = operationId,
				session = if release then nil else { id = self.options.owner, expires = self.options.now() + self.options.leaseSeconds },
			})
		end)
	end)
	self.busy[id] = nil
	if not ok or not result then
		-- Ownership refusal invalidates local access immediately. API errors leave only the last confirmed cache.
		if ok then
			self.profiles[id] = nil
		end
		return false, if ok then "Profile ownership lost" else result
	end
	self.profiles[id] = if release then nil else result
	return true, nil
end

function Store.Save(self: Engine, id: number): (boolean, string?)
	return self:Transaction(id, function() end)
end

function Store.Release(self: Engine, id: number): (boolean, string?)
	return self:Transaction(id, function() end, true)
end

function Store.Receipt(self: Engine, id: number, purchaseId: any, productId: number, grant: (profile: any) -> ()): (boolean, string?)
	if type(purchaseId) ~= "string" or #purchaseId == 0 or #purchaseId > 200 then
		return false, "Invalid receipt ID"
	end
	return self:Transaction(id, function(p)
		local previous = p.receipts[purchaseId]
		if previous then
			assert(previous == productId, "Receipt product mismatch")
			return
		end
		local count = 0
		for _ in p.receipts do
			count += 1
		end
		assert(count < 10000, "Receipt ledger full; archival required") -- Never evict an idempotency key.
		grant(p)
		p.receipts[purchaseId] = productId
	end)
end

function Store.ApplyResult(self: Engine, id: number, matchId: string, result: any): (boolean, string?)
	return self:Transaction(id, function(p)
		if p.appliedMatches[matchId] then
			p.pendingMatches[matchId] = nil
			return
		end
		assert(p.pendingMatches[matchId], "Result was not registered before match start")
		assert(result.userId == id and result.mode == "Ranked1v1", "Invalid ranked result")
		local count = 0
		for _ in p.appliedMatches do
			count += 1
		end
		assert(count < 10000, "Result ledger full; archival required")
		p.elo = math.clamp(p.elo + result.eloDelta, 0, 5000)
		p.peakElo = math.max(p.peakElo, p.elo)
		p.fightCash += result.cash
		if result.outcome == "Win" then
			p.wins += 1
			p.winStreak += 1
		elseif result.outcome == "Draw" then
			p.draws += 1
			p.winStreak = 0
		else
			p.losses += 1
			p.winStreak = 0
		end
		local style = assert(p.styles[result.style])
		assert(style.unlocked)
		local multiplier = if p.ownedCosmetics.VIP_Pass then 2 else 1
		style.xp += result.xp * multiplier
		style.level = self.schema.Level(style.xp)
		p.appliedMatches[matchId] = true
		p.pendingMatches[matchId] = nil
	end)
end

-------------------------------------------------------------------------------------------------
-- Souls progression transactions. Each pre-checks against the confirmed cache, then re-checks
-- inside the write so a refused change is a no-op rather than a retried error.
-------------------------------------------------------------------------------------------------

function Store.Souls(self: Engine, id: number): Souls?
	local profile = self:Get(id)
	return if profile then profile.souls else nil
end

function Store.ActivateAltar(self: Engine, id: number, altarId: string, setActive: boolean, refillElixirs: boolean): (boolean, string?)
	if not identifier(altarId) then
		return false, "Invalid altar"
	end
	return self:Transaction(id, function(p)
		local world = p.souls.world
		local count = 0
		for _ in world.altars do
			count += 1
		end
		if not world.altars[altarId] and count < MAX_WORLD_ENTRIES then
			world.altars[altarId] = true
		end
		if setActive and world.altars[altarId] then
			world.activeAltar = altarId
		end
		if refillElixirs then
			p.souls.inventory.elixirs.charges = p.souls.inventory.elixirs.max
		end
	end)
end

function Store.SetElixirCharges(self: Engine, id: number, charges: number): (boolean, string?)
	if not integer(charges, 0, ELIXIR.MaxCharges) then
		return false, "Invalid charges"
	end
	return self:Transaction(id, function(p)
		local elixirs = p.souls.inventory.elixirs
		elixirs.charges = math.min(charges, elixirs.max)
	end)
end

function Store.AddElixirCapacity(self: Engine, id: number): (boolean, string?)
	local souls = self:Souls(id)
	if not souls then
		return false, "Profile session unavailable"
	end
	if souls.inventory.elixirs.max >= ELIXIR.MaxCharges then
		return false, "Gourd already at capacity"
	end
	return self:Transaction(id, function(p)
		local elixirs = p.souls.inventory.elixirs
		if elixirs.max < ELIXIR.MaxCharges then
			elixirs.max += 1
			elixirs.charges = math.min(elixirs.charges + 1, elixirs.max)
		end
	end)
end

function Store.GrantEssence(self: Engine, id: number, amount: number): (boolean, string?)
	if not integer(amount, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid essence amount"
	end
	if amount == 0 then
		return true, nil
	end
	return self:Transaction(id, function(p)
		p.souls.essence = math.min(MAX_SAFE_INTEGER, p.souls.essence + amount)
	end)
end

-- Death: unbanked session essence joins the carried total, all of it drops into a new bloodstain,
-- and any previous unrecovered bloodstain is destroyed. Returns the essence now in the stain.
function Store.RecordDeath(self: Engine, id: number, region: string, x: number, y: number, z: number, unbanked: number): (boolean, string?, number)
	if not identifier(region) or not finite(x) or not finite(y) or not finite(z) or not integer(unbanked, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid death record", 0
	end
	local dropped = 0
	local ok, err = self:Transaction(id, function(p)
		local souls = p.souls
		souls.deaths = math.min(MAX_SAFE_INTEGER, souls.deaths + 1)
		dropped = math.min(MAX_SAFE_INTEGER, souls.essence + unbanked)
		souls.essence = 0
		souls.world.bloodstain = if dropped > 0
			then {
				region = region,
				x = math.clamp(x, -COORDINATE_LIMIT, COORDINATE_LIMIT),
				y = math.clamp(y, -COORDINATE_LIMIT, COORDINATE_LIMIT),
				z = math.clamp(z, -COORDINATE_LIMIT, COORDINATE_LIMIT),
				essence = dropped,
				death = souls.deaths,
			}
			else nil
	end)
	return ok, err, if ok then dropped else 0
end

function Store.RecoverBloodstain(self: Engine, id: number, deathIndex: number): (boolean, string?, number)
	local souls = self:Souls(id)
	local stain = souls and souls.world.bloodstain
	if not stain or stain.death ~= deathIndex then
		return false, "No matching bloodstain", 0
	end
	local recovered = 0
	local ok, err = self:Transaction(id, function(p)
		local current = p.souls.world.bloodstain
		if current and current.death == deathIndex then
			recovered = current.essence
			p.souls.essence = math.min(MAX_SAFE_INTEGER, p.souls.essence + current.essence)
			p.souls.world.bloodstain = nil
		end
	end)
	return ok, err, if ok then recovered else 0
end

function Store.LevelAttribute(self: Engine, id: number, attribute: AttributeName): (boolean, string?)
	if table.find(ATTRIBUTES, attribute) == nil then
		return false, "Unknown attribute"
	end
	local souls = self:Souls(id)
	if not souls then
		return false, "Profile session unavailable"
	end
	if souls.attributes[attribute] >= ATTRIBUTE_MAX then
		return false, "Attribute at maximum"
	end
	local cost = Store.LevelCost(souls.level)
	if souls.essence < cost then
		return false, "Not enough essence"
	end
	local applied = false
	local ok, err = self:Transaction(id, function(p)
		local s = p.souls
		local price = Store.LevelCost(s.level)
		if s.essence >= price and s.attributes[attribute] < ATTRIBUTE_MAX then
			s.essence -= price
			s.attributes[attribute] += 1
			s.level = Store.SoulLevel(s.attributes)
			applied = true
		end
	end)
	if ok and not applied then
		return false, "Level refused"
	end
	return ok, err
end

function Store.RecordBossDefeat(self: Engine, id: number, bossId: string, essence: number): (boolean, string?)
	if not identifier(bossId) or not integer(essence, 0, MAX_SAFE_INTEGER) then
		return false, "Invalid boss record"
	end
	return self:Transaction(id, function(p)
		local bosses = p.souls.world.bosses
		local count = 0
		for _ in bosses do
			count += 1
		end
		if not bosses[bossId] and count < MAX_WORLD_ENTRIES then
			bosses[bossId] = true
			p.souls.essence = math.min(MAX_SAFE_INTEGER, p.souls.essence + essence)
		end
	end)
end

function Store.UnlockWeapon(self: Engine, id: number, weapon: string): (boolean, string?)
	if not WEAPON_SET[weapon] then
		return false, "Unknown weapon"
	end
	return self:Transaction(id, function(p)
		p.souls.inventory.weapons[weapon] = true
	end)
end

-- Blacksmith: spends banked essence to raise one weapon's reinforcement by a level.
-- Returns the new level on success.
function Store.ReinforceWeapon(self: Engine, id: number, weapon: string): (boolean, string?, number)
	if not WEAPON_SET[weapon] then
		return false, "Unknown weapon", 0
	end
	local souls = self:Souls(id)
	if not souls then
		return false, "Profile session unavailable", 0
	end
	if souls.inventory.weapons[weapon] ~= true then
		return false, "Weapon is locked", 0
	end
	local current = Store.ReinforceLevel(souls, weapon)
	if current >= REINFORCE_MAX then
		return false, "Reinforcement at maximum", current
	end
	if souls.essence < Store.ReinforceCost(current) then
		return false, "Not enough essence", current
	end
	local reached = 0
	local ok, err = self:Transaction(id, function(p)
		local s = p.souls
		local level = s.inventory.reinforcement[weapon] or 0
		local price = Store.ReinforceCost(level)
		if s.inventory.weapons[weapon] == true and level < REINFORCE_MAX and s.essence >= price then
			s.essence -= price
			s.inventory.reinforcement[weapon] = level + 1
			reached = level + 1
		end
	end)
	if ok and reached == 0 then
		return false, "Reinforcement refused", current
	end
	return ok, err, reached
end

function Store.EquipLoadout(self: Engine, id: number, mainhand: string, offhand: string): (boolean, string?)
	local souls = self:Souls(id)
	if not souls then
		return false, "Profile session unavailable"
	end
	local weapons = souls.inventory.weapons
	if not weapons[mainhand] or (offhand ~= "None" and not weapons[offhand]) then
		return false, "Weapon is locked"
	end
	return self:Transaction(id, function(p)
		local inventory = p.souls.inventory
		if inventory.weapons[mainhand] and (offhand == "None" or inventory.weapons[offhand]) then
			inventory.mainhand = mainhand
			inventory.offhand = offhand
		end
	end)
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">SanctuaryService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/SanctuaryService
-- The Shrine of the Ascendant: a lantern-lit Wuxia courtyard above a misted karst valley.
-- Builds every piece procedurally under Workspace.Sanctuary from the WorldDefinitions layout:
--   * Central courtyard: laid flagstones, reflecting basins, incense altar and roofed cloisters.
--   * Ascension Gateway (north): a 20-step grand staircase to a two-tier paifang gatehouse whose portal
--     carries the player to the Monastery Gate.
--   * Blacksmith Loggia (west): pavilion, forge, anvil and Master Smith Gao (reinforce / refill).
--   * Colosseum Promenade (east): balustraded balcony with banners and braziers; the ring itself
--     is raised by ColosseumService on the same anchor.
--   * Sea of clouds and a horizon of ruined spires and castle silhouettes.
-- Start() must run before WorldService.Start(): the region's MapFolder (this folder) suppresses
-- the greybox, and the bonfire's AltarAnchor part receives the altar's rest prompt.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local World = require(Shared.Shared.WorldDefinitions)
local Animations = require(Shared.Shared.AnimationCatalog)
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local WorldService = require(script.Parent:WaitForChild("WorldService") :: ModuleScript)

local SanctuaryService = {}

-------------------------------------------------------------------------------------------------
-- Layout
-------------------------------------------------------------------------------------------------

local LAYOUT = World.Sanctuary
local ORIGIN = Vector3.new(LAYOUT.Origin.X, LAYOUT.Origin.Y, LAYOUT.Origin.Z)
local R = LAYOUT.PlazaRadius
local LOGGIA = Vector3.new(LAYOUT.Loggia.X, LAYOUT.Loggia.Y, LAYOUT.Loggia.Z)
local PROMENADE = Vector3.new(LAYOUT.Promenade.X, LAYOUT.Promenade.Y, LAYOUT.Promenade.Z)
local BALCONY_APOTHEM = 32
local STAIR_START = R - 1
local LANDING_DEPTH = 22
local ARCH_OFFSET = 15 -- arch depth into the landing

local BONFIRE_ALTAR = World.startingAltar()
local DESTINATION = World.Altars[LAYOUT.PortalDestination]

local PORTAL_FADE = 0.5
local PORTAL_COOLDOWN = 4
local CATCH_DEPTH = 40
local CATCH_RADIUS = 1300
local POLL_INTERVAL = 0.5
local SMITH_RADIUS = 10

local TEXTURE_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEXTURE_SPARKS = "rbxasset://textures/particles/fire_sparks_main.dds"
local TEXTURE_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEXTURE_MOTE = "rbxasset://textures/particles/sparkles_main.dds"

-- Palette
local FLAG_LIGHT = Color3.fromRGB(80, 87, 86)
local FLAG_DARK = Color3.fromRGB(61, 69, 70)
local STONE = Color3.fromRGB(95, 101, 96)
local STONE_DARK = Color3.fromRGB(41, 49, 51)
local ROCK = Color3.fromRGB(49, 60, 64)
local STATUE = Color3.fromRGB(82, 91, 88)
local SHADOW = Color3.fromRGB(26, 24, 24)
local WATER = Color3.fromRGB(30, 53, 57)
local BONFIRE_LIGHT = Color3.fromRGB(255, 185, 90)
local EMBER = Color3.fromRGB(255, 120, 40)
local PORTAL = Color3.fromRGB(111, 170, 164)
local IRON = Color3.fromRGB(34, 32, 34)
local BANNER_RED = Color3.fromRGB(83, 26, 28)
local BANNER_BLACK = Color3.fromRGB(20, 18, 20)
local ROOF = Color3.fromRGB(27, 37, 40)
local BRICK = Color3.fromRGB(63, 49, 43)
local WOOD = Color3.fromRGB(47, 38, 33)
local SILHOUETTE = Color3.fromRGB(62, 80, 88)

-------------------------------------------------------------------------------------------------
-- State
-------------------------------------------------------------------------------------------------

local root: Folder? = nil
local spawnCFrame = CFrame.new()
local smithPosition = Vector3.zero
local connections: { RBXScriptConnection } = {}
local disconnectors: { () -> () } = {}
local transit: { [number]: number } = {}
local running = false
local accumulator = 0

-------------------------------------------------------------------------------------------------
-- Construction helpers
-------------------------------------------------------------------------------------------------

type PartOptions = {
	Collide: boolean?,
	Query: boolean?,
	Transparency: number?,
	Reflectance: number?,
	Shadow: boolean?,
	Shape: Enum.PartType?,
	Class: string?,
}

local function folder(name: string, parent: Instance): Folder
	local created = Instance.new("Folder")
	created.Name = name
	created.Parent = parent
	return created
end

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, options: PartOptions?): BasePart
	local o: PartOptions = options or {}
	local p = Instance.new((o.Class or "Part") :: any) :: BasePart
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	p.CanCollide = if o.Collide == nil then true else o.Collide
	p.CanQuery = if o.Query == nil then p.CanCollide else o.Query
	p.Transparency = o.Transparency or 0
	p.Reflectance = o.Reflectance or 0
	p.CastShadow = if o.Shadow == nil then true else o.Shadow
	if o.Shape and p:IsA("Part") then
		p.Shape = o.Shape
	end
	p.Parent = parent
	return p
end

-- Upright cylinder centred on `center` (Roblox cylinders run along local X).
local function disc(parent: Instance, name: string, radius: number, height: number, center: CFrame, color: Color3, material: Enum.Material, options: PartOptions?): BasePart
	local o: PartOptions = if options then table.clone(options) else {}
	o.Shape = Enum.PartType.Cylinder
	return part(parent, name, Vector3.new(height, radius * 2, radius * 2), center * CFrame.Angles(0, 0, math.rad(90)), color, material, o)
end

local function decor(): PartOptions
	return { Collide = false, Query = false, Shadow = false }
end

local function sequence(points: { { number } }): NumberSequence
	local keys = {}
	for _, point in points do
		table.insert(keys, NumberSequenceKeypoint.new(point[1], point[2]))
	end
	return NumberSequence.new(keys)
end

local function colors(a: Color3, b: Color3): ColorSequence
	return ColorSequence.new(a, b)
end

local function light(parent: BasePart, color: Color3, range: number, brightness: number, shadows: boolean)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = shadows
	l.Parent = parent
end

local function fire(parent: BasePart, size: number, heat: number, color: Color3, secondary: Color3)
	local f = Instance.new("Fire")
	f.Size = size
	f.Heat = heat
	f.Color = color
	f.SecondaryColor = secondary
	f.Parent = parent
end

local function embers(parent: BasePart, rate: number, spread: number, lift: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = "Embers"
	e.Texture = TEXTURE_SPARKS
	e.Rate = rate
	e.Lifetime = NumberRange.new(2.5, 4.5)
	e.Speed = NumberRange.new(3, 7)
	e.SpreadAngle = Vector2.new(spread, spread)
	e.Acceleration = Vector3.new(0.6, lift, 0.4)
	e.Drag = 0.6
	e.Size = sequence({ { 0, 0.22 }, { 1, 0.05 } })
	e.Transparency = sequence({ { 0, 0 }, { 0.8, 0.3 }, { 1, 1 } })
	e.Color = colors(Color3.fromRGB(255, 200, 110), Color3.fromRGB(255, 80, 30))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Parent = parent
	return e
end

local function polar(angle: number, radius: number, y: number): CFrame
	return CFrame.new(ORIGIN) * CFrame.Angles(0, angle, 0) * CFrame.new(0, y, -radius)
end

-------------------------------------------------------------------------------------------------
-- 1. Central Reflective Plaza
-------------------------------------------------------------------------------------------------

-- Architecture is built in layers at human scale: masonry, timber frame, tiled roof, then light.
local BRONZE = Color3.fromRGB(112, 91, 57)
local LANTERN = Color3.fromRGB(232, 180, 112)

local function beam(parent: Instance, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3)
	return part(parent, name, Vector3.new(thickness, thickness, (b-a).Magnitude),
		CFrame.lookAt((a+b)*0.5, b), color, Enum.Material.Wood, decor())
end

local function roof(parent: Instance, base: CFrame, width: number, depth: number)
	local group = folder("TiledEaves", parent)
	local half = width * 0.5
	local function height(t: number): number
		return 4 * (1-t)^1.35 + 1.65 * t^8
	end
	for side = -1, 1, 2 do
		for strip = 0, 5 do
			local a, b = strip/6, (strip+1)/6
			local x0, x1 = side*half*a, side*half*b
			local y0, y1 = height(a), height(b)
			local length = math.sqrt((x1-x0)^2+(y1-y0)^2)
			local angle = math.atan((y1-y0)/(x1-x0))
			local shade = ROOF:Lerp(STONE_DARK, if strip%2==0 then 0.1 else 0.25)
			part(group, "TileCourse", Vector3.new(length+0.12,0.32,depth),
				base*CFrame.new((x0+x1)*0.5,(y0+y1)*0.5,0)*CFrame.Angles(0,0,angle), shade, Enum.Material.Slate, decor())
			-- Thin raised seams give the tiles a legible rhythm from the gameplay camera.
			for _, z in { -depth*0.5+0.1, depth*0.5-0.1 } do
				part(group, "TileRib", Vector3.new(length+0.1,0.1,0.12),
					base*CFrame.new((x0+x1)*0.5,(y0+y1)*0.5+0.19,z)*CFrame.Angles(0,0,angle), STONE_DARK, Enum.Material.Slate, decor())
			end
		end
		for face = -1, 1, 2 do
			beam(group,"EaveTip", (base*CFrame.new(side*(half-2),1.25,face*depth*0.5)).Position,
				(base*CFrame.new(side*(half+1.6),3.4,face*depth*0.5)).Position,0.38,IRON)
		end
	end
	part(group,"Ridge",Vector3.new(0.55,0.55,depth+2),base*CFrame.new(0,4.25,0),IRON,Enum.Material.Metal,decor())
	for side=-1,1,2 do
		beam(group,"RidgeHorn",(base*CFrame.new(0,4.25,side*depth*0.5)).Position,
			(base*CFrame.new(0,5.5,side*(depth*0.5+2))).Position,0.4,IRON)
	end
end

local function lantern(parent: Instance, base: CFrame, hanging: boolean?)
	local group=folder("StoneLantern",parent)
	if not hanging then
		part(group,"Foot",Vector3.new(2.6,0.35,2.6),base*CFrame.new(0,0.175,0),STONE_DARK,Enum.Material.Slate)
		part(group,"Stem",Vector3.new(0.8,2.4,0.8),base*CFrame.new(0,1.5,0),STONE,Enum.Material.Slate)
	end
	local y=if hanging then 0 else 3.2
	part(group,"Sill",Vector3.new(1.9,0.22,1.9),base*CFrame.new(0,y-0.7,0),IRON,Enum.Material.Metal,decor())
	local glow=part(group,"Paper",Vector3.new(1.25,1.4,1.25),base*CFrame.new(0,y,0),LANTERN,Enum.Material.Neon,decor())
	for x=-1,1,2 do
		for z=-1,1,2 do
			part(group,"Frame",Vector3.new(0.12,1.65,0.12),base*CFrame.new(x*0.72,y,z*0.72),WOOD,Enum.Material.Wood,decor())
		end
	end
	part(group,"Cap",Vector3.new(2.2,0.35,2.2),base*CFrame.new(0,y+0.95,0),STONE_DARK,Enum.Material.Slate,decor())
	part(group,"Finial",Vector3.new(0.45,0.45,0.45),base*CFrame.new(0,y+1.3,0),BRONZE,Enum.Material.Metal,decor())
	light(glow,LANTERN,17,1.1,false)
end

local function inscription(parent: BasePart, text: string, face: Enum.NormalId?)
	local gui=Instance.new("SurfaceGui")
	gui.Face=face or Enum.NormalId.Front
	gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud=40
	local label=Instance.new("TextLabel")
	label.Size=UDim2.fromScale(1,1)
	label.BackgroundTransparency=1
	label.Text=text
	label.TextColor3=Color3.fromRGB(158,145,112)
	label.TextSize=56
	label.Font=Enum.Font.Antique
	label.Parent=gui
	gui.Parent=parent
end

local function buildPlaza(parent: Folder): BasePart
	local plaza=folder("CentralPlaza",parent)
	local center=CFrame.new(ORIGIN)
	local rng=Random.new(751)
	disc(plaza,"Foundation",R+2,5,center*CFrame.new(0,-2.5,0),STONE_DARK,Enum.Material.Slate)
	-- Squared foundation buttresses anchor the terrace to the mountain instead of stacked discs.
	for k=0,7 do
		local base=polar(math.rad(k*45),R-2,-8)
		part(plaza,"FoundationButtress",Vector3.new(8,16,11),base,ROCK,Enum.Material.Rock)
	end
	disc(plaza,"CliffFoot",R-2,30,center*CFrame.new(0,-20,0),ROCK,Enum.Material.Rock)
	-- Individually laid flagstones, with an axial route and two recessed reflecting basins.
	for x=-6,6 do
		for z=-6,6 do
			local px,pz=x*6.5,z*6.5
			local pool=math.abs(px)>10 and math.abs(px)<23 and math.abs(pz)<18
			if px*px+pz*pz<(R-1)^2 and not pool then
				local shade=FLAG_DARK:Lerp(FLAG_LIGHT,rng:NextNumber(0,0.7))
				if x==0 then shade=Color3.fromRGB(94,99,94) end
				part(plaza,"Flagstone",Vector3.new(6.36,0.22,6.36),center*CFrame.new(px,0.02+rng:NextNumber(-0.015,0.015),pz),shade,Enum.Material.Slate)
			end
		end
	end
	for side=-1,1,2 do
		local pool=center*CFrame.new(side*16.25,0,0)
		part(plaza,"Basin",Vector3.new(12.9,0.1,32.4),pool*CFrame.new(0,0.02,0),SHADOW,Enum.Material.Slate)
		part(plaza,"StillWater",Vector3.new(12.5,0.05,32),pool*CFrame.new(0,0.09,0),WATER,Enum.Material.Glass,
			{Collide=false,Query=false,Shadow=false,Transparency=0.28,Reflectance=0.38})
		for edge=-1,1,2 do
			part(plaza,"BasinCoping",Vector3.new(0.45,0.3,33),pool*CFrame.new(edge*6.5,0.16,0),STONE_DARK,Enum.Material.Slate)
			part(plaza,"BasinCoping",Vector3.new(13.4,0.3,0.5),pool*CFrame.new(0,0.16,edge*16.5),STONE_DARK,Enum.Material.Slate)
		end
		for z=-36,36,12 do
			part(plaza,"InlaidPathEdge",Vector3.new(0.1,0.04,7.5),center*CFrame.new(side*4,0.15,z),BRONZE,Enum.Material.Metal,decor())
		end
	end
	-- Crimson Petals drift across the wet plaza stones matching lobby concept art
	local petalAnchor = part(plaza, "PetalAnchor", Vector3.new(R * 1.6, 1, R * 1.6), center * CFrame.new(0, 32, 0), STONE, Enum.Material.SmoothPlastic,
		{ Collide = false, Query = false, Shadow = false, Transparency = 1 })
	local petals = Instance.new("ParticleEmitter")
	petals.Name = "FallingPetals"
	petals.Texture = TEXTURE_MOTE
	petals.Rate = 12
	petals.Lifetime = NumberRange.new(7, 12)
	petals.Speed = NumberRange.new(1.2, 2.8)
	petals.SpreadAngle = Vector2.new(45, 45)
	petals.Acceleration = Vector3.new(1.5, -1.1, 0.8)
	petals.Drag = 0.45
	petals.Size = sequence({ { 0, 0.35 }, { 0.5, 0.45 }, { 1, 0.22 } })
	petals.Transparency = sequence({ { 0, 0.15 }, { 0.8, 0.35 }, { 1, 1 } })
	petals.Color = colors(Color3.fromRGB(188, 38, 48), Color3.fromRGB(118, 22, 28))
	petals.LightEmission = 0.2
	petals.LightInfluence = 0.85
	petals.Parent = petalAnchor
	-- A low bronze incense altar: the player, rather than a bonfire particle, supplies the scale.
	disc(plaza,"AltarStep",4.6,0.4,center*CFrame.new(0,0.32,0),STONE,Enum.Material.Slate)
	disc(plaza,"AltarDais",3.4,0.7,center*CFrame.new(0,0.85,0),STONE_DARK,Enum.Material.Slate)
	disc(plaza,"BronzeLip",2,0.18,center*CFrame.new(0,1.4,0),BRONZE,Enum.Material.Metal)
	disc(plaza,"AshBowl",1.8,0.5,center*CFrame.new(0,1.55,0),IRON,Enum.Material.Metal)
	local anchor=part(plaza,"AltarAnchor_"..BONFIRE_ALTAR.Id,Vector3.new(1,0.2,1),center*CFrame.new(0,LAYOUT.PlinthHeight,0),STONE,Enum.Material.Slate,
		{Collide=false,Query=false,Transparency=1,Shadow=false})
	local coals=disc(plaza,"BankedEmbers",1.35,0.1,center*CFrame.new(0,1.84,0),Color3.fromRGB(139,59,28),Enum.Material.Neon,decor())
	for k=0,8 do
		local a=math.rad(k*40)
		part(plaza,"Incense",Vector3.new(0.035,1.2,0.035),center*CFrame.new(math.cos(a)*0.75,2.3,math.sin(a)*0.75)*CFrame.Angles(math.rad(9),0,math.rad(9)),WOOD,Enum.Material.Wood,decor())
	end
	local flame=Instance.new("ParticleEmitter")
	flame.Name="RitualFlame"
	flame.Texture=TEXTURE_FIRE
	flame.Rate=9
	flame.Lifetime=NumberRange.new(0.5,0.85)
	flame.Speed=NumberRange.new(0.7,1.8)
	flame.SpreadAngle=Vector2.new(8,8)
	flame.Size=sequence({{0,0.65},{0.5,0.8},{1,0}})
	flame.Transparency=sequence({{0,0.35},{0.7,0.55},{1,1}})
	flame.Color=colors(LANTERN,Color3.fromRGB(174,67,31))
	flame.LightEmission=0.6
	flame.Parent=coals
	embers(coals,3,15,0.4)
	light(coals,LANTERN,23,1.65,true)
	local smoke=Instance.new("ParticleEmitter")
	smoke.Texture=TEXTURE_SMOKE
	smoke.Rate=2
	smoke.Lifetime=NumberRange.new(4,7)
	smoke.Speed=NumberRange.new(0.5,0.9)
	smoke.Acceleration=Vector3.new(0.15,0.15,0)
	smoke.Size=sequence({{0,0.3},{1,2.5}})
	smoke.Transparency=sequence({{0,0.95},{0.25,0.82},{1,1}})
	smoke.Color=colors(Color3.fromRGB(145,150,145),Color3.fromRGB(95,110,116))
	smoke.Parent=coals
	-- Covered corner cloisters frame the camera with timber, stone and repeated roof profiles.
	for _,position in {{-29,-28},{29,-28},{-29,28},{29,28}} do
		local bay=folder("CornerCloister",plaza)
		local base=center*CFrame.new(position[1],0,position[2])
		part(bay,"RaisedSill",Vector3.new(21,0.4,9),base*CFrame.new(0,0.3,0),STONE_DARK,Enum.Material.Slate)
		for x=-1,1,2 do
			for z=-1,1,2 do
				part(bay,"ColumnFoot",Vector3.new(2.3,0.7,2.3),base*CFrame.new(x*8,0.8,z*2.8),STONE,Enum.Material.Slate)
				part(bay,"LacquerColumn",Vector3.new(1.1,10,1.1),base*CFrame.new(x*8,6.1,z*2.8),BANNER_RED,Enum.Material.Wood)
				part(bay,"ColumnCapital",Vector3.new(2.2,0.45,2.2),base*CFrame.new(x*8,11.2,z*2.8),WOOD,Enum.Material.Wood)
			end
		end
		for z=-1,1,2 do
			part(bay,"Crossbeam",Vector3.new(22,1,1.1),base*CFrame.new(0,11.7,z*3),WOOD,Enum.Material.Wood)
		end
		roof(bay,base*CFrame.new(0,11.5,0),25,12)
		lantern(bay,base*CFrame.new(0,8.5,0),true)
		-- Slatted back screens give a dark background to the warm lantern, without closing paths.
		local back=if position[2]>0 then 3.6 else -3.6
		part(bay,"ScreenSill",Vector3.new(17,1.6,0.3),base*CFrame.new(0,1.5,back),STONE_DARK,Enum.Material.Slate)
		for x=-7,7,1.4 do
			part(bay,"Lattice",Vector3.new(0.13,6,0.16),base*CFrame.new(x,5.3,back),WOOD,Enum.Material.Wood,decor())
		end
		part(bay,"ScreenRail",Vector3.new(17,0.18,0.3),base*CFrame.new(0,7.6,back),WOOD,Enum.Material.Wood,decor())
	end
	-- Low perimeter walls leave the four routes open and stop accidental walks into the clouds.
	for k=0,31 do
		local angle=(k+0.5)*math.pi*2/32
		local axial=math.min(k%8,7-k%8)<1
		if not axial then
			local base=polar(angle,R-1,0)
			part(plaza,"Parapet",Vector3.new(8.9,2.4,1.3),base*CFrame.new(0,1.2,0),STONE_DARK,Enum.Material.Slate)
			part(plaza,"ParapetCap",Vector3.new(9,0.25,1.8),base*CFrame.new(0,2.55,0),STONE,Enum.Material.Slate)
		end
	end
	for _,location in {{-7,17},{7,17},{-7,-21},{7,-21}} do
		lantern(plaza,center*CFrame.new(location[1],0.15,location[2]))
	end
	for _,angle in {45,135,225,315} do
		local base=polar(math.rad(angle),37,0)*CFrame.Angles(0,math.pi,0)
		part(plaza,"MemorialFoot",Vector3.new(3.8,0.5,3),base*CFrame.new(0,0.25,0),STONE_DARK,Enum.Material.Slate)
		part(plaza,"MemorialStele",Vector3.new(2.6,6.8,0.9),base*CFrame.new(0,3.9,0),STONE,Enum.Material.Slate)
		local plaque=part(plaza,"ErodedInscription",Vector3.new(1.8,4.7,0.08),base*CFrame.new(0,4,-0.5),STONE_DARK,Enum.Material.Slate,decor())
		inscription(plaque,"REMEMBER\nDEATH")
		part(plaza,"MemorialCap",Vector3.new(3.4,0.5,1.7),base*CFrame.new(0,7.4,0),STONE_DARK,Enum.Material.Slate)
	end
	return anchor
end

-------------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------------
-- 2. Ascension Gateway (north, -Z)
-------------------------------------------------------------------------------------------------

local function buildGateway(parent: Folder): BasePart
	local gate=folder("AscensionGateway",parent)
	local center=CFrame.new(ORIGIN)
	local steps,rise,run,width=LAYOUT.StairSteps,LAYOUT.StairRise,LAYOUT.StairRun,LAYOUT.StairWidth
	-- A paved approach joins the courtyard to the staircase.
	part(gate,"Approach",Vector3.new(width+4,0.3,20),center*CFrame.new(0,0.02,-38),FLAG_DARK,Enum.Material.Slate)
	for i=1,steps do
		local height=i*rise+6
		local z=-(STAIR_START+(i-0.5)*run)
		part(gate,"Step"..i,Vector3.new(width,height,run+0.03),center*CFrame.new(0,i*rise-height*0.5,z),FLAG_DARK:Lerp(FLAG_LIGHT,(i%3)*0.2),Enum.Material.Slate)
		part(gate,"TreadNosing",Vector3.new(width,0.12,0.22),center*CFrame.new(0,i*rise+0.03,z+run*0.5-0.1),STONE,Enum.Material.Slate,decor())
		for side=-1,1,2 do
			part(gate,"StairCheek",Vector3.new(1.4,height+2.2,run+0.03),center*CFrame.new(side*(width*0.5+0.7),i*rise-height*0.5+1.1,z),STONE_DARK,Enum.Material.Slate)
		end
		if i==4 or i==12 or i==19 then
			for side=-1,1,2 do lantern(gate,center*CFrame.new(side*(width*0.5+0.7),i*rise+2.2,z)) end
		end
	end
	local top=steps*rise
	local landingStart=STAIR_START+steps*run
	part(gate,"Landing",Vector3.new(42,10,LANDING_DEPTH+3),center*CFrame.new(0,top-5,-landingStart-LANDING_DEPTH*0.5),STONE_DARK,Enum.Material.Slate)
	local floor=center*CFrame.new(0,top,-landingStart-ARCH_OFFSET)
	-- Paifang gatehouse: stone jambs, oxblood timber and two tiers of curved tile eaves.
	for side=-1,1,2 do
		for row=0,3 do
			part(gate,"MasonryJamb",Vector3.new(3.2,3.1,4.4),floor*CFrame.new(side*8.6,1.55+row*3.1,0),if row%2==0 then STONE else FLAG_DARK,Enum.Material.Slate)
		end
		part(gate,"JambFoot",Vector3.new(4.4,0.6,5.4),floor*CFrame.new(side*8.6,0.3,0),STONE,Enum.Material.Slate)
		part(gate,"TimberColumn",Vector3.new(1.4,10,1.4),floor*CFrame.new(side*14,5,0),BANNER_RED,Enum.Material.Wood)
		part(gate,"SideScreen",Vector3.new(4.5,7,0.6),floor*CFrame.new(side*12,5,0.3),WOOD,Enum.Material.Wood)
		for y=3,8,1.2 do part(gate,"ScreenLouvre",Vector3.new(3.5,0.13,0.3),floor*CFrame.new(side*12,y,-0.12),BRONZE,Enum.Material.Wood,decor()) end
		lantern(gate,floor*CFrame.new(side*6.6,9.2,2.9),true)
	end
	part(gate,"Lintel",Vector3.new(32,1.4,4.8),floor*CFrame.new(0,12.9,0),WOOD,Enum.Material.Wood)
	part(gate,"LintelInset",Vector3.new(12.8,0.18,0.18),floor*CFrame.new(0,12.2,2.5),BRONZE,Enum.Material.Metal,decor())
	roof(gate,floor*CFrame.new(0,13.3,0),39,13)
	part(gate,"UpperStorey",Vector3.new(15,4.5,5),floor*CFrame.new(0,18,0),WOOD,Enum.Material.Wood)
	local plaque=part(gate,"GateTablet",Vector3.new(8,2.6,0.22),floor*CFrame.new(0,18.2,2.65),SHADOW,Enum.Material.Wood,decor())
	inscription(plaque,"PATH OF THE ASURA",Enum.NormalId.Back)
	roof(gate,floor*CFrame.new(0,20.2,0),23,9)
	-- Restrained jade mist, dark enough to read the gate's frame and the destination beyond it.
	local veilSize=Vector3.new(13,11.4,0.2)
	local cf=floor*CFrame.new(0,5.8,0)
	local veil=part(gate,"PortalVeil",veilSize,cf,Color3.fromRGB(36,65,66),Enum.Material.Glass,
		{Collide=false,Query=false,Transparency=0.2,Reflectance=0.1,Shadow=false})
	for side=-1,1,2 do
		part(gate,"PortalSeam",Vector3.new(0.06,11.3,0.1),cf*CFrame.new(side*6.4,0,0.15),PORTAL,Enum.Material.Neon,decor())
	end
	light(veil,PORTAL,16,0.8,false)
	local mist=Instance.new("ParticleEmitter")
	mist.Texture=TEXTURE_SMOKE
	mist.Rate=4
	mist.Lifetime=NumberRange.new(3,4)
	mist.Speed=NumberRange.new(0.2,0.6)
	mist.SpreadAngle=Vector2.new(30,15)
	mist.Size=sequence({{0,2},{1,6}})
	mist.Transparency=sequence({{0,1},{0.3,0.85},{1,1}})
	mist.Color=colors(PORTAL,Color3.fromRGB(72,103,112))
	mist.LightEmission=0.15
	mist.Parent=veil
	local trigger=part(gate,"PortalTrigger",Vector3.new(13,11.4,2.4),cf,PORTAL,Enum.Material.SmoothPlastic,
		{Collide=false,Query=false,Transparency=1,Shadow=false})
	trigger.CanTouch=true
	return trigger
end

-------------------------------------------------------------------------------------------------
-- 3. Blacksmith Loggia
-------------------------------------------------------------------------------------------------

local function buildSmithFigure(parent: Instance, base: CFrame)
	-- Stone-coloured stand-in used only if the avatar rig cannot be created.
	local model = Instance.new("Model")
	model.Name = "MasterSmithGao"
	part(model, "Legs", Vector3.new(2, 2.4, 1), base * CFrame.new(0, 1.2, 0), Color3.fromRGB(40, 34, 30), Enum.Material.Fabric)
	part(model, "Torso", Vector3.new(2.2, 2.4, 1.2), base * CFrame.new(0, 3.6, 0), Color3.fromRGB(70, 48, 36), Enum.Material.Leather)
	part(model, "Head", Vector3.new(1.3, 1.3, 1.3), base * CFrame.new(0, 5.5, 0), Color3.fromRGB(176, 128, 96), Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball })
	model.Parent = parent
end

local function spawnSmith(parent: Instance, base: CFrame)
	task.spawn(function()
		local description = Instance.new("HumanoidDescription")
		local skin = Color3.fromRGB(176, 128, 96)
		description.HeadColor = skin
		description.LeftArmColor = skin
		description.RightArmColor = skin
		description.TorsoColor = Color3.fromRGB(70, 48, 36)
		description.LeftLegColor = Color3.fromRGB(40, 34, 30)
		description.RightLegColor = Color3.fromRGB(40, 34, 30)
		local ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
		end)
		if not running or not parent.Parent then
			if ok and model then
				model:Destroy()
			end
			return
		end
		if not ok or not model then
			warn("[Sanctuary] Blacksmith rig unavailable, using the stone figure: " .. tostring(model))
			buildSmithFigure(parent, base)
			return
		end
		model.Name = "MasterSmithGao"
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if humanoid then
			humanoid.DisplayName = "Master Smith Gao"
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			humanoid.NameDisplayDistance = 40
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
		if rootPart and rootPart:IsA("BasePart") then
			rootPart.Anchored = true
		end
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		model:PivotTo(base * CFrame.new(0, 3, 0))
		model.Parent = parent
		-- Idle from the catalog keeps the smith out of a bind pose until a custom idle is set.
		if humanoid then
			local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
			animator.Parent = humanoid
			local idle = Animations.weapon("Unarmed", "Idle")
			local animation = Instance.new("Animation")
			animation.AnimationId = Animations.resolve(idle, "R15")
			local loaded, track = pcall(function()
				return (animator :: Animator):LoadAnimation(animation)
			end)
			if loaded and track then
				track.Looped = true
				track.Priority = Enum.AnimationPriority.Idle
				track:Play(0.2, 1, Animations.speed(idle))
			end
		end
	end)
end

local function buildLoggia(parent: Folder): (ProximityPrompt, ProximityPrompt)
	local loggia = folder("BlacksmithLoggia", parent)
	local base = CFrame.new(LOGGIA)
	local center = CFrame.new(ORIGIN)

	-- Walkway from the plaza's west edge.
	local walkStart, walkEnd = R - 2, (ORIGIN.X - LOGGIA.X) - 17
	local walkLength = walkEnd - walkStart
	local walk = center * CFrame.new(-(walkStart + walkLength * 0.5), 0, 0)
	part(loggia, "Walkway", Vector3.new(walkLength, 3, 12), walk * CFrame.new(0, -1.5, 0), FLAG_DARK, Enum.Material.Slate)
	part(loggia, "WalkwaySupport", Vector3.new(walkLength - 4, 10, 8), walk * CFrame.new(0, -8, 0), ROCK, Enum.Material.Rock, { Shadow = false })
	for side = -1, 1, 2 do
		part(loggia, "WalkRail" .. side, Vector3.new(walkLength, 1.4, 0.8), walk * CFrame.new(0, 0.7, side * 6.4), STONE_DARK, Enum.Material.Slate)
	end

	-- Platform and pavilion.
	part(loggia, "Platform", Vector3.new(36, 6, 36), base * CFrame.new(0, -3, 0), FLAG_LIGHT, Enum.Material.Slate)
	disc(loggia, "PlatformRoot", 16, 30, base * CFrame.new(0, -21, 0), ROCK, Enum.Material.Rock, { Shadow = false })
	local pierHeight = 15
	for _, corner in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		part(loggia, "Pier", Vector3.new(2.6, pierHeight, 2.6), base * CFrame.new(corner[1] * 15, pierHeight * 0.5, corner[2] * 15), STONE, Enum.Material.Slate)
	end
	for index, lintel in { { 0, 15, 32.6, 2.6 }, { 0, -15, 32.6, 2.6 }, { 15, 0, 2.6, 32.6 }, { -15, 0, 2.6, 32.6 } } do
		part(loggia, "Lintel" .. index, Vector3.new(lintel[3], 2.4, lintel[4]), base * CFrame.new(lintel[1], pierHeight + 1.2, lintel[2]), STONE, Enum.Material.Slate)
	end
	-- Arch braces suggest pointed openings on the three open faces.
	for _, face in { { 15, 0 }, { 0, 15 }, { 0, -15 } } do
		for side = -1, 1, 2 do
			local along = if face[1] ~= 0 then CFrame.new(face[1], pierHeight - 2.2, side * 11.5) else CFrame.new(side * 11.5, pierHeight - 2.2, face[2])
			local tilt = if face[1] ~= 0 then CFrame.Angles(side * math.rad(38), 0, 0) else CFrame.Angles(0, 0, -side * math.rad(38))
			part(loggia, "Brace", if face[1] ~= 0 then Vector3.new(2.2, 1.2, 7) else Vector3.new(7, 1.2, 2.2), base * along * tilt, STONE, Enum.Material.Slate)
		end
	end
	roof(loggia, base * CFrame.new(0, pierHeight + 2, 0), 42, 37)
	part(loggia, "BackWall", Vector3.new(1.6, pierHeight, 30), base * CFrame.new(-15.8, pierHeight * 0.5, 0), STONE_DARK, Enum.Material.Slate)
	for side = -1, 1, 2 do
		part(loggia, "LowWall" .. side, Vector3.new(30, 4, 1.2), base * CFrame.new(-0.5, 2, side * 15.6), STONE_DARK, Enum.Material.Slate)
	end

	-- Forge furnace against the back wall.
	part(loggia, "Forge", Vector3.new(7, 6, 6), base * CFrame.new(-12, 3, 0), BRICK, Enum.Material.Brick)
	part(loggia, "ForgeHood", Vector3.new(8, 3, 7), base * CFrame.new(-12, 7.5, 0), STONE_DARK, Enum.Material.Slate)
	part(loggia, "Chimney", Vector3.new(3, 14, 3), base * CFrame.new(-13, 15, 0), BRICK, Enum.Material.Brick)
	local mouth = part(loggia, "ForgeMouth", Vector3.new(0.3, 2.4, 3.4), base * CFrame.new(-8.35, 2.6, 0), Color3.fromRGB(255, 96, 36), Enum.Material.Neon,
		{ Collide = false, Query = false, Shadow = false })
	fire(mouth, 4, 6, Color3.fromRGB(255, 110, 40), Color3.fromRGB(200, 40, 20))
	local forgeEmbers = embers(mouth, 16, 25, 6)
	forgeEmbers.EmissionDirection = Enum.NormalId.Right
	light(mouth, Color3.fromRGB(255, 110, 50), 24, 2.6, true)

	-- Anvil on a stump, and a weapon rack.
	disc(loggia, "Stump", 1.2, 2, base * CFrame.new(-4, 1, 3), WOOD, Enum.Material.Wood)
	part(loggia, "AnvilBody", Vector3.new(1.3, 0.9, 2.8), base * CFrame.new(-4, 2.45, 3), Color3.fromRGB(58, 58, 62), Enum.Material.Metal)
	part(loggia, "AnvilHorn", Vector3.new(1.0, 0.9, 1.3), base * CFrame.new(-4, 2.45, 5.0), Color3.fromRGB(58, 58, 62), Enum.Material.Metal, { Class = "WedgePart" })
	part(loggia, "Rack", Vector3.new(0.5, 4, 6), base * CFrame.new(-14.2, 2, -10), WOOD, Enum.Material.Wood)
	for k = -1, 1 do
		part(loggia, "RackBlade" .. (k + 2), Vector3.new(0.15, 3.8, 0.4), base * CFrame.new(-13.7, 2.6, -10 + k * 1.8) * CFrame.Angles(math.rad(-8), 0, 0),
			Color3.fromRGB(190, 194, 200), Enum.Material.Metal, decor())
	end

	-- The smith stands beside the anvil facing the plaza; prompts live on a fixed anchor so they
	-- work immediately, even while (or if) the avatar rig is still loading.
	local stand = base * CFrame.new(-2, 0, -1)
	local facing = CFrame.lookAt(stand.Position, stand.Position + Vector3.xAxis)
	smithPosition = stand.Position
	spawnSmith(loggia, facing)
	local promptAnchor = part(loggia, "SmithPrompts", Vector3.new(2, 5, 2), facing * CFrame.new(0, 2.5, 0), STONE, Enum.Material.SmoothPlastic,
		{ Collide = false, Query = false, Transparency = 1, Shadow = false })
	local reinforce = Instance.new("ProximityPrompt")
	reinforce.Name = "ReinforcePrompt"
	reinforce.ActionText = "Reinforce Weapon"
	reinforce.ObjectText = "Master Smith Gao"
	reinforce.KeyboardKeyCode = Enum.KeyCode.E
	reinforce.GamepadKeyCode = Enum.KeyCode.ButtonX
	reinforce.HoldDuration = 0.6
	reinforce.MaxActivationDistance = SMITH_RADIUS
	reinforce.RequiresLineOfSight = false
	reinforce.Parent = promptAnchor
	local refill = Instance.new("ProximityPrompt")
	refill.Name = "RefillPrompt"
	refill.ActionText = "Refill Elixir Gourd"
	refill.ObjectText = "Master Smith Gao"
	refill.KeyboardKeyCode = Enum.KeyCode.C
	refill.GamepadKeyCode = Enum.KeyCode.DPadLeft
	refill.HoldDuration = 0.3
	refill.MaxActivationDistance = SMITH_RADIUS
	refill.RequiresLineOfSight = false
	refill.UIOffset = Vector2.new(0, 72)
	refill.Parent = promptAnchor
	return reinforce, refill
end

-------------------------------------------------------------------------------------------------
-- 4. Colosseum Promenade (east, +X)
-------------------------------------------------------------------------------------------------

local function buildBrazier(parent: Instance, base: CFrame, index: number)
	part(parent, "BrazierStand" .. index, Vector3.new(0.5, 4.2, 0.5), base * CFrame.new(0, 2.1, 0), IRON, Enum.Material.Metal)
	for leg = 0, 2 do
		part(parent, "BrazierLeg" .. index .. leg, Vector3.new(0.3, 1.8, 0.3),
			base * CFrame.Angles(0, math.rad(120 * leg), 0) * CFrame.new(0, 0.8, -0.6) * CFrame.Angles(math.rad(-30), 0, 0), IRON, Enum.Material.Metal, decor())
	end
	disc(parent, "BrazierBowl" .. index, 1.4, 0.8, base * CFrame.new(0, 4.6, 0), IRON, Enum.Material.Metal)
	local coals = disc(parent, "BrazierCoals" .. index, 1.1, 0.2, base * CFrame.new(0, 5.05, 0), EMBER, Enum.Material.Neon, decor())
	fire(coals, 2, 3, Color3.fromRGB(255, 150, 60), Color3.fromRGB(220, 60, 20))
	embers(coals, 6, 30, 3)
	light(coals, Color3.fromRGB(255, 170, 100), 15, 0.8, false)
end

local function buildBanner(parent: Instance, base: CFrame, index: number)
	part(parent, "BannerPole" .. index, Vector3.new(0.6, 16, 0.6), base * CFrame.new(0, 8, 0), IRON, Enum.Material.Metal)
	part(parent, "BannerBar" .. index, Vector3.new(3.8, 0.3, 0.3), base * CFrame.new(0, 15.4, -0.5), IRON, Enum.Material.Metal, decor())
	part(parent, "Banner" .. index, Vector3.new(3.4, 9, 0.12), base * CFrame.new(0, 10.8, -0.6), BANNER_RED, Enum.Material.Fabric, decor())
	part(parent, "BannerBand" .. index, Vector3.new(3.42, 1.1, 0.14), base * CFrame.new(0, 7.2, -0.6), BANNER_BLACK, Enum.Material.Fabric, decor())
	part(parent, "BannerTail" .. index, Vector3.new(3.4, 1.2, 0.12), base * CFrame.new(0, 5.7, -0.6), BANNER_RED, Enum.Material.Fabric, decor())
end

local function buildPromenade(parent: Folder)
	local promenade = folder("ColosseumPromenade", parent)
	local base = CFrame.new(PROMENADE)
	local center = CFrame.new(ORIGIN)

	local walkStart, walkEnd = R - 2, (PROMENADE.X - ORIGIN.X) - BALCONY_APOTHEM + 2
	local walkLength = walkEnd - walkStart
	local walk = center * CFrame.new(walkStart + walkLength * 0.5, 0, 0)
	part(promenade, "Walkway", Vector3.new(walkLength, 3, 12), walk * CFrame.new(0, -1.5, 0), FLAG_DARK, Enum.Material.Slate)
	part(promenade, "WalkwaySupport", Vector3.new(walkLength - 4, 10, 8), walk * CFrame.new(0, -8, 0), ROCK, Enum.Material.Rock, { Shadow = false })
	for side = -1, 1, 2 do
		part(promenade, "WalkRail" .. side, Vector3.new(walkLength, 1.4, 0.8), walk * CFrame.new(0, 0.7, side * 6.4), STONE_DARK, Enum.Material.Slate)
	end

	-- Octagonal balcony (two squares sharing an apothem) jutting over the clouds.
	for index = 0, 1 do
		part(promenade, "Balcony" .. index, Vector3.new(BALCONY_APOTHEM * 2, 5, BALCONY_APOTHEM * 2), base * CFrame.Angles(0, math.rad(45 * index), 0) * CFrame.new(0, -2.5, 0),
			FLAG_LIGHT, Enum.Material.Slate)
	end
	disc(promenade, "Corbel", 26, 18, base * CFrame.new(0, -14, 0), ROCK, Enum.Material.Rock, { Shadow = false })
	disc(promenade, "CorbelRoot", 14, 28, base * CFrame.new(0, -37, 0), ROCK, Enum.Material.Rock, { Shadow = false })

	-- Balustrade on every edge except the west entry (edge 2 faces -X).
	local edge = 2 * BALCONY_APOTHEM * math.tan(math.rad(22.5))
	for k = 0, 7 do
		if k ~= 2 then
			local frame = base * CFrame.Angles(0, math.rad(45 * k), 0) * CFrame.new(0, 0, -(BALCONY_APOTHEM - 0.7))
			part(promenade, "Plinth" .. k, Vector3.new(edge, 0.6, 1.2), frame * CFrame.new(0, 0.3, 0), STONE_DARK, Enum.Material.Slate)
			part(promenade, "Rail" .. k, Vector3.new(edge + 0.8, 0.7, 1.4), frame * CFrame.new(0, 3.35, 0), STONE, Enum.Material.Slate)
			for j = 1, 5 do
				part(promenade, "Baluster" .. k .. "_" .. j, Vector3.new(0.7, 2.4, 0.7), frame * CFrame.new(-edge * 0.5 + (j - 0.5) * edge / 5, 1.8, 0), STONE, Enum.Material.Slate)
			end
		end
	end
	local vertexRadius = BALCONY_APOTHEM / math.cos(math.rad(22.5)) - 1.4
	for k = 0, 7 do
		local angle = math.rad(45 * k + 22.5)
		local vertex = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -vertexRadius)
		part(promenade, "Post" .. k, Vector3.new(1.6, 4.4, 1.6), vertex * CFrame.new(0, 2.2, 0), STONE, Enum.Material.Slate)
		if k == 1 or k == 2 then
			buildBrazier(promenade, vertex * CFrame.new(0, 4.4, 0), k)
		else
			buildBanner(promenade, vertex * CFrame.new(0, 4.4, 0), k)
		end
	end
	for index, k in { 0, 4, 6 } do
		local mid = base * CFrame.Angles(0, math.rad(45 * k), 0) * CFrame.new(0, 0, -(BALCONY_APOTHEM - 3.5))
		buildBrazier(promenade, mid, 10 + index)
	end
end

-------------------------------------------------------------------------------------------------
-- 5. Sea of clouds and the horizon
-------------------------------------------------------------------------------------------------

local function buildSky(parent: Folder)
	local sky=folder("ValleyMist",parent)
	-- Soft particle banks replace the opaque cloud slabs and visible plastic spheres.
	for k=0,7 do
		local angle=math.rad(k*45)
		local anchor=part(sky,"MistBank",Vector3.new(150,5,110),CFrame.new(ORIGIN+Vector3.new(math.cos(angle)*190,-48,math.sin(angle)*190)),STONE,Enum.Material.SmoothPlastic,
			{Collide=false,Query=false,Transparency=1,Shadow=false})
		local mist=Instance.new("ParticleEmitter")
		mist.Texture=TEXTURE_SMOKE
		mist.Rate=1.2
		mist.Lifetime=NumberRange.new(18,25)
		mist.Speed=NumberRange.new(0.1,0.5)
		mist.Acceleration=Vector3.new(0.4,0,0.12)
		mist.Shape=Enum.ParticleEmitterShape.Box
		mist.ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume
		mist.Size=sequence({{0,65},{1,110}})
		mist.Transparency=sequence({{0,1},{0.2,0.86},{0.7,0.9},{1,1}})
		mist.Color=colors(Color3.fromRGB(102,128,140),Color3.fromRGB(135,151,157))
		mist.LightInfluence=0.7
		mist.Parent=anchor
	end
end

local function buildHorizon(parent: Folder)
	local horizon=folder("KarstMountains",parent)
	local rng=Random.new(9091)
	for k=0,17 do
		local angle=math.rad(k*20)+rng:NextNumber(-0.1,0.1)
		local distance=rng:NextNumber(260,750)
		local height=rng:NextNumber(150,310)
		local width=rng:NextNumber(65,140)
		local base=CFrame.new(ORIGIN+Vector3.new(math.sin(angle)*distance,-140,math.cos(angle)*distance))*CFrame.Angles(0,angle,0)
		for lobe=-1,1 do
			local h=height*rng:NextNumber(0.6,1.1)
			part(horizon,"KarstFace",Vector3.new(width*0.65,h,width*0.9),base*CFrame.new(lobe*width*0.25,h*0.5,0)*CFrame.Angles(0,rng:NextNumber(-0.5,0.5),math.rad(rng:NextNumber(-10,10))),
				SILHOUETTE:Lerp(ROCK,rng:NextNumber(0.1,0.6)),Enum.Material.Rock,{Class="WedgePart",Collide=false,Query=false,Shadow=false})
		end
		-- A few distant pagoda roofs establish a world beyond this one courtyard.
		if k==3 or k==10 or k==15 then
			local tower=base*CFrame.new(0,height*0.6,0)
			for tier=0,2 do
				part(horizon,"DistantPagoda",Vector3.new(12-tier*2,7,12-tier*2),tower*CFrame.new(0,tier*10,0),SILHOUETTE,Enum.Material.Slate,decor())
				part(horizon,"DistantEave",Vector3.new(20-tier*3,0.8,20-tier*3),tower*CFrame.new(0,tier*10+7,0),SILHOUETTE,Enum.Material.Slate,decor())
			end
		end
	end
end

-------------------------------------------------------------------------------------------------
-- 6. Colossus Asura Sanctuary Dais (matching lobby concept art)
-------------------------------------------------------------------------------------------------

local function buildHeroStatueDais(parent: Folder)
	local statueGroup = folder("ColossusSanctuary", parent)
	local center = CFrame.new(ORIGIN)
	-- Offset behind the central pool (toward North-East at roughly X = 10, Z = -32)
	local daisBase = center * CFrame.new(10, 0, -32)

	-- Monumental tiered ruined stone plinth supporting the colossus
	disc(statueGroup, "StatueBaseTier1", 28, 3.5, daisBase * CFrame.new(0, 1.75, 0), STONE_DARK, Enum.Material.Slate)
	disc(statueGroup, "StatueBaseTier2", 23, 2.8, daisBase * CFrame.new(0, 4.5, 0), STONE, Enum.Material.Slate)
	disc(statueGroup, "StatueBaseTier3", 18, 2.2, daisBase * CFrame.new(0, 7.0, 0), STONE_DARK, Enum.Material.Slate)

	-- Flanking ruin columns with warm lanterns
	for side = -1, 1, 2 do
		for k = 1, 3 do
			local pcf = daisBase * CFrame.new(side * (24 + k * 6), 0, -k * 7)
			local h = 32 - k * 5
			part(statueGroup, "RuinColumn", Vector3.new(4.5, h, 4.5), pcf * CFrame.new(0, h * 0.5, 0), STONE, Enum.Material.Slate)
			part(statueGroup, "ColumnCap", Vector3.new(6.0, 1.8, 6.0), pcf * CFrame.new(0, h + 0.9, 0), STONE_DARK, Enum.Material.Slate)
			lantern(statueGroup, pcf * CFrame.new(0, h * 0.5, 3))
		end
	end

	-- Monumental gothic arch framing behind the colossal titan
	part(statueGroup, "ArchPillarL", Vector3.new(6.0, 75, 6.0), daisBase * CFrame.new(-24, 37.5, -16), STONE, Enum.Material.Slate)
	part(statueGroup, "ArchPillarR", Vector3.new(6.0, 75, 6.0), daisBase * CFrame.new(24, 37.5, -16), STONE, Enum.Material.Slate)
	part(statueGroup, "ArchSpan", Vector3.new(54, 6.0, 7.0), daisBase * CFrame.new(0, 75, -16), STONE_DARK, Enum.Material.Slate)

	-- Hero Statue Anchor point (elevated onto the third plinth tier)
	local anchor = part(statueGroup, "AsuraColossusAnchor", Vector3.new(32, 68, 32), daisBase * CFrame.new(0, 8.2, 0) * CFrame.Angles(0, math.rad(-165), 0), STATUE, Enum.Material.SmoothPlastic,
		{ Collide = false, Query = false, Transparency = 1, Shadow = false })

	-- Stand-in meditating stone titan colossus until custom mesh is inserted
	local titan = folder("StoneTitanProxy", statueGroup)
	part(titan, "ColossusTorso", Vector3.new(18, 26, 14), anchor.CFrame * CFrame.new(0, 16, 0), STATUE, Enum.Material.Slate)
	part(titan, "ColossusShoulders", Vector3.new(28, 7, 16), anchor.CFrame * CFrame.new(0, 29, 0), STONE, Enum.Material.Slate)
	part(titan, "ColossusHead", Vector3.new(11, 13, 11), anchor.CFrame * CFrame.new(0, 39, -1.0), STATUE, Enum.Material.Slate)
	part(titan, "ColossusCrown", Vector3.new(12.5, 6.5, 12.5), anchor.CFrame * CFrame.new(0, 46, -1.0), BRONZE, Enum.Material.Metal)
	for r = -2, 2 do
		part(titan, "RootTendril", Vector3.new(3.2, 28, 3.2), anchor.CFrame * CFrame.new(r * 6.5, 14, -8.0 + math.abs(r) * 2) * CFrame.Angles(math.rad(12), 0, math.rad(r * 15)), Color3.fromRGB(215, 210, 202), Enum.Material.Wood, decor())
	end

	-- Auto-mount listener: automatically mounts and positions titan statue when imported
	task.spawn(function()
		local function isTarget(name: string): boolean
			return name == "AsuraColossusStatue" or name == "titan_statue" or name == "AsceticTitanStatue"
		end

		local function mountModel(model: Instance)
			if model:IsA("Model") then
				titan:Destroy()
				-- Clean up procedural parts: style stone, roots, metal, and keep rich blood leaves
				for _, desc in model:GetDescendants() do
					if desc:IsA("BasePart") then
						desc.Anchored = true
						local lname = desc.Name:lower()
						if lname:find("leaf") or lname:find("leaves") then
							desc.Transparency = 0
							desc.CanCollide = false
							desc.Material = Enum.Material.SmoothPlastic
							desc.Color = Color3.fromRGB(168, 24, 34) -- rich blood crimson sacred leaves
						elseif lname:find("bark") or lname:find("tree") or lname:find("root") then
							desc.Material = Enum.Material.Wood
							desc.Color = Color3.fromRGB(212, 206, 198) -- pale sacred roots
						elseif lname:find("metal") or lname:find("sword") or lname:find("crown") then
							desc.Material = Enum.Material.Metal
							desc.Color = Color3.fromRGB(88, 82, 76)
						else
							desc.Material = Enum.Material.Slate
							desc.Color = Color3.fromRGB(136, 140, 138) -- weathered ancient stone
						end
					end
				end
				-- Screen-dominating Colossus Scale (68 studs tall = 14x taller than the player!)
				local currentSize = model:GetExtentsSize()
				local targetHeight = 68
				if (model :: any).ScaleTo and currentSize.Y > 0 then
					local factor = targetHeight / currentSize.Y
					(model :: any):ScaleTo(factor)
				end
				model:PivotTo(anchor.CFrame)
				model.Parent = statueGroup
			elseif model:IsA("BasePart") then
				titan:Destroy()
				model.CFrame = anchor.CFrame
				model.Parent = statueGroup
			end
		end

		for _, parent in { ReplicatedStorage, Workspace } do
			for _, child in parent:GetChildren() do
				if isTarget(child.Name) then
					mountModel(child)
					return
				end
			end
		end

		ReplicatedStorage.ChildAdded:Connect(function(child)
			if isTarget(child.Name) then
				mountModel(child)
			end
		end)
	end)
end

-------------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------------
-- Behaviour
-------------------------------------------------------------------------------------------------

local function toCFrame(p: World.Placement): CFrame
	return CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, math.rad(p.Yaw), 0)
end

local function result(player: Player, ok: boolean, reason: string)
	player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
end

local function onPortal(hit: BasePart)
	local model = hit:FindFirstAncestorOfClass("Model")
	local player = if model then Players:GetPlayerFromCharacter(model) else nil
	if not player then
		return
	end
	local userId = player.UserId
	local clock = os.clock()
	if (transit[userId] or 0) > clock then
		return
	end
	local e = Characters.GetEntity(userId)
	if not e or e.Model ~= model or e.Fighter.State == "KO" or e.Respawning or Characters.IsInDuel(userId) then
		return
	end
	transit[userId] = clock + PORTAL_COOLDOWN
	Characters.Cinematic(userId, PORTAL_FADE * 2)
	Characters.Cue("PortalTransit", userId, { to = DESTINATION.Id, name = DESTINATION.Name, fade = PORTAL_FADE })
	task.delay(PORTAL_FADE, function()
		local current = Characters.GetEntity(userId)
		if running and current and current.Fighter.State ~= "KO" and not Characters.IsInDuel(userId) then
			Characters.Teleport(userId, toCFrame(DESTINATION.Spawn))
		end
	end)
end

local function poll()
	for _, player in Players:GetPlayers() do
		local userId = player.UserId
		local e = Characters.GetEntity(userId)
		if e and e.Fighter.State ~= "KO" and not e.Respawning and not Characters.IsInDuel(userId) then
			local position = e.Root.Position
			local flat = Vector3.new(position.X - ORIGIN.X, 0, position.Z - ORIGIN.Z)
			if flat.Magnitude < CATCH_RADIUS and position.Y < ORIGIN.Y - CATCH_DEPTH then
				-- The clouds return those who fall back to the bonfire.
				Characters.Teleport(userId, spawnCFrame)
				Characters.Cue("SanctuaryCatch", userId, {})
			end
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function SanctuaryService.Start()
	assert(not running, "SanctuaryService already started")
	assert(BONFIRE_ALTAR.Region == "Sanctuary", "The starting altar must stand in the Sanctuary")
	assert(DESTINATION ~= nil, "Sanctuary portal destination missing")
	running = true
	local existing = Workspace:FindFirstChild(World.Regions.Sanctuary.MapFolder)
	if existing then
		existing:Destroy()
	end
	local sanctuary = Instance.new("Folder")
	sanctuary.Name = World.Regions.Sanctuary.MapFolder
	root = sanctuary
	spawnCFrame = toCFrame(BONFIRE_ALTAR.Spawn)

	buildPlaza(sanctuary)
	local trigger = buildGateway(sanctuary)
	local reinforce, refill = buildLoggia(sanctuary)
	buildPromenade(sanctuary)
	buildHeroStatueDais(sanctuary)
	buildSky(sanctuary)
	buildHorizon(sanctuary)
	sanctuary.Parent = Workspace

	-- Default checkpoint for anyone without a resolved respawn yet (WorldService's altar hook
	-- supersedes it once a Souls session exists).
	table.insert(disconnectors, Characters.OnEntityAdded(function(id: number, kind: Characters.EntityKind)
		if kind == "Player" then
			Characters.SetRespawnPoint(id, spawnCFrame)
		end
	end))
	table.insert(connections, trigger.Touched:Connect(onPortal))
	table.insert(connections, reinforce.Triggered:Connect(function(player: Player)
		local ok, reason = WorldService.Reinforce(player.UserId)
		if not ok then
			result(player, false, reason)
		end
	end))
	table.insert(connections, refill.Triggered:Connect(function(player: Player)
		local ok, reason = WorldService.RefillElixirs(player.UserId)
		result(player, ok, reason)
	end))
	-- The Interact key beside the smith is the reinforce prompt's own key; acknowledge it quietly.
	table.insert(disconnectors, WorldService.RegisterInteractable(function(_userId: number, position: Vector3): (boolean?, string?)
		if (position - smithPosition).Magnitude <= SMITH_RADIUS + 1 then
			return true, "Smith"
		end
		return nil, nil
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		transit[player.UserId] = nil
	end))
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator >= POLL_INTERVAL then
			accumulator = 0
			local ok, problem = pcall(poll)
			if not ok then
				warn("[Sanctuary] Poll failed: " .. tostring(problem))
			end
		end
	end))
end

function SanctuaryService.SpawnCFrame(): CFrame
	return spawnCFrame
end

function SanctuaryService.Contains(position: Vector3): boolean
	return World.regionAt(position.X, position.Y, position.Z) == "Sanctuary"
end

function SanctuaryService.Destroy()
	running = false
	for _, disconnect in disconnectors do
		disconnect()
	end
	table.clear(disconnectors)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	table.clear(transit)
	local folderRoot = root
	if folderRoot then
		folderRoot:Destroy()
		root = nil
	end
end

return SanctuaryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local Catalog=require(Shared.ShopCatalog)
local Schema=require(Shared.ProfileSchema)
local Config=require(Shared.Config)
local Persistence=require(script.Parent.PersistenceService)
local Shop={}
local rng=Random.new()
local policyCache={}
local function canRoll(id)
 if not Config.Release.PurchasesIntegrationPassed then return true end
 -- Cash/spins are potentially paid once product delivery is enabled. Fail closed on policy errors.
 local cached=policyCache[id]
 if cached and cached.expires>os.clock() then return cached.allowed end
 local player=game:GetService("Players"):GetPlayerByUserId(id)
 if not player then return false end
 local ok,info=pcall(function() return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(player) end)
 local allowed=ok and type(info)=="table" and info.ArePaidRandomItemsRestricted==false
 policyCache[id]={allowed=allowed,expires=os.clock()+60}
 return allowed
end
function Shop.RollStyle(id,useToken)
 if not canRoll(id) then return false,"Random purchases are unavailable for this account" end
 local selected,isDuplicate
 local seed=rng:NextNumber() -- Stable across UpdateAsync callback retries.
 local ok,err=Persistence.Transaction(id,function(p)
  if useToken then assert(p.styleSpins>0,"No style spins remaining");p.styleSpins-=1
  else assert(p.fightCash>=Catalog.SpinCostCash,"Insufficient Fight Cash");p.fightCash-=Catalog.SpinCostCash end
  p.pityCounter+=1
  local pool,total={},0
  for _,s in Catalog.Styles do
   if p.pityCounter<Catalog.PityThreshold or s.rarity=="Epic" or s.rarity=="Legendary" then
    table.insert(pool,s);total+=s.weight
   end
  end
  local roll=math.floor(seed*total)+1
  for _,s in pool do roll-=s.weight;if roll<=0 then selected=s;break end end
  if selected.rarity=="Epic" or selected.rarity=="Legendary" then p.pityCounter=0 end
  local entry=assert(p.styles[selected.name]);isDuplicate=entry.unlocked
  if isDuplicate then
   entry.xp+=Catalog.DuplicateXpBonus*(if p.ownedCosmetics.VIP_Pass then 2 else 1)
   entry.level=Schema.Level(entry.xp)
  else entry.unlocked=true end
 end)
 return ok,err,if ok then selected else nil,if ok then isDuplicate else nil
end
function Shop.RollCrate(id,crateId)
 if not canRoll(id) then return false,"Random purchases are unavailable for this account" end
 local crate=Catalog.Crates[crateId]
 if not crate then return false,"Unknown crate" end
 local seed=rng:NextNumber()
 local selected,duplicate
 local ok,err=Persistence.Transaction(id,function(p)
  assert(p.fightCash>=crate.cost,"Insufficient Fight Cash")
  local roll=math.floor(seed*100)+1
  for _,drop in crate.drops do roll-=drop.weight;if roll<=0 then selected=drop.id;break end end
  assert(selected,"Invalid crate odds")
  duplicate=p.ownedCosmetics[selected]==true
  p.fightCash-=crate.cost
  if duplicate then p.fightCash+=crate.refund else p.ownedCosmetics[selected]=true end
 end)
 return ok,err,if ok then selected else nil,if ok then duplicate else nil
end
function Shop.BuyCosmetic(id,itemId)
 local item=Catalog.Cosmetics[itemId];if not item then return false,"Unknown cosmetic" end
 return Persistence.Transaction(id,function(p)
  assert(not p.ownedCosmetics[itemId],"Already owned");assert(p.fightCash>=item.cashPrice,"Insufficient Fight Cash")
  p.fightCash-=item.cashPrice;p.ownedCosmetics[itemId]=true
 end)
end
function Shop.EquipCosmetic(id,itemId)
 local item=Catalog.Cosmetics[itemId];if not item then return false,"Unknown cosmetic" end
 return Persistence.Transaction(id,function(p) assert(p.ownedCosmetics[itemId],"Item is locked");p.equippedCosmetics[item.slot]=itemId end)
end
function Shop.EquipStyle(id,name)
 return Persistence.Transaction(id,function(p) assert(p.styles[name] and p.styles[name].unlocked,"Style is locked");p.activeStyle=name end)
end
function Shop.SaveSettings(id,settings)
 if settings.keybinds~=nil and not Schema.ValidKeybinds(settings.keybinds) then return false,"Invalid or conflicting keybinds" end
 return Persistence.Transaction(id,function(p)
  p.settings.fov=settings.fov;p.settings.sensitivity=settings.sensitivity;p.settings.leftHanded=settings.leftHanded
  if settings.keybinds then p.settings.keybinds=table.clone(settings.keybinds) end
 end)
end
function Shop.BuyBundle() return false,"Developer products require a durable receipt" end
-- Shared server-side grant body for real delivery and the isolated synthetic adapter.
function Shop.GrantBundle(p,bundle)
 if bundle.bundleType=="Cash" then p.fightCash+=bundle.amount
 elseif bundle.bundleType=="Spins" then p.styleSpins+=bundle.amount
 elseif bundle.bundleType=="Pass" then p.ownedCosmetics.VIP_Pass=true
 else error("Unsupported product") end
end
function Shop.ProcessReceipt(receipt)
 local decision=Enum.ProductPurchaseDecision
 -- Delivery of outstanding receipts is independent of whether new purchase prompts are enabled.
 if not Config.Release.PurchasesIntegrationPassed then return decision.NotProcessedYet end
 if not Persistence.Get(receipt.PlayerId) then return decision.NotProcessedYet end
 local bundle
 for _,b in Catalog.Bundles do if b.productId==receipt.ProductId then bundle=b;break end end
 if not bundle then return decision.NotProcessedYet end
 local ok=Persistence.ProcessReceipt(receipt.PlayerId,receipt.PurchaseId,receipt.ProductId,function(p)
  Shop.GrantBundle(p,bundle)
 end)
 return if ok then decision.PurchaseGranted else decision.NotProcessedYet
end
return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
-- ModuleScript: ServerScriptService/AsurasPath/Services/WorldService
-- Story Mode world rules: Incense Altar checkpoints, elixir gourd, death penalty bloodstains and
-- boss fog gates. Live session state (unbanked essence, gourd charges) is committed to the profile
-- through a per-player serial queue so progression writes never overlap or race a release.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local World = require(Shared.Shared.WorldDefinitions)
local Settings = require(Shared.Shared.CombatSettings) :: any
local Weapons = require(Shared.Simulation.WeaponSchema) :: any
local Characters = require(script.Parent:WaitForChild("CharacterService") :: ModuleScript)
local AI = require(script.Parent:WaitForChild("AIService") :: ModuleScript)
local Persistence = require(script.Parent:WaitForChild("PersistenceService") :: ModuleScript) :: any
local ProfileStore = require(script.Parent:WaitForChild("ProfileStore") :: ModuleScript)

type Altar = World.Altar
type FogGate = World.FogGate
type Souls = ProfileStore.Souls

type Commit = { Label: string, Run: (engine: any) -> (boolean, string?) }

type Session = {
	UserId: number,
	Player: Player,
	Elixirs: number,
	MaxElixirs: number,
	Potency: number,
	ElixirsDirty: boolean,
	Unbanked: number,
	ActiveAltar: string,
	Altars: { [string]: boolean },
	Bosses: { [string]: boolean },
	Region: string?,
	Fight: string?,
	Stain: BasePart?,
	StainDeath: number,
	Queue: { Commit },
	Processing: boolean,
	LastFlush: number,
}

type Fight = {
	Gate: FogGate,
	BossId: string,
	BossEntity: number,
	Participants: { [number]: boolean },
	StartedAt: number,
}

local WorldService = {}

local TAG_ALTAR = "AsuraAltar"
local TAG_STAIN = "AsuraBloodstain"
local INTERACT_RADIUS = 6
local FLUSH_INTERVAL = 20
local GATE_INTERVAL = 6 -- ticks (10 Hz)
local BUSY_RETRIES = 40
local POTENCY_STEP = 0.04
-- Static level geometry joins WorldGeometry; CameraProbe collides with nothing else, so client
-- camera spherecasts cast as CameraProbe see walls and floors but never characters or effects.
local WORLD_GROUP = "WorldGeometry"
local PROBE_GROUP = "CameraProbe"

local sessions: { [number]: Session } = {}
local fights: { [string]: Fight } = {}
local altarParts: { [string]: BasePart } = {}
local gateParts: { [string]: BasePart } = {}
local connections: { RBXScriptConnection } = {}
local disconnectors: { () -> () } = {}
local worldFolder: Folder? = nil
-- Other services' interactables (e.g. the Sanctuary blacksmith) answer the Interact intent so a
-- press beside them is acknowledged instead of reporting "nothing nearby".
type Interactable = (userId: number, position: Vector3) -> (boolean?, string?)
local interactables: { Interactable } = {}
local tickCounter = 0
local running = false

-------------------------------------------------------------------------------------------------
-- Geometry helpers
-------------------------------------------------------------------------------------------------

local function toCFrame(p: World.Placement): CFrame
	return CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, math.rad(p.Yaw), 0)
end

local function vec(v: World.Vec3): Vector3
	return Vector3.new(v.X, v.Y, v.Z)
end

local function inBounds(bounds: World.Bounds, position: Vector3): boolean
	return World.contains(bounds, position.X, position.Y, position.Z)
end

local function material(name: string): Enum.Material
	local ok, value = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return if ok and value then value else Enum.Material.Slate
end

local function folder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = name
	created.Parent = parent
	return created
end

local function entityPosition(userId: number): Vector3?
	local e = Characters.GetEntity(userId)
	return if e then e.Root.Position else nil
end

-------------------------------------------------------------------------------------------------
-- Sessions and the serial commit queue
-------------------------------------------------------------------------------------------------

local function engine(): any
	return Persistence.Engine
end

local function souls(userId: number): Souls?
	local profile = Persistence.Get(userId)
	return if profile then profile.souls else nil
end

local function session(userId: number): Session?
	local existing = sessions[userId]
	if existing then
		return existing
	end
	local player = Players:GetPlayerByUserId(userId)
	local record = souls(userId)
	if not player or not record then
		return nil
	end
	local created: Session = {
		UserId = userId,
		Player = player,
		Elixirs = record.inventory.elixirs.charges,
		MaxElixirs = record.inventory.elixirs.max,
		Potency = record.inventory.elixirs.potency,
		ElixirsDirty = false,
		Unbanked = 0,
		ActiveAltar = record.world.activeAltar,
		Altars = table.clone(record.world.altars),
		Bosses = table.clone(record.world.bosses),
		Region = nil,
		Fight = nil,
		Stain = nil,
		StainDeath = 0,
		Queue = {},
		Processing = false,
		LastFlush = os.clock(),
	}
	sessions[userId] = created
	player:SetAttribute("AsuraElixirs", created.Elixirs)
	player:SetAttribute("AsuraElixirsMax", created.MaxElixirs)
	player:SetAttribute("AsuraUnbanked", 0)
	return created
end

local function publish(s: Session)
	local record = souls(s.UserId)
	local player = s.Player
	if not player.Parent then
		return
	end
	player:SetAttribute("AsuraElixirs", s.Elixirs)
	player:SetAttribute("AsuraElixirsMax", s.MaxElixirs)
	player:SetAttribute("AsuraUnbanked", s.Unbanked)
	if record then
		player:SetAttribute("AsuraEssence", record.essence)
		player:SetAttribute("AsuraLevel", record.level)
		player:SetAttribute("AsuraLevelCost", ProfileStore.LevelCost(record.level))
		player:SetAttribute("AsuraActiveAltar", record.world.activeAltar)
		player:SetAttribute("AsuraMainhand", record.inventory.mainhand)
		player:SetAttribute("AsuraOffhand", record.inventory.offhand)
		local forged = ProfileStore.ReinforceLevel(record, record.inventory.mainhand)
		player:SetAttribute("AsuraReinforce", forged)
		player:SetAttribute("AsuraReinforceCost", if forged >= ProfileStore.ReinforceMax then 0 else ProfileStore.ReinforceCost(forged))
		local altars: { string } = {}
		for id in record.world.altars do
			table.insert(altars, id)
		end
		table.sort(altars)
		player:SetAttribute("AsuraAltars", table.concat(altars, ","))
		for _, name in ProfileStore.Attributes do
			player:SetAttribute("Asura" .. name, record.attributes[name])
		end
	end
end

local function processQueue(s: Session)
	if s.Processing then
		return
	end
	s.Processing = true
	task.spawn(function()
		while #s.Queue > 0 do
			local commit = table.remove(s.Queue, 1) :: Commit
			local ok, err = false, "Profile is busy"
			for _ = 1, BUSY_RETRIES do
				ok, err = commit.Run(engine())
				if ok or err ~= "Profile is busy" then
					break
				end
				task.wait(0.25)
			end
			if not ok then
				warn(string.format("[WorldService] %s for %d failed: %s", commit.Label, s.UserId, tostring(err)))
			end
		end
		s.Processing = false
		if s.Player.Parent then
			publish(s)
		elseif sessions[s.UserId] == s then
			sessions[s.UserId] = nil
		end
	end)
end

local function enqueue(s: Session, label: string, run: (engine: any) -> (boolean, string?))
	table.insert(s.Queue, { Label = label, Run = run })
	processQueue(s)
end

-- Banks unbanked essence and gourd charges. Returns immediately; work is serialised per player.
local function flush(s: Session)
	s.LastFlush = os.clock()
	if s.Unbanked > 0 then
		local amount = s.Unbanked
		s.Unbanked = 0
		enqueue(s, "BankEssence", function(store: any): (boolean, string?)
			local ok, err = store:GrantEssence(s.UserId, amount)
			if not ok and err ~= "Profile is busy" then
				s.Unbanked += amount
			end
			return ok, err
		end)
	end
	if s.ElixirsDirty then
		s.ElixirsDirty = false
		local charges = s.Elixirs
		enqueue(s, "Elixirs", function(store: any): (boolean, string?)
			return store:SetElixirCharges(s.UserId, charges)
		end)
	end
end

-- Blocking flush used on leave/shutdown before the profile lease is released.
function WorldService.Flush(userId: number, timeout: number?)
	local s = sessions[userId]
	if not s then
		return
	end
	flush(s)
	local deadline = os.clock() + (timeout or 8)
	while (s.Processing or #s.Queue > 0) and os.clock() < deadline do
		task.wait(0.05)
	end
end

function WorldService.FlushAll(timeout: number?)
	local deadline = os.clock() + (timeout or 10)
	for _, s in sessions do
		flush(s)
	end
	repeat
		local busy = false
		for _, s in sessions do
			if s.Processing or #s.Queue > 0 then
				busy = true
			end
		end
		if busy then
			task.wait(0.05)
		end
	until not busy or os.clock() >= deadline
end

-------------------------------------------------------------------------------------------------
-- World construction
-------------------------------------------------------------------------------------------------

local function registerGroups()
	for _, name in { WORLD_GROUP, PROBE_GROUP } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	for _, group in PhysicsService:GetRegisteredCollisionGroups() do
		PhysicsService:CollisionGroupSetCollidable(PROBE_GROUP, group.name, group.name == WORLD_GROUP)
	end
end

local function markGeometry(container: Instance)
	local function mark(instance: Instance)
		if instance:IsA("BasePart") and instance.Anchored and instance:FindFirstAncestorOfClass("Model") == nil then
			instance.CollisionGroup = WORLD_GROUP
		elseif instance:IsA("BasePart") and instance.Anchored then
			local model = instance:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") == nil then
				instance.CollisionGroup = WORLD_GROUP
			end
		end
	end
	for _, descendant in container:GetDescendants() do
		mark(descendant)
	end
	table.insert(connections, container.DescendantAdded:Connect(mark))
end

local function buildGreybox(root: Folder)
	local greybox = folder("Greybox", root)
	for _, id in World.RegionOrder do
		local region = World.Regions[id]
		if Workspace:FindFirstChild(region.MapFolder, true) == nil and greybox:FindFirstChild(id) == nil then
			local bounds = region.Bounds
			local floor = Instance.new("Part")
			floor.Name = id
			floor.Anchored = true
			floor.Size = Vector3.new(bounds.Size.X, 4, bounds.Size.Z)
			floor.CFrame = CFrame.new(bounds.Center.X, -2, bounds.Center.Z)
			floor.Material = material(region.Greybox.Material)
			floor.Color = Color3.fromRGB(region.Greybox.Color[1], region.Greybox.Color[2], region.Greybox.Color[3])
			floor.TopSurface = Enum.SurfaceType.Smooth
			floor:SetAttribute("AsuraRegion", id)
			floor.Parent = greybox
		end
	end
end

-- An authored part named AltarAnchor_<id> (e.g. the Sanctuary bonfire plinth) replaces the stock
-- censer: the rest prompt mounts on it and it becomes the altar's reference point.
local function anchoredAltar(altar: Altar): ProximityPrompt?
	local anchor = Workspace:FindFirstChild("AltarAnchor_" .. altar.Id, true)
	if not anchor or not anchor:IsA("BasePart") then
		return nil
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RestPrompt"
	prompt.ActionText = "Rest"
	prompt.ObjectText = altar.Name
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = altar.Radius
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	anchor:SetAttribute("AltarId", altar.Id)
	CollectionService:AddTag(anchor, TAG_ALTAR)
	altarParts[altar.Id] = anchor
	return prompt
end

local function buildAltar(altar: Altar, parent: Folder): ProximityPrompt
	local authored = anchoredAltar(altar)
	if authored then
		return authored
	end
	local model = Instance.new("Model")
	model.Name = "IncenseAltar_" .. altar.Id
	local base = Instance.new("Part")
	base.Name = "Base"
	base.Anchored = true
	base.Size = Vector3.new(4, 1.5, 4)
	base.CFrame = toCFrame(altar.Placement) * CFrame.new(0, 0.75, 0)
	base.Material = Enum.Material.Slate
	base.Color = Color3.fromRGB(64, 58, 54)
	base.Parent = model
	local censer = Instance.new("Part")
	censer.Name = "Censer"
	censer.Anchored = true
	censer.CanCollide = false
	censer.Shape = Enum.PartType.Cylinder
	censer.Size = Vector3.new(0.8, 1.6, 1.6)
	censer.CFrame = base.CFrame * CFrame.new(0, 1.15, 0) * CFrame.Angles(0, 0, math.rad(90))
	censer.Material = Enum.Material.Metal
	censer.Color = Color3.fromRGB(122, 92, 46)
	censer.Parent = model
	local incense = Instance.new("Part")
	incense.Name = "Incense"
	incense.Anchored = true
	incense.CanCollide = false
	incense.Size = Vector3.new(0.12, 1.8, 0.12)
	incense.CFrame = base.CFrame * CFrame.new(0, 2.4, 0)
	incense.Material = Enum.Material.Neon
	incense.Color = Color3.fromRGB(255, 140, 60)
	incense.Parent = model
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 80)
	light.Range = 14
	light.Brightness = 1.6
	light.Parent = incense
	local smoke = Instance.new("Smoke")
	smoke.Size = 0.4
	smoke.RiseVelocity = 2
	smoke.Opacity = 0.08
	smoke.Color = Color3.fromRGB(200, 196, 190)
	smoke.Parent = incense
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RestPrompt"
	prompt.ActionText = "Rest"
	prompt.ObjectText = altar.Name
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = altar.Radius
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	model.PrimaryPart = base
	model:SetAttribute("AltarId", altar.Id)
	CollectionService:AddTag(model, TAG_ALTAR)
	model.Parent = parent
	altarParts[altar.Id] = base
	return prompt
end

local function buildGate(gate: FogGate, parent: Folder)
	local wall = Instance.new("Part")
	wall.Name = "FogGate_" .. gate.Id
	wall.Anchored = true
	wall.CanCollide = false
	wall.CanQuery = false
	wall.CanTouch = false
	wall.Size = vec(gate.Size)
	wall.CFrame = toCFrame(gate.Placement)
	wall.Material = Enum.Material.ForceField
	wall.Color = Color3.fromRGB(220, 214, 200)
	wall.Transparency = 0.45
	wall:SetAttribute("Sealed", false)
	wall:SetAttribute("Boss", gate.Boss)
	wall.Parent = parent
	gateParts[gate.Id] = wall
end

local function setGate(gateId: string, sealed: boolean)
	local wall = gateParts[gateId]
	if not wall then
		return
	end
	wall.CanCollide = sealed
	wall.Transparency = if sealed then 0.1 else 0.45
	wall.Color = if sealed then Color3.fromRGB(150, 40, 36) else Color3.fromRGB(220, 214, 200)
	wall:SetAttribute("Sealed", sealed)
end

-------------------------------------------------------------------------------------------------
-- Bloodstains
-------------------------------------------------------------------------------------------------

local function destroyStain(s: Session)
	if s.Stain then
		s.Stain:Destroy()
		s.Stain = nil
	end
	s.StainDeath = 0
	s.Player:SetAttribute("AsuraBloodstain", nil)
end

local recoverStain: (s: Session) -> (boolean, string)

local function placeStain(s: Session, stain: ProfileStore.Bloodstain)
	destroyStain(s)
	local root = worldFolder
	if not root then
		return
	end
	local part = Instance.new("Part")
	part.Name = "Bloodstain_" .. s.UserId
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.15, 4, 4)
	part.CFrame = CFrame.new(stain.x, stain.y - 2.8, stain.z) * CFrame.Angles(0, 0, math.rad(90))
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(150, 12, 18)
	part.Transparency = 0.25
	part:SetAttribute("Owner", s.UserId)
	part:SetAttribute("Essence", stain.essence)
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(200, 30, 30)
	glow.Range = 10
	glow.Parent = part
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Recover Essence"
	prompt.ObjectText = s.Player.DisplayName .. "'s Bloodstain"
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = INTERACT_RADIUS
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	table.insert(connections, prompt.Triggered:Connect(function(player: Player)
		if player.UserId == s.UserId then
			recoverStain(s)
		end
	end))
	CollectionService:AddTag(part, TAG_STAIN)
	part.Parent = folder("Bloodstains", root)
	s.Stain = part
	s.StainDeath = stain.death
	s.Player:SetAttribute("AsuraBloodstain", Vector3.new(stain.x, stain.y, stain.z))
end

recoverStain = function(s: Session): (boolean, string)
	local part = s.Stain
	local position = entityPosition(s.UserId)
	if not part or not position or (position - part.Position).Magnitude > INTERACT_RADIUS + 3 then
		return false, "NoBloodstain"
	end
	local death = s.StainDeath
	destroyStain(s)
	enqueue(s, "RecoverBloodstain", function(store: any): (boolean, string?)
		local ok, err, amount = store:RecoverBloodstain(s.UserId, death)
		if ok then
			Characters.Cue("EssenceRecovered", s.UserId, { amount = amount })
		end
		return ok, err
	end)
	return true, "Recovered"
end

local function onPlayerDeath(s: Session)
	local e = Characters.GetEntity(s.UserId)
	if not e then
		return
	end
	local position = e.Root.Position
	local region = World.regionAt(position.X, position.Y, position.Z) or s.Region or World.startingAltar().Region
	local unbanked = s.Unbanked
	s.Unbanked = 0
	-- The previous bloodstain is forfeit the moment a new death occurs.
	destroyStain(s)
	enqueue(s, "RecordDeath", function(store: any): (boolean, string?)
		local ok, err, dropped = store:RecordDeath(s.UserId, region, position.X, position.Y, position.Z, unbanked)
		if ok then
			local record = souls(s.UserId)
			local stain = record and record.world.bloodstain
			if stain and dropped > 0 then
				placeStain(s, stain)
			end
			Characters.Cue("EssenceLost", s.UserId, { amount = dropped })
		end
		return ok, err
	end)
	s.Elixirs = s.MaxElixirs
	s.ElixirsDirty = true
	local altar = World.Altars[s.ActiveAltar] or World.startingAltar()
	task.delay(Settings.Respawn.PlayerDelay, function()
		if running then
			AI.RespawnRegion(altar.Region, true)
		end
	end)
end

-------------------------------------------------------------------------------------------------
-- Altars, elixirs, progression
-------------------------------------------------------------------------------------------------

local function nearestAltar(position: Vector3): (Altar?, number)
	local best: Altar? = nil
	local bestDistance = math.huge
	for id, altar in World.Altars do
		local part = altarParts[id]
		if part then
			local distance = (part.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = altar, distance
			end
		end
	end
	return best, bestDistance
end

local function restAt(s: Session, altar: Altar): (boolean, string)
	if s.Fight then
		return false, "InBossFight"
	end
	if Characters.IsInDuel(s.UserId) then
		return false, "InDuel"
	end
	if AI.IsHunting(s.UserId) then
		return false, "EnemiesNearby"
	end
	local position = entityPosition(s.UserId)
	local part = altarParts[altar.Id]
	if not position or not part or (position - part.Position).Magnitude > altar.Radius + 2 then
		return false, "TooFar"
	end
	-- The proximity prompt and the Interact intent can both fire for one press; resting is idempotent.
	local fighter = Characters.GetFighter(s.UserId)
	if fighter and fighter.State == "RestingAtShrine" then
		return true, "Resting"
	end
	local ok, reason = Characters.Rest(s.UserId)
	if not ok or reason == "Rose" then
		return ok, reason
	end
	s.ActiveAltar = altar.Id
	s.Altars[altar.Id] = true
	s.Elixirs = s.MaxElixirs
	s.ElixirsDirty = false
	Characters.SetRespawnPoint(s.UserId, toCFrame(altar.Spawn))
	AI.RespawnRegion(altar.Region, true)
	Characters.Cue("AltarRest", s.UserId, { altar = altar.Id, name = altar.Name })
	flush(s)
	enqueue(s, "ActivateAltar", function(store: any): (boolean, string?)
		return store:ActivateAltar(s.UserId, altar.Id, true, true)
	end)
	return true, "Rest"
end

local function nearAltar(s: Session): Altar?
	local position = entityPosition(s.UserId)
	if not position then
		return nil
	end
	local altar, distance = nearestAltar(position)
	if altar and distance <= altar.Radius + 2 and s.Altars[altar.Id] then
		return altar
	end
	return nil
end

local function drink(s: Session): (boolean, string)
	if s.Elixirs <= 0 then
		return false, "GourdEmpty"
	end
	local ok, reason = Characters.TryHeal(s.UserId, Settings.Elixir.HealFraction + s.Potency * POTENCY_STEP)
	if not ok then
		return false, reason
	end
	s.Elixirs -= 1
	s.ElixirsDirty = true
	s.Player:SetAttribute("AsuraElixirs", s.Elixirs)
	return true, "Drink"
end

local function refreshStats(userId: number)
	local record = souls(userId)
	if record then
		local stats = ProfileStore.DeriveStats(record)
		Characters.ApplyStats(userId, stats, false)
	end
end

local function levelUp(s: Session, attribute: string): (boolean, string)
	if table.find(ProfileStore.Attributes, attribute :: any) == nil then
		return false, "UnknownAttribute"
	end
	if not nearAltar(s) then
		return false, "NotAtAltar"
	end
	flush(s)
	enqueue(s, "LevelUp", function(store: any): (boolean, string?)
		local ok, err = store:LevelAttribute(s.UserId, attribute)
		if ok then
			refreshStats(s.UserId)
			Characters.Cue("LevelUp", s.UserId, { attribute = attribute })
		elseif err == "Not enough essence" or err == "Attribute at maximum" or err == "Level refused" then
			Characters.Cue("LevelRefused", s.UserId, { reason = err })
			return true, nil
		end
		return ok, err
	end)
	return true, "LevelQueued"
end

-- Travel between activated altars: only while at an activated altar, then rest at the destination.
local function travel(s: Session, altarId: string): (boolean, string)
	local destination = World.Altars[altarId]
	if not destination or not s.Altars[altarId] then
		return false, "AltarNotKindled"
	end
	if s.Fight then
		return false, "InBossFight"
	end
	if AI.IsHunting(s.UserId) then
		return false, "EnemiesNearby"
	end
	local origin = nearAltar(s)
	if not origin then
		return false, "NotAtAltar"
	end
	if origin.Id == altarId then
		return false, "AlreadyHere"
	end
	Characters.Teleport(s.UserId, toCFrame(destination.Spawn))
	Characters.Cue("AltarTravel", s.UserId, { from = origin.Id, to = altarId })
	local fighter = Characters.GetFighter(s.UserId)
	if fighter and fighter.State == "RestingAtShrine" then
		fighter.State = "Idle"
		fighter.StateEnd = math.huge
	end
	return restAt(s, destination)
end

local function swap(s: Session): (boolean, string)
	local record = souls(s.UserId)
	if not record then
		return false, "Unavailable"
	end
	local inventory = record.inventory
	if inventory.offhand == "None" then
		return false, "NoOffhand"
	end
	local main, off = inventory.offhand, inventory.mainhand
	local ok, reason = Characters.EquipWeapon(s.UserId, main :: any)
	if not ok then
		return false, reason
	end
	enqueue(s, "Swap", function(store: any): (boolean, string?)
		local ok, err = store:EquipLoadout(s.UserId, main, off)
		if ok then
			-- Reinforcement follows the weapon in hand.
			Characters.RefreshProgression(s.UserId)
		end
		return ok, err
	end)
	return true, main
end

-------------------------------------------------------------------------------------------------
-- Boss fog gates
-------------------------------------------------------------------------------------------------

local function endFight(gateId: string, victory: boolean)
	local fight = fights[gateId]
	if not fight then
		return
	end
	fights[gateId] = nil
	setGate(gateId, false)
	local boss = World.Bosses[fight.BossId]
	for userId in fight.Participants do
		local s = sessions[userId]
		if s then
			s.Fight = nil
			if victory then
				s.Bosses[fight.BossId] = true
				flush(s)
				enqueue(s, "BossDefeat", function(store: any): (boolean, string?)
					return store:RecordBossDefeat(userId, fight.BossId, boss.Essence)
				end)
			end
		end
	end
	Characters.Cue(if victory then "BossDefeated" else "BossReset", fight.BossEntity, { boss = fight.BossId, gate = gateId })
	if not victory then
		AI.DespawnBoss(fight.BossId)
	end
end

local function startFight(gate: FogGate, entrants: { number })
	local boss = World.Bosses[gate.Boss]
	local participants: { [number]: boolean } = {}
	local list: { number } = {}
	for _, userId in entrants do
		participants[userId] = true
		table.insert(list, userId)
	end
	for userId, s in sessions do
		local position = entityPosition(userId)
		if not participants[userId] and position and inBounds(boss.Arena, position) and not s.Bosses[boss.Id] and not s.Fight then
			participants[userId] = true
			table.insert(list, userId)
		end
	end
	local entity = AI.SpawnBoss(boss.Id, list)
	if not entity then
		return
	end
	fights[gate.Id] = { Gate = gate, BossId = boss.Id, BossEntity = entity, Participants = participants, StartedAt = Characters.Now() }
	for userId in participants do
		local s = sessions[userId]
		if s then
			s.Fight = gate.Id
		end
	end
	setGate(gate.Id, true)
	Characters.Cue("FogGateSealed", entity, { gate = gate.Id, boss = boss.Id, title = boss.Title })
end

local function updateGates()
	for gateId, gate in World.FogGates do
		local boss = World.Bosses[gate.Boss]
		local fight = fights[gateId]
		if fight == nil then
			local entrants: { number } = {}
			for userId, s in sessions do
				local e = Characters.GetEntity(userId)
				if e and e.Fighter.State ~= "KO" and not s.Bosses[boss.Id] and not s.Fight and not Characters.IsInDuel(userId)
					and inBounds(gate.Trigger, e.Root.Position) then
					table.insert(entrants, userId)
				end
			end
			if #entrants > 0 then
				startFight(gate, entrants)
			end
		else
			local living = 0
			for userId in fight.Participants do
				local e = Characters.GetEntity(userId)
				local s = sessions[userId]
				if not s or not e or e.Fighter.State == "KO" or e.Respawning then
					fight.Participants[userId] = nil
					if s then
						s.Fight = nil
					end
				else
					living += 1
					if not inBounds(boss.Arena, e.Root.Position) then
						Characters.Teleport(userId, toCFrame(gate.Inside))
					end
				end
			end
			for userId, s in sessions do
				if not fight.Participants[userId] then
					local position = entityPosition(userId)
					if position and inBounds(boss.Arena, position) and s.Fight == nil then
						Characters.Teleport(userId, toCFrame(gate.Outside))
					end
				end
			end
			local remaining: { number } = {}
			for userId in fight.Participants do
				table.insert(remaining, userId)
			end
			AI.SetBossTargets(fight.BossId, remaining)
			if living == 0 then
				endFight(gateId, false)
			elseif AI.GetBossEntity(fight.BossId) == nil then
				endFight(gateId, false)
			end
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Event wiring
-------------------------------------------------------------------------------------------------

local function onEvent(event: any, _point: Vector3?)
	if event.Kind ~= "KO" then
		return
	end
	local victimSession = sessions[event.Target]
	if victimSession then
		if not Characters.IsInDuel(event.Target) then
			onPlayerDeath(victimSession)
		end
		return
	end
	local agent = AI.GetAgent(event.Target)
	if not agent or agent.Kind ~= "Mob" then
		return
	end
	local killer = sessions[event.Source]
	if killer then
		killer.Unbanked += agent.Essence
		killer.Player:SetAttribute("AsuraUnbanked", killer.Unbanked)
	end
end

local function onBossDefeated(bossId: string, _entityId: number)
	for gateId, fight in fights do
		if fight.BossId == bossId then
			endFight(gateId, true)
		end
	end
end

local function onPlayerAdded(id: number, kind: Characters.EntityKind)
	if kind ~= "Player" then
		return
	end
	local s = session(id)
	if not s then
		return
	end
	local record = souls(id)
	local stain = record and record.world.bloodstain
	if stain and s.Stain == nil then
		placeStain(s, stain)
	end
	publish(s)
end

local function hooks(): Characters.Hooks
	return {
		RespawnPoint = function(userId: number): CFrame?
			local s = session(userId)
			local altar = if s then World.Altars[s.ActiveAltar] else nil
			return toCFrame((altar or World.startingAltar()).Spawn)
		end,
		Stats = function(userId: number): any
			local record = souls(userId)
			return if record then ProfileStore.DeriveStats(record) else nil
		end,
		Loadout = function(userId: number): (string?, string?)
			local record = souls(userId)
			if not record then
				return nil, nil
			end
			return record.inventory.mainhand, record.inventory.offhand
		end,
		CanEquip = function(userId: number, weapon: string): boolean
			local record = souls(userId)
			return record ~= nil and record.inventory.weapons[weapon] == true and Weapons.Weapons[weapon] ~= nil
		end,
		Rest = function(userId: number): (boolean, string)
			local s = session(userId)
			local position = entityPosition(userId)
			if not s or not position then
				return false, "Unavailable"
			end
			local altar = nearestAltar(position)
			if not altar then
				return false, "NoAltar"
			end
			return restAt(s, altar)
		end,
		Heal = function(userId: number): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return drink(s)
		end,
		Interact = function(userId: number): (boolean, string)
			local s = session(userId)
			local position = entityPosition(userId)
			if not s or not position then
				return false, "Unavailable"
			end
			local part = s.Stain
			if part and (position - part.Position).Magnitude <= INTERACT_RADIUS + 3 then
				return recoverStain(s)
			end
			local altar, distance = nearestAltar(position)
			if altar and distance <= altar.Radius + 2 then
				return restAt(s, altar)
			end
			for _, handler in interactables do
				local ok, handled, reason = pcall(handler, userId, position)
				if ok and handled ~= nil then
					return handled, reason or "Interacted"
				end
			end
			return false, "NothingNearby"
		end,
		LevelUp = function(userId: number, attribute: string): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return levelUp(s, attribute)
		end,
		Swap = function(userId: number): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return swap(s)
		end,
		Travel = function(userId: number, altarId: string): (boolean, string)
			local s = session(userId)
			if not s then
				return false, "Unavailable"
			end
			return travel(s, altarId)
		end,
	}
end

-------------------------------------------------------------------------------------------------
-- Lifecycle
-------------------------------------------------------------------------------------------------

function WorldService.Start()
	assert(not running, "WorldService already started")
	running = true
	local root = Workspace:FindFirstChild(Config.Names.Root) or Instance.new("Folder")
	if not root.Parent then
		root.Name = Config.Names.Root
		root.Parent = Workspace
	end
	local worldRoot = folder("World", root)
	worldFolder = worldRoot
	registerGroups()
	buildGreybox(worldRoot)
	local altarsFolder = folder("Altars", worldRoot)
	for id, altar in World.Altars do
		local prompt = buildAltar(altar, altarsFolder)
		table.insert(connections, prompt.Triggered:Connect(function(player: Player)
			local s = session(player.UserId)
			if s then
				local ok, reason = restAt(s, World.Altars[id])
				player:SetAttribute("AsuraResult", (if ok then "" else "!") .. reason)
			end
		end))
	end
	local gatesFolder = folder("FogGates", worldRoot)
	for _, gate in World.FogGates do
		buildGate(gate, gatesFolder)
	end
	markGeometry(worldRoot)
	local arena = root:FindFirstChild(Config.Names.Arena)
	if arena then
		markGeometry(arena)
	end
	for _, id in World.RegionOrder do
		local map = Workspace:FindFirstChild(World.Regions[id].MapFolder, true)
		if map then
			markGeometry(map)
		end
	end
	pcall(function()
		(Workspace.Terrain :: any).CollisionGroup = WORLD_GROUP
	end)

	Characters.SetHooks(hooks())
	table.insert(disconnectors, Characters.Subscribe(onEvent))
	table.insert(disconnectors, Characters.OnEntityAdded(onPlayerAdded))
	table.insert(disconnectors, AI.OnBossDefeated(onBossDefeated))
	table.insert(disconnectors, Characters.OnStep(function(_now: number, _dt: number)
		tickCounter += 1
		if tickCounter % GATE_INTERVAL == 0 then
			updateGates()
		end
		if tickCounter % 60 == 0 then
			local clock = os.clock()
			for userId, s in sessions do
				local position = entityPosition(userId)
				if position then
					local region = World.regionAt(position.X, position.Y, position.Z)
					if region ~= s.Region then
						s.Region = region
						s.Player:SetAttribute("AsuraRegion", region)
					end
				end
				if clock - s.LastFlush >= FLUSH_INTERVAL then
					flush(s)
				end
			end
		end
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(player: Player)
		local s = sessions[player.UserId]
		if not s then
			return
		end
		for gateId, fight in fights do
			if fight.Participants[player.UserId] then
				fight.Participants[player.UserId] = nil
				if next(fight.Participants) == nil then
					endFight(gateId, false)
				end
			end
		end
		task.defer(function()
			if s.Stain then
				s.Stain:Destroy()
				s.Stain = nil
			end
			if not s.Processing and #s.Queue == 0 then
				sessions[player.UserId] = nil
			end
		end)
	end))

	-- Rig creation yields on asset loads; populate regions off the startup path.
	task.spawn(function()
		for _, id in World.RegionOrder do
			for _, entry in World.spawnsIn(id) do
				if running then
					AI.SpawnMob(entry.Id)
				end
			end
		end
	end)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player.UserId, "Player")
	end
end

function WorldService.Destroy()
	running = false
	for _, disconnect in disconnectors do
		disconnect()
	end
	table.clear(disconnectors)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for gateId in fights do
		endFight(gateId, false)
	end
	for _, s in sessions do
		if s.Stain then
			s.Stain:Destroy()
		end
	end
	table.clear(sessions)
	local root = worldFolder
	if root then
		root:Destroy()
		worldFolder = nil
	end
	table.clear(altarParts)
	table.clear(gateParts)
end

-- Blacksmith: reinforce the equipped weapon with banked essence (unbanked essence is banked first).
function WorldService.Reinforce(userId: number): (boolean, string)
	local s = session(userId)
	local record = souls(userId)
	if not s or not record then
		return false, "Unavailable"
	end
	if Characters.IsInDuel(userId) then
		return false, "InDuel"
	end
	local weapon = record.inventory.mainhand
	flush(s)
	enqueue(s, "Reinforce", function(store: any): (boolean, string?)
		local ok, err, level = store:ReinforceWeapon(userId, weapon)
		if ok then
			Characters.RefreshProgression(userId)
			Characters.Cue("WeaponReinforced", userId, { weapon = weapon, level = level })
		elseif err == "Not enough essence" or err == "Reinforcement at maximum" or err == "Weapon is locked" or err == "Reinforcement refused" then
			local current = souls(userId)
			Characters.Cue("ReinforceRefused", userId, {
				reason = err,
				weapon = weapon,
				cost = if current then ProfileStore.ReinforceCost(ProfileStore.ReinforceLevel(current, weapon)) else 0,
			})
			return true, nil
		end
		return ok, err
	end)
	return true, "ReinforceQueued"
end

-- Blacksmith: refill the gourd outside the rest ritual (no enemy respawn, no checkpoint change).
function WorldService.RefillElixirs(userId: number): (boolean, string)
	local s = session(userId)
	if not s then
		return false, "Unavailable"
	end
	if s.Elixirs >= s.MaxElixirs then
		return false, "GourdFull"
	end
	s.Elixirs = s.MaxElixirs
	s.ElixirsDirty = true
	s.Player:SetAttribute("AsuraElixirs", s.Elixirs)
	flush(s)
	Characters.Cue("GourdRefilled", userId, { charges = s.Elixirs })
	return true, "Refilled"
end

function WorldService.RegisterInteractable(handler: Interactable): () -> ()
	table.insert(interactables, handler)
	return function()
		local index = table.find(interactables, handler)
		if index then
			table.remove(interactables, index)
		end
	end
end

function WorldService.GetSession(userId: number): any
	return sessions[userId]
end

function WorldService.IsInBossFight(userId: number): boolean
	local s = sessions[userId]
	return s ~= nil and s.Fight ~= nil
end

return WorldService
