          <Item class="ModuleScript" referent="638">
            <Properties>
              <string name="Name">ActionBar</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ActionBar
-- Bottom-centre row of sakura medallions, one per combat move, each with a drawn icon, its name and
-- the key for the current device (keyboard or gamepad; hidden on touch, which has its own buttons).
-- A medallion pops and glows gold while its move is happening: attacks on press, Block while the
-- guard is up, Parry during the deflect window, Dodge while dashing, Lock while locked on.
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local Icons = require(script.Parent:WaitForChild("MoveIcons") :: ModuleScript)

local Bar = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local SLOT = 46 -- medallion diameter (px at 900px screen height)
local GAP = 74 -- centre-to-centre spacing
local BOTTOM = require(script.Parent:WaitForChild("HudLayout") :: ModuleScript).ActionBarBottom -- reserved combat row
local FLASH = 0.35 -- seconds an attack medallion stays lit after its key is pressed
-- Kind = icon, Command = input action whose key is shown, Hint = suffix for shared keys.
local MOVES: { { Kind: string, Name: string, Command: string, Hint: string? } } = {
	{ Kind = "Light", Name = "Slash", Command = "Light" },
	{ Kind = "Heavy", Name = "Heavy", Command = "Heavy" },
	{ Kind = "Parry", Name = "Parry", Command = "Guard", Hint = "tap" },
	{ Kind = "Block", Name = "Block", Command = "Guard", Hint = "hold" },
	{ Kind = "Dash", Name = "Dodge", Command = "Dash" },
	{ Kind = "WeaponArt", Name = "Art", Command = "WeaponArt" },
	{ Kind = "Heal", Name = "Heal", Command = "Heal" },
	{ Kind = "Lock", Name = "Lock On", Command = "Lock" },
}

type Slot = { Kind: string, Command: string, Hint: string?, Disc: Frame, Stroke: UIStroke?, Scale: UIScale, Key: TextLabel, Icon: CanvasGroup, Lit: boolean, Until: number }
export type View = { Root: Frame, Slots: { [string]: Slot }, Device: string }

local POP = TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

function Bar.new(gui: ScreenGui): View
	local width = GAP * (#MOVES - 1) + SLOT + 24
	local root = HudKit.make("Frame", gui, {
		Name = "ActionBar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -BOTTOM),
		Size = UDim2.fromOffset(width, SLOT + 40), BackgroundTransparency = 1,
	}) :: Frame
	root.Destroying:Once(HudKit.bindScale(root, 0.8))
	local slots: { [string]: Slot } = {}
	for n, move in MOVES do
		local x = 12 + SLOT / 2 + (n - 1) * GAP
		local disc = Sakura.medallion(root, SLOT, UDim2.fromOffset(x, SLOT / 2), false)
		disc.BackgroundTransparency = 0.15
		local scale = HudKit.make("UIScale", disc, {}) :: UIScale
		local icon = Icons.draw(disc, move.Kind, SLOT)
		local key = HudKit.label(disc, "", 11, Enum.Font.GothamBold, C.Ink, {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromOffset(34, 16),
			BackgroundColor3 = C.Blossom, BackgroundTransparency = 0, ZIndex = 5,
		})
		HudKit.make("UICorner", key, { CornerRadius = UDim.new(1, 0) })
		HudKit.make("UIStroke", key, { Color = C.Rose, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
		HudKit.label(root, move.Name, 12, Enum.Font.Garamond, C.Blossom, {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(x, SLOT + 12), Size = UDim2.fromOffset(GAP, 16), TextStrokeTransparency = 0.35,
		})
		slots[move.Kind] = {
			Kind = move.Kind, Command = move.Command, Hint = move.Hint, Disc = disc, Stroke = disc:FindFirstChildOfClass("UIStroke"),
			Scale = scale, Key = key, Icon = icon, Lit = false, Until = 0,
		}
	end
	return { Root = root, Slots = slots, Device = "" }
end

-- Lights the medallion for a pressed command (attacks only stay lit for FLASH seconds).
function Bar.press(view: View, command: string)
	local kind = if command == "Guard" then "Parry" elseif command == "Roll" then "Dash" else command
	local slot = view.Slots[kind]
	if slot then slot.Until = os.clock() + FLASH end
end

local function light(slot: Slot, on: boolean)
	if on == slot.Lit then return end
	slot.Lit = on
	TweenService:Create(slot.Scale, POP, { Scale = if on then 1.14 else 1 }):Play()
	if slot.Stroke then
		TweenService:Create(slot.Stroke, POP, { Color = if on then C.Gold else C.Sakura, Thickness = if on then 3.5 else 2 }):Play()
	end
end

function Bar.update(view: View, snapshot: any?, input: any, locked: boolean)
	local device = tostring(input.Device)
	view.Root.Visible = device ~= "Touch"
	if device ~= view.Device then
		view.Device = device
		for _, slot in view.Slots do
			local key = input:Label(slot.Command)
			slot.Key.Text = if slot.Hint then string.format("%s %s", key, slot.Hint) else key
			slot.Key.Size = UDim2.fromOffset(math.max(28, #slot.Key.Text * 7 + 10), 16)
		end
	end
	local now = os.clock()
	local state = if snapshot then snapshot.State else "Idle"
	local active: { [string]: boolean } = {
		Block = snapshot ~= nil and (snapshot.Blocking or state == "Blocking" or state == "Blockstun"),
		Parry = state == "Deflecting",
		Dash = state == "Dashing",
		Lock = locked,
	}
	local flasks = tonumber(Players.LocalPlayer:GetAttribute("AsuraElixirs")) or 0
	view.Slots.Heal.Icon.GroupTransparency = if flasks &gt; 0 then 0 else 0.6
	local winded = snapshot ~= nil and snapshot.State == "StaminaBroken"
	for kind, slot in view.Slots do
		light(slot, active[kind] == true or now &lt; slot.Until)
		if kind ~= "Heal" then slot.Icon.GroupTransparency = if winded and kind ~= "Lock" then 0.55 else 0 end
	end
end

return table.freeze(Bar)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="639">
            <Properties>
              <string name="Name">AltarAscension</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/AltarAscension
-- The altar menu's Ascension page: a fixed header (level, Essence held, cost and what is left)
-- above a bounded scroll region of attribute rows. Each row shows the readable name (Arcane Qi),
-- the current value and the concrete before/after result from LevelPreview; its + button is
-- disabled when Essence is short or the attribute is at its peak. The server still decides.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath"):WaitForChild("Shared")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)
local Rules = require(Shared:WaitForChild("ProgressionRules") :: ModuleScript)
local Preview = require(Shared:WaitForChild("LevelPreview") :: ModuleScript)

local Ascension = {}
local T = UiKit.Theme
local ROW = 70

export type Row = { Value: TextLabel, Result: TextLabel, Plus: TextButton }
export type View = { Header: TextLabel, Quote: TextLabel, List: ScrollingFrame, Rows: { [string]: Row } }

-- `page` is the altar menu's Level page (UIListLayout); Back is appended by the caller (order 10).
function Ascension.build(page: Frame, onLevel: (string) -&gt; ()): View
	local header = HudKit.label(page, "", 18, T.TitleFont, T.Ivory, { Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0 })
	local quote = HudKit.label(page, "", 15, T.BodyFont, T.Muted, { Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1 })
	local list = HudKit.make("ScrollingFrame", page, {
		Name = "Attributes", Size = UDim2.new(1, 0, 1, -112), BackgroundColor3 = T.Ink, BackgroundTransparency = 0.6, BorderSizePixel = 0,
		ScrollBarThickness = 5, ScrollBarImageColor3 = T.Edge, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y, ClipsDescendants = true, LayoutOrder = 2,
	}) :: ScrollingFrame
	HudKit.make("UIStroke", list, { Color = T.Edge, Transparency = 0.55 }) -- the scroll boundary is visible
	HudKit.make("UIListLayout", list, { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
	HudKit.make("UIPadding", list, { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 10) })
	local rows: { [string]: Row } = {}
	for index, id in Rules.Attributes do
		local row = HudKit.make("Frame", list, { Name = id, Size = UDim2.new(1, 0, 0, ROW), BackgroundTransparency = 1, LayoutOrder = index }) :: Frame
		HudKit.label(row, Preview.Labels[id], 20, T.BodyFont, T.Ivory, { Position = UDim2.fromOffset(0, 2), Size = UDim2.new(1, -110, 0, 24), TextXAlignment = Enum.TextXAlignment.Left })
		HudKit.label(row, Preview.Summary[id], 13, T.BodyFont, T.Muted, { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -110, 0, 16), TextXAlignment = Enum.TextXAlignment.Left })
		local result = HudKit.label(row, "", 13, T.BodyFont, T.Gold, {
			Name = "Result", Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, -54, 0, 28), TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		})
		local value = HudKit.label(row, "10", 22, Enum.Font.GothamMedium, T.Ivory, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -52, 0, 4), Size = UDim2.fromOffset(52, 30) })
		local plus = UiKit.button(row, "+", "Primary", function() onLevel(id) end)
		plus.AnchorPoint, plus.Position, plus.Size = Vector2.new(1, 0), UDim2.new(1, 0, 0, 2), UDim2.fromOffset(44, 36)
		rows[id] = { Value = value, Result = result, Plus = plus }
	end
	return { Header = header, Quote = quote, List = list, Rows = rows }
end

-- Reads the server-published attributes on the player (Asura* attributes) and redraws.
function Ascension.refresh(view: View, player: Player)
	local essence = tonumber(player:GetAttribute("AsuraEssence")) or 0
	local cost = tonumber(player:GetAttribute("AsuraLevelCost")) or 0
	local level = tonumber(player:GetAttribute("AsuraLevel")) or 1
	local tier = tonumber(player:GetAttribute("AsuraReinforce")) or 0
	local attributes: { [string]: number } = {}
	for _, id in Rules.Attributes do attributes[id] = tonumber(player:GetAttribute("Asura" .. id)) or 10 end
	local affordable, quote = Preview.quote(essence, cost)
	view.Header.Text = string.format("Level %d → %d   ·   %d Essence", level, level + 1, essence)
	view.Quote.Text, view.Quote.TextColor3 = quote, if affordable then T.Gold else T.Muted
	for id, row in view.Rows do
		row.Value.Text = tostring(attributes[id])
		row.Result.Text = Preview.line(attributes, id, tier)
		UiKit.setEnabled(row.Plus, affordable and attributes[id] &lt; Preview.Max)
	end
end

return table.freeze(Ascension)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="640">
            <Properties>
              <string name="Name">ArenaAsh</string>
              <string name="Source">--!strict
local Shared = game:GetService("ReplicatedStorage").AsurasPath.Shared
local Assets = require(Shared.PresentationAssets)
local Profiles = require(Shared.EnvironmentProfiles)
local Effects = require(Shared.EffectsPreference)
local RATE = 18 -- ash flakes per second at full decorative density
local Ash = {}
Ash.__index = Ash
function Ash.new(): any return setmetatable({Folder=nil,Anchor=nil,Emitter=nil,Bits={},Time=0},Ash) end
function Ash.clear(self: any)
	if self.Folder then self.Folder:Destroy() end
	self.Folder,self.Anchor,self.Emitter=nil,nil,nil;table.clear(self.Bits)
end
function Ash.Update(self: any,dt: number,at: Vector3?,key: string)
	-- Colosseum only; thinned during the fight itself (and by reduced effects) so ash never
	-- competes with telegraphs.
	local density=Effects.decor(key~="AshColosseum")
	if not at or not Profiles.ashFall(key) or density&lt;=0 then if self.Folder then self:clear() end;return end
	if not self.Folder then
		local folder=Instance.new("Folder");folder.Name,folder.Parent="AsuraLocalAsh",workspace;self.Folder=folder
		if Assets.Textures.Ash~="" then
			local p=Instance.new("Part");p.Size,p.Transparency=Vector3.new(60,1,60),1
			p.Anchored,p.CanCollide,p.CanQuery,p.CanTouch,p.Parent=true,false,false,false,folder;self.Anchor=p
			local e=Instance.new("ParticleEmitter")
			e.Texture,e.Shape,e.Rate=Assets.Textures.Ash,Enum.ParticleEmitterShape.Box,RATE;self.Emitter=e
			e.Lifetime,e.Speed,e.Drag=NumberRange.new(7,12),NumberRange.new(0.4,1.4),0.4
			e.Acceleration,e.RotSpeed=Vector3.new(0.8,-0.9,0.3),NumberRange.new(-90,90)
			e.Size,e.Transparency=NumberSequence.new(0.09,0.02),NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.15,0.45),NumberSequenceKeypoint.new(1,1)})
			e.Color,e.LightInfluence,e.Parent=ColorSequence.new(Color3.fromRGB(154,139,129)),1,p
		else
			for i=1,24 do
				local p=Instance.new("Part")
				p.Size,p.Color,p.Material=Vector3.new(0.045,0.018,0.07),Color3.fromRGB(132,123,117),Enum.Material.Slate
				p.Anchored,p.CanCollide,p.CanQuery,p.CanTouch,p.CastShadow=true,false,false,false,false
				p.Parent=folder;table.insert(self.Bits,{Part=p,Seed=i*2.399})
			end
		end
	end
	if self.Anchor then self.Anchor.Position=at+Vector3.yAxis*14 end
	if self.Emitter then self.Emitter.Rate=RATE*density end
	self.Time+=dt
	local shown=math.ceil(#self.Bits*density)
	for i, item in self.Bits do
		local n,t=item.Seed,self.Time
		item.Part.Transparency=if i&lt;=shown then 0 else 1
		item.Part.CFrame=CFrame.new(at+Vector3.new(math.sin(n)*22+math.sin(t+n)*2,15-((t*1.5+n*2)%19),math.cos(n)*22))*CFrame.Angles(n+t,n,t*0.5)
	end
end
function Ash.Destroy(self: any) self:clear() end
return Ash
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="641">
            <Properties>
              <string name="Name">ArsenalPanel</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ArsenalPanel
-- The Arsenal (B / Select): Qi spell slots, weapon loadout and Gao's transmutation as one tabbed
-- lacquer window. Re-renders the active tab from the last inventory packet; every action goes to
-- the server through `Send` (ArsenalIntent), which stays authoritative. Forging asks twice.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Settings = require(Shared:WaitForChild("Shared"):WaitForChild("CombatSettings") :: ModuleScript) :: any
local InputMap = require(Shared:WaitForChild("Shared"):WaitForChild("InputMap") :: ModuleScript)
local Rules = require(Shared:WaitForChild("Shared"):WaitForChild("ProgressionRules") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)
local UiWindow = require(script.Parent:WaitForChild("UiWindow") :: ModuleScript)
local ArsenalTabs = require(script.Parent:WaitForChild("ArsenalTabs") :: ModuleScript)

local Panel = {}
local T = UiKit.Theme

-- Customization ------------------------------------------------------------------------------
local WINDOW_SIZE = Vector2.new(760, 560)
local TABS = { "Spells", "Weapons", "Forge" }
local TAB_TEXT: { [string]: string } = { Spells = "Qi Sorcery", Weapons = "Weapons", Forge = "Transmutation" }
-- Hints are built from the live bindings and settings so they cannot drift from the game.
local function hint(tab: string, label: (string) -&gt; string): string
	if tab == "Spells" then
		return string.format("Slot 1 casts on [%s] · Slot 2 on [%s] · Melee hits +%d Qi · Perfect deflects +%d Qi",
			label("SpellOne"), label("SpellTwo"), Settings.Qi.GainOnHit, Settings.Qi.GainOnDeflect)
	elseif tab == "Weapons" then
		-- The Jade Catalyst's card states its own sorcery focus; a third sentence was clipped here (F05).
		return "Numbers use your current attributes and forge levels; ▲ beats your wielded weapon, ▼ falls short."
	end
	return "Each remembrance forges ONE weapon or spell. The choice is permanent. Visit Gao's Loggia."
end
export type View = {
	Root: Frame, List: ScrollingFrame, Send: (any) -&gt; (), Inventory: any, Label: (string) -&gt; string,
	Window: UiWindow.Window, Tab: string, Tabs: { [string]: TextButton }, Hint: TextLabel,
}

local function attributes(): { [string]: number }
	local player, result = Players.LocalPlayer, {}
	for _, id in Rules.Attributes do result[id] = tonumber(player:GetAttribute("Asura" .. id)) or 10 end
	return result
end

local function render(view: View)
	for _, child in view.List:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	for name, tab in view.Tabs do
		tab.TextColor3 = if name == view.Tab then T.Gold else T.Muted;
		(tab:FindFirstChild("Underline") :: Frame).Visible = name == view.Tab
	end
	view.Hint.Text = hint(view.Tab, view.Label)
	local inv = view.Inventory
	if not inv then
		HudKit.label(view.List, "The arsenal stirs…", 18, T.BodyFont, T.Muted, { Size = UDim2.new(1, 0, 0, 40) })
		return
	end
	local fill: (send: (any) -&gt; (), inv: any, list: ScrollingFrame, env: ArsenalTabs.Env) -&gt; () = if view.Tab == "Spells" then ArsenalTabs.Spells elseif view.Tab == "Weapons" then ArsenalTabs.Weapons else ArsenalTabs.Forge
	fill(view.Send, inv, view.List, { Label = view.Label, Attributes = attributes() })
	if UserInputService.GamepadEnabled and UiWindow.isOpen(view.Window) then
		GuiService.SelectedObject = view.List:FindFirstChildWhichIsA("TextButton", true)
	end
end

-- `label` maps an InputMap command to the key shown for the current device (InputController:Label).
function Panel.new(gui: ScreenGui, send: (any) -&gt; (), label: ((string) -&gt; string)?): View
	local view: View
	local window = UiWindow.new(gui, "ArsenalPanel", "Arsenal", "Weapons · Qi Sorcery · Transmutation", WINDOW_SIZE, function() Panel.close(view) end)
	local tabs = HudKit.make("Frame", window.Body, { Name = "Tabs", Size = UDim2.new(1, -50, 0, 38), BackgroundTransparency = 1 }) :: Frame
	HudKit.make("UIListLayout", tabs, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
	local list = HudKit.make("ScrollingFrame", window.Body, {
		Name = "List", Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 1, -92), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 4, ScrollBarImageColor3 = T.Edge, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
	}) :: ScrollingFrame
	HudKit.make("UIListLayout", list, { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
	HudKit.make("UIPadding", list, { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 2) })
	local hintLabel = HudKit.label(window.Body, "", 14, T.BodyFont, T.Muted, {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 36), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
	})
	local keys = label or function(command: string): string return InputMap.label(command, "Keyboard") end
	view = { Root = window.Root, List = list, Send = send, Inventory = nil, Label = keys, Window = window, Tab = "Spells", Tabs = {}, Hint = hintLabel }
	for order, name in TABS do
		local tab = UiKit.button(tabs, TAB_TEXT[name], "Ghost", function()
			view.Tab = name
			render(view)
		end)
		tab.LayoutOrder, tab.Size = order, UDim2.new(1 / #TABS, -6, 1, 0)
		HudKit.make("Frame", tab, { Name = "Underline", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -3), Size = UDim2.new(0.6, 0, 0, 2), BackgroundColor3 = T.Gold, BorderSizePixel = 0 })
		view.Tabs[name] = tab
	end
	render(view)
	return view
end

function Panel.update(view: View, inventory: any)
	view.Inventory = inventory
	render(view)
end

function Panel.isOpen(view: View): boolean
	return UiWindow.isOpen(view.Window)
end

function Panel.open(view: View)
	UiWindow.open(view.Window)
	render(view)
end

function Panel.close(view: View)
	UiWindow.close(view.Window)
end

return table.freeze(Panel)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="642">
            <Properties>
              <string name="Name">ArsenalTabs</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ArsenalTabs
-- Card rendering for the Arsenal's three tabs (spells, weapons, transmutation). Each card is a
-- raised lacquer row with a discipline/state accent bar, name, wrapped lines from ArsenalFacts
-- (practical use, targeting/cost or style, effects or a comparison with the wielded weapon).
-- Pure presentation: actions call `send` with ArsenalIntent packets; the server validates.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Catalog = require(Shared:WaitForChild("Shared"):WaitForChild("ArsenalCatalog") :: ModuleScript)
local Spells = require(Shared:WaitForChild("Simulation"):WaitForChild("SpellSchema") :: ModuleScript)
local Weapons = require(Shared:WaitForChild("Simulation"):WaitForChild("WeaponSchema") :: ModuleScript)
local Facts = require(Shared:WaitForChild("Shared"):WaitForChild("ArsenalFacts") :: ModuleScript)
local Inventory = require(Shared:WaitForChild("Simulation"):WaitForChild("ArsenalInventory") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)

local Tabs = {}
local T = UiKit.Theme

-- Customization ------------------------------------------------------------------------------
local CONFIRM_SECONDS = 3 -- forging is permanent: the first press arms, the second commits
local DISCIPLINE: { [string]: { Name: string, Color: Color3 } } = {
	CelestialThunder = { Name = "Celestial Thunder", Color = Color3.fromRGB(120, 170, 235) },
	CrimsonFlame = { Name = "Crimson Flame", Color = T.Ember },
	AbyssalVoid = { Name = "Abyssal Void", Color = Color3.fromRGB(140, 96, 186) },
	SpiritTalismans = { Name = "Spirit Talismans", Color = Color3.fromRGB(86, 168, 92) },
}

export type Env = { Label: (command: string) -&gt; string, Attributes: { [string]: number } }
export type Line = { Text: string, Color: Color3, Size: number }

-- A card grows with its text: title, then wrapped lines (use, details, effects/comparison).
local function card(list: ScrollingFrame, order: number, title: string, lines: { Line }, accent: Color3, actionWidth: number): Frame
	local frame = HudKit.make("Frame", list, {
		Name = title, LayoutOrder = order, Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Raised, BackgroundTransparency = 0.2, BorderSizePixel = 0,
	}) :: Frame
	HudKit.make("UICorner", frame, { CornerRadius = UDim.new(0, T.Radius) })
	HudKit.make("UIStroke", frame, { Color = T.Edge, Transparency = 0.5 })
	HudKit.make("Frame", frame, { Name = "Accent", Position = UDim2.fromOffset(0, 10), Size = UDim2.new(0, 3, 1, -20), BackgroundColor3 = accent, BorderSizePixel = 0 })
	local text = HudKit.make("Frame", frame, {
		Name = "Text", Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -actionWidth - 36, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
	}) :: Frame
	HudKit.make("UIListLayout", text, { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
	HudKit.make("UIPadding", text, { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10) })
	HudKit.label(text, title, 20, T.BodyFont, T.Ivory, { Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 0 })
	for index, line in lines do
		if line.Text ~= "" then
			HudKit.label(text, line.Text, line.Size, T.BodyFont, line.Color, {
				Name = "Line" .. index, Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = index,
			})
		end
	end
	local actions = HudKit.make("Frame", frame, {
		Name = "Actions", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, actionWidth, 0, 38), BackgroundTransparency = 1,
	}) :: Frame
	HudKit.make("UIListLayout", actions, { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
	return actions
end

local function lines(l: Facts.Lines): { Line }
	return { { Text = l.Use, Color = T.Ivory, Size = 15 }, { Text = l.Detail, Color = T.Muted, Size = 14 }, { Text = l.Effects, Color = T.Gold, Size = 14 } }
end

local function action(actions: Frame, text: string, variant: UiKit.Variant, width: number, enabled: boolean, fn: () -&gt; ()): TextButton
	local b = UiKit.button(actions, text, variant, fn)
	b.Size = UDim2.new(0, width, 1, 0)
	b.TextSize, b.TextScaled = 17, true
	HudKit.make("UITextSizeConstraint", b, { MinTextSize = 11, MaxTextSize = 17 })
	UiKit.setEnabled(b, enabled)
	return b
end

-- Slot buttons use Arabic numerals plus the live binding ("Slot 2 [E]"): the old Roman two
-- was hard to tell from one in the menu font.
function Tabs.slotText(slot: number, key: string, equipped: boolean): string
	return (if equipped then "✓ " else "") .. "Slot " .. slot .. " [" .. key .. "]"
end

function Tabs.Spells(send: (any) -&gt; (), inv: any, list: ScrollingFrame, env: Env)
	local ctx = Facts.context(inv, env.Attributes)
	for order, id in Spells.Order do
		local s = Spells.ById[id]
		if inv.spells[id] and s then
			local school = DISCIPLINE[s.Discipline] or { Name = s.Discipline, Color = T.Gold }
			local facts = Facts.spell(id, ctx)
			facts.Detail = school.Name .. "  ·  " .. facts.Detail
			local actions = card(list, order, s.Name, lines(facts), school.Color, 248)
			for slot, command in { "SpellOne", "SpellTwo" } do
				local on = inv.spellSlots[slot] == id
				local b = action(actions, Tabs.slotText(slot, env.Label(command), on), if on then "Primary" else "Secondary", 120, true, function()
					send({ action = "EquipSpell", id = id, slot = slot })
				end)
				b.Font = Enum.Font.GothamMedium -- the menu face draws an old-style "1" that reads as "ı" (F05)
			end
		end
	end
end

function Tabs.Weapons(send: (any) -&gt; (), inv: any, list: ScrollingFrame, env: Env)
 local talismans=if inv.materials then inv.materials.LastBreathTalisman or 0 else 0
 if talismans&gt;0 then
  local actions=card(list,0,"Last Breath Talisman",{{Text=tostring(talismans).." owned · wards one fatal blow for 30 seconds",Color=T.Muted,Size=14}},T.Gold,104)
  action(actions,"Invoke","Primary",104,true,function() send({action="UseTalisman"}) end)
 end
	local ctx = Facts.context(inv, env.Attributes)
	for order, id in Weapons.WeaponKeys do
		if inv.weapons[id] then
			local w = Weapons.get(id :: any) -- WeaponKeys is typed string[]; get() wants the key union
			local main, off = inv.mainhand == id, inv.offhand == id
			local facts = Facts.weapon(id, ctx)
			if off then facts.Detail = "Off-hand focus  ·  " .. facts.Detail end
			local actions = card(list, order, w.Name, lines(facts), if main then T.Gold else T.Edge, if id == "Catalyst" then 236 else 120)
			action(actions, if main then "✓ Wielded" else "Wield", if main then "Primary" else "Secondary", 112, not main, function()
				send({ action = "EquipWeapon", id = id, offhand = false })
			end)
			if id == "Catalyst" then
				action(actions, if off then "✓ Off-hand" else "Off-hand", "Secondary", 116, not off, function()
					send({ action = "EquipWeapon", id = id, offhand = true })
				end)
			end
		end
	end
end

-- Readiness is ArsenalInventory.recipeState (token objects, the server forge's rule), by sovereign.
function Tabs.Forge(send: (any) -&gt; (), inv: any, list: ScrollingFrame, _env: Env)
	local order = 0
	for _, boss in Catalog.TokenOrder do
		local ids = {}
		for id, r in Catalog.Recipes do if r.Boss == boss then table.insert(ids, id) end end
		table.sort(ids, function(a, b) return Catalog.Recipes[a].Kind &gt; Catalog.Recipes[b].Kind end) -- weapon, then spell
		for _, id in ids do
			order += 1
			local r, name, state = Catalog.Recipes[id], (string.gsub(boss, "(%l)(%u)", "%1 %2")), Inventory.recipeState(inv, id)
			local ready = state == "Ready"
			local detail = { { Text = r.Kind .. " · Remembrance of " .. name, Color = T.Muted, Size = 14 },
				{ Text = string.format(Catalog.ForgeStates[state], name), Color = if ready then T.Gold else T.Muted, Size = 14 } }
			local actions, armed, button = card(list, order, r.Name, detail, if ready then T.Gold else T.Edge, 120), false, nil :: TextButton?
			button = action(actions, if ready then "Forge" else state, if ready then "Primary" else "Ghost", 112, ready, function()
				if armed then send({ action = "Forge", id = id }); return end
				armed = true; (button :: TextButton).Text = "Confirm?"
				task.delay(CONFIRM_SECONDS, function() armed = false; if button and button.Parent then button.Text = "Forge" end end)
			end)
		end
	end
end

return table.freeze(Tabs)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="643">
            <Properties>
              <string name="Name">BillboardFx</string>
              <string name="Source">--!strict
-- Camera-facing 2D shapes drawn in the world with BillboardGuis: glowing rings, 4-point lens-flare
-- sparkles, jagged starbursts and spinning crescent arcs (BillboardShapes has the rest). Sizes are
-- in studs; stroke widths follow the on-screen size so a ring stays a ring at any distance.
local RunService = game:GetService("RunService")
local Kit = require(script.Parent.SkillKit)
local Bb = {}

local WHITE = Color3.new(1, 1, 1)
local function seq(...: number): NumberSequence
	local keys, args = {}, { ... }
	for n = 1, #args, 2 do table.insert(keys, NumberSequenceKeypoint.new(args[n], args[n + 1])) end
	return NumberSequence.new(keys)
end
local TIP = seq(0, 1, 0.5, 0, 1, 1) -- transparent ends, solid middle

-- An invisible anchored point to hang boards on (world position, not a character limb).
function Bb.anchor(parent: Instance, at: Vector3): BasePart
	local p = Kit.part(parent, "BoardAnchor", WHITE, Vector3.one * 0.1, CFrame.new(at))
	p.Transparency = 1
	return p
end

function Bb.board(trove: Kit.Trove, adornee: Instance, studs: number): BillboardGui
	local gui = Kit.add(trove, Instance.new("BillboardGui"))
	gui.Adornee, gui.Size, gui.LightInfluence, gui.AlwaysOnTop = adornee, UDim2.fromScale(studs, studs), 0, false
	gui.MaxDistance, gui.ZIndexBehavior, gui.Brightness = 2000, Enum.ZIndexBehavior.Sibling, 2 -- glows like the clip's light
	gui.Parent = adornee
	return gui
end

local function frame(parent: Instance, color: Color3, size: UDim2, rotation: number?, z: number?): Frame
	local f = Instance.new("Frame")
	f.AnchorPoint, f.Position, f.Size, f.BackgroundColor3 = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), size, color
	f.BorderSizePixel, f.Rotation, f.ZIndex = 0, rotation or 0, z or 1
	f.Parent = parent
	return f
end

local function round(f: GuiObject)
	local c = Instance.new("UICorner")
	c.CornerRadius, c.Parent = UDim.new(0.5, 0), f
end

-- Hollow circle with a stroke `ratio` of its on-screen width; returns the stroke to animate.
local function circle(gui: BillboardGui, color: Color3, scale: number, ratio: number, transparency: number, trove: Kit.Trove): UIStroke
	local f = frame(gui, color, UDim2.fromScale(scale, scale))
	f.BackgroundTransparency = 1
	round(f)
	local stroke = Instance.new("UIStroke")
	stroke.Color, stroke.Transparency, stroke.Parent = color, transparency, f
	Kit.add(trove, RunService.Heartbeat:Connect(function()
		stroke.Thickness = math.max(1, gui.AbsoluteSize.X * scale * ratio)
	end))
	return stroke
end

Bb.seq, Bb.frame, Bb.round, Bb.circle = seq, frame, round, circle -- for the other shape modules

-- The circle: a white-hot ring with a cyan glow that snaps open from `from` to `to` studs.
-- `weight` thickens every layer (the detonation's white donut is ~4).
function Bb.ring(trove: Kit.Trove, adornee: Instance, glow: Color3, from: number, to: number, grow: number, hold: number, fade: number, weight: number?): BillboardGui
	local gui = Bb.board(trove, adornee, from)
	local w = weight or 1
	local strokes = { circle(gui, glow, 0.92, 0.07 * w, 0.75, trove), circle(gui, glow, 0.92, 0.035 * w, 0.35, trove), circle(gui, WHITE, 0.92, 0.012 * w + 0.02 * (w - 1), 0, trove) } -- heavy rings are mostly white
	Kit.tween(trove, gui, grow, { Size = UDim2.fromScale(to, to) }, Enum.EasingStyle.Quart)
	Kit.after(trove, grow + hold, function()
		for _, s in strokes do Kit.tween(trove, s, fade, { Transparency = 1 }) end
		Kit.tween(trove, gui, fade, { Size = UDim2.fromScale(to * 1.08, to * 1.08) })
	end)
	return gui
end

-- 4-point lens-flare sparkle (long horizontal spike, shorter vertical, hot centre) that twinkles.
function Bb.sparkle(trove: Kit.Trove, adornee: Instance, color: Color3, studs: number, seconds: number, tilt: number?): BillboardGui
	local gui = Bb.board(trove, adornee, studs)
	local holder = frame(gui, color, UDim2.fromScale(1, 1), tilt)
	holder.BackgroundTransparency = 1
	for _, bar in { { 1, 0.045, 0 }, { 0.6, 0.04, 90 }, { 0.35, 0.03, 45 }, { 0.35, 0.03, -45 } } do
		local f = frame(holder, color, UDim2.fromScale(bar[1], bar[2]), bar[3])
		local g = Instance.new("UIGradient")
		g.Transparency, g.Color, g.Parent = TIP, ColorSequence.new({ ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(0.5, WHITE), ColorSequenceKeypoint.new(1, color) }), f
	end
	local glow = frame(holder, color, UDim2.fromScale(0.16, 0.16), 0, 2)
	glow.BackgroundTransparency = 0.45
	round(glow)
	round(frame(holder, WHITE, UDim2.fromScale(0.06, 0.06), 0, 3))
	holder.Size = UDim2.fromScale(0, 0)
	Kit.tween(trove, holder, seconds * 0.3, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back)
	Kit.after(trove, seconds * 0.55, function() Kit.tween(trove, holder, seconds * 0.45, { Size = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In) end)
	return gui
end

-- Jagged anime starburst: `count` tapered spikes of random length, re-cut every frame so it boils.
function Bb.starburst(trove: Kit.Trove, adornee: Instance, colors: { Color3 }, studs: number, count: number): BillboardGui
	local gui = Bb.board(trove, adornee, studs)
	local spikes: { Frame } = {}
	for n = 1, count do
		local f = frame(gui, colors[(n % #colors) + 1], UDim2.fromScale(0.5, 0.06), 0, if n % 3 == 0 then 2 else 1)
		local g = Instance.new("UIGradient")
		g.Transparency, g.Parent = seq(0, 1, 0.42, 0.05, 0.5, 0, 0.58, 0.05, 1, 1), f
		spikes[n] = f
	end
	local core = frame(gui, colors[1], UDim2.fromScale(0.26, 0.26), 0, 4)
	round(core)
	local base = math.random() * 360
	Kit.add(trove, RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for n, f in spikes do
			local length = 0.45 + 0.55 * (0.5 + 0.5 * math.noise(n * 1.7, t * 9))
			f.Size = UDim2.fromScale(length, 0.05 + 0.04 * (n % 3))
			f.Rotation = base + n / #spikes * 180 + math.noise(n, t * 4) * 14
		end
	end))
	return gui
end

-- Crescent arc: `span` (0..1) of a glowing circle, spinning at `speed` degrees per second.
function Bb.arc(trove: Kit.Trove, adornee: Instance, color: Color3, studs: number, span: number, speed: number, weight: number?): BillboardGui
	local gui = Bb.board(trove, adornee, studs)
	local w = weight or 1
	local cut = math.clamp(span, 0.05, 0.95)
	local mask = seq(0, 1, 0.5 - cut / 2, 1, 0.5 - cut / 2 + 0.02, 0, 0.5 + cut / 2 - 0.02, 0, 0.5 + cut / 2, 1, 1, 1)
	local grads: { UIGradient } = {}
	for _, layer in { { color, 0.09, 0.6 }, { color, 0.04, 0.1 }, { WHITE, 0.014, 0 } } do
		local stroke = circle(gui, layer[1], 0.9, layer[2] * w, layer[3], trove)
		local g = Instance.new("UIGradient")
		g.Transparency, g.Parent = mask, stroke
		table.insert(grads, g)
	end
	local angle = math.random() * 360
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		angle += speed * dt
		for _, g in grads do g.Rotation = angle end
	end))
	return gui
end

return table.freeze(Bb)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="644">
            <Properties>
              <string name="Name">BillboardShapes</string>
              <string name="Source">--!strict
-- The Supernova's one-off billboard shapes: the merged five-lobed detonation blob, the hollow gold
-- 4-point stars by the planet and the vertical lens-flare line. Built on BillboardFx's helpers.
local Kit = require(script.Parent.SkillKit)
local Bb = require(script.Parent.BillboardFx)
local Shapes = {}

local WHITE = Color3.new(1, 1, 1)

-- Detonation blob: a white core with `lobes` bulges under a soft glowing rim, swelling from 40% to
-- `studs` over `grow` seconds and then fading over `fade` (the reference's white star-burst).
function Shapes.blob(trove: Kit.Trove, adornee: Instance, glow: Color3, studs: number, lobes: number, grow: number, fade: number): BillboardGui
	local gui = Bb.board(trove, adornee, studs * 0.4)
	-- One CanvasGroup so the lobes fade as a single merged shape, never as overlapping circles.
	local group = Instance.new("CanvasGroup")
	group.Size, group.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	group.Parent = gui
	local function puff(x: number, y: number, d: number)
		for _, layer in { { glow, 1.3, 0.45, 1 }, { WHITE, 1, 0, 2 } } do
			local f = Bb.frame(group, layer[1], UDim2.fromScale(d * layer[2], d * layer[2]), 0, layer[4])
			f.Position, f.BackgroundTransparency = UDim2.fromScale(x, y), layer[3]
			Bb.round(f)
		end
	end
	puff(0.5, 0.5, 0.48)
	local spin = math.random() * math.pi * 2
	for n = 1, lobes do
		local a = spin + n / lobes * math.pi * 2
		puff(0.5 + math.cos(a) * 0.25, 0.5 + math.sin(a) * 0.25, 0.24 + math.random() * 0.1)
	end
	Kit.tween(trove, gui, grow, { Size = UDim2.fromScale(studs, studs) }, Enum.EasingStyle.Quart)
	Kit.after(trove, grow, function() Kit.tween(trove, group, fade, { GroupTransparency = 1 }) end)
	return gui
end

-- A hollow 4-point star outline (the reference's gold stars hanging by the planet), fading in and out.
function Shapes.star(trove: Kit.Trove, adornee: Instance, color: Color3, studs: number, seconds: number): BillboardGui
	local gui = Bb.board(trove, adornee, studs)
	local group = Instance.new("CanvasGroup")
	group.Size, group.BackgroundTransparency, group.GroupTransparency = UDim2.fromScale(1, 1), 1, 1
	group.Parent = gui
	local tips = { Vector2.new(0.5, 0), Vector2.new(1, 0.5), Vector2.new(0.5, 1), Vector2.new(0, 0.5) }
	local points: { Vector2 } = {}
	for n, tip in tips do
		local nxt = tips[(n % 4) + 1]
		table.insert(points, tip)
		table.insert(points, Vector2.new(0.5, 0.5) + ((tip + nxt) / 2 - Vector2.new(0.5, 0.5)) * 0.3)
	end
	for n, a in points do
		local b = points[(n % #points) + 1]
		local mid, delta = (a + b) / 2, b - a
		local f = Bb.frame(group, color, UDim2.fromScale(delta.Magnitude + 0.02, 0.03), math.deg(math.atan2(delta.Y, delta.X)))
		f.Position = UDim2.fromScale(mid.X, mid.Y)
	end
	Kit.tween(trove, group, seconds * 0.25, { GroupTransparency = 0.25 })
	Kit.after(trove, seconds * 0.7, function() Kit.tween(trove, group, seconds * 0.3, { GroupTransparency = 1 }) end)
	return gui
end

-- A thin vertical flare line through `adornee` (lens streak).
function Shapes.line(trove: Kit.Trove, adornee: Instance, color: Color3, studs: number, seconds: number)
	local gui = Bb.board(trove, adornee, studs)
	local f = Bb.frame(gui, WHITE, UDim2.fromScale(0.012, 1))
	local g = Instance.new("UIGradient")
	g.Transparency, g.Color, g.Parent = Bb.seq(0, 1, 0.5, 0, 1, 1), ColorSequence.new({ ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(0.5, WHITE), ColorSequenceKeypoint.new(1, color) }), f
	Kit.tween(trove, f, seconds, { Size = UDim2.fromScale(0.004, 1.2), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

return table.freeze(Shapes)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="645">
            <Properties>
              <string name="Name">BlazingSunShow</string>
              <string name="Source">--!strict
-- Blazing Sun Awakening, cut to the reference video (startup phases are fractions of the server
-- windup; the release and pulses wait for the authoritative cues):
--   0.00 the world goes orange duotone, white sparkles, low close-up on the face
--   0.07 extreme close-up along cheek and shoulder   0.33 "BOOM." bubble
--   0.39 black void, medium shot; 0.42 an ember kindles on the chest   0.80 a thorn ring clamps it
--   0.88 it bursts into a sunburst that fills the frame
--   release: red splatter, shard burst, black/white ground frame, the camera inside a 3D firestorm
--   with the silhouette burning through, gradient wash, dark sun frame;
--   +3.5 black silhouette, blazing star eyes, ember rain   +5.4 burning fists with gold crescents
-- Void, camera, grading and 2D layers are the caster's; everyone nearby sees the fire in the world.
local Kit = require(script.Parent.SkillKit)
local Fx = require(script.Parent.SkillFx)
local Cinema = require(script.Parent.SkillCinema)
local Screen = require(script.Parent.ImpactFrame)
local Flame = require(script.Parent.FlameForms)
local Bb = require(script.Parent.BillboardFx)
local Manga = require(script.Parent.MangaFx)
local Canvas = require(script.Parent.FireCanvas)
local Stage = require(script.Parent.VoidStage)
local Sun = require(script.Parent.SunForms)
local Shots = require(script.Parent.SunShots)
local Ink = require(script.Parent.InkFrames)
local Storm = require(script.Parent.FireStorm)
local Sfx = require(script.Parent.SkillAudio)
local Show = {}

Show.FinalPulse = 4
local EYES, FISTS, FINISH = 3.55, 5.45, 8.6 -- seconds after release
local rgb = Color3.fromRGB

local function root(cast: any): BasePart?
	local r = cast.Entity.Root
	return if r and r.Parent then r else nil
end

local function sparkles(cast: any, trove: Kit.Trove, count: number)
	local r = root(cast)
	if not r then return end
	for n = 1, count do
		Kit.after(trove, (n - 1) * 0.12, function()
			local a = Kit.attach(trove, r, Vector3.new((math.random() - 0.5) * 6, 1 + math.random() * 3, -1 - math.random() * 2), "Twinkle")
			Bb.sparkle(trove, a, Color3.new(1, 1, 1), 0.9, 0.5, (math.random() - 0.5) * 30)
		end)
	end
end

function Show.startup(cast: any)
	local w = cast.Windup
	local tension = Kit.trove()
	cast.Bag.Tension = tension
	Kit.add(cast.Trove, function() Kit.clean(tension) end)
	local r = root(cast)
	Sfx.score(cast, "Sun", "Startup")
	sparkles(cast, tension, 6)
	if cast.Own then
		cast.Bag.Grade = Screen.grade(cast.Trove)
		cast.Bag.Hud = Kit.add(cast.Trove, Stage.hud())
		Stage.bloom(cast.Trove, 1, 26, 0.88, 0.4)
		Screen.settle(cast.Trove, cast.Bag.Grade, Stage.Grades.Duotone, 0.04)
		Shots.startup(cast)
		Kit.after(tension, w * 0.33, function() Manga.boom(tension, Vector2.new(0.28, 0.48), w * 0.1) end)
		Kit.after(tension, w * 0.39, function()
			local base = root(cast) or r
			if not base then return end
			cast.Bag.Void = Stage.void(cast.Trove, base.Position, 40, 2.8, 60, rgb(4, 2, 2), { cast.Entity.Model })
			cast.Bag.Key = Stage.key(cast.Trove, base, rgb(255, 120, 50), 2.5)
		end)
	end
	if not r then return end
	local chest = Sun.chest(tension, r)
	Kit.after(tension, w * 0.42, function()
		local ember = Sun.ember(tension, chest)
		Kit.tween(tension, ember, w * 0.4, { Size = UDim2.fromScale(3, 3) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	Kit.after(tension, w * 0.8, function()
		Sun.thorns(tension, chest, 4.2)
		if cast.Own then Cinema.shake(cast.Cinema, 0.25, 1, 2) end
	end)
	Kit.after(tension, w * 0.88, function()
		local burst = Bb.starburst(tension, chest, Sun.Burst, 3, 14)
		Kit.tween(tension, burst, w * 0.11, { Size = UDim2.fromScale(16, 16) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Kit.light(chest, Sun.Burst[3], 30, 6)
	end)
end

-- The blast as the reference draws it, then the eyes, then the fists.
function Show.release(cast: any, at: Vector3)
	if cast.Bag.Tension then Kit.clean(cast.Bag.Tension) end
	local folder = Kit.folder(cast.Trove, "BlazingSunAwakening")
	cast.Bag.Folder = folder
	Sfx.score(cast, "Sun", "Release")
	local model = cast.Entity.Model
	local floor = CFrame.new(at - Vector3.new(0, 2.8, 0))
	Flame.shockwave(cast.Trove, folder, floor)
	Fx.flash(cast.Trove, folder, at, Sun.Burst[2], 26, 0.6)
	Fx.burst(Bb.anchor(folder, at), ColorSequence.new(Sun.Burst[1], Sun.Burst[4]), 70, 45)
	if cast.Own then
		-- Timed to the reference: red splatter, white shard burst, black/white ground, then the fire.
		Ink.splatter(cast.Trove, 0.05)
		Kit.after(cast.Trove, 0.055, function() Ink.shards(cast.Trove, 0.06) end)
		Kit.after(cast.Trove, 0.115, function() Manga.groundFlash(cast.Trove, 0.1) end)
		Kit.after(cast.Trove, 0.22, function() Storm.engulf(cast.Trove, 2.45) end)
		Kit.after(cast.Trove, 0.27, function() Canvas.emerge(cast.Trove, model, 0.3) end)
		Kit.after(cast.Trove, 2.67, function() Canvas.wash(cast.Trove, 0.45) end)
		Kit.after(cast.Trove, 3.12, function() Canvas.sunFrame(cast.Trove, 0.42) end)
		Cinema.shake(cast.Cinema, 0.9, 0.5, 2)
		Shots.release(cast, EYES, FISTS, FINISH)
	end
	local head = Kit.head(model)
	Kit.after(cast.Trove, EYES, function()
		if not head then return end
		local eyes = Kit.trove()
		cast.Bag.Eyes = eyes
		Kit.add(cast.Trove, function() Kit.clean(eyes) end)
		local flares = Sun.eyes(eyes, head, 2.3)
		if cast.Own then
			if cast.Bag.Void then Stage.tint(cast.Trove, cast.Bag.Void, rgb(96, 26, 10), 0.05) end
			cast.Bag.Mask = Stage.silhouette(eyes, model, rgb(8, 4, 3))
			Screen.settle(cast.Trove, cast.Bag.Grade or Screen.grade(cast.Trove), Stage.Grades.Ember, 0.05)
		end
		Kit.after(cast.Trove, FISTS - EYES, function()
			for _, f in flares do f.Scale = 0.9 end
			if cast.Bag.Mask then cast.Bag.Mask:Destroy() end
		end)
	end)
	Kit.after(cast.Trove, FISTS, function()
		for _, hand in Kit.hands(model) do Sun.gauntlet(cast.Trove, hand) end
		if cast.Own and cast.Bag.Void then Stage.tint(cast.Trove, cast.Bag.Void, rgb(8, 4, 3), 0.3) end
	end)
	Kit.after(cast.Trove, FINISH, function()
		if cast.Own then
			Stage.remove(cast.Bag.Void)
			if cast.Bag.Hud then cast.Bag.Hud() end
			Screen.settle(cast.Trove, cast.Bag.Grade or Screen.grade(cast.Trove), Stage.Grades.Neutral, 0.5)
		end
	end)
	Kit.after(cast.Trove, FINISH + 1.6, function() Kit.clean(cast.Trove) end)
end

-- Pulses: heat rings in the world and a kick of shake for the caster.
function Show.pulse(cast: any, at: Vector3)
	if cast.Pulses &lt;= 1 or not cast.Bag.Folder then return end
	Flame.heat(cast.Trove, cast.Bag.Folder, CFrame.new(at - Vector3.new(0, 2.8, 0)))
	Sfx.play(cast, "SunPulse", if cast.Pulses &gt;= Show.FinalPulse then 1.2 else 1)
	if cast.Own then Cinema.shake(cast.Cinema, if cast.Pulses &gt;= Show.FinalPulse then 0.6 else 0.35, 1.4, 2) end
end

return table.freeze(Show)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="646">
            <Properties>
              <string name="Name">BossAnimations</string>
              <string name="Source">--!strict
-- Client playback for the shared boss animation contract (BossAnimationRules, F10): every boss
-- actor resolves its own look, phase and attack to an authored override/custom track or a stock
-- stand-in. A creature with nothing authored keeps CreatureMotion's procedural pose; when an
-- authored track plays on it, AsuraAuthoredMotion (local to this client) makes CreatureMotion
-- release its welds so the two never transform the same joints. Cosmetic only.
local Rules = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.BossAnimationRules)
local Animations = {}
type Playing = { Signature: string, Key: string, Source: string, Track: AnimationTrack? }
local playing: { [Model]: Playing } = {}

local function rigOf(model: Model, humanoid: Humanoid?): string
	if model:GetAttribute("AsuraRig") == "Creature" then return "Creature" end
	return if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then "R6" else "R15"
end

local function signature(model: Model): (string, number, string)
	local look, phase = model:GetAttribute("AsuraLookKey"), model:GetAttribute("AsuraBossPhase")
	local key = if type(look) == "string" then look else model.Name
	local index = if type(phase) == "number" then phase else 1
	return key, index, key .. "|" .. index .. "|" .. tostring(model:GetAttribute("AsuraAnimationSet"))
end

local function stop(model: Model)
	local previous = playing[model]
	if previous and previous.Track then previous.Track:Stop(0.15); previous.Track:Destroy() end
	playing[model] = nil
end

local function play(model: Model, action: string, kind: string?): Rules.Resolved?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local look, phase, sig = signature(model)
	local resolved = Rules.resolve(look, phase, action, kind, rigOf(model, humanoid), function(name) return model:GetAttribute(name) end)
	model:SetAttribute("AsuraAnimationPlaying", resolved.Key .. "|" .. resolved.Source)
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	stop(model)
	if not resolved.Id or not animator then
		model:SetAttribute("AsuraAuthoredMotion", nil)
		playing[model] = { Signature = sig, Key = resolved.Key, Source = resolved.Source, Track = nil }
		return resolved
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = resolved.Id
	local ok, track = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	if not ok then return nil end
	track.Priority = (Enum.AnimationPriority :: any)[resolved.Priority]
	track.Looped = resolved.Looped
	track:Play(0.15, 1, resolved.Speed)
	model:SetAttribute("AsuraAuthoredMotion", if resolved.Source == "Override" or resolved.Source == "Custom" then true else nil)
	playing[model] = { Signature = sig, Key = resolved.Key, Source = resolved.Source, Track = track }
	return resolved
end
Animations.play = play

-- Keeps the idle for the current look and phase; a phase change re-resolves (and re-reads overrides).
function Animations.sync(model: Model)
	local _, _, sig = signature(model)
	local previous = playing[model]
	if previous and previous.Signature == sig and (previous.Track == nil or previous.Track.IsPlaying) then return end
	play(model, "Idle")
end

-- A telegraphed move (its catalogue id and kind) or the phase/oath transform.
function Animations.action(model: Model, transform: boolean, move: string?, kind: string?)
	play(model, if transform then "Transform" elseif move and move ~= "" then move else "Strike", kind)
end

-- Drops tracks of actors that have left the world (defeat, reset); called with the boss cues.
function Animations.prune()
	for model, entry in playing do
		if not model.Parent then
			if entry.Track then entry.Track:Destroy() end
			playing[model] = nil
		end
	end
end
function Animations.clear()
	for model in playing do
		stop(model)
		if model.Parent then model:SetAttribute("AsuraAuthoredMotion", nil) end
	end
end
return Animations
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="647">
            <Properties>
              <string name="Name">BossCinematics</string>
              <string name="Source">--!strict
local WorldState = require(script.Parent.WorldStateController)
local Cinematics = {}
export type Shot = { Target: number, Start: number, Duration: number, From: CFrame, Finish: boolean, Speeds: { [AnimationTrack]: number }, Span: number }
-- Framing grows with the actor (batch 11): a scale-3 Titan or a winged Wyrm is framed whole
-- instead of the camera sitting inside its body at the old fixed 14 studs.
function Cinematics.span(model: Model?): number
	if not model then return 6 end
	local ok, size = pcall(function() return model:GetExtentsSize() end)
	return if ok then math.clamp(math.max(size.Y, size.Z * 0.8), 6, 40) else 6
end
function Cinematics.begin(camera: Camera, state: WorldState.WorldState, id: number, duration: number, finish: boolean): Shot
	local speeds: { [AnimationTrack]: number } = {}
	if finish then
		for _, entity in { state:Get(id), state:Own() } do
			local animator = entity and entity.Humanoid and entity.Humanoid:FindFirstChildOfClass("Animator")
			if animator then for _, track in animator:GetPlayingAnimationTracks() do speeds[track] = if track.Speed &gt; 0 then track.Speed else 1; track:AdjustSpeed(0.25) end end
		end
	end
	local entity = state:Get(id)
	return { Target = id, Start = os.clock(), Duration = duration, From = camera.CFrame, Finish = finish, Speeds = speeds,
		Span = Cinematics.span(entity and entity.Model) }
end
function Cinematics.restore(shot: Shot?)
	if shot then for track, speed in shot.Speeds do if track.IsPlaying then track:AdjustSpeed(speed) end end end
end
function Cinematics.step(shot: Shot?, state: WorldState.WorldState, camera: Camera): boolean
	if not shot then return false end
	local elapsed = os.clock() - shot.Start
	local entity = state:Get(shot.Target)
	local own = state:Own()
	if elapsed &gt;= shot.Duration or not entity or not entity.Root or not own or not own.Snapshot or own.Snapshot.State == "KO" then
		Cinematics.restore(shot); return false
	end
	if shot.Finish then
		-- Deathblow tracks can arrive after the finish cue; include them as they start.
		for _, actor in { entity, own } do
			local animator = actor.Humanoid and actor.Humanoid:FindFirstChildOfClass("Animator")
			if animator then for _, track in animator:GetPlayingAnimationTracks() do
				if shot.Speeds[track] == nil then shot.Speeds[track] = if track.Speed &gt; 0 then track.Speed else 1 end
				if track.Speed &gt; 0.25 then track:AdjustSpeed(0.25) end
			end end
		end
	end
	local span = shot.Span
	local target = entity.Root.Position + Vector3.new(0, span * 0.3, 0)
	local view = target + entity.Root.CFrame.LookVector * (span * 1.4 + 6) + entity.Root.CFrame.RightVector * (span * 0.55 + 3.5) + Vector3.new(0, span * 0.2 + 3.5, 0)
	local goal = CFrame.lookAt(view, target)
	camera.CFrame = shot.From:Lerp(goal, math.clamp(elapsed / 0.65, 0, 1))
	camera.Focus = CFrame.new(target)
	camera.FieldOfView = if shot.Finish then 46 else 56
	return true
end
return Cinematics
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="648">
            <Properties>
              <string name="Name">BossEffects</string>
              <string name="Source">--!strict
local Tween = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local WorldState = require(script.Parent.WorldStateController)
local Comfort = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Effects = {}
local COLORS: { [string]: Color3 } = { ["Lightning+Iron"] = Color3.fromRGB(235, 197, 95), Frost = Color3.fromRGB(115, 220, 255), Thunder = Color3.fromRGB(100, 170, 255),
	Lightning = Color3.fromRGB(220, 205, 90), Void = Color3.fromRGB(138, 65, 215), Iron = Color3.fromRGB(165, 145, 95), Blood = Color3.fromRGB(210, 24, 46) }
local function spark(position: Vector3, color: Color3, size: Vector3, duration: number): Part
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Material, p.Color, p.Size, p.Position, p.Transparency = Enum.Material.Neon, color, size, position, 0.25
	p.Parent = workspace.CurrentCamera
	Debris:AddItem(p, duration)
	return p
end
local function ring(origin: Vector3, radius: number, duration: number, color: Color3)
	for i = 1, 32 do
		local angle = i * math.pi * 2 / 32
		local p = spark(origin, color, Vector3.new(1, 0.4, 1), duration + 0.2)
		p.CFrame *= CFrame.Angles(0, -angle, 0)
		Tween:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Position = origin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius),
			Size = Vector3.new(1, 0.4, radius * math.pi / 16), Transparency = 0.8 }):Play()
	end
end
local function lane(origin: Vector3, aim: Vector3, color: Color3, duration: number)
	local endpoint = aim + (aim - origin) * 2
	local delta = endpoint - origin
	if delta.Magnitude &lt; 1 then return end
	local p = spark((origin + endpoint) / 2, color, Vector3.new(28, 0.4, delta.Magnitude), duration)
	p.CFrame, p.Transparency = CFrame.lookAt(p.Position, endpoint), 0.65
end
function Effects.cue(cue: WorldState.Cue, state: WorldState.WorldState)
	local d = cue.Data
	local entity = state:Get(cue.Source)
	local origin = if type(d.x) == "number" then Vector3.new(d.x, tonumber(d.y) or 0.5, tonumber(d.z) or 0) elseif entity and entity.Root then entity.Root.Position else Vector3.zero
	local color = COLORS[tostring(d.element)] or Color3.fromRGB(220, 35, 52)
	if cue.Kind == "Telegraph" and d.kind then
		local duration = math.max(0.1, (tonumber(d.impact) or cue.Time + 1) - cue.Time)
		if d.kind == "Breath" and type(d.ox) == "number" then lane(Vector3.new(d.ox, 0.4, d.oz), origin, color, duration)
		else ring(origin, math.min(tonumber(d.radius) or 15, 30), duration, color) end
	elseif cue.Kind == "BossHazard" then
		local radius, speed = tonumber(d.radius) or 30, tonumber(d.speed) or 36
		if d.kind == "Breath" then lane(origin, Vector3.new(d.ax, origin.Y, d.az), color, tonumber(d.duration) or 3)
		elseif d.kind == "Gravity" or d.kind == "Ritual" or (d.kind == "Leap" and d.element == "Frost") then
			local center = if d.kind == "Gravity" then Vector3.new(d.ax, 0.4, d.az) else origin
			local p = spark(center, color, Vector3.new(0.4, radius * 2, radius * 2), tonumber(d.duration) or 3)
			p.Shape, p.CFrame, p.Transparency = Enum.PartType.Cylinder, CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), 0.7
		else
			for i = 0, (tonumber(d.repeats) or 1) - 1 do
				task.delay(i * (tonumber(d.interval) or 1), function() ring(origin, radius, radius / speed, color) end)
			end
		end
	elseif cue.Kind == "BossProjectile" then
		local p = spark(origin, Color3.fromRGB(150, 110, 245), Vector3.new(0.6, 0.6, 4), 0.08)
		p.Transparency = 0.05
	elseif cue.Kind == "BossPhase" or cue.Kind == "BossEnrage" or cue.Kind == "BossTeleport" then
		-- One brief translucent bloom sized to the actor; the phase reads on the body (CostumeKit) and
		-- the perilous ring and warning stay visible through it (it used to fill 35 studs for 1.4 s).
		local span = if entity and entity.Model then math.clamp(entity.Model:GetExtentsSize().Y, 6, 24) else 8
		if cue.Kind == "BossTeleport" then
			color = COLORS.Void -- the bloom marks the server's destination; a shade fades where Wu stood
			if entity and entity.Root and (entity.Root.Position - origin).Magnitude &gt; 3 then
				local shade = spark(entity.Root.Position, color, Vector3.new(2.4, span, 2.4), 0.6)
				shade.Transparency = 0.55
				Tween:Create(shade, TweenInfo.new(0.5), { Transparency = 1, Size = Vector3.new(0.4, span * 1.2, 0.4) }):Play()
			end
		end
		local p = spark(origin, color, Vector3.one * 2, 0.9)
		p.Shape, p.Transparency = Enum.PartType.Ball, 1 - Comfort.flash(0.4) -- reduced flashes: fainter, still marked
		Tween:Create(p, TweenInfo.new(0.8), { Size = Vector3.one * span * 1.6, Transparency = 1 }):Play()
	end
end
return Effects
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="649">
            <Properties>
              <string name="Name">BossHud</string>
              <string name="Source">--!strict
local Kit = require(script.Parent.HudKit)
local WorldState = require(script.Parent.WorldStateController)
local Hud = {}
function Hud.decorate(frame: Frame, title: string, phases: number)
	local old = frame:FindFirstChild("HonoraryTitle")
	if old then old:Destroy() end
	Kit.label(frame, title, 16, Enum.Font.Garamond, Kit.Palette.Gold, { Name = "HonoraryTitle", Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = true })
	local track = frame:FindFirstChild("Health") :: Frame
	for _, child in track:GetChildren() do if string.sub(child.Name, 1, 7) == "Segment" then child:Destroy() end end
	for i = 1, phases do
		Kit.make("Frame", track, { Name = "Segment" .. i, Size = UDim2.fromOffset(6, 6), Position = UDim2.new((i - 0.5) / phases, -3, 1, 5),
			Rotation = 45, BorderSizePixel = 0, BackgroundColor3 = Kit.Palette.Gold })
		if i &lt; phases then Kit.make("Frame", track, { Name = "SegmentDivider" .. i, Size = UDim2.new(0, 2, 1, 0),
			Position = UDim2.fromScale(i / phases, 0), BackgroundColor3 = Kit.Palette.Ink, BorderSizePixel = 0, ZIndex = 3 }) end
	end
end
function Hud.values(frame: Frame, state: WorldState.WorldState, members: { number }): (number, number, number, boolean)
	local hp, recoverable, maximum, posture, capacity = 0, 0, 0, 0, 0
	local broken, phase = false, 1
	for _, id in members do
		local entity = state:Get(id)
		local s = entity and entity.Snapshot
		if not s then continue end
		if s.State == "KO" and #members &gt; 1 then phase += 1 end
		if s.State ~= "KO" then
			maximum += s.MaxHP
			hp += s.ActiveHP; recoverable += s.RecoverableHP
			posture += s.Posture; capacity += s.PostureCapacity
			broken = broken or s.State == "StanceBroken"
		end
		local value = entity.Model:GetAttribute("AsuraBossPhase")
		if type(value) == "number" then phase = math.max(phase, value) end
	end
	local track = frame:FindFirstChild("Health")
	if track then for _, child in track:GetChildren() do
		local i = tonumber(string.match(child.Name, "^Segment(%d+)$"))
		if i and child:IsA("Frame") then child.BackgroundTransparency = if i &lt; phase then 0.8 else 0 end
	end end
	return math.clamp(hp / math.max(maximum, 1), 0, 1), math.clamp((hp + recoverable) / math.max(maximum, 1), 0, 1),
		math.clamp(posture / math.max(capacity, 1), 0, 1), broken
end
return Hud
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="650">
            <Properties>
              <string name="Name">BossMusic</string>
              <string name="Source">--!strict
-- Authored SoundService.BossMusic_&lt;bossId&gt; tracks override the built-in rhythmic placeholder.
local SoundService = game:GetService("SoundService")
local Audio = require(script.Parent.SpatialAudio)
local Music = {}
export type Score = { Intensity: number, Beat: number, Track: Sound?, Connection: RBXScriptConnection? }
function Music.new(): Score
	return { Intensity = 0, Beat = 0, Track = nil, Connection = nil }
end
function Music.stop(score: Score)
	score.Intensity = 0
	if score.Track then score.Track:Stop(); score.Track:Destroy(); score.Track = nil end
	if score.Connection then score.Connection:Disconnect(); score.Connection = nil end
	SoundService:SetAttribute("AsuraBossMusicIntensity", 0)
	SoundService:SetAttribute("AsuraBossMusic", nil)
end
function Music.set(score: Score, bossId: string, intensity: number)
	if score.Intensity == 0 then
		local authored = SoundService:FindFirstChild("BossMusic_" .. bossId)
		if authored and authored:IsA("Sound") then
			local track = authored:Clone(); score.Track = track
			track.Parent = SoundService; track.Looped = true; track:Play()
		else
			score.Track = Audio.play("BossDrone", SoundService, 0.28, true)
		end
	end
	score.Intensity = intensity
	if score.Track then score.Track.PlaybackSpeed = 1 + (intensity - 1) * 0.12 end
	SoundService:SetAttribute("AsuraBossMusic", bossId)
	SoundService:SetAttribute("AsuraBossMusicIntensity", intensity)
end
return Music
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="651">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/CameraController
-- Third-person over-the-shoulder camera with lock-on. Yaw/pitch/distance are driven by critically
-- damped springs; a spherecast cast as the CameraProbe collision group (which only collides with
-- WorldGeometry) pulls the camera in front of walls and cage bars.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local BossCinematics = require(script.Parent.BossCinematics)
local Portrait = require(script.Parent.PortraitCamera)
local Effects = require(Shared:WaitForChild("Shared"):WaitForChild("EffectsPreference") :: ModuleScript) :: any
local Strike = require(Shared:WaitForChild("Simulation"):WaitForChild("StrikeGeometry") :: ModuleScript)

type WorldState = WorldState.WorldState
type Entity = WorldState.Entity

local Controller = {}
Controller.__index = Controller

local BASE_OFFSET = Vector3.new(1.8, 1.4, 10.5)
local CORRECTION_SPEED = 22
local MIN_DISTANCE, MAX_DISTANCE = 8, 16
local LOCK_RANGE = 60
local LOCK_BREAK_RANGE = 80
local PITCH_MIN, PITCH_MAX = math.rad(-70), math.rad(55)
local DEFAULT_PITCH = math.rad(-12)
local PROBE_RADIUS = 0.6
local PROBE_GROUP = "CameraProbe"
local OCCLUSION_RECOVER = 6
local SWITCH_COOLDOWN = 0.25
local SWITCH_MOUSE = 45
local SWITCH_STICK = 0.85

-- Rotational drag on lock tracking per head injury tier (concussion / eye trauma).
local TRAUMA_DRAG: { [string]: number } = { None = 1, Impaired = 0.75, Injured = 0.5, Severe = 0.3 }
local TRAUMA_WOBBLE: { [string]: number } = { None = 0, Impaired = 0.004, Injured = 0.01, Severe = 0.02 }

type Spring = { Value: number, Velocity: number }

type Fields = {
	BossShotState: BossCinematics.Shot?,
	State: WorldState,
	Camera: Camera,
	Yaw: Spring,
	Pitch: Spring,
	Distance: Spring,
	TargetYaw: number,
	TargetPitch: number,
	Occluded: number,
	Shoulder: number,
	ShoulderSpring: Spring,
	Locked: number?,
	FollowRoot: BasePart?, -- the body being framed; a new one (respawn) recentres the view
	LastSwitch: number,
	SwitchAccumulator: number,
	Fov: number,
	MovementFov: Spring,
	MovementDrop: Spring,
	MovementTilt: Spring,
	Gliding: boolean,
	Sliding: boolean,
	SlideTurn: number,
	Sensitivity: number,
	FovPunch: Spring,
	FovClamp: number,
	Shake: Vector3,
	ShakeVelocity: Vector3,
	Roll: number,
	Sway: number,
	HeadTier: string,
	Clock: number,
	Params: RaycastParams,
	Enabled: boolean,
 DialogueFrame: CFrame?,
	OnLockChanged: ((id: number?) -&gt; ())?,
}

export type CameraController = typeof(setmetatable({} :: Fields, Controller))

local function spring(value: number): Spring
	return { Value = value, Velocity = 0 }
end

-- Critically damped spring step (semi-implicit, stable at any frame rate up to 1/15 s).
local function stepSpring(s: Spring, target: number, omega: number, dt: number)
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for _ = 1, steps do
		local acceleration = omega * omega * (target - s.Value) - 2 * omega * s.Velocity
		s.Velocity += acceleration * h
		s.Value += s.Velocity * h
	end
end

-- Camera shake: a damped oscillator in camera space, sub-stepped like the springs. One explicit
-- step per frame is unstable above ~33 ms frames: at 7 FPS in Studio one hit impulse grew to 1e35,
-- froze the camera and hid every line-of-sight prompt (altars, portals).
local function stepShake(fields: Fields, dt: number)
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	for _ = 1, steps do
		local acceleration = -fields.Shake * 900 - fields.ShakeVelocity * 30
		fields.ShakeVelocity += acceleration * h
		fields.Shake += fields.ShakeVelocity * h
	end
end

local function wrap(angle: number): number
	return (angle + math.pi) % (2 * math.pi) - math.pi
end

local function yawOf(direction: Vector3): number
	return math.atan2(-direction.X, -direction.Z)
end

-- A new body to frame (spawn or respawn). A lock held over a KO'd body pitches the view up toward
-- the killer; the respawned body starts behind its own facing instead of staring at the sky until
-- the mouse moves (F03; tools/test_camera_shake.luau).
local function followRoot(self: Fields, root: BasePart)
	self.FollowRoot = root
	self.TargetPitch, self.Pitch.Value, self.Pitch.Velocity = DEFAULT_PITCH, DEFAULT_PITCH, 0
	local facing = root.CFrame.LookVector
	local flat = Vector3.new(facing.X, 0, facing.Z)
	if flat.Magnitude &gt; 1e-3 then
		self.TargetYaw = yawOf(flat)
		self.Yaw.Value, self.Yaw.Velocity = self.TargetYaw, 0
	end
end

function Controller.new(state: WorldState): CameraController
	local camera = Workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local fields: Fields = {
		State = state,
		BossShotState = nil,
		Camera = camera,
		Yaw = spring(0),
		Pitch = spring(DEFAULT_PITCH),
		Distance = spring(BASE_OFFSET.Z),
		TargetYaw = 0,
		TargetPitch = DEFAULT_PITCH,
		Occluded = BASE_OFFSET.Z,
		Shoulder = 1,
		ShoulderSpring = spring(1),
		Locked = nil,
		FollowRoot = nil,
		LastSwitch = 0,
		SwitchAccumulator = 0,
		Fov = Config.Camera.FOV,
		MovementFov = spring(0), MovementDrop = spring(0), MovementTilt = spring(0),
		Gliding = false, Sliding = false, SlideTurn = 0,
		Sensitivity = 1,
		FovPunch = spring(0),
		FovClamp = 0,
		Shake = Vector3.zero,
		ShakeVelocity = Vector3.zero,
		Roll = 0,
		Sway = 0,
		HeadTier = "None",
		Clock = 0,
		Params = params,
		Enabled = true,
		OnLockChanged = nil,
	}
	local self = setmetatable(fields, Controller)
	camera.CameraType = Enum.CameraType.Scriptable
	return self
end

-------------------------------------------------------------------------------------------------
-- Lock-on
-------------------------------------------------------------------------------------------------

local function targetPoint(entity: Entity): Vector3?
	local root = entity.Root
	if not root then
		return nil
	end
	local height = if entity.Boss then 2.4 else 1.2
	return root.Position + Vector3.new(0, height, 0)
end

function Controller.Candidates(self: CameraController): { Entity }
	local own = self.State:Own()
	local origin = if own and own.Root then own.Root.Position else self.Camera.CFrame.Position
	local list: { Entity } = {}
	for _, entity in self.State.Entities do
		if self.State:IsHostile(entity) and self.State:IsAlive(entity) and entity.Root then
			local root = entity.Root :: BasePart
			if (root.Position - origin).Magnitude &lt;= LOCK_RANGE then
				local _, onScreen = self.Camera:WorldToViewportPoint(root.Position)
				if onScreen then
					table.insert(list, entity)
				end
			end
		end
	end
	return list
end

function Controller.SetLock(self: CameraController, id: number?)
	if self.Locked == id then
		return
	end
	self.Locked = id
	local callback = self.OnLockChanged
	if callback then
		callback(id)
	end
end

function Controller.ToggleLock(self: CameraController)
	if self.Locked then
		self:SetLock(nil)
		return
	end
	local viewport = self.Camera.ViewportSize
	local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
	local best: Entity? = nil
	local bestScore = math.huge
	for _, entity in self:Candidates() do
		local root = entity.Root :: BasePart
		local screen = self.Camera:WorldToViewportPoint(root.Position)
		local score = (Vector2.new(screen.X, screen.Y) - center).Magnitude + screen.Z * 4
		if score &lt; bestScore then
			best, bestScore = entity, score
		end
	end
	if best then
		self:SetLock(best.Id)
	end
end

-- Switch to the nearest candidate on the requested screen side (-1 left, +1 right).
function Controller.SwitchTarget(self: CameraController, side: number)
	local current = if self.Locked then self.State:Get(self.Locked) else nil
	if not current or not current.Root then
		return
	end
	local now = os.clock()
	if now - self.LastSwitch &lt; SWITCH_COOLDOWN then
		return
	end
	local origin = self.Camera:WorldToViewportPoint((current.Root :: BasePart).Position)
	local best: Entity? = nil
	local bestGap = math.huge
	for _, entity in self:Candidates() do
		if entity.Id ~= current.Id then
			local screen = self.Camera:WorldToViewportPoint((entity.Root :: BasePart).Position)
			local dx = screen.X - origin.X
			if dx * side &gt; 0 and math.abs(dx) &lt; bestGap then
				best, bestGap = entity, math.abs(dx)
			end
		end
	end
	if best then
		self.LastSwitch = now
		self:SetLock(best.Id)
	end
end

function Controller.LockedEntity(self: CameraController): Entity?
	local id = self.Locked
	if not id then
		return nil
	end
	return self.State:Get(id)
end

-------------------------------------------------------------------------------------------------
-- Input, feel and trauma hooks
-------------------------------------------------------------------------------------------------

-- Mouse/stick delta in pixels (or stick units scaled by the caller). While locked, horizontal
-- flicks switch targets instead of rotating.
function Controller.Look(self: CameraController, delta: Vector2, fromStick: boolean?)
	if self.Locked then
		if fromStick then
			if math.abs(delta.X) &gt;= SWITCH_STICK then
				self:SwitchTarget(if delta.X &gt; 0 then 1 else -1)
			end
			return
		end
		self.SwitchAccumulator = self.SwitchAccumulator * 0.85 + delta.X
		if math.abs(self.SwitchAccumulator) &gt;= SWITCH_MOUSE then
			self:SwitchTarget(if self.SwitchAccumulator &gt; 0 then 1 else -1)
			self.SwitchAccumulator = 0
		end
		return
	end
	local scale = Config.Camera.MouseSensitivity * self.Sensitivity
	self.TargetYaw -= delta.X * scale
	self.TargetPitch = math.clamp(self.TargetPitch - delta.Y * scale, PITCH_MIN, PITCH_MAX)
end

function Controller.ToggleShoulder(self: CameraController)
	self.Shoulder = -self.Shoulder
end

-- Directional shake and FOV punch. `direction` is world-space (the shake pushes along it).
-- Snaps the orbit behind a facing (portal arrival, batch 07) so the view matches the body.
function Controller.Face(self: CameraController, look: Vector3)
	if Vector3.new(look.X, 0, look.Z).Magnitude &lt; 1e-3 then return end
	self.TargetYaw = yawOf(look)
	self.Yaw.Value = self.TargetYaw
end

function Controller.Impulse(self: CameraController, direction: Vector3?, magnitude: number, fovPunch: number?)
	local push = if direction and direction.Magnitude &gt; 1e-3 then direction.Unit else Vector3.new(0, 1, 0)
	local localPush = self.Camera.CFrame:VectorToObjectSpace(push)
	magnitude = Effects.motion(magnitude) -- reduced motion keeps a quarter of the kick (batch 25)
	self.ShakeVelocity += Vector3.new(localPush.X, localPush.Y, 0) * magnitude * 6
	self.Roll += (math.random() - 0.5) * magnitude * 0.05
	if fovPunch then
		self.FovPunch.Velocity += Effects.motion(fovPunch) * 18
	end
end

function Controller.SetHeadTrauma(self: CameraController, tier: string)
	self.HeadTier = if TRAUMA_DRAG[tier] then tier else "None"
end

function Controller.SetSway(self: CameraController, amplitude: number)
	self.Sway = Effects.motion(amplitude)
end

function Controller.SetFovClamp(self: CameraController, degrees: number)
	self.FovClamp = math.max(degrees, 0)
end

-------------------------------------------------------------------------------------------------
-- Frame update
-------------------------------------------------------------------------------------------------

function Controller.SetMovement(self: CameraController, gliding: boolean, sliding: boolean, turn: number)
	self.Gliding, self.Sliding, self.SlideTurn = gliding, sliding, turn
end

function Controller.BossShot(self: CameraController, id: number, duration: number, finish: boolean?)
	BossCinematics.restore(self.BossShotState)
	self.BossShotState = BossCinematics.begin(self.Camera, self.State, id, duration, finish == true)
end

-- Ends any boss shot now (skip, reset, leaving, death) and restores slowed tracks.
function Controller.EndBossShot(self: CameraController)
	BossCinematics.restore(self.BossShotState)
	self.BossShotState = nil
end

function Controller.Update(self: CameraController, dt: number)
	local camera = Workspace.CurrentCamera
	self.Camera = camera
	camera.CameraType = Enum.CameraType.Scriptable
	self.Clock += dt
 if self.DialogueFrame then
  camera.CFrame=camera.CFrame:Lerp(self.DialogueFrame,math.min(1,dt*9));camera.FieldOfView=Portrait.Fov;return
 end
	if self.BossShotState then
		if BossCinematics.step(self.BossShotState, self.State, camera) then return end
		self.BossShotState = nil
	end
	local own = self.State:Own()
	local root = own and own.Root
	if not own or not root then
		return
	end
	if root ~= self.FollowRoot then
		followRoot(self, root)
	end

	local target = self:LockedEntity()
	if self.Locked and (not target or not self.State:IsAlive(target) or not target.Root
		or ((target.Root :: BasePart).Position - root.Position).Magnitude &gt; LOCK_BREAK_RANGE) then
		self:SetLock(nil)
		target = nil
	end

	stepSpring(self.MovementFov, if self.Gliding then 10 else 0, 10, dt)
	stepSpring(self.MovementDrop, if self.Sliding then -0.6 else 0, 14, dt)
	stepSpring(self.MovementTilt, if self.Sliding then -math.clamp(self.SlideTurn, -1, 1) * math.rad(4) else 0, 12, dt)
	local pivot = root.Position + Vector3.new(0, BASE_OFFSET.Y + self.MovementDrop.Value, 0)
	local omega = CORRECTION_SPEED
	local desiredDistance = BASE_OFFSET.Z
	local humanoid = own.Humanoid
	if target and target.Root then
		local point = targetPoint(target) :: Vector3
		local midpoint = pivot:Lerp(point, 0.5)
		local flat = Vector3.new(midpoint.X - pivot.X, 0, midpoint.Z - pivot.Z)
		if flat.Magnitude &gt; 0.1 then
			self.TargetYaw = yawOf(flat)
		end
		local separation = (point - pivot).Magnitude
		local elevation = point.Y - pivot.Y
		self.TargetPitch = math.clamp(math.atan2(elevation * 0.5, math.max(flat.Magnitude, 1)) - math.rad(10), PITCH_MIN, PITCH_MAX)
		desiredDistance = math.clamp(MIN_DISTANCE + separation * 0.28 + math.max(elevation, 0) * 0.6, MIN_DISTANCE, MAX_DISTANCE)
		omega = CORRECTION_SPEED * TRAUMA_DRAG[self.HeadTier]
		if humanoid then
			humanoid.AutoRotate = false
		end
		-- StrikeGeometry: face the target freely in neutral, at the shared rate while winding up or
		-- recovering, and not at all once a swing commits (the server sweeps the committed yaw).
		local snapshot = own.Snapshot
		local look = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
		local desired, current = Strike.yaw(look.X, look.Z), Strike.yaw(root.CFrame.LookVector.X, root.CFrame.LookVector.Z)
		if desired and current and flat.Magnitude &gt; 0.1 then
			local step = if snapshot then Strike.turnStep(snapshot.State, snapshot.StateElapsed, snapshot.StateDuration, dt) else math.huge
			local yaw = Strike.turn(current, desired, step)
			if yaw ~= current then
				root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
			end
		end
	elseif humanoid then
		-- Unlocked, walking turns the body only in neutral; a committed swing keeps its facing.
		local snapshot = own.Snapshot
		humanoid.AutoRotate = snapshot == nil or Strike.turnStep(snapshot.State, 0, 0, 1) == math.huge
	end

	self.Yaw.Value = self.TargetYaw + wrap(self.Yaw.Value - self.TargetYaw)
	stepSpring(self.Yaw, self.TargetYaw, omega, dt)
	stepSpring(self.Pitch, self.TargetPitch, omega, dt)
	stepSpring(self.Distance, desiredDistance, 8, dt)
	stepSpring(self.ShoulderSpring, self.Shoulder, 10, dt)
	stepSpring(self.FovPunch, 0, 14, dt)

	stepShake(self, dt)
	self.Roll *= math.exp(-dt * 8)

	local wobble = TRAUMA_WOBBLE[self.HeadTier]
	local swayRoll = self.Sway * math.sin(self.Clock * 0.6) + wobble * math.sin(self.Clock * 2.3)
	local swayPitch = self.Sway * 0.5 * math.sin(self.Clock * 0.45 + 1.3) + wobble * math.cos(self.Clock * 1.7)
	local rotation = CFrame.fromEulerAnglesYXZ(self.Pitch.Value + swayPitch, self.Yaw.Value, self.Roll + swayRoll + self.MovementTilt.Value)
	local shoulder = BASE_OFFSET.X * self.ShoulderSpring.Value
	local origin = pivot + rotation:VectorToWorldSpace(Vector3.new(shoulder * 0.35, 0, 0))
	local desired = pivot + rotation:VectorToWorldSpace(Vector3.new(shoulder, 0, self.Distance.Value))

	-- Occlusion: snap in immediately, ease back out. CameraProbe only collides with WorldGeometry;
	-- before the server registers the groups, fall back to excluding every fighter model.
	local params = self.Params
	if PhysicsService:IsCollisionGroupRegistered(PROBE_GROUP) then
		params.CollisionGroup = PROBE_GROUP
		params.FilterDescendantsInstances = {}
	else
		local ignore: { Instance } = {}
		for _, entity in self.State.Entities do
			table.insert(ignore, entity.Model)
		end
		params.FilterDescendantsInstances = ignore
	end
	local offset = desired - origin
	local length = offset.Magnitude
	local allowed = length
	if length &gt; 1e-3 then
		local hit = Workspace:Spherecast(origin, PROBE_RADIUS, offset, params)
		if hit then
			allowed = math.max(hit.Distance - 0.15, 0.5)
		end
	end
	if allowed &lt; self.Occluded then
		self.Occluded = allowed
	else
		self.Occluded = math.min(allowed, self.Occluded + (allowed - self.Occluded) * math.min(1, dt * OCCLUSION_RECOVER) + dt)
	end
	local position = if length &gt; 1e-3 then origin + offset.Unit * math.min(self.Occluded, length) else desired

	local shake = rotation:VectorToWorldSpace(Vector3.new(self.Shake.X, self.Shake.Y, 0))
	camera.CFrame = CFrame.new(position + shake) * rotation
	camera.Focus = CFrame.new(pivot)
	local fov = math.clamp(self.Fov + self.MovementFov.Value + self.FovPunch.Value - self.FovClamp, Config.Camera.MinFOV - 20, Config.Camera.MaxFOV + 10)
	camera.FieldOfView = fov
end

function Controller.Destroy(self: CameraController)
	BossCinematics.restore(self.BossShotState)
	self.Enabled = false
	self:SetLock(nil)
	local own = self.State:Own()
	if own and own.Humanoid then
		own.Humanoid.AutoRotate = true
	end
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local player = Players.LocalPlayer
	if player.Character then
		camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
	end
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="652">
            <Properties>
              <string name="Name">CelestialForms</string>
              <string name="Source">--!strict
-- Procedural geometry for Celestial Supernova: planetary orb, dual counter-rotating orbital rings,
-- reverse-gravity voxels and the sky-piercing light column. Pure Luau, no meshes or Blender.
local Workspace = game:GetService("Workspace")
local Kit = require(script.Parent.SkillKit)
local Forms = {}

Forms.Teal = Color3.fromRGB(0, 255, 255)
Forms.Deep = Color3.fromRGB(36, 177, 174)
Forms.Gold = Color3.fromRGB(255, 170, 0)
Forms.Cyan = Color3.fromRGB(0, 230, 230)
local WHITE = Color3.new(1, 1, 1)

export type Ring = { Parts: { BasePart }, Radius: number, Angle: number, Spin: number, Tilt: CFrame, Moon: BasePart? }
export type Voxel = { Part: BasePart, Base: Vector3, Lift: number, Phase: number, Spin: Vector3 }

function Forms.orb(trove: Kit.Trove, folder: Instance, center: Vector3): (BasePart, BasePart)
	-- ForceField shell: a shimmering energy surface the caster shows through, not a solid plastic ball.
	local shell = Kit.part(folder, "PlanetOrb", Forms.Teal, Vector3.one * 0.2, CFrame.new(center), Enum.PartType.Ball)
	shell.Material, shell.Transparency = Enum.Material.ForceField, 0
	local core = Kit.part(folder, "PlanetCore", WHITE, Vector3.one * 0.1, CFrame.new(center), Enum.PartType.Ball)
	Kit.light(shell, Forms.Teal, 22, 3)
	Kit.tween(trove, shell, 0.55, { Size = Vector3.one * 6 }, Enum.EasingStyle.Back)
	Kit.tween(trove, core, 0.55, { Size = Vector3.one * 2.6 }, Enum.EasingStyle.Back)
	return shell, core
end

local function ring(folder: Instance, radius: number, color: Color3, tilt: CFrame, spin: number): Ring
	local parts: { BasePart } = {}
	for _ = 1, 28 do
		table.insert(parts, Kit.part(folder, "OrbitSegment", color, Vector3.new(1, 0.3, 0.3), CFrame.identity))
	end
	return { Parts = parts, Radius = radius, Angle = 0, Spin = spin, Tilt = tilt }
end

-- Gold and teal rings on crossed tilts spinning in opposite directions, a fine white equator ring,
-- and a small moon riding each of the two main rings.
function Forms.rings(folder: Instance): { Ring }
	local list = {
		ring(folder, 6.5, Forms.Gold, CFrame.Angles(math.rad(28), 0, math.rad(8)), 1),
		ring(folder, 7.6, Forms.Cyan, CFrame.Angles(math.rad(-22), 0, math.rad(-34)), -1),
		ring(folder, 9.4, WHITE, CFrame.Angles(math.rad(4), 0, math.rad(12)), 0.45),
	}
	for n = 1, 2 do
		local moon = list[n].Parts[1]
		moon.Shape, moon.Size, moon.Color = Enum.PartType.Ball, Vector3.one * 1.1, if n == 1 then Forms.Gold else WHITE
		list[n].Moon = moon
		Kit.light(moon, moon.Color, 10, 2)
	end
	for _, p in list[3].Parts do p.Size = Vector3.new(1, 0.12, 0.12); p.Transparency = 0.3 end
	return list
end

-- Places every segment around `center` this frame; speed is radians per second.
function Forms.spin(rings: { Ring }, center: Vector3, speed: number, dt: number)
	local parts: { BasePart } = {}
	local frames: { CFrame } = {}
	for _, r in rings do
		r.Angle += r.Spin * speed * dt
		local count = #r.Parts
		local chord = math.max(0.15, 2 * r.Radius * math.sin(math.pi / count) * 1.1)
		for n, p in r.Parts do
			local yaw = r.Angle + (n / count) * math.pi * 2
			table.insert(parts, p)
			table.insert(frames, CFrame.new(center) * r.Tilt * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -r.Radius))
			if p ~= r.Moon and math.abs(p.Size.X - chord) &gt; 0.05 then p.Size = Vector3.new(chord, p.Size.Y, p.Size.Z) end
		end
	end
	Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

function Forms.voxels(folder: Instance, ground: Vector3, count: number): { Voxel }
	local list: { Voxel } = {}
	for n = 1, count do
		local angle = (n / count) * math.pi * 2 + math.random() * 0.4
		local distance = 4 + math.random() * 7 -- inside the orbit camera's 13-17 stud radius
		local base = ground + Vector3.new(math.cos(angle) * distance, -2.4, math.sin(angle) * distance)
		local size = 0.5 + math.random()
		local glow = n % 4 == 0
		local p = Kit.part(folder, "VoidVoxel", if glow then Forms.Teal else Color3.fromRGB(46, 52, 60), Vector3.one * size, CFrame.new(base))
		p.Material = if glow then Enum.Material.Neon else Enum.Material.Slate
		table.insert(list, { Part = p, Base = base, Lift = 2 + math.random() * 7, Phase = math.random() * 6,
			Spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3 })
	end
	return list
end

-- hover (0) bobs the voxels up from the floor; spiral (&gt;0, seconds since release) draws them up the beam.
function Forms.drift(voxels: { Voxel }, axis: Vector3, clock: number, spiral: number)
	local parts: { BasePart } = {}
	local frames: { CFrame } = {}
	for _, v in voxels do
		local spin = CFrame.Angles(v.Spin.X * clock, v.Spin.Y * clock, v.Spin.Z * clock)
		local at: Vector3
		if spiral &lt;= 0 then
			at = v.Base + Vector3.new(0, math.min(v.Lift, clock * 3.5) + math.sin(clock * 1.7 + v.Phase) * 0.35 + 2.4, 0)
		else
			local offset = v.Base - axis
			local angle = math.atan2(offset.Z, offset.X) + spiral * 2.2
			local r = math.max(2, Vector3.new(offset.X, 0, offset.Z).Magnitude * (1 - math.min(0.7, spiral * 0.4)))
			at = Vector3.new(axis.X + math.cos(angle) * r, v.Base.Y + v.Lift + 2.4 + spiral * spiral * 9, axis.Z + math.sin(angle) * r)
		end
		table.insert(parts, v.Part)
		table.insert(frames, CFrame.new(at) * spin)
	end
	Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Caster-only lift on an AlignPosition: rises to `rise` studs above where the cast began.
function Forms.levitate(cast: any, rise: number, seconds: number)
	local root = cast.Entity.Root
	if not cast.Own or not root then return end
	local align = cast.Bag.Align
	if not align then
		local anchor = Kit.attach(cast.Trove, root, Vector3.zero, "SupernovaLift")
		align = Kit.add(cast.Trove, Instance.new("AlignPosition"))
		align.Mode, align.Attachment0 = Enum.PositionAlignmentMode.OneAttachment, anchor
		align.MaxForce, align.MaxVelocity, align.Responsiveness = 1e6, 40, 25
		align.Position, align.Parent = root.Position, root
		cast.Bag.Align, cast.Bag.Floor = align, root.Position
	end
	Kit.tween(cast.Trove, align, seconds, { Position = cast.Bag.Floor + Vector3.new(0, rise, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

return table.freeze(Forms)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="653">
            <Properties>
              <string name="Name">CelestialPillar</string>
              <string name="Source">--!strict
-- The Supernova column as the reference shows it: a translucent cyan cylinder with a pale glowing
-- heart, thin bright edge lines running its full height, dark jagged ink slivers streaming up
-- through it, and a flat translucent disc band circling it at the caster's height.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Kit = require(script.Parent.SkillKit)
local Pillar = {}

local rgb = Color3.fromRGB
local HEIGHT = 160
local UP = CFrame.Angles(0, 0, math.pi / 2)
local SHELL, HEART, EDGE, INK = rgb(70, 225, 235), rgb(200, 255, 255), rgb(225, 255, 255), rgb(2, 10, 14)

export type Column = { Parts: { BasePart }, Shards: { BasePart }, Band: { BasePart }, Ground: Vector3, Width: number, Fading: boolean? }

local function cylinder(folder: Instance, name: string, color: Color3, width: number, transparency: number, top: Vector3): BasePart
	local p = Kit.part(folder, name, color, Vector3.new(1, width, width), CFrame.new(top) * UP, Enum.PartType.Cylinder)
	p.Transparency = transparency
	return p
end

-- Drives the column down onto `ground` in 0.2 s; `band` is the disc's height above the ground.
function Pillar.erupt(trove: Kit.Trove, folder: Instance, ground: Vector3, width: number, band: number): Column
	local top = ground + Vector3.new(0, HEIGHT, 0)
	local shell = cylinder(folder, "SupernovaPillar", SHELL, width, 0.62, top)
	local heart = cylinder(folder, "SupernovaHeart", HEART, width * 0.55, 0.62, top)
	local sheath = cylinder(folder, "SupernovaSheath", SHELL, width * 1.04, 0, top)
	sheath.Material = Enum.Material.ForceField
	local parts = { shell, heart, sheath }
	for n = 1, 8 do -- edge lines on the silhouette of the beam
		local yaw = n / 8 * math.pi * 2
		local line = Kit.part(folder, "PillarEdge", EDGE, Vector3.new(1, 0.22, 0.22), CFrame.new(top + Vector3.new(math.cos(yaw), 0, math.sin(yaw)) * width * 0.5) * UP)
		line.Transparency = 0.15
		table.insert(parts, line)
	end
	for _, p in parts do
		local at = Vector3.new(p.Position.X, ground.Y + HEIGHT / 2 - 2.6, p.Position.Z)
		Kit.tween(trove, p, 0.2, { Size = Vector3.new(HEIGHT, p.Size.Y, p.Size.Z), CFrame = CFrame.new(at) * UP }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	Kit.light(heart, SHELL, 60, 6)
	-- Ink slivers: thin jagged dark wedges at varied radii, leaning a little, racing up and wrapping round.
	local shards: { BasePart } = {}
	local spec = {}
	for n = 1, 46 do
		local p = Kit.part(folder, "InkShard", INK, Vector3.new(0.15 + math.random() * 0.35, 5 + math.random() * 18, 0.6 + math.random() * 1.8), CFrame.new(ground),
			if n % 2 == 0 then Enum.PartType.Wedge else Enum.PartType.Block)
		p.Material, p.Transparency = Enum.Material.SmoothPlastic, 1
		shards[n] = p
		-- Mostly between the white heart and the outer shell, where only one translucent layer covers them.
		spec[n] = { Yaw = math.random() * math.pi * 2, R = width * (0.3 + math.random() * 0.19), H = math.random() * HEIGHT, Speed = 30 + math.random() * 40, Lean = (math.random() - 0.5) * 0.4 }
	end
	-- Disc band: a wide translucent ring and a bright rim at the caster's height.
	local ring: { BasePart } = {}
	for n = 1, 64 do
		local rim = n &gt; 32
		local p = Kit.part(folder, "PillarBand", if rim then EDGE else SHELL, Vector3.new(1, if rim then 0.15 else 0.1, if rim then 0.2 else width * 0.25), CFrame.new(ground))
		p.Transparency = if rim then 0.35 else 0.82
		ring[n] = p
	end
	local column: Column = { Parts = parts, Shards = shards, Band = ring, Ground = ground, Width = width }
	local clock = 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		local frames: { CFrame } = {}
		for n, p in shards do
			local s = spec[n]
			s.H = (s.H + s.Speed * dt) % HEIGHT
			local yaw = s.Yaw + clock * 0.6
			frames[n] = CFrame.new(ground + Vector3.new(math.cos(yaw) * s.R, s.H - 2.6, math.sin(yaw) * s.R)) * CFrame.Angles(0, -yaw, s.Lean)
			if not column.Fading then p.Transparency = math.clamp(1 - clock * 4, 0.05, 1) end
		end
		local wobble = math.sin(clock * 1.3) * 0.06
		for n, p in ring do
			local rim = n &gt; 32
			local s = if rim then n - 32 else n
			local rr = width * (if rim then 1.12 else 0.92)
			local yaw = s / 32 * math.pi * 2 + clock * 0.4
			table.insert(frames, CFrame.new(ground + Vector3.new(0, band, 0)) * CFrame.Angles(wobble, 0, wobble * 0.6) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -rr))
			if math.abs(p.Size.X - 2 * rr * math.sin(math.pi / 32) * 1.12) &gt; 0.05 then p.Size = Vector3.new(2 * rr * math.sin(math.pi / 32) * 1.12, p.Size.Y, p.Size.Z) end
		end
		local all = table.move(ring, 1, #ring, #shards + 1, table.clone(shards))
		Workspace:BulkMoveTo(all, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end))
	return column
end

-- A pulse: the beam swells and brightens for a beat, then settles.
function Pillar.flare(trove: Kit.Trove, column: Column, strength: number)
	for _, p in column.Parts do
		local base = p.Size
		Kit.tween(trove, p, 0.08, { Size = Vector3.new(base.X, base.Y * (1 + 0.25 * strength), base.Z * (1 + 0.25 * strength)) }, Enum.EasingStyle.Quad)
		Kit.after(trove, 0.1, function() Kit.tween(trove, p, 0.5, { Size = base }, Enum.EasingStyle.Sine) end)
	end
end

-- Final beat: the column blasts wide and dissolves.
function Pillar.dissolve(trove: Kit.Trove, column: Column, seconds: number)
	column.Fading = true
	for _, p in column.Parts do
		Kit.tween(trove, p, seconds, { Transparency = 1, Size = Vector3.new(p.Size.X * 1.2, p.Size.Y * 2, p.Size.Z * 2) }, Enum.EasingStyle.Quart)
	end
	for _, p in column.Shards do Kit.tween(trove, p, seconds * 0.6, { Transparency = 1 }) end
	for _, p in column.Band do Kit.tween(trove, p, seconds * 0.6, { Transparency = 1 }) end
end

return table.freeze(Pillar)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="654">
            <Properties>
              <string name="Name">CodexView</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/CodexView
-- The Codex inside the conversation panel: discovered/total counts for inscriptions and
-- sovereigns, a discovery instruction, and two sections. Entries come only from the server's
-- discovery flags (LoreEntries, defeated bosses). An undiscovered inscription shows only where to
-- look (its region), never its title or text; an unbound sovereign shows only its region.
local Shared = game:GetService("ReplicatedStorage").AsurasPath.Shared
local Catalog = require(Shared.NarrativeCatalog) :: any
local World = require(Shared.WorldDefinitions) :: any
local InputMap = require(Shared.InputMap) :: any
local Ending = require(Shared.EndingRules) :: any

local Codex = {}
Codex.Title = "MEMORIES OF THE JADE CATACLYSM"
Codex.Tagline = "Eight inscriptions. Six souls. One path beyond death." -- the existing narrative line
Codex.Instruction = "Read the jade memorial stones along the path (look for the glowing green script) to recover an inscription; "
	.. "each first reading also grants Essence. Lay the six sovereigns to rest to fill the second ledger."

export type Entry = { Id: string, Title: string, Hint: string, Known: boolean }
export type Summary = { Found: number, Total: number, Rested: number, Sovereigns: number, Inscriptions: { Entry }, Souls: { Entry }, Crossing: string }
export type Ui = { button: (v: any, label: string, run: () -&gt; (), variant: string?, enabled: boolean?, height: number?) -&gt; (),
	note: (v: any, text: string, color: Color3) -&gt; (), reopen: (id: string) -&gt; (), Gold: Color3, Muted: Color3, Ivory: Color3 }

local function regionName(id: string?): string
	local region = if id then World.Regions[id] else nil
	return if region then region.Name else "an unexplored region"
end

local function bossName(id: string): string
	local boss = World.Bosses[id]
	if not boss then return id end
	return if id == "TwinSentinels" then (string.match(boss.Title or "", "^([^:]+)") or "The Twin Sentinels") else boss.Name
end

-- The ending ledger line (batch 22): the same server flags as Lin and the objective tracker.
Codex.Crossing = table.freeze({
	Bound = "◇  The crossing · the ferryman waits for six silent chains",
	Release = "◆  The crossing · Lady Lin waits beside the Primal Bonfire",
	Remained = "◆  You chose to remain · Lady Lin keeps the crossing open",
	Crossed = "◆  The crossing is made · the Asura's Path is walked",
})

-- Pure: what the Codex may show for this discovery state.
function Codex.summary(data: any): Summary
	local lore = (data.inventory and data.inventory.LoreEntries) or {}
	local bosses = data.bosses or {}
	local result: Summary = { Found = 0, Total = #Catalog.LoreOrder, Rested = 0, Sovereigns = #Catalog.Sovereigns, Inscriptions = {}, Souls = {},
		Crossing = Codex.Crossing[Ending.stage(bosses, data.story)] }
	for _, id in Catalog.LoreOrder do
		local l = Catalog.Lore[id]
		local known = lore[id] == true
		if known then result.Found += 1 end
		table.insert(result.Inscriptions, { Id = id, Title = if known then l.Title else "Undiscovered inscription", Hint = regionName(l.Region), Known = known })
	end
	for _, id in Catalog.Sovereigns do
		local known = bosses[id] == true
		if known then result.Rested += 1 end
		local boss = World.Bosses[id]
		table.insert(result.Souls, { Id = id, Title = if known then bossName(id) else "Unbound sovereign", Hint = if known then "at rest" else regionName(boss and boss.Region), Known = known })
	end
	return result
end

function Codex.status(sum: Summary): string
	return string.format("%d / %d Inscriptions  ·  %d / %d Sovereigns at rest", sum.Found, sum.Total, sum.Rested, sum.Sovereigns)
end

-- Body text: a discovered entry's own words, or the tagline plus what to do next.
function Codex.body(sum: Summary, selected: string?): string
	for _, entry in sum.Inscriptions do
		if entry.Id == selected and entry.Known then
			-- The first reading teaches where it went (batch 10, #44).
			if sum.Found == 1 then
				local key = InputMap.get("Codex")
				return Catalog.Lore[selected].Text .. string.format("\n\nFirst inscription recorded in your Codex; each one also grants Essence. Reopen it any time with [%s].", if key then key.Key else "J")
			end
			return Catalog.Lore[selected].Text
		end
	end
	if sum.Found == sum.Total then return Codex.Tagline .. "\nEvery inscription is recovered. Choose one below to read it again." end
	if sum.Found == 0 then return Codex.Tagline .. "\n" .. Codex.Instruction end
	return Codex.Tagline .. string.format("\n%d inscriptions remain. ", sum.Total - sum.Found) .. Codex.Instruction
end

function Codex.render(v: any, data: any, selected: string?, ui: Ui)
	local sum = Codex.summary(data)
	v.Title.Text, v.Status.Text, v.Subtitle.Text = Codex.Title, Codex.status(sum), Codex.body(sum, selected)
	ui.note(v, string.format("INSCRIPTIONS  ·  %d / %d", sum.Found, sum.Total), ui.Gold)
	for _, entry in sum.Inscriptions do
		if entry.Known then
			local id = entry.Id
			ui.button(v, entry.Title .. "  ·  " .. entry.Hint, function() ui.reopen(id) end, if id == selected then "Primary" else "Secondary")
		else
			ui.button(v, "◇  " .. entry.Title .. "  ·  " .. entry.Hint, function() end, "Ghost", false)
		end
	end
	ui.note(v, string.format("SOVEREIGNS AT REST  ·  %d / %d", sum.Rested, sum.Sovereigns), ui.Gold)
	for _, entry in sum.Souls do
		ui.note(v, (if entry.Known then "◆  " else "◇  ") .. entry.Title .. "  ·  " .. entry.Hint, if entry.Known then ui.Ivory else ui.Muted)
	end
	ui.note(v, sum.Crossing, if sum.Rested == sum.Sovereigns then ui.Gold else ui.Muted)
end

return table.freeze(Codex)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="655">
            <Properties>
              <string name="Name">ColosseumController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ColosseumController
-- Colosseum matchmaking surface: the threshold panel (ranked queue, casual spar roster), incoming
-- challenge prompts, the duel countdown/clock and spectator notices. All authority stays on the
-- server; this controller only renders ColosseumIntent payloads and sends bounded requests.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local InputController = require(script.Parent:WaitForChild("InputController") :: ModuleScript)
local InterfaceController = require(script.Parent:WaitForChild("InterfaceController") :: ModuleScript)

type WorldState = WorldState.WorldState
type Cue = WorldState.Cue
type InputController = InputController.InputController
type Interface = InterfaceController.Interface

local Controller = {}
Controller.__index = Controller

local INK = Color3.fromRGB(14, 10, 9)
local IVORY = Color3.fromRGB(236, 226, 206)
local MUTED = Color3.fromRGB(150, 140, 126)
local EMBER = Color3.fromRGB(232, 132, 52)
local BLOOD = Color3.fromRGB(176, 22, 24)
local JADE = Color3.fromRGB(86, 168, 92)
local BORDER = Color3.fromRGB(120, 40, 32)

local TITLE_FONT = Enum.Font.Antique
local BODY_FONT = Enum.Font.Garamond
local NUMBER_FONT = Enum.Font.GothamMedium

local SPECTATOR_RADIUS = 110
local MAX_ROSTER = 24

local REASONS: { [string]: string } = {
	StepOnThreshold = "Stand upon the ember threshold.",
	AlreadyQueued = "You already await a ranked rival.",
	HighLatency = "Your connection is too slow for ranked duels.",
	RecoveryPending = "A previous duel is still being settled. Try again shortly.",
	AlreadyAssigned = "You have already been matched.",
	ProfileBusy = "Your record is busy. Try again.",
	RankedClosed = "The ranked league has not opened yet.",
	ColosseumClosed = "The Colosseum is closing.",
	InDuel = "Already in a duel.",
	Fallen = "Rise before you duel.",
	InBossFight = "The fog binds you to a fight.",
	EnemiesNearby = "Enemies still hunt you.",
	Unavailable = "Unavailable right now.",
	TargetInDuel = "They are already dueling.",
	TargetFallen = "They have fallen.",
	TargetInBossFight = "They are bound in a boss fight.",
	TargetEnemiesNearby = "They are being hunted.",
	TargetUnavailable = "They are unavailable.",
	TargetColosseumClosed = "The Colosseum is closing.",
	ChallengeExpired = "The challenge has lapsed.",
	ChallengeDeclined = "Your challenge was declined.",
	RingsOccupied = "Every ring is occupied. Try again soon.",
	RingOccupied = "The ring is occupied.",
	StartRefused = "The duel could not begin.",
	JournalUnavailable = "The ranked ledger is unavailable. Try again.",
	AlreadyChallenged = "They have already challenged you.",
	InvalidTarget = "Choose another opponent.",
}

local STATUS_TEXT: { [string]: string } = {
	Ready = "Ready",
	InDuel = "Dueling",
	Fallen = "Fallen",
	InBossFight = "In a boss fight",
	EnemiesNearby = "Hunted",
	Unavailable = "Away",
	ColosseumClosed = "Away",
}

type Row = { Frame: Frame, Name: TextLabel, Detail: TextLabel, Button: TextButton, Id: number }

type Fields = {
	State: WorldState,
	Input: InputController,
	Interface: Interface,
	Remote: RemoteEvent,
	Player: Player,
	Gui: ScreenGui,
	Panel: Frame,
	PanelTitle: TextLabel,
	PanelGlyph: TextLabel,
	PanelStatus: TextLabel,
	RankedButton: TextButton,
	RankedDetail: TextLabel,
	Roster: ScrollingFrame,
	RosterEmpty: TextLabel,
	Rows: { Row },
	Prompt: Frame,
	PromptText: TextLabel,
	PromptTimer: TextLabel,
	MatchFrame: Frame,
	MatchNames: TextLabel,
	MatchClock: TextLabel,
	MatchMode: TextLabel,
	Countdown: TextLabel,
	PanelOpen: boolean,
	MenuHeld: boolean,
	RankedOpen: boolean,
	Queued: boolean,
	QueuedAt: number,
	ChallengeId: string?,
	ChallengeExpires: number,
	MatchId: string?,
	MatchStarts: number,
	MatchEnds: number,
	LastCount: number,
	Connections: { RBXScriptConnection },
	Disconnects: { () -&gt; () },
}

export type ColosseumController = typeof(setmetatable({} :: Fields, Controller))

-------------------------------------------------------------------------------------------------
-- Instance helpers
-------------------------------------------------------------------------------------------------

local function make&lt;T&gt;(className: string, parent: Instance?, properties: { [string]: any }): T
	local instance = Instance.new(className :: any)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance :: any
end

local function label(parent: Instance, text: string, size: number, font: Enum.Font, color: Color3, properties: { [string]: any }?): TextLabel
	local result = make("TextLabel", parent, {
		Text = text,
		TextSize = size,
		Font = font,
		TextColor3 = color,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = INK,
		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextLabel
	if properties then
		for key, value in properties do
			(result :: any)[key] = value
		end
	end
	return result
end

local function decorate(frame: GuiObject, radius: number, thickness: number)
	make("UICorner", frame, { CornerRadius = UDim.new(0, radius) })
	make("UIStroke", frame, { Color = BORDER, Thickness = thickness, Transparency = 0.1 })
end

local function button(parent: Instance, text: string, size: UDim2, callback: () -&gt; ()): TextButton
	local result = make("TextButton", parent, {
		Text = text,
		Font = BODY_FONT,
		TextSize = 20,
		TextColor3 = IVORY,
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.2,
		AutoButtonColor = true,
		Size = size,
		BorderSizePixel = 0,
		Selectable = true,
	}) :: TextButton
	decorate(result, 4, 1)
	result.Activated:Connect(callback)
	return result
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function clockText(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

-------------------------------------------------------------------------------------------------
-- Construction
-------------------------------------------------------------------------------------------------

function Controller.new(state: WorldState, input: InputController, ui: Interface, net: Instance): ColosseumController
	local player = Players.LocalPlayer
	local remote = net:WaitForChild("ColosseumIntent") :: RemoteEvent
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "AsuraColosseum",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 11,
	}) :: ScreenGui

	-- Threshold panel
	local panel = make("Frame", gui, {
		Name = "ColosseumPanel",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -60, 0.5, 0),
		Size = UDim2.fromOffset(400, 500),
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.12,
		Visible = false,
	}) :: Frame
	decorate(panel, 6, 2)
	make("UIPadding", panel, {
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
		PaddingTop = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 14),
	})
	local panelTitle = label(panel, "Colosseum", 26, TITLE_FONT, IVORY, {
		Size = UDim2.new(1, -40, 0, 32),
		TextWrapped = true,
		TextScaled = true,
	})
	local panelGlyph = label(panel, "", 30, TITLE_FONT, EMBER, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(36, 32),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local panelStatus = label(panel, "", 16, BODY_FONT, MUTED, {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 20),
	})
	label(panel, "Ranked Normalized", 20, TITLE_FONT, EMBER, {
		Position = UDim2.fromOffset(0, 66),
		Size = UDim2.new(1, 0, 0, 24),
	})
	local rankedDetail = label(panel, "", 15, BODY_FONT, MUTED, {
		Position = UDim2.fromOffset(0, 90),
		Size = UDim2.new(1, 0, 0, 34),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local rankedButton: TextButton = nil :: any -- built below once `self` exists

	label(panel, "Open Arena", 20, TITLE_FONT, EMBER, {
		Position = UDim2.fromOffset(0, 184),
		Size = UDim2.new(1, 0, 0, 24),
	})
	local roster = make("ScrollingFrame", panel, {
		Name = "Roster",
		Position = UDim2.fromOffset(0, 212),
		Size = UDim2.new(1, 0, 1, -270),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = BORDER,
	}) :: ScrollingFrame
	make("UIListLayout", roster, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	local rosterEmpty = label(roster, "No other warriors walk these lands.", 16, BODY_FONT, MUTED, {
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 0,
	})

	-- Incoming challenge prompt
	local prompt = make("Frame", gui, {
		Name = "ChallengePrompt",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(460, 132),
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.1,
		Visible = false,
	}) :: Frame
	decorate(prompt, 6, 2)
	make("UIPadding", prompt, {
		PaddingLeft = UDim.new(0, 16),
		PaddingRight = UDim.new(0, 16),
		PaddingTop = UDim.new(0, 12),
	})
	local promptText = label(prompt, "", 20, BODY_FONT, IVORY, {
		Size = UDim2.new(1, -60, 0, 52),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local promptTimer = label(prompt, "", 22, NUMBER_FONT, EMBER, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(56, 28),
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	-- Duel clock
	local matchFrame = make("Frame", gui, {
		Name = "DuelClock",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 24),
		Size = UDim2.fromOffset(520, 76),
		BackgroundTransparency = 1,
		Visible = false,
	}) :: Frame
	local matchMode = label(matchFrame, "", 16, TITLE_FONT, EMBER, {
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local matchNames = label(matchFrame, "", 22, TITLE_FONT, IVORY, {
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local matchClock = label(matchFrame, "", 26, NUMBER_FONT, IVORY, {
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local countdown = label(gui, "", 120, TITLE_FONT, IVORY, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(600, 140),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		TextTransparency = 1,
	})

	local fields: Fields = {
		State = state,
		Input = input,
		Interface = ui,
		Remote = remote,
		Player = player,
		Gui = gui,
		Panel = panel,
		PanelTitle = panelTitle,
		PanelGlyph = panelGlyph,
		PanelStatus = panelStatus,
		RankedButton = rankedButton,
		RankedDetail = rankedDetail,
		Roster = roster,
		RosterEmpty = rosterEmpty,
		Rows = {},
		Prompt = prompt,
		PromptText = promptText,
		PromptTimer = promptTimer,
		MatchFrame = matchFrame,
		MatchNames = matchNames,
		MatchClock = matchClock,
		MatchMode = matchMode,
		Countdown = countdown,
		PanelOpen = false,
		MenuHeld = false,
		RankedOpen = false,
		Queued = false,
		QueuedAt = 0,
		ChallengeId = nil,
		ChallengeExpires = 0,
		MatchId = nil,
		MatchStarts = 0,
		MatchEnds = 0,
		LastCount = -1,
		Connections = {},
		Disconnects = {},
	}
	local self = setmetatable(fields, Controller)

	self.RankedButton = button(panel, "Enter the Ranked Queue", UDim2.new(1, 0, 0, 42), function()
		if not self.RankedOpen then
			self.Interface:ShowToast(REASONS.RankedClosed)
			return
		end
		self:Send({ action = if self.Queued then "Dequeue" else "Enqueue" })
	end)
	self.RankedButton.Position = UDim2.fromOffset(0, 130)
	button(panel, "Step Away", UDim2.new(1, 0, 0, 40), function()
		self:Send({ action = "Dismiss" })
		self:ClosePanel()
	end).Position = UDim2.new(0, 0, 1, -44)

	local accept = button(prompt, "Accept", UDim2.new(0.5, -6, 0, 40), function()
		self:Respond(true)
	end)
	accept.Position = UDim2.fromOffset(0, 70)
	accept.TextColor3 = JADE
	local decline = button(prompt, "Decline", UDim2.new(0.5, -6, 0, 40), function()
		self:Respond(false)
	end)
	decline.Position = UDim2.new(0.5, 6, 0, 70)

	table.insert(self.Connections, remote.OnClientEvent:Connect(function(payload: any)
		if type(payload) == "table" and type(payload.action) == "string" then
			self:Receive(payload)
		end
	end))
	table.insert(self.Disconnects, state:OnCue(function(cue: Cue)
		self:OnCue(cue)
	end))
	return self
end

-------------------------------------------------------------------------------------------------
-- Requests
-------------------------------------------------------------------------------------------------

function Controller.Send(self: ColosseumController, payload: { [string]: any })
	self.Remote:FireServer(payload)
end

function Controller.Respond(self: ColosseumController, accept: boolean)
	local id = self.ChallengeId
	if id then
		self:Send({ action = "Respond", challenge = id, accept = accept })
	end
	self.ChallengeId = nil
	self.Prompt.Visible = false
	self:HoldMenu(self.PanelOpen)
end

function Controller.Toast(self: ColosseumController, reason: any)
	local text = if type(reason) == "string" then REASONS[reason] or reason else nil
	if text then
		self.Interface:ShowToast(text)
	end
end

-------------------------------------------------------------------------------------------------
-- Panel
-------------------------------------------------------------------------------------------------

function Controller.HoldMenu(self: ColosseumController, held: boolean)
	if self.MenuHeld ~= held then
		self.MenuHeld = held
		self.Input:SetMenu(held, "Colosseum")
	end
end

function Controller.OpenPanel(self: ColosseumController)
	if self.MatchId then
		return
	end
	self.PanelOpen = true
	self.Panel.Visible = true
	self:HoldMenu(true)
end

function Controller.ClosePanel(self: ColosseumController)
	self.PanelOpen = false
	self.Panel.Visible = false
	self:HoldMenu(self.Prompt.Visible)
end

function Controller.RefreshRanked(self: ColosseumController)
	local rankedButton = self.RankedButton
	if not self.RankedOpen then
		rankedButton.Text = "Ranked League Sealed"
		rankedButton.TextColor3 = MUTED
	elseif self.Queued then
		rankedButton.Text = "Leave the Queue  ·  " .. clockText(os.clock() - self.QueuedAt)
		rankedButton.TextColor3 = EMBER
	else
		rankedButton.Text = "Enter the Ranked Queue"
		rankedButton.TextColor3 = IVORY
	end
end

function Controller.Populate(self: ColosseumController, payload: any)
	self.PanelTitle.Text = tostring(payload.name or "Colosseum")
	self.PanelGlyph.Text = tostring(payload.glyph or "")
	self.RankedOpen = payload.rankedOpen == true
	local queued = payload.queued == true
	if queued and not self.Queued then
		self.QueuedAt = os.clock()
	end
	self.Queued = queued
	local ping = tonumber(payload.ping) or 0
	local limit = tonumber(payload.pingLimit) or 0
	local elo = tonumber(payload.elo)
	self.PanelStatus.Text = string.format(
		"%sLatency %d ms%s",
		if elo then string.format("%s · %d  ·  ", tostring(payload.rank or "Unranked"),elo) else "",
		ping,
		if payload.occupied == true then "  ·  Ring in use" else ""
	)
	self.PanelStatus.TextColor3 = if limit &gt; 0 and ping &gt; limit then BLOOD else MUTED
	self.RankedDetail.Text = string.format(
		"Equal attributes, +0 steel and no infusions · Soul Level %d. Latency under %d ms.",
		tonumber(payload.level) or 1,
		limit
	)
	self:RefreshRanked()

	local players = if type(payload.players) == "table" then payload.players else {}
	local count = math.min(#players, MAX_ROSTER)
	self.RosterEmpty.Visible = count == 0
	for index = 1, count do
		local entry = players[index]
		local row = self.Rows[index]
		if not row then
			local frame = make("Frame", self.Roster, {
				Size = UDim2.new(1, -8, 0, 44),
				BackgroundColor3 = INK,
				BackgroundTransparency = 0.4,
				LayoutOrder = index,
			}) :: Frame
			make("UICorner", frame, { CornerRadius = UDim.new(0, 4) })
			local nameLabel = label(frame, "", 18, BODY_FONT, IVORY, {
				Position = UDim2.fromOffset(10, 2),
				Size = UDim2.new(1, -120, 0, 22),
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			local detail = label(frame, "", 14, BODY_FONT, MUTED, {
				Position = UDim2.fromOffset(10, 22),
				Size = UDim2.new(1, -120, 0, 18),
			})
			local created: Row = { Frame = frame, Name = nameLabel, Detail = detail, Button = nil :: any, Id = 0 }
			created.Button = button(frame, "Challenge", UDim2.fromOffset(100, 32), function()
				if created.Id ~= 0 then
					self:Send({ action = "Challenge", target = created.Id })
				end
			end)
			created.Button.AnchorPoint = Vector2.new(1, 0.5)
			created.Button.Position = UDim2.new(1, -6, 0.5, 0)
			created.Button.TextSize = 16
			row = created
			self.Rows[index] = created
		end
		local ready = entry.status == "Ready"
		row.Id = tonumber(entry.id) or 0
		row.Name.Text = tostring(entry.name or "?")
		row.Detail.Text = string.format("Soul Level %d  ·  %s", tonumber(entry.level) or 1, STATUS_TEXT[tostring(entry.status)] or "Away")
		row.Detail.TextColor3 = if ready then JADE else MUTED
		row.Button.Visible = ready
		row.Frame.Visible = true
	end
	for index = count + 1, #self.Rows do
		self.Rows[index].Frame.Visible = false
		self.Rows[index].Id = 0
	end
end

-------------------------------------------------------------------------------------------------
-- Duel presentation
-------------------------------------------------------------------------------------------------

function Controller.Pulse(self: ColosseumController, text: string, color: Color3)
	local countdown = self.Countdown
	countdown.Text = text
	countdown.TextColor3 = color
	countdown.TextTransparency = 0
	countdown.TextStrokeTransparency = 0.3
	countdown.Size = UDim2.fromOffset(660, 160)
	TweenService:Create(countdown, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Size = UDim2.fromOffset(600, 140),
	}):Play()
end

function Controller.BeginMatch(self: ColosseumController, payload: any)
	self.Prompt.Visible = false
	self.ChallengeId = nil
	self:ClosePanel()
	self.Queued = false
	self.MatchId = tostring(payload.matchId)
	self.MatchStarts = tonumber(payload.starts) or serverNow()
	self.MatchEnds = tonumber(payload.ends) or (self.MatchStarts + 120)
	self.LastCount = -1
	local ranked = payload.mode == "Ranked1v1"
	self.MatchMode.Text = if ranked then "RANKED DUEL" else "CASUAL SPAR"
	local opponent = tostring(payload.opponentName or "Rival")
	if ranked and payload.opponentElo then
		opponent ..= string.format("  (%d)", tonumber(payload.opponentElo) or 0)
	end
	self.MatchNames.Text = string.format("%s   VS   %s", self.Player.DisplayName, opponent)
	self.MatchClock.Text = ""
	self.MatchFrame.Visible = true
	self.Interface:ShowBanner(string.upper(tostring(payload.name or "The Colosseum")), if ranked
		then string.format("Balanced to Soul Level %d", tonumber(payload.level) or 1)
		else "A spar between warriors", 2.6)
end

function Controller.EndMatch(self: ColosseumController, payload: any)
	self.MatchId = nil
	self.MatchFrame.Visible = false
	local outcome = tostring(payload.outcome or "")
	local opponent = tostring(payload.opponentName or "your rival")
	local delta = tonumber(payload.eloDelta)
	local subtitle = if delta then string.format("Rating %s%d", if delta &gt;= 0 then "+" else "", delta) else ""
	if payload.reason == "Forfeit" then
		subtitle = (if subtitle ~= "" then subtitle .. "  ·  " else "") .. "by forfeit"
	elseif payload.reason == "Time" then
		subtitle = (if subtitle ~= "" then subtitle .. "  ·  " else "") .. "on time"
	end
	if outcome == "Win" then
		self.Interface:ShowBanner("VICTORY", if subtitle ~= "" then subtitle else "over " .. opponent, 4)
	elseif outcome == "Loss" then
		self.Interface:ShowBanner("DEFEAT", if subtitle ~= "" then subtitle else "to " .. opponent, 4)
	elseif outcome == "Draw" then
		self.Interface:ShowBanner("STALEMATE", subtitle, 4)
	else
		self.Interface:ShowBanner("DUEL ABANDONED", "", 3)
	end
end

-------------------------------------------------------------------------------------------------
-- Network
-------------------------------------------------------------------------------------------------

function Controller.Receive(self: ColosseumController, payload: any)
	local action: string = payload.action
	if action == "Open" then
		self:Populate(payload)
		self:OpenPanel()
	elseif action == "Roster" then
		self:Populate(payload)
	elseif action == "Close" then
		self:ClosePanel()
	elseif action == "Queue" then
		local queued = payload.queued == true
		if queued and not self.Queued then
			self.QueuedAt = os.clock()
		end
		self.Queued = queued
		if type(payload.rankedOpen) == "boolean" then
			self.RankedOpen = payload.rankedOpen
		end
		self:RefreshRanked()
		if payload.ok ~= true then
			self:Toast(payload.err)
		elseif queued then
			self.Interface:ShowToast("You await a worthy rival.")
		end
	elseif action == "Challenge" then
		self.ChallengeId = tostring(payload.challenge)
		self.ChallengeExpires = tonumber(payload.expires) or (serverNow() + 15)
		self.PromptText.Text = string.format("%s challenges you to a spar at %s.", tostring(payload.fromName or "A warrior"), tostring(payload.name or "the Colosseum"))
		self.Prompt.Visible = true
		self:HoldMenu(true)
	elseif action == "ChallengeWithdrawn" then
		if self.ChallengeId == payload.challenge then
			self.ChallengeId = nil
			self.Prompt.Visible = false
			if not self.PanelOpen then
				self:HoldMenu(false)
			end
		end
	elseif action == "ChallengeResult" then
		if payload.ok == true and payload.sent == true then
			self.Interface:ShowToast(string.format("Challenge sent to %s.", tostring(payload.name or "your rival")))
		elseif payload.ok ~= true then
			self:Toast(payload.err)
		end
	elseif action == "MatchFound" then
		self:BeginMatch(payload)
	elseif action == "MatchState" then
		if type(payload.ends) == "number" then
			self.MatchEnds = payload.ends
		end
	elseif action == "MatchResult" then
		self:EndMatch(payload)
	end
end

function Controller.OnCue(self: ColosseumController, cue: Cue)
	if cue.Kind ~= "ColosseumBegin" and cue.Kind ~= "ColosseumResult" then
		return
	end
	local data = cue.Data
	local own = self.State.LocalId
	if data.a == own or data.b == own then
		return
	end
	local root = self.State:Own()
	local part = root and root.Root
	local x, z = tonumber(data.x), tonumber(data.z)
	if not part or not x or not z or (Vector3.new(x, part.Position.Y, z) - part.Position).Magnitude &gt; SPECTATOR_RADIUS then
		return
	end
	if cue.Kind == "ColosseumBegin" then
		self.Interface:ShowToast(string.format("%s faces %s in %s.", tostring(data.an or "?"), tostring(data.bn or "?"), tostring(data.name or "the ring")))
	elseif data.draw == true then
		self.Interface:ShowToast(string.format("%s and %s fight to a stalemate.", tostring(data.an or "?"), tostring(data.bn or "?")))
	elseif data.wn then
		self.Interface:ShowToast(string.format("%s prevails in %s.", tostring(data.wn), tostring(data.name or "the ring")))
	end
end

-------------------------------------------------------------------------------------------------
-- Frame
-------------------------------------------------------------------------------------------------

function Controller.Update(self: ColosseumController, _dt: number)
	local current = serverNow()
	if self.Prompt.Visible then
		local remaining = self.ChallengeExpires - current
		if remaining &lt;= 0 then
			self.ChallengeId = nil
			self.Prompt.Visible = false
			if not self.PanelOpen then
				self:HoldMenu(false)
			end
		else
			self.PromptTimer.Text = tostring(math.ceil(remaining))
		end
	end
	if self.PanelOpen and self.Queued then
		self:RefreshRanked()
	end
	if self.MatchId then
		if current &lt; self.MatchStarts then
			local count = math.ceil(self.MatchStarts - current)
			if count ~= self.LastCount then
				self.LastCount = count
				self:Pulse(tostring(count), IVORY)
			end
			self.MatchClock.Text = clockText(self.MatchEnds - self.MatchStarts)
		else
			if self.LastCount ~= 0 then
				self.LastCount = 0
				self:Pulse("FIGHT!", BLOOD)
			end
			local remaining = self.MatchEnds - current
			self.MatchClock.Text = clockText(remaining)
			self.MatchClock.TextColor3 = if remaining &lt;= 10 then BLOOD else IVORY
		end
	end
end

function Controller.Destroy(self: ColosseumController)
	for _, disconnect in self.Disconnects do
		disconnect()
	end
	table.clear(self.Disconnects)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	self:HoldMenu(false)
	self.Gui:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="656">
            <Properties>
              <string name="Name">CombatCallouts</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/CombatCallouts
-- Readable combat feedback: damage numbers (pale yours, gold counters/deathblows, red taken, grey
-- chip), centre calls for PARRY / BLOCKED / GUARD BROKEN / COUNTER / DEATHBLOW, contact calls from
-- ContactCues (MISSED / OUT OF REACH / EVADED / DODGED / FEINT) and a guard emblem with posture.
-- Priority: a perilous warning (shape-marked "▲") outranks critical calls (PARRY!, DEATHBLOW,
-- breaks), which outrank info calls; damage numbers shrink and fade while a warning is up.
local TweenService = game:GetService("TweenService")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local Icons = require(script.Parent:WaitForChild("MoveIcons") :: ModuleScript)
local Contact = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.ContactCues)

local Callouts = {}
local C = Sakura.Colors
-- Customization ------------------------------------------------------------------------------
local MAX_POPUPS, POPUP_TIME, CALLOUT_TIME = 16, 0.85, 0.75
local GREY = Color3.fromRGB(190, 170, 182)
local DAMAGE_KINDS = { Hit = true, CounterHit = true, BleedProc = true, Deathblow = true }
local WARNING, CRITICAL, INFO = 3, 2, 1

export type View = {
	Gui: ScreenGui, State: any, Text: TextLabel, Pop: UIScale, Until: number, Live: number, Priority: number, WarnUntil: number,
	Guard: Frame, GuardStroke: UIStroke, GuardFill: Frame, OwnState: string,
}

function Callouts.new(gui: ScreenGui, state: any): View
	local text = HudKit.label(gui, "", 40, Enum.Font.Garamond, C.Gold, {
		Name = "CombatCallout", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.34),
		Size = UDim2.fromOffset(520, 48), TextStrokeTransparency = 0.1, TextTransparency = 1,
	})
	local pop = HudKit.make("UIScale", text, {}) :: UIScale
	local guard = Sakura.medallion(gui, 44, UDim2.fromScale(0.5, 0.62), false)
	guard.Name, guard.Visible = "GuardEmblem", false
	Icons.draw(guard, "Block", 44)
	local track = HudKit.make("Frame", guard, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 8), Size = UDim2.fromOffset(90, 5),
		BackgroundColor3 = C.Ink, BackgroundTransparency = 0.2, BorderSizePixel = 0,
	}) :: Frame
	local fill = HudKit.make("Frame", track, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Gold, BorderSizePixel = 0,
	}) :: Frame
	return {
		Gui = gui, State = state, Text = text, Pop = pop, Until = 0, Live = 0, Priority = 0, WarnUntil = 0, OwnState = "Idle",
		Guard = guard, GuardStroke = guard:FindFirstChildOfClass("UIStroke") :: UIStroke, GuardFill = fill,
	}
end

local function shout(view: View, text: string, color: Color3, size: number?, priority: number?, hold: number?)
	local rank = priority or INFO
	if os.clock() &lt; view.Until and rank &lt; view.Priority then return end
	view.Priority = rank
	view.Text.Text, view.Text.TextColor3, view.Text.TextSize = text, color, size or 40
	view.Text.TextTransparency, view.Text.TextStrokeTransparency = 0, 0.1
	view.Until = os.clock() + (hold or CALLOUT_TIME)
	view.Pop.Scale = 1.35
	TweenService:Create(view.Pop, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function popup(view: View, entity: any?, text: string, color: Color3, size: number)
	local root = entity and entity.Root
	if not root or view.Live &gt;= MAX_POPUPS then return end
	view.Live += 1
	if os.clock() &lt; view.WarnUntil then size = math.floor(size * 0.7) end
	local start = Vector3.new(math.random(-12, 12) / 10, 2.6, 0)
	local billboard = HudKit.make("BillboardGui", view.Gui, {
		Name = "DamageNumber", Adornee = root, Size = UDim2.fromOffset(120, 40), StudsOffsetWorldSpace = start,
		AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 120, ResetOnSpawn = false,
	}) :: BillboardGui
	local label = HudKit.label(billboard, text, size, Enum.Font.GothamBlack, color, { Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0.15 })
	local info = TweenInfo.new(POPUP_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(billboard, info, { StudsOffsetWorldSpace = start + Vector3.new(0, 2.2, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(POPUP_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(POPUP_TIME, function()
		view.Live -= 1
		billboard:Destroy()
	end)
end

-- Whiff / evade / feint (ContactCues): grey popups over the foe, or a quiet centre call.
local function contact(view: View, event: any, own: number): boolean
	if event.Kind == "Evade" and event.Source == own and view.OwnState ~= "Dashing" then return false end -- F08: not while helpless
	local source, me = view.State:Get(event.Source), view.State:Get(own)
	local near = source and source.Root and me and me.Root and (source.Root.Position - me.Root.Position).Magnitude &lt; 30
	local cue = Contact.describe(event.Kind, event.Source, event.Target, event.Value, own, near == true)
	if not cue then return false end
	local color = if cue.Tone == "Ivory" then C.Ivory else GREY
	if cue.Over then popup(view, view.State:Get(if cue.Over == "Source" then event.Source else event.Target), cue.Text, color, 17)
	else shout(view, cue.Text, color, 26) end
	return true
end

-- Returns the id of the opponent involved when the local player dealt or took the blow.
function Callouts.event(view: View, event: any): number?
	local own = view.State.LocalId
	if event.Kind == "Whiff" or event.Kind == "Evade" or event.Kind == "Feint" then
		return if contact(view, event, own) and event.Source == own and event.Target ~= own and event.Target ~= 0 then event.Target else nil
	end
	local mine, onMe = event.Source == own and event.Target ~= own, event.Target == own and event.Source ~= own
	if not mine and not onMe then return nil end
	local target = view.State:Get(event.Target)
	local amount = tostring(math.max(1, math.floor(event.Value + 0.5)))
	if DAMAGE_KINDS[event.Kind] then
		local special = event.Kind == "CounterHit" or event.Kind == "Deathblow"
		popup(view, target, amount, if onMe then C.Crimson elseif special then C.Gold else C.Ivory, if special then 30 else 24)
		if mine and event.Kind == "CounterHit" then shout(view, "COUNTER", C.Gold, 34) end
		if mine and event.Kind == "Deathblow" then shout(view, "DEATHBLOW", C.Crimson, 46, CRITICAL) end
	elseif event.Kind == "Block" then
		popup(view, target, if event.Value &gt;= 1 then amount else "Blocked", GREY, 18)
		if onMe then shout(view, "BLOCKED", C.Ivory, 30) end
	elseif event.Kind == "DeflectSpark" then -- Source deflected Target's attack
		if mine then shout(view, "PARRY!", C.Gold, 46, CRITICAL) else shout(view, "DEFLECTED", GREY, 30) end
	elseif event.Kind == "GuardBreak" then
		if onMe then shout(view, "GUARD BROKEN", C.Crimson, 40, CRITICAL) else shout(view, "GUARD BREAK", C.Gold, 36) end
	elseif event.Kind == "StanceBreak" and mine then
		shout(view, "POSTURE BROKEN — DEATHBLOW!", C.Gold, 34, CRITICAL)
	elseif event.Kind == "KO" and mine then
		shout(view, "DEFEATED", C.Blossom, 34)
	end
	return if mine then event.Target else event.Source
end

-- A boss's perilous attack: the counter is named in the centre until impact, above everything else.
function Callouts.warn(view: View, counter: string, seconds: number, hint: string?)
	local hold = math.clamp(seconds, 0.4, 3)
	view.WarnUntil = os.clock() + hold
	shout(view, "▲ PERILOUS — " .. string.upper(counter) .. (if hint then "  ·  " .. hint else "") .. " ▲", C.Crimson, if hint then 30 else 38, WARNING, hold)
end

function Callouts.step(view: View, dt: number, snapshot: any?, hidden: boolean)
	if hidden then -- nothing from the fight survives into death, prologue or dialogue
		view.Until, view.WarnUntil, view.Priority = 0, 0, 0
		view.Text.TextTransparency, view.Text.TextStrokeTransparency = 1, 1
	end
	if os.clock() &gt; view.Until and view.Text.TextTransparency &lt; 1 then
		view.Text.TextTransparency = math.min(1, view.Text.TextTransparency + dt * 4)
		view.Text.TextStrokeTransparency = math.max(view.Text.TextTransparency, 0.1)
	end
	local state = if snapshot then snapshot.State else "Idle"; view.OwnState = state
	local guarding = snapshot ~= nil and not hidden and (snapshot.Blocking or state == "Blocking" or state == "Blockstun" or state == "Deflecting")
	view.Guard.Visible = guarding
	if guarding and snapshot then
		local p = math.clamp(snapshot.Posture / math.max(snapshot.PostureCapacity, 1), 0, 1)
		view.GuardFill.Size = UDim2.fromScale(p, 1)
		view.GuardFill.BackgroundColor3 = if p &gt; 0.75 then C.Crimson else C.Gold
		view.GuardStroke.Color = if state == "Deflecting" then C.Gold elseif state == "Blockstun" then C.Ivory else C.Sakura
	end
end
return table.freeze(Callouts)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="657">
            <Properties>
              <string name="Name">CombatFeedback</string>
              <string name="Source">--!strict
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Schema = require(game:GetService("ReplicatedStorage").AsurasPath.Simulation.MoveSchema) :: any
local Comfort = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Feedback = {}
Feedback.__index = Feedback
local HITSTOP: { [string]: number } = {
	Hit = 0.04,
	Armored = 0.04,
	CounterHit = 0.07,
	DeflectSpark = 0.05,
	GuardBreak = 0.06,
	StanceBreak = 0.07,
	Deathblow = 0.08,
}
local WEIGHT: { [string]: number } = {
	Hit = 0.18,
	Armored = 0.12,
	Block = 0.1,
	CounterHit = 0.4,
	DeflectSpark = 0.25,
	GuardBreak = 0.5,
	StanceBreak = 0.55,
	Deathblow = 0.9,
	KO = 0.6,
}
local FOV_PUNCH: { [string]: number } = {
	CounterHit = 2.5,
	GuardBreak = 3,
	StanceBreak = -3,
	Deathblow = -8,
	DeflectSpark = 1.2,
}
local BLUR_BY_TIER: { [string]: number } = { None = 0, Impaired = 4, Injured = 8, Severe = 14 }
local FOV_CLAMP_BY_TIER: { [string]: number } = { None = 0, Impaired = 4, Injured = 8, Severe = 14 }
local SWAY_BY_TIER: { [string]: number } = { None = 0, Impaired = 0.004, Injured = 0.009, Severe = 0.016 }
local function vignetteEdge(parent: Instance, name: string, size: UDim2, position: UDim2, rotation: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = Color3.fromRGB(8, 0, 0)
	frame.BorderSizePixel = 0
	frame.BackgroundTransparency = 1
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = frame
	frame.Parent = parent
	return frame
end
function Feedback.new(state: any, camera: any): any
	local blur = Instance.new("BlurEffect")
	blur.Name = "AsuraConcussion"
	blur.Size = 0
	blur.Parent = Lighting
	local gui = Instance.new("ScreenGui")
	gui.Name = "AsuraVignette"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local edges = {
		vignetteEdge(gui, "Left", UDim2.fromScale(0.28, 1), UDim2.fromScale(0, 0), 0),
		vignetteEdge(gui, "Right", UDim2.fromScale(0.28, 1), UDim2.fromScale(0.72, 0), 180),
		vignetteEdge(gui, "Top", UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), 90),
		vignetteEdge(gui, "Bottom", UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.7), 270),
	}
	return setmetatable({ State=state, Camera=camera, Blur=blur, Vignette=gui, VignetteEdges=edges, Frozen={}, Tier="None" }, Feedback)
end
local function animator(model: Model): Animator?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return if humanoid then humanoid:FindFirstChildOfClass("Animator") else nil
end
function Feedback.HitStop(self: any, models: { Model }, duration: number)
	local release = os.clock() + duration
	for _, model in models do
		local anim = animator(model)
		if anim then
			for _, track in anim:GetPlayingAnimationTracks() do
				local frozen = self.Frozen[track]
				if frozen then
					frozen.Until = math.max(frozen.Until, release)
				else
					self.Frozen[track] = { Track = track, Speed = track.Speed, Until = release }
					track:AdjustSpeed(0)
				end
			end
		end
	end
end
function Feedback.Event(self: any, event: any, direction: Vector3)
 local id = self.State.LocalId
 if event.Source ~= id and event.Target ~= id and event.Source ~= self.Camera.Locked and event.Target ~= self.Camera.Locked then return end
 local models: {Model} = {}
 for _, actorId in {event.Source, event.Target} do
  local e = self.State:Get(actorId); if e then table.insert(models, e.Model) end
 end
 if HITSTOP[event.Kind] then self:HitStop(models, HITSTOP[event.Kind]) end
 if WEIGHT[event.Kind] then self.Camera:Impulse(direction, WEIGHT[event.Kind] * (if event.Target == id then 1 else 0.6), FOV_PUNCH[event.Kind]) end
end
function Feedback.Update(self: any, dt: number)
	local now = os.clock()
	for track, frozen in self.Frozen do
		if now &gt;= frozen.Until then
			self.Frozen[track] = nil
			if track.IsPlaying then
				track:AdjustSpeed(frozen.Speed)
			end
		end
	end
	local snapshot = self.State:OwnSnapshot()
	local tier = "None"
	local blur = 0
	local vignette = 0
	if snapshot and snapshot.State ~= "KO" then
		tier = snapshot.Injuries.Head
		local penalties = Schema.penalties(snapshot.Injuries, false, "Right")
		local vision = if penalties.VisionBlur &gt; 0 then 4 + (penalties.VisionBlur - 0.2) / 0.55 * 10 else 0
		blur = math.max(BLUR_BY_TIER[tier] or 0, vision)
		vignette = penalties.EyeVignette
	end
	if tier ~= self.Tier then
		self.Tier = tier
		self.Camera:SetHeadTrauma(tier)
		self.Camera:SetFovClamp(FOV_CLAMP_BY_TIER[tier] or 0)
		self.Camera:SetSway(SWAY_BY_TIER[tier] or 0)
	end
	local pulse = if blur &gt; 0 and not Comfort.reducedMotion() then 1 + 0.15 * math.sin(now * 1.4) else 1
	self.BlurTarget = math.clamp(blur * pulse, 0, 14)
	self.Blur.Size += (self.BlurTarget - self.Blur.Size) * math.min(1, dt * 4)
	local transparency = 1 - math.clamp(vignette * 1.1, 0, 0.85)
	for _, edge in self.VignetteEdges do
		edge.BackgroundTransparency += (transparency - edge.BackgroundTransparency) * math.min(1, dt * 3)
	end
end
function Feedback.Destroy(self: any)
 for track, frozen in self.Frozen do if track.IsPlaying then track:AdjustSpeed(frozen.Speed) end end
 table.clear(self.Frozen); self.Blur:Destroy(); self.Vignette:Destroy()
 self.Camera:SetHeadTrauma("None"); self.Camera:SetFovClamp(0); self.Camera:SetSway(0)
end
return Feedback
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="658">
            <Properties>
              <string name="Name">CombatHud</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/CombatHud
-- Owns the fight-readability layer: the keybind ActionBar, overhead EnemyBars with attack
-- warnings, CombatCallouts (damage numbers, PARRY / BLOCKED pops, guard emblem) and the top
-- TargetPlate for whoever you are fighting. HudVisibility hides it for the prologue, death and
-- dialogue (and hides world prompts with it); the focused foe's overhead plate drops to its warning.
local Workspace = game:GetService("Workspace")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local ActionBar = require(script.Parent:WaitForChild("ActionBar") :: ModuleScript)
local EnemyBars = require(script.Parent:WaitForChild("EnemyBars") :: ModuleScript)
local Callouts = require(script.Parent:WaitForChild("CombatCallouts") :: ModuleScript)
local TargetPlate = require(script.Parent:WaitForChild("TargetPlate") :: ModuleScript)
local Visibility = require(script.Parent:WaitForChild("HudVisibility") :: ModuleScript)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath").Shared
local BossRules = require(Shared.BossEncounterRules)
local TutorialRules = require(Shared.TutorialRules)

local Controller = {}
Controller.__index = Controller

-- Customization ------------------------------------------------------------------------------
local FOCUS_SECONDS = 8 -- how long the target plate follows the last foe you traded blows with
local taught: { [string]: number } = {} -- boss counters warned this session (hint on the first few)

export type CombatHud = typeof(setmetatable({} :: {
	State: any, Camera: any, Input: any, Ui: any, Bar: ActionBar.View, Bars: EnemyBars.View, Callouts: Callouts.View,
	Target: TargetPlate.View, FocusId: number, FocusUntil: number, Disconnects: { () -&gt; () }, PreviousCommand: any,
}, Controller))

function Controller.new(state: any, camera: any, input: any, ui: any): CombatHud
	local gui = ui.Gui :: ScreenGui
	local self = setmetatable({
		State = state, Camera = camera, Input = input, Ui = ui,
		Bar = ActionBar.new(gui), Bars = EnemyBars.new(gui, state), Callouts = Callouts.new(gui, state), Target = TargetPlate.new(gui),
		FocusId = 0, FocusUntil = 0, Disconnects = {}, PreviousCommand = input.OnCommand,
	}, Controller)
	self.Target.Root.Destroying:Once(HudKit.bindScale(self.Target.Root, 0.9))
	table.insert(self.Disconnects, state:OnEvent(function(event)
		local foe = Callouts.event(self.Callouts, event)
		if foe and foe ~= 0 then self.FocusId, self.FocusUntil = foe, os.clock() + FOCUS_SECONDS end
	end))
	table.insert(self.Disconnects, state:OnCue(function(cue)
		local entity = if cue.Kind == "Telegraph" then state:Get(cue.Source) else nil
		if entity then EnemyBars.cue(self.Bars, entity, cue.Data) end
		local data = cue.Data
		local mine = entity ~= nil and ui.BossId ~= nil and entity.Model:GetAttribute("AsuraEncounter") == ui.BossId
		if mine and type(data.counter) == "string" and type(data.impact) == "number" and Visibility.of(ui).Combat then
			local count = (taught[data.counter] or 0) + 1
			taught[data.counter] = count
			local keys = BossRules.CounterKeys[data.counter]
			local hint = if keys and count &lt;= BossRules.CounterHintCount then TutorialRules.text(keys, function(c: string) return input:Hint(c) end) else nil
			Callouts.warn(self.Callouts, data.counter, data.impact - Workspace:GetServerTimeNow(), hint)
		end
	end))
	local previous = self.PreviousCommand
	input.OnCommand = function(command: string)
		if previous then previous(command) end
		ActionBar.press(self.Bar, command)
	end
	return self
end

function Controller.Update(self: CombatHud, dt: number)
	local ui = self.Ui
	local layers = Visibility.apply(ui)
	local hidden = not layers.Combat
	local snapshot = self.State:OwnSnapshot()
	local locked = self.Camera:LockedEntity()
	ActionBar.update(self.Bar, snapshot, self.Input, locked ~= nil)
	if hidden then self.Bar.Root.Visible = false end
	local focus = locked
	if not focus and os.clock() &lt; self.FocusUntil then focus = self.State:Get(self.FocusId) end
	if focus and not self.State:IsAlive(focus) then focus = nil end
	local bossShown = ui.BossFrame ~= nil and ui.BossFrame.Visible
	local plated = not hidden and not bossShown and focus ~= nil and not focus.Boss
	if hidden then EnemyBars.destroy(self.Bars) else EnemyBars.step(self.Bars, dt, locked, if plated then focus else nil) end
	Callouts.step(self.Callouts, dt, snapshot, hidden)
	TargetPlate.update(self.Target, focus, dt, not plated)
end

function Controller.Destroy(self: CombatHud)
	for _, disconnect in self.Disconnects do disconnect() end
	table.clear(self.Disconnects)
	self.Input.OnCommand = self.PreviousCommand
	EnemyBars.destroy(self.Bars)
	Visibility.restore()
	self.Bar.Root:Destroy()
	self.Callouts.Text:Destroy()
	self.Callouts.Guard:Destroy()
	self.Target.Root:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="659">
            <Properties>
              <string name="Name">CombatSurfaces</string>
              <string name="Source">--!strict
local Debris = game:GetService("Debris")
local Tween = game:GetService("TweenService")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Surfaces = {}
local stains: {BasePart} = {}
function Surfaces.ground(folder: Instance, point: Vector3, excludes: {Instance}?): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list: {Instance} = { folder }
	local ignored: {Instance} = excludes or {}
	for _, item in ignored do table.insert(list, item) end
	params.FilterDescendantsInstances, params.RespectCanCollide = list, true
	return workspace:Raycast(point + Vector3.yAxis * 2, -Vector3.yAxis * 16, params)
end
function Surfaces.stain(folder: Instance, point: Vector3, direction: Vector3, excludes: {Instance}?)
	local hit = Surfaces.ground(folder, point + direction * 1.4, excludes)
	if not hit then return end
	while #stains &gt; 0 and stains[1].Parent == nil do table.remove(stains, 1) end
	if #stains &gt;= Assets.Limits.Stains then local oldest=table.remove(stains,1); if oldest then oldest:Destroy() end end
	local p = Instance.new("Part")
	p.Name, p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = "BloodRallyStain", true, false, false, false, false
	local normal = hit.Normal
	local right = normal:Cross(if math.abs(normal.Y) &gt; 0.95 then Vector3.zAxis else Vector3.yAxis).Unit
	p.CFrame = CFrame.fromMatrix(hit.Position + normal * 0.014, right, normal) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	p.Size = Vector3.new(1.4 + math.random(), 0.016, 1 + math.random())
	p.Color, p.Material = Color3.fromRGB(65, 5, 9), Enum.Material.SmoothPlastic
	if Assets.Textures.BloodStain ~= "" then
		p.Transparency = 1
		local decal = Instance.new("Decal")
		decal.Texture, decal.Face, decal.Parent = Assets.Textures.BloodStain, Enum.NormalId.Top, p
		Tween:Create(decal, TweenInfo.new(7), { Transparency = 1 }):Play()
	else
		p.Shape = Enum.PartType.Ball; p.Transparency = 0.3
		Tween:Create(p, TweenInfo.new(7), { Transparency = 1 }):Play()
	end
	p.Parent = folder; table.insert(stains, p); Debris:AddItem(p, 7.2)
end
function Surfaces.rupture(folder: Instance, point: Vector3, direction: Vector3, color: Color3, excludes: {Instance}?)
	local forward = Vector3.new(direction.X, 0, direction.Z)
	forward = if forward.Magnitude &lt; 0.1 then Vector3.zAxis else forward.Unit
	local side = forward:Cross(Vector3.yAxis)
	local previous: Vector3? = nil
	for i = 0, 10 do
		local hit = Surfaces.ground(folder, point + forward * (i * 1.7) + side * math.sin(i * 2.8) * 0.8, excludes)
		if not hit then previous = nil; continue end
		local at = hit.Position + hit.Normal * 0.035
		if previous then
			local p = Instance.new("Part")
			p.Name, p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = "QiGroundFissure", true, false, false, false, false
			p.Material, p.Color = Enum.Material.Neon, color
			p.Size, p.CFrame = Vector3.new(0.12 + i * 0.012, 0.045, (at - previous).Magnitude), CFrame.lookAt((at + previous)/2, at)
			p.Parent = folder
			Tween:Create(p, TweenInfo.new(1.3), { Transparency = 1 }):Play(); Debris:AddItem(p, 1.4)
		end
		previous = at
	end
end
function Surfaces.clear()
	for _, p in stains do p:Destroy() end
	table.clear(stains)
end
return Surfaces
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="660">
            <Properties>
              <string name="Name">CombatVfx</string>
              <string name="Source">--!strict
local Tween = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Surfaces = require(script.Parent.CombatSurfaces)
local Comfort = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Vfx = {}
Vfx.__index = Vfx
local rng = Random.new()
function Vfx.new(folder: Folder): any return setmetatable({ Folder = folder, Bursts = {}, Shards = {} }, Vfx) end
local function part(parent: Instance, name: string): Part
	local p = Instance.new("Part")
	p.Name, p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = name, true, false, false, false, false
	p.Transparency, p.Size, p.Parent = 1, Vector3.one * 0.1, parent
	return p
end
function Vfx.ring(self: any, point: Vector3, direction: Vector3, color: Color3, radius: number)
	while #self.Bursts &gt; 0 and self.Bursts[1].Parent == nil do table.remove(self.Bursts, 1) end
	if #self.Bursts &gt;= Assets.Limits.Bursts then local oldest=table.remove(self.Bursts,1); if oldest then oldest:Destroy() end end
	local p = part(self.Folder, "DeflectShockwave")
	table.insert(self.Bursts, p)
	p.CFrame = CFrame.lookAt(point, point + (if direction.Magnitude &gt; 0.1 then direction.Unit else Vector3.yAxis))
	local nodes: {Attachment} = {}
	for i = 1, 20 do
		local angle = (i - 1) * math.pi / 10
		local a = Instance.new("Attachment"); a.Position, a.Parent = Vector3.new(math.cos(angle), math.sin(angle), 0) * 0.12, p
		table.insert(nodes, a)
		Tween:Create(a, TweenInfo.new(0.18), { Position = a.Position * radius / 0.12 }):Play()
	end
	for i, a in nodes do
		local b = Instance.new("Beam")
		b.Attachment0, b.Attachment1, b.FaceCamera = a, nodes[i % #nodes + 1], true
		b.Color, b.LightEmission, b.Width0, b.Width1 = ColorSequence.new(Color3.new(1,1,1), color), 1, 0.09, 0.09
		b.Parent = p
		Tween:Create(b, TweenInfo.new(0.2), { Width0 = 0, Width1 = 0 }):Play()
	end
	Debris:AddItem(p, 0.23)
end
-- An attack's real reach (batch 09): a pale 90° arc at chest height around the attacker, drawn when a
-- swing closes without contact so a whiff reads as distance rather than a broken hit.
function Vfx.arc(self: any, center: Vector3, forward: Vector3, radius: number, color: Color3)
	local p = part(self.Folder, "ReachArc")
	local flat = Vector3.new(forward.X, 0, forward.Z)
	p.CFrame = CFrame.lookAt(center, center + (if flat.Magnitude &gt; 0.1 then flat.Unit else Vector3.zAxis))
	local nodes: {Attachment} = {}
	for i = 0, 8 do
		local angle = math.rad(-45 + i * 11.25)
		local a = Instance.new("Attachment"); a.Position, a.Parent = Vector3.new(math.sin(angle), 0, -math.cos(angle)) * radius, p
		table.insert(nodes, a)
	end
	for i = 1, #nodes - 1 do
		local b = Instance.new("Beam")
		b.Attachment0, b.Attachment1, b.FaceCamera, b.Parent = nodes[i], nodes[i + 1], true, p
		b.Color, b.LightEmission, b.Transparency, b.Width0, b.Width1 = ColorSequence.new(color), 0.6, NumberSequence.new(0.35), 0.12, 0.12
		Tween:Create(b, TweenInfo.new(0.35), { Width0 = 0, Width1 = 0 }):Play()
	end
	Debris:AddItem(p, 0.4)
end
function Vfx.burst(self: any, point: Vector3, direction: Vector3, color: Color3, count: number, speed: number, blood: boolean?): Part
	while #self.Bursts &gt; 0 and self.Bursts[1].Parent == nil do table.remove(self.Bursts, 1) end
	if #self.Bursts &gt;= Assets.Limits.Bursts then local oldest=table.remove(self.Bursts,1); if oldest then oldest:Destroy() end end
	local p = part(self.Folder, if blood then "FleshImpact" else "BladeEmbers")
	p.CFrame = CFrame.lookAt(point, point + (if direction.Magnitude &gt; 0.1 then direction.Unit else Vector3.yAxis))
	table.insert(self.Bursts, p)
	local texture = if blood then Assets.Textures.Blood else Assets.Textures.Ember
	if texture ~= "" then
		local e = Instance.new("ParticleEmitter")
		e.Texture, e.Rate = texture, 0
		e.EmissionDirection, e.SpreadAngle = Enum.NormalId.Front, Vector2.new(32, 32)
		e.Lifetime, e.Speed, e.Drag = NumberRange.new(0.1, 0.3), NumberRange.new(speed * 0.6, speed), 3
		e.LightEmission, e.LightInfluence = if blood then 0 else 1, if blood then 1 else 0
		e.Color = ColorSequence.new(if blood then color else Color3.new(1,1,1), color)
		e.Acceleration = Vector3.new(0, -55, 0)
		e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.26), NumberSequenceKeypoint.new(1, 0)})
		e.Parent = p; e:Emit(math.clamp(count, 1, 40))
	else
		-- Custom geometric streaks keep feedback available before the texture uploads.
		for _ = 1, math.min(count, 40, Assets.Limits.Shards - #self.Shards) do
			local shard = part(p, "RicochetStreak")
			shard.Transparency, shard.Material, shard.Color = 0, if blood then Enum.Material.SmoothPlastic else Enum.Material.Neon, color
			shard.Size = Vector3.new(0.035, 0.035, if blood then 0.18 else 0.4)
			local velocity = p.CFrame:VectorToWorldSpace(Vector3.new(rng:NextNumber(-0.6,0.6), rng:NextNumber(-0.4,0.8), -1).Unit) * rng:NextNumber(speed*0.6,speed)
			table.insert(self.Shards, { Part = shard, At = point, V = velocity, Life = rng:NextNumber(0.12,0.27), Bounced = false })
		end
	end
	if not blood then
		local flash = Instance.new("PointLight")
		flash.Color, flash.Range, flash.Brightness, flash.Parent = color, 10, Comfort.flash(3), p
		Tween:Create(flash, TweenInfo.new(0.1), { Brightness = 0 }):Play()
	end
	Debris:AddItem(p, 0.65); return p
end
function Vfx.Update(self: any, dt: number)
	local params = RaycastParams.new(); params.FilterDescendantsInstances = {self.Folder}; params.RespectCanCollide = true
	for i = #self.Shards, 1, -1 do
		local s = self.Shards[i]; s.Life -= dt
		if s.Life &lt;= 0 or not s.Part.Parent then s.Part:Destroy(); table.remove(self.Shards,i); continue end
		s.V += Vector3.new(0,-55,0)*dt
		local delta = s.V * dt
		local hit = if not s.Bounced then workspace:Raycast(s.At, delta, params) else nil
		if hit then s.At = hit.Position + hit.Normal*0.04; s.V = (s.V-2*s.V:Dot(hit.Normal)*hit.Normal)*0.45; s.Bounced = true else s.At += delta end
		if s.V.Magnitude &gt; 0.01 then s.Part.CFrame = CFrame.lookAt(s.At,s.At+s.V) end
		s.Part.Transparency = math.clamp(1-s.Life/0.13,0,1)
	end
end
function Vfx.blood(self: any, point: Vector3, direction: Vector3, excludes: {Instance})
	self:burst(point,direction,Color3.fromRGB(118,8,17),18,22,true)
	Surfaces.stain(self.Folder,point,direction,excludes)
end
function Vfx.rupture(self: any, point: Vector3, direction: Vector3, excludes: {Instance}?)
	Surfaces.rupture(self.Folder,point,direction,Color3.fromRGB(248,74,36),excludes)
end
function Vfx.Destroy(self: any) Surfaces.clear(); self.Folder:ClearAllChildren(); table.clear(self.Shards); table.clear(self.Bursts) end
return Vfx
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="661">
            <Properties>
              <string name="Name">ComfortSettings</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ComfortSettings
-- Comfort and readability rows for the Respite settings page (batch 25, #36 #35): reduced effects
-- (decorative petals, ash, particle density), reduced motion (camera shake/kick, scripted camera
-- moves), reduced flashes (screen blooms) and text size. Changes preview live through the shared
-- EffectsPreference; PauseMenu's Apply saves them with FOV/sensitivity and Back reverts them.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Effects = require(Shared:WaitForChild("Shared"):WaitForChild("EffectsPreference") :: ModuleScript) :: any
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)

local Comfort = {}
local T = UiKit.Theme

Comfort.Rows = table.freeze({
	{ Key = "ReducedEffects", Text = "Reduced effects" },
	{ Key = "ReducedMotion", Text = "Reduced motion" },
	{ Key = "ReducedFlashes", Text = "Reduced flashes" },
})

-- Pure: the next text scale after `current` (wraps), and its caption.
function Comfort.nextScale(current: number): number
	local scales = Effects.TextScales
	local index = table.find(scales, current) or 1
	return scales[index % #scales + 1]
end
function Comfort.caption(scale: number): string
	return string.format("%d%%", math.floor(scale * 100 + 0.5))
end

local function row(parent: Instance, order: number, text: string, press: () -&gt; ()): TextButton
	local frame = HudKit.make("Frame", parent, { Name = text, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 })
	HudKit.label(frame, text, 18, T.BodyFont, T.Ivory, { Size = UDim2.new(1, -130, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
	local button = UiKit.button(frame, "", "Secondary", press)
	button.AnchorPoint, button.Position, button.Size = Vector2.new(1, 0.5), UDim2.new(1, 0, 0.5, 0), UDim2.fromOffset(120, 40)
	return button
end

-- Builds the rows from LayoutOrder `first` on; returns a refresh function for the shown values.
function Comfort.build(parent: Instance, first: number): () -&gt; ()
	local buttons: { [string]: TextButton } = {}
	for i, spec in Comfort.Rows do
		buttons[spec.Key] = row(parent, first + i - 1, spec.Text, function()
			local prefs = Effects.get()
			Effects.set({ [spec.Key] = not prefs[spec.Key] })
		end)
	end
	local textSize = row(parent, first + #Comfort.Rows, "Text size", function()
		Effects.set({ TextScale = Comfort.nextScale(Effects.textScale()) })
	end)
	local function refresh()
		local prefs = Effects.get()
		for key, button in buttons do button.Text = if prefs[key] then "On" else "Off" end
		textSize.Text = Comfort.caption(prefs.TextScale)
	end
	local stop = Effects.onChanged(function() refresh() end)
	parent.Destroying:Once(stop)
	refresh()
	return refresh
end

return table.freeze(Comfort)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="662">
            <Properties>
              <string name="Name">ControlsCard</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ControlsCard
-- Device-aware controls reference. A centred overlay over a dim backdrop, in the band HudLayout
-- reserves between the top strip and the action bar, so it never covers the combat row. Opens on
-- a fresh spawn, folds into a "Controls" pill (left utility column, beside Codex) after a while,
-- on any combat input, or with H / B / a tap. Rows, captions and the toggle key come from InputMap.
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")

local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Layout = require(script.Parent:WaitForChild("HudLayout") :: ModuleScript)
local Visibility = require(script.Parent:WaitForChild("HudVisibility") :: ModuleScript)
local InputMap = require(Shared:WaitForChild("Shared"):WaitForChild("InputMap") :: ModuleScript)

local P = HudKit.Palette
local AUTO_HIDE = 25
local ROW_HEIGHT = 26
local COLUMN_WIDTH = 300
local CLOSE_KEYS = { [Enum.KeyCode.ButtonB] = true, [Enum.KeyCode.Backspace] = true }

-- Command, description: every InputMap binding with reference text, in map order.
local ROWS: { { string } } = {}
for _, binding in InputMap.Bindings do
	if binding.Help then
		table.insert(ROWS, { binding.Command, binding.Help })
	end
end
local TOGGLE: { [Enum.KeyCode]: boolean } = {}
for _, name in (InputMap.get("Controls") :: any).Keys do
	TOGGLE[(Enum.KeyCode :: any)[name]] = true
end

local Controller = {}
Controller.__index = Controller

export type ControlsCard = typeof(setmetatable({} :: {
	Input: any, Ui: any, Card: Frame, Backdrop: TextButton, Pill: TextButton, Keys: { [string]: TextLabel },
	Open: boolean, Timer: number, Cleanup: { () -&gt; () },
}, Controller))

function Controller.new(input: any, ui: any): ControlsCard
	local perColumn = math.ceil(#ROWS / 2)
	local size = Vector2.new(2 * COLUMN_WIDTH + 28, 46 + perColumn * ROW_HEIGHT)
	local backdrop = HudKit.make("TextButton", ui.Gui, {
		Name = "ControlsBackdrop", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.55,
		Text = "", AutoButtonColor = false, ZIndex = 30, Visible = false,
	}) :: TextButton
	-- Near-opaque: a modal over the backdrop must not let a teaching card's text bleed through (F03).
	local card = HudKit.panel(ui.Gui, "ControlsCard", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size.X, size.Y), Active = true, ZIndex = 31, BackgroundTransparency = 0.04 })
	HudKit.make("UIPadding", card, { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 8) })
	HudKit.label(card, "CONTROLS", 18, HudKit.TitleFont, P.Ember, { Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left })
	HudKit.label(card, "", 13, HudKit.BodyFont, P.Muted, { Name = "CloseHint", Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Right })
	local keys: { [string]: TextLabel } = {}
	for index, row in ROWS do
		local x = if index &gt; perColumn then COLUMN_WIDTH else 0
		local y = 28 + ((index - 1) % perColumn) * ROW_HEIGHT
		local key = HudKit.label(card, "", 15, Enum.Font.GothamMedium, P.Gold, { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(70, ROW_HEIGHT - 4), BackgroundTransparency = 0.6, BackgroundColor3 = Color3.fromRGB(40, 30, 26) })
		HudKit.make("UICorner", key, { CornerRadius = UDim.new(0, 4) })
		local text = HudKit.label(card, row[2], 17, HudKit.BodyFont, P.Ivory, { Position = UDim2.fromOffset(x + 78, y), Size = UDim2.fromOffset(COLUMN_WIDTH - 84, ROW_HEIGHT - 4), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = true })
		HudKit.make("UITextSizeConstraint", text, { MinTextSize = 10, MaxTextSize = 17 })
		keys[row[1]] = key
	end
	local slot = Layout.Regions.ControlsPill
	local pill = HudKit.make("TextButton", ui.Gui, {
		Name = "ControlsPill", Position = UDim2.new(slot.At[1], slot.Offset[1], slot.At[2], slot.Offset[2]), Size = UDim2.fromOffset(slot.Size[1], slot.Size[2]),
		BackgroundColor3 = P.Ink, BackgroundTransparency = 0.35, Font = HudKit.BodyFont, TextSize = 17, TextColor3 = P.Ivory, Visible = false,
	}) :: TextButton
	HudKit.make("UICorner", pill, { CornerRadius = UDim.new(1, 0) })
	HudKit.make("UIStroke", pill, { Color = P.Edge, Thickness = 1, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

	local self = setmetatable({ Input = input, Ui = ui, Card = card, Backdrop = backdrop, Pill = pill, Keys = keys, Open = true, Timer = AUTO_HIDE, Cleanup = {} }, Controller)
	-- Size the card into the reserved band for the current viewport.
	local scale = HudKit.make("UIScale", card, {}) :: UIScale
	local function place(v: Vector2)
		local s, rect = Layout.modal(v.X, v.Y, size.X, size.Y, input.Device == "Touch")
		scale.Scale, card.Position = s, UDim2.fromOffset(rect.X + rect.W / 2, rect.Y + rect.H / 2)
	end
	table.insert(self.Cleanup, HudKit.onViewport(place))
	table.insert(self.Cleanup, HudKit.bindScale(pill, slot.Base))
	-- Any combat command folds the reference away so it never sits over a fight. Only a card on
	-- screen folds (F08): the Space or click that skips the prologue closed it before it was seen.
	local previousCommand, previousDevice = input.OnCommand, input.OnDeviceChanged
	input.OnCommand = function(command: string)
		if previousCommand then previousCommand(command) end
		if self.Open and self.Card.Visible and command ~= "Controls" and command ~= "Cursor" and command ~= "Shoulder" then self:SetOpen(false) end
	end
	input.OnDeviceChanged = function(device: string)
		if previousDevice then previousDevice(device) end
		local camera = workspace.CurrentCamera
		if camera then place(camera.ViewportSize) end
		self:Refresh()
	end
	table.insert(self.Cleanup, function() input.OnCommand, input.OnDeviceChanged = previousCommand, previousDevice end)
	local toggleConnection = UserInputService.InputBegan:Connect(function(event: InputObject, processed: boolean)
		local key = event.KeyCode
		if not processed and not UserInputService:GetFocusedTextBox() and TOGGLE[key] and not self.Input.MenuOpen then
			self:SetOpen(not self.Open)
		elseif self.Open and CLOSE_KEYS[key] and self.Card.Visible then
			self:SetOpen(false)
		end
	end)
	table.insert(self.Cleanup, function() toggleConnection:Disconnect() end)
	-- Card, backdrop and pill connections die with the instances in Destroy.
	pill.Activated:Connect(function() self:SetOpen(true) end)
	backdrop.Activated:Connect(function() self:SetOpen(false) end)
	card.InputBegan:Connect(function(event: InputObject)
		if event.UserInputType == Enum.UserInputType.Touch or event.UserInputType == Enum.UserInputType.MouseButton1 then self:SetOpen(false) end
	end)
	self:Refresh()
	return self
end

function Controller.Refresh(self: ControlsCard)
	local device = self.Input.Device
	for command, key in self.Keys do
		key.Text = InputMap.label(command, device)
	end
	self.Pill.Text = if device == "Keyboard" then "[" .. InputMap.label("Controls", device) .. "]  Controls" else "Controls"
	local hint = self.Card:FindFirstChild("CloseHint") :: TextLabel?
	if hint then
		hint.Text = if device == "Keyboard" then "[" .. InputMap.label("Controls", device) .. "] close" elseif device == "Gamepad" then "[B] close" else "tap to close"
	end
end

function Controller.SetOpen(self: ControlsCard, open: boolean)
	self.Open = open
	self.Timer = if open then AUTO_HIDE else 0
	HudKit.cue(HudKit.Sounds.Tick, 0.35, if open then 1.2 else 0.9)
end

function Controller.Update(self: ControlsCard, dt: number)
	-- A window that owns input (the Arsenal opens on its own key) hides the card; F05: it drew over the Arsenal.
	-- F08: so does the prologue's handoff line, which the card's backdrop dimmed and half covered.
	local blocked = not Visibility.of(self.Ui).Guidance or self.Ui.BossEntity ~= nil or self.Input.MenuOpen
		or os.clock() &lt; (self.Ui.HandoffUntil or 0)
	if self.Open and self.Timer &gt; 0 and not blocked then
		self.Timer -= dt
		if self.Timer &lt;= 0 then
			self.Open = false
		end
	end
	self.Card.Visible = self.Open and not blocked
	self.Backdrop.Visible = self.Card.Visible
	self.Pill.Visible = not self.Open and not blocked and self.Input.Device ~= "Touch" -- touch: Respite &gt; Controls
end

function Controller.Destroy(self: ControlsCard)
	for _, cleanup in self.Cleanup do cleanup() end
	self.Card:Destroy(); self.Backdrop:Destroy(); self.Pill:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="663">
            <Properties>
              <string name="Name">CoreGuiPolicy</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/CoreGuiPolicy
-- One source for each value: the Roblox health bar duplicates the vitals plate and the player
-- list covers the objective tracker, so both are switched off. Chat, the Roblox menu (whose People
-- tab still lists players), emotes and the backpack stay as they are. Fighters tracked by the HUD
-- also lose the default overhead name/health, which EnemyBars and the boss bar replace.
local StarterGui = game:GetService("StarterGui")

local Policy = {}
Policy.Disabled = table.freeze({ Enum.CoreGuiType.Health, Enum.CoreGuiType.PlayerList })

local function setAll(enabled: boolean)
	for _, kind in Policy.Disabled do
		pcall(function() StarterGui:SetCoreGuiEnabled(kind, enabled) end)
	end
end

local function quiet(entity: any)
	local humanoid = entity.Humanoid :: Humanoid?
	if not humanoid then return end
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	if entity.Kind == "Enemy" or entity.Boss then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

-- Applies the policy and keeps it on newly tracked fighters. Returns the undo function.
function Policy.start(state: any): () -&gt; ()
	setAll(false)
	for _, entity in state.Entities do quiet(entity) end
	local stop = state:OnEntityAdded(quiet)
	return function()
		stop()
		setAll(true)
	end
end

return table.freeze(Policy)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="664">
            <Properties>
              <string name="Name">CreatureMotion</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/CreatureMotion
-- Local procedural poses for creature bosses (batches 12-13) until authored rig animations are
-- imported. Every attire piece with an AsuraJoint is turned about its hinge (AsuraPivot, a
-- fraction of the piece's size) by rewriting its Weld.C1 on this client only, so the server's
-- welds, the root and the rewound hurtboxes never move. Legs trot diagonally with ground speed,
-- the jaw opens for grabs and breath, tails sweep for the tail strike, wings beat while airborne
-- (BossMotion anchors the root in flight) and fold on the ground, and orbiting charms circle.
local Workspace = game:GetService("Workspace")

local Motion = {}
Motion.__index = Motion
Motion.Range = 260 -- studs from the camera beyond which poses rest

type Joint = { Weld: Weld, Part: BasePart, Role: string, Hinge: Vector3, Parent: Vector3? }
type Rig = { Joints: { Joint }, Gait: number, Count: number, Recheck: number }
export type Controller = typeof(setmetatable({} :: { State: any, Rigs: { [Model]: Rig }, Clock: number }, Motion))

local LEG_PHASE = { LegFL = 0, LegHR = 0, LegFR = math.pi, LegHL = math.pi }

function Motion.new(state: any): Controller
	return setmetatable({ State = state, Rigs = {}, Clock = 0 }, Motion)
end

-- Attire replicates piece by piece, so the joint list is rebuilt whenever the piece count changes.
local function collect(attire: Instance, previous: Rig?, now: number): Rig
	local children = attire:GetChildren()
	if previous and previous.Count == #children then previous.Recheck = now + 1; return previous end
	local joints: { Joint } = {}
	for _, part in children do
		local role, hinge, weld = part:GetAttribute("AsuraJoint"), part:GetAttribute("AsuraPivot"), part:FindFirstChild("AsuraBind")
		if part:IsA("BasePart") and type(role) == "string" and typeof(hinge) == "Vector3" and weld and weld:IsA("Weld") then
			local parent = part:GetAttribute("AsuraPivot2")
			table.insert(joints, { Weld = weld, Part = part, Role = role, Hinge = hinge, Parent = if typeof(parent) == "Vector3" then parent else nil })
		end
	end
	return { Joints = joints, Gait = if previous then previous.Gait else 0, Count = #children, Recheck = now + 1 }
end

-- Pure: the hinge rotation (pitch, yaw, roll in radians) for one joint role.
function Motion.angles(role: string, t: number, gait: number, stride: number, attack: string?, airborne: boolean): (number, number, number)
	local leg = LEG_PHASE[role]
	if leg then return math.sin(gait + leg) * math.rad(28) * stride, 0, 0 end
	if role == "Neck" then
		local lunge = if attack == "PerilousGrab" or attack == "Breath" then math.rad(-12) elseif attack then math.rad(-6) else 0
		return math.sin(t * 1.3) * math.rad(3) + lunge, 0, 0
	elseif role == "Jaw" then
		return if attack == "PerilousGrab" or attack == "Breath" then math.rad(28) else math.rad(3) + math.sin(t * 2.1) * math.rad(2), 0, 0
	elseif role == "Mane" then
		return 0, 0, math.sin(t * 1.7) * math.rad(4)
	elseif string.sub(role, 1, 4) == "Tail" then
		local k = tonumber(string.sub(role, 5)) or 1
		local swing = if attack == "Tail" then math.rad(34) else math.rad(8 + k * 3)
		return 0, math.sin(t * (if attack == "Tail" then 7 else 2) - k * 0.6) * swing, 0
	elseif role == "WingL" or role == "WingR" or role == "WingTipL" or role == "WingTipR" then
		local side = if string.sub(role, -1) == "L" then 1 else -1
		local tip = if string.find(role, "Tip") then 0.6 else 1 -- on top of the inner beat
		local beat = if airborne then math.sin(t * 7) * math.rad(34) else math.rad(-14) + math.sin(t * 1.4) * math.rad(3)
		return 0, 0, beat * side * tip
	elseif role == "Orbit" then
		return 0, t * math.rad(40), 0
	end
	return 0, 0, 0
end

function Motion.Update(self: Controller, dt: number)
	self.Clock += dt
	local camera = Workspace.CurrentCamera
	local eye = if camera then camera.CFrame.Position else Vector3.zero
	for _, entity in self.State.Entities do
		local model, root = entity.Model, entity.Root
		local attire = if entity.Kind == "Enemy" and root and model:GetAttribute("AsuraCostume") ~= nil then model:FindFirstChild("AsuraAttire") else nil
		if not attire or not root or (root.Position - eye).Magnitude &gt; Motion.Range then continue end
		local known = self.Rigs[model]
		if model:GetAttribute("AsuraAuthoredMotion") == true then -- an authored track owns the joints (BossAnimations)
			if known then for _, joint in known.Joints do joint.Weld.C1 = CFrame.identity end end
			self.Rigs[model] = nil
			continue
		end
		local rig: Rig = if known and self.Clock &lt; known.Recheck then known else collect(attire, known, self.Clock)
		self.Rigs[model] = rig
		if #rig.Joints == 0 then continue end
		local scale = math.max(model:GetScale(), 0.1)
		local velocity = root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude / scale
		rig.Gait += dt * speed * 0.9
		local stride = math.clamp(speed / 10, 0, 1)
		local attack = model:GetAttribute("AsuraBossAttack")
		local airborne = root.Anchored or math.abs(velocity.Y) &gt; 12
		for _, joint in rig.Joints do
			local pitch, yaw, roll = Motion.angles(joint.Role, self.Clock, rig.Gait, stride, if type(attack) == "string" then attack else nil, airborne)
			local hinge = joint.Hinge * joint.Part.Size
			local pose = CFrame.new(hinge) * CFrame.Angles(pitch, yaw, roll) * CFrame.new(-hinge)
			if joint.Parent then -- a wing tip also rides its inner wing's beat about the parent hinge
				local inner = joint.Parent * joint.Part.Size
				local p2, y2, r2 = Motion.angles(string.gsub(joint.Role, "Tip", "") :: string, self.Clock, rig.Gait, stride, nil, airborne)
				pose = CFrame.new(inner) * CFrame.Angles(p2, y2, r2) * CFrame.new(-inner) * pose
			end
			joint.Weld.C1 = pose:Inverse()
		end
	end
	for model in self.Rigs do
		if not model.Parent then self.Rigs[model] = nil end
	end
end

function Motion.Destroy(self: Controller)
	for _, rig in self.Rigs do
		for _, joint in rig.Joints do joint.Weld.C1 = CFrame.identity end
	end
	table.clear(self.Rigs)
end

return Motion
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="665">
            <Properties>
              <string name="Name">DeviceLayout</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/DeviceLayout
-- Batch 25 (#33 #35 #37 #39): places the HUD for the active device. On touch it applies the
-- HudLayout.Touch profile measured inside the device safe area (vitals in the freed bottom centre,
-- spell slots top-right above the combat buttons, objective beside the minimap, target plate and
-- boss bar in the top band, warnings between the thumbstick and the buttons) and restores the
-- authored desktop placement when a keyboard or controller takes over. It also keeps the HUD,
-- touch controls and dialogue inside notches (DeviceSafeInsets); on touch the minimap's Respite
-- blossom grows to a 44-point target and the small controls blossom gives way (Controls and the
-- Codex are Respite entries); a controller reaches Respite from the Arsenal window (Select).
-- Presentation only.
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)
local Layout = require(script.Parent:WaitForChild("HudLayout") :: ModuleScript)
local UiWindow = require(script.Parent:WaitForChild("UiWindow") :: ModuleScript)

local Device = {}
Device.__index = Device

-- Frame name in the HUD -&gt; touch rect key, whether its size follows the rect, and its UIScale base.
local MANAGED: { [string]: { Rect: string, Sized: boolean, Base: number? } } = {
	Vitals = { Rect = "Vitals", Sized = false, Base = 0.78 },
	Loadout = { Rect = "Vitals", Sized = false, Base = 0.78 },
	ObjectiveTracker = { Rect = "Objective", Sized = false },
	BossBar = { Rect = "Boss", Sized = true },
	TargetPlate = { Rect = "Target", Sized = true },
	CombatCallout = { Rect = "Callout", Sized = true },
}

type Saved = { AnchorPoint: Vector2, Position: UDim2, Size: UDim2, Min: Vector2? }

function Device.new(ui: any, input: any, extras: { ScreenGui }, arsenal: any?, pause: any?): any
	local self = setmetatable({ Ui = ui, Input = input, Saved = {} :: { [string]: Saved }, Touch = false, Links = {} }, Device) :: any
	for _, gui in { ui.Gui, table.unpack(extras) } do
		pcall(function() (gui :: any).ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets end)
	end
	local function refresh() self:Apply() end
	table.insert(self.Links, (ui.Gui :: ScreenGui):GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh))
	local previous = input.OnDeviceChanged
	input.OnDeviceChanged = function(device: string) if previous then previous(device) end; refresh() end
	self.RestoreDevice = function() input.OnDeviceChanged = previous end
	if arsenal and pause then self:MenuRoute(arsenal, pause) end
	local minimap = ui.Gui:FindFirstChild("Minimap")
	if minimap and minimap:IsA("GuiObject") then
		table.insert(self.Links, minimap:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:Blossoms(ui.Gui, self.Touch) end))
	end
	refresh()
	return self
end

local function constraint(frame: GuiObject): UISizeConstraint?
	return frame:FindFirstChildOfClass("UISizeConstraint")
end

function Device.Apply(self: any)
	self:Place(self.Input.Device == "Touch")
end

function Device.Place(self: any, touch: boolean)
	local gui = self.Ui.Gui :: ScreenGui
	local size = gui.AbsoluteSize
	self.Touch = touch
	self.Ui.TouchHud = touch -- HudVisibility: pointer-only buttons give way on touch
	self:Blossoms(gui, touch)
	if size.X &lt; 2 or size.Y &lt; 2 then return end
	local rects = Layout.touch(size.X, size.Y)
	for name, spec in MANAGED do
		local frame = gui:FindFirstChild(name)
		if not frame or not frame:IsA("GuiObject") then continue end
		local limit = constraint(frame)
		local saved = self.Saved[name]
		if not saved then
			saved = { AnchorPoint = frame.AnchorPoint, Position = frame.Position, Size = frame.Size, Min = if limit then limit.MinSize else nil }
			self.Saved[name] = saved
		end
		local scale = frame:FindFirstChildOfClass("UIScale")
		if touch then
			local r = rects[spec.Rect]
			frame.AnchorPoint, frame.Position = Vector2.zero, UDim2.fromOffset(math.floor(r.X), math.floor(r.Y))
			if spec.Sized then
				frame.Size = UDim2.fromOffset(math.floor(r.W), frame.Size.Y.Offset)
				if limit then limit.MinSize = Vector2.new(math.min(limit.MinSize.X, math.floor(r.W)), limit.MinSize.Y) end
			end
			if spec.Base then frame:SetAttribute("AsuraScaleBase", Layout.Touch.VitalsBase) end
			if scale and spec.Base then scale.Scale = Layout.Touch.VitalsBase * HudKit.factor() end
		else
			frame.AnchorPoint, frame.Position, frame.Size = saved.AnchorPoint, saved.Position, saved.Size
			if limit and saved.Min then limit.MinSize = saved.Min end
			if spec.Base then frame:SetAttribute("AsuraScaleBase", nil) end
			if scale and spec.Base then scale.Scale = spec.Base * HudKit.factor() end
		end
	end
end

-- Minimap blossoms: Respite (≡) is the touch menu button, so it gets a 44-point target there.
local TOUCH_TARGET: number = 44
local BLOSSOM_SIZE: number = 30 -- SakuraMinimap's Sakura.roundButton size
Device.TouchTarget, Device.BlossomSize = TOUCH_TARGET, BLOSSOM_SIZE
function Device.Blossoms(self: any, gui: ScreenGui, touch: boolean)
	local map = gui:FindFirstChild("Minimap")
	if not map or not map:IsA("GuiObject") then return end
	local mapScale = map:FindFirstChildOfClass("UIScale")
	local mapFactor: number = if mapScale then mapScale.Scale else 1
	local shown: number = BLOSSOM_SIZE * mapFactor -- on-screen points
	for _, b in map:GetDescendants() do
		if b:IsA("TextButton") and (b.Text == "≡" or b.Text == "?") then
			local grow = (b:FindFirstChild("TouchGrow") :: UIScale?) or (HudKit.make("UIScale", b, { Name = "TouchGrow" }) :: UIScale)
			local wanted: number = TOUCH_TARGET / shown
			grow.Scale = if touch and b.Text == "≡" then math.max(1, wanted) else 1
			b.Visible = not (touch and b.Text == "?")
		end
	end
end

-- Respite and Codex buttons in the Arsenal window: the controller's way to settings and lore.
function Device.MenuRoute(self: any, arsenal: any, pause: any)
	local body = arsenal.Window.Body :: Frame
	local hint = arsenal.Hint :: TextLabel
	hint.Size = UDim2.new(1, -236, 0, 36)
	local row = HudKit.make("Frame", body, { Name = "MenuRoute", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(228, 36), BackgroundTransparency = 1 }) :: Frame
	HudKit.make("UIListLayout", row, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder })
	local function leave() UiWindow.close(arsenal.Window) end
	local respite = UiKit.button(row, "Respite", "Secondary", function() leave(); task.defer(function() pause:Open() end) end)
	local codex = UiKit.button(row, "Codex", "Secondary", function() leave(); if self.Ui.OpenCodex then self.Ui.OpenCodex() end end)
	for order, button in { respite, codex } do
		button.LayoutOrder, button.Size = order, UDim2.fromOffset(110, 36)
	end
	self.Route = row
end

function Device.Destroy(self: any)
	for _, link in self.Links do link:Disconnect() end
	table.clear(self.Links)
	self.RestoreDevice()
	self:Place(false)
	self.Ui.TouchHud = false
	if self.Route then self.Route:Destroy() end
end

return Device
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="666">
            <Properties>
              <string name="Name">DialogueController</string>
              <string name="Source">--!strict
-- Conversations (physical NPCs and Lin's intentional altar projection) and the Codex reader.
-- Owns camera framing (PortraitCamera) and gameplay input while open and always gives both back:
-- on Leave/Escape/B, on the server ending the session, on death, on respawn and when a new
-- conversation replaces this one. Lin is summoned deliberately from the altar menu (ui.OnSummon);
-- after a farewell the player is returned to that altar menu so Travel stays one press away.
local Players=game:GetService("Players")
local UserInput=game:GetService("UserInputService")
local GuiService=game:GetService("GuiService")
local CollectionService=game:GetService("CollectionService")
local Shared=game:GetService("ReplicatedStorage").AsurasPath
local View=require(script.Parent.DialogueView)
local Kit=require(script.Parent.HudKit)
local InputMap=require(Shared.Shared.InputMap)
local Visibility=require(script.Parent.HudVisibility)
local Portrait=require(script.Parent.PortraitCamera)
-- Codex owns its InputMap key alone (weapon swap moved off it).
local CODEX_KEYS: {[Enum.KeyCode]: boolean}={}
for _,name in (InputMap.get("Codex") :: any).Keys do CODEX_KEYS[(Enum.KeyCode :: any)[name]]=true end
local Controller={};Controller.__index=Controller
-- The player's costume ignores spatial queries, so no probe sees a hat brim in an over-the-shoulder
-- shot (F04: it covered half of Lin's face): the local avatar is hidden while a portrait is framed.
local function hideAvatar(self: any,character: Model?)
 for part,original in self.Hidden or {} do if part.Parent then part.LocalTransparencyModifier=original end end
 self.Hidden=nil
 if not character then return end
 local hidden={}
 for _,d in character:GetDescendants() do if d:IsA("BasePart") then hidden[d]=d.LocalTransparencyModifier;d.LocalTransparencyModifier=1 end end
 self.Hidden=hidden
end
function Controller.new(camera: any,input: any,ui: any): any
 local self=setmetatable({Camera=camera,Input=input,UI=ui,Revision=0,Generation=0,Open=false,Links={},ReturnAltar=nil},Controller) :: any
 self.Remote=Shared.Net:WaitForChild("DialogueIntent")
 self.View=View.new(Players.LocalPlayer:WaitForChild("PlayerGui"))
 self.View.Close.Activated:Connect(function() self:Close(true) end)
 local codex=Instance.new("TextButton");codex.Name="CodexButton";codex.Text="Codex";codex.Size=UDim2.fromOffset(92,30)
 codex.Position=UDim2.new(0,14,0.55,0);codex.BackgroundColor3=Kit.Palette.Ink;codex.TextColor3=Kit.Palette.Ivory
 codex.Parent=ui.Gui;self.Codex=codex;Visibility.register(codex,"Pointer")
 local function caption()
  local key=input:Label("Codex");codex.Text=if key~="" and key~="—" then "Codex ["..key.."]" else "Codex"
  View.hint(self.View,input.Device)
 end
 caption()
 local previousDevice=input.OnDeviceChanged
 input.OnDeviceChanged=function(device: string) if previousDevice then previousDevice(device) end;caption() end
 self.RestoreDevice=function() input.OnDeviceChanged=previousDevice end
 -- The altar menu's "Summon Lady Lin" choice; the server validates the kindled altar and distance.
 ui.OnSummon=function(altarId: string) self.Remote:FireServer({action="Summon",id=altarId}) end
 -- Also opened from the Respite menu (touch, controller) through ui.OpenCodex.
 ui.OpenCodex=function() if not self.Open then self.Remote:FireServer({action="Codex"}) end end
 table.insert(self.Links,codex.Activated:Connect(function() if not input.MenuOpen then self.Remote:FireServer({action="Codex"}) end end))
 table.insert(self.Links,UserInput.InputBegan:Connect(function(key: InputObject,used: boolean)
  if used or UserInput:GetFocusedTextBox() then return end
  if CODEX_KEYS[key.KeyCode] and not input.MenuOpen and Visibility.of(ui).Guidance then self.Remote:FireServer({action="Codex"})
  -- Roblox reserves Escape for its own menu (the event arrives processed), so Backspace is the desktop back key, as in Respite.
  elseif self.Open and (key.KeyCode==Enum.KeyCode.Backspace or key.KeyCode==Enum.KeyCode.Escape or key.KeyCode==Enum.KeyCode.ButtonB) then self:Close(true) end
 end))
 -- Death and respawn always end the conversation without returning to any menu.
 local function watch(character: Model) -- one Died link at a time (batch 26: none kept per respawn)
  if self.DiedLink then self.DiedLink:Disconnect();self.DiedLink=nil end
  local humanoid=character:FindFirstChildOfClass("Humanoid")
  if humanoid then self.DiedLink=humanoid.Died:Connect(function() self:Close(false) end) end
 end
 local player=Players.LocalPlayer
 if player.Character then watch(player.Character) end
 table.insert(self.Links,player.CharacterAdded:Connect(function(character: Model) self:Close(false);watch(character) end))
 table.insert(self.Links,player.CharacterRemoving:Connect(function() self:Close(false) end))
 table.insert(self.Links,self.Remote.OnClientEvent:Connect(function(p: any) self:Receive(p) end))
 return self
end
-- toAltar: a deliberate farewell/leave reopens the altar menu Lin was summoned from.
function Controller.Close(self: any,toAltar: boolean?)
 if self.Portrait then self.Portrait:Destroy();self.Portrait=nil end
 local altar=self.ReturnAltar;self.ReturnAltar=nil
 self.Generation+=1;local wasOpen=self.Open;self.Open=false;self.UI.DialogueOpen=false;self.View.Gui.Enabled=false;self.Camera.DialogueFrame=nil;hideAvatar(self,nil)
 if wasOpen then self.Input:SetMenu(false,"Dialogue");self.Remote:FireServer({action="Close"}) end
 View.clear(self.View)
 if wasOpen and toAltar and altar and not self.UI.DeathShown then self.UI:OpenAltar(altar) end
end
function Controller.Frame(self: any,p: any)
 local character=Players.LocalPlayer.Character
 local root=character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
 local original=Portrait.speaker(p.npc,workspace:FindFirstChild("JadeCataclysm"),CollectionService:GetTagged("AsuraNPC"))
 local exclude: {Instance}={workspace.CurrentCamera}
 if character then table.insert(exclude,character) end
 if original then table.insert(exclude,original) end
 local viewer=if root then root.Position else p.point+Vector3.zAxis*8
 local probe=Portrait.probe(exclude)
 local subject=p.point+Vector3.new(0,2,0)
 if p.projection and original and original:IsA("Model") then
  local spirit=original:Clone()
  for _,child in spirit:GetDescendants() do
   if child:IsA("BasePart") then child.Transparency=0.35;child.CanCollide=false;child.CanQuery=false
   elseif child:IsA("ProximityPrompt") or child:IsA("BillboardGui") then child:Destroy() end
  end
  local spot=Portrait.spiritSpot(p.point,viewer,probe)
  spirit.Parent=workspace.CurrentCamera;spirit:PivotTo(CFrame.lookAt(spot,Vector3.new(viewer.X,spot.Y,viewer.Z)))
  self.Portrait=spirit;subject=spot+Vector3.new(0,2,0)
 end
 -- The panel covers the middle of the screen, so the face goes in the clear band between the top
 -- letterbox bar and the panel's top edge (F04: a centred head sat behind Lin's name on short screens).
 local speaker=self.Portrait or original
 local head=speaker and speaker:FindFirstChild("Head",true)
 local face=if head and head:IsA("BasePart") then head.Position else subject
 local screen=workspace.CurrentCamera.ViewportSize.Y
 local inset=if self.View.Gui.IgnoreGuiInset then 0 else GuiService:GetGuiInset().Y
 self.Camera.DialogueFrame=Portrait.aim(Portrait.choose(subject,viewer,probe),face,if screen&gt;inset then View.faceY(screen,inset) else 0.3)
 hideAvatar(self,character)
end
function Controller.Receive(self: any,p: any)
 if p.action=="Close" then self:Close(p.reason=="Farewell");return end
 if p.action=="Result" then self.UI:ShowBanner("THE INSCRIPTION",tostring(p.message),2);return end
 if p.action=="Refused" then self.UI:ShowToast(tostring(p.message));return end
 if not p.view or self.UI.DeathShown then return end
 if self.UI.Altar.Visible then self.UI:CloseAltar() end
 if self.Portrait then self.Portrait:Destroy();self.Portrait=nil end -- a replacement conversation
 self.Generation+=1;local generation=self.Generation
 if not self.Open then self.Input:SetMenu(true,"Dialogue") end
 self.Open=true;self.UI.DialogueOpen=true;self.View.Gui.Enabled=true
 if p.action=="Dialogue" then
  self.Revision=p.revision;self.ReturnAltar=p.altar
  View.render(self.View,p,function(packet: any) packet.revision=self.Revision;self.Remote:FireServer(packet) end)
  self:Frame(p)
 else self.ReturnAltar=nil;self.Camera.DialogueFrame=nil;hideAvatar(self,nil);View.codex(self.View,p.view,p.id) end
 self.View.Subtitle.MaxVisibleGraphemes=0
 local count=utf8.len(self.View.Subtitle.ContentText) or #self.View.Subtitle.Text
 task.spawn(function()
  for i=1,count do
   if generation~=self.Generation then return end
   self.View.Subtitle.MaxVisibleGraphemes=i
   if i%4==0 then Kit.cue(Kit.Sounds.Tick,0.08,0.8) end
   task.wait(0.022)
  end
 end)
 if UserInput.GamepadEnabled then GuiService.SelectedObject=self.View.Buttons[1] or self.View.Close end
end
function Controller.Destroy(self: any)
 self:Close(false);if self.DiedLink then self.DiedLink:Disconnect() end;for _,c in self.Links do c:Disconnect() end;self.RestoreDevice();self.UI.OnSummon=nil;self.UI.OpenCodex=nil;self.Codex:Destroy();self.View.Gui:Destroy()
end
return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="667">
            <Properties>
              <string name="Name">DialogueView</string>
              <string name="Source">--!strict
-- Conversation and Codex panel. Same lacquer surface, fonts and UiKit buttons as the Arsenal:
-- the speaker's name is the title, their purse/progress sits on a separate status line, choices
-- are Secondary buttons, affordable purchases Primary and unaffordable ones visibly disabled.
-- Essence is the currency; Qi only ever names the spell resource. Long lists scroll inside a
-- bounded region. Purchases lock the panel until the server answers, so one click buys once.
local Kit=require(script.Parent.HudKit)
local UiKit=require(script.Parent.UiKit)
local Shared=game:GetService("ReplicatedStorage").AsurasPath.Shared
local Catalog=require(Shared.NarrativeCatalog)
local Progress=require(Shared.ProgressionRules)
local Preview=require(Shared.LevelPreview)
local Codex=require(script.Parent.CodexView)
local Effects=require(Shared.EffectsPreference)
local View={}
View.Letterbox=0.09 -- height of each cinematic bar, as a fraction of the screen
View.PanelBottom,View.PanelHeight,View.PanelMax=0.9,0.58,Vector2.new(900,600)
-- Screen height fraction (0 = top) midway between the top bar and the panel's top edge: where a
-- speaker's face stays visible. Computed from the layout, so it holds before the panel is laid out.
function View.faceY(screen: number,inset: number): number
 local height=screen-inset
 local top=height*View.PanelBottom-math.min(height*View.PanelHeight,View.PanelMax.Y)
 return (inset+(height*View.Letterbox+top)/2)/screen
end
local T=UiKit.Theme
local PURCHASES={Level=true,Upgrade=true,Infuse=true,Trade=true}
function View.new(parent: Instance): any
 local gui=Kit.make("ScreenGui",parent,{Name="JadeDialogue",ResetOnSpawn=false,DisplayOrder=85,IgnoreGuiInset=true,Enabled=false})
 Kit.make("Frame",gui,{Size=UDim2.fromScale(1,View.Letterbox),BackgroundColor3=T.Ink,BorderSizePixel=0})
 Kit.make("Frame",gui,{Position=UDim2.fromScale(0,1-View.Letterbox),Size=UDim2.fromScale(1,View.Letterbox),BackgroundColor3=T.Ink,BorderSizePixel=0})
 local panel=Kit.panel(gui,"Dialogue",{AnchorPoint=Vector2.new(0.5,1),Position=UDim2.fromScale(0.5,View.PanelBottom),Size=UDim2.fromScale(0.9,View.PanelHeight),BackgroundColor3=T.Surface,BackgroundTransparency=0.08})
 Kit.make("UISizeConstraint",panel,{MaxSize=View.PanelMax})
 local title=Kit.label(panel,"",26,T.TitleFont,T.Gold,{Position=UDim2.fromOffset(18,6),Size=UDim2.new(1,-120,0,32),TextXAlignment=Enum.TextXAlignment.Left})
 local status=Kit.label(panel,"",15,T.BodyFont,T.Ember,{Position=UDim2.fromOffset(18,36),Size=UDim2.new(1,-120,0,18),TextXAlignment=Enum.TextXAlignment.Left})
 Kit.make("Frame",panel,{Position=UDim2.fromOffset(18,58),Size=UDim2.new(1,-36,0,1),BackgroundColor3=T.Gold,BackgroundTransparency=0.5,BorderSizePixel=0})
 local subtitle=Kit.label(panel,"",20,T.BodyFont,T.Ivory,{Position=UDim2.fromOffset(18,66),Size=UDim2.new(1,-36,0.24,0),TextWrapped=true,TextScaled=true,RichText=true,TextYAlignment=Enum.TextYAlignment.Top})
 Kit.make("UITextSizeConstraint",subtitle,{MinTextSize=13,MaxTextSize=20}) -- long lore shrinks to fit, never spills
 local list=Kit.make("ScrollingFrame",panel,{Position=UDim2.new(0,18,0.24,74),Size=UDim2.new(1,-36,0.76,-110),BackgroundTransparency=1,BorderSizePixel=0,
  ScrollBarThickness=4,ScrollBarImageColor3=T.Edge,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollingDirection=Enum.ScrollingDirection.Y})
 Kit.make("UIListLayout",list,{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
 Kit.make("UIPadding",list,{PaddingTop=UDim.new(0,2),PaddingRight=UDim.new(0,8)})
 local hint=Kit.label(panel,"",13,T.BodyFont,T.Muted,{AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,18,1,-8),Size=UDim2.new(1,-36,0,18),TextXAlignment=Enum.TextXAlignment.Left})
 local close=UiKit.button(panel,"Leave","Ghost",function() end)
 close.AnchorPoint=Vector2.new(1,0);close.Position=UDim2.new(1,-14,0,10);close.Size=UDim2.fromOffset(92,34);close.TextSize=17
 return {Gui=gui,Title=title,Status=status,Subtitle=subtitle,List=list,Hint=hint,Close=close,Buttons={},Links={},Locked=false,Enabled={},Serial=0,Order=0}
end
function View.hint(v: any,device: string)
 v.Hint.Text=if device=="Gamepad" then "[B] leave" elseif device=="Touch" then "Tap Leave to return" else "[Backspace] leave"
end
-- Reading text follows the comfort text size (batch 25): long lore still shrinks to fit.
local function readable(v: any)
 local c=v.Subtitle:FindFirstChildOfClass("UITextSizeConstraint");if not c then return end
 local s=Effects.textScale();c.MinTextSize=math.floor(13*s+0.5);c.MaxTextSize=math.floor(20*s+0.5)
end
function View.clear(v: any)
 for _,c in v.Links do c:Disconnect() end;table.clear(v.Links);table.clear(v.Buttons);table.clear(v.Enabled);v.Locked=false;v.Serial+=1;v.Order=0
 for _,child in v.List:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
end
function View.note(v: any,text: string,color: Color3)
 v.Order+=1;Kit.label(v.List,text,15,T.BodyFont,color,{Size=UDim2.new(1,-8,0,0),AutomaticSize=Enum.AutomaticSize.Y,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=v.Order})
end
function View.button(v: any,label: string,run: ()-&gt;(),variant: string?,enabled: boolean?,height: number?)
 local b=UiKit.button(v.List,label,(variant or "Secondary") :: any,run)
 b.Size=UDim2.new(1,-8,0,height or 42);b.TextSize=17;b.TextWrapped=true;v.Order+=1;b.LayoutOrder=v.Order
 if enabled==false then UiKit.setEnabled(b,false) end
 table.insert(v.Buttons,b);v.Enabled[b]=enabled~=false
end
function View.render(v: any,p: any,send: (any)-&gt;())
 readable(v)
 View.clear(v);local n=Catalog.NPCs[p.npc];local node=n.Nodes[p.node];local data=p.view
 local function buy(packet: any): ()-&gt;()
  return function()
   if v.Locked then return end -- one purchase per server answer; render() unlocks
   if PURCHASES[packet.action] then
    v.Locked=true;local serial=v.Serial;for _,b in v.Buttons do UiKit.setEnabled(b,false) end
    task.delay(1.5,function() -- no answer (refused packet): give the choices back
     if v.Serial==serial and v.Locked then v.Locked=false;for b,on in v.Enabled do UiKit.setEnabled(b,on) end end
    end)
   end
   send(packet)
  end
 end
 v.Title.Text=n.Name..(if p.projection then "  ·  spirit projection" else "")
 v.Status.Text=tostring(data.qi).." Essence"..(if p.npc=="Lin" then "  ·  "..data.sovereigns.."/6 souls at rest" else "")
 v.Subtitle.Text=if p.message then tostring(p.message).."\n"..node.Text else node.Text
 if p.panel=="Level" then
  local affordable,quote=Preview.quote(data.qi,data.cost)
  View.note(v,"Level "..Progress.level(data.attributes).." → "..(Progress.level(data.attributes)+1).."  ·  "..quote,if affordable then T.Gold else T.Muted)
  for _,id in Progress.Attributes do
   local value=data.attributes[id];local open=affordable and value&lt;Preview.Max
   View.button(v,Preview.Labels[id].." "..value.." → "..(value+1).."\n"..Preview.line(data.attributes,id,data.tier or 0),
    buy({action="Level",id=id}),if open then "Primary" else "Secondary",open,58)
  end
 elseif p.panel=="Forge" then
  local id=data.loadout.MainWeapon;local w=data.inventory.Weapons[id];local cost,ore,count=Progress.upgradeCost(w.Level)
  View.note(v,id.." +"..w.Level.."  ·  Mastery "..Progress.masteryRank(data.mastery[id] or 0).."  ·  "..(w.Infusion or "Uninfused"),T.Ivory)
  if w.Level&lt;10 then
   local have=data.inventory.Materials[ore] or 0
   View.button(v,"Reinforce · "..cost.." Essence + "..count.." "..Catalog.Trades[ore].Name.." ("..have.." owned)",buy({action="Upgrade"}),nil,data.qi&gt;=cost and have&gt;=count)
  end
  for _,affinity in {"CrimsonFire","CelestialLightning","AbyssalVoid"} do
   local gem=Progress.Infusions[affinity];local have=data.inventory.Materials[gem] or 0
   View.button(v,"Infuse "..string.gsub(Catalog.Trades[gem].Name," Gem$","").." · 300 Essence + 1 gem ("..have.." owned)",buy({action="Infuse",id=affinity}),nil,data.qi&gt;=300 and have&gt;=1)
  end
 elseif p.panel=="Trade" then
  local ids={};for id in Catalog.Trades do table.insert(ids,id) end;table.sort(ids)
  for _,id in ids do local t=Catalog.Trades[id];View.button(v,t.Name.." · "..t.Price.." Essence",buy({action="Trade",id=id}),nil,data.qi&gt;=t.Price) end
 end
 for index,c in node.Choices do View.button(v,c.Label,buy({action="Choose",index=index})) end
end
-- Codex: progress, instruction and sections from CodexView; only discovered entries open.
function View.codex(v: any,data: any,selected: string?)
 readable(v)
 View.clear(v)
 Codex.render(v,data,selected,{button=View.button,note=View.note,reopen=function(id: string) View.codex(v,data,id) end,Gold=T.Gold,Muted=T.Muted,Ivory=T.Ivory})
end
return table.freeze(View)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="668">
            <Properties>
              <string name="Name">DuoBars</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/DuoBars
-- Multi-actor boss encounters (the Twin Sentinels): instead of one merged bar under three
-- overlapping names, each member gets its own row in the boss plate (sigil, name, health with its
-- recoverable layer, posture, status) and a matching overhead tag. Sigils are shapes, so the
-- pairing never relies on colour; row order follows the server's member list and never reshuffles.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Kit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local InputMap = require(Shared:WaitForChild("Shared"):WaitForChild("InputMap") :: ModuleScript)

local Duo = {}
local C = Sakura.Colors
Duo.Sigils = table.freeze({ "◆", "▲", "■", "●" })
Duo.Replaced = table.freeze({ "Casing", "Health", "Posture", "HonoraryTitle" }) -- merged boss-bar parts

export type Row = {
	Id: number, Sigil: string, Root: Frame, Name: TextLabel, Status: TextLabel, Fill: Frame, Recover: Frame,
	Posture: Frame, Stroke: UIStroke, Tag: BillboardGui?,
}
export type View = { Frame: Frame, Gui: ScreenGui, Root: Frame, Hint: TextLabel, Rows: { Row } }

function Duo.new(frame: Frame, gui: ScreenGui): View
	local root = Kit.make("Frame", frame, { Name = "DuoStrip", Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1, Visible = false }) :: Frame
	local hint = Kit.label(frame, "", 13, Kit.BodyFont, Kit.Palette.Muted, { Name = "DuoHint", Position = UDim2.fromOffset(0, 94), Size = UDim2.new(1, 0, 0, 16), Visible = false })
	return { Frame = frame, Gui = gui, Root = root, Hint = hint, Rows = {} }
end

local function setReplaced(view: View, visible: boolean)
	for _, name in Duo.Replaced do
		local child = view.Frame:FindFirstChild(name)
		if child and child:IsA("GuiObject") then child.Visible = visible end
	end
end

function Duo.clear(view: View)
	for _, row in view.Rows do
		if row.Tag then row.Tag:Destroy() end
		row.Root:Destroy()
	end
	table.clear(view.Rows)
	view.Root.Visible, view.Hint.Visible = false, false
	setReplaced(view, true)
end

-- Builds one row per member; returns false (and leaves the merged bar) for a single boss.
function Duo.bind(view: View, members: { number }, lockKey: string): boolean
	Duo.clear(view)
	if #members &lt; 2 then return false end
	local share = 1 / #members
	for i, id in members do
		local row = Kit.make("Frame", view.Root, { Name = "Member" .. i, Position = UDim2.new(share * (i - 1), if i &gt; 1 then 10 else 0, 0, 0),
			Size = UDim2.new(share, -10, 1, 0), BackgroundColor3 = C.Ink, BackgroundTransparency = 0.35, BorderSizePixel = 0 }) :: Frame
		local stroke = Kit.make("UIStroke", row, { Color = C.Gold, Thickness = 1, Transparency = 0.6 }) :: UIStroke
		local sigil = Duo.Sigils[(i - 1) % #Duo.Sigils + 1]
		local name = Kit.label(row, "", 17, Enum.Font.Garamond, C.Ivory, { Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -96, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.3 })
		local status = Kit.label(row, "", 12, Enum.Font.GothamBold, C.Gold, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.fromOffset(84, 16), TextXAlignment = Enum.TextXAlignment.Right })
		local track = Kit.make("Frame", row, { Position = UDim2.fromOffset(8, 26), Size = UDim2.new(1, -16, 0, 12), BackgroundColor3 = C.Track, BorderSizePixel = 0 }) :: Frame
		local recover = Kit.make("Frame", track, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Kit.Palette.Ember, BorderSizePixel = 0 }) :: Frame
		local fill = Kit.make("Frame", track, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Crimson, BorderSizePixel = 0 }) :: Frame
		local postureTrack = Kit.make("Frame", row, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44), Size = UDim2.new(0.7, 0, 0, 5), BackgroundColor3 = C.Ink, BorderSizePixel = 0 }) :: Frame
		local posture = Kit.make("Frame", postureTrack, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Gold, BorderSizePixel = 0 }) :: Frame
		table.insert(view.Rows, { Id = id, Sigil = sigil, Root = row, Name = name, Status = status, Fill = fill, Recover = recover, Posture = posture, Stroke = stroke, Tag = nil })
	end
	view.Hint.Text = if lockKey ~= "" then string.format("[%s] lock a foe · flick to switch", lockKey) else "lock a foe · flick to switch"
	view.Root.Visible, view.Hint.Visible = true, true
	setReplaced(view, false)
	return true
end

-- Overhead tag matching the row: sigil + name above the actor's head.
local function tag(view: View, row: Row, entity: any): BillboardGui
	local height = entity.Model:GetExtentsSize().Y
	local billboard = Kit.make("BillboardGui", view.Gui, { Name = "DuoTag", Adornee = entity.Root, Size = UDim2.fromOffset(180, 26),
		StudsOffsetWorldSpace = Vector3.new(0, height * 0.55 + 1, 0), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 140, ResetOnSpawn = false }) :: BillboardGui
	Kit.label(billboard, row.Sigil .. "  " .. string.upper(entity.Name), 16, Enum.Font.Garamond, C.Ivory, { Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0.15 })
	return billboard
end

function Duo.update(view: View, state: any, locked: any?, hidden: boolean)
	for _, row in view.Rows do
		local entity = state:Get(row.Id)
		local s = entity and entity.Snapshot
		if not entity or not s then continue end
		row.Name.Text = row.Sigil .. "  " .. entity.Name
		if not row.Tag and entity.Root then row.Tag = tag(view, row, entity) end
		local maximum = math.max(s.MaxHP, 1)
		local fallen = s.State == "KO"
		row.Fill.Size = UDim2.fromScale(if fallen then 0 else math.clamp(s.ActiveHP / maximum, 0, 1), 1)
		row.Recover.Size = UDim2.fromScale(if fallen then 0 else math.clamp((s.ActiveHP + s.RecoverableHP) / maximum, 0, 1), 1)
		local broken = s.State == "StanceBroken"
		row.Posture.Size = UDim2.fromScale(if broken then 1 else math.clamp(s.Posture / math.max(s.PostureCapacity, 1), 0, 1), 1)
		row.Posture.BackgroundColor3 = if broken then C.Ivory else C.Gold
		local target = entity == locked
		row.Status.Text = if fallen then "FALLEN" elseif broken then "BROKEN" elseif target then "◎ TARGET" else ""
		row.Stroke.Transparency, row.Stroke.Thickness = if target then 0 else 0.6, if target then 2 else 1
		row.Root.BackgroundTransparency = if fallen then 0.7 else 0.35
		if row.Tag then row.Tag.Enabled = not hidden and not fallen end
	end
end

function Duo.lockKey(device: string): string
	return if device == "Touch" then "LOCK" else InputMap.label("Lock", device)
end

return table.freeze(Duo)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="669">
            <Properties>
              <string name="Name">EncounterHandoffController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/EncounterHandoffController
-- Client half of the boss-entry contract (BossHandoff, #16). An entry, metamorphosis or oath cue
-- that carries a `shot` frames the boss for exactly that long while the server holds this player
-- locked and protected; combat input is closed for the shot (the guard is released so client and
-- server agree). Any key, button or the Skip pill ends the shot here and sends the Skip intent, so
-- the server ends the lock at the same moment. Reset, leaving, victory and death restore the
-- follow camera and input immediately.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local InputMap = require(Shared.Shared.InputMap)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)

local Controller = {}
Controller.__index = Controller
local SHOTS = { BossIntro = true, BossPhase = true, BossEnrage = true }
local ENDS = { BossReset = true, BossDefeated = true }

function Controller.new(state: any, camera: any, input: any, ui: any, send: (string) -&gt; ()): any
	local self = setmetatable({ State = state, Camera = camera, Input = input, Ui = ui, Send = send, Active = false,
		Blocked = false, Links = {}, PreviousCommand = input.OnCommand }, Controller)
	local pill = UiKit.button(ui.Gui, "Skip ›", "Ghost", function() self:Skip() end)
	pill.Name, pill.AnchorPoint, pill.Position, pill.Size, pill.Visible = "HandoffSkip", Vector2.new(1, 1), UDim2.new(1, -24, 1, -24), UDim2.fromOffset(150, 34), false
	self.Pill = pill
	input.OnCommand = function(command: string)
		if self.Active and command ~= "Cursor" then self:Skip() end
		if self.PreviousCommand then self.PreviousCommand(command) end
	end
	table.insert(self.Links, state:OnCue(function(cue: any) self:OnCue(cue) end))
	return self
end

function Controller.Involved(self: any, data: any): boolean
	local own = self.State.LocalId
	if type(data.participants) == "table" and table.find(data.participants, own) then return true end
	return data.boss ~= nil and Players.LocalPlayer:GetAttribute("AsuraEncounter") == data.boss
end

function Controller.OnCue(self: any, cue: any)
	local data = cue.Data or {}
	if SHOTS[cue.Kind] and type(data.shot) == "number" and self:Involved(data) then
		self.Camera:BossShot(cue.Source, data.shot)
		self.Active = true
		if not self.Blocked then self.Blocked = true; self.Input:SetMenu(true, "Handoff") end
		self.Pill.Text = "Skip ›  " .. self:Key()
		self.Pill.Visible = true
	elseif self.Active and (ENDS[cue.Kind] or (cue.Kind == "BossParticipantLeft" and cue.Source == self.State.LocalId)) then
		self:Finish(true)
	end
end

function Controller.Key(self: any): string
	local key = self.Input:Label("Interact")
	return if key ~= "" then "[" .. key .. "]" else "[" .. InputMap.label("Interact", "Touch") .. "]"
end

function Controller.Skip(self: any)
	if not self.Active then return end
	self.Send("Skip")
	self:Finish(true)
end

-- Restores the follow camera and combat input; `cut` ends the shot now.
function Controller.Finish(self: any, cut: boolean)
	if cut then self.Camera:EndBossShot() end
	self.Active = false
	self.Pill.Visible = false
	if self.Blocked then
		self.Blocked = false
		self.Input:SetMenu(false, "Handoff")
	end
end

function Controller.Update(self: any)
	if not self.Active then return end
	local own = self.State:Own()
	local dead = own and own.Snapshot and own.Snapshot.State == "KO"
	if dead or self.Camera.BossShotState == nil then self:Finish(dead == true) end
end

function Controller.Destroy(self: any)
	if self.Active then self:Finish(true) end
	self.Input.OnCommand = self.PreviousCommand
	for _, unlink in self.Links do unlink() end
	self.Pill:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="670">
            <Properties>
              <string name="Name">EndingController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/EndingController
-- The crossing (batch 22, #10). Plays EndingRules.Scene after the server has recorded a Cross
-- choice (so nothing here can lose or duplicate progress): three letterboxed Sanctuary shots, the
-- completion card, concise credits from EndingCredits and the return line. Stepped from the frame
-- loop, so skip and interruption are immediate: the first skip jumps to the completion card, a second
-- ends it; death, respawn or leaving the character stops it. Every exit restores the camera, input,
-- HUD flag and destroys the overlay (Stop is idempotent). Remain shows a banner only.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage").AsurasPath
local Ending = require(Shared.Shared.EndingRules) :: any
local Credits = require(Shared.Shared.EndingCredits) :: any
local Effects = require(Shared.Shared.EffectsPreference) :: any
local HudKit = require(script.Parent.HudKit)

local P = HudKit.Palette
local VEIL = Color3.fromRGB(12, 24, 20) -- deep jade ink: the dawn beyond the river
local FADE = 0.8

local Controller = {}
Controller.__index = Controller

function Controller.new(camera: any, input: any, ui: any): any
	local self = setmetatable({ Camera = camera, Input = input, Ui = ui, Active = false, Links = {}, Index = 0, Elapsed = 0, Clock = 0 }, Controller) :: any
	local remote = Shared.Net:WaitForChild("DialogueIntent") :: RemoteEvent
	table.insert(self.Links, remote.OnClientEvent:Connect(function(p: any)
		if type(p) ~= "table" or p.action ~= "Ending" then return end
		if p.choice == "Cross" then
			self:Play()
		else
			ui:ShowBanner("YOU REMAIN", "Their names walk with you · Lady Lin opens the crossing whenever you return to her bonfire", 5)
		end
	end))
	local player = Players.LocalPlayer
	-- One link at a time, never one kept per respawn. The client can see the character before its Humanoid
	-- replicates, so wait for it (Studio F21: a death mid-scene played the crossing over the death screen).
	local function watch(character: Model)
		if self.DiedLink then self.DiedLink:Disconnect(); self.DiedLink = nil end
		local function link(humanoid: Humanoid)
			self.DiedLink = humanoid.Died:Connect(function() self:Stop("Interrupted") end)
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then link(humanoid); return end
		self.DiedLink = character.ChildAdded:Connect(function(child: Instance)
			if child:IsA("Humanoid") then
				self.DiedLink:Disconnect()
				link(child)
			end
		end)
	end
	if player.Character then watch(player.Character) end
	table.insert(self.Links, player.CharacterAdded:Connect(function(character: Model) self:Stop("Interrupted"); watch(character) end))
	table.insert(self.Links, player.CharacterRemoving:Connect(function() self:Stop("Interrupted") end))
	return self
end

function Controller.Play(self: any)
	local ui = self.Ui
	if self.Active or ui.PrologueActive or ui.DeathShown then return end
	self.Active, self.Index, self.Elapsed, self.Clock = true, 1, 0, 0
	ui.EndingActive = true
	self.Input:SetMenu(true, "Ending")
	local gui = HudKit.make("ScreenGui", Players.LocalPlayer:WaitForChild("PlayerGui"), { Name = "AsuraCrossing", IgnoreGuiInset = true, DisplayOrder = 61, ResetOnSpawn = false })
	self.Gui = gui
	self.Veil = HudKit.make("Frame", gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = VEIL, BackgroundTransparency = 1, BorderSizePixel = 0 })
	for edge = 0, 1 do
		HudKit.make("Frame", gui, { AnchorPoint = Vector2.new(0, edge), Position = UDim2.fromScale(0, edge), Size = UDim2.fromScale(1, 0.1), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 0 })
	end
	-- The Respite text size reaches the crossing's lines and credits too (Studio F24: only dialogue
	-- used it); the subtitle keeps a firm stroke over the pale colossus (Studio F21).
	local scale = Effects.textScale()
	local function px(n: number): number return math.floor(n * scale + 0.5) end
	self.Line = HudKit.label(gui, "", px(30), HudKit.TitleFont, P.Ivory, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.8), Size = UDim2.new(0.84, 0, 0, px(40)), TextScaled = true, TextWrapped = true, TextTransparency = 1, TextStrokeTransparency = 0.6 })
	HudKit.make("UITextSizeConstraint", self.Line, { MinTextSize = px(16), MaxTextSize = px(30) })
	self.Sub = HudKit.label(gui, "", px(18), HudKit.BodyFont, P.Ember, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.8, 6), Size = UDim2.new(0.84, 0, 0, px(44)), TextWrapped = true, TextTransparency = 1, TextStrokeTransparency = 0.3 })
	self.Roll = HudKit.label(gui, Credits.Title .. "\n\n" .. table.concat(Credits.lines(), "\n") .. "\n\n" .. Credits.Closing, px(15), HudKit.BodyFont, P.Ivory,
		{ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.2), Size = UDim2.fromScale(0.8, 0.62), TextScaled = true, TextWrapped = true, TextTransparency = 1, Visible = false })
	HudKit.make("UITextSizeConstraint", self.Roll, { MinTextSize = px(11), MaxTextSize = px(16) })
	local skipText = if UserInputService.GamepadEnabled then "Any button skips" else "Any key or tap skips"
	HudKit.label(gui, skipText, 14, HudKit.BodyFont, P.Muted, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -12), Size = UDim2.fromOffset(260, 20), TextXAlignment = Enum.TextXAlignment.Right })
	self.SkipLink = UserInputService.InputBegan:Connect(function(event: InputObject)
		local t = event.UserInputType
		local counts = t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 or string.sub(t.Name, 1, 7) == "Gamepad"
		if counts and self.Clock &gt;= Ending.SkipGuard then self:Skip() end
	end)
	self:Draw(Ending.Scene[1])
end

function Controller.Skip(self: any)
	if not self.Active then return end
	if self.Index &lt; Ending.CardBeat then
		self.Index, self.Elapsed = Ending.CardBeat, 0
		self:Draw(Ending.Scene[self.Index])
	else
		self:Stop("Skipped")
	end
end

function Controller.Draw(self: any, beat: any)
	local reduced = Effects.reducedMotion()
	local at, look = Ending.frame(beat, self.Elapsed, reduced)
	if at and look then self.Camera.DialogueFrame = CFrame.lookAt(at, look) end
	local t = self.Elapsed
	local fade = math.clamp(math.min(t, beat.Duration - t) / FADE, 0, 1)
	local overlay = beat.Kind ~= "Shot"
	local veil = if overlay then 0 else 1
	if not overlay and self.Index == Ending.CardBeat - 1 then -- the last shot dissolves into the dawn
		veil = 1 - math.clamp((t - (beat.Duration - 1.2)) / 1.2, 0, 1)
	end
	self.Veil.BackgroundTransparency = veil
	self.Line.Text, self.Sub.Text = beat.Line, beat.Sub
	local y = if beat.Kind == "Credits" then 0.18 elseif overlay then 0.48 else 0.8
	self.Line.Position, self.Sub.Position = UDim2.fromScale(0.5, y), UDim2.new(0.5, 0, y, 6)
	self.Line.TextTransparency, self.Sub.TextTransparency = 1 - fade, 1 - fade
	self.Roll.Visible = beat.Kind == "Credits"
	self.Roll.TextTransparency = 1 - fade
end

function Controller.Update(self: any, dt: number)
	if not self.Active then return end
	self.Clock += dt
	self.Elapsed += dt
	local beat = Ending.Scene[self.Index]
	if self.Elapsed &gt;= beat.Duration then
		self.Index, self.Elapsed = self.Index + 1, 0
		if self.Index &gt; #Ending.Scene then
			self:Stop("Finished")
			return
		end
		beat = Ending.Scene[self.Index]
	end
	self:Draw(beat)
end

-- reason: "Finished" | "Skipped" | "Interrupted" | "Destroyed". Safe to call at any time.
function Controller.Stop(self: any, reason: string)
	if not self.Active then return end
	self.Active = false
	if self.SkipLink then self.SkipLink:Disconnect(); self.SkipLink = nil end
	if self.Gui then self.Gui:Destroy(); self.Gui = nil end
	self.Camera.DialogueFrame = nil
	self.Input:SetMenu(false, "Ending")
	self.Ui.EndingActive = false
	local final = Ending.Scene[#Ending.Scene]
	if reason == "Interrupted" then
		self.Ui:ShowBanner("THE CROSSING IS RECORDED", "Lady Lin can walk it with you again at the Primal Bonfire", 4)
	elseif reason ~= "Destroyed" then
		self.Ui:ShowBanner(final.Line, final.Sub, 5)
	end
end

function Controller.Destroy(self: any)
	self:Stop("Destroyed")
	if self.DiedLink then self.DiedLink:Disconnect(); self.DiedLink = nil end
	for _, link in self.Links do link:Disconnect() end
	table.clear(self.Links)
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="671">
            <Properties>
              <string name="Name">EnemyBars</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/EnemyBars
-- Overhead plate for every nearby hostile (NPCs and duel opponents; bosses use the top boss bar):
-- name, a crimson health bar with a pale trail showing recent damage, and a gold posture bar that
-- grows from the centre. Above it, the enemy's incoming attack: an icon of the attack type and a
-- ring that closes on the icon at the moment of impact. When the ring turns gold, press Parry.
-- Unblockable (perilous) attacks show a red "!" and tell you to dodge instead.
local Workspace = game:GetService("Workspace")
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local Plate = require(script.Parent:WaitForChild("EnemyPlate") :: ModuleScript)
local PlateLayout = require(script.Parent:WaitForChild("PlateLayout") :: ModuleScript)

local Bars = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local SHOW_RANGE = 60 -- studs; locked targets always show
local TRAIL_SPEED = 0.6 -- health fraction per second the damage trail drains

export type View = { Gui: ScreenGui, State: any, Plates: { [any]: Plate.Plate } }

function Bars.new(gui: ScreenGui, state: any): View
	return { Gui = gui, State = state, Plates = {} }
end

-- Boss-style cues carry a counter hint ("Double Jump", "Slide Dash"...) for perilous attacks.
function Bars.cue(view: View, entity: any, data: { [string]: any })
	local plate = view.Plates[entity]
	if plate and type(data.impact) == "number" then
		local now = Workspace:GetServerTimeNow()
		plate.Class, plate.Start, plate.Impact = tostring(data.class or "Heavy"), now, data.impact
		plate.Counter = if type(data.counter) == "string" then data.counter else nil
	end
end

-- `focus` is the foe shown on the top TargetPlate; its overhead plate keeps only the warning.
function Bars.step(view: View, dt: number, locked: any?, focus: any?)
	local state = view.State
	local own = state:Own()
	local origin = own and own.Root and own.Root.Position
	local now = Workspace:GetServerTimeNow()
	local camera = Workspace.CurrentCamera
	local seen: { [any]: boolean } = {}
	local candidates: { PlateLayout.Candidate } = {}
	for _, entity in state.Entities do
		local snapshot = entity.Snapshot
		if entity ~= own and not entity.Boss and entity.Root and snapshot and state:IsAlive(entity) and state:IsHostile(entity) and origin then
			local distance = (entity.Root.Position - origin).Magnitude
			if distance &lt;= SHOW_RANGE or entity == locked then
				seen[entity] = true
				local plate = view.Plates[entity] or Plate.build(view.Gui, entity, SHOW_RANGE)
				view.Plates[entity] = plate
				plate.Gui.Adornee = entity.Root
				local ratio = math.clamp(snapshot.ActiveHP / math.max(snapshot.MaxHP, 1), 0, 1)
				plate.Trailing = if plate.Trailing &gt; ratio then math.max(ratio, plate.Trailing - TRAIL_SPEED * dt) else ratio
				plate.Fill.Size = UDim2.fromScale(ratio, 1)
				plate.Trail.Size = UDim2.fromScale(plate.Trailing, 1)
				local p = math.clamp(snapshot.Posture / math.max(snapshot.PostureCapacity, 1), 0, 1)
				local broken = snapshot.State == "StanceBroken"
				plate.Posture.Size = UDim2.fromScale(if broken then 1 else p, 1)
				plate.Posture.BackgroundColor3 = if broken and (os.clock() * 6) % 2 &lt; 1 then C.Ivory elseif p &gt; 0.8 then C.Crimson else C.Gold
				plate.Name.TextColor3 = if entity == locked then C.Gold else C.Ivory
				Plate.telegraph(plate, entity.Model, now)
				local point = if camera then camera:WorldToViewportPoint(entity.Root.Position + Vector3.yAxis * 3.4) else Vector3.zero
				table.insert(candidates, { Id = entity.Id, X = point.X, Y = point.Y, Distance = distance, Focus = entity == focus, Warning = Plate.warning(plate, now) })
			end
		end
	end
	local placements = PlateLayout.arrange(candidates)
	for entity, plate in view.Plates do
		local placement = placements[entity.Id]
		if placement then Plate.mode(plate, placement.Mode, placement.Lift) end
		if not seen[entity] then
			plate.Gui:Destroy()
			view.Plates[entity] = nil
		end
	end
end

function Bars.destroy(view: View)
	for _, plate in view.Plates do plate.Gui:Destroy() end
	table.clear(view.Plates)
end

return table.freeze(Bars)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="672">
            <Properties>
              <string name="Name">EnemyDissolve</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/EnemyDissolve
-- Authored enemy death (batch 09). When the server pins a fallen enemy (AsuraDissolve attribute;
-- its parts no longer collide or answer queries and its joints stay intact), the body folds
-- forward over its feet, then burns away into drifting ash while a gold Essence wisp rises from it
-- as the reward pulse. Local presentation only; the server removes the model afterwards
-- (Settings.Respawn.EnemyCorpseTime), and plates/lock already drop because IsAlive treats a
-- dissolving body as dead.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)

local Dissolve = {}
Dissolve.__index = Dissolve
Dissolve.Collapse = 0.85 -- seconds to fold forward
Dissolve.Fade = 1.3 -- seconds to burn away once down
Dissolve.Pitch = math.rad(-78) -- negative pitches toward the body's LookVector
Dissolve.Sink = 0.4
Dissolve.Roll = math.rad(80)
local ASH = Color3.fromRGB(58, 40, 40)
local ESSENCE = Color3.fromRGB(244, 196, 91)

-- Pure: the root's pose `t` (0..1) into the collapse, rotating about the feet so the body falls
-- forward onto the ground instead of sinking through it. `hip` is root height above the feet.
-- Four-legged creatures (AsuraRig "Creature") topple onto their side instead of pitching forward.
function Dissolve.pose(base: CFrame, t: number, hip: number, creature: boolean?): CFrame
	local e = 1 - (1 - math.clamp(t, 0, 1)) ^ 3
	local fall = if creature then CFrame.Angles(0, 0, Dissolve.Roll * e) else CFrame.Angles(Dissolve.Pitch * e, 0, 0)
	return base * CFrame.new(0, -hip, 0) * fall * CFrame.new(0, hip * (if creature then 0.35 else 1) - Dissolve.Sink * e, 0)
end

export type Controller = typeof(setmetatable({} :: { State: any, Playing: { [Model]: { Started: number, Base: CFrame, Hip: number, Faded: boolean, Creature: boolean } } }, Dissolve))

function Dissolve.new(state: any): Controller
	return setmetatable({ State = state, Playing = {} }, Dissolve)
end

local function emitAsh(root: BasePart)
	local e = Instance.new("ParticleEmitter")
	e.Name, e.Texture, e.Rate = "DissolveAsh", if Assets.Textures.Ash ~= "" then Assets.Textures.Ash else Assets.Textures.Smoke, 0
	e.Lifetime, e.Speed, e.SpreadAngle = NumberRange.new(0.8, 1.6), NumberRange.new(1, 3), Vector2.new(180, 180)
	e.Color, e.LightEmission, e.Acceleration = ColorSequence.new(ASH, Color3.fromRGB(150, 40, 36)), 0.2, Vector3.new(0, 3, 0)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1.4) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = root
	e:Emit(26)
end

-- The reward pulse: a small gold wisp that climbs and fades where the foe fell.
local function wisp(at: Vector3)
	local p = Instance.new("Part")
	p.Name, p.Shape, p.Size, p.Material, p.Color = "EssenceWisp", Enum.PartType.Ball, Vector3.one * 0.6, Enum.Material.Neon, ESSENCE
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Position, p.Parent = at, workspace
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Parent = ESSENCE, 10, 2, p
	TweenService:Create(p, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = at + Vector3.new(0, 5, 0), Transparency = 1, Size = Vector3.one * 0.2 }):Play()
	TweenService:Create(light, TweenInfo.new(1.1), { Brightness = 0 }):Play()
	Debris:AddItem(p, 1.2)
end

local function fade(model: Model, seconds: number)
	local info = TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		elseif d:IsA("Decal") then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
			(d :: any).Enabled = false
		end
	end
end

function Dissolve.Update(self: Controller, _dt: number)
	local now = os.clock()
	for _, entity in self.State.Entities do
		local model, root = entity.Model, entity.Root
		if entity.Kind == "Enemy" and root and not self.Playing[model] and model.Parent and model:GetAttribute("AsuraDissolve") ~= nil then
			local humanoid = entity.Humanoid
			local hip = if humanoid then humanoid.HipHeight + root.Size.Y * 0.5 else 3
			self.Playing[model] = { Started = now, Base = root.CFrame, Hip = hip, Faded = false, Creature = model:GetAttribute("AsuraRig") == "Creature" }
			emitAsh(root)
		end
	end
	for model, play in self.Playing do
		local root = model.Parent and model:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			self.Playing[model] = nil
			continue
		end
		local t = (now - play.Started) / Dissolve.Collapse
		root.CFrame = Dissolve.pose(play.Base, t, play.Hip, play.Creature)
		if t &gt;= 1 and not play.Faded then
			play.Faded = true
			fade(model, Dissolve.Fade)
			emitAsh(root)
			wisp(root.Position)
		end
	end
end

function Dissolve.Destroy(self: Controller)
	table.clear(self.Playing)
end

return Dissolve
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="673">
            <Properties>
              <string name="Name">EnemyPlate</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/EnemyPlate
-- One overhead enemy plate for EnemyBars: attack warning (icon + closing ring + cue text), name,
-- health bar with damage trail and diamond caps, and a centre-out posture bar.
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local Icons = require(script.Parent:WaitForChild("MoveIcons") :: ModuleScript)

local Plate = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local HEIGHT = 3.4 -- studs above the root part
local WIDTH = 150 -- health bar width (px)
local PARRY_WINDOW = 0.22 -- seconds before impact the ring turns gold
local CLASS_TEXT: { [string]: string } = { Light = "SLASH", Heavy = "HEAVY", Perilous = "PERILOUS" }

export type Plate = {
	Gui: BillboardGui, Name: TextLabel, Fill: Frame, Trail: Frame, Posture: Frame, Track: Frame, PostureTrack: Frame, Warn: Frame, Ring: Frame, RingStroke: UIStroke,
	Cue: TextLabel, Icon: CanvasGroup?, IconKind: string, Trailing: number, Raw: string, Class: string, Start: number, Impact: number, Counter: string?,
}

function Plate.build(gui: ScreenGui, entity: any, range: number): Plate
	local billboard = HudKit.make("BillboardGui", gui, {
		Name = "EnemyPlate", Size = UDim2.fromOffset(WIDTH + 30, 78), StudsOffsetWorldSpace = Vector3.new(0, HEIGHT, 0),
		AlwaysOnTop = true, LightInfluence = 0, MaxDistance = range * 1.5, ResetOnSpawn = false, Adornee = entity.Root,
	}) :: BillboardGui
	local warn = HudKit.make("Frame", billboard, {
		Name = "Warn", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 17), Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = C.Ink, BackgroundTransparency = 0.1, Visible = false,
	}) :: Frame
	HudKit.make("UICorner", warn, { CornerRadius = UDim.new(1, 0) })
	local ring = HudKit.make("Frame", warn, {
		Name = "Ring", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
	}) :: Frame
	HudKit.make("UICorner", ring, { CornerRadius = UDim.new(1, 0) })
	local ringStroke = HudKit.make("UIStroke", ring, { Color = C.Ivory, Thickness = 2 }) :: UIStroke
	local cue = HudKit.label(billboard, "", 13, Enum.Font.GothamBold, C.Ivory, {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 20, 0, 17), Size = UDim2.fromOffset(90, 16),
		TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.2, Visible = false,
	})
	local name = HudKit.label(billboard, entity.Name, 14, Enum.Font.Garamond, C.Ivory, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 34), Size = UDim2.fromOffset(WIDTH, 15), TextStrokeTransparency = 0.25,
	})
	local track = HudKit.make("Frame", billboard, {
		Name = "Health", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 51), Size = UDim2.fromOffset(WIDTH, 9),
		BackgroundColor3 = C.Track, BorderSizePixel = 0,
	}) :: Frame
	HudKit.make("UIStroke", track, { Color = C.Ink, Thickness = 1.5 })
	local trail = HudKit.make("Frame", track, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Blossom, BorderSizePixel = 0 }) :: Frame
	local fill = HudKit.make("Frame", track, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Crimson, BorderSizePixel = 0 }) :: Frame
	HudKit.make("UIGradient", fill, { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 120, 130), Color3.fromRGB(140, 10, 26)) })
	for _, x in { 0, 1 } do Sakura.diamond(track, 10, UDim2.fromScale(x, 0.5), C.Gold, C.Ink) end
	local postureTrack = HudKit.make("Frame", billboard, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 65), Size = UDim2.fromOffset(WIDTH * 0.75, 4),
		BackgroundColor3 = C.Ink, BackgroundTransparency = 0.3, BorderSizePixel = 0,
	}) :: Frame
	local posture = HudKit.make("Frame", postureTrack, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Gold, BorderSizePixel = 0,
	}) :: Frame
	return {
		Gui = billboard, Name = name, Fill = fill, Trail = trail, Posture = posture, Track = track, PostureTrack = postureTrack, Warn = warn, Ring = ring, RingStroke = ringStroke,
		Cue = cue, Icon = nil, IconKind = "", Trailing = 1, Raw = "", Class = "", Start = 0, Impact = 0, Counter = nil,
	}
end

-- Applies a PlateLayout placement. Focus keeps only the warning (the TargetPlate shows the rest);
-- Compact drops the name; `lift` (screen pixels) raises the plate clear of a neighbour.
function Plate.mode(plate: Plate, mode: string, lift: number)
	plate.Gui.Enabled = mode ~= "Hidden"
	plate.Name.Visible = mode == "Full"
	plate.Track.Visible = mode == "Full" or mode == "Compact"
	plate.PostureTrack.Visible = plate.Track.Visible
	plate.Gui.SizeOffset = Vector2.new(0, lift / plate.Gui.Size.Y.Offset) -- +Y raises the plate
end

-- True while an attack warning is (or is about to be) on screen.
function Plate.warning(plate: Plate, now: number): boolean
	local remaining = plate.Impact - now
	return remaining &gt; -0.12 and remaining &lt; 3
end

-- Reads the NPC's published attack ("class|move|impactTime") and animates the warning ring.
function Plate.telegraph(plate: Plate, model: Model, now: number)
	local raw = model:GetAttribute("AsuraTelegraph")
	if type(raw) == "string" and raw ~= plate.Raw then
		plate.Raw = raw
		local class, _, impact = string.match(raw, "^(%a+)|([^|]*)|([%d%.]+)$")
		if class and tonumber(impact) then
			plate.Class, plate.Start, plate.Impact, plate.Counter = class, now, tonumber(impact) :: number, nil
		end
	end
	local remaining = plate.Impact - now
	local shown = Plate.warning(plate, now)
	plate.Warn.Visible, plate.Cue.Visible = shown, shown
	if not shown then return end
	local perilous = plate.Class == "Perilous"
	local kind = if perilous then "Perilous" elseif plate.Class == "Heavy" then "Heavy" else "Light"
	if kind ~= plate.IconKind then
		if plate.Icon then (plate.Icon :: CanvasGroup):Destroy() end
		plate.Icon = if perilous then nil else Icons.draw(plate.Warn, kind, 28)
		plate.IconKind = kind
		plate.Warn.BackgroundColor3 = if perilous then C.Crimson else C.Ink
		local bang = plate.Warn:FindFirstChild("Bang")
		if perilous and not bang then
			HudKit.label(plate.Warn, "!", 22, Enum.Font.GothamBlack, C.Ivory, { Name = "Bang", Size = UDim2.fromScale(1, 1), ZIndex = 4 })
		elseif bang and not perilous then
			bang:Destroy()
		end
	end
	local lead = math.max(plate.Impact - plate.Start, 0.05)
	local closing = math.clamp(remaining / lead, 0, 1)
	plate.Ring.Size = UDim2.fromScale(1 + closing * 1.6, 1 + closing * 1.6)
	local window = remaining &lt;= PARRY_WINDOW
	plate.RingStroke.Color = if window then C.Gold elseif perilous then C.Crimson else C.Ivory
	plate.RingStroke.Thickness = if window then 3 else 2
	if perilous then
		plate.Cue.Text = string.upper(plate.Counter or "Dodge") .. "!"
		plate.Cue.TextColor3 = C.Crimson
	else
		plate.Cue.Text = if window then "PARRY!" else CLASS_TEXT[plate.Class] or "ATTACK"
		plate.Cue.TextColor3 = if window then C.Gold else C.Ivory
	end
end

return table.freeze(Plate)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="674">
            <Properties>
              <string name="Name">EnvironmentController</string>
              <string name="Source">--!strict
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Profiles = require(Shared.Shared.EnvironmentProfiles)
local Assets = require(Shared.Shared.PresentationAssets)
local World = require(Shared.Shared.WorldDefinitions)
local Ash = require(script.Parent.ArenaAsh)
local Controller = {}
Controller.__index = Controller

function Controller.new(state: any): any
	local self = setmetatable({ State = state, Key = "", Elapsed = 1, Phase = 1, Boss = "", Tweens = {} }, Controller)
	self.Ash = Ash.new()
	self.Sky = {}
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if sky then for _, face in {"Bk","Dn","Ft","Lf","Rt","Up"} do self.Sky[face] = (sky :: any)["Skybox"..face] end end
	self.Disconnect = state:OnCue(function(cue: any)
		if cue.Kind == "BossPhase" and Players.LocalPlayer:GetAttribute("AsuraEncounter") == cue.Data.boss then
			self.Phase = math.max(self.Phase, tonumber(cue.Data.phase) or 1)
		end
	end)
	return self
end
function Controller.Update(self: any, dt: number)
	local actor = self.State:Own()
	self.Ash:Update(dt,if actor and actor.Root then actor.Root.Position else nil,self.Key)
	self.Elapsed += dt
	if self.Elapsed &lt; 0.2 then return end
	self.Elapsed = 0
	local own = self.State:Own()
	if not own or not own.Root then return end
	local boss = Players.LocalPlayer:GetAttribute("AsuraEncounter") or ""
	if boss ~= self.Boss then self.Boss, self.Phase = boss, 1 end
	for _, e in self.State.Entities do
		if boss ~= "" and e.Model:GetAttribute("AsuraEncounter") == boss then
			self.Phase = math.max(self.Phase, tonumber(e.Model:GetAttribute("AsuraBossPhase")) or 1)
		end
	end
	local p = own.Root.Position
	local reported = Players.LocalPlayer:GetAttribute("AsuraRegion")
	local region = World.regionAt(p.X, p.Y, p.Z) or (if type(reported)=="string" then reported else nil)
	local alive = own.Snapshot == nil or own.Snapshot.State ~= "KO"
	-- The fight takes its look from the boss arena's biome, never one shared night profile.
	local definition = if boss ~= "" then World.Bosses[boss] else nil
	local arena = if definition then definition.Region else nil
	local key = Profiles.resolve(region, boss ~= "" and alive, self.Phase, arena)
	if key == self.Key then return end
	self.Key = key
	for _, tween in self.Tweens do tween:Cancel() end
	table.clear(self.Tweens)
	for _, light in CollectionService:GetTagged("AsuraArenaLight") do
		local tween=TweenService:Create(light,TweenInfo.new(1.8),{Color=if Profiles.isUnbound(key) then Profiles.UnboundBrazier else Profiles.arena(arena).Brazier})
		table.insert(self.Tweens,tween);tween:Play()
	end
	for name, values in Profiles.get(key) do
		local target = if name == "Lighting" then Lighting else Lighting:FindFirstChild(name)
		if target then
			local tween = TweenService:Create(target, TweenInfo.new(2.4, Enum.EasingStyle.Sine), values)
			table.insert(self.Tweens, tween); tween:Play()
		end
	end
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if sky then
		local kind = Profiles.skyFor(key)
		local night = kind == "Night"
		sky.CelestialBodiesShown = not night
		sky.StarCount = if sky.CelestialBodiesShown then 500 else 0
		local set = if night then Assets.Sky elseif kind == "Sunset" then Assets.SunsetSky else nil
		for face, suffix in {Back="Bk",Down="Dn",Front="Ft",Left="Lf",Right="Rt",Up="Up"} do
			local id = if set then set[face] else nil
			local value=if id and id~="" then id else self.Sky[suffix]
			if value then (sky :: any)["Skybox"..suffix]=value end
		end
	end
end
function Controller.Destroy(self: any)
	self.Disconnect()
	self.Ash:Destroy()
	for _, tween in self.Tweens do tween:Cancel() end
end
return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="675">
            <Properties>
              <string name="Name">FireCanvas</string>
              <string name="Source">--!strict
-- 2D layers of the Blazing Sun blast (the fire itself is FireStorm, in 3D): the caster's crimson
-- silhouette with white-hot eyes burning through it, the yellow-to-crimson wash and the soft dark
-- orange frame with the sun's disc. Caster only; reduced flashes lets the world show through.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Effects = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Kit = require(script.Parent.SkillKit)
local Screen = require(script.Parent.ImpactFrame)
local Canvas = {}

local rgb = Color3.fromRGB

local function gui(trove: Kit.Trove, order: number): (ScreenGui?, Vector2)
	local player, camera = Players.LocalPlayer, Workspace.CurrentCamera
	if not player or not camera then return nil, Vector2.zero end
	local g = Kit.add(trove, Instance.new("ScreenGui"))
	g.Name, g.IgnoreGuiInset, g.DisplayOrder, g.ResetOnSpawn = "AsuraFireCanvas", true, order, false
	g.Parent = player:FindFirstChildOfClass("PlayerGui")
	return g, camera.ViewportSize
end

local function shape(parent: Instance, z: number): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel, f.AnchorPoint, f.ZIndex = 0, Vector2.new(0.5, 0.5), z
	local c = Instance.new("UICorner")
	c.Parent = f
	f.Parent = parent
	return f
end


-- The caster as a dark crimson silhouette with two white-hot eyes burning through the blast, drawn
-- exactly where they stand for `seconds` (over the 3D firestorm).
function Canvas.emerge(trove: Kit.Trove, model: Model, seconds: number)
	local g = gui(trove, 59)
	local camera = Workspace.CurrentCamera
	local head = model:FindFirstChild("Head")
	if not g or not camera or not head or not head:IsA("BasePart") then return end
	local layer = Instance.new("Frame")
	layer.Size, layer.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	layer.Parent = g
	Screen.silhouette(layer, model, camera.CFrame, camera.FieldOfView, rgb(120, 14, 6), 1, 7, true)
	local s = head.Size
	for _, side in { -1, 1 } do
		local at = camera:WorldToViewportPoint((head.CFrame * CFrame.new(side * s.X * 0.22, s.Y * 0.08, -s.Z * 0.5)).Position)
		for n, spec in { { rgb(255, 210, 80), 0.05, 0.35 }, { Color3.new(1, 1, 1), 0.022, 0 } } do
			local eye = shape(layer, 8 + n)
			eye.Position, eye.Size = UDim2.fromOffset(at.X, at.Y), UDim2.fromOffset(camera.ViewportSize.Y * spec[2], camera.ViewportSize.Y * spec[2] * 0.8)
			eye.BackgroundColor3, eye.BackgroundTransparency = spec[1], spec[3]
			eye:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
		end
	end
	Kit.tween(trove, layer, seconds, { BackgroundTransparency = 1 })
	Kit.after(trove, seconds, function() g:Destroy() end)
end

-- Yellow-to-crimson gradient wash over `seconds`, sliding as it fades.
function Canvas.wash(trove: Kit.Trove, seconds: number)
	local g = gui(trove, 58)
	if not g then return end
	local f = shape(g, 1)
	f.Position, f.Size, f.BackgroundColor3 = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1.4, 1), Color3.new(1, 1, 1)
	f.BackgroundTransparency = if Effects.reducedFlashes() then 0.5 else 0
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, rgb(255, 236, 70)), ColorSequenceKeypoint.new(0.45, rgb(255, 150, 30)), ColorSequenceKeypoint.new(1, rgb(200, 45, 12)) })
	grad.Parent = f
	Kit.tween(trove, f, seconds, { Position = UDim2.fromScale(0.35, 0.5), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Kit.after(trove, seconds, function() g:Destroy() end)
end

-- Dark orange frame with a yellow sun disc breaking in from the corner and darker silhouette lobes.
function Canvas.sunFrame(trove: Kit.Trove, seconds: number)
	local g, size = gui(trove, 58)
	if not g then return end
	local back = shape(g, 1)
	back.Position, back.Size, back.BackgroundColor3 = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1), rgb(165, 70, 12)
	back:FindFirstChildOfClass("UICorner"):Destroy()
	-- Every shape is stacked in widening, fading copies: a cheap blur, as the reference frame is soft.
	local function soft(color: Color3, x: number, y: number, w: number, h: number, rotation: number, z: number)
		for k, fade in { 0, 0.5, 0.72, 0.86 } do
			local f = shape(back, z)
			local grow = 1 + (k - 1) * 0.09
			f.Position, f.Size, f.Rotation = UDim2.fromScale(x, y), UDim2.fromOffset(w * grow, h * grow), rotation
			f.BackgroundColor3, f.BackgroundTransparency = color, fade
			f:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
		end
	end
	soft(rgb(255, 196, 60), 0.16, 0.2, size.Y * 0.5, size.Y * 0.3, -35, 2)
	for n, lobe in { { 0.55, 0.62, 0.62 }, { 0.2, 0.95, 0.5 }, { 0.88, 0.9, 0.45 } } do
		soft(rgb(130 - n * 10, 50, 8), lobe[1], lobe[2], size.Y * lobe[3], size.Y * lobe[3] * 1.1, 0, 3)
	end
	Kit.tween(trove, back, seconds, { BackgroundTransparency = 0.3 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Kit.after(trove, seconds, function() g:Destroy() end)
end

return table.freeze(Canvas)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="676">
            <Properties>
              <string name="Name">FireStorm</string>
              <string name="Source">--!strict
-- The Blazing Sun blast as the reference shows it: the camera is inside the explosion. Glowing flame
-- puffs and spark streaks boil up a few studs in front of the lens, flame particles roar through,
-- and a blur pass plus a hot solarized grade soften it into the smeared, blown-out look of the clip.
-- Heat starts white-hot and cools to orange and crimson; the storm thins and pales as it burns out.
-- Caster only; reduced flashes keeps the fire but drops the blow-out.
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Effects = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Kit = require(script.Parent.SkillKit)
local Storm = {}

local rgb = Color3.fromRGB
local HOT = { rgb(255, 252, 225), rgb(255, 240, 120), rgb(255, 214, 60) }
local BODY = { rgb(255, 160, 40), rgb(250, 115, 25), rgb(225, 70, 20), rgb(160, 30, 10), rgb(60, 12, 4) }

type Puff = { Part: BasePart, X: number, Y: number, Depth: number, Speed: number, Size: number }

local function pick(list: { Color3 }): Color3 return list[math.random(1, #list)] end

local function respawn(p: Puff, heat: number, bottom: boolean)
	p.X, p.Y = (math.random() - 0.5) * 2.2, if bottom then -1.3 - math.random() * 0.4 else (math.random() - 0.5) * 2.4
	p.Depth, p.Speed, p.Size = 4 + math.random() * 4, 1.2 + math.random() * 2.2, 1.8 + math.random() * 3.8
	p.Part.Color = if math.random() &lt; 0.15 + heat * 0.7 then pick(HOT) else pick(BODY)
end

-- `seconds` of storm around `camera`. Returns nothing; everything leaves with `trove`.
function Storm.engulf(trove: Kit.Trove, seconds: number)
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local folder = Kit.folder(trove, "BlazingSunStorm")
	local puffs: { Puff } = {}
	for n = 1, 34 do
		local part = Kit.part(folder, "FlamePuff", HOT[1], Vector3.one, CFrame.identity, Enum.PartType.Ball)
		local p: Puff = { Part = part, X = 0, Y = 0, Depth = 5, Speed = 1, Size = 1 }
		respawn(p, 1, false)
		puffs[n] = p
	end
	local sparks: { BasePart } = {}
	for n = 1, 18 do sparks[n] = Kit.part(folder, "SparkStreak", if n % 3 == 0 then HOT[1] else HOT[2], Vector3.new(0.05, 0.05, 2), CFrame.identity) end
	-- Most of the storm is soft flame-texture particles pouring up through a sheet just past the lens,
	-- over dark crimson smoke that gives the fire its holes and depth (the neon puffs only add heat).
	local roar = Kit.part(folder, "StormSheet", HOT[2], Vector3.new(18, 12, 3), CFrame.identity)
	roar.Transparency = 1
	local flames = Kit.emitter(roar, { Texture = Assets.Textures.Flame, Color = ColorSequence.new(HOT[1], HOT[3]), Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(0.4, 7), NumberSequenceKeypoint.new(1, 4) }), Rate = 260,
		Lifetime = NumberRange.new(0.35, 0.7), Speed = NumberRange.new(5, 11), Spread = 25, Accel = Vector3.new(0, 14, 0), Light = 1,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.2, 0.05), NumberSequenceKeypoint.new(1, 1) }) })
	flames.Shape, flames.EmissionDirection = Enum.ParticleEmitterShape.Box, Enum.NormalId.Top
	local smoke = Kit.emitter(roar, { Texture = Assets.Textures.Smoke, Color = ColorSequence.new(rgb(150, 34, 10), rgb(40, 8, 2)), Size = NumberSequence.new(4, 9), Rate = 30,
		Lifetime = NumberRange.new(0.6, 1.1), Speed = NumberRange.new(3, 6), Spread = 30, Accel = Vector3.new(0, 6, 0), Light = 0,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.25), NumberSequenceKeypoint.new(1, 1) }) })
	smoke.Shape, smoke.EmissionDirection = Enum.ParticleEmitterShape.Box, Enum.NormalId.Top
	local tint = 0
	local blur = Kit.add(trove, Instance.new("BlurEffect"))
	blur.Name, blur.Size, blur.Parent = "AsuraSkillStormBlur", 9, Lighting
	local grade = Kit.add(trove, Instance.new("ColorCorrectionEffect"))
	grade.Name, grade.Parent = "AsuraSkillStormGrade", Lighting
	local blowout = if Effects.reducedFlashes() then 0.15 else 0.45
	local start = os.clock()
	local name = "AsuraSkillStorm" .. math.random(1, 1e6)
	Kit.add(trove, function() RunService:UnbindFromRenderStep(name) end)
	-- After the cinema director (Camera + 5) so the storm sits on this frame's camera, never a frame late.
	RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 6, function(dt: number)
		local t = os.clock() - start
		local heat = math.clamp(1 - t / (seconds * 0.55), 0, 1)
		local fade = math.clamp((t - seconds * 0.6) / (seconds * 0.4), 0, 1)
		local view = camera.CFrame
		local parts: { BasePart } = {}
		local frames: { CFrame } = {}
		for _, p in puffs do
			p.Y += p.Speed * dt
			if p.Y &gt; 1.4 then respawn(p, heat, true) end
			local wobble = math.sin(t * 6 + p.Depth * 3) * 0.08
			local scale = p.Depth * math.tan(math.rad(camera.FieldOfView / 2))
			local size = p.Size * (0.75 + 0.25 * math.sin(t * 9 + p.X * 5))
			p.Part.Size = Vector3.new(size, size * 1.35, size * 0.6)
			p.Part.Transparency = 0.2 + fade * 0.75
			table.insert(parts, p.Part)
			table.insert(frames, view * CFrame.new((p.X + wobble) * scale * 1.7, p.Y * scale, -p.Depth))
		end
		for n, s in sparks do
			local seed = n * 13.7 + math.floor(t * 12 + n) * 0.37
			local x, y = (math.noise(seed, 1) * 2) * 3, (math.noise(seed, 2) * 2) * 2
			table.insert(parts, s)
			table.insert(frames, view * CFrame.new(x, y, -3 - (n % 4)) * CFrame.Angles(math.rad(90 + math.noise(seed, 3) * 50), 0, math.rad(math.noise(seed, 4) * 40)))
			s.Transparency = fade
		end
		table.insert(parts, roar)
		table.insert(frames, view * CFrame.new(0, -3, -6))
		tint += dt
		if tint &gt; 0.1 then -- the particles cool with the heat and thin as the storm burns out
			tint = 0
			flames.Color = if heat &gt; 0.5 then ColorSequence.new(HOT[1], HOT[3]) else ColorSequence.new(HOT[3], BODY[3])
			flames.Rate, smoke.Rate = 260 * (1 - fade), 30 * (1 - fade) + 10 * (1 - heat)
		end
		Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		blur.Size = 9 * (1 - fade * 0.7)
		grade.Brightness = blowout * heat
		grade.Contrast = 0.35 + 0.2 * heat
		grade.Saturation = 0.35 - fade * 0.6
		grade.TintColor = Color3.new(1, 0.9 + 0.08 * heat, 0.72 + 0.2 * heat)
	end)
	Kit.after(trove, seconds, function()
		RunService:UnbindFromRenderStep(name)
		folder:Destroy()
		blur:Destroy()
		grade:Destroy()
	end)
end

return table.freeze(Storm)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="677">
            <Properties>
              <string name="Name">FlameForms</string>
              <string name="Source">--!strict
-- Procedural fire for Blazing Sun Awakening: tension embers, dual-layer flame gauntlets, blazing
-- eye starbursts with trailing jets, the ground fire shockwave and recurring heat rings.
local RunService = game:GetService("RunService")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Kit = require(script.Parent.SkillKit)
local Flame = {}

Flame.Core = Color3.fromRGB(251, 252, 29)
Flame.Body = Color3.fromRGB(255, 69, 0)
Flame.Coal = Color3.fromRGB(225, 112, 81)
Flame.Amber = Color3.fromRGB(200, 162, 106)
Flame.Heat = Color3.fromRGB(255, 106, 0)
Flame.Plasma = Color3.fromRGB(255, 245, 157)

local function seq(a: Color3, b: Color3): ColorSequence return ColorSequence.new(a, b) end
local function sizes(a: number, b: number): NumberSequence return NumberSequence.new(a, b) end

-- Subtle heat embers rising off clenched fists during the stance.
function Flame.embers(trove: Kit.Trove, hand: BasePart)
	local a = Kit.attach(trove, hand, Vector3.zero, "SunEmbers")
	Kit.emitter(a, { Texture = Assets.Textures.Ember, Color = seq(Flame.Heat, Flame.Amber), Size = sizes(0.18, 0.04), Rate = 16,
		Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(1, 2.5), Spread = 35, Accel = Vector3.new(0, 5, 0) })
	local light = Kit.light(a, Flame.Heat, 6, 0.8)
	local seed = math.random() * 50
	Kit.add(trove, RunService.Heartbeat:Connect(function()
		light.Brightness = 0.8 + math.noise(seed, os.clock() * 9) * 0.9
	end))
end

-- Core plasma plus flickering outer flame spirals, and a breathing orange light.
function Flame.gauntlet(trove: Kit.Trove, hand: BasePart)
	local a = Kit.attach(trove, hand, Vector3.zero, "SunGauntlet")
	Kit.emitter(a, { Color = seq(Flame.Plasma, Flame.Core), Size = sizes(0.9, 0.2), Rate = 40, Lifetime = NumberRange.new(0.18, 0.3),
		Speed = NumberRange.new(0.5, 1.5), Spread = 180, Accel = Vector3.new(0, 4, 0) })
	Kit.emitter(a, { Color = seq(Flame.Body, Flame.Coal), Size = sizes(1.5, 0.3), Rate = 55, Lifetime = NumberRange.new(0.35, 0.55),
		Speed = NumberRange.new(1, 3), Spread = 180, Accel = Vector3.new(0, 9, 0), Drag = 2, Spin = NumberRange.new(-260, 260),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(0.6, 0.5), NumberSequenceKeypoint.new(1, 1) }) })
	local light = Kit.light(a, Flame.Body, 11, 2)
	local seed = math.random() * 50
	Kit.add(trove, RunService.Heartbeat:Connect(function()
		light.Brightness = 2 + math.noise(seed, os.clock() * 7) * 1.6
	end))
end

local function spikes(parent: Instance, count: number, length: number, color: Color3): Frame
	local holder = Instance.new("Frame")
	holder.Size, holder.AnchorPoint, holder.Position, holder.BackgroundTransparency = UDim2.fromScale(1, 1), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), 1
	for n = 1, count do
		local spike = Instance.new("Frame")
		spike.AnchorPoint, spike.Position, spike.BackgroundColor3, spike.BorderSizePixel = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), color, 0
		spike.Size, spike.Rotation = UDim2.fromScale(length, 0.04), (n / count) * 180
		local fade = Instance.new("UIGradient")
		fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
		fade.Parent = spike
		spike.Parent = holder
	end
	holder.Parent = parent
	return holder
end

-- Radiating 4-point and 6-point starbursts on both eyes, flame jets streaming back, micro-sparks.
function Flame.eyes(trove: Kit.Trove, head: BasePart)
	local s = head.Size
	local bursts: { Frame } = {}
	for _, side in { -1, 1 } do
		local a = Kit.attach(trove, head, Vector3.new(side * s.X * 0.17, s.Y * 0.1, -s.Z * 0.5), "BlazingEye")
		local gui = Kit.add(trove, Instance.new("BillboardGui"))
		-- Sized to the eye: the gaze shot frames the face from ~2 studs, where a 2.2-stud burst became
		-- flat panels across the whole screen.
		gui.Adornee, gui.Size, gui.LightInfluence, gui.AlwaysOnTop = a, UDim2.fromScale(0.9, 0.9), 0, false
		table.insert(bursts, spikes(gui, 2, 1, Flame.Plasma))
		table.insert(bursts, spikes(gui, 3, 0.6, Flame.Heat))
		gui.Parent = a
		local jet = Kit.emitter(a, { Color = seq(Flame.Core, Flame.Body), Size = sizes(0.35, 0.05), Rate = 45, Lifetime = NumberRange.new(0.2, 0.35),
			Speed = NumberRange.new(5, 8), Spread = 12, Accel = Vector3.new(0, 3, 0) })
		jet.EmissionDirection = Enum.NormalId.Back
		local sparks = Kit.emitter(a, { Texture = Assets.Textures.Ember, Color = seq(Flame.Plasma, Flame.Heat), Size = sizes(0.08, 0.02),
			Rate = 30, Lifetime = NumberRange.new(0.15, 0.4), Speed = NumberRange.new(4, 9), Spread = 70 })
		sparks.EmissionDirection = Enum.NormalId.Back
		Kit.light(a, Flame.Core, 5, 3)
	end
	Kit.add(trove, RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for n, holder in bursts do
			holder.Rotation = t * (if n % 2 == 0 then -140 else 90)
			local pulse = 1 + math.noise(n * 3.1, t * 12) * 0.35
			holder.Size = UDim2.fromScale(pulse, pulse)
		end
	end))
end

-- Expanding ground fire rings and a burst of flying embers.
function Flame.shockwave(trove: Kit.Trove, folder: Instance, floor: CFrame)
	Kit.shockwave(trove, folder, floor, Flame.Core, 18, 0.45, 0.05)
	Kit.shockwave(trove, folder, floor, Flame.Body, 32, 0.8, 0.2)
	Kit.after(trove, 0.1, function() Kit.shockwave(trove, folder, floor, Flame.Coal, 24, 0.9, 0.45) end)
	local anchor = Kit.part(folder, "SunEmberBurst", Flame.Body, Vector3.one * 0.2, floor)
	anchor.Transparency = 1
	local burst = Kit.emitter(anchor, { Texture = Assets.Textures.Ember, Color = seq(Flame.Plasma, Flame.Body), Size = sizes(0.3, 0.05), Rate = 0,
		Lifetime = NumberRange.new(0.6, 1.2), Speed = NumberRange.new(22, 40), Spread = 75, Accel = Vector3.new(0, -30, 0), Drag = 1.5 })
	burst:Emit(70)
end

-- Recurring heat ring while the stance burns.
function Flame.heat(trove: Kit.Trove, folder: Instance, floor: CFrame)
	Kit.shockwave(trove, folder, floor, Flame.Heat, 14, 0.8, 0.35)
	Kit.after(trove, 0.08, function() Kit.shockwave(trove, folder, floor, Flame.Core, 9, 0.5, 0.55) end)
end

return table.freeze(Flame)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="678">
            <Properties>
              <string name="Name">GameFeelController</string>
              <string name="Source">--!strict
-- Authoritative events drive presentation; damage and timing stay on the server.
local Players = game:GetService("Players")
local Audio = require(script.Parent.SpatialAudio)
local Vfx = require(script.Parent.CombatVfx)
local Feedback = require(script.Parent.CombatFeedback)
local Trails = require(script.Parent.WeaponTrails)
local Dissolve = require(script.Parent.EnemyDissolve)
local Controller = {}
Controller.__index = Controller
export type GameFeel = any
function Controller.new(state: any, camera: any): GameFeel
 local folder = Instance.new("Folder"); folder.Name, folder.Parent = "AsuraFeel", workspace
 local self = setmetatable({State=state, Camera=camera, Folder=folder, Vfx=Vfx.new(folder),
  Feedback=Feedback.new(state,camera), Trails=Trails.new(state), Dissolve=Dissolve.new(state), Disconnects={}}, Controller)
 table.insert(self.Disconnects,state:OnEvent(function(event: any) self:OnEvent(event) end))
 table.insert(self.Disconnects,state:OnCue(function(cue: any) self:OnCue(cue) end))
 return self
end
function Controller.OnEvent(self: GameFeel, event: any)
 local source,target,own = self.State:Get(event.Source),self.State:Get(event.Target),self.State:Own()
 local point = event.Point or (if target and target.Root then target.Root.Position else nil)
 if not point or not own or not own.Root or (point-own.Root.Position).Magnitude&gt;70 then return end
 local direction = if source and source.Root and target and target.Root then target.Root.Position-source.Root.Position else Vector3.yAxis
 if direction.Magnitude&gt;0.1 then direction=direction.Unit end
 local kind=event.Kind
 if kind=="Whiff" and source and source.Root and (event.Source==own.Id or event.Target==own.Id) then
  -- The swing's true reach is already drawn from the server's committed strike (WeaponTrails), so
  -- a miss reads as distance there; ContactCues words the gap in the callouts.
  Audio.at("Wind",point,0.25)
 elseif kind=="DeflectSpark" then
  self.Vfx:burst(point,direction+Vector3.yAxis*0.5,Color3.fromRGB(255,173,65),math.random(25,40),55)
  self.Vfx:ring(point,direction,Color3.fromRGB(255,200,105),4)
  Audio.at("Clash",point,0.85); Audio.at("ParryBass",point,0.65)
 elseif kind=="Block" or kind=="GuardBreak" or kind=="StanceBreak" then
  self.Vfx:burst(point,-direction,Color3.fromRGB(247,196,127),if kind=="Block" then 12 else 30,34)
  Audio.at("Clash",point,if kind=="Block" then 0.5 else 0.9)
 elseif kind=="Hit" or kind=="CounterHit" or kind=="Armored" or kind=="BleedProc" or kind=="Deathblow" then
  local weapon=if source and source.Snapshot then source.Snapshot.Weapon else ""
  local stone=weapon=="CalamityBoneCleaver" or (source and source.Model:FindFirstChild("ColossalWarhammer",true)~=nil)
  if stone or weapon=="Unarmed" or kind=="Armored" then
   self.Vfx:burst(point,direction,Color3.fromRGB(192,173,142),22,26)
   Audio.at(if stone then "Stone" elseif kind=="Armored" then "Clash" else "Blunt",point,0.75)
  else
   local excludes: {Instance}={}
   if source then table.insert(excludes,source.Model) end
   if target then table.insert(excludes,target.Model) end
   self.Vfx:blood(point,direction,excludes); Audio.at("Flesh",point,0.7)
  end
 end
 self.Feedback:Event(event,direction)
end
function Controller.OnCue(self: GameFeel, cue: any)
 local own=self.State:Own()
 if not own or not own.Root then return end
 if cue.Kind=="Shockwave" then
  local d=cue.Data; local at=Vector3.new(tonumber(d.x) or 0,tonumber(d.y) or 0,tonumber(d.z) or 0)
  local radius=tonumber(d.radius) or 16
  local strength=math.clamp(1.2-(own.Root.Position-at).Magnitude/(radius*2.5),0,1)
  if strength&lt;=0 then return end
  self.Camera:Impulse(own.Root.Position-at,strength,4*strength)
  self.Vfx:ring(at,Vector3.yAxis,Color3.fromRGB(237,93,44),math.min(radius,24))
  local excludes: {Instance}={own.Model}
  local source=self.State:Get(cue.Source);if source then table.insert(excludes,source.Model) end
  self.Vfx:rupture(at,own.Root.Position-at,excludes); Audio.at("Stone",at,0.9)
 elseif cue.Kind=="BossPhase" and Players.LocalPlayer:GetAttribute("AsuraEncounter")==cue.Data.boss then
  self.Camera:Impulse(Vector3.yAxis,0.7,-5)
 end
end
function Controller.Update(self: GameFeel,dt: number)
 self.Feedback:Update(dt); self.Vfx:Update(dt); self.Trails:Update(dt); self.Dissolve:Update(dt)
end
function Controller.Destroy(self: GameFeel)
 for _,disconnect in self.Disconnects do disconnect() end
 self.Feedback:Destroy();self.Trails:Destroy();self.Dissolve:Destroy();self.Vfx:Destroy();self.Folder:Destroy()
end
return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="679">
            <Properties>
              <string name="Name">HudKit</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/HudKit
-- Shared presentation kit for HUD modules: the ink-and-ivory palette, instance helpers, a
-- viewport-driven UIScale binding (so panels authored at 1080p shrink on phones and grow on large
-- displays) and a one-shot UI cue sound. Pure presentation; never talks to the server.
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")

local HudKit = {}

HudKit.Palette = table.freeze({ -- sakura theme; SakuraKit.Colors holds the full set
	Ink = Color3.fromRGB(22, 10, 20),
	Ivory = Color3.fromRGB(255, 240, 246),
	Muted = Color3.fromRGB(190, 156, 176),
	Blood = Color3.fromRGB(196, 22, 38),
	Ember = Color3.fromRGB(247, 168, 200),
	Gold = Color3.fromRGB(236, 196, 120),
	Edge = Color3.fromRGB(150, 60, 110),
})

HudKit.TitleFont = Enum.Font.Antique
HudKit.BodyFont = Enum.Font.Garamond

-- Reference viewport height the HUD was authored against, and the factor clamp. The floor keeps
-- text legible on landscape phones (~360 px tall); the ceiling stops panels ballooning on TVs.
local REFERENCE_HEIGHT = 900
local MIN_FACTOR = 0.7
local MAX_FACTOR = 1.35

function HudKit.make(className: string, parent: Instance?, properties: { [string]: any }): any
	local instance = Instance.new(className :: any)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function HudKit.label(parent: Instance, text: string, size: number, font: Enum.Font, color: Color3, properties: { [string]: any }?): TextLabel
	local result = HudKit.make("TextLabel", parent, {
		Text = text,
		TextSize = size,
		Font = font,
		TextColor3 = color,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = HudKit.Palette.Ink,
	}) :: TextLabel
	for key, value in properties or {} do
		(result :: any)[key] = value
	end
	return result
end

-- Ink panel with the house red edge, matching the altar menu and loadout styling.
function HudKit.panel(parent: Instance, name: string, properties: { [string]: any }): Frame
	local frame = HudKit.make("Frame", parent, {
		Name = name,
		BackgroundColor3 = HudKit.Palette.Ink,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	}) :: Frame
	for key, value in properties do
		(frame :: any)[key] = value
	end
	HudKit.make("UICorner", frame, { CornerRadius = UDim.new(0, 6) })
	HudKit.make("UIStroke", frame, { Color = HudKit.Palette.Edge, Thickness = 1, Transparency = 0.2 })
	return frame
end

function HudKit.factor(): number
	local camera = Workspace.CurrentCamera
	local height = if camera then camera.ViewportSize.Y else REFERENCE_HEIGHT
	if height &lt;= 1 then
		return 1
	end
	return math.clamp(height / REFERENCE_HEIGHT, MIN_FACTOR, MAX_FACTOR)
end

-- Calls `refresh(viewportSize)` now and whenever the viewport resizes or the camera is replaced.
-- Returns a disconnect function.
function HudKit.onViewport(refresh: (Vector2) -&gt; ()): () -&gt; ()
	local viewportConnection: RBXScriptConnection? = nil
	local function watch()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
		local camera = Workspace.CurrentCamera
		viewportConnection = if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			refresh(camera.ViewportSize)
		end) else nil
		refresh(if camera then camera.ViewportSize else Vector2.new(REFERENCE_HEIGHT * 16 / 9, REFERENCE_HEIGHT))
	end
	local cameraConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watch)
	watch()
	return function()
		cameraConnection:Disconnect()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
	end
end

-- Adds (or reuses) a UIScale on `target` whose scale is `base * factor()`, kept current as the
-- viewport resizes or the camera is replaced. Returns a disconnect function.
-- A device profile may override the base through the AsuraScaleBase attribute (DeviceLayout).
-- minScale (desktop only) keeps survival values readable on small windows (HudLayout MinScale).
function HudKit.bindScale(target: GuiObject, base: number, minScale: number?): () -&gt; ()
	local scale = target:FindFirstChildOfClass("UIScale") or HudKit.make("UIScale", target, {})
	return HudKit.onViewport(function()
		local override = target:GetAttribute("AsuraScaleBase")
		scale.Scale = if type(override) == "number" then override * HudKit.factor() else math.max(base * HudKit.factor(), minScale or 0)
	end)
end

-- Built-in content sounds only (rbxasset://), so cues work offline and in Studio.
HudKit.Sounds = table.freeze({
	Objective = "rbxasset://sounds/action_get_up.mp3",
	Tick = "rbxasset://sounds/volume_slider.ogg",
})

function HudKit.cue(id: string, volume: number, pitch: number)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = pitch
	SoundService:PlayLocalSound(sound)
	task.delay(3, function()
		sound:Destroy()
	end)
end

return HudKit
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="680">
            <Properties>
              <string name="Name">HudLayout</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/HudLayout
-- Reserved HUD regions (authored at the 900 px reference height, scaled like HudKit.bindScale) so
-- panels can be checked for overlap at any viewport. The controls reference lives in its own
-- centre band between the top strip and the action bar; its pill sits in the left utility column
-- with the Codex button, never in the bottom-centre combat row.
local Layout = {}

Layout.ReferenceHeight, Layout.MinFactor, Layout.MaxFactor = 900, 0.7, 1.35 -- mirrors HudKit.factor
Layout.ActionBarBottom = 58
Layout.Margin = 12

export type Rect = { X: number, Y: number, W: number, H: number }
-- Anchor/At: scale terms; Offset: pixels; Size: authored pixels; Base: UIScale base (0 = unscaled).
-- WidthScale/MinWidth/MaxWidth model size-constrained strips (compass, boss bar).
export type Region = {
	Anchor: { number }, At: { number }, Offset: { number }, Size: { number }, Base: number,
	WidthScale: number?, MinWidth: number?, MaxWidth: number?,
	MinScale: number?, -- desktop floor on Base * factor (survival plates)
}
local function region(anchor: { number }, at: { number }, offset: { number }, size: { number }, base: number): Region
	return { Anchor = anchor, At = at, Offset = offset, Size = size, Base = base }
end

Layout.Regions = {
	ActionBar = region({ 0.5, 1 }, { 0.5, 1 }, { 0, -Layout.ActionBarBottom }, { 588, 86 }, 0.8),
	Vitals = region({ 0, 1 }, { 0, 1 }, { 16, -12 }, { 470, 150 }, 0.78),
	Spells = region({ 1, 1 }, { 1, 1 }, { -24, -24 }, { 260, 190 }, 0.85),
	Minimap = region({ 0, 0 }, { 0, 0 }, { 20, 66 }, { 190, 190 }, 0.82),
	Objective = region({ 1, 0 }, { 1, 0 }, { -20, 64 }, { 360, 92 }, 0.8),
	Codex = region({ 0, 0 }, { 0, 0.55 }, { 14, 0 }, { 92, 30 }, 0),
	ControlsPill = region({ 0, 0 }, { 0, 0.55 }, { 14, -40 }, { 150, 30 }, 0.85),
	-- The training card (unscaled, grows with its text): right column, below the objective and above
	-- the spell slots. F08: in the left column it covered the Codex button and the Controls pill.
	Training = region({ 1, 0 }, { 1, 0 }, { -20, 172 }, { 360, 170 }, 0),
}
-- Health, flask, essence and weapon stay at least ~12 px on a 1096x604 window (F03 Studio view).
Layout.Regions.Vitals.MinScale = 0.66
Layout.Regions.Compass ={ Anchor = { 0.5, 0 }, At = { 0.5, 0 }, Offset = { 0, 8 }, Size = { 520, 60 }, Base = 0, WidthScale = 0.36, MinWidth = 240, MaxWidth = 520 }
Layout.Regions.Boss = { Anchor = { 0.5, 0 }, At = { 0.5, 0 }, Offset = { 0, 74 }, Size = { 900, 148 }, Base = 0, WidthScale = 0.5, MinWidth = 300, MaxWidth = 900 }

-- The general toast (InterfaceController): centred above the action bar, as wide as the band left
-- between two side columns (the training card is 360 wide at 20 from the edge), wrapping to two lines.
Layout.Toast = { Bottom = 200, Side = 400, Height = 48, MaxWidth = 640 }
function Layout.toastRect(width: number, height: number): Rect
	local t = Layout.Toast
	local w = math.clamp(width - 2 * t.Side, 0, t.MaxWidth)
	return { X = (width - w) / 2, Y = height - t.Bottom - t.Height, W = w, H = t.Height }
end

function Layout.factor(height: number): number
	if height &lt;= 1 then return 1 end
	return math.clamp(height / Layout.ReferenceHeight, Layout.MinFactor, Layout.MaxFactor)
end

-- On-screen rectangle of a region (UIScale scales about the anchor point).
function Layout.rect(name: string, width: number, height: number): Rect
	local r = (Layout.Regions :: any)[name] :: Region
	local scale = if r.Base &gt; 0 then math.max(r.Base * Layout.factor(height), r.MinScale or 0) else 1
	local w = r.Size[1] * scale
	if r.WidthScale then w = math.clamp(width * r.WidthScale, r.MinWidth or 0, r.MaxWidth or math.huge) end
	local h = r.Size[2] * scale
	local x = width * r.At[1] + r.Offset[1] - w * r.Anchor[1]
	local y = height * r.At[2] + r.Offset[2] - h * r.Anchor[2]
	return { X = x, Y = y, W = w, H = h }
end

function Layout.overlaps(a: Rect, b: Rect): boolean
	return a.X &lt; b.X + b.W and b.X &lt; a.X + a.W and a.Y &lt; b.Y + b.H and b.Y &lt; a.Y + a.H
end

-- The controls reference: centred in the band below the compass and above the action bar,
-- clear of the minimap and objective columns. Returns its UIScale and on-screen rect. On touch it
-- is a full-screen modal over its backdrop (the HUD columns would leave it unreadably small).
function Layout.modal(width: number, height: number, cardW: number, cardH: number, touch: boolean?): (number, Rect)
	local m = Layout.Margin
	if touch then
		local scale = math.max(math.min(Layout.factor(height), (width - 2 * m) / cardW, (height - 2 * m) / cardH), 0.5)
		return scale, { X = (width - cardW * scale) / 2, Y = (height - cardH * scale) / 2, W = cardW * scale, H = cardH * scale }
	end
	local top = Layout.rect("Compass", width, height)
	local bar = Layout.rect("ActionBar", width, height)
	local map = Layout.rect("Minimap", width, height)
	local objective = Layout.rect("Objective", width, height)
	local side = math.max(map.X + map.W, width - objective.X) + m
	local bandTop, bandBottom = top.Y + top.H + m, bar.Y - m
	local scale = math.min(Layout.factor(height), (width - 2 * side) / cardW, (bandBottom - bandTop) / cardH)
	scale = math.max(scale, 0.5)
	local w, h = cardW * scale, cardH * scale
	return scale, { X = (width - w) / 2, Y = bandTop + (bandBottom - bandTop - h) / 2, W = w, H = h }
end

-- Touch profile (batch 25): phones and tablets in landscape, measured inside the device safe area.
-- The bottom-left square is the thumbstick's and holds nothing; the combat buttons own the
-- bottom-right; the action bar is hidden (the buttons are the action bar). Vitals take the
-- freed bottom centre, the spell slots the top-right corner above the buttons, the objective
-- sits beside the minimap (whose blossom buttons carry Respite, controls and the Codex), and the
-- target plate and boss bar fill the top band between the minimap and the right-hand column.
Layout.Touch = { Cluster = { 340, 360 }, Thumb = 0.42, VitalsBase = 0.72, MinTarget = 240, MinBoss = 240, BossHeight = 110 }
function Layout.touch(width: number, height: number): { [string]: Rect }
	local f, m, t = Layout.factor(height), Layout.Margin, Layout.Touch
	local map = Layout.rect("Minimap", width, height)
	local cluster = { X = width - t.Cluster[1] * f, Y = height - t.Cluster[2] * f, W = t.Cluster[1] * f, H = t.Cluster[2] * f }
	local thumb = { X = 0, Y = height - height * t.Thumb, W = height * t.Thumb, H = height * t.Thumb }
	local vw, vh = 470 * t.VitalsBase * f, 150 * t.VitalsBase * f
	local left, right = thumb.W + m, cluster.X - m
	local vitals = { X = left + math.max(0, (right - left - vw) / 2), Y = height - m - vh, W = vw, H = vh }
	local sw, sh = 260 * 0.85 * f, 190 * 0.85 * f
	local spells = { X = width - 16 - sw, Y = math.max(2, cluster.Y - sh - 2), W = sw, H = sh }
	local ow, oh = 360 * 0.8 * f, 92 * 0.8 * f
	local objective = { X = map.X + map.W + m, Y = 72, W = ow, H = oh }
	local spanL, spanR = map.X + map.W + m, math.min(cluster.X, spells.X) - m
	local tw = math.clamp(math.min(width * 0.4, spanR - spanL), t.MinTarget, 520)
	local target = { X = spanL + math.max(0, (spanR - spanL - tw) / 2), Y = objective.Y + objective.H + 8, W = tw, H = 52 }
	local bw = math.clamp(math.min(width * 0.5, spanR - spanL), t.MinBoss, 900)
	local boss = { X = spanL + math.max(0, (spanR - spanL - bw) / 2), Y = 74, W = bw, H = t.BossHeight }
	-- Warnings sit between the thumb and the buttons, midway between the top band and the vitals.
	local cw = math.min(520, right - left)
	local cy = (target.Y + target.H + vitals.Y) / 2 - 24
	return { Minimap = map, Compass = Layout.rect("Compass", width, height), Cluster = cluster, Thumb = thumb, Vitals = vitals,
		Spells = spells, Objective = objective, Target = target, Boss = boss,
		Callout = { X = left + (right - left - cw) / 2, Y = cy, W = cw, H = 48 } }
end

return table.freeze(Layout)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="681">
            <Properties>
              <string name="Name">HudVisibility</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/HudVisibility
-- One rule for which HUD layers may show. Every layer asks this each frame instead of keeping its
-- own hidden flag, so leaving the prologue, death screen or a dialogue restores exactly what the
-- current situation allows and no stale label survives a transition.
local ProximityPromptService = game:GetService("ProximityPromptService")

local Visibility = {}

export type Flags = { Death: boolean, Prologue: boolean, Dialogue: boolean, Altar: boolean, Boss: boolean, Touch: boolean? }
export type Layers = {
	Combat: boolean, -- action bar, enemy plates, target plate, callouts, lock-on
	Vitals: boolean, -- health / stamina / Qi plate and loadout
	Boss: boolean, -- boss bar and duo strip
	Decor: boolean, -- compass, minimap, screen petals
	Guidance: boolean, -- objective, controls pill/card, Codex button, spell cluster
	Pointer: boolean, -- guidance buttons for mouse/controller only (touch reaches them through Respite)
	Prompts: boolean, -- in-world ProximityPrompts
	Notices: boolean, -- toasts and banners
}

-- Pure decision table (tested in tools/test_hud_layout.luau).
function Visibility.resolve(flags: Flags): Layers
	local cinematic = flags.Death or flags.Prologue
	local talking = flags.Dialogue
	return {
		Combat = not cinematic and not talking,
		Vitals = not cinematic and not talking,
		Boss = flags.Boss and not cinematic and not talking,
		Decor = not cinematic and not talking,
		Guidance = not cinematic and not talking and not flags.Altar,
		Pointer = not cinematic and not talking and not flags.Altar and flags.Touch ~= true,
		Prompts = not cinematic and not talking and not flags.Altar, -- menus own the interact key
		Notices = not flags.Death,
	}
end

function Visibility.flags(ui: any): Flags
	return {
		Death = ui.DeathShown == true,
		Prologue = ui.PrologueActive == true or ui.EndingActive == true, -- the crossing is cinematic too
		Dialogue = ui.DialogueOpen == true,
		Altar = ui.Altar ~= nil and ui.Altar.Visible == true,
		Boss = ui.BossEntity ~= nil,
		Touch = ui.TouchHud == true,
	}
end

function Visibility.of(ui: any): Layers
	return Visibility.resolve(Visibility.flags(ui))
end

-- Small HUD pieces without their own update (e.g. the Codex button) register a layer once.
local registered: { [GuiObject]: string } = setmetatable({}, { __mode = "k" }) :: any
function Visibility.register(object: GuiObject, layer: string)
	registered[object] = layer
end

-- Prompts are a local client setting: hiding them never disables the server-side interaction.
local promptsShown = true
function Visibility.apply(ui: any): Layers
	local layers = Visibility.of(ui)
	if layers.Prompts ~= promptsShown then
		promptsShown = layers.Prompts
		ProximityPromptService.Enabled = layers.Prompts
	end
	for object, layer in registered do
		object.Visible = (layers :: any)[layer] == true
	end
	return layers
end

function Visibility.restore()
	promptsShown = true
	ProximityPromptService.Enabled = true
	table.clear(registered)
end

return table.freeze(Visibility)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="682">
            <Properties>
              <string name="Name">IconShapes</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/IconShapes
-- Drawing primitives for MoveIcons. Coordinates are 0..1 inside a square icon frame, so shapes
-- scale with whatever size the icon is shown at. `px` values are stroke widths in pixels.
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)

local Shapes = {}
-- Customization ------------------------------------------------------------------------------
Shapes.Accent = Sakura.Colors.Gold -- crossguards, pommels and highlights on every icon
Shapes.make = HudKit.make

function Shapes.box(icon: Instance, x: number, y: number, w: number, h: number, rotation: number, color: Color3, round: number?): Frame
	local f = HudKit.make("Frame", icon, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h),
		Rotation = rotation, BackgroundColor3 = color, BorderSizePixel = 0,
	}) :: Frame
	if round then HudKit.make("UICorner", f, { CornerRadius = UDim.new(round, 0) }) end
	return f
end

-- A stroke between two points (icon space 0..1); the icon is square so scale is isotropic.
function Shapes.line(icon: Instance, x1: number, y1: number, x2: number, y2: number, thick: number, color: Color3): Frame
	local dx, dy = x2 - x1, y2 - y1
	return Shapes.box(icon, (x1 + x2) / 2, (y1 + y2) / 2, math.sqrt(dx * dx + dy * dy) + thick * 0.5, thick, math.deg(math.atan2(dy, dx)), color, 0.5)
end

function Shapes.disc(icon: Instance, x: number, y: number, d: number, color: Color3): Frame
	return Shapes.box(icon, x, y, d, d, 0, color, 1)
end

-- Circle outline; `cut` (0..1) hides that share of it behind a straight edge facing `facing`°.
function Shapes.ring(icon: Instance, x: number, y: number, d: number, px: number, color: Color3, cut: number?, facing: number?): Frame
	local f = Shapes.disc(icon, x, y, d, color)
	f.BackgroundTransparency = 1
	local stroke = HudKit.make("UIStroke", f, { Color = color, Thickness = math.max(1, px) }) :: UIStroke
	if cut then
		HudKit.make("UIGradient", stroke, { Rotation = facing or 0, Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1 - cut - 0.001, 0),
			NumberSequenceKeypoint.new(1 - cut, 1), NumberSequenceKeypoint.new(1, 1),
		}) })
	end
	return f
end

function Shapes.sword(icon: Instance, x1: number, y1: number, x2: number, y2: number, thick: number, color: Color3)
	Shapes.line(icon, x1, y1, x2, y2, thick, color) -- blade, tip at (x2, y2)
	local gx, gy = x1 + (x2 - x1) * 0.18, y1 + (y2 - y1) * 0.18
	local nx, ny = -(y2 - y1) * 0.22, (x2 - x1) * 0.22
	Shapes.line(icon, gx - nx, gy - ny, gx + nx, gy + ny, thick * 0.9, Shapes.Accent) -- crossguard
	Shapes.disc(icon, x1 - (x2 - x1) * 0.08, y1 - (y2 - y1) * 0.08, thick * 1.6, Shapes.Accent) -- pommel
end

return table.freeze(Shapes)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="683">
            <Properties>
              <string name="Name">ImpactFrame</string>
              <string name="Source">--!strict
-- Screen-space layer for the showcase sorceries: colour grading pulses (blackout, solarized burst,
-- whiteout) and 2D anime impact frames (sunburst discs, radial speed lines, character silhouette with
-- a coloured rim). Palettes give each spell its own frame and its negative. Local caster only;
-- reduced flashes keeps a share of every grade via EffectsPreference.flash and shortens frames.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Effects = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Kit = require(script.Parent.SkillKit)
local Screen = {}

local rgb = Color3.fromRGB
Screen.Yellow = rgb(251, 252, 29)
Screen.Pale = rgb(255, 245, 157)
Screen.Ink = rgb(15, 2, 2)
local WHITE = Color3.new(1, 1, 1)
local NEUTRAL = { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = WHITE }

export type Palette = { Back: Color3, Rings: { Color3 }, Lines: Color3, Body: Color3, Rim: Color3, Flat: boolean? }
Screen.Palettes = table.freeze({
	Fire = { Back = rgb(255, 140, 0), Rings = { Screen.Yellow, Screen.Pale, WHITE }, Lines = Screen.Ink, Body = Screen.Ink, Rim = rgb(150, 12, 10) },
	FireNegative = { Back = Screen.Ink, Rings = { rgb(120, 8, 6), rgb(255, 69, 0), Screen.Yellow }, Lines = Screen.Pale, Body = WHITE, Rim = rgb(255, 69, 0), Flat = true },
	Celestial = { Back = rgb(6, 12, 30), Rings = { rgb(0, 120, 140), rgb(0, 255, 255), WHITE }, Lines = WHITE, Body = Screen.Ink, Rim = rgb(255, 170, 0) },
	CelestialNegative = { Back = WHITE, Rings = { rgb(190, 250, 255), rgb(120, 230, 240), WHITE }, Lines = rgb(4, 20, 40), Body = rgb(4, 8, 18), Rim = rgb(0, 200, 210) },
})

function Screen.grade(trove: Kit.Trove): ColorCorrectionEffect
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "AsuraSkillGrade"
	cc.Parent = Lighting
	return Kit.add(trove, cc)
end

-- Snap to a grade now, hold it, then ease back to neutral over `fade` seconds.
function Screen.pulse(trove: Kit.Trove, cc: ColorCorrectionEffect, goal: { [string]: any }, hold: number, fade: number)
	cc.Brightness = Effects.flash(goal.Brightness or 0)
	cc.Contrast = Effects.flash(goal.Contrast or 0)
	cc.Saturation = goal.Saturation or 0
	cc.TintColor = goal.TintColor or NEUTRAL.TintColor
	Kit.after(trove, hold, function()
		if fade &lt;= 0 then
			for key, value in NEUTRAL do (cc :: any)[key] = value end
		else
			Kit.tween(trove, cc, fade, NEUTRAL, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)
end

-- Eases a grade toward `goal` and leaves it there (void dimming, stance tension).
function Screen.settle(trove: Kit.Trove, cc: ColorCorrectionEffect, goal: { [string]: any }, seconds: number)
	local scaled = table.clone(goal)
	if scaled.Brightness then scaled.Brightness = Effects.flash(scaled.Brightness) end
	Kit.tween(trove, cc, seconds, scaled, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

local function silhouette(parent: Instance, model: Model, view: CFrame, fov: number, tint: Color3, scale: number, z: number, flat: boolean?)
	local viewport = Instance.new("ViewportFrame")
	viewport.Size, viewport.AnchorPoint = UDim2.fromScale(scale, scale), Vector2.new(0.5, 0.5)
	viewport.Position, viewport.BackgroundTransparency, viewport.ZIndex = UDim2.fromScale(0.5, 0.5), 1, z
	viewport.Ambient, viewport.LightColor, viewport.ImageColor3 = WHITE, WHITE, tint
	local camera = Instance.new("Camera")
	camera.CFrame, camera.FieldOfView, camera.Parent = view, fov, viewport
	viewport.CurrentCamera = camera
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local was = model.Archivable
	model.Archivable = true
	local clone = model:Clone()
	model.Archivable = was
	if not clone then return end
	for _, d in clone:GetDescendants() do
		if d:IsA("LuaSourceContainer") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("GuiBase") or d:IsA("Constraint") or d:IsA("Beam") then
			d:Destroy()
		elseif flat and (d:IsA("Decal") or d:IsA("SurfaceAppearance") or d:IsA("Clothing")) then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			if flat then d.Color, d.Material = WHITE, Enum.Material.Neon end
		end
	end
	clone.Parent = world
	viewport.Parent = parent
end

-- Impact frame over `seconds` in `palette`: sunburst discs, speed lines re-cut every frame like
-- hand-drawn smears, and the caster's silhouette with a coloured rim exactly where it stands.
function Screen.frame(trove: Kit.Trove, model: Model, seconds: number, palette: Palette)
	local player = Players.LocalPlayer
	local camera = Workspace.CurrentCamera
	if not player or not camera then return end
	if Effects.reducedFlashes() then seconds *= 0.5 end
	local gui = Kit.add(trove, Instance.new("ScreenGui"))
	gui.Name, gui.IgnoreGuiInset, gui.DisplayOrder, gui.ResetOnSpawn = "AsuraImpactFrame", true, 60, false
	local back = Instance.new("Frame")
	back.Size, back.BackgroundColor3, back.BorderSizePixel = UDim2.fromScale(1, 1), palette.Back, 0
	back.Parent = gui
	for n, ring in { 1.9, 1.15, 0.55 } do
		local disc = Instance.new("Frame")
		disc.AnchorPoint, disc.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
		disc.Size, disc.BackgroundColor3, disc.BorderSizePixel, disc.ZIndex = UDim2.fromScale(ring, ring), palette.Rings[n], 0, 1 + n
		local aspect, corner = Instance.new("UIAspectRatioConstraint"), Instance.new("UICorner")
		aspect.DominantAxis, aspect.Parent, corner.CornerRadius, corner.Parent = Enum.DominantAxis.Height, disc, UDim.new(0.5, 0), disc
		disc.Parent = back
	end
	local size = camera.ViewportSize
	local reach = size.Magnitude * 0.5
	local lines: { Frame } = {}
	for n = 1, 48 do
		local line = Instance.new("Frame")
		line.AnchorPoint, line.BackgroundColor3, line.BorderSizePixel, line.ZIndex = Vector2.new(0.5, 0.5), palette.Lines, 0, 6
		local fade = Instance.new("UIGradient")
		fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 0.6), NumberSequenceKeypoint.new(1, 0) })
		fade.Parent = line
		line.Parent = back
		lines[n] = line
	end
	local function scatter()
		for n, line in lines do
			local angle = (n / #lines) * math.pi * 2 + (math.random() - 0.5) * 0.12
			local length = reach * (0.5 + math.random() * 0.5)
			local mid = size / 2 + Vector2.new(math.cos(angle), math.sin(angle)) * (reach - length / 2)
			line.Size = UDim2.fromOffset(length, 2 + math.random() * 8)
			line.Position, line.Rotation = UDim2.fromOffset(mid.X, mid.Y), math.deg(angle)
		end
	end
	scatter()
	silhouette(back, model, camera.CFrame, camera.FieldOfView, palette.Rim, 1.03, 7, palette.Flat)
	silhouette(back, model, camera.CFrame, camera.FieldOfView, palette.Body, 1, 8, palette.Flat)
	gui.Parent = player:FindFirstChildOfClass("PlayerGui")
	Kit.add(trove, task.spawn(function()
		local stop = os.clock() + seconds
		while os.clock() &lt; stop and gui.Parent do
			task.wait(1 / 30)
			scatter()
		end
		gui:Destroy()
	end))
end

Screen.silhouette = silhouette -- the caster drawn exactly where they stand, for other 2D layers

return table.freeze(Screen)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="684">
            <Properties>
              <string name="Name">InkFrames</string>
              <string name="Source">--!strict
-- Single-beat impact frames that open the Blazing Sun blast: the red ink splatter and the white shard
-- burst. Each lasts two to four frames and re-cuts every frame like hand-drawn smears. Caster only.
local Kit = require(script.Parent.SkillKit)
local Manga = require(script.Parent.MangaFx)
local Ink = {}

local rgb = Color3.fromRGB
local WHITE, INK = Color3.new(1, 1, 1), rgb(6, 6, 8)

local function full(gui: ScreenGui, color: Color3): Frame
	local back = Manga.box(gui, color)
	back.Position, back.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	return back
end

-- A thin stroke from `from` at `angle` (radians), `length` px long.
local function stroke(f: Frame, from: Vector2, angle: number, length: number, width: number)
	local mid = from + Vector2.new(math.cos(angle), math.sin(angle)) * length / 2
	f.Position, f.Size, f.Rotation = UDim2.fromOffset(mid.X, mid.Y), UDim2.fromOffset(length, width), math.deg(angle)
end

Ink.full, Ink.stroke = full, stroke -- shared with NovaInk

-- Black frame splashed with blood-red ink around a white-hot star.
function Ink.splatter(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	local back = full(gui, INK)
	local drops: { Frame } = {}
	for n = 1, 80 do drops[n] = Manga.blob(back, rgb(222, 18, 10)) end
	local rays: { Frame } = {}
	for n = 1, 24 do
		rays[n] = Manga.box(back, if n % 3 == 0 then WHITE else rgb(255, 236, 90))
		rays[n].ZIndex = 4
	end
	local star = Manga.blob(back, rgb(255, 250, 225))
	star.ZIndex = 5
	Manga.animate(trove, gui, seconds, function()
		local c = Vector2.new(size.X * 0.5, size.Y * 0.47)
		for _, f in drops do
			local a, r = math.random() * math.pi * 2, size.Y * (0.05 + 0.6 * math.random() ^ 1.3)
			local d = size.Y * (0.08 + math.random() * 0.3) * (1.1 - r / (size.Y * 0.75))
			f.Position, f.Size = UDim2.fromOffset(c.X + math.cos(a) * r * 1.4, c.Y + math.sin(a) * r), UDim2.fromOffset(d * (1 + math.random()), d)
			f.Rotation = math.random() * 180
		end
		for n, f in rays do stroke(f, c, n / #rays * math.pi * 2 + math.random() * 0.3, size.Y * (0.14 + math.random() * 0.3), 4 + math.random() * 12) end
		star.Position, star.Size = UDim2.fromOffset(c.X, c.Y), UDim2.fromOffset(size.Y * 0.2, size.Y * 0.2)
	end)
end

-- Warm white flash of yellow, white and red sticks flying from the centre, a flare line through it.
function Ink.shards(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	-- A hazy, washed-out flash the world still shows through, with a soft white heart.
	local back = full(gui, rgb(250, 232, 214))
	back.BackgroundTransparency = 0.3
	for k, spec in { { 1.3, 0.75 }, { 0.95, 0.5 }, { 0.6, 0.15 } } do
		local glow = Manga.blob(back, WHITE)
		glow.Position, glow.Size, glow.BackgroundTransparency, glow.ZIndex = UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(size.Y * spec[1], size.Y * spec[1]), spec[2], 1 + k
	end
	local colors = { WHITE, rgb(255, 236, 90), rgb(255, 176, 40), rgb(225, 40, 20) }
	local sticks: { Frame } = {}
	for n = 1, 48 do
		sticks[n] = Manga.box(back, colors[(n % #colors) + 1])
		sticks[n].ZIndex = 5
	end
	local flare = Manga.box(back, WHITE)
	flare.Position, flare.Size, flare.ZIndex = UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(size.X * 0.008, size.Y), 4
	Manga.animate(trove, gui, seconds, function()
		local c = size / 2
		for _, f in sticks do
			local a = math.random() * math.pi * 2
			local from = c + Vector2.new(math.cos(a), math.sin(a)) * size.Y * math.random() * 0.12
			stroke(f, from, a + (math.random() - 0.5) * 0.6, size.Y * (0.08 + math.random() * 0.4), 4 + math.random() * 9)
		end
	end)
end

return table.freeze(Ink)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="685">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/InputController
-- Hybrid Souls control scheme for keyboard/mouse, gamepad and touch. Presses are stamped with
-- server time, deduplicated and priority-ordered through the shared InputBuffer, then sent as
-- ActionIntent packets. The server buffers again and re-validates every action.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local InputBuffer = require(Shared:WaitForChild("Simulation"):WaitForChild("InputBuffer") :: ModuleScript)
local Strike = require(Shared:WaitForChild("Simulation"):WaitForChild("StrikeGeometry") :: ModuleScript)
local InputMap = require(Shared:WaitForChild("Shared"):WaitForChild("InputMap") :: ModuleScript)
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local CameraController = require(script.Parent:WaitForChild("CameraController") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Movement = require(script.Parent:WaitForChild("MovementController") :: ModuleScript)

type WorldState = WorldState.WorldState
type CameraController = CameraController.CameraController

export type Device = "Keyboard" | "Gamepad" | "Touch"
export type Command =
	"Light"
	| "Heavy"
	| "WeaponArt"
	| "Guard"
	| "Roll"
	| "Dash"
	| "Sprint"
	| "Lock"
	| "Swap"
	| "Heal"
	| "Interact"
	| "Shoulder"
	| "Cursor"
	| "Jump"
	| "Slide"
	| "Aim"

local Controller = {}
Controller.__index = Controller

-- Bindings, captions and touch labels all come from the shared InputMap.
local function keyTable(names: { [string]: InputMap.Command }, enum: any): { [any]: Command }
	local result: { [any]: Command } = {}
	for name, command in names do
		result[enum[name]] = command :: any
	end
	return result
end
local KEYBOARD: { [Enum.KeyCode]: Command } = keyTable(InputMap.lookup("Combat", "Keys"), Enum.KeyCode)
local MOUSE: { [Enum.UserInputType]: Command } = keyTable(InputMap.lookup("Combat", "Mouse"), Enum.UserInputType)
local GAMEPAD: { [Enum.KeyCode]: Command } = keyTable(InputMap.lookup("Combat", "Pad"), Enum.KeyCode)
-- Keys bound to "Cursor": the cursor stays free only while one of them is physically held.
local CURSOR_KEYS: { Enum.KeyCode } = {}
for _, name in (InputMap.get("Cursor") :: InputMap.Binding).Keys do
	table.insert(CURSOR_KEYS, (Enum.KeyCode :: any)[name])
end
-- Jump, dash, slide and glide inputs are owned by one context action (native held-jump repeats
-- cannot spend the double jump); jump never takes the raw InputBegan path.
local MOVEMENT_INPUTS: { any } = {}
local JUMP_INPUTS: { [Enum.KeyCode]: boolean } = {}
for _, command in { "Jump", "Dash", "Slide", "Aim" } do
	local binding = InputMap.get(command) :: InputMap.Binding
	for _, name in binding.Keys do
		table.insert(MOVEMENT_INPUTS, (Enum.KeyCode :: any)[name])
	end
	for _, name in binding.Pad do
		table.insert(MOVEMENT_INPUTS, (Enum.KeyCode :: any)[name])
	end
	for _, name in binding.Mouse do
		table.insert(MOVEMENT_INPUTS, (Enum.UserInputType :: any)[name])
	end
	if command == "Jump" then
		for _, name in binding.Keys do
			KEYBOARD[(Enum.KeyCode :: any)[name]] = nil
			JUMP_INPUTS[(Enum.KeyCode :: any)[name]] = true
		end
		for _, name in binding.Pad do
			GAMEPAD[(Enum.KeyCode :: any)[name]] = nil
			JUMP_INPUTS[(Enum.KeyCode :: any)[name]] = true
		end
	end
end
local PROMPT_KEY: Enum.KeyCode = (Enum.KeyCode :: any)[InputMap.PromptKey]
local PROMPT_PAD: Enum.KeyCode = (Enum.KeyCode :: any)[InputMap.PromptPad]

local TOUCH_LAYOUT: { { Command: Command, Position: UDim2, Size: number } } = {
	{ Command = "Light", Position = UDim2.new(1, -96, 1, -150), Size = 84 },
	{ Command = "Heavy", Position = UDim2.new(1, -190, 1, -110), Size = 72 },
	{ Command = "Guard", Position = UDim2.new(1, -110, 1, -250), Size = 72 },
	{ Command = "Dash", Position = UDim2.new(1, -205, 1, -205), Size = 64 },
	{ Command = "Jump", Position = UDim2.new(1, -82, 1, -62), Size = 68 },
	{ Command = "Slide", Position = UDim2.new(1, -300, 1, -325), Size = 56 },
	{ Command = "Aim", Position = UDim2.new(1, -300, 1, -65), Size = 52 },
	{ Command = "WeaponArt", Position = UDim2.new(1, -280, 1, -150), Size = 56 },
	{ Command = "Lock", Position = UDim2.new(1, -70, 1, -326), Size = 52 },
	{ Command = "Heal", Position = UDim2.new(1, -150, 1, -320), Size = 52 },
	{ Command = "Interact", Position = UDim2.new(1, -230, 1, -290), Size = 52 },
	{ Command = "Swap", Position = UDim2.new(1, -300, 1, -230), Size = 48 },
}

-- Own jump edges so native held-jump repeats cannot spend the double jump.
local MOVEMENT_ACTION = "AsuraKineticMovement"
local STICK_DEADZONE = 0.18
local STICK_SPEED = 900
local TOUCH_SCALE = 1.4
-- Authored minimum button size: at the smallest HUD factor (0.7) it is still a 44-point target (batch 25).
local MIN_TOUCH = 64

export type Sender = (action: string, variant: string?, x: number?, z: number?, held: boolean?, time: number?) -&gt; ()

type Fields = {
	State: WorldState,
	Camera: CameraController,
	Movement: Movement.MovementController,
	Send: Sender,
	Buffer: InputBuffer.Buffer,
	Device: Device,
	Connections: { RBXScriptConnection },
	GuardHeld: boolean,
	SprintHeld: boolean,
	CursorFree: boolean,
	MenuOpen: boolean,
	MenuOwners: { [string]: true },
	Stick: Vector2,
	TouchLook: Vector2,
	TouchGui: ScreenGui,
	TouchButtons: { [Command]: TextButton },
	LookTouch: InputObject?,
	OnCommand: ((command: Command) -&gt; ())?,
	OnDeviceChanged: ((device: Device) -&gt; ())?,
}

export type InputController = typeof(setmetatable({} :: Fields, Controller))

local function deviceFor(inputType: Enum.UserInputType): Device?
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.sub(inputType.Name, 1, 7) == "Gamepad" then
		return "Gamepad"
	elseif inputType == Enum.UserInputType.Keyboard or string.sub(inputType.Name, 1, 5) == "Mouse" then
		return "Keyboard"
	end
	return nil
end

-- Prompts currently on screen (most recent last) and the one a touch USE press is holding.
local shownPrompts: { ProximityPrompt } = {}
local heldPrompt: ProximityPrompt? = nil

local function buildTouchGui(self: InputController)
	-- Buttons hang off a bottom-right cluster that scales with the viewport, so the top of the
	-- cluster never climbs into the Roblox top bar on short landscape phones.
	local gui = Instance.new("Frame")
	gui.Name = "Cluster"
	gui.AnchorPoint = Vector2.new(1, 1)
	gui.Position = UDim2.fromScale(1, 1)
	gui.Size = UDim2.fromOffset(340, 360)
	gui.BackgroundTransparency = 1
	gui.Parent = self.TouchGui
	gui.Destroying:Once(HudKit.bindScale(gui, 1))
	for _, entry in TOUCH_LAYOUT do
		local button = Instance.new("TextButton")
		button.Name = entry.Command
		button.Text = InputMap.label(entry.Command, "Touch")
		button.Font = Enum.Font.GothamMedium
		button.TextScaled = true
		button.TextColor3 = Color3.fromRGB(255, 226, 238)
		button.BackgroundColor3 = Color3.fromRGB(48, 18, 42)
		button.BackgroundTransparency = 0.3
		button.AutoButtonColor = false
		button.Size = UDim2.fromOffset(math.max(entry.Size, MIN_TOUCH), math.max(entry.Size, MIN_TOUCH))
		button.Position = entry.Position
		button.AnchorPoint = Vector2.new(0.5, 0.5)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = button
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(247, 168, 200)
		stroke.Thickness = 1
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button
		local padding = Instance.new("UIPadding")
		padding.PaddingTop = UDim.new(0.18, 0)
		padding.PaddingLeft = UDim.new(0.08, 0)
		padding.PaddingRight = UDim.new(0.08, 0)
		local textLimit = Instance.new("UITextSizeConstraint")
		textLimit.MinTextSize, textLimit.MaxTextSize = 10, 16
		textLimit.Parent = button
		padding.PaddingBottom = UDim.new(0.18, 0)
		padding.Parent = button
		local command: Command = entry.Command
		button.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.Touch then
				button.BackgroundTransparency = 0.05
				self:Press(command)
			end
		end)
		button.InputEnded:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.Touch then
				button.BackgroundTransparency = 0.3
				self:Release(command)
			end
		end)
		button.Parent = gui
		self.TouchButtons[command] = button
	end
	local compact = { { "Slide", "Heal", "Lock" }, { "Swap", "Interact", "Guard" },
		{ "WeaponArt", "Dash", "Light" }, { "Aim", "Heavy", "Jump" } }
	local function arrange()
		if self.TouchGui.AbsoluteSize.Y &lt; 420 then
			for row, names in compact do
				for col, name in names do
					local button = self.TouchButtons[name :: Command]
					button.Position = UDim2.new(1, -({ 218, 136, 54 })[col], 1, -({ 274, 200, 122, 40 })[row])
				end
			end
		else
			for _, entry in TOUCH_LAYOUT do self.TouchButtons[entry.Command].Position = entry.Position end
		end
	end
	table.insert(self.Connections, self.TouchGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(arrange))
	arrange()
	-- PlayerModule still owns the native thumbstick. Its separate jump button would duplicate
	-- our edge-owned double jump, so hide that button only, including when Roblox rebuilds it.
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local function nativeJump(item: Instance)
		if item.Name ~= "JumpButton" or not item:IsA("GuiObject") or not item:FindFirstAncestor("TouchControlFrame") then return end
		item.Visible = false
		table.insert(self.Connections, item:GetPropertyChangedSignal("Visible"):Connect(function() if item.Visible then item.Visible = false end end))
	end
	for _, item in playerGui:GetDescendants() do nativeJump(item) end
	table.insert(self.Connections, playerGui.DescendantAdded:Connect(nativeJump))
end

function Controller.new(state: WorldState, camera: CameraController, send: Sender, movement: Movement.MovementController): InputController
	local gui = Instance.new("ScreenGui")
	gui.Name = "AsuraTouchControls"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 8
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local fields: Fields = {
		State = state,
		Camera = camera,
		Movement = movement,
		Send = send,
		Buffer = InputBuffer.new(),
		Device = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Touch" else "Keyboard",
		Connections = {},
		GuardHeld = false,
		SprintHeld = false,
		CursorFree = false,
		MenuOpen = false,
		MenuOwners = {},
		Stick = Vector2.zero,
		TouchLook = Vector2.zero,
		TouchGui = gui,
		TouchButtons = {},
		LookTouch = nil,
		OnCommand = nil,
		OnDeviceChanged = nil,
	}
	local self = setmetatable(fields, Controller)
	buildTouchGui(self)
	self:SetDevice(self.Device)
	table.insert(self.Connections, ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt)
		-- Any prompt (including saved-place content) answers the shared Interact binding.
		if prompt.KeyboardKeyCode ~= PROMPT_KEY or prompt.GamepadKeyCode ~= PROMPT_PAD then
			InputMap.applyPrompt(prompt)
		end
		table.insert(shownPrompts, prompt)
	end))
	table.insert(self.Connections, ProximityPromptService.PromptHidden:Connect(function(prompt: ProximityPrompt)
		local index = table.find(shownPrompts, prompt)
		if index then
			table.remove(shownPrompts, index)
		end
		if heldPrompt == prompt then
			heldPrompt = nil
		end
	end))

	table.insert(self.Connections, UserInputService.LastInputTypeChanged:Connect(function(inputType: Enum.UserInputType)
		local device: Device? = deviceFor(inputType)
		if device then
			self:SetDevice(device)
		end
	end))
	-- Device Simulator and hardware capability changes need not produce an input event. Refresh
	-- on capability changes too, so an already-running session never keeps desktop controls on a phone.
	local function capabilitiesChanged()
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			self:SetDevice("Touch")
		elseif not UserInputService.KeyboardEnabled and UserInputService.GamepadEnabled then
			self:SetDevice("Gamepad")
		elseif self.Device == "Touch" and not UserInputService.TouchEnabled then
			self:SetDevice(deviceFor(UserInputService:GetLastInputType()) or "Keyboard")
		end
	end
	for _, capability in { "TouchEnabled", "KeyboardEnabled", "GamepadEnabled" } do
		table.insert(self.Connections, UserInputService:GetPropertyChangedSignal(capability):Connect(capabilitiesChanged))
	end
	capabilitiesChanged()
	table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		self:Began(input, processed)
	end))
	table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input: InputObject, _processed: boolean)
		self:Ended(input)
	end))
	table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		self:Changed(input, processed)
	end))
	table.insert(self.Connections, UserInputService.WindowFocusReleased:Connect(function()
		self.Movement:Cancel()
		self.CursorFree = false -- the Alt release is lost when focus leaves mid-press
	end))
	table.insert(self.Connections, UserInputService.WindowFocused:Connect(function() self.CursorFree = false end))
	table.insert(self.Connections, UserInputService.TextBoxFocused:Connect(function() self.Movement:SetEnabled(false) end))
	table.insert(self.Connections, GuiService.MenuOpened:Connect(function() self.Movement:SetEnabled(false) end))
	ContextActionService:BindActionAtPriority(MOVEMENT_ACTION, function(_name: string, inputState: Enum.UserInputState, event: InputObject): Enum.ContextActionResult
		if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
		-- B is Dash and also every window's back button: an open window gets it unprocessed.
		if self.MenuOpen and event.KeyCode == Enum.KeyCode.ButtonB then return Enum.ContextActionResult.Pass end
		local command: Command = if JUMP_INPUTS[event.KeyCode] then "Jump"
			else KEYBOARD[event.KeyCode] or GAMEPAD[event.KeyCode] or MOUSE[event.UserInputType]
		if inputState == Enum.UserInputState.Begin then
			self:SetDevice(deviceFor(event.UserInputType) or self.Device)
			self:Press(command)
		elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			self:Release(command)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, table.unpack(MOVEMENT_INPUTS))
	return self
end

function Controller.SetDevice(self: InputController, device: Device)
	if self.Device == device and self.TouchGui.Enabled == (device == "Touch") then
		return
	end
	self.Device = device
	Players.LocalPlayer:SetAttribute("AsuraInputDevice", device)
	self.TouchGui.Enabled = device == "Touch" and not self.MenuOpen
	local callback = self.OnDeviceChanged
	if callback then
		callback(device)
	end
end

-- Caption of any InputMap command (combat, spells, menus) for the active device; "" on touch.
function Controller.Label(self: InputController, command: string): string
	if self.Device == "Touch" then
		return ""
	end
	return InputMap.label(command, self.Device)
end

-- Caption for instructional text (tutorial, counter hints): touch names its on-screen button
-- ("JUMP") where Label answers "" so key badges can hide (batch 25).
function Controller.Hint(self: InputController, command: string): string
	return InputMap.label(command, self.Device)
end

-- Each window claims input under its own owner name; input stays with menus until every owner has
-- released it, so closing Respite over a dialogue cannot hand keys back while Lin is still talking.
function Controller.SetMenu(self: InputController, open: boolean, owner: string?)
	self.MenuOwners[owner or "Menu"] = if open then true else nil
	open = next(self.MenuOwners) ~= nil
	self.MenuOpen = open
	self.Movement:SetEnabled(not open)
	self.TouchGui.Enabled = self.Device == "Touch" and not open
	if open and self.GuardHeld then
		self:Release("Guard")
	end
	if open and self.SprintHeld then
		self.SprintHeld = false
		self.Send("Sprint", nil, nil, nil, false, Workspace:GetServerTimeNow())
	end
end

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- Movement intent in world space for evasions: stick/keys direction, else straight back.
function Controller.EvadeDirection(self: InputController): Vector3
	local own = self.State:Own()
	local humanoid = own and own.Humanoid
	if humanoid and humanoid.MoveDirection.Magnitude &gt; 0.1 then
		local direction = humanoid.MoveDirection
		return Vector3.new(direction.X, 0, direction.Z).Unit
	end
	local look = Workspace.CurrentCamera.CFrame.LookVector
	local back = -Vector3.new(look.X, 0, look.Z)
	return if back.Magnitude &gt; 1e-3 then back.Unit else Vector3.new(0, 0, 1)
end

-- Where an attack is aimed (StrikeGeometry): the locked target, else the move input, else the camera
-- (mouse) or the body's facing (stick and touch). The server commits the swing within its budget.
function Controller.AttackDirection(self: InputController): Vector3
	local own = self.State:Own()
	local root = own and own.Root
	local target = self.Camera:LockedEntity()
	if root and target and target.Root then
		local d = (target.Root :: BasePart).Position - root.Position
		if Vector3.new(d.X, 0, d.Z).Magnitude &gt; 0.1 then
			return Vector3.new(d.X, 0, d.Z).Unit
		end
	end
	local humanoid = own and own.Humanoid
	if humanoid and humanoid.MoveDirection.Magnitude &gt; 0.1 then
		local m = humanoid.MoveDirection
		return Vector3.new(m.X, 0, m.Z).Unit
	end
	local look = if self.Device == "Keyboard" or not root then Workspace.CurrentCamera.CFrame.LookVector else root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	return if flat.Magnitude &gt; 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
end

-- Turn the body to a sent attack's aim at once in neutral, or by the shared recovery rate in a combo,
-- so it agrees with the arc the server commits.
function Controller.FaceAttack(self: InputController, x: number, z: number)
	local own = self.State:Own()
	local root, snapshot = own and own.Root, self.State:OwnSnapshot()
	local aim = Strike.yaw(x, z)
	if not root or not aim then
		return
	end
	local look = root.CFrame.LookVector
	local current = Strike.yaw(look.X, look.Z) or aim
	local state = if snapshot then snapshot.State else "Idle"
	local step = if state == "Recovery" then Strike.turnStep("Recovery", 0, 0, snapshot.StateElapsed) else Strike.turnStep(state, 0, 0, 0)
	if step &gt; 0 then
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, Strike.turn(current, aim, step), 0)
	end
end

function Controller.Press(self: InputController, command: Command)
	local callback = self.OnCommand
	if callback then
		callback(command)
	end
	local blocked = self.MenuOpen or GuiService.MenuIsOpen or UserInputService:GetFocusedTextBox() ~= nil
	-- Open menus own every key except cursor release; world interaction waits until they close.
	if blocked and command ~= "Cursor" then
		return
	end
	local stamp = now()
	if command == "Jump" or command == "Slide" or command == "Aim" then
		self.Movement:Press(command)
	elseif command == "Light" or command == "Heavy" or command == "WeaponArt" then
		local aim = self:AttackDirection()
		InputBuffer.push(self.Buffer, command, stamp, nil, aim.X, aim.Z)
	elseif command == "Guard" then
		-- Sekiro rule: a guard press during a feintable windup feints; otherwise it deflects, and
		-- holding it keeps the guard raised once the deflect window closes.
		local snapshot = self.State:OwnSnapshot()
		if snapshot and snapshot.State == "Startup" then
			self.Send("Feint", nil, nil, nil, nil, stamp)
		end
		InputBuffer.push(self.Buffer, "Deflect", stamp)
		if not self.GuardHeld then
			self.GuardHeld = true
			self.Send("Block", nil, nil, nil, true, stamp)
		end
	elseif command == "Roll" or command == "Dash" then
		self.Movement:Release("Slide")
		local direction = self:EvadeDirection()
		InputBuffer.push(self.Buffer, command, stamp, nil, direction.X, direction.Z)
	elseif command == "Sprint" then
		if self.Device == "Gamepad" or self.Device == "Keyboard" then
			self.SprintHeld = not self.SprintHeld
		else
			self.SprintHeld = true
		end
		self.Send("Sprint", nil, nil, nil, self.SprintHeld, stamp)
	elseif command == "Lock" then
		self.Camera:ToggleLock()
	elseif command == "Shoulder" then
		self.Camera:ToggleShoulder()
	elseif command == "Swap" then
		self.Send("Swap", nil, nil, nil, nil, stamp)
	elseif command == "Heal" then
		self.Send("Heal", nil, nil, nil, nil, stamp)
	elseif command == "Interact" then
		-- A visible prompt on the Interact key already owns the press (and runs its hold bar);
		-- sending the intent too would rest or recover twice. Touch USE drives the prompt instead.
		local prompt = self:OwningPrompt()
		if prompt then
			if self.Device == "Touch" then
				heldPrompt = prompt
				prompt:InputHoldBegin()
			end
			return
		end
		self.Send("Interact", nil, nil, nil, nil, stamp)
	elseif command == "Cursor" then
		-- Held, not toggled: Alt-Tab and window focus changes deliver a lone Alt press, which used to
		-- leave the cursor free and mouse look dead until Alt was pressed again.
		self.CursorFree = true
	end
end

-- The newest visible prompt that answers this device's Interact input (InputMap.routeInteract).
function Controller.OwningPrompt(self: InputController): ProximityPrompt?
	local views: { InputMap.PromptView } = {}
	for index, prompt in shownPrompts do
		views[index] = { Enabled = prompt.Enabled, Key = prompt.KeyboardKeyCode.Name, Pad = prompt.GamepadKeyCode.Name }
	end
	local route, index = InputMap.routeInteract(self.Device, views, false)
	return if route == "Prompt" and index then shownPrompts[index] else nil
end

function Controller.Release(self: InputController, command: Command)
	if command == "Jump" or command == "Slide" or command == "Aim" then
		self.Movement:Release(command)
	elseif command == "Interact" and heldPrompt then
		heldPrompt:InputHoldEnd()
		heldPrompt = nil
	elseif command == "Guard" and self.GuardHeld then
		self.GuardHeld = false
		self.Send("Block", nil, nil, nil, false, now())
	elseif command == "Sprint" and self.Device == "Touch" and self.SprintHeld then
		self.SprintHeld = false
		self.Send("Sprint", nil, nil, nil, false, now())
	elseif command == "Cursor" then
		self.CursorFree = false
	end
end

function Controller.Began(self: InputController, input: InputObject, processed: boolean)
	local device: Device? = deviceFor(input.UserInputType)
	if device then
		self:SetDevice(device)
	end
	if input.UserInputType == Enum.UserInputType.Touch then
		if not processed and self.LookTouch == nil and input.Position.X &gt; Workspace.CurrentCamera.ViewportSize.X * 0.4 then
			self.LookTouch = input
		end
		return
	end
	if processed or UserInputService:GetFocusedTextBox() ~= nil then
		return
	end
	local command: Command? = nil
	if input.UserInputType == Enum.UserInputType.Keyboard then
		command = KEYBOARD[input.KeyCode]
	elseif MOUSE[input.UserInputType] then
		command = MOUSE[input.UserInputType]
	elseif device == "Gamepad" then
		command = GAMEPAD[input.KeyCode]
	end
	if command ~= nil then
		self:Press(command :: Command)
	end
end

function Controller.Ended(self: InputController, input: InputObject)
	if input == self.LookTouch then
		self.LookTouch = nil
		return
	end
	local command: Command? = nil
	if input.UserInputType == Enum.UserInputType.Keyboard then
		command = KEYBOARD[input.KeyCode]
	elseif MOUSE[input.UserInputType] then
		command = MOUSE[input.UserInputType]
	elseif deviceFor(input.UserInputType) == "Gamepad" then
		command = GAMEPAD[input.KeyCode]
	end
	if command ~= nil then
		self:Release(command :: Command)
	end
end

function Controller.Changed(self: InputController, input: InputObject, processed: boolean)
	if input.KeyCode == Enum.KeyCode.Thumbstick2 then
		local value = Vector2.new(input.Position.X, -input.Position.Y)
		self.Stick = if value.Magnitude &gt; STICK_DEADZONE then value else Vector2.zero
	elseif input == self.LookTouch and not processed then
		self.TouchLook += Vector2.new(input.Delta.X, input.Delta.Y) * TOUCH_SCALE
	end
end

-- Per frame: route look input to the camera, then flush buffered presses in priority order.
function Controller.Step(self: InputController, dt: number)
	self.Movement:SetEnabled(not self.MenuOpen and not GuiService.MenuIsOpen and UserInputService:GetFocusedTextBox() == nil)
	if self.CursorFree then
		local held = false
		for _, key in CURSOR_KEYS do
			held = held or UserInputService:IsKeyDown(key)
		end
		self.CursorFree = held -- a press whose release never arrived (focus change) must not stick
	end
	local gameplay = not self.MenuOpen and not self.CursorFree and self.Device ~= "Touch"
	UserInputService.MouseBehavior = if gameplay then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = not gameplay
	if not self.MenuOpen then
		if self.Device == "Keyboard" and gameplay then
			local delta = UserInputService:GetMouseDelta()
			if delta.Magnitude &gt; 0 then
				self.Camera:Look(delta)
			end
		elseif self.Device == "Gamepad" then
			if self.Camera.Locked then
				self.Camera:Look(self.Stick, true)
			elseif self.Stick.Magnitude &gt; 0 then
				self.Camera:Look(self.Stick * STICK_SPEED * dt)
			end
		elseif self.Device == "Touch" and self.TouchLook.Magnitude &gt; 0 then
			self.Camera:Look(self.TouchLook)
		end
	end
	self.TouchLook = Vector2.zero
	if GuiService.MenuIsOpen then
		return
	end
	local stamp = now()
	for _ = 1, self.Buffer.Capacity do
		local action, time, variant, x, z = InputBuffer.pop(self.Buffer, stamp)
		if action == nil then
			break
		end
		local attack = action == "Light" or action == "Heavy" or action == "WeaponArt"
		local hasDirection = attack or action == "Roll" or action == "Dash"
		if attack and x and z then
			self:FaceAttack(x, z)
		end
		self.Send(action, if variant ~= "" then variant else nil, if hasDirection then x else nil, if hasDirection then z else nil, nil, time)
	end
end

function Controller.Destroy(self: InputController)
	ContextActionService:UnbindAction(MOVEMENT_ACTION)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	self.TouchGui:Destroy()
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="686">
            <Properties>
              <string name="Name">InterfaceController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/InterfaceController
-- Minimal Souls HUD: curved vitality arcs, inward-filling posture, loadout and gourd, boss
-- encounter bar, lock-on reticle with Deathblow calligraphy, telegraph glyphs, Incense Altar menu
-- and the death screen. Everything is built from instances; no uploaded imagery.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local simFolder = Shared:WaitForChild("Simulation")
local sharedFolder = Shared:WaitForChild("Shared")
local Weapons = require(simFolder:WaitForChild("WeaponSchema") :: ModuleScript) :: any
local Settings = require(sharedFolder:WaitForChild("CombatSettings") :: ModuleScript) :: any
local World = require(sharedFolder:WaitForChild("WorldDefinitions") :: ModuleScript)
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local CameraController = require(script.Parent:WaitForChild("CameraController") :: ModuleScript)
local InputController = require(script.Parent:WaitForChild("InputController") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local HudLayout = require(script.Parent:WaitForChild("HudLayout") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local BossHud = require(script.Parent.BossHud)
local BossMusic = require(script.Parent.BossMusic)
local BossEffects = require(script.Parent.BossEffects)
local BossAnimations = require(script.Parent.BossAnimations)
local DuoBars = require(script.Parent.DuoBars)
local VitalsTags = require(script.Parent.VitalsTags)
local Visibility = require(script.Parent.HudVisibility)
local AltarAscension = require(script.Parent.AltarAscension)
local LevelPreview = require(sharedFolder:WaitForChild("LevelPreview") :: ModuleScript)

type WorldState = WorldState.WorldState
type Entity = WorldState.Entity
type Snapshot = WorldState.Snapshot
type CombatEvent = WorldState.CombatEvent
type Cue = WorldState.Cue
type CameraController = CameraController.CameraController
type InputController = InputController.InputController

local Controller = {}
Controller.__index = Controller

-- Sakura palette (SakuraKit.Colors): plum ink, blossom pink, crimson life, gold trim.
local INK = Sakura.Colors.Ink
local IVORY = Sakura.Colors.Ivory
local MUTED = Color3.fromRGB(190, 156, 176)
local BLOOD = Sakura.Colors.Crimson
local EMBER = Sakura.Colors.Sakura
local BLEED = Sakura.Colors.Blossom
local JADE = Sakura.Colors.Stamina
local GOLD = Sakura.Colors.Gold
local SCAR = Color3.fromRGB(62, 40, 60)
local TRACK = Sakura.Colors.Track
local EDGE = Color3.fromRGB(150, 60, 110)

-- The altar holds the cursor and combat keys while open, so it takes the same back keys as Respite,
-- the Codex and Lin (Roblox reserves Escape). Bound only while open; anything stacked over it closes it.
local ALTAR_BACK = "AsuraAltarBack"
local ALTAR_BACK_KEYS = { Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace }

local TITLE_FONT = Enum.Font.Antique
local BODY_FONT = Enum.Font.Garamond
local NUMBER_FONT = Enum.Font.GothamMedium

local WEAPON_GLYPH: { [string]: string } = { Unarmed = "FIST", Jian = "JIAN", Dao = "DAO", Guandao = "GLAIVE" }
local WEAPON_NAME: { [string]: string } = { Unarmed = "Iron Fist", Jian = "Jian Sword", Dao = "Dao Sabre", Guandao = "Guandao Glaive", None = "—" }
local REASONS: { [string]: string } = {
	GourdEmpty = "The gourd is empty.",
	EnemiesNearby = "Cannot rest while enemies hunt you.",
	InBossFight = "The fog binds you to this fight.",
	NotAtAltar = "Kneel at an Incense Altar first.",
	NoAltar = "There is no altar here.",
	TooFar = "Move closer to the altar.",
	NothingNearby = "Nothing to interact with.",
	WeaponLocked = "That weapon has not been earned.",
	NoOffhand = "No second weapon is carried.",
	AltarNotKindled = "That altar has not been kindled.",
	AlreadyHere = "You already rest here.",
	InsufficientStamina = "Too winded.",
	InsufficientQi = "Not enough Qi.",
	InDuel = "Not during a duel.",
	InColosseum = "The Colosseum forbids it.",
	GourdFull = "Your gourd is already full.",
	Unavailable = "Unavailable right now.",
}

-------------------------------------------------------------------------------------------------
-- Instance helpers
-------------------------------------------------------------------------------------------------

local function make&lt;T&gt;(className: string, parent: Instance?, properties: { [string]: any }): T
	local instance = Instance.new(className :: any)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance :: any
end

local function label(parent: Instance, text: string, size: number, font: Enum.Font, color: Color3, properties: { [string]: any }?): TextLabel
	local result = make("TextLabel", parent, {
		Text = text,
		TextSize = size,
		Font = font,
		TextColor3 = color,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = INK,
	}) :: TextLabel
	if properties then
		for key, value in properties do
			(result :: any)[key] = value
		end
	end
	return result
end

local function corner(parent: Instance, radius: number)
	make("UICorner", parent, { CornerRadius = UDim.new(0, radius) })
end

local function stroke(parent: Instance, color: Color3, thickness: number, transparency: number?)
	make("UIStroke", parent, { Color = color, Thickness = thickness, Transparency = transparency or 0 })
end

-- Altar buttons share the menu kit's hover / press / SFX juice.
local function button(parent: Instance, text: string, size: UDim2, callback: () -&gt; ()): TextButton
	local result = UiKit.button(parent, text, "Secondary", callback)
	result.Size = size
	result.TextSize = 22
	return result
end

local function lerpColor(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, math.clamp(t, 0, 1))
end

-------------------------------------------------------------------------------------------------
-- Curved segmented arc
-------------------------------------------------------------------------------------------------

type Arc = { Segments: { Frame }, Count: number }
type Layer = { Upto: number, Color: Color3 }

local function newArc(parent: Instance, center: Vector2, radius: number, thickness: number, count: number, startDeg: number, sweepDeg: number): Arc
	local segments: { Frame } = {}
	local step = math.rad(sweepDeg) / count
	for index = 1, count do
		local angle = math.rad(startDeg) + step * (index - 0.5)
		local segment = make("Frame", parent, {
			Name = "Segment" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X + math.cos(angle) * radius, center.Y + math.sin(angle) * radius),
			Size = UDim2.fromOffset(radius * step * 1.08, thickness),
			Rotation = math.deg(angle) + 90,
			BackgroundColor3 = TRACK,
			BorderSizePixel = 0,
		}) :: Frame
		segments[index] = segment
	end
	return { Segments = segments, Count = count }
end

-- `visible` (0..1) trims the arc length (it grows with the stat's maximum); layers are cumulative.
local function setArc(arc: Arc, layers: { Layer }, visible: number, emptyColor: Color3)
	local shown = math.clamp(math.floor(arc.Count * visible + 0.5), 1, arc.Count)
	for index, segment in arc.Segments do
		if index &gt; shown then
			segment.Visible = false
		else
			segment.Visible = true
			local position = (index - 0.5) / shown
			local color = emptyColor
			for _, layer in layers do
				if position &lt;= layer.Upto then
					color = layer.Color
					break
				end
			end
			segment.BackgroundColor3 = color
			segment.BackgroundTransparency = if color == emptyColor then 0.35 else 0
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Inward posture bar (fills from both ends toward the centre)
-------------------------------------------------------------------------------------------------

type PostureBar = { Frame: Frame, Left: Frame, Right: Frame, Notch: Frame }

local function newPosture(parent: Instance, size: UDim2, position: UDim2, anchor: Vector2): PostureBar
	local frame = make("Frame", parent, {
		Name = "Posture",
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		BackgroundColor3 = TRACK,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
	}) :: Frame
	corner(frame, 3)
	local left = make("Frame", frame, { Name = "Left", Size = UDim2.fromScale(0, 1), BackgroundColor3 = GOLD, BorderSizePixel = 0 }) :: Frame
	local right = make("Frame", frame, {
		Name = "Right",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
	}) :: Frame
	local notch = make("Frame", frame, {
		Name = "Notch",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 2, 1, 6),
		BackgroundColor3 = IVORY,
		BorderSizePixel = 0,
	}) :: Frame
	return { Frame = frame, Left = left, Right = right, Notch = notch }
end

local function setPosture(bar: PostureBar, ratio: number, broken: boolean)
	local r = math.clamp(ratio, 0, 1)
	local color = if broken then BLOOD elseif r &lt; 0.6 then lerpColor(GOLD, EMBER, r / 0.6) else lerpColor(EMBER, BLOOD, (r - 0.6) / 0.4)
	bar.Left.Size = UDim2.fromScale(r * 0.5, 1)
	bar.Right.Size = UDim2.fromScale(r * 0.5, 1)
	bar.Left.BackgroundColor3 = color
	bar.Right.BackgroundColor3 = color
	bar.Frame.Visible = r &gt; 0.005 or broken
end

-------------------------------------------------------------------------------------------------
-- Construction
-------------------------------------------------------------------------------------------------

type Fields = {
	State: WorldState,
	Camera: CameraController,
	Input: InputController,
	Player: Player,
	Gui: ScreenGui,
	HealthArc: Arc,
	StaminaArc: Arc,
	QiArc: Arc,
	QiText: TextLabel,
	OwnPosture: PostureBar,
	HealthText: TextLabel,
	LevelText: TextLabel,
	WeaponGlyph: TextLabel,
	WeaponName: TextLabel,
	OffhandName: TextLabel,
	ElixirText: TextLabel,
	EssenceText: TextLabel,
	BossFrame: Frame,
	BossTitle: TextLabel,
	BossPhase: TextLabel,
	BossActive: Frame,
	BossRecoverable: Frame,
	BossPosture: PostureBar,
	BossEntity: number?,
	BossId: string?,
	BossMembers: { number },
	BossScore: BossMusic.Score,
	Duo: DuoBars.View,
	Tags: VitalsTags.View,
	Vitals: Frame,
	Loadout: Frame,
	Billboard: BillboardGui,
	LockPosture: PostureBar,
	LockHealth: Frame,
	LockKanji: TextLabel,
	Deathblow: Frame,
	DeathblowKanji: TextLabel,
	DeathblowPrompt: TextLabel,
	Toast: TextLabel,
	ToastUntil: number,
	Banner: TextLabel,
	BannerSub: TextLabel,
	BannerUntil: number,
	Altar: Frame,
	AltarTitle: TextLabel,
	AltarPages: { [string]: Frame },
	AltarId: string?,
	Ascension: AltarAscension.View,
	AltarStatus: TextLabel,
	TravelList: Frame,
	Death: Frame,
	DeathTitle: TextLabel,
	DeathSub: TextLabel,
	DeathDetail: TextLabel,
	DeathShown: boolean,
	-- Essence spilled by the current death; the EssenceLost cue can arrive before or after the KO.
	DeathSpilled: number,
	Veil: Frame,
	Telegraphs: { BillboardGui },
	Connections: { RBXScriptConnection },
	Disconnects: { () -&gt; () },
	OnIntent: ((action: string, variant: string?) -&gt; ())?,
	OnSummon: ((altarId: string) -&gt; ())?, -- set by DialogueController: summon Lin's projection here
	Clock: number,
}

export type Interface = typeof(setmetatable({} :: Fields, Controller))

-- Bottom-left sakura plate (authored at 1080p, scaled with the viewport): blossom medallion,
-- level and essence, then health / stamina / Qi bars and the inward posture bar.
local VITALS_SIZE = Vector2.new(470, 150)
local function plate(gui: ScreenGui, name: string): Frame
	local frame = make("Frame", gui, {
		Name = name, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -12),
		Size = UDim2.fromOffset(VITALS_SIZE.X, VITALS_SIZE.Y), BackgroundTransparency = 1,
	}) :: Frame
	return frame
end

local function buildVitals(gui: ScreenGui): (Arc, Arc, PostureBar, TextLabel, Arc, TextLabel, TextLabel)
	local frame = plate(gui, "Vitals")
	Sakura.medallion(frame, 112, UDim2.fromOffset(60, 84), true, { 35, 200, 305 })
	local level = label(frame, "Lv. 1", 22, TITLE_FONT, IVORY, {
		Name = "Level", Position = UDim2.fromOffset(128, 18), Size = UDim2.fromOffset(120, 26), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local _, health = Sakura.bar(frame, "Health", Vector2.new(128, 48), 300, 18, 60, true)
	Sakura.crest(frame, 24, UDim2.fromOffset(446, 57))
	local text = label(frame, "", 13, NUMBER_FONT, IVORY, {
		Position = UDim2.fromOffset(128, 48), Size = UDim2.fromOffset(300, 18), ZIndex = 5, TextStrokeTransparency = 0.3,
	})
	-- y 68: VitalsTags status line (rally / lowered ceiling) between health and stamina.
	local _, stamina = Sakura.bar(frame, "Stamina", Vector2.new(128, 86), 270, 8, 54, false)
	local _, qi = Sakura.bar(frame, "Qi", Vector2.new(128, 100), 240, 8, 48, false)
	local qiText = label(frame, "QI 100 / 100", 13, NUMBER_FONT, Sakura.Colors.Qi, {
		Position = UDim2.fromOffset(376, 96), Size = UDim2.fromOffset(90, 16), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local posture = newPosture(frame, UDim2.fromOffset(200, 5), UDim2.fromOffset(128, 114), Vector2.new(0, 0))
	return health, stamina, posture, text, qi, qiText, level
end

local function buildLoadout(gui: ScreenGui): (TextLabel, TextLabel, TextLabel, TextLabel, TextLabel)
	local frame = plate(gui, "Loadout")
	local glyph = label(frame, "FIST", 14, TITLE_FONT, IVORY, { Visible = false })
	local name = label(frame, "", 18, BODY_FONT, IVORY, {
		Position = UDim2.fromOffset(128, 124), Size = UDim2.fromOffset(140, 22), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local offhand = label(frame, "", 14, BODY_FONT, MUTED, {
		Position = UDim2.fromOffset(268, 124), Size = UDim2.fromOffset(96, 22), TextXAlignment = Enum.TextXAlignment.Left,
	})
	-- Flask charges as shapes (◆ full, ◇ spent): readable without relying on the colour.
	local elixir = label(frame, "FLASK —", 18, TITLE_FONT, EMBER, {
		Name = "Flask", Position = UDim2.fromOffset(364, 124), Size = UDim2.fromOffset(110, 22), TextXAlignment = Enum.TextXAlignment.Left,
	})
	-- Essence is the currency (banked + carried); Qi is spell energy and lives by the Qi bar.
	local essence = label(frame, "", 20, TITLE_FONT, GOLD, {
		Name = "Essence", Position = UDim2.fromOffset(230, 18), Size = UDim2.fromOffset(216, 26), TextXAlignment = Enum.TextXAlignment.Right,
	})
	return glyph, name, offhand, elixir, essence
end

-- Top-centre boss plate under the compass: serif name, ornate crimson bar with gold diamond caps.
local function buildBoss(gui: ScreenGui): (Frame, TextLabel, TextLabel, Frame, Frame, PostureBar)
	local frame = make("Frame", gui, {
		Name = "BossBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.new(0.5, 0, 0, 96),
		BackgroundTransparency = 1,
		Visible = false,
	}) :: Frame
	make("UISizeConstraint", frame, { MaxSize = Vector2.new(900, 96), MinSize = Vector2.new(300, 96) })
	local title = label(frame, "", 24, TITLE_FONT, IVORY, {
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.3,
	})
	local phase = label(frame, "", 16, BODY_FONT, EMBER, {
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local casing = make("Frame", frame, {
		Name = "Casing", Position = UDim2.fromOffset(-5, 48), Size = UDim2.new(1, 10, 0, 22),
		BackgroundColor3 = INK, BackgroundTransparency = 0.3, BorderSizePixel = 0,
	}) :: Frame
	stroke(casing, GOLD, 1, 0.45)
	Sakura.diamond(casing, 16, UDim2.fromScale(0, 0.5), GOLD, EMBER)
	Sakura.diamond(casing, 16, UDim2.fromScale(1, 0.5), GOLD, EMBER)
	local posture = newPosture(frame, UDim2.new(0.5, 0, 0, 5), UDim2.new(0.5, 0, 0, 84), Vector2.new(0.5, 0))
	local track = make("Frame", frame, {
		Name = "Health",
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = TRACK,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
	}) :: Frame
	stroke(track, EDGE, 1, 0.2)
	local recoverable = make("Frame", track, { Name = "Recoverable", Size = UDim2.fromScale(1, 1), BackgroundColor3 = EMBER, BorderSizePixel = 0 }) :: Frame
	local active = make("Frame", track, { Name = "Active", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }) :: Frame
	make("UIGradient", active, { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(236, 64, 72), Color3.fromRGB(140, 8, 22)) })
	return frame, title, phase, active, recoverable, posture
end

local function buildLockBillboard(gui: ScreenGui): (BillboardGui, PostureBar, Frame, TextLabel)
	local billboard = make("BillboardGui", gui, {
		Name = "LockOn",
		Size = UDim2.fromOffset(140, 150),
		StudsOffset = Vector3.new(0, 1.6, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Enabled = false,
		ResetOnSpawn = false,
	}) :: BillboardGui
	local reticle = make("Frame", billboard, {
		Name = "Reticle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = IVORY,
		BackgroundTransparency = 0.1,
	}) :: Frame
	corner(reticle, 5)
	stroke(reticle, BLOOD, 2)
	local posture = newPosture(billboard, UDim2.new(0.8, 0, 0, 5), UDim2.new(0.5, 0, 0, 6), Vector2.new(0.5, 0))
	local healthTrack = make("Frame", billboard, {
		Name = "Health",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.new(0.6, 0, 0, 4),
		BackgroundColor3 = TRACK,
		BorderSizePixel = 0,
	}) :: Frame
	local health = make("Frame", healthTrack, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLOOD, BorderSizePixel = 0 }) :: Frame
	local kanji = label(billboard, "!", 72, TITLE_FONT, BLOOD, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromOffset(100, 100),
		TextStrokeTransparency = 0.2,
		Visible = false,
	})
	return billboard, posture, health, kanji
end

local function buildDeathblow(gui: ScreenGui): (Frame, TextLabel, TextLabel)
	local frame = make("Frame", gui, {
		Name = "Deathblow",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}) :: Frame
	local kanji = label(frame, "EXECUTE", 80, TITLE_FONT, BLOOD, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromOffset(480, 480),
		TextTransparency = 0.82,
		TextStrokeTransparency = 1,
	})
	local prompt = label(frame, "", 26, TITLE_FONT, IVORY, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.7),
		Size = UDim2.fromOffset(520, 34),
	})
	return frame, kanji, prompt
end

local function buildDeath(gui: ScreenGui): (Frame, TextLabel, TextLabel, TextLabel)
	local frame = make("Frame", gui, {
		Name = "Death",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
	}) :: Frame
	local title = label(frame, "YOU FELL", 84, TITLE_FONT, Color3.fromRGB(168, 24, 26), {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.new(0.9, 0, 0, 100),
		TextScaled = true,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		ZIndex = 21,
	})
	make("UITextSizeConstraint", title, { MinTextSize = 36, MaxTextSize = 84 })
	local sub = label(frame, "SPIRIT SEVERED", 26, BODY_FONT, IVORY, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.85, 0, 0, 34),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		ZIndex = 21,
	})
	local detail = label(frame, "", 18, BODY_FONT, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.new(0.85, 0, 0, 52),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		ZIndex = 21,
	})
	return frame, title, sub, detail
end

function Controller.new(state: WorldState, camera: CameraController, input: InputController): Interface
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
		Name = "AsuraHUD",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
	}) :: ScreenGui
	local healthArc, staminaArc, ownPosture, healthText, qiArc, qiText, levelText = buildVitals(gui)
	local glyph, weaponName, offhand, elixir, essence = buildLoadout(gui)
	local bossFrame, bossTitle, bossPhase, bossActive, bossRecoverable, bossPosture = buildBoss(gui)
	local billboard, lockPosture, lockHealth, lockKanji = buildLockBillboard(gui)
	local deathblow, deathblowKanji, deathblowPrompt = buildDeathblow(gui)
	local death, deathTitle, deathSub, deathDetail = buildDeath(gui)
	-- Full-screen veil for portal transitions (above the HUD, below nothing interactive).
	local veil = make("Frame", gui, {
		Name = "PortalVeil",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(242, 234, 255),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 50,
		Visible = false,
	}) :: Frame
	-- Kept to the centre band between the side columns (HudLayout.Toast; F08: the gourd refusal ran
	-- under the training card) and wrapped onto a second line rather than clipped.
	local toast = label(gui, "", 22, BODY_FONT, IVORY, {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -HudLayout.Toast.Bottom),
		Size = UDim2.new(1, -2 * HudLayout.Toast.Side, 0, HudLayout.Toast.Height),
		TextScaled = true,
		TextWrapped = true,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	make("UISizeConstraint", toast, { MaxSize = Vector2.new(HudLayout.Toast.MaxWidth, HudLayout.Toast.Height) })
	make("UITextSizeConstraint", toast, { MinTextSize = 14, MaxTextSize = 22 })
	local banner = label(gui, "", 27, TITLE_FONT, IVORY, {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.22),
		Size = UDim2.new(0.84, 0, 0, 42),
		TextScaled = true,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	make("UITextSizeConstraint", banner, { MinTextSize = 14, MaxTextSize = 27 })
	local bannerSub = label(gui, "", 16, BODY_FONT, MUTED, {
		Name = "BannerSub",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.22, 24),
		Size = UDim2.new(0.8, 0, 0, 24),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})

	local fields: Fields = {
		State = state,
		Camera = camera,
		Input = input,
		Player = player,
		Gui = gui,
		HealthArc = healthArc,
		StaminaArc = staminaArc,
		QiArc = qiArc,
		QiText = qiText,
		OwnPosture = ownPosture,
		HealthText = healthText,
		LevelText = levelText,
		WeaponGlyph = glyph,
		WeaponName = weaponName,
		OffhandName = offhand,
		ElixirText = elixir,
		EssenceText = essence,
		BossFrame = bossFrame,
		BossTitle = bossTitle,
		BossPhase = bossPhase,
		BossActive = bossActive,
		BossRecoverable = bossRecoverable,
		BossPosture = bossPosture,
		BossEntity = nil,
		BossId = nil, BossMembers = {}, BossScore = BossMusic.new(), Duo = DuoBars.new(bossFrame, gui),
		Tags = VitalsTags.build(gui:FindFirstChild("Vitals") :: Frame), Vitals = gui:FindFirstChild("Vitals") :: Frame, Loadout = gui:FindFirstChild("Loadout") :: Frame,
		Billboard = billboard,
		LockPosture = lockPosture,
		LockHealth = lockHealth,
		LockKanji = lockKanji,
		Deathblow = deathblow,
		DeathblowKanji = deathblowKanji,
		DeathblowPrompt = deathblowPrompt,
		Toast = toast,
		ToastUntil = 0,
		Banner = banner,
		BannerSub = bannerSub,
		BannerUntil = 0,
		Altar = (nil :: any) :: Frame,
		AltarTitle = (nil :: any) :: TextLabel,
		AltarPages = {},
		AltarId = nil,
		Ascension = (nil :: any) :: AltarAscension.View,
		AltarStatus = (nil :: any) :: TextLabel,
		TravelList = (nil :: any) :: Frame,
		Death = death,
		Veil = veil,
		DeathTitle = deathTitle,
		DeathSub = deathSub,
		DeathDetail = deathDetail,
		DeathShown = false,
		DeathSpilled = 0,
		Telegraphs = {},
		Connections = {},
		Disconnects = {},
		OnIntent = nil,
		OnSummon = nil,
		Clock = 0,
	}
	local self = setmetatable(fields, Controller)
	self:BuildAltar()
	-- Panels are authored at 1080p; scale them with the viewport so phones stay legible and
	-- large displays don't shrink the HUD to a corner.
	for name, base in { Vitals = 0.78, Loadout = 0.78, AltarMenu = 0.8 } do
		local panel = gui:FindFirstChild(name)
		if panel and panel:IsA("GuiObject") then
			local floor = if name == "AltarMenu" then nil else HudLayout.Regions.Vitals.MinScale -- loadout shares the vitals plate
			table.insert(self.Disconnects, HudKit.bindScale(panel, base, floor))
		end
	end

	table.insert(self.Disconnects, state:OnCue(function(cue: Cue)
		self:OnCue(cue)
	end))
	table.insert(self.Disconnects, state:OnEvent(function(event: CombatEvent)
		self:OnEvent(event)
	end))
	table.insert(self.Connections, player:GetAttributeChangedSignal("AsuraResult"):Connect(function()
		local result = player:GetAttribute("AsuraResult")
		if type(result) == "string" and string.sub(result, 1, 1) == "!" then
			local reason = string.sub(result, 2)
			local text = REASONS[reason]
			if text then
				self:ShowToast(text)
			end
		end
	end))
	table.insert(self.Connections, player:GetAttributeChangedSignal("AsuraRegion"):Connect(function()
		local region = player:GetAttribute("AsuraRegion")
		local definition = if type(region) == "string" then World.Regions[region :: any] else nil
		if definition then
			self:ShowBanner(string.upper(definition.Name), "", 3)
		end
	end))
	return self
end

-------------------------------------------------------------------------------------------------
-- Incense Altar menu
-------------------------------------------------------------------------------------------------

function Controller.Intent(self: Interface, action: string, variant: string?)
	local callback = self.OnIntent
	if callback then
		callback(action, variant)
	end
end

function Controller.ShowPage(self: Interface, page: string)
	for name, frame in self.AltarPages do
		frame.Visible = name == page
	end
	if page == "Travel" then
		self:RefreshTravel()
	elseif page == "Level" then
		self:RefreshLevel()
	end
end

function Controller.BuildAltar(self: Interface)
	local frame = make("Frame", self.Gui, {
		Name = "AltarMenu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 60, 0.5, 0),
		Size = UDim2.fromOffset(380, 440),
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.12,
		Visible = false,
		ZIndex = 5,
	}) :: Frame
	make("UIScale", frame, { Scale = 0.8 })
	corner(frame, 6)
	stroke(frame, EDGE, 2)
	make("UIPadding", frame, {
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
		PaddingTop = UDim.new(0, 14),
	})
	local title = label(frame, "Incense Altar", 30, TITLE_FONT, IVORY, {
		Size = UDim2.new(1, 0, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	label(frame, "RESTING SITE", 16, TITLE_FONT, EMBER, {
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local function page(name: string): Frame
		local container = make("Frame", frame, {
			Name = name,
			Position = UDim2.fromOffset(0, 70),
			Size = UDim2.new(1, 0, 1, -84),
			BackgroundTransparency = 1,
			Visible = false,
		}) :: Frame
		make("UIListLayout", container, { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
		self.AltarPages[name] = container
		return container
	end

	-- Resting already set the checkpoint and refilled the flask (server restAt); the menu only
	-- offers deliberate next steps. Lin is summoned on request, never forced open by resting.
	local main = page("Main")
	self.AltarStatus = label(main, "Rested  ·  checkpoint set  ·  flask refilled", 16, BODY_FONT, MUTED, {
		Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0,
	})
	button(main, "Ascension", UDim2.new(1, 0, 0, 46), function()
		self:ShowPage("Level")
	end).LayoutOrder = 1
	button(main, "Summon Lady Lin", UDim2.new(1, 0, 0, 46), function()
		local altarId, summon = self.AltarId, self.OnSummon
		if altarId and summon then summon(altarId) end
	end).LayoutOrder = 2
	button(main, "Travel", UDim2.new(1, 0, 0, 46), function()
		self:ShowPage("Travel")
	end).LayoutOrder = 3
	button(main, "Leave", UDim2.new(1, 0, 0, 46), function()
		self:CloseAltar()
	end).LayoutOrder = 4

	local level = page("Level")
	self.Ascension = AltarAscension.build(level, function(attribute: string)
		self:Intent("LevelUp", attribute)
	end)
	button(level, "Back", UDim2.new(1, 0, 0, 40), function()
		self:ShowPage("Main")
	end).LayoutOrder = 10

	local travel = page("Travel")
	local list = make("ScrollingFrame", travel, {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -52),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		LayoutOrder = 1,
	}) :: ScrollingFrame
	make("UIListLayout", list, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	self.TravelList = list
	button(travel, "Back", UDim2.new(1, 0, 0, 40), function()
		self:ShowPage("Main")
	end).LayoutOrder = 2

	self.Altar = frame
	self.AltarTitle = title
end

function Controller.RefreshLevel(self: Interface)
	AltarAscension.refresh(self.Ascension, self.Player)
end

function Controller.RefreshTravel(self: Interface)
	for _, child in self.TravelList:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local raw = self.Player:GetAttribute("AsuraAltars")
	local current = self.AltarId
	local index = 0
	for id in string.gmatch(if type(raw) == "string" then raw else "", "[^,]+") do
		local altar = World.Altars[id]
		if altar then
			index += 1
			local region = World.Regions[altar.Region]
			local entry = button(self.TravelList, altar.Name .. "   —   " .. region.Name, UDim2.new(1, -8, 0, 40), function()
				self:Intent("Travel", id)
			end)
			entry.TextSize = 17
			entry.LayoutOrder = index
			if id == current then
				entry.AutoButtonColor = false
				entry.TextColor3 = MUTED
				entry.Text = altar.Name .. "   (here)"
			end
		end
	end
end

function Controller.OpenAltar(self: Interface, altarId: string)
	local altar = World.Altars[altarId]
	self.AltarId = altarId
	self.AltarTitle.Text = if altar then altar.Name else "Incense Altar"
	self.Altar.Visible = true
	self.Input:SetMenu(true, "Altar")
	self:ShowPage("Main")
	-- Back steps out of Ascension/Travel first, then leaves the altar.
	ContextActionService:BindActionAtPriority(ALTAR_BACK, function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			if self.AltarPages.Main.Visible then self:CloseAltar() else self:ShowPage("Main") end
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 2, table.unpack(ALTAR_BACK_KEYS))
	if UserInputService.GamepadEnabled then
		GuiService.SelectedObject = self.AltarPages.Main:FindFirstChildWhichIsA("TextButton", true)
	end
	-- Spring the altar in from the left; the authored UIScale (0.8) is the rest size.
	local scale = self.Altar:FindFirstChildOfClass("UIScale")
	if scale then
		scale.Scale = 0.72
		TweenService:Create(scale, UiKit.Motion.Open, { Scale = 0.8 }):Play()
	end
	self.Altar.Position = UDim2.new(0, 60 - UiKit.Motion.SlidePixels * 2, 0.5, 0)
	TweenService:Create(self.Altar, UiKit.Motion.Open, { Position = UDim2.new(0, 60, 0.5, 0) }):Play()
	UiKit.play("Open")
end

function Controller.CloseAltar(self: Interface)
	if not self.Altar.Visible then
		return
	end
	self.Altar.Visible = false
	self.AltarId = nil
	ContextActionService:UnbindAction(ALTAR_BACK)
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(self.Altar) then GuiService.SelectedObject = nil end
	self.Input:SetMenu(false, "Altar")
	UiKit.play("Close")
end

-------------------------------------------------------------------------------------------------
-- Transient text
-------------------------------------------------------------------------------------------------

function Controller.ShowToast(self: Interface, text: string)
	if not Visibility.of(self).Notices then return end -- nothing stale outlives the death screen
	self.Toast.Text = text
	self.Toast.TextTransparency = 0
	self.Toast.TextStrokeTransparency = 0.6
	self.ToastUntil = os.clock() + 2.4
end

function Controller.ShowBanner(self: Interface, title: string, subtitle: string, duration: number)
	if not Visibility.of(self).Notices then return end
	self.Banner.TextColor3 = IVORY
	self.Banner.Position = UDim2.fromScale(0.5, 0.22)
	self.BannerSub.Position = UDim2.fromScale(0.5, 0.27)
	local constraint = self.Banner:FindFirstChildOfClass("UITextSizeConstraint")
	if constraint then constraint.MaxTextSize = 27 end
	self.Banner.Text = title
	self.BannerSub.Text = subtitle
	self.Banner.TextTransparency = 0
	self.BannerSub.TextTransparency = 0
	self.Banner.TextStrokeTransparency = 0.5
	self.BannerSub.TextStrokeTransparency = 0.6
	self.BannerUntil = os.clock() + duration
end

function Controller.Telegraph(self: Interface, entity: Entity, class: string, impact: number)
	local root = entity.Root
	if not root then
		return
	end
	local perilous = class == "Perilous"
	local billboard = make("BillboardGui", self.Gui, {
		Name = "Telegraph",
		Adornee = root,
		Size = UDim2.fromOffset(if perilous then 110 else 50, if perilous then 110 else 50),
		StudsOffset = Vector3.new(0, if entity.Boss then 5.5 else 4, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
	}) :: BillboardGui
	local glyph = label(billboard, "!", if perilous then 96 else 40, TITLE_FONT, if perilous then BLOOD else IVORY, {
		Size = UDim2.fromScale(1, 1),
		TextStrokeTransparency = 0.1,
	})
	table.insert(self.Telegraphs, billboard)
	local remaining = math.max(impact - workspace:GetServerTimeNow(), 0.15) + 0.25
	TweenService:Create(glyph, TweenInfo.new(remaining, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	task.delay(remaining, function()
		local index = table.find(self.Telegraphs, billboard)
		if index then
			table.remove(self.Telegraphs, index)
		end
		billboard:Destroy()
	end)
end

-------------------------------------------------------------------------------------------------
-- Cues and events
-------------------------------------------------------------------------------------------------

function Controller.ShowDeath(self: Interface)
	-- A Colosseum defeat is not a death: no essence is spilled and the duel result is shown instead.
	if self.DeathShown or type(self.Player:GetAttribute("AsuraColosseum")) == "string" then
		return
	end
	self.DeathShown = true
	self:CloseAltar()
	-- Clear anything mid-flight so the death screen stands alone.
	self.Toast.TextTransparency, self.Toast.TextStrokeTransparency, self.ToastUntil = 1, 1, 0
	self.Banner.TextTransparency, self.BannerSub.TextTransparency, self.BannerUntil = 1, 1, 0
	local frame = self.Death
	frame.Visible = true
	frame.BackgroundTransparency = 1
	self:DeathNote(self.DeathSpilled)
	local info = TweenInfo.new(1.6, Enum.EasingStyle.Sine)
	TweenService:Create(frame, info, { BackgroundTransparency = 0.05 }):Play()
	TweenService:Create(self.DeathTitle, TweenInfo.new(2.2, Enum.EasingStyle.Sine), { TextTransparency = 0, TextStrokeTransparency = 0.4 }):Play()
	TweenService:Create(self.DeathSub, TweenInfo.new(2.8, Enum.EasingStyle.Sine), { TextTransparency = 0.1 }):Play()
	TweenService:Create(self.DeathDetail, TweenInfo.new(3.2, Enum.EasingStyle.Sine), { TextTransparency = 0.2 }):Play()
end

-- Loss, wake point and recovery goal, in that order.
function Controller.DeathNote(self: Interface, spilled: number)
	self.DeathSpilled = spilled
	local altarId = self.Player:GetAttribute("AsuraActiveAltar")
	local altar = if type(altarId) == "string" then World.Altars[altarId] else nil
	local lines = {}
	if spilled &gt; 0 then table.insert(lines, string.format("%d essence spilled — reclaim it from your bloodstain", spilled)) end
	if altar then table.insert(lines, "You will wake at " .. altar.Name) end
	self.DeathDetail.Text = table.concat(lines, "\n")
end

function Controller.HideDeath(self: Interface)
	if not self.DeathShown then
		return
	end
	self.DeathShown = false
	self.DeathSpilled = 0
	local info = TweenInfo.new(1.2, Enum.EasingStyle.Sine)
	TweenService:Create(self.Death, info, { BackgroundTransparency = 1 }):Play()
	for _, text in { self.DeathTitle, self.DeathSub, self.DeathDetail } do
		TweenService:Create(text, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end
	task.delay(1.25, function()
		if not self.DeathShown then
			self.Death.Visible = false
		end
	end)
end

-- Fades to the portal's light, holds while the server moves the fighter, then fades back in.
function Controller.Transition(self: Interface, fade: number, destination: string)
	local veil = self.Veil
	veil.Visible = true
	veil.BackgroundTransparency = 1
	self:CloseAltar()
	TweenService:Create(veil, TweenInfo.new(fade, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { BackgroundTransparency = 0 }):Play()
	task.delay(fade + 0.35, function()
		local out = TweenService:Create(veil, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
		out.Completed:Connect(function()
			if veil.BackgroundTransparency &gt;= 0.99 then
				veil.Visible = false
			end
		end)
		out:Play()
		if destination ~= "" then
			self:ShowBanner(string.upper(destination), "Arrived · the altar ahead is your checkpoint", 2.6)
		end
	end)
end

function Controller.OnEvent(self: Interface, event: CombatEvent)
	if event.Kind == "KO" and event.Target == self.State.LocalId then
		self:ShowDeath()
		BossMusic.stop(self.BossScore)
	elseif event.Kind == "StanceBreak" and event.Target == self.State.LocalId then
		self:ShowToast("Posture broken!")
	end
end

function Controller.OnCue(self: Interface, cue: Cue)
	local own = self.State.LocalId
	local data = cue.Data
	local isBossCue = string.sub(cue.Kind, 1, 4) == "Boss" or cue.Kind == "FogGateSealed"
	local ownEncounter = self.Player:GetAttribute("AsuraEncounter")
	if isBossCue then
		local participants = data.participants
		local entity = self.State:Get(cue.Source)
		local encounter = data.boss or (entity and entity.Model:GetAttribute("AsuraEncounter"))
		local included = type(participants) == "table" and table.find(participants, own) ~= nil
		local involved = encounter ~= nil and (encounter == self.BossId or encounter == ownEncounter)
		if cue.Kind == "BossParticipantLeft" then involved = cue.Source == own end
		if not included and not involved then return end
	end
	local sourceEntity = self.State:Get(cue.Source)
	if isBossCue or (sourceEntity and sourceEntity.Model:GetAttribute("AsuraEncounter") == self.BossId and self.BossId ~= nil) then
		BossEffects.cue(cue, self.State)
		if sourceEntity and (cue.Kind == "Telegraph" or cue.Kind == "BossPhase" or cue.Kind == "BossEnrage") then
			BossAnimations.action(sourceEntity.Model, cue.Kind ~= "Telegraph", data.move, data.kind)
		end
	end
	if cue.Kind == "AltarRest" and cue.Source == own then
		local altarId = tostring(data.altar or "")
		self:ShowBanner("ALTAR KINDLED", tostring(data.name or ""), 2.5)
		self:OpenAltar(altarId)
	elseif cue.Kind == "AltarTravel" and cue.Source == own then
		self:ShowToast("You walk the incense road.")
	elseif cue.Kind == "LevelUp" and cue.Source == own then
		local attribute = tostring(data.attribute or "")
		self:ShowToast((LevelPreview.Labels[attribute] or attribute) .. " deepens.")
		task.delay(0.6, function()
			if self.Altar.Visible then
				self:RefreshLevel()
			end
		end)
	elseif cue.Kind == "LevelRefused" and cue.Source == own then
		self:ShowToast(if data.reason == "Not enough essence" then "Not enough essence." else "Cannot grow further.")
	elseif cue.Kind == "EssenceLost" and cue.Source == own then
		self:DeathNote(tonumber(data.amount) or 0)
	elseif cue.Kind == "EssenceRecovered" and cue.Source == own then
		self:ShowToast(string.format("Essence reclaimed  +%d", tonumber(data.amount) or 0))
	elseif cue.Kind == "BossIntro" or cue.Kind == "FogGateSealed" then
		self.BossEntity = cue.Source
		self.BossId = tostring(data.boss or "")
		if type(data.members) == "table" then self.BossMembers = data.members
		elseif #self.BossMembers == 0 then self.BossMembers = { cue.Source } end
		local boss = World.Bosses[self.BossId :: string]
		self.BossTitle.Text = if boss then boss.Name else tostring(data.title or "")
		BossHud.decorate(self.BossFrame, if boss then boss.Title else "", if boss then math.max(#boss.Phases, #self.BossMembers) else 1)
		if DuoBars.bind(self.Duo, self.BossMembers, DuoBars.lockKey(self.Input.Device)) and boss then
			self.BossTitle.Text = string.match(boss.Title, "^([^:]+)") or boss.Name -- each member is named on its own row
		end
		self.BossPhase.Text = tostring(data.name or "")
		self.BossFrame.Visible = true
		BossMusic.set(self.BossScore, self.BossId :: string, 1)
	elseif cue.Kind == "BossPhase" or cue.Kind == "BossEnrage" then
		self.BossPhase.Text = tostring(data.name or "")
		if data.survivor and #self.Duo.Rows == 0 then self.BossTitle.Text = tostring(data.survivor) end
		self:ShowBanner(string.upper(tostring(data.name or "")), "", 2.4)
		if data.shot == nil then self.Camera:BossShot(cue.Source, tonumber(data.duration) or 2.4) end -- handoff shots: EncounterHandoffController
		BossMusic.set(self.BossScore, self.BossId or "", tonumber(data.phase) or 2)
	elseif cue.Kind == "BossFinish" then
		self.Camera:BossShot(cue.Source, 1.3, true)
	elseif cue.Kind == "BossKneel" then
		self:ShowToast("Ankles shattered — strike the head!")
	elseif cue.Kind == "BossGrab" and data.target == own then
		self.Camera:BossShot(cue.Source, tonumber(data.duration) or 1.2)
	elseif cue.Kind == "BossDefeated" then
		self:ShowBanner(tostring(data.banner or "GREAT FOE VANQUISHED"), string.format("+%d essence", tonumber(data.essence) or 0), 4)
		self.Banner.TextColor3 = GOLD
		self.Banner.ZIndex, self.BannerSub.ZIndex = 20, 20
		self.Banner.Position = UDim2.fromScale(0.5, 0.45)
		self.BannerSub.Position = UDim2.fromScale(0.5, 0.51)
		local victoryVeil = self.Gui:FindFirstChild("VictoryVeil")
		if victoryVeil then victoryVeil:Destroy() end
		local veil = make("Frame", self.Gui, { Name = "VictoryVeil", Position = UDim2.fromScale(0, 0.36), Size = UDim2.fromScale(1, 0.22),
			BackgroundColor3 = INK, BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 19 }) :: Frame
		TweenService:Create(veil, TweenInfo.new(4), { BackgroundTransparency = 1 }):Play()
		task.delay(4.2, function() veil:Destroy() end)
		self.Banner.TextSize = 44
		local constraint = self.Banner:FindFirstChildOfClass("UITextSizeConstraint")
		if constraint then constraint.MaxTextSize = 44 end
		HudKit.cue(HudKit.Sounds.Objective, 0.8, 0.7)
		HudKit.cue(HudKit.Sounds.Tick, 0.65, 1.4)
		self.BossEntity, self.BossId, self.BossMembers = nil, nil, {}
		self.BossFrame.Visible = false
		DuoBars.clear(self.Duo)
		BossMusic.stop(self.BossScore)
		task.delay(12, BossAnimations.prune) -- the corpse is removed after EnemyCorpseTime
	elseif cue.Kind == "BossReset" or cue.Kind == "BossParticipantLeft" then
		BossAnimations.prune()
		self.BossEntity, self.BossId, self.BossMembers = nil, nil, {}
		self.BossFrame.Visible = false
		DuoBars.clear(self.Duo)
		BossMusic.stop(self.BossScore)
	elseif cue.Kind == "PortalTransit" and cue.Source == own then
		local fade = tonumber(data.fade) or 0.5
		self:Transition(fade, tostring(data.name or ""))
		task.delay(fade + 0.2, function() -- arrival faces the checkpoint; bring the view round with it
			local body = self.State:Own()
			if body and body.Root then self.Camera:Face(body.Root.CFrame.LookVector) end
		end)
	elseif cue.Kind == "HealRefused" and cue.Source == own then
		self:ShowToast(if data.reason == "AtCeiling" then "At your lowered ceiling · gourd kept · rest restores maximum health"
			else string.format("Health is full · gourd kept (%d left)", tonumber(data.charges) or 0))
	elseif cue.Kind == "RavineReturn" and cue.Source == own then
		self:ShowToast("The ravine mist carries you back to the bridge.")
	elseif cue.Kind == "MistReturn" and cue.Source == own then
		self:ShowToast("The mist carries you back to " .. tostring(data.place or "safe ground") .. ".")
	elseif cue.Kind == "SanctuaryCatch" and cue.Source == own then
		self:ShowToast("The clouds return you to the bonfire.")
	elseif cue.Kind == "WeaponReinforced" and cue.Source == own then
		local weapon = tostring(data.weapon or "")
		self:ShowBanner("WEAPON REINFORCED", string.format("%s  +%d", WEAPON_NAME[weapon] or weapon, tonumber(data.level) or 0), 2.6)
	elseif cue.Kind == "ReinforceRefused" and cue.Source == own then
		local reason = tostring(data.reason or "")
		if reason == "Not enough essence" then
			self:ShowToast(string.format("The smith asks %d essence.", tonumber(data.cost) or 0))
		elseif reason == "Reinforcement at maximum" then
			self:ShowToast("This blade can be forged no further.")
		elseif reason == "Weapon is locked" then
			self:ShowToast("That weapon has not been earned.")
		else
			self:ShowToast("The smith sets down his hammer.")
		end
	elseif cue.Kind == "GourdRefilled" and cue.Source == own then
		self:ShowToast(string.format("Gourd refilled  (x%d)", tonumber(data.charges) or 0))
	elseif cue.Kind == "Telegraph" then
		local entity = self.State:Get(cue.Source)
		if entity and type(data.impact) == "number" then
			if entity.Boss then self:Telegraph(entity, tostring(data.class or "Heavy"), data.impact) end -- mobs: EnemyBars
			-- Perilous counters are named by CombatCallouts.warn (top callout priority), not a toast.
		end
	end
end

-------------------------------------------------------------------------------------------------
-- Per-frame refresh
-------------------------------------------------------------------------------------------------

function Controller.UpdateVitals(self: Interface, snapshot: Snapshot)
	local maxHP = math.max(snapshot.MaxHP, 1)
	local active = snapshot.ActiveHP / maxHP
	local recoverable = (snapshot.ActiveHP + snapshot.RecoverableHP) / maxHP
	local ceiling = (maxHP - snapshot.PermanentDeficit) / maxHP
	local bleed = lerpColor(EMBER, BLEED, 0.5 + 0.5 * math.sin(self.Clock * 6))
	setArc(self.HealthArc, {
		{ Upto = active, Color = BLOOD },
		{ Upto = recoverable, Color = if snapshot.RallyActive then bleed else EMBER },
		{ Upto = ceiling, Color = TRACK },
		{ Upto = 1, Color = SCAR },
	}, math.clamp(maxHP / 200, 0.5, 1), TRACK)
	local stamina = snapshot.Stamina / math.max(snapshot.MaxStamina, 1)
	setArc(self.StaminaArc, { { Upto = stamina, Color = if snapshot.State == "StaminaBroken" then MUTED else JADE } }, math.clamp(snapshot.MaxStamina / 200, 0.5, 1), TRACK)
	local maxQi=if self.Player:GetAttribute("AsuraColosseum") and self.Player:GetAttribute("AsuraArenaNormalized")==true then 130 else (tonumber(self.Player:GetAttribute("AsuraMaxQi")) or 100)
 self.QiText.Text = string.format("QI %d / %d",math.floor(snapshot.Qi),maxQi)
	setArc(self.QiArc, { { Upto = snapshot.Qi / maxQi, Color = lerpColor(Sakura.Colors.Qi,BLEED,snapshot.Qi/maxQi) } }, 1, TRACK)
	setPosture(self.OwnPosture, snapshot.Posture / math.max(snapshot.PostureCapacity, 1), snapshot.State == "StanceBroken")
	self.HealthText.Text = string.format("%d / %d", math.floor(snapshot.ActiveHP + 0.5), math.floor(maxHP - snapshot.PermanentDeficit + 0.5))
	self.WeaponGlyph.Text = WEAPON_GLYPH[snapshot.Weapon] or "FIST"
	self.WeaponName.Text = Weapons.get(snapshot.Weapon).Name
	VitalsTags.update(self.Tags, snapshot, self.Clock)
end

function Controller.UpdateLock(self: Interface, own: Entity?, ownSnapshot: Snapshot?)
	local target = self.Camera:LockedEntity()
	local snapshot = target and target.Snapshot
	if not target or not target.Root or not snapshot or not Visibility.of(self).Combat then
		self.Billboard.Enabled = false
		self.Deathblow.Visible = false
		return
	end
	self.Billboard.Adornee = target.Root
	self.Billboard.StudsOffset = Vector3.new(0, if target.Boss then 3 else 1.6, 0)
	self.Billboard.Enabled = true
	-- Health and posture for the locked foe live on its EnemyBars plate and the TargetPlate.
	self.LockPosture.Frame.Visible = false
	(self.LockHealth.Parent :: Frame).Visible = false
	local distance = if own and own.Root then ((target.Root :: BasePart).Position - (own.Root :: BasePart).Position).Magnitude else math.huge
	local ready = snapshot.State == "StanceBroken" and distance &lt;= Settings.Deathblow.Range + 0.5
		and ownSnapshot ~= nil and ownSnapshot.State ~= "KO"
	self.LockKanji.Visible = snapshot.State == "StanceBroken"
	self.LockKanji.TextTransparency = if ready then 0 else 0.55
	self.Deathblow.Visible = ready
	if ready then
		local pulse = 0.5 + 0.5 * math.sin(self.Clock * 7)
		self.DeathblowKanji.TextTransparency = 0.7 + 0.15 * pulse
		local key = self.Input:Label("Heavy")
		self.DeathblowPrompt.Text = if key ~= "" then string.format("DEATHBLOW   [%s]", key) else "DEATHBLOW   [HEAVY]"
	end
end

function Controller.UpdateBoss(self: Interface)
	if self.BossEntity == nil then return end
	for _, id in self.BossMembers do
		local entity = self.State:Get(id)
		if entity then BossAnimations.sync(entity.Model) end
	end
	if #self.Duo.Rows &gt; 0 then
		DuoBars.update(self.Duo, self.State, self.Camera:LockedEntity(), not Visibility.of(self).Boss)
		return
	end
	local active, recoverable, posture, broken = BossHud.values(self.BossFrame, self.State, self.BossMembers)
	self.BossActive.Size = UDim2.fromScale(active, 1)
	self.BossRecoverable.Size = UDim2.fromScale(recoverable, 1)
	setPosture(self.BossPosture, posture, broken)
end

function Controller.Update(self: Interface, dt: number)
	self.Clock += dt
	local now = os.clock()
	local own = self.State:Own()
	local snapshot = own and own.Snapshot
	if snapshot then
		self:UpdateVitals(snapshot)
		if snapshot.State == "KO" then
			self:ShowDeath()
		elseif self.DeathShown then
			self:HideDeath()
		end
	end
	self:UpdateLock(own, snapshot)
	self:UpdateBoss()
	local layers = Visibility.of(self)
	self.Vitals.Visible, self.Loadout.Visible = layers.Vitals, layers.Vitals
	self.BossFrame.Visible = self.BossEntity ~= nil and layers.Boss

	local player = self.Player
	local elixirs = tonumber(player:GetAttribute("AsuraElixirs")) or 0
	local maximum = tonumber(player:GetAttribute("AsuraElixirsMax")) or 0
	self.ElixirText.Text = VitalsTags.flask(elixirs, maximum)
	local low = maximum &gt; 0 and elixirs &lt;= 1
	self.ElixirText.TextColor3 = if elixirs == 0 then MUTED elseif low then lerpColor(EMBER, BLOOD, 0.5 + 0.5 * math.sin(self.Clock * 5)) else EMBER
	self.ElixirText.TextTransparency = if maximum &gt; 0 then 0 else 0.4
	local offhand = player:GetAttribute("AsuraOffhand")
	self.OffhandName.Text = if type(offhand) == "string" and offhand ~= "None" then "Off: " .. (WEAPON_NAME[offhand] or offhand) else ""
	local essence = tonumber(player:GetAttribute("AsuraEssence")) or 0
	local unbanked = tonumber(player:GetAttribute("AsuraUnbanked")) or 0
	self.EssenceText.Text = if unbanked &gt; 0 then string.format("%d ESSENCE  +%d carried", essence, unbanked) else string.format("%d ESSENCE", essence)
	self.LevelText.Text = string.format("Lv. %d", tonumber(player:GetAttribute("AsuraLevel")) or 1)

	if self.Altar.Visible then
		local altar = if self.AltarId then World.Altars[self.AltarId] else nil
		local root = own and own.Root
		if not altar or not root then
			self:CloseAltar()
		else
			local p = altar.Placement
			if (root.Position - Vector3.new(p.X, p.Y, p.Z)).Magnitude &gt; altar.Radius + 6 then
				self:CloseAltar()
			end
		end
	end

	if now &gt; self.ToastUntil and self.Toast.TextTransparency &lt; 1 then
		self.Toast.TextTransparency = math.min(1, self.Toast.TextTransparency + dt * 2)
		self.Toast.TextStrokeTransparency = math.max(self.Toast.TextTransparency, 0.6)
	end
	if now &gt; self.BannerUntil and self.Banner.TextTransparency &lt; 1 then
		local fade = math.min(1, self.Banner.TextTransparency + dt * 1.2)
		self.Banner.TextTransparency = fade
		self.BannerSub.TextTransparency = fade
		self.Banner.TextStrokeTransparency = math.max(fade, 0.5)
		self.BannerSub.TextStrokeTransparency = math.max(fade, 0.6)
	end
end

function Controller.Destroy(self: Interface)
	BossMusic.stop(self.BossScore)
	BossAnimations.clear()
	for _, disconnect in self.Disconnects do
		disconnect()
	end
	table.clear(self.Disconnects)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	ContextActionService:UnbindAction(ALTAR_BACK)
	self.Input:SetMenu(false, "Altar")
	self.Gui:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="687">
            <Properties>
              <string name="Name">LandscapeBudget</string>
              <string name="Source">--!strict
-- Client-only landscape cost control. Geometry/physics, prompts and authority stay on the server.
-- Small dressing fades by projected size, while the goddess, sacred canopy, roof silhouettes,
-- cliffs, water and real Atmosphere remain. No per-frame descendant walks or new connections.
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").AsurasPath.Shared
local Effects = require(Shared.EffectsPreference)
local Budget = {}
Budget.__index = Budget
local protected = { "Lantern", "Frosted", "Sheltered", "Paper", "WarmLight", "Candle", "Column_", "Roof_", "Beam_" }

local function position(item: Instance): Vector3?
	local parent = item.Parent
	if parent and parent:IsA("BasePart") then return parent.Position end
	if parent and parent:IsA("Attachment") then return parent.WorldPosition end
	return nil
end

local function keep(part: BasePart): boolean
	if part:GetAttribute("AsuraHeroFoliage") then return true end
	for _, word in protected do if part.Name:find(word, 1, true) then return true end end
	return part.Size.Magnitude &gt; 38
end

function Budget.new(): any
	local self = setmetatable({ Parts = {}, Emitters = {}, Lights = {}, Links = {}, Time = 1, Alive = true }, Budget) :: any
	local function register(item: Instance)
		if not item:IsDescendantOf(workspace) then return end
		local root: Instance? = item
		while root and root.Parent ~= workspace do root = root.Parent end
		if not root or (root.Name ~= "Sanctuary" and not root.Name:match("^Map_")) then return end
		if item:IsA("BasePart") and item.Anchored then
			-- Collision/query surfaces keep their visibility; decorative mesh siblings carry the art.
			if item:IsA("MeshPart") or item:GetAttribute("AsuraMicroDetail") then
				table.insert(self.Parts, { Part = item, Original = item.LocalTransparencyModifier,
					Keep = keep(item), Radius = item.Size.Magnitude * 0.5, Sanctuary = root.Name == "Sanctuary" })
			end
		elseif item:IsA("PointLight") and root.Name == "Sanctuary" then
			table.insert(self.Lights, { Light = item, Enabled = item.Enabled })
		elseif item:IsA("ParticleEmitter") and root.Name == "Sanctuary" then
			table.insert(self.Emitters, { Emitter = item, Rate = item.Rate, Enabled = item.Enabled,
				Cloud = item.Name:find("Cloud", 1, true) ~= nil })
		end
	end
	for _, item in workspace:GetDescendants() do register(item) end
	table.insert(self.Links, workspace.DescendantAdded:Connect(register))
	table.insert(self.Links, RunService.Heartbeat:Connect(function(dt)
		self.Time += dt
		if self.Time &gt;= 0.4 then self.Time = 0; self:Refresh() end
	end))
	self:Refresh()
	return self
end

function Budget.Refresh(self: any)
	local camera = workspace.CurrentCamera
	if not camera or not self.Alive then return end
	local at = camera.CFrame.Position
	local quality = UserSettings():GetService("UserGameSettings").SavedQualityLevel.Value
	local low = (quality &gt; 0 and quality &lt;= 4) or (quality == 0 and UIS.TouchEnabled)
	local threshold = if low then 0.028 else 0.013
	local hidden, active, particles = 0, 0, 0
	for i = #self.Parts, 1, -1 do
		local row = self.Parts[i]; local part = row.Part
		if not part.Parent then table.remove(self.Parts, i); continue end
		local distance = (part.Position - at).Magnitude
		local fade = if row.Keep then 0 else math.clamp((distance * threshold / math.max(row.Radius, 0.1) - 0.85) / 0.35, 0, 1)
		-- Underground campaign meshes cannot contribute to a cloud-top vista. The 900-stud radius
		-- preloads their visual state long before a portal arrival and follows the camera for shots.
		if not row.Sanctuary and distance &gt; 900 then fade = 1 end
		local value = math.max(row.Original, fade)
		if part.LocalTransparencyModifier ~= value then part.LocalTransparencyModifier = value end
		if fade &gt;= 1 then hidden += 1 end
	end
	local range = if low then 64 else 110
	for i = #self.Lights, 1, -1 do
		local row = self.Lights[i]; local light = row.Light
		if not light.Parent then table.remove(self.Lights, i); continue end
		local pos = position(light)
		local enabled = row.Enabled and pos ~= nil and (pos - at).Magnitude &lt; range
		if light.Enabled ~= enabled then light.Enabled = enabled end
		if enabled then active += 1 end
	end
	for i = #self.Emitters, 1, -1 do
		local row = self.Emitters[i]; local emitter = row.Emitter
		if not emitter.Parent then table.remove(self.Emitters, i); continue end
		local pos = position(emitter)
		local rangeLimit = if row.Cloud then 2800 else 240
		local enabled = row.Enabled and pos ~= nil and (pos - at).Magnitude &lt; rangeLimit
		local density = if row.Cloud then (if low then 0.55 else 1) else Effects.decor(false) * (if low then 0.5 else 1)
		local rate = row.Rate * density
		if emitter.Rate ~= rate then emitter.Rate = rate end
		if emitter.Enabled ~= enabled then emitter.Enabled = enabled end
		if enabled then particles += rate * emitter.Lifetime.Max end
	end
	local player = Players.LocalPlayer
	player:SetAttribute("LandscapeTier", if low then "Balanced" else "Detailed")
	player:SetAttribute("LandscapeHiddenMeshes", hidden)
	player:SetAttribute("LandscapeActiveLights", active)
	player:SetAttribute("LandscapeParticleCeiling", particles)
end

function Budget.Destroy(self: any)
	self.Alive = false
	for _, link in self.Links do link:Disconnect() end
	for _, row in self.Parts do if row.Part.Parent then row.Part.LocalTransparencyModifier = row.Original end end
	for _, row in self.Lights do if row.Light.Parent then row.Light.Enabled = row.Enabled end end
	for _, row in self.Emitters do if row.Emitter.Parent then row.Emitter.Rate, row.Emitter.Enabled = row.Rate, row.Enabled end end
	table.clear(self.Parts); table.clear(self.Lights); table.clear(self.Emitters); table.clear(self.Links)
end
return Budget
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="688">
            <Properties>
              <string name="Name">MangaFx</string>
              <string name="Source">--!strict
-- Hand-drawn 2D screen beats from the reference cut (NovaInk and InkFrames draw the ink frames):
-- the black frame with a white ground band, a comic "BOOM."
-- bubble, diagonal swoop streaks and full-screen colour fills (the slow whiteout). Lines re-cut every
-- frame like smear animation. Caster only; reduced flashes shortens and softens every beat.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Effects = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Kit = require(script.Parent.SkillKit)
local Manga = {}

local WHITE, INK = Color3.new(1, 1, 1), Color3.fromRGB(6, 6, 8)

local function screen(trove: Kit.Trove, order: number): (ScreenGui?, Vector2)
	local player, camera = Players.LocalPlayer, Workspace.CurrentCamera
	if not player or not camera then return nil, Vector2.zero end
	local gui = Kit.add(trove, Instance.new("ScreenGui"))
	gui.Name, gui.IgnoreGuiInset, gui.DisplayOrder, gui.ResetOnSpawn = "AsuraMangaFrame", true, order, false
	gui.Parent = player:FindFirstChildOfClass("PlayerGui")
	return gui, camera.ViewportSize
end

local function box(parent: Instance, color: Color3, transparency: number?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel, f.AnchorPoint = color, transparency or 0, 0, Vector2.new(0.5, 0.5)
	f.Parent = parent
	return f
end

local function blob(parent: Instance, color: Color3): Frame
	local f = box(parent, color)
	local c = Instance.new("UICorner")
	c.CornerRadius, c.Parent = UDim.new(0.5, 0), f
	return f
end

-- Runs `draw` now and every 1/30 s for `seconds`, then removes the gui.
local function animate(trove: Kit.Trove, gui: ScreenGui, seconds: number, draw: (number) -&gt; ())
	if Effects.reducedFlashes() then seconds *= 0.5 end
	draw(0)
	Kit.add(trove, task.spawn(function()
		local start = os.clock()
		while os.clock() - start &lt; seconds and gui.Parent do
			task.wait(1 / 30)
			draw(os.clock() - start)
		end
		gui:Destroy()
	end))
end

-- A long, needle-thin 4-point sparkle (the reference's cross-shaped glints).
local function sparkle(parent: Instance, at: Vector2, size: number, color: Color3?)
	for _, bar in { { size, size * 0.022 }, { size * 0.022, size * 0.8 } } do
		local f = box(parent, color or WHITE)
		f.Position, f.Size, f.ZIndex = UDim2.fromOffset(at.X, at.Y), UDim2.fromOffset(bar[1], bar[2]), 5
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
		g.Rotation, g.Parent = if bar[1] &lt; bar[2] then 90 else 0, f
	end
end

Manga.screen, Manga.box, Manga.blob, Manga.animate, Manga.sparkle = screen, box, blob, animate, sparkle

-- Black frame with a white ground band and scattered white blobs (the burst's first instant).
function Manga.groundFlash(trove: Kit.Trove, seconds: number)
	local gui, size = screen(trove, 62)
	if not gui then return end
	local back = box(gui, INK)
	back.Position, back.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	local band = box(back, WHITE)
	band.AnchorPoint, band.Position, band.Size = Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0.66), UDim2.fromScale(1, 0.4)
	local blobs: { Frame } = {}
	for n = 1, 10 do blobs[n] = blob(back, WHITE) end
	animate(trove, gui, seconds, function()
		for n, f in blobs do
			local bump = n &lt;= 6
			local d = if bump then size.Y * (0.03 + math.random() * 0.05) else size.Y * (0.015 + math.random() * 0.025)
			f.Position = UDim2.fromOffset(math.random() * size.X, if bump then size.Y * 0.66 else size.Y * (0.15 + math.random() * 0.35))
			f.Size = UDim2.fromOffset(d * (if bump then 3 else 1.3), d)
		end
	end)
end

-- Comic speech bubble with vertical "BOOM." lettering, popped in at `anchor` (0..1 screen space).
function Manga.boom(trove: Kit.Trove, anchor: Vector2, seconds: number)
	local gui, size = screen(trove, 61)
	if not gui then return end
	local holder = box(gui, WHITE, 1)
	holder.Position, holder.Size = UDim2.fromScale(anchor.X, anchor.Y), UDim2.fromOffset(0, 0)
	local h = size.Y * 0.62
	local body = blob(holder, WHITE)
	body.Position, body.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.82, 0.9)
	for n = 1, 16 do -- ragged rim and two drips
		local a = n / 16 * math.pi * 2
		local puff = blob(holder, WHITE)
		puff.Position, puff.Size = UDim2.fromScale(0.5 + math.cos(a) * 0.38, 0.5 + math.sin(a) * 0.43), UDim2.fromScale(0.16 + math.random() * 0.1, 0.1 + math.random() * 0.06)
	end
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency, text.Text, text.Font, text.TextColor3 = 1, "B\nO\nO\nM.", Enum.Font.Bangers, INK
	text.TextScaled, text.Size, text.Position, text.AnchorPoint, text.ZIndex = true, UDim2.fromScale(0.5, 0.82), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), 3
	text.Parent = holder
	Kit.tween(trove, holder, 0.08, { Size = UDim2.fromOffset(h * 0.5, h) }, Enum.EasingStyle.Back)
	Kit.after(trove, seconds, function() if holder.Parent then holder.Parent:Destroy() end end)
end

-- Diagonal motion streaks raking across the screen (the camera swoop).
function Manga.streaks(trove: Kit.Trove, color: Color3, seconds: number)
	local gui, size = screen(trove, 40)
	if not gui then return end
	local lines: { Frame } = {}
	for n = 1, 14 do
		local f = box(gui, color, 0.35)
		local g = Instance.new("UIGradient")
		g.Transparency, g.Parent = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }), f
		lines[n] = f
	end
	animate(trove, gui, seconds, function()
		for _, f in lines do
			f.Position, f.Rotation = UDim2.fromOffset(math.random() * size.X, math.random() * size.Y), -18 + (math.random() - 0.5) * 6
			f.Size = UDim2.fromOffset(size.X * (0.3 + math.random() * 0.6), 2 + math.random() * 18)
		end
	end)
end

-- A full-screen colour that fades in, holds and fades out (the slow whiteout).
function Manga.fill(trove: Kit.Trove, color: Color3, fadeIn: number, hold: number, fadeOut: number)
	local gui = screen(trove, 63)
	if not gui then return end
	local f = box(gui, color, 1)
	f.Position, f.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	local peak = 1 - Effects.flash(1)
	Kit.tween(trove, f, fadeIn, { BackgroundTransparency = peak }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	Kit.after(trove, fadeIn + hold, function()
		Kit.tween(trove, f, fadeOut, { BackgroundTransparency = 1 })
		Kit.after(trove, fadeOut, function() gui:Destroy() end)
	end)
end

return table.freeze(Manga)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="689">
            <Properties>
              <string name="Name">MasteryEffects</string>
              <string name="Source">--!strict
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local Kit=require(script.Parent.HudKit)
local Effects={}
function Effects.new(state: any,camera: any,ui: any): any
 local disconnect=state:OnCue(function(cue: any)
  if cue.Kind=="SignatureUnlocked" then
   local own=state:Own()
   if own and state:Get(cue.Source)==own then ui:ShowBanner("SIGNATURE STANCE AWAKENED",tostring(cue.Data.weapon).." · Mastery V · Heavy on a broken stance",4) end
   return
  end
  if cue.Kind~="SignatureFinisher" then return end
  local d=cue.Data;local actor=state:Get(cue.Source)
  local own=state:Own();local point=d.position
  if typeof(point)~="Vector3" then return end
  if own and own.Root and (own.Root.Position-point).Magnitude&gt;140 then return end
  if own and actor==own then camera:BossShot(d.target,1.1,true) end
  local sound=Instance.new("Sound");sound.Name="SignatureStanceClash"
  sound.SoundId="rbxasset://sounds/impact_explosion_03.mp3";sound.PlaybackSpeed=0.65;sound.Volume=0.65
  sound.Parent=workspace.CurrentCamera;sound:Play();Debris:AddItem(sound,3)
  Kit.cue(Kit.Sounds.Objective,0.25,0.5)
  for n=1,24 do
   local angle=n*math.pi*2/24
   local p=Instance.new("Part");p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false
   p.Material=Enum.Material.Neon;p.Color=Kit.Palette.Gold;p.Size=Vector3.new(0.5,0.15,1.5)
   p.CFrame=CFrame.new(point)*CFrame.Angles(0,-angle,0);p.Parent=workspace.CurrentCamera
   Tween:Create(p,TweenInfo.new(0.6),{Position=point+Vector3.new(math.cos(angle)*17,0,math.sin(angle)*17),Transparency=1}):Play()
   Debris:AddItem(p,0.7)
  end
 end)
 return {Destroy=function() disconnect() end}
end
return table.freeze(Effects)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="690">
            <Properties>
              <string name="Name">MinimapRoute</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/MinimapRoute
-- Route layer for the SakuraMinimap (follow-up 14, #28): the walked line RouteGuide stages for the
-- objective marker (player -&gt; doorways -&gt; goal), drawn as thin pooled segments clipped to the disc.
-- Nodes mark what the line cannot show flat: a climb or drop (▲/▼ when a doorway sits a storey
-- above or below), a portal the route leaves through (◎, nothing drawn past it), and the
-- bloodstain (✕). The route comes from ObjectiveController's refresh; nothing here scans the world.
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)

local Layer = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local SEGMENTS = 10 -- longest staged route (Monastery doors + campaign doors) fits
local NODES = 6
local RIM = 0.86 -- disc radius the line is clipped to (dots clamp to the same rim)
local NODE_RIM = 0.7 -- off-disc nodes ride inside the N/E/S/W ring, never under a letter
local STOREY = 7 -- studs above/below the player before a doorway shows a climb or a drop
local WIDTH = 3 -- line thickness, px

export type Route = { Points: { Vector3 }, Names: { string }, Exit: string?, Stain: boolean? }
export type View = { Segments: { Frame }, Nodes: { TextLabel }, Diameter: number }

function Layer.new(disc: Frame, diameter: number): View
	local segments, nodes = {}, {}
	for i = 1, SEGMENTS do
		segments[i] = HudKit.make("Frame", disc, {
			Name = "RouteSegment", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = C.Gold, BackgroundTransparency = 0.25,
			BorderSizePixel = 0, Visible = false, ZIndex = 2,
		}) :: Frame
	end
	for i = 1, NODES do
		nodes[i] = HudKit.label(disc, "", 11, Enum.Font.GothamBold, C.Gold, {
			Name = "RouteNode", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), Visible = false, ZIndex = 3,
			TextStrokeTransparency = 0.2,
		})
	end
	return { Segments = segments, Nodes = nodes, Diameter = diameter }
end

-- The part of a -&gt; b inside the rim circle (disc units: 1 = RANGE studs), or nil when outside.
local function clip(ax: number, ay: number, bx: number, by: number): (number?, number?, number?, number?)
	local dx, dy = bx - ax, by - ay
	local a = dx * dx + dy * dy
	if a &lt; 1e-6 then return nil, nil, nil, nil end
	local b = 2 * (ax * dx + ay * dy)
	local c = ax * ax + ay * ay - RIM * RIM
	local disc = b * b - 4 * a * c
	if disc &lt;= 0 then return nil, nil, nil, nil end
	local root = math.sqrt(disc)
	local t0, t1 = math.max(0, (-b - root) / (2 * a)), math.min(1, (-b + root) / (2 * a))
	if t0 &gt;= t1 then return nil, nil, nil, nil end
	return ax + dx * t0, ay + dy * t0, ax + dx * t1, ay + dy * t1
end

local function glyph(route: Route, index: number, rise: number): (string, Color3)
	local last = index == #route.Points
	if last and route.Exit then return "◎", C.Blossom end
	if last and route.Stain then return "✕", C.Crimson end
	if rise &gt; STOREY then return "▲", C.Gold end
	if rise &lt; -STOREY then return "▼", C.Gold end
	return if last then "◆" else "", C.Gold
end

-- Projects the route around `origin` with the camera's flat basis (as SakuraMinimap places dots).
function Layer.step(view: View, route: Route?, origin: Vector3, look: Vector3, right: Vector3, range: number)
	local drawn, marked = 0, 0
	if route then
		local px, py = 0, 0 -- the player sits at the centre
		for index, point in route.Points do
			local offset = point - origin
			local x, y = offset:Dot(right) / range, -offset:Dot(look) / range
			local ax, ay, bx, by = clip(px, py, x, y)
			if ax and ay and bx and by and drawn &lt; #view.Segments then
				drawn += 1
				local segment = view.Segments[drawn]
				local length = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2) * view.Diameter * 0.5
				segment.Position = UDim2.fromScale(0.5 + (ax + bx) * 0.25, 0.5 + (ay + by) * 0.25)
				segment.Size = UDim2.fromOffset(length, WIDTH)
				segment.Rotation = math.deg(math.atan2(by - ay, bx - ax))
				segment.Visible = true
			end
			local text, color = glyph(route, index, offset.Y)
			local distance = math.sqrt(x * x + y * y)
			-- Off-disc nodes ride the rim only for the next step, so the rim never fills with icons.
			if text ~= "" and marked &lt; #view.Nodes and (distance &lt;= RIM or index == 1) then
				marked += 1
				local node = view.Nodes[marked]
				local scale = if distance &gt; RIM then NODE_RIM / distance else 1
				node.Text, node.TextColor3 = text, color
				node.Position = UDim2.fromScale(0.5 + x * scale * 0.5, 0.5 + y * scale * 0.5)
				node.TextTransparency = if distance &gt; RIM then 0.45 else 0
				node.Visible = true
			end
			px, py = x, y
		end
	end
	for i = drawn + 1, #view.Segments do view.Segments[i].Visible = false end
	for i = marked + 1, #view.Nodes do view.Nodes[i].Visible = false end
end

return table.freeze(Layer)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="691">
            <Properties>
              <string name="Name">MoveIcons</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/MoveIcons
-- Small pictorial move icons drawn from rotated frames, so no image uploads are needed: sword
-- slash, heavy cleave, shield, crossed-blade parry, dash chevrons, weapon-art burst, healing gourd,
-- lock reticle, and one per spell discipline (lightning bolt, flame, void, paper talisman).
-- Icons.draw returns a square CanvasGroup; fade the whole picture with GroupTransparency.
local Shapes = require(script.Parent:WaitForChild("IconShapes") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)

local Icons = {}
local C = Sakura.Colors
local box, line, disc, ring, sword = Shapes.box, Shapes.line, Shapes.disc, Shapes.ring, Shapes.sword

-- Customization ------------------------------------------------------------------------------
Icons.Ink = C.Blossom -- main line colour
Icons.Fill = 0.64 -- icon size as a fraction of its parent

export type Kind = "Light" | "Heavy" | "Block" | "Parry" | "Dash" | "WeaponArt" | "Heal" | "Lock" | "Arsenal"
	| "CelestialThunder" | "CrimsonFlame" | "AbyssalVoid" | "SpiritTalismans" | "Empty"

local DRAW: { [string]: (Instance, number) -&gt; () } = {
	Light = function(i, px)
		ring(i, 0.5, 0.5, 0.92, px * 0.05, C.Sakura, 0.55, 225)
		sword(i, 0.22, 0.78, 0.8, 0.2, 0.09, Icons.Ink)
	end,
	Heavy = function(i, px)
		sword(i, 0.5, 0.08, 0.5, 0.72, 0.16, Icons.Ink)
		for _, side in { -1, 1 } do -- impact cracks
			line(i, 0.5 + side * 0.12, 0.78, 0.5 + side * 0.34, 0.64, 0.06, Shapes.Accent)
			line(i, 0.5 + side * 0.14, 0.86, 0.5 + side * 0.4, 0.82, 0.06, Shapes.Accent)
		end
		line(i, 0.18, 0.92, 0.82, 0.92, 0.06, C.Sakura)
	end,
	Block = function(i)
		box(i, 0.5, 0.36, 0.64, 0.46, 0, Icons.Ink, 0.22)
		box(i, 0.5, 0.56, 0.45, 0.45, 45, Icons.Ink, 0.12)
		box(i, 0.5, 0.46, 0.08, 0.5, 0, C.Plum, 0.5)
		disc(i, 0.5, 0.42, 0.2, Shapes.Accent)
	end,
	Parry = function(i)
		sword(i, 0.18, 0.82, 0.74, 0.22, 0.08, Icons.Ink)
		sword(i, 0.82, 0.82, 0.26, 0.22, 0.08, Icons.Ink)
		for n = 0, 3 do box(i, 0.5, 0.4, 0.46, 0.06, n * 45, Shapes.Accent, 0.5) end
		disc(i, 0.5, 0.4, 0.14, C.Ivory)
	end,
	Dash = function(i)
		for n, x in { 0.24, 0.48, 0.72 } do
			local color = if n == 3 then Icons.Ink else C.Sakura
			line(i, x - 0.12, 0.22, x + 0.08, 0.5, 0.1, color)
			line(i, x - 0.12, 0.78, x + 0.08, 0.5, 0.1, color)
		end
	end,
	WeaponArt = function(i)
		for n = 0, 3 do box(i, 0.5, 0.5, if n % 2 == 0 then 0.94 else 0.6, 0.12, n * 45, if n % 2 == 0 then Icons.Ink else Shapes.Accent, 0.5) end
		disc(i, 0.5, 0.5, 0.3, C.Ivory)
		disc(i, 0.5, 0.5, 0.16, C.Rose)
	end,
	Heal = function(i)
		disc(i, 0.5, 0.66, 0.54, Icons.Ink)
		disc(i, 0.5, 0.32, 0.34, Icons.Ink)
		box(i, 0.5, 0.12, 0.16, 0.12, 0, Shapes.Accent, 0.3)
		box(i, 0.5, 0.48, 0.42, 0.06, 0, C.Rose, 0.5)
		box(i, 0.5, 0.68, 0.22, 0.07, 0, C.Crimson, 0.5)
		box(i, 0.5, 0.68, 0.07, 0.22, 0, C.Crimson, 0.5)
	end,
	Lock = function(i, px)
		ring(i, 0.5, 0.5, 0.66, px * 0.07, Icons.Ink)
		for n = 0, 3 do
			local r = math.rad(n * 90)
			line(i, 0.5 + math.cos(r) * 0.3, 0.5 + math.sin(r) * 0.3, 0.5 + math.cos(r) * 0.48, 0.5 + math.sin(r) * 0.48, 0.08, Shapes.Accent)
		end
		disc(i, 0.5, 0.5, 0.14, C.Crimson)
	end,
	Arsenal = function(i)
		sword(i, 0.2, 0.8, 0.8, 0.2, 0.09, Icons.Ink)
		sword(i, 0.8, 0.8, 0.2, 0.2, 0.09, C.Sakura)
		disc(i, 0.5, 0.5, 0.16, Shapes.Accent)
	end,
	CelestialThunder = function(i)
		local pts = { { 0.64, 0.06 }, { 0.36, 0.5 }, { 0.6, 0.48 }, { 0.36, 0.94 } }
		for n = 1, 3 do line(i, pts[n][1], pts[n][2], pts[n + 1][1], pts[n + 1][2], 0.16, Color3.fromRGB(255, 236, 160)) end
		for n = 1, 3 do line(i, pts[n][1], pts[n][2], pts[n + 1][1], pts[n + 1][2], 0.06, C.Ivory) end
	end,
	CrimsonFlame = function(i)
		local tongues: { { Y: number, D: number, Color: Color3 } } = { { Y = 0.62, D = 0.56, Color = C.Crimson }, { Y = 0.7, D = 0.32, Color = Shapes.Accent } }
		for _, f in tongues do -- teardrop = disc + diamond tip
			disc(i, 0.5, f.Y, f.D, f.Color)
			box(i, 0.5, f.Y - f.D * 0.32, f.D * 0.62, f.D * 0.62, 45, f.Color, 0.18)
		end
		disc(i, 0.24, 0.74, 0.16, C.Rose)
		disc(i, 0.76, 0.74, 0.16, C.Rose)
	end,
	AbyssalVoid = function(i, px)
		ring(i, 0.5, 0.5, 0.9, px * 0.05, C.Qi, 0.45, 30)
		ring(i, 0.5, 0.5, 0.66, px * 0.05, Icons.Ink, 0.45, 210)
		local core = disc(i, 0.5, 0.5, 0.36, C.Ink)
		Shapes.make("UIStroke", core, { Color = C.Qi, Thickness = math.max(1, px * 0.05) })
	end,
	SpiritTalismans = function(i)
		box(i, 0.5, 0.5, 0.42, 0.84, 8, Color3.fromRGB(246, 226, 176), 0.08)
		for n, y in { 0.26, 0.4, 0.54 } do box(i, 0.5 + (n - 2) * 0.01, y, 0.24, 0.05, 8, C.Ink, 0.5) end
		disc(i, 0.53, 0.72, 0.2, C.Crimson)
	end,
	Empty = function(i)
		disc(i, 0.5, 0.5, 0.16, C.Sakura)
	end,
}

function Icons.draw(parent: Instance, kind: string, px: number): CanvasGroup
	local group = Shapes.make("CanvasGroup", parent, {
		Name = "Icon", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(Icons.Fill, Icons.Fill), BackgroundTransparency = 1, ZIndex = 3,
	}) :: CanvasGroup
	Shapes.make("UIAspectRatioConstraint", group, { AspectRatio = 1 })
	local draw = DRAW[kind] or DRAW.Empty
	draw(group, px * Icons.Fill)
	return group
end

return table.freeze(Icons)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="692">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source">--!strict
-- Client-owned locomotion. Combat dash grants retain ownership of stamina and invulnerability.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Settings = require(game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath"):WaitForChild("Shared"):WaitForChild("CombatSettings") :: ModuleScript).Movement
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local Camera = require(script.Parent:WaitForChild("CameraController") :: ModuleScript)
local Motion = require(script.Parent:WaitForChild("MovementMath") :: ModuleScript)
local Effects = require(script.Parent:WaitForChild("MovementEffects") :: ModuleScript)
local Controller = {}
Controller.__index = Controller
export type State = "Grounded" | "Airborne" | "Sliding" | "Gliding" | "BulletJumping"
type Fields = {
	World: WorldState.WorldState, Camera: Camera.CameraController, Effects: Effects.MovementEffects,
	State: State, Model: Model?, Humanoid: Humanoid?, Root: BasePart?, Params: RaycastParams,
	Hip: number, AutoJump: boolean, Enabled: boolean, JumpHeld: boolean, AimHeld: boolean, SlideHeld: boolean,
	DoubleUsed: boolean, GlideTime: number, LaunchGrace: number, GroundGap: number, SlideSpeed: number, Direction: Vector3,
}
export type MovementController = typeof(setmetatable({} :: Fields, Controller))

function Controller.new(world: WorldState.WorldState, camera: Camera.CameraController): MovementController
	local params = RaycastParams.new()
	params.FilterType, params.IgnoreWater, params.RespectCanCollide = Enum.RaycastFilterType.Exclude, true, true
	return setmetatable({ World = world, Camera = camera, Effects = Effects.new(camera), State = "Grounded" :: State,
		Model = nil, Humanoid = nil, Root = nil, Params = params, Hip = 0, AutoJump = true, Enabled = true,
		JumpHeld = false, AimHeld = false, SlideHeld = false, DoubleUsed = false, GlideTime = 0,
		LaunchGrace = 0, GroundGap = 0, SlideSpeed = 0, Direction = Vector3.zAxis }, Controller)
end

function Controller.SetState(self: MovementController, state: State)
	self.State = state
	if self.Humanoid then
		local crouched = state == "Sliding" or (state == "Grounded" and self.SlideHeld)
		self.Humanoid.HipHeight = if crouched then math.max(0, self.Hip - Settings.SlideHipDrop) else self.Hip
	end
end

function Controller.Cancel(self: MovementController)
	self.JumpHeld, self.AimHeld, self.SlideHeld = false, false, false
	self:SetState("Airborne")
	self.Effects:Stop()
end

function Controller.SetEnabled(self: MovementController, enabled: boolean)
	if self.Enabled and not enabled then self:Cancel() end
	self.Enabled = enabled
end

function Controller.Bind(self: MovementController)
	local model = Players.LocalPlayer.Character
	if model == self.Model and self.Root and self.Root.Parent then return end
	if self.Humanoid and self.Humanoid.Parent then
		self.Humanoid.HipHeight, self.Humanoid.AutoJumpEnabled = self.Hip, self.AutoJump
	end
	self:Cancel()
	self.Model, self.Humanoid, self.Root = model, nil, nil
	self.DoubleUsed, self.GlideTime, self.LaunchGrace, self.GroundGap = false, 0, 0, 0
	if not model then return end
	local humanoid, root = model:FindFirstChildOfClass("Humanoid"), model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then return end
	self.Humanoid, self.Root, self.Hip, self.AutoJump = humanoid, root, humanoid.HipHeight, humanoid.AutoJumpEnabled
	humanoid.AutoJumpEnabled = false
	self.Params.FilterDescendantsInstances = { model }
	self.Effects:Bind(model, root)
end

function Controller.CanMove(self: MovementController): boolean
	local humanoid = self.Humanoid
	local snapshot = self.World:OwnSnapshot()
	local rootUntil = if self.Model then self.Model:GetAttribute("RootUntil") else nil
	return (type(rootUntil)~="number" or rootUntil&lt;=Workspace:GetServerTimeNow()) and self.Enabled and humanoid ~= nil and humanoid.Health &gt; 0 and not humanoid.Sit and not humanoid.PlatformStand
		and (snapshot == nil or snapshot.State == "Idle" or snapshot.State == "Blocking")
		and os.clock() &gt;= self.World.DashEnds
end

function Controller.Grounded(self: MovementController): boolean
	local humanoid = self.Humanoid
	return humanoid ~= nil and humanoid.FloorMaterial ~= Enum.Material.Air and self.LaunchGrace &lt;= 0
end

function Controller.Press(self: MovementController, command: string)
	self:Bind()
	if not self:CanMove() then return end
	local humanoid, root = self.Humanoid, self.Root
	if not humanoid or not root then return end
	if command == "Aim" then self.AimHeld = true; return end
	if command == "Slide" then
		if self.SlideHeld then return end
		self.SlideHeld = true
		if self:Grounded() and humanoid.MoveDirection.Magnitude &gt; 0.1 then
			local velocity = root.AssemblyLinearVelocity
			self.Direction = Motion.flat(velocity, Motion.flat(humanoid.MoveDirection, root.CFrame.LookVector))
			self.SlideSpeed = math.max(Vector3.new(velocity.X, 0, velocity.Z).Magnitude, humanoid.WalkSpeed) * Settings.SlideBoost
			self.GroundGap = 0
			self:SetState("Sliding")
		elseif self:Grounded() then self:SetState("Grounded")
		end
		return
	end
	if command ~= "Jump" or self.JumpHeld then return end
	self.JumpHeld = true
	if self.State == "Sliding" or (self:Grounded() and self.SlideHeld) then
		self:SetState("BulletJumping")
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		root.AssemblyLinearVelocity = Motion.bullet(self.Camera.Camera.CFrame.LookVector)
		self.LaunchGrace = 0.15
		self.Effects:Launch(root, true)
	elseif self:Grounded() then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		self.LaunchGrace = 0.15
		self:SetState("Airborne")
	elseif not self.DoubleUsed then
		self.DoubleUsed, self.LaunchGrace = true, 0.1
		self:SetState("Airborne")
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		root.AssemblyLinearVelocity = Motion.doubleJump(humanoid.MoveDirection)
		self.Effects:Launch(root, false)
	end
end

function Controller.Release(self: MovementController, command: string)
	if command == "Jump" then self.JumpHeld = false
	elseif command == "Aim" then self.AimHeld = false
	elseif command == "Slide" then
		self.SlideHeld = false
		if self.State == "Sliding" or self.State == "Grounded" then self:SetState(if self:Grounded() then "Grounded" else "Airborne") end
	end
end

-- Called in PreSimulation, so the camera, animation and combat systems never fight velocity writes.
function Controller.Step(self: MovementController, dt: number)
	self:Bind()
	local humanoid, root = self.Humanoid, self.Root
	if not humanoid or not root then return end
	self.LaunchGrace = math.max(0, self.LaunchGrace - dt)
	local grounded = self:Grounded()
	if grounded then self.DoubleUsed, self.GlideTime = false, 0 end
	if not self:CanMove() then
		self:SetState(if grounded then "Grounded" else "Airborne")
		humanoid.HipHeight = self.Hip
		self.Effects:Stop()
		return
	end
	local turn = 0
	if self.State == "Sliding" then
		local reach = root.Size.Y * 0.5 + self.Hip + 2.5
		local hit = Workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), self.Params)
		self.GroundGap = if hit then 0 else self.GroundGap + dt
		if self.GroundGap &gt; Settings.SlideGroundGrace or (hit and hit.Normal.Y &lt; math.cos(math.rad(humanoid.MaxSlopeAngle))) then
			self:SetState("Airborne")
		else
			local normal = if hit then hit.Normal else Vector3.yAxis
			local velocity: Vector3
			self.Direction, self.SlideSpeed, velocity = Motion.slide(self.Direction, self.SlideSpeed, normal, humanoid.MoveDirection, Workspace.Gravity, dt)
			local y = if grounded then velocity.Y else math.min(velocity.Y, root.AssemblyLinearVelocity.Y)
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, y, velocity.Z)
			turn = self.Camera.Camera.CFrame.RightVector:Dot(humanoid.MoveDirection)
			if self.SlideSpeed &lt; Settings.SlideMinSpeed then self:SetState(if grounded then "Grounded" else "Airborne") end
		end
	elseif grounded then self:SetState("Grounded")
	elseif (self.JumpHeld or self.AimHeld) and self.GlideTime &lt; Settings.GlideDuration then
		self:SetState("Gliding")
		local remaining = Settings.GlideDuration - self.GlideTime
		self.GlideTime = math.min(Settings.GlideDuration, self.GlideTime + dt)
		root.AssemblyLinearVelocity = Motion.glide(root.AssemblyLinearVelocity, self.Camera.Camera.CFrame.LookVector, math.min(dt, remaining))
	elseif self.State ~= "BulletJumping" or root.AssemblyLinearVelocity.Y &lt;= 0 then self:SetState("Airborne") end
	self.Effects:Step(dt, self.State, turn, grounded)
end

function Controller.Destroy(self: MovementController)
	self:Cancel()
	self.Effects:Clear()
	if self.Humanoid then self.Humanoid.AutoJumpEnabled = self.AutoJump end
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="693">
            <Properties>
              <string name="Name">MovementEffects</string>
              <string name="Source">--!strict
-- Local procedural cosmetics; no uploaded animation or VFX assets required. R6 and R15.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Camera = require(script.Parent:WaitForChild("CameraController") :: ModuleScript)
local Assets = require(game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath"):WaitForChild("Shared"):WaitForChild("PresentationAssets") :: ModuleScript)
local Effects = {}
Effects.__index = Effects
type Fields = {
	Camera: Camera.CameraController, Items: { Instance }, Trails: { Trail }, Dust: ParticleEmitter?,
	Joint: Motor6D?, Base: CFrame, SpinTime: number, SpinDuration: number, Bullet: boolean,
}
export type MovementEffects = typeof(setmetatable({} :: Fields, Effects))

function Effects.new(camera: Camera.CameraController): MovementEffects
	return setmetatable({ Camera = camera, Items = {}, Trails = {}, Dust = nil, Joint = nil,
		Base = CFrame.identity, SpinTime = 0, SpinDuration = 0, Bullet = false }, Effects)
end

function Effects.Clear(self: MovementEffects)
	if self.Joint and self.Joint.Parent then self.Joint.C0 = self.Base end
	for _, item in self.Items do item:Destroy() end
	table.clear(self.Items)
	table.clear(self.Trails)
	self.Joint, self.Dust, self.SpinDuration = nil, nil, 0
	self.Camera:SetMovement(false, false, 0)
end

function Effects.Stop(self: MovementEffects)
	if self.Joint and self.Joint.Parent then self.Joint.C0 = self.Base end
	self.SpinDuration = 0
	self:Step(0, "Airborne", 0, false)
end

function Effects.Bind(self: MovementEffects, model: Model, root: BasePart)
	self:Clear()
	local candidate = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	local torso: BasePart = if candidate and candidate:IsA("BasePart") then candidate else root
	local joint = model:FindFirstChild("Waist", true) or model:FindFirstChild("RootJoint", true)
	if joint and joint:IsA("Motor6D") then self.Joint, self.Base = joint, joint.C0 end
	for _, side in { -1, 1 } do
		local a = Instance.new("Attachment")
		a.Position = Vector3.new(side * torso.Size.X * 0.45, 0.5, 0)
		a.Parent = torso
		local b = Instance.new("Attachment")
		b.Position = a.Position + Vector3.new(0, -0.18, 0)
		b.Parent = torso
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = a, b
		trail.Lifetime, trail.MinLength, trail.FaceCamera = 0.3, 0.1, true
		trail.Color = ColorSequence.new(Color3.fromRGB(195, 223, 230))
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.65), NumberSequenceKeypoint.new(1, 1) })
		trail.Enabled, trail.Parent = false, torso
		table.insert(self.Trails, trail)
		table.insert(self.Items, a)
		table.insert(self.Items, b)
		table.insert(self.Items, trail)
	end
	local foot = Instance.new("Attachment")
	foot.Position = Vector3.new(0, -root.Size.Y * 0.5 - 1.4, 0)
	foot.Parent = root
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = Assets.Textures.Smoke
	dust.Color = ColorSequence.new(Color3.fromRGB(147, 131, 107))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1.3) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime, dust.Speed, dust.Rate = NumberRange.new(0.2, 0.45), NumberRange.new(2, 5), 35
	dust.SpreadAngle, dust.Enabled, dust.Parent = Vector2.new(55, 35), false, foot
	self.Dust = dust
	table.insert(self.Items, foot)
end

function Effects.Launch(self: MovementEffects, root: BasePart, bullet: boolean)
	self.SpinTime, self.SpinDuration, self.Bullet = 0, if bullet then 0.5 else 0.4, bullet
	if not bullet then return end
	self.Camera.FovPunch.Value += 10
	self.Camera:Impulse(root.CFrame.LookVector, 0.12)
	local center = root.Position - Vector3.new(0, 1.8, 0)
	for index = 1, 18 do
		local angle = index * math.pi / 9
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local ring = Instance.new("Part")
		ring.Name = "BulletWind"
		ring.Anchored, ring.CanCollide, ring.CanTouch, ring.CanQuery = true, false, false, false
		ring.Material, ring.Color, ring.Transparency = Enum.Material.Neon, Color3.fromRGB(202, 228, 234), 0.55
		ring.Size, ring.CFrame = Vector3.new(0.75, 0.08, 0.12), CFrame.lookAt(center + radial * 2, center + radial * 3)
		ring.Parent = workspace
		TweenService:Create(ring, TweenInfo.new(0.35), {
			CFrame = CFrame.lookAt(center + radial * 7, center + radial * 8), Size = Vector3.new(2.5, 0.02, 0.1), Transparency = 1,
		}):Play()
		Debris:AddItem(ring, 0.4)
	end
end

function Effects.Step(self: MovementEffects, dt: number, state: string, turn: number, grounded: boolean)
	self.Camera:SetMovement(state == "Gliding", state == "Sliding", turn)
	for _, trail in self.Trails do trail.Enabled = state == "Gliding" end
	if self.Dust then self.Dust.Enabled = state == "Sliding" and grounded and self.Dust.Texture ~= "" end
	local joint = self.Joint
	if joint and self.SpinDuration &gt; 0 then
		self.SpinTime = math.min(self.SpinTime + dt, self.SpinDuration)
		local angle = self.SpinTime / self.SpinDuration * math.pi * 2
		joint.C0 = self.Base * (if self.Bullet then CFrame.Angles(0, 0, angle) else CFrame.Angles(-angle, 0, 0))
		if self.SpinTime &gt;= self.SpinDuration or grounded then
			joint.C0, self.SpinDuration = self.Base, 0
		end
	end
end

return Effects
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="694">
            <Properties>
              <string name="Name">MovementMath</string>
              <string name="Source">--!strict
-- Stateless, frame-rate-independent movement tuning. Tested separately from Roblox physics.
local Settings = require(game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath"):WaitForChild("Shared"):WaitForChild("CombatSettings") :: ModuleScript).Movement
local Motion = {}

function Motion.flat(value: Vector3, fallback: Vector3): Vector3
	local flat = Vector3.new(value.X, 0, value.Z)
	return if flat.Magnitude &gt; 0.001 then flat.Unit else fallback
end

function Motion.bullet(look: Vector3): Vector3
	return (look * 1.35 + Vector3.new(0, 0.75, 0)).Unit * Settings.BulletSpeed
end

function Motion.doubleJump(move: Vector3): Vector3
	return Vector3.new(0, Settings.DoubleJumpUp, 0) + move * Settings.DoubleJumpForward
end

function Motion.slide(direction: Vector3, speed: number, normal: Vector3, move: Vector3, gravity: number, dt: number): (Vector3, number, Vector3)
	local steered = direction:Lerp(Motion.flat(move, direction), 1 - math.exp(-3 * dt))
	direction = Motion.flat(steered, direction)
	local tangent = direction - normal * direction:Dot(normal)
	tangent = if tangent.Magnitude &gt; 0.001 then tangent.Unit else direction
	local slope = Vector3.new(0, -gravity, 0):Dot(tangent)
	speed = math.clamp(speed + (slope - Settings.SlideFriction) * dt, 0, Settings.SlideMaxSpeed)
	return direction, speed, tangent * speed
end

function Motion.glide(velocity: Vector3, look: Vector3, dt: number): Vector3
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
	local direction = Motion.flat(look, Motion.flat(horizontal, Vector3.zAxis))
	local target = direction * math.max(horizontal.Magnitude, Settings.WalkSpeed)
	local steered = horizontal:Lerp(target, 1 - math.exp(-Settings.GlideSteering * dt))
	return Vector3.new(steered.X, math.max(velocity.Y, -Settings.GlideFallSpeed), steered.Z)
end

return Motion
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="695">
            <Properties>
              <string name="Name">NovaInk</string>
              <string name="Source">--!strict
-- The Supernova's three ink frames, back to back after the detonation: the black frame with a white
-- hatched dome over a two-lobed ink core, the inverted white frame with a hatched black blob and a
-- white radial burst, and the white frame torn by black ink streaks. Lines re-cut every frame like
-- smear animation. Caster only; reduced flashes shortens every beat.
local Kit = require(script.Parent.SkillKit)
local Manga = require(script.Parent.MangaFx)
local Ink = require(script.Parent.InkFrames)
local Nova = {}

local rgb = Color3.fromRGB
local WHITE, INK = Color3.new(1, 1, 1), rgb(6, 6, 8)

-- Black frame: a thick white dome of vertical ink hatching arching over a two-lobed black core that
-- sits on a hatched white ground line, white rain from the top edge, needle sparkles.
function Nova.dome(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	local back = Manga.box(gui, INK)
	back.Position, back.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	local hatch: { Frame } = {}
	for n = 1, 320 do hatch[n] = Manga.box(back, WHITE) end
	local inner: { Frame } = {}
	for n = 1, 70 do
		inner[n] = Manga.box(back, INK)
		inner[n].ZIndex = 4
	end
	local arch = Manga.blob(back, WHITE) -- solid white under the hatching: the dome reads as one bright mass
	arch.ZIndex = 1
	local lobes = { Manga.blob(back, INK), Manga.blob(back, INK) }
	for _, l in lobes do l.ZIndex = 3 end
	local ground = Manga.box(back, WHITE)
	ground.AnchorPoint, ground.ZIndex = Vector2.new(0.5, 0), 2
	for n, at in { Vector2.new(0.24, 0.24), Vector2.new(0.66, 0.16), Vector2.new(0.86, 0.42), Vector2.new(0.12, 0.6) } do
		Manga.sparkle(back, at * size, size.Y * (0.22 + 0.06 * n))
	end
	Manga.animate(trove, gui, seconds, function(t: number)
		local grow = 1 + t * 1.5
		local c = Vector2.new(size.X * 0.5, size.Y * 0.6)
		local rx, ry = size.X * 0.23 * grow, size.Y * 0.4 * grow
		arch.Position, arch.Size = UDim2.fromOffset(c.X, c.Y), UDim2.fromOffset(rx * 2.15, ry * 1.75)
		for i, l in lobes do
			l.Position = UDim2.fromOffset(c.X + (if i == 1 then -1 else 1) * rx * 0.36, c.Y + ry * 0.08)
			l.Size = UDim2.fromOffset(rx * 0.95, ry * 1.05)
		end
		ground.Position, ground.Size = UDim2.fromOffset(c.X, c.Y + ry * 0.5), UDim2.fromOffset(size.X, size.Y)
		for n, f in inner do -- the core's edge hatched up into the white, so the two read as one ink mass
			local i = if n % 2 == 0 then 1 else -1
			local a = math.pi + (math.random() * 0.9 + 0.05) * math.pi
			local len = size.Y * (0.03 + math.random() * 0.08)
			f.Position = UDim2.fromOffset(c.X + i * rx * 0.36 + math.cos(a) * rx * 0.47, c.Y + ry * 0.08 + math.sin(a) * ry * 0.52 - len * 0.4)
			f.Size = UDim2.fromOffset(1 + math.random() * 3, len)
		end
		for n, f in hatch do
			if n &lt;= 240 then -- the arch's fuzzy rim: strokes poking out of it, longest at the crown
				local a = math.pi * 0.92 + n / 240 * math.pi * 1.16
				local crown = math.max(0, -math.sin(a))
				local len = size.Y * (0.05 + math.random() * 0.1 + crown * 0.1)
				f.Position = UDim2.fromOffset(c.X + math.cos(a) * rx * 1.06 + (math.random() - 0.5) * 12, c.Y + math.sin(a) * ry * 0.86 - len * 0.2)
				f.Size = UDim2.fromOffset(2 + math.random() * 5, len)
			elseif n &lt;= 280 then -- rain from the top edge
				f.Position, f.Size = UDim2.fromOffset(math.random() * size.X, math.random() * size.Y * 0.25), UDim2.fromOffset(1 + math.random() * 2, size.Y * (0.08 + math.random() * 0.35))
			else -- hatching up from the ground line
				f.Position, f.Size = UDim2.fromOffset(math.random() * size.X, c.Y + ry * 0.5 - size.Y * 0.03), UDim2.fromOffset(1 + math.random() * 3, size.Y * (0.03 + math.random() * 0.09))
			end
		end
	end)
end

-- White frame torn by black vertical ink streaks (the column's first instant).
function Nova.streaks(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	local back = Manga.box(gui, WHITE)
	back.Position, back.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
	-- Each tear is three stacked strokes of different widths and lengths: a ragged ink edge.
	local streaks: { Frame } = {}
	for n = 1, 96 do streaks[n] = Manga.box(back, if n % 7 == 0 then Color3.fromRGB(110, 110, 115) else INK) end
	Manga.animate(trove, gui, seconds, function()
		for n = 1, #streaks, 3 do
			local x = size.X * (0.5 + (math.random() - 0.5) * (if math.random() &lt; 0.65 then 0.32 else 0.95))
			local y, width, tilt = size.Y * (0.25 + math.random() * 0.55), 4 + math.random() ^ 1.6 * 70, (math.random() - 0.5) * 14
			for k = 0, 2 do
				local f = streaks[n + k]
				f.Position = UDim2.fromOffset(x + (math.random() - 0.5) * width * 0.6, y + (math.random() - 0.5) * size.Y * 0.3)
				f.Size, f.Rotation = UDim2.fromOffset(width * (0.35 + math.random() * 0.65), size.Y * (0.2 + math.random() * 0.7)), tilt + (math.random() - 0.5) * 6
			end
		end
	end)
end

-- White frame: a black hatched blob on hatched ground with white rays bursting from its heart.
function Nova.burst(trove: Kit.Trove, seconds: number)
	local gui, size = Manga.screen(trove, 62)
	if not gui then return end
	local back = Ink.full(gui, WHITE)
	local core = Manga.blob(back, INK)
	core.ZIndex = 2
	local fringe: { Frame } = {}
	for n = 1, 230 do
		fringe[n] = Manga.box(back, INK)
		fringe[n].ZIndex = 2
	end
	local rays: { Frame } = {}
	for n = 1, 44 do
		rays[n] = Manga.box(back, WHITE)
		rays[n].ZIndex = 4
	end
	for n = 1, 3 do Manga.sparkle(back, Vector2.new(size.X * (0.1 + 0.3 * n), size.Y * (0.1 + 0.12 * (n % 2))), size.Y * 0.4, rgb(70, 70, 75)) end
	Manga.animate(trove, gui, seconds, function()
		local c = Vector2.new(size.X * 0.5, size.Y * 0.5)
		local rx, ry = size.Y * 0.44, size.Y * 0.4 -- a round blob, not a pill
		core.Position, core.Size = UDim2.fromOffset(c.X, c.Y), UDim2.fromOffset(rx * 2, ry * 2)
		for n, f in fringe do
			if n &lt;= 150 then -- hatched rim of the blob
				local a = n / 150 * math.pi * 2
				f.Position = UDim2.fromOffset(c.X + math.cos(a) * rx * 0.97 + (math.random() - 0.5) * 8, c.Y + math.sin(a) * ry * 0.97)
				f.Size = UDim2.fromOffset(2 + math.random() * 4, size.Y * (0.05 + math.random() * 0.14))
			else -- hatched ground band
				f.Position, f.Size = UDim2.fromOffset(math.random() * size.X, size.Y * 0.92), UDim2.fromOffset(2 + math.random() * 4, size.Y * (0.06 + math.random() * 0.16))
			end
		end
		local hub = c + Vector2.new(size.X * 0.03, size.Y * 0.16)
		for n, f in rays do
			Ink.stroke(f, hub, n / #rays * math.pi * 2 + (math.random() - 0.5) * 0.25, size.Y * (0.1 + math.random() * 0.36), 1 + math.random() * 4)
		end
	end)
end

return table.freeze(Nova)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="696">
            <Properties>
              <string name="Name">NovaScenery</string>
              <string name="Source">--!strict
-- Celestial Supernova scenery around the planet: a vortex of translucent teal smoke ribbons whipping
-- round the caster, floating black rocks and glowing cubes, gold sparkles, the hollow gold stars by
-- the planet and the gold flame crescents that tear across it before the detonation.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Kit = require(script.Parent.SkillKit)
local Bb = require(script.Parent.BillboardFx)
local Shapes = require(script.Parent.BillboardShapes)
local Planet = require(script.Parent.PlanetForms)
local Scenery = {}

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)

-- Curved smoke ribbons orbiting `center()`; returns a setter for their radius (to widen the storm).
function Scenery.vortex(trove: Kit.Trove, folder: Instance, center: () -&gt; Vector3, count: number): (number) -&gt; ()
	local hub = Kit.part(folder, "VortexHub", WHITE, Vector3.one * 0.1, CFrame.new(center()))
	hub.Transparency = 1
	local radius = 6
	local ribbons = {}
	for n = 1, count do
		local a0, a1 = Kit.attach(trove, hub, Vector3.zero, "RibbonA"), Kit.attach(trove, hub, Vector3.zero, "RibbonB")
		local beam = Instance.new("Beam")
		beam.Attachment0, beam.Attachment1, beam.Segments, beam.FaceCamera = a0, a1, 24, true
		beam.Texture, beam.TextureSpeed, beam.TextureLength = Assets.Textures.Smoke, 0.6, 6
		beam.Color = ColorSequence.new(if n % 3 == 0 then rgb(200, 255, 255) else rgb(70, 205, 215))
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(0.7, 0.5), NumberSequenceKeypoint.new(1, 1) })
		beam.LightEmission, beam.LightInfluence, beam.Width0, beam.Width1 = 1, 0, 3 + math.random() * 4, 4 + math.random() * 6
		beam.Parent = hub
		ribbons[n] = { A = a0, B = a1, Beam = beam, Phase = math.random() * 6, Tilt = (math.random() - 0.5) * 1.6, Speed = 1.6 + math.random() * 1.8 }
	end
	-- A soft teal cloud boiling round the caster under the ribbons.
	Kit.emitter(hub, { Texture = Assets.Textures.Smoke, Color = ColorSequence.new(rgb(90, 220, 230), rgb(20, 90, 110)), Size = NumberSequence.new(5, 12),
		Rate = 7, Lifetime = NumberRange.new(2, 3), Speed = NumberRange.new(1, 3), Spread = 180, Light = 0.4, Spin = NumberRange.new(-40, 40),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.75), NumberSequenceKeypoint.new(1, 1) }) })
	local clock = 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		hub.Position = center()
		for _, r in ribbons do
			local a = r.Phase + clock * r.Speed
			local rr = radius * (0.7 + 0.3 * math.sin(clock + r.Phase))
			local function at(off: number): Vector3
				local yaw = a + off
				return Vector3.new(math.cos(yaw) * rr, math.sin(yaw * 0.5 + r.Tilt) * rr * 0.35 + r.Tilt * 2, math.sin(yaw) * rr)
			end
			r.A.Position, r.B.Position = at(0), at(1.9)
			r.Beam.CurveSize0, r.Beam.CurveSize1 = rr * 0.9, -rr * 0.9
		end
	end))
	return function(r: number) radius = r end
end

-- Dark rocks (and a few glowing cubes) hanging in the void around `center`, tumbling slowly.
function Scenery.rocks(trove: Kit.Trove, folder: Instance, center: Vector3, count: number, spread: number)
	local parts: { BasePart } = {}
	local spins: { CFrame } = {}
	for n = 1, count do
		local cube = n % 5 == 0
		local size = if cube then Vector3.one * (0.5 + math.random() * 0.6) else Vector3.new(1 + math.random() * 2.5, 0.8 + math.random() * 2, 1 + math.random() * 2)
		local offset = Vector3.new(math.random() - 0.5, (math.random() - 0.5) * 0.6, math.random() - 0.5) * spread
		local p = Kit.part(folder, if cube then "GlowCube" else "VoidRock", if cube then Planet.Cyan else rgb(14, 18, 22), size, CFrame.new(center + offset))
		p.Material = if cube then Enum.Material.Neon else Enum.Material.Slate
		parts[n], spins[n] = p, CFrame.Angles(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
	end
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		local frames: { CFrame } = {}
		for n, p in parts do frames[n] = p.CFrame * spins[n]:Lerp(CFrame.identity, 1 - dt) + Vector3.new(0, dt * 0.6, 0) end
		Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end))
end

-- `count` gold sparkles twinkling in one by one around `at`.
function Scenery.sparkles(trove: Kit.Trove, folder: Instance, at: Vector3, count: number, spread: number, size: number, life: number)
	for n = 1, count do
		Kit.after(trove, (n - 1) * 0.12, function()
			local p = Bb.anchor(folder, at + Vector3.new(math.random() - 0.5, math.random() - 0.3, math.random() - 0.5) * spread)
			Bb.sparkle(trove, p, Planet.Gold, size * (0.6 + math.random() * 0.8), life, (math.random() - 0.5) * 20)
		end)
	end
end

-- Hollow gold stars hanging off the planet's upper shoulder on this viewer's screen.
function Scenery.stars(trove: Kit.Trove, folder: Instance, at: Vector3, radius: number, seconds: number)
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local right, up = camera.CFrame.RightVector, camera.CFrame.UpVector
	for n, spot in { { -1.15, 0.7, 0.62 }, { -0.6, 1.15, 0.48 }, { 0.15, 1.3, 0.34 } } do
		Kit.after(trove, (n - 1) * 0.12, function()
			local hold = Bb.anchor(folder, at + right * radius * spot[1] + up * radius * spot[2])
			Shapes.star(trove, hold, rgb(215, 160, 70), radius * spot[3], seconds)
		end)
	end
end

-- Gold flame crescents on this viewer's side of the planet, so they tear across its face; returns
-- their anchors so the detonation can burn them out.
function Scenery.crescents(trove: Kit.Trove, folder: Instance, at: Vector3, radius: number): { BasePart }
	local camera = Workspace.CurrentCamera
	local toward = if camera then (camera.CFrame.Position - at).Unit else Vector3.zAxis
	local anchors: { BasePart } = {}
	for n = 1, 6 do
		local p = Bb.anchor(folder, at + toward * radius * 1.25 + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * radius * 1.3)
		table.insert(anchors, p)
		Bb.arc(trove, p, Planet.Gold, radius * (1.3 + math.random() * 0.9), 0.3 + math.random() * 0.2, (if n % 2 == 0 then 1 else -1) * (160 + math.random() * 120), 2.4)
	end
	return anchors
end

return table.freeze(Scenery)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="697">
            <Properties>
              <string name="Name">ObjectiveController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/ObjectiveController
-- HUD objective tracker: a top-right "next step" card plus a WaypointMarker, both derived from
-- replicated player attributes via the pure Shared.Objectives resolver.
-- Presentation only — it never sends intents.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Objectives = require(ReplicatedStorage:WaitForChild("AsurasPath"):WaitForChild("Shared"):WaitForChild("Objectives") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local WaypointMarker = require(script.Parent:WaitForChild("WaypointMarker") :: ModuleScript)
local Visibility = require(script.Parent:WaitForChild("HudVisibility") :: ModuleScript)
local WorldState = require(script.Parent:WaitForChild("WorldStateController") :: ModuleScript)
local RouteGuide = require(ReplicatedStorage.AsurasPath.Shared.RouteGuide)

local P = HudKit.Palette
local REFRESH = 0.2

local Controller = {}
Controller.__index = Controller

export type ObjectiveController = typeof(setmetatable({} :: {
	Player: Player,
	Ui: any,
	Panel: Frame,
	Header: TextLabel,
	Title: TextLabel,
	Detail: TextLabel,
	Distance: TextLabel,
	Marker: WaypointMarker.WaypointMarker,
	Current: Objectives.Objective?,
	Rested: boolean,
	BossFelled: boolean,
	PendingRegion: string?,
	Elapsed: number,
	Cleanup: { () -&gt; () },
}, Controller))

function Controller.new(state: WorldState.WorldState, ui: any): ObjectiveController
	local player = Players.LocalPlayer
	local panel = HudKit.panel(ui.Gui, "ObjectiveTracker", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 64), Size = UDim2.fromOffset(360, 92), Visible = false })
	HudKit.make("UIPadding", panel, { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 8) })
	local header = HudKit.label(panel, "OBJECTIVE", 14, HudKit.TitleFont, P.Ember, { Size = UDim2.new(1, -60, 0, 18), TextXAlignment = Enum.TextXAlignment.Left })
	local distance = HudKit.label(panel, "", 14, Enum.Font.GothamMedium, P.Muted, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(60, 18), TextXAlignment = Enum.TextXAlignment.Right })
	local title = HudKit.label(panel, "", 22, HudKit.TitleFont, P.Ivory, { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = true })
	HudKit.make("UITextSizeConstraint", title, { MaxTextSize = 22, MinTextSize = 12 })
	local detail = HudKit.label(panel, "", 16, HudKit.BodyFont, P.Muted, { Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true })

	local self = setmetatable({
		Player = player, Ui = ui, Panel = panel, Header = header, Title = title, Detail = detail, Distance = distance,
		Marker = WaypointMarker.new(ui.Gui), Current = nil, Rested = false, BossFelled = false, PendingRegion = nil,
		Elapsed = REFRESH, Cleanup = {},
	}, Controller)
	table.insert(self.Cleanup, HudKit.bindScale(panel, 0.8))
	local regionConnection = player:GetAttributeChangedSignal("AsuraRegion"):Connect(function()
		self.PendingRegion = nil
	end)
	table.insert(self.Cleanup, function()
		regionConnection:Disconnect()
	end)
	table.insert(self.Cleanup, state:OnCue(function(cue: WorldState.Cue)
		-- Resting, or leaving the Sanctuary, ends the first-rest step.
		if cue.Source == state.LocalId and (cue.Kind == "AltarRest" or cue.Kind == "PortalTransit" or cue.Kind == "AltarTravel") then
			self.Rested = true
			-- AsuraRegion lags a teleport; trust the cue's destination until it catches up.
			local destination = Objectives.regionOf(tostring(cue.Data.to or ""))
			if cue.Kind ~= "AltarRest" and destination then
				self.PendingRegion = destination
			end
		elseif cue.Kind == "BossDefeated" and cue.Data.boss == "GrandmasterShen" then
			self.BossFelled = true
		end
		self.Elapsed = REFRESH
	end))
	return self
end

function Controller.Facts(self: ObjectiveController): Objectives.Facts
	local player = self.Player
	local region = player:GetAttribute("AsuraRegion")
	local stain = player:GetAttribute("AsuraBloodstain")
	local bosses = Objectives.parseAltars(player:GetAttribute("AsuraBosses"))
	return {
		Bosses = bosses,
		Region = self.PendingRegion or (if type(region) == "string" then region else nil),
		Altars = Objectives.parseAltars(player:GetAttribute("AsuraAltars")),
		Bloodstain = if typeof(stain) == "Vector3" then stain else nil,
		StainRegion = if typeof(stain) == "Vector3" then RouteGuide.regionOf(stain) else nil,
		InBoss = self.Ui.BossEntity ~= nil,
		InColosseum = type(player:GetAttribute("AsuraColosseum")) == "string",
		BossFelled = self.BossFelled or bosses.GrandmasterShen == true,
		Rested = self.Rested,
		Story = Objectives.parseAltars(player:GetAttribute("AsuraStory")),
	}
end

function Controller.Show(self: ObjectiveController, objective: Objectives.Objective?)
	local previous = self.Current
	self.Current = objective
	self.Panel.Visible = objective ~= nil
	if not objective then
		return
	end
	self.Title.Text = objective.Title
	self.Detail.Text = objective.Detail
	if previous and previous.Key ~= objective.Key then
		self.Header.Text = "NEW OBJECTIVE"
		self.Panel.BackgroundTransparency = 0
		TweenService:Create(self.Panel, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { BackgroundTransparency = 0.25 }):Play()
		HudKit.cue(HudKit.Sounds.Objective, 0.5, 1.2)
		task.delay(3, function()
			if self.Current == objective then
				self.Header.Text = "OBJECTIVE"
			end
		end)
	end
end

function Controller.Update(self: ObjectiveController, dt: number)
	local guidance = Visibility.of(self.Ui).Guidance
	self.Panel.Visible = self.Current ~= nil and guidance
	self.Elapsed += dt
	if self.Elapsed &lt; REFRESH then
		return
	end
	self.Elapsed = 0
	local objective = Objectives.resolve(self:Facts())
	if Objectives.changed(self.Current, objective) then
		self:Show(objective)
	end
	local character = self.Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local goal = if objective then self.Marker:Locate(objective.Target) else nil
	-- Staged route (#28): the next doorway or portal on the walked route, with the walked distance.
	local stage = if goal and root then RouteGuide.next(root.Position, goal) else nil
	if stage then goal = if stage.Kind == "Portal" then self.Marker:Locate({ Kind = "Portal" }) else stage.Position end
	-- The minimap draws the same walked route (follow-up 14); the northern gate is the placed portal.
	local route: any = nil
	if stage and guidance then
		local points = stage.Route.Points
		if stage.Route.Exit == "Northern gate" then points = if goal then { goal } else {} end
		route = { Points = points, Names = stage.Route.Names, Exit = stage.Route.Exit, Stain = objective ~= nil and objective.Key == "Bloodstain" }
	end
	self.Ui.Route = route
	local meters = self.Marker:Point(goal, if root then root.Position else nil, not guidance, stage and stage.Label, stage and stage.Remaining)
	self.Distance.Text = if meters then string.format("%dm", meters) else ""
end

function Controller.Destroy(self: ObjectiveController)
	for _, cleanup in self.Cleanup do
		cleanup()
	end
	self.Marker:Destroy()
	self.Panel:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="698">
            <Properties>
              <string name="Name">PauseMenu</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/PauseMenu
-- Respite menu (P, or the ≡ blossom button beside the minimap): Resume, Settings (field of view and
-- camera sensitivity steppers, comfort/readability toggles, previewed live, saved through ShopIntent
-- SaveSettings), Controls and the Codex. Pages scroll so phones never clip an entry (batch 25).
-- The world keeps running (online Souls), so opening only releases held inputs; it never pauses.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local InputMap = require(Shared:WaitForChild("Shared"):WaitForChild("InputMap") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)
local UiWindow = require(script.Parent:WaitForChild("UiWindow") :: ModuleScript)
local Comfort = require(script.Parent:WaitForChild("ComfortSettings") :: ModuleScript)
local Effects = require(Shared:WaitForChild("Shared"):WaitForChild("EffectsPreference") :: ModuleScript) :: any

local Menu = {}
Menu.__index = Menu
local T = UiKit.Theme
local C = Config.Camera

-- Customization ------------------------------------------------------------------------------
local WINDOW_SIZE = Vector2.new(460, 470)
local TOGGLE_KEYS: { Enum.KeyCode } = {}
for _, name in (InputMap.get("Pause") :: any).Keys do
	table.insert(TOGGLE_KEYS, (Enum.KeyCode :: any)[name])
end
local BACK_KEYS = { Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace } -- only bound while open
local FOOTNOTE = "The world does not wait. Foes still hunt while you linger here."

export type Saved = { fov: number, sensitivity: number, leftHanded: boolean, comfort: any }
export type PauseMenu = typeof(setmetatable({} :: {
	Window: UiWindow.Window, Camera: any, Input: any, Ui: any, Remote: RemoteEvent, Controls: any,
	Arsenal: GuiObject, Pages: { [string]: Frame }, First: { [string]: TextButton }, Saved: Saved,
	Refresh: () -&gt; (), Bin: UiKit.Bin,
}, Menu))

local function page(self: any, name: string): Frame
	local frame = HudKit.make("ScrollingFrame", self.Window.Body, { Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false,
		BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = T.Edge, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y }) :: Frame
	HudKit.make("UIListLayout", frame, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	self.Pages[name] = frame
	return frame
end

-- [label .......... (−) value (+)] ; `step` returns the new display text.
local function stepper(parent: Frame, order: number, text: string, step: (direction: number) -&gt; string): () -&gt; ()
	local row = HudKit.make("Frame", parent, { Name = text, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1 }) :: Frame
	HudKit.label(row, text, 19, T.BodyFont, T.Ivory, { Size = UDim2.new(1, -170, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
	local value = HudKit.label(row, "", 20, Enum.Font.GothamMedium, T.Gold, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0), Size = UDim2.fromOffset(66, 30) })
	for _, direction in { -1, 1 } do
		local b = UiKit.button(row, if direction &lt; 0 then "−" else "+", "Secondary", function()
			value.Text = step(direction)
		end)
		b.AnchorPoint, b.Size, b.TextSize = Vector2.new(1, 0.5), UDim2.fromOffset(44, 44), 24
		b.Position = UDim2.new(1, if direction &lt; 0 then -122 else 0, 0.5, 0)
	end
	return function() value.Text = step(0) end
end

function Menu.new(camera: any, input: any, ui: any, remote: RemoteEvent, controls: any, arsenal: GuiObject): PauseMenu
	local self: any = setmetatable({ Camera = camera, Input = input, Ui = ui, Remote = remote, Controls = controls, Arsenal = arsenal, Pages = {}, First = {}, Bin = {},
		Saved = { fov = camera.Fov, sensitivity = camera.Sensitivity, leftHanded = false, comfort = Effects.get() } }, Menu)
	self.Window = UiWindow.new(ui.Gui, "RespiteMenu", "Respite", "A breath between battles", WINDOW_SIZE, function() self:Close() end)

	local main = page(self, "Main")
	local entries: { { Text: string, Variant: UiKit.Variant, Fn: () -&gt; () } } = {
		{ Text = "Resume", Variant = "Primary", Fn = function() self:Close() end },
		{ Text = "Settings", Variant = "Secondary", Fn = function() self:Show("Settings") end },
		{ Text = "Controls", Variant = "Secondary", Fn = function() self:Close(); controls:SetOpen(true) end },
		{ Text = "Codex", Variant = "Secondary", Fn = function() self:Close(); if ui.OpenCodex then ui.OpenCodex() end end },
		{ Text = "Replay training", Variant = "Secondary", Fn = function() self:Close(); if ui.OnTraining then ui.OnTraining("Replay") end end },
		{ Text = "Replay opening", Variant = "Secondary", Fn = function() self:Close(); if ui.OnPrologue then ui.OnPrologue() end end },
	}
	for order, entry in entries do
		local b = UiKit.button(main, entry.Text, entry.Variant, entry.Fn)
		b.LayoutOrder, b.Size = order, UDim2.new(1, 0, 0, 50)
		self.First.Main = self.First.Main or b
	end
	HudKit.label(main, FOOTNOTE, 15, T.BodyFont, T.Muted, { LayoutOrder = 9, Size = UDim2.new(1, 0, 0, 44), TextWrapped = true })

	local settings = page(self, "Settings")
	local fov = stepper(settings, 1, "Field of view", function(d: number)
		camera.Fov = math.clamp(camera.Fov + d * C.FOVStep, C.MinFOV, C.MaxFOV)
		return string.format("%d°", math.floor(camera.Fov + 0.5))
	end)
	local sens = stepper(settings, 2, "Camera sensitivity", function(d: number)
		camera.Sensitivity = math.clamp(camera.Sensitivity + d * C.SensitivityStep, C.SensitivityMin, C.SensitivityMax)
		return string.format("%.2f×", camera.Sensitivity)
	end)
	local comfort = Comfort.build(settings, 3)
	self.Refresh = function() fov(); sens(); comfort() end
	local apply = UiKit.button(settings, "Apply", "Primary", function()
		remote:FireServer({ action = "SaveSettings", settings = { fov = camera.Fov, sensitivity = camera.Sensitivity, leftHanded = self.Saved.leftHanded, comfort = Effects.get() } })
	end)
	apply.LayoutOrder, apply.Size = 8, UDim2.new(1, 0, 0, 48)
	self.First.Settings = apply
	local back = UiKit.button(settings, "Back", "Secondary", function() self:Revert(); self:Show("Main") end)
	back.LayoutOrder, back.Size = 9, UDim2.new(1, 0, 0, 44)

	-- Profile syncs and save results arrive on ShopIntent; the bootstrap applies them to the camera.
	table.insert(self.Bin, remote.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then return end
		local s = type(payload.profile) == "table" and payload.profile.settings
		if type(s) == "table" and type(s.fov) == "number" and type(s.sensitivity) == "number" then
			self.Saved = { fov = s.fov, sensitivity = s.sensitivity, leftHanded = s.leftHanded == true, comfort = Effects.sanitize(s.comfort) }
		end
		if payload.action == "SettingsResult" then
			if payload.ok then UiKit.play("Click"); ui:ShowToast("Settings inscribed.") else UiKit.play("Error"); ui:ShowToast(tostring(payload.err or "The settings would not hold.")) end
			self.Refresh()
		end
	end))
	table.insert(self.Bin, arsenal:GetPropertyChangedSignal("Visible"):Connect(function()
		if arsenal.Visible then self:Close() end
	end))
	ContextActionService:BindAction("AsuraRespite", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then self:Toggle() end
		return Enum.ContextActionResult.Sink
	end, false, table.unpack(TOGGLE_KEYS))
	return self
end

function Menu.Blocked(self: PauseMenu): boolean
	local ui = self.Ui
	-- One window at a time: Respite opened over Lin or the Codex stacked two translucent panels (F03).
	return ui.DeathShown or ui.PrologueActive == true or ui.EndingActive == true or ui.DialogueOpen == true or ui.Altar.Visible or self.Arsenal.Visible
end

function Menu.Show(self: PauseMenu, name: string)
	for key, frame in self.Pages do frame.Visible = key == name end
	self.Refresh()
	if UserInputService.GamepadEnabled then GuiService.SelectedObject = self.First[name] end
end

function Menu.Revert(self: PauseMenu)
	self.Camera.Fov, self.Camera.Sensitivity = self.Saved.fov, self.Saved.sensitivity
	Effects.set(self.Saved.comfort)
end

function Menu.Toggle(self: PauseMenu)
	if UiWindow.isOpen(self.Window) then self:Close() elseif not self:Blocked() then self:Open() end
end

function Menu.Open(self: PauseMenu)
	self.Input:SetMenu(true, "Pause")
	UiWindow.open(self.Window)
	self:Show("Main")
	ContextActionService:BindActionAtPriority("AsuraRespiteBack", function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			if self.Pages.Settings.Visible then self:Revert(); self:Show("Main") else self:Close() end
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 2, table.unpack(BACK_KEYS))
end

function Menu.Close(self: PauseMenu)
	if not UiWindow.isOpen(self.Window) then return end
	ContextActionService:UnbindAction("AsuraRespiteBack")
	self:Revert()
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(self.Window.Root) then GuiService.SelectedObject = nil end
	UiWindow.close(self.Window, function()
		self.Input:SetMenu(false, "Pause")
	end)
end

function Menu.Destroy(self: PauseMenu)
	ContextActionService:UnbindAction("AsuraRespite")
	ContextActionService:UnbindAction("AsuraRespiteBack")
	UiKit.clean(self.Bin)
	self.Window.Root:Destroy()
end

return Menu
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="699">
            <Properties>
              <string name="Name">PlanetForms</string>
              <string name="Source">--!strict
-- The Celestial Supernova planet from the reference: a translucent sphere wrapped in streaking cyan
-- cloud bands under a tilted Saturn ring, which can burn white-hot before it detonates (NovaScenery
-- has the vortex, rocks and gold accents around it). Procedural parts only.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Kit = require(script.Parent.SkillKit)
local Planet = {}

local rgb = Color3.fromRGB
Planet.Cyan, Planet.Deep, Planet.Gold = rgb(120, 255, 255), rgb(0, 110, 125), rgb(255, 160, 30)
local WHITE = Color3.new(1, 1, 1)

export type Body = { Shell: BasePart, Inner: BasePart, Core: BasePart, Bands: { BasePart }, Ring: { BasePart }, Light: PointLight, Radius: number }

local function slab(folder: Instance, color: Color3, size: Vector3, transparency: number): BasePart
	local p = Kit.part(folder, "PlanetBand", color, size, CFrame.identity)
	p.Transparency = transparency
	return p
end

-- The planet: radius `radius`, centred on `center()`, growing in over `grow` seconds.
function Planet.body(trove: Kit.Trove, folder: Instance, center: () -&gt; Vector3, radius: number, grow: number): Body
	local at = center()
	local shell = Kit.part(folder, "PlanetShell", Planet.Cyan, Vector3.one * 0.5, CFrame.new(at), Enum.PartType.Ball)
	shell.Material = Enum.Material.ForceField
	local inner = Kit.part(folder, "PlanetBody", rgb(0, 70, 82), Vector3.one * 0.5, CFrame.new(at), Enum.PartType.Ball)
	inner.Transparency = 0.45
	local core = Kit.part(folder, "PlanetHeart", WHITE, Vector3.one * 0.2, CFrame.new(at), Enum.PartType.Ball)
	core.Transparency = 1
	local light = Kit.light(inner, Planet.Cyan, 60, 2)
	for _, p in { shell, inner } do Kit.tween(trove, p, grow, { Size = Vector3.one * radius * 2 }, Enum.EasingStyle.Back) end
	-- Cloud bands: 13 latitudes x 32 slabs of varied thickness, each a broken arc that ripples in
	-- latitude as it turns, so the planet reads as wavy brushed weather rather than stacked rings.
	local SEG = 32
	local bands: { BasePart } = {}
	local layout = {}
	for lat = 1, 13 do
		local phi = math.rad(-72 + (lat - 1) * 12)
		local bright = lat % 2 == 1
		local start, run = math.random(1, SEG), math.random(16, 28)
		local thick = radius * (0.07 + math.random() * 0.09)
		for s = 1, SEG do
			local lit = ((s - start) % SEG) &lt; run
			local p = slab(folder, if bright then Planet.Cyan else Planet.Deep, Vector3.new(1, thick, 0.3), if lit then (if bright then 0.12 else 0.3) else 1)
			table.insert(bands, p)
			table.insert(layout, { Phi = phi, Index = s, Lat = lat, Speed = (if bright then 0.9 else 0.55) * (1 + lat * 0.05) })
		end
	end
	-- Saturn ring: a faint translucent sheet between a bright outer rim and a fainter inner rim.
	local RING = 56
	local ring: { BasePart } = {}
	for _ = 1, RING do table.insert(ring, slab(folder, rgb(60, 210, 220), Vector3.new(1, 0.1, radius * 0.4), 0.88)) end
	for _ = 1, RING do table.insert(ring, slab(folder, Planet.Cyan, Vector3.new(1, 0.22, 0.28), 0)) end
	for _ = 1, RING do table.insert(ring, slab(folder, Planet.Cyan, Vector3.new(1, 0.12, 0.16), 0.55)) end
	local body: Body = { Shell = shell, Inner = inner, Core = core, Bands = bands, Ring = ring, Light = light, Radius = radius }
	local axis = CFrame.Angles(math.rad(14), 0, math.rad(-10))
	local ringTilt = CFrame.Angles(math.rad(14), 0, math.rad(-16))
	local clock = 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		if not shell.Parent then return end -- removed at detonation
		clock += dt
		local c = center()
		local r = shell.Size.X / 2 * 1.01
		local frames: { CFrame } = {}
		for n, p in bands do
			local l = layout[n]
			local yaw = l.Index / SEG * math.pi * 2 + clock * l.Speed
			local phi = l.Phi + 0.07 * math.sin(yaw * 3 + clock * 1.5 + l.Lat)
			local ring_r = r * math.cos(phi)
			frames[n] = CFrame.new(c) * axis * CFrame.new(0, r * math.sin(phi), 0) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -ring_r) * CFrame.Angles(phi, 0, 0)
			p.Size = Vector3.new(2 * ring_r * math.sin(math.pi / SEG) * 1.15, p.Size.Y, p.Size.Z)
		end
		for n, p in ring do
			local layer = math.ceil(n / RING)
			local s = n - (layer - 1) * RING
			local rr = r * (if layer == 1 then 1.72 elseif layer == 2 then 2.02 else 1.42)
			local yaw = s / RING * math.pi * 2 + clock * 0.25
			table.insert(frames, CFrame.new(c) * ringTilt * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -rr))
			p.Size = Vector3.new(2 * rr * math.sin(math.pi / RING) * 1.03, p.Size.Y, if layer == 1 then r * 0.55 else p.Size.Z)
		end
		local all = table.move(ring, 1, #ring, #bands + 1, table.clone(bands))
		Workspace:BulkMoveTo(all, frames, Enum.BulkMoveMode.FireCFrameChanged)
		shell.Position, inner.Position, core.Position = c, c, c
	end))
	return body
end

-- The planet burns white from the inside over `seconds` (the build to detonation).
function Planet.ignite(trove: Kit.Trove, body: Body, seconds: number)
	body.Core.Transparency = 0.05
	Kit.tween(trove, body.Core, seconds, { Size = Vector3.one * body.Radius * 1.7 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Kit.tween(trove, body.Inner, seconds, { Color = rgb(180, 255, 255), Transparency = 0.2 })
	Kit.tween(trove, body.Light, seconds, { Brightness = 10, Color = WHITE })
	for _, p in body.Bands do
		if p.Transparency &lt; 1 then Kit.tween(trove, p, seconds, { Color = WHITE }) end
	end
end

function Planet.remove(body: Body?)
	if not body then return end
	for _, p in { body.Shell, body.Inner, body.Core } do p:Destroy() end
	for _, p in body.Bands do p:Destroy() end
	for _, p in body.Ring do p:Destroy() end
end

return table.freeze(Planet)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="700">
            <Properties>
              <string name="Name">PlateLayout</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/PlateLayout
-- Decides what each overhead enemy plate shows so a crowd stays readable and nothing is repeated:
--   Focus   - the foe on the top TargetPlate: its overhead plate keeps only the attack warning.
--   Full    - the nearest few: name, health and posture.
--   Compact - further foes: bars only, no name.
--   Hidden  - beyond the budget, unless it is winding up an attack (warnings always show).
-- A plate that would overlap one already placed is lifted (in pixels) to sit just above it.
-- Pure; no engine calls.
local Layout = {}

Layout.MaxFull = 3
Layout.MaxShown = 6
Layout.Gap = { X = 150, Y = 46 } -- screen pixels one plate occupies
Layout.MaxLift = 3 * 46 -- pixels

export type Mode = "Focus" | "Full" | "Compact" | "Hidden"
export type Candidate = { Id: number, X: number, Y: number, Distance: number, Focus: boolean, Warning: boolean }
export type Placement = { Mode: Mode, Lift: number } -- Lift: screen pixels upward

function Layout.arrange(candidates: { Candidate }): { [number]: Placement }
	local order = table.clone(candidates)
	table.sort(order, function(a, b)
		if a.Focus ~= b.Focus then return a.Focus end
		if a.Distance ~= b.Distance then return a.Distance &lt; b.Distance end
		return a.Id &lt; b.Id -- stable when two foes stand at the same range
	end)
	local result: { [number]: Placement } = {}
	local placed: { { X: number, Y: number } } = {}
	local full, shown = 0, 0
	for _, c in order do
		local mode: Mode
		if c.Focus then
			mode = "Focus"
		elseif full &lt; Layout.MaxFull then
			mode, full = "Full", full + 1
		elseif shown &lt; Layout.MaxShown or c.Warning then
			mode = "Compact"
		else
			mode = "Hidden"
		end
		if mode ~= "Focus" and mode ~= "Hidden" then shown += 1 end
		local lift = 0
		if mode ~= "Hidden" then
			local y = c.Y
			local moved = true
			while moved do
				moved = false
				for _, p in placed do
					if math.abs(p.X - c.X) &lt; Layout.Gap.X and math.abs(p.Y - y) &lt; Layout.Gap.Y and c.Y - (p.Y - Layout.Gap.Y) &lt;= Layout.MaxLift then
						y = p.Y - Layout.Gap.Y
						moved = true
						break
					end
				end
			end
			lift = c.Y - y
			table.insert(placed, { X = c.X, Y = y })
		end
		result[c.Id] = { Mode = mode, Lift = lift }
	end
	return result
end

return table.freeze(Layout)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="701">
            <Properties>
              <string name="Name">PortraitCamera</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/PortraitCamera
-- Conversation framing for physical NPCs and Lin's altar projection. Tries over-the-shoulder shots
-- from the player's side (right, then left), then raised and wider angles, and takes the first whose
-- line to the speaker's head and chest is clear of visible geometry (bonfire, stone, pillars).
-- If every angle is blocked it pulls the best one in front of the obstruction, and as a last resort
-- frames from above. The projected spirit is placed on clear ground beside the altar, facing the
-- player. Selection is pure (a probe function is injected) so it is tested without the engine.
local Workspace = game:GetService("Workspace")

local Portrait = {}
Portrait.Distance = 7 -- studs from the speaker
Portrait.Shoulder = 2
Portrait.Height = 1
Portrait.Margin = 0.8 -- clearance kept around the camera
Portrait.MinReach = 3.2 -- a pulled-in shot closer than this is rejected
Portrait.Chest = 1.2 -- second sight line, below the head
Portrait.Fov = 52 -- vertical field of view while a conversation is framed (CameraController)

-- Returns where a segment first meets visible geometry, or nil when it is clear.
export type Probe = (from: Vector3, to: Vector3) -&gt; Vector3?

local function facing(subject: Vector3, viewer: Vector3): (Vector3, Vector3)
	local flat = Vector3.new(viewer.X - subject.X, 0, viewer.Z - subject.Z)
	local toward = if flat.Magnitude &gt; 0.1 then flat.Unit else Vector3.zAxis
	return toward, toward:Cross(Vector3.yAxis)
end

-- Camera positions in preference order: both shoulders, raised shoulders, then wide side angles.
function Portrait.candidates(subject: Vector3, viewer: Vector3): { Vector3 }
	local toward, side = facing(subject, viewer)
	local list: { Vector3 } = {}
	for _, spec in { { 1, 0, 1 }, { -1, 0, 1 }, { 1, 1.6, 0.9 }, { -1, 1.6, 0.9 }, { 2.6, 0.6, 0.7 }, { -2.6, 0.6, 0.7 } } do
		local offset = toward * Portrait.Distance * spec[3] + side * Portrait.Shoulder * spec[1]
		table.insert(list, subject + offset + Vector3.new(0, Portrait.Height + spec[2], 0))
	end
	return list
end

-- Picks a shot. Returns the camera position and whether it was a clean (unobstructed) candidate.
function Portrait.choose(subject: Vector3, viewer: Vector3, probe: Probe): (Vector3, boolean)
	local chest = subject - Vector3.new(0, Portrait.Chest, 0)
	local best: Vector3? = nil
	local bestReach = 0
	for _, c in Portrait.candidates(subject, viewer) do
		local away = (c - subject).Unit
		local past = c + away * Portrait.Margin
		local hit = probe(subject, past) or probe(chest, past)
		if not hit then return c, true end
		local reach = (hit - subject).Magnitude - Portrait.Margin
		if reach &gt; bestReach then best, bestReach = subject + away * reach, reach end
	end
	if best and bestReach &gt;= Portrait.MinReach then return best, false end
	local toward = facing(subject, viewer)
	return subject + toward * 2 + Vector3.new(0, 6, 0), false
end

-- Where Lin's spirit stands: beside the altar on the player's side, with a clear path from the
-- altar at chest height and (batch 07) in plain view of the player, so a stele or pillar never
-- stands between the two; resting on the ground below. Returns the spirit's pivot position.
function Portrait.spiritSpot(altar: Vector3, viewer: Vector3, probe: Probe): Vector3
	local toward, side = facing(altar, viewer)
	local chosen = altar + toward * 3 + side * 2
	local eye = viewer + Vector3.new(0, 1.5, 0)
	for _, offset in { toward * 3 + side * 2, toward * 3 + side * -2, toward * 4, side * 3, side * -3 } do
		local spot = altar + offset
		local chest = spot + Vector3.new(0, 3, 0)
		if not probe(altar + Vector3.new(0, 3, 0), chest) and not probe(chest, eye) then chosen = spot; break end
	end
	local ground = probe(chosen + Vector3.new(0, 5, 0), chosen - Vector3.new(0, 4, 0))
	return Vector3.new(chosen.X, (if ground then ground.Y else chosen.Y) + 2, chosen.Z)
end

-- Engine probe: ignores the excluded instances and invisible volumes, so only what the player
-- would actually see between the camera and the speaker counts as an obstruction.
function Portrait.probe(exclude: { Instance }): Probe
	return function(from: Vector3, to: Vector3): Vector3?
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignored = table.clone(exclude)
		params.FilterDescendantsInstances = ignored
		for _ = 1, 6 do
			local result = Workspace:Raycast(from, to - from, params)
			if not result then return nil end
			local part = result.Instance
			if part.Transparency &lt; 0.9 then return result.Position end
			table.insert(ignored, part)
			params.FilterDescendantsInstances = ignored
		end
		return nil
	end
end

-- Looks from `position` at `face`, pitched down so the face sits at `faceY` of the screen height
-- (0 = top) instead of the centre, which the dialogue panel covers.
function Portrait.aim(position: Vector3, face: Vector3, faceY: number): CFrame
	local above = math.clamp(1 - 2 * faceY, 0, 0.9) -- how far above the centre, in half-screens
	local pitch = math.atan(above * math.tan(math.rad(Portrait.Fov) / 2))
	return CFrame.lookAt(position, face) * CFrame.Angles(-pitch, 0, 0)
end

-- The speaker's own model: JadeCataclysm.&lt;npc&gt;, else any model tagged AsuraNPC = npc (Master Smith
-- Gao stands in the Sanctuary loggia). F13: Gao was never found, so his body was not excluded from
-- the probe, every shot hit him and the portrait fell back to looking down on his topknot.
function Portrait.speaker(npc: string, world: Instance?, tagged: { Instance }): Instance?
	local found = world and world:FindFirstChild(npc)
	if found then return found end
	for _, model in tagged do
		if model:IsA("Model") and model:GetAttribute("AsuraNPC") == npc then return model end
	end
	return nil
end

function Portrait.frame(subject: Vector3, viewer: Vector3, exclude: { Instance }): CFrame
	local position = Portrait.choose(subject, viewer, Portrait.probe(exclude))
	return CFrame.lookAt(position, subject)
end

return table.freeze(Portrait)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="702">
            <Properties>
              <string name="Name">PrologueController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/PrologueController
-- Opening presentation (batch 10, #43). An opaque veil covers the screen from the first frame until
-- the avatar has loaded its appearance and settled at the spawn (the server holds respawns for
-- 1.5 s), so no grey silhouette or half-built HUD shows through. New players (nothing kindled
-- beyond the Primal Bonfire) then see four letterboxed lines; any key, button or tap skips. The
-- camera is set behind the standing avatar before the veil lifts, and the handoff names the first
-- step (rest at the bonfire, then train at the Monastery Gate). Replayable from the Respite menu.
-- Presentation only; input is parked in menu mode while the veil is up.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)

local P = HudKit.Palette
local HOLD = 4.2
local FADE = 1.1
local LOAD_TIMEOUT = 8 -- seconds before the veil lifts even if the appearance never reports loaded
local SETTLE = 1.6 -- spawn hold plus a beat, so the avatar is standing still when revealed

local LINES: { { string } } = {
 {"Shen devoured the souls of his disciples.", "THE JADE CATACLYSM"},
 {"The celestial pillars shattered. The Abyss awoke.", "Six Fallen Sovereigns bind the living to the dead."},
 {"You are an Asura Emissary, a phantom without an afterlife.", "The ferryman will not carry a soul still bound by six chains."},
 {"Lay the six sovereigns to rest.", "Harvest Qi. Kindle the altars. Choose your path beyond death."},
}

local Controller = {}
Controller.Handoff = { "WALK THE ASURA'S PATH", "Kneel at the bonfire to rest · then train at the Monastery Gate" }
Controller.HandoffSeconds = 4

function Controller.isNewcomer(altars: any): boolean
	return type(altars) ~= "string" or altars == "" or altars == "Altar_SanctuaryBonfire"
end

-- Blocks until the character exists, its appearance has loaded and it has settled (or timeout).
local function ready(player: Player)
	local deadline = os.clock() + LOAD_TIMEOUT
	local character = player.Character or player.CharacterAdded:Wait()
	while os.clock() &lt; deadline and not (player:HasAppearanceLoaded() and character:FindFirstChild("HumanoidRootPart")) do task.wait(0.1) end
	while os.clock() &lt; deadline and player:GetAttribute("AsuraAltars") == nil do task.wait(0.1) end
	task.wait(SETTLE)
end

-- Plays the opening. `force` replays it for anyone (Respite menu); otherwise only newcomers see the
-- lines and everyone else just gets the clean load veil. `ui` gets a PrologueActive flag.
function Controller.Play(ui: any, input: any, camera: any?, force: boolean?)
	local player = Players.LocalPlayer
	if ui.PrologueActive then return end
	ui.PrologueActive = true
	input:SetMenu(true, "Prologue")
	local gui = HudKit.make("ScreenGui", player:WaitForChild("PlayerGui"), { Name = "AsuraPrologue", IgnoreGuiInset = true, DisplayOrder = 60, ResetOnSpawn = false }) :: ScreenGui
	local veil = HudKit.make("Frame", gui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, BorderSizePixel = 0 }) :: Frame
	local bars: { Frame } = {}
	for edge = 0, 1 do
		table.insert(bars, HudKit.make("Frame", veil, { AnchorPoint = Vector2.new(0, edge), Position = UDim2.fromScale(0, edge), Size = UDim2.new(1, 0, 0.12, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }))
	end
	local line = HudKit.label(veil, "", 34, HudKit.TitleFont, P.Ivory, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.new(0.8, 0, 0, 48), TextScaled = true, TextTransparency = 1, TextStrokeTransparency = 1 })
	HudKit.make("UITextSizeConstraint", line, { MinTextSize = 18, MaxTextSize = 34 })
	local sub = HudKit.label(veil, "", 20, HudKit.BodyFont, P.Ember, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.45, 34), Size = UDim2.new(0.8, 0, 0, 30), TextWrapped = true, TextTransparency = 1, TextStrokeTransparency = 1 })
	local hint = HudKit.label(veil, "", 14, HudKit.BodyFont, P.Muted, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 0.88, -10), Size = UDim2.fromOffset(320, 20), TextXAlignment = Enum.TextXAlignment.Right })

	if not force then ready(player) end
	local story = force == true or Controller.isNewcomer(player:GetAttribute("AsuraAltars"))
	local skipped = false
	local skip = UserInputService.InputBegan:Connect(function(event: InputObject)
		local t = event.UserInputType
		if t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 or string.sub(t.Name, 1, 7) == "Gamepad" then
			skipped = true
		end
	end)
	local function fade(target: number, duration: number)
		local info = TweenInfo.new(duration, Enum.EasingStyle.Sine)
		TweenService:Create(line, info, { TextTransparency = target, TextStrokeTransparency = if target &lt; 1 then 0.6 else 1 }):Play()
		TweenService:Create(sub, info, { TextTransparency = target, TextStrokeTransparency = if target &lt; 1 then 0.7 else 1 }):Play()
	end
	local function hold(seconds: number)
		local finish = os.clock() + seconds
		while os.clock() &lt; finish and not skipped do task.wait(0.05) end
	end
	if story then
		hint.Text = if UserInputService.GamepadEnabled then "Press any button to skip" else "Press any key or tap to skip"
		for _, entry in LINES do
			if skipped then break end
			line.Text, sub.Text = entry[1], entry[2]
			fade(0, FADE)
			hold(FADE + HOLD)
			fade(1, FADE * 0.7)
			hold(FADE * 0.7)
		end
	end
	skip:Disconnect()
	hint.Text = ""
	-- A deliberate first view: behind the avatar, facing where the spawn faces.
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if camera and root and root:IsA("BasePart") then camera:Face(root.CFrame.LookVector) end
	local lift = if story then 1.4 else 0.6
	local out = TweenService:Create(veil, TweenInfo.new(lift, Enum.EasingStyle.Sine), { BackgroundTransparency = 1 })
	fade(1, 0.4)
	for _, bar in bars do
		TweenService:Create(bar, TweenInfo.new(lift, Enum.EasingStyle.Sine), { BackgroundTransparency = 1 }):Play()
	end
	out:Play()
	out.Completed:Wait()
	gui:Destroy()
	input:SetMenu(false, "Prologue")
	ui.PrologueActive = false
	if story then
		ui.HandoffUntil = os.clock() + Controller.HandoffSeconds -- the controls card waits for it (F08)
		ui:ShowBanner(Controller.Handoff[1], Controller.Handoff[2], Controller.HandoffSeconds)
	end
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="703">
            <Properties>
              <string name="Name">QiVfx</string>
              <string name="Source">--!strict
local Debris = game:GetService("Debris")
local Tween = game:GetService("TweenService")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Surfaces = require(script.Parent.CombatSurfaces)
local Qi = {}
function Qi.seal(hand: BasePart, color: Color3, duration: number): BillboardGui?
	if Assets.Textures.Rune == "" then return nil end
	local gui = Instance.new("BillboardGui")
	gui.Name, gui.Adornee, gui.Size, gui.LightInfluence = "QiHandSeal", hand, UDim2.fromScale(1,1), 0
	gui.AlwaysOnTop = false
	local image = Instance.new("ImageLabel")
	image.Image, image.ImageColor3, image.BackgroundTransparency = Assets.Textures.Rune, color, 1
	image.Size, image.Parent = UDim2.fromScale(1,1), gui
	gui.Parent = hand
	Tween:Create(gui,TweenInfo.new(duration),{Size=UDim2.fromScale(4,4)}):Play()
	Tween:Create(image,TweenInfo.new(duration),{Rotation=180,ImageTransparency=1}):Play()
	Debris:AddItem(gui,duration+0.1); return gui
end
function Qi.tail(head: BasePart, color: Color3)
	local a,b=Instance.new("Attachment"),Instance.new("Attachment")
	a.Position,b.Position=Vector3.new(-0.2,0,0),Vector3.new(0.2,0,0)
	a.Parent,b.Parent=head,head
	local trail=Instance.new("Trail")
	trail.Attachment0,trail.Attachment1,trail.FaceCamera=a,b,true
	trail.Lifetime,trail.MinLength,trail.LightEmission=0.2,0.02,0.8
	trail.Color=ColorSequence.new(Color3.new(1,1,1),color)
	trail.Transparency=NumberSequence.new(0.15,1);trail.Texture=Assets.Textures.Ribbon;trail.Parent=head
	if Assets.Textures.Smoke~="" then
		local smoke=Instance.new("ParticleEmitter")
		smoke.Texture,smoke.Rate,smoke.Lifetime=Assets.Textures.Smoke,18,NumberRange.new(0.15,0.35)
		smoke.Color,smoke.Speed,smoke.Drag=ColorSequence.new(color),NumberRange.new(0.2,0.5),2
		smoke.Size,smoke.Transparency=NumberSequence.new(0.25,1.4),NumberSequence.new(0.65,1)
		smoke.Parent=head
	end
end
function Qi.rupture(folder: Instance, point: Vector3, direction: Vector3, color: Color3, character: Model?)
	local excludes: {Instance}={}
	if character then table.insert(excludes,character) end
	Surfaces.rupture(folder,point,direction,color,excludes)
end
return Qi
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="704">
            <Properties>
              <string name="Name">SakuraCompass</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/SakuraCompass
-- Top-centre heading strip: a sakura hairline with seal-crest finials, a crest medallion at the
-- centre, the nearest heading above it, and cardinal/intercardinal marks plus 15-degree ticks that
-- slide along the line as the camera turns. North is world -Z.
local Workspace = game:GetService("Workspace")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)

local Compass = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local SIZE = Vector2.new(520, 60)
local HALF_SPAN = 80 -- degrees visible either side of centre
local LINE_Y = 30
local NAMES = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }

type Mark = { Gui: GuiObject, Bearing: number }
export type View = { Root: Frame, Marks: { Mark }, Heading: TextLabel }

function Compass.new(gui: ScreenGui): View
	local root = HudKit.make("Frame", gui, {
		Name = "Compass", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.36, 0, 0, SIZE.Y), BackgroundTransparency = 1,
	}) :: Frame
	HudKit.make("UISizeConstraint", root, { MaxSize = SIZE, MinSize = Vector2.new(240, SIZE.Y) })
	local line = HudKit.make("Frame", root, {
		Name = "Line", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(0, LINE_Y), Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = C.Sakura, BorderSizePixel = 0,
	})
	HudKit.make("UIGradient", line, { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.15, 0.25), NumberSequenceKeypoint.new(0.85, 0.25), NumberSequenceKeypoint.new(1, 0.9),
	}) })
	Sakura.crest(root, 16, UDim2.new(0, 2, 0, LINE_Y))
	Sakura.crest(root, 16, UDim2.new(1, -2, 0, LINE_Y))
	local marks: { Mark } = {}
	for bearing = 0, 345, 15 do
		local named = bearing % 45 == 0
		local gui: GuiObject
		if named then
			local text = NAMES[bearing // 45 + 1]
			local cardinal = #text == 1
			gui = HudKit.label(root, text, if cardinal then 16 else 12, Enum.Font.Garamond, if cardinal then C.Ivory else C.Blossom, {
				AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(28, 16),
			})
			gui.Position = UDim2.new(0.5, 0, 0, LINE_Y + 6)
		else
			gui = HudKit.make("Frame", root, {
				Name = "Tick", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(1, 6), BackgroundColor3 = C.Sakura, BorderSizePixel = 0,
			}) :: Frame
			gui.Position = UDim2.new(0.5, 0, 0, LINE_Y)
		end
		table.insert(marks, { Gui = gui, Bearing = bearing })
	end
	Sakura.medallion(root, 30, UDim2.new(0.5, 0, 0, LINE_Y), false)
	Sakura.crest(root, 24, UDim2.new(0.5, 0, 0, LINE_Y))
	local heading = HudKit.label(root, "N", 13, Enum.Font.Garamond, C.Ivory, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(40, 12), TextStrokeTransparency = 0.3,
	})
	return { Root = root, Marks = marks, Heading = heading }
end

function Compass.step(view: View)
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local look = camera.CFrame.LookVector
	local heading = math.deg(math.atan2(look.X, -look.Z)) % 360
	for _, mark in view.Marks do
		local delta = (mark.Bearing - heading + 540) % 360 - 180
		local shown = math.abs(delta) &lt; HALF_SPAN and math.abs(delta) &gt; 6
		mark.Gui.Visible = shown
		if shown then
			local x = 0.5 + delta / (HALF_SPAN * 2)
			mark.Gui.Position = UDim2.new(x, 0, mark.Gui.Position.Y.Scale, mark.Gui.Position.Y.Offset)
			local fade = math.clamp((math.abs(delta) - HALF_SPAN * 0.6) / (HALF_SPAN * 0.4), 0, 1)
			if mark.Gui:IsA("TextLabel") then
				mark.Gui.TextTransparency = fade
				mark.Gui.TextStrokeTransparency = math.max(fade, 0.5)
			else
				mark.Gui.BackgroundTransparency = 0.2 + fade * 0.8
			end
		end
	end
	view.Heading.Text = NAMES[math.floor((heading + 22.5) / 45) % 8 + 1]
end

return table.freeze(Compass)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="705">
            <Properties>
              <string name="Name">SakuraHud</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/SakuraHud
-- Owns the sakura HUD furniture that is not tied to combat state: the compass, the minimap (with
-- its Respite / Controls buttons) and a light drift of screen-space petals. Hidden with the rest
-- of the HUD during the prologue and the death screen. Petals are decoration: they thin out and
-- fade during fights (and with reduced effects) so warnings stay the brightest thing on screen.
local Players = game:GetService("Players")
local Effects = require(game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath"):WaitForChild("Shared"):WaitForChild("EffectsPreference") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Visibility = require(script.Parent:WaitForChild("HudVisibility") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local Compass = require(script.Parent:WaitForChild("SakuraCompass") :: ModuleScript)
local Minimap = require(script.Parent:WaitForChild("SakuraMinimap") :: ModuleScript)

local Controller = {}
Controller.__index = Controller
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local PETALS = 14 -- 0 disables the overlay
local FALL = { 28, 64 } -- pixels per second
local SWAY = 26 -- pixels
local ENGAGE_RADIUS = 45 -- a live hostile this close (or a boss encounter) counts as a fight
local BLEND = 2.5 -- density change per second

type Petal = { Gui: Frame, X: number, Y: number, Speed: number, Phase: number, Spin: number, Size: number, Alpha: number }
export type SakuraHud = typeof(setmetatable({} :: {
	Ui: any, State: any, Compass: Compass.View, Minimap: Minimap.View, Layer: Frame, Petals: { Petal }, Random: Random,
	Density: number, Engaged: boolean, Probe: number,
}, Controller))

-- In an active fight: a boss encounter, or a live hostile within ENGAGE_RADIUS.
local function engaged(state: any): boolean
	local boss = Players.LocalPlayer:GetAttribute("AsuraEncounter")
	if type(boss) == "string" and boss ~= "" then
		return true
	end
	local own = state:Own()
	if not own or not own.Root then
		return false
	end
	for _, entity in state.Entities do
		if entity.Root and state:IsHostile(entity) and state:IsAlive(entity)
			and (entity.Root.Position - own.Root.Position).Magnitude &lt;= ENGAGE_RADIUS then
			return true
		end
	end
	return false
end

function Controller.new(state: any, ui: any, pause: any, controls: any): SakuraHud
	local layer = HudKit.make("Frame", ui.Gui, {
		Name = "SakuraPetals", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Active = false,
	}) :: Frame
	local rng = Random.new()
	local petals: { Petal } = {}
	for _ = 1, PETALS do
		local size = rng:NextNumber(8, 14)
		local alpha = rng:NextNumber(0.15, 0.45)
		local gui = HudKit.make("Frame", layer, {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size * 0.62), BorderSizePixel = 0,
			BackgroundColor3 = if rng:NextNumber() &lt; 0.5 then C.BloodPetal else C.EmberPetal, BackgroundTransparency = alpha,
		}) :: Frame
		HudKit.make("UICorner", gui, { CornerRadius = UDim.new(1, 0) })
		table.insert(petals, {
			Gui = gui, X = rng:NextNumber(), Y = rng:NextNumber(-40, 900), Speed = rng:NextNumber(FALL[1], FALL[2]),
			Phase = rng:NextNumber(0, math.pi * 2), Spin = rng:NextNumber(-90, 90), Size = size, Alpha = alpha,
		})
	end
	local buttons = {
		{ Glyph = "≡", Angle = 305, Press = function() pause:Toggle() end },
		{ Glyph = "?", Angle = 55, Press = function() controls:SetOpen(not controls.Open) end },
	}
	return setmetatable({
		Ui = ui, State = state, Compass = Compass.new(ui.Gui), Minimap = Minimap.new(ui.Gui, state, buttons), Layer = layer, Petals = petals,
		Random = rng, Density = 1, Engaged = false, Probe = 0,
	}, Controller)
end

function Controller.Update(self: SakuraHud, dt: number)
	local hidden = not Visibility.of(self.Ui).Decor
	self.Compass.Root.Visible = not hidden
	self.Minimap.Root.Visible = not hidden
	self.Layer.Visible = not hidden
	if hidden then return end
	Compass.step(self.Compass)
	Minimap.step(self.Minimap, self.Ui.Route)
	self.Probe -= dt
	if self.Probe &lt;= 0 then
		self.Probe, self.Engaged = 0.25, engaged(self.State)
	end
	local target = Effects.decor(self.Engaged)
	self.Density += math.clamp(target - self.Density, -BLEND * dt, BLEND * dt)
	local shown = math.ceil(#self.Petals * self.Density - 1e-3)
	local contrast = if self.Engaged then Effects.CombatContrast else 1
	local height = math.max(self.Layer.AbsoluteSize.Y, 1)
	for index, p in self.Petals do
		p.Gui.Visible = index &lt;= shown
		p.Gui.BackgroundTransparency = 1 - (1 - p.Alpha) * contrast
		p.Y += p.Speed * dt
		p.Phase += dt * 1.6
		if p.Y &gt; height + 20 then
			p.Y, p.X = -20, self.Random:NextNumber()
		end
		p.Gui.Position = UDim2.new(p.X, math.sin(p.Phase) * SWAY, 0, p.Y)
		p.Gui.Rotation += p.Spin * dt
		p.Gui.Size = UDim2.fromOffset(p.Size * (0.35 + 0.65 * math.abs(math.cos(p.Phase * 0.8))), p.Size * 0.62) -- tumbling flip
	end
end

function Controller.Destroy(self: SakuraHud)
	self.Compass.Root:Destroy()
	self.Minimap.Root:Destroy()
	self.Layer:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="706">
            <Properties>
              <string name="Name">SakuraKit</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/SakuraKit
-- Sakura HUD primitives, built purely from instances (no uploaded art): martial diamond-seal
-- crests, ringed medallions, diamond caps, segmented stat bars compatible with the Interface
-- `Arc` contract ({ Segments, Count }) and round crest-backed buttons.
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)

local Kit = {}
local make = HudKit.make

-- Customization ------------------------------------------------------------------------------
Kit.Colors = table.freeze({
	Ink = Color3.fromRGB(22, 10, 20), Plum = Color3.fromRGB(48, 18, 42), Track = Color3.fromRGB(40, 20, 34),
	Sakura = Color3.fromRGB(247, 168, 200), Blossom = Color3.fromRGB(255, 218, 232), Rose = Color3.fromRGB(214, 84, 140),
	Crimson = Color3.fromRGB(196, 22, 38), Gold = Color3.fromRGB(236, 196, 120), Ivory = Color3.fromRGB(255, 240, 246),
	Qi = Color3.fromRGB(196, 120, 236), Stamina = Color3.fromRGB(255, 196, 214),
	-- Grimdark drift: blood-red screen petals (decoration only; warnings use Crimson + shape).
	BloodPetal = Color3.fromRGB(122, 10, 20), EmberPetal = Color3.fromRGB(176, 28, 36),
})
local C = Kit.Colors

export type Bar = { Segments: { Frame }, Count: number }

local function round(gui: GuiObject)
	make("UICorner", gui, { CornerRadius = UDim.new(1, 0) })
end

-- Martial seal: a crossed blade star behind a lacquered outer diamond, a crimson inner diamond
-- and a gold centre pip. Replaces the old five-petal blossom wherever a motif is drawn.
function Kit.crest(parent: Instance, size: number, position: UDim2, tint: Color3?): Frame
	local holder = make("Frame", parent, {
		Name = "Crest", AnchorPoint = Vector2.new(0.5, 0.5), Position = position, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
	}) :: Frame
	local thin = math.max(1, size * 0.07)
	for _, rotation in { 0, 90 } do -- blade cross reaching past the seal
		make("Frame", holder, {
			Name = "Blade", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(thin, size),
			Rotation = rotation, BackgroundColor3 = C.Gold, BackgroundTransparency = 0.15, BorderSizePixel = 0,
		})
	end
	local outer = make("Frame", holder, {
		Name = "Seal", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size * 0.6, size * 0.6),
		Rotation = 45, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}) :: Frame
	make("UIGradient", outer, { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(70, 16, 22), C.Ink) })
	make("UIStroke", outer, { Color = C.Gold, Thickness = if size &gt; 30 then 1.5 else 1, Transparency = 0.1 })
	local inner = make("Frame", outer, {
		Name = "Core", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.55, 0.55),
		BackgroundColor3 = tint or C.Crimson, BorderSizePixel = 0,
	}) :: Frame
	make("UIStroke", inner, { Color = C.Ink, Thickness = 1 })
	make("Frame", inner, {
		Name = "Pip", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.36, 0.36),
		BackgroundColor3 = C.Gold, BorderSizePixel = 0,
	})
	return holder
end

-- Plum disc, sakura outer ring, faint gold inner ring, optional centre crest and rim studs.
function Kit.medallion(parent: Instance, size: number, position: UDim2, withCrest: boolean?, studs: { number }?): Frame
	local disc = make("Frame", parent, {
		Name = "Medallion", AnchorPoint = Vector2.new(0.5, 0.5), Position = position, Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = C.Plum, BackgroundTransparency = 0.15, BorderSizePixel = 0,
	}) :: Frame
	round(disc)
	make("UIGradient", disc, { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(120, 60, 100), C.Ink) })
	make("UIStroke", disc, { Color = C.Sakura, Thickness = math.max(2, size / 36), Transparency = 0.05 })
	local inner = make("Frame", disc, {
		Name = "Inner", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -10, 1, -10), BackgroundTransparency = 1,
	}) :: Frame
	round(inner)
	make("UIStroke", inner, { Color = C.Gold, Thickness = 1, Transparency = 0.5 })
	if withCrest then
		Kit.crest(disc, size * 0.62, UDim2.fromScale(0.5, 0.5))
	end
	local list: { number } = studs or {}
	for _, degrees in list do
		local a = math.rad(degrees - 90)
		Kit.crest(disc, math.max(12, size * 0.2), UDim2.new(0.5, math.cos(a) * size * 0.5, 0.5, math.sin(a) * size * 0.5))
	end
	return disc
end

function Kit.diamond(parent: Instance, size: number, position: UDim2, fill: Color3, edge: Color3?): Frame
	local d = make("Frame", parent, {
		Name = "Diamond", AnchorPoint = Vector2.new(0.5, 0.5), Position = position, Size = UDim2.fromOffset(size, size),
		Rotation = 45, BackgroundColor3 = fill, BorderSizePixel = 0, ZIndex = 4,
	}) :: Frame
	make("UIStroke", d, { Color = edge or C.Ink, Thickness = 1.5 })
	return d
end

-- Horizontal segmented bar: segments fill left-to-right so Interface setArc can colour them.
function Kit.bar(parent: Instance, name: string, position: Vector2, width: number, height: number, count: number, caps: boolean): (Frame, Bar)
	local frame = make("Frame", parent, {
		Name = name, Position = UDim2.fromOffset(position.X, position.Y), Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = C.Ink, BackgroundTransparency = 0.25, BorderSizePixel = 0,
	}) :: Frame
	make("UIStroke", frame, { Color = C.Rose, Thickness = 1, Transparency = 0.25 })
	local segments: { Frame } = {}
	local step = (width - 2) / count
	for i = 1, count do
		segments[i] = make("Frame", frame, {
			Name = "Segment" .. i, Position = UDim2.fromOffset(1 + (i - 1) * step, 1), Size = UDim2.new(0, math.ceil(step), 1, -2),
			BackgroundColor3 = C.Track, BorderSizePixel = 0,
		}) :: Frame
	end
	local gloss = make("Frame", frame, { -- lacquer highlight across the upper half
		Name = "Gloss", Size = UDim2.new(1, 0, 0.45, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = 3,
	}) :: Frame
	make("UIGradient", gloss, { Rotation = 90, Transparency = NumberSequence.new(0.2, 1) })
	if caps then
		Kit.diamond(frame, height * 0.9, UDim2.new(0, 0, 0.5, 0), C.Sakura)
		Kit.diamond(frame, height * 0.9, UDim2.new(1, 0, 0.5, 0), C.Sakura)
	end
	return frame, { Segments = segments, Count = count }
end

-- Round skill-style button: plum disc ringed in sakura over a faded seal crest.
function Kit.roundButton(parent: Instance, size: number, position: UDim2, glyph: string): TextButton
	local holder = make("Frame", parent, {
		Name = "Holder", AnchorPoint = Vector2.new(0.5, 0.5), Position = position, Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
	}) :: Frame
	local back = Kit.crest(holder, size * 1.32, UDim2.fromScale(0.5, 0.5), C.Rose)
	local seal = back:FindFirstChild("Seal") :: Frame?
	if seal then seal.BackgroundTransparency = 0.35 end
	-- The lacquer disc sits behind a clear button so its gradient never tints the glyph.
	local disc = make("Frame", holder, {
		Name = "Disc", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}) :: Frame
	round(disc)
	make("UIGradient", disc, { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(150, 80, 130), Color3.fromRGB(58, 24, 50)) })
	make("UIStroke", disc, { Color = C.Sakura, Thickness = 2 })
	local button = make("TextButton", holder, {
		Name = "Button", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0,
		Text = glyph, Font = Enum.Font.Antique, TextSize = size * 0.42, TextColor3 = C.Blossom, ZIndex = 2,
	}) :: TextButton
	round(button)
	return button
end

return table.freeze(Kit)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="707">
            <Properties>
              <string name="Name">SakuraMinimap</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/SakuraMinimap
-- Top-left blossom radar that turns with the camera: sakura-ringed plum disc with corner sprigs,
-- N/E/S/W on the rim, the player's arrow fixed at the centre, crimson dots for hostiles, blossom
-- dots for other fighters, gold diamonds for Incense Altars, the region name beneath, and small
-- round blossom buttons on the rim (Respite menu, Controls). Follow-up 14: under the dots, the
-- objective's walked route (MinimapRoute) - doorways, climbs, portal exits and the bloodstain.
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local World = require(Shared:WaitForChild("Shared"):WaitForChild("WorldDefinitions") :: ModuleScript) :: any
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local RouteLayer = require(script.Parent:WaitForChild("MinimapRoute") :: ModuleScript)

local Map = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local DIAMETER = 150
local RANGE = 140 -- studs from centre to rim
local DOT_POOL = 24
local ALTAR_POOL = 8

export type Button = { Glyph: string, Angle: number, Press: () -&gt; () }
export type View = { Root: Frame, Disc: Frame, Letters: { [number]: TextLabel }, Dots: { Frame }, Altars: { Frame }, Region: TextLabel, State: any,
	Route: RouteLayer.View }

local function dot(parent: Instance, size: number, color: Color3, diamond: boolean): Frame
	local d = HudKit.make("Frame", parent, {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size), BackgroundColor3 = color,
		BorderSizePixel = 0, Rotation = if diamond then 45 else 0, Visible = false, ZIndex = 3,
	}) :: Frame
	if not diamond then HudKit.make("UICorner", d, { CornerRadius = UDim.new(1, 0) }) end
	HudKit.make("UIStroke", d, { Color = C.Ink, Thickness = 1 })
	return d
end

function Map.new(gui: ScreenGui, state: any, buttons: { Button }): View
	local root = HudKit.make("Frame", gui, {
		Name = "Minimap", Position = UDim2.fromOffset(20, 66), Size = UDim2.fromOffset(DIAMETER + 40, DIAMETER + 40), BackgroundTransparency = 1,
	}) :: Frame
	root.Destroying:Once(HudKit.bindScale(root, 0.82))
	local centre = UDim2.fromOffset((DIAMETER + 40) / 2, (DIAMETER + 40) / 2)
	local disc = Sakura.medallion(root, DIAMETER, centre, false, { 315, 45, 160 })
	disc.BackgroundTransparency = 0.3
	for _, rotation in { 0, 90 } do -- faint crosshair
		HudKit.make("Frame", disc, {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -24, 0, 1), Rotation = rotation,
			BackgroundColor3 = C.Sakura, BackgroundTransparency = 0.8, BorderSizePixel = 0,
		})
	end
	local letters: { [number]: TextLabel } = {}
	for i, text in { "N", "E", "S", "W" } do
		letters[(i - 1) * 90] = HudKit.label(disc, text, if text == "N" then 15 else 12, Enum.Font.Garamond, if text == "N" then C.Sakura else C.Ivory, {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 16), ZIndex = 4, TextStrokeTransparency = 0.3,
		})
	end
	HudKit.label(disc, "▲", 18, Enum.Font.GothamBold, C.Blossom, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(20, 20), ZIndex = 5, TextStrokeTransparency = 0.2,
	})
	local route = RouteLayer.new(disc, DIAMETER)
	local dots, altars = {}, {}
	for i = 1, DOT_POOL do dots[i] = dot(disc, 7, C.Crimson, false) end
	for i = 1, ALTAR_POOL do altars[i] = dot(disc, 8, C.Gold, true) end
	local region = HudKit.label(disc, "", 11, Enum.Font.Garamond, C.Blossom, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.66, 0), Size = UDim2.fromOffset(110, 14), ZIndex = 4, TextStrokeTransparency = 0.3,
	})
	for _, b in buttons do
		local a = math.rad(b.Angle - 90)
		local r = DIAMETER * 0.5 + 4
		local button = Sakura.roundButton(root, 30, centre + UDim2.fromOffset(math.cos(a) * r, math.sin(a) * r), b.Glyph)
		button.TextSize, button.Font = 15, Enum.Font.GothamBold
		button.Activated:Connect(b.Press)
	end
	return { Root = root, Disc = disc, Letters = letters, Dots = dots, Altars = altars, Region = region, State = state, Route = route }
end

-- Places `offset` (world, studs) on the disc relative to the camera's flat heading.
local function place(gui: Frame, offset: Vector3, look: Vector3, right: Vector3)
	local x, y = offset:Dot(right) / RANGE, -offset:Dot(look) / RANGE
	local distance = math.sqrt(x * x + y * y)
	local edge = distance &gt; 0.86
	if edge then x, y = x / distance * 0.86, y / distance * 0.86 end
	gui.Position = UDim2.fromScale(0.5 + x * 0.5, 0.5 + y * 0.5)
	gui.BackgroundTransparency = if edge then 0.55 else 0
	gui.Visible = true
end

-- `route` is ObjectiveController's staged route (ui.Route), nil when guidance is hidden.
function Map.step(view: View, route: RouteLayer.Route?)
	local camera = Workspace.CurrentCamera
	local own = view.State:Own()
	local root = own and own.Root
	if not camera or not root then return end
	local flat = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	local look = if flat.Magnitude &gt; 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
	local right = look:Cross(Vector3.yAxis)
	local heading = math.atan2(look.X, -look.Z)
	for bearing, letter in view.Letters do
		local a = math.rad(bearing) - heading
		letter.Position = UDim2.new(0.5, math.sin(a) * (DIAMETER * 0.5 - 13), 0.5, -math.cos(a) * (DIAMETER * 0.5 - 13))
	end
	RouteLayer.step(view.Route, route, root.Position, look, right, RANGE)
	local used = 0
	for _, entity in view.State.Entities do
		if entity ~= own and entity.Root and used &lt; #view.Dots and view.State:IsAlive(entity) then
			local offset = entity.Root.Position - root.Position
			if offset.Magnitude &lt; RANGE * 2 then
				used += 1
				local d = view.Dots[used]
				d.BackgroundColor3 = if view.State:IsHostile(entity) then C.Crimson else C.Blossom
				place(d, offset, look, right)
			end
		end
	end
	for i = used + 1, #view.Dots do view.Dots[i].Visible = false end
	used = 0
	for _, altar in World.Altars do
		local p = altar.Placement
		local offset = Vector3.new(p.X, p.Y, p.Z) - root.Position
		if offset.Magnitude &lt; RANGE * 1.5 and used &lt; #view.Altars then
			used += 1
			place(view.Altars[used], offset, look, right)
		end
	end
	for i = used + 1, #view.Altars do view.Altars[i].Visible = false end
	local id = Players.LocalPlayer:GetAttribute("AsuraRegion")
	local info = if type(id) == "string" then World.Regions[id] else nil
	view.Region.Text = if info then string.upper(info.Name) else ""
end

return table.freeze(Map)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="708">
            <Properties>
              <string name="Name">SanguineCombat</string>
              <string name="Source">--!strict
-- The VFX demo's crimson/cobalt clash and layered sword wake, sized to real attack reach.
local G = require(script.Parent.SanguineGeometry)
local Combat = {}
local WHITE, GOLD = Color3.fromRGB(255, 245, 229), Color3.fromRGB(255, 195, 86)
local RED, BLUE = Color3.fromRGB(218, 22, 42), Color3.fromRGB(60, 135, 245)
function Combat.slash(ctx: any, root: BasePart, move: any)
	local group = ctx:Group("SanguineWeaponCrescent", 0.45)
	if not group then return end
	local heavy = move.Kind ~= "Light"
	local reach = math.clamp(move.Reach, 1, 16)
	local half = math.rad(math.clamp(move.Arc, 15, 160) * 0.5)
	local cf = root.CFrame
	local color = if heavy then GOLD elseif (move.ComboIndex or 1) % 2 == 0 then BLUE else RED
	for layer = 1, 2 do
		local previous: Vector3? = nil
		for i = 0, 8 do
			local angle = -half + half * 2 * i / 8
			local point = cf:PointToWorldSpace(Vector3.new(math.sin(angle) * reach, 0.25 + math.sin(angle) * 0.6,
				-math.cos(angle) * reach * (if layer == 1 then 1 else 0.94)))
			if previous then G.line(ctx, group, previous, point, if layer == 1 then 0.08 else 0.035, if layer == 1 then color else WHITE, 0.24) end
			previous = point
		end
	end
end
function Combat.parry(ctx: any, position: Vector3, direction: Vector3)
	local group = ctx:Group("SanguineCrimsonCobaltParry", 0.65)
	if not group then return end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	local forward = if flat.Magnitude &gt; 0.01 then flat.Unit else Vector3.zAxis
	local right = forward:Cross(Vector3.yAxis)
	G.pulse(ctx, group, position, 1.1, WHITE, 0.18)
	G.lightning(ctx, group, position - right * 1.5 - Vector3.yAxis, position + right * 1.5 + Vector3.yAxis, BLUE, 0.24)
	G.lightning(ctx, group, position + right * 1.5 - Vector3.yAxis, position - right * 1.5 + Vector3.yAxis, RED, 0.24)
	G.ring(ctx, group, CFrame.new(position) * CFrame.Angles(math.pi / 2, 0, 0), 2.3, GOLD, 0.28)
	ctx:Emit(group, position, GOLD, 20)
end
function Combat.hit(ctx: any, position: Vector3, heavy: boolean, blocked: boolean?)
	local group = ctx:Group(if blocked then "SanguineMetalContact" else "SanguineHitSpark", 0.55)
	if not group then return end
	local color = if blocked then GOLD elseif heavy then GOLD else RED
	G.pulse(ctx, group, position, if heavy then 1.2 else 0.55, WHITE, 0.16)
	if heavy then G.forks(ctx, group, position, 1.8, color, BLUE) end
	ctx:Emit(group, position, color, if heavy then 18 else 8)
end
return table.freeze(Combat)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="709">
            <Properties>
              <string name="Name">SanguineController</string>
              <string name="Source">--!strict
-- Presentation-only bridge for VFX place 99240829139422. Existing controllers retain all ownership.
local RunService = game:GetService("RunService")
local Runtime = require(script.Parent.SanguineRuntime)
local Dispatch = require(script.Parent.SanguineDispatch)
local Combat = require(script.Parent.SanguineCombat)
local Visibility = require(script.Parent.HudVisibility)
local Weapons = require(game:GetService("ReplicatedStorage").AsurasPath.Simulation.WeaponSchema) :: any
local Controller = {}
Controller.__index = Controller
function Controller.new(state: any, ui: any): any
	assert(RunService:IsClient(), "Sanguine effects are client-only")
	local self = setmetatable({ State = state, Ui = ui, Context = Runtime.new(workspace),
		Last = {}, Disconnects = {}, Alive = true, Failed = false }, Controller)
	table.insert(self.Disconnects, state:OnEvent(function(event: any) self:Safe(Dispatch.event, event) end))
	table.insert(self.Disconnects, state:OnCue(function(cue: any) self:Safe(Dispatch.cue, cue) end))
	return self
end
function Controller.Blocked(self: any): boolean
	local own = self.State:Own()
	return not self.Alive or self.Failed or not own or not own.Root or not own.Snapshot
		or own.Snapshot.State == "KO" or not Visibility.of(self.Ui).Combat or Visibility.flags(self.Ui).Altar
		or workspace:GetAttribute("AsuraSanguineVFXEnabled") == false
end
function Controller.Near(self: any, point: any): boolean
	local own = self.State:Own()
	return typeof(point) == "Vector3" and own ~= nil and own.Root ~= nil and (point - own.Root.Position).Magnitude &lt;= 65
end
function Controller.Clear(self: any)
	self.Context:Clear(); table.clear(self.Last)
end
function Controller.Safe(self: any, fn: any, value: any)
	if not self.Alive or self.Failed then return end
	local ok, problem = pcall(fn, self, value)
	if not ok then
		self.Failed = true; self:Clear()
		warn("[Asura VFX] Sanguine layer disabled; existing effects remain: " .. tostring(problem))
	end
end
local function step(self: any, dt: number)
	self.Context:Update(dt)
	if self:Blocked() then self:Clear(); return end
	for id in self.Last do if not self.State.Entities[id] then self.Last[id] = nil end end
	for id, entity in self.State.Entities do
		local snap, root = entity.Snapshot, entity.Root
		if not snap or not root or not self:Near(root.Position) then self.Last[id] = nil; continue end
		local previous = self.Last[id]
		local active = snap.State == "Active"
		local newSwing = active and (not previous or previous.State ~= "Active" or previous.Move ~= snap.Move or snap.StateElapsed &lt; previous.Elapsed)
		if newSwing and snap.Move then
			local weapon = Weapons.Weapons[snap.Weapon] -- snapshots carry family keys (Jian), not asset ids (Jian_Sword).
			local move = if weapon then Weapons.findMove(weapon, snap.Move) else nil
			if move then Combat.slash(self.Context, root, move) end
		end
		self.Last[id] = { State = snap.State, Move = snap.Move, Elapsed = snap.StateElapsed }
	end
end
function Controller.Update(self: any, dt: number) self:Safe(step, dt) end
function Controller.Destroy(self: any)
	if not self.Alive then return end
	self.Alive = false
	for _, disconnect in self.Disconnects do disconnect() end
	table.clear(self.Disconnects); table.clear(self.Last); self.Context:Destroy()
end
return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="710">
            <Properties>
              <string name="Name">SanguineDispatch</string>
              <string name="Source">--!strict
-- Server events/cues enter here; no input listeners, remotes or alternate combat simulation.
local Combat = require(script.Parent.SanguineCombat)
local Ghost = require(script.Parent.SanguineGhost)
local Magic = require(script.Parent.SanguineMagic)
local Spells = require(game:GetService("ReplicatedStorage").AsurasPath.Simulation.SpellSchema) :: any
local Dispatch = {}
function Dispatch.event(self: any, event: any)
	local source, target = self.State:Get(event.Source), self.State:Get(event.Target)
	local own = self.State:Own()
	if event.Kind == "Rest" then
		if own and event.Source == own.Id then self:Clear() end
		return
	end
	if event.Kind == "KO" and own and event.Target == own.Id then self:Clear(); return end
	if self:Blocked() then return end
	local point = event.Point or (if target and target.Root then target.Root.Position else nil)
	if not self:Near(point) then return end
	local direction = if source and source.Root and target and target.Root then target.Root.Position - source.Root.Position else Vector3.zAxis
	local kind = event.Kind
	if kind == "DeflectSpark" then Combat.parry(self.Context, point, direction)
	elseif kind == "Hit" or kind == "CounterHit" or kind == "Armored" or kind == "Deathblow" then
		Combat.hit(self.Context, point, kind == "CounterHit" or kind == "Deathblow", kind == "Armored")
	elseif kind == "Block" or kind == "GuardBreak" or kind == "StanceBreak" then
		Combat.hit(self.Context, point, kind ~= "Block", true)
	elseif kind == "Dash" and source then Ghost.dodge(self.Context, source.Model) end
end
function Dispatch.cue(self: any, cue: any)
	local kind, d = cue.Kind, cue.Data
	if kind == "AltarTravel" or kind == "BossReset" or kind == "BossParticipantLeft" then
		local own = self.State:Own()
		if own and (cue.Source == own.Id or (type(d.participants) == "table" and table.find(d.participants, own.Id))) then self:Clear() end
		return
	end
	if self:Blocked() then return end
	local entity = self.State:Get(cue.Source)
	local point = if typeof(d.position) == "Vector3" then d.position
		elseif type(d.x) == "number" and type(d.z) == "number" then Vector3.new(d.x, tonumber(d.y) or 0.3, d.z)
		elseif entity and entity.Root then entity.Root.Position else nil
	if not self:Near(point) then return end
	if kind == "BossPhase" or kind == "BossEnrage" then
		Magic.phase(self.Context, point, if entity and entity.Model then entity.Model:GetExtentsSize().Y else 8)
	elseif kind == "BossDefeated" then Magic.death(self.Context, point)
	elseif kind == "Shockwave" then Magic.impact(self.Context, point, tonumber(d.radius) or 4)
	elseif kind == "SpellStartup" or kind == "SpellRelease" or kind == "SpellPulse" or kind == "ProjectileParry" then
		local spell = if type(d.spell) == "string" then Spells.get(d.spell) else nil
		Magic.spell(self.Context, point, if typeof(d.destination) == "Vector3" then d.destination else nil,
			if spell then spell.Discipline else nil, kind ~= "SpellStartup")
	end
	-- Demo GroundTelegraph/MeteorFall are not replayed: real BossEffects owns the danger footprint/timing.
end
return table.freeze(Dispatch)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="711">
            <Properties>
              <string name="Name">SanguineGeometry</string>
              <string name="Source">--!strict
-- Adapted from SanguineVFX_Overhaul's ring, pulse and branching energy shapes.
local Geometry = {}
local rng = Random.new()
function Geometry.line(ctx: any, group: Folder, a: Vector3, b: Vector3, width: number, color: Color3, duration: number)
	local delta = b - a
	if delta.Magnitude &lt; 0.03 then return end
	local p = ctx:Part(group, "SanguineEnergyLine", Vector3.new(width, width, delta.Magnitude), CFrame.lookAt((a + b) / 2, b), color)
	ctx:Tween(p, duration, { Transparency = 1, Size = Vector3.new(0.01, 0.01, delta.Magnitude) })
end
function Geometry.pulse(ctx: any, group: Folder, position: Vector3, radius: number, color: Color3, duration: number)
	local p = ctx:Part(group, "SanguinePulse", Vector3.one * 0.25, CFrame.new(position), color, 0.8)
	if p then p.Shape = Enum.PartType.Ball end
	ctx:Tween(p, duration, { Transparency = 1, Size = Vector3.one * math.clamp(radius * 2, 0.5, 12) })
end
function Geometry.ring(ctx: any, group: Folder, cf: CFrame, radius: number, color: Color3, duration: number)
	-- Segmented rings preserve the demo's broken-energy silhouette without large opaque floors.
	local segments = 10
	for i = 1, segments do
		local angle = i * math.pi * 2 / segments
		local localPoint = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local from = cf * CFrame.new(localPoint * 0.4) * CFrame.Angles(0, -angle, 0)
		local p = ctx:Part(group, "SanguineRing", Vector3.new(0.12, 0.05, 0.15), from, color, 0.55)
		ctx:Tween(p, duration, { CFrame = cf * CFrame.new(localPoint * radius) * CFrame.Angles(0, -angle, 0),
			Size = Vector3.new(0.02, 0.02, math.max(0.15, radius * 0.4)), Transparency = 1 })
	end
end
function Geometry.lightning(ctx: any, group: Folder, a: Vector3, b: Vector3, color: Color3, duration: number)
	local previous = a
	for i = 1, 4 do
		local point = a:Lerp(b, i / 4)
		if i &lt; 4 then point += Vector3.new(rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3)) end
		Geometry.line(ctx, group, previous, point, 0.06, color, duration)
		previous = point
	end
end
function Geometry.forks(ctx: any, group: Folder, position: Vector3, radius: number, first: Color3, second: Color3)
	for i = 1, 3 do
		local angle = i * math.pi * 2 / 3
		local target = position + Vector3.new(math.cos(angle), 0.3, math.sin(angle)) * radius
		Geometry.lightning(ctx, group, position, target, if i % 2 == 0 then first else second, 0.22)
	end
end
return table.freeze(Geometry)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="712">
            <Properties>
              <string name="Name">SanguineGhost</string>
              <string name="Source">--!strict
-- Read-only silhouette samples: never clone a character, Humanoid, script or motion controller.
local Ghost = {}
local NAMES = { Head = true, UpperTorso = true, LowerTorso = true, Torso = true,
	LeftUpperArm = true, RightUpperArm = true, LeftUpperLeg = true, RightUpperLeg = true }
function Ghost.dodge(ctx: any, model: Model)
	local group = ctx:Group("SanguineDodgeAfterimage", 0.4)
	if not group then return end
	for _, limb in model:GetChildren() do
		if limb:IsA("BasePart") and NAMES[limb.Name] and limb.Transparency &lt; 1 then
			local ghost = ctx:Part(group, "SanguineAfterimage", limb.Size * 0.97, limb.CFrame, Color3.fromRGB(103, 146, 185), 0.88)
			ctx:Tween(ghost, 0.3, { Transparency = 1 })
		end
	end
end
return table.freeze(Ghost)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="713">
            <Properties>
              <string name="Name">SanguineMagic</string>
              <string name="Source">--!strict
-- Selected demo spell/phase/death motifs. Existing authoritative telegraphs and actor death own timing.
local G = require(script.Parent.SanguineGeometry)
local Magic = {}
local RED, BLUE = Color3.fromRGB(218, 22, 42), Color3.fromRGB(60, 135, 245)
local GOLD = Color3.fromRGB(255, 195, 86)
local COLORS: { [string]: Color3 } = { CelestialThunder = BLUE, CrimsonFlame = RED,
	AbyssalVoid = Color3.fromRGB(129, 80, 175), SpiritTalismans = Color3.fromRGB(91, 216, 164) }
function Magic.spell(ctx: any, position: Vector3, destination: Vector3?, discipline: string?, release: boolean)
	local group = ctx:Group("SanguineSpellEnergy", 0.65)
	if not group then return end
	local color = COLORS[discipline or ""] or GOLD
	if release and destination and (destination - position).Magnitude &gt; 0.1 then
		-- A cosmetic path only; no simulated projectile, invented hit, target selection or damage.
		local goal = position + (destination - position).Unit * math.min((destination - position).Magnitude, 20)
		G.lightning(ctx, group, position, goal, color, 0.16)
	else
		G.ring(ctx, group, CFrame.new(position), if release then 2.4 else 1.3, color, 0.32)
	end
	if release then ctx:Emit(group, position, color, 12) end
end
function Magic.phase(ctx: any, position: Vector3, span: number)
	local group = ctx:Group("SanguinePhaseAscension", 1.1)
	if not group then return end
	local radius = math.clamp(span * 0.3, 2, 6)
	G.ring(ctx, group, CFrame.new(position), radius, RED, 0.65)
	G.forks(ctx, group, position + Vector3.yAxis, radius * 0.6, RED, BLUE)
	ctx:Emit(group, position, RED, 22)
end
function Magic.impact(ctx: any, position: Vector3, radius: number)
	local group = ctx:Group("SanguineGroundImpact", 0.8)
	if not group then return end
	-- Broken ground lines are visuals above the surface, never terrain edits or colliding debris.
	local r = math.clamp(radius, 1, 8)
	G.ring(ctx, group, CFrame.new(position), r, RED, 0.42)
	G.forks(ctx, group, position, r * 0.7, RED, GOLD)
	ctx:Emit(group, position, GOLD, 16)
end
function Magic.death(ctx: any, position: Vector3)
	local group = ctx:Group("SanguineGreatEnemyFelled", 1.2)
	if not group then return end
	G.ring(ctx, group, CFrame.new(position), 5, GOLD, 0.8)
	G.forks(ctx, group, position + Vector3.yAxis * 2, 3, GOLD, BLUE)
	ctx:Emit(group, position + Vector3.yAxis, GOLD, 24)
	-- Deliberately no boss Material/Color/Transparency/Size writes from the demo's BossDeath.
end
return table.freeze(Magic)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="714">
            <Properties>
              <string name="Name">SanguineRuntime</string>
              <string name="Source">--!strict
-- Bounded client-only rendering for the user's VFX place. No world, actor or camera ownership.
local Tween = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage").AsurasPath.Shared
local Assets = require(Shared.PresentationAssets) :: any
local Comfort = require(Shared.EffectsPreference) :: any
local Runtime = {}
Runtime.__index = Runtime
Runtime.Limits = table.freeze({ Groups = 8, Parts = 192, PartsPerGroup = 32, ParticlesPerSecond = 120 })
function Runtime.new(parent: Instance): any
	local folder = Instance.new("Folder")
	folder.Name, folder.Archivable, folder.Parent = "AsuraSanguineVFX", false, parent
	return setmetatable({ Folder = folder, Groups = {}, Parts = 0, Tokens = 60, Alive = true }, Runtime)
end
function Runtime.Drop(self: any, group: Folder)
	local record = self.Groups[group]
	if not record then return end
	self.Groups[group] = nil
	self.Parts -= record.Parts
	group:Destroy()
end
function Runtime.Group(self: any, name: string, lifetime: number): Folder?
	if not self.Alive then return nil end
	local count = 0
	for _ in self.Groups do count += 1 end
	if count &gt;= (if Comfort.reduced() then 4 else Runtime.Limits.Groups) then return nil end
	local group = Instance.new("Folder")
	group.Name, group.Archivable, group.Parent = name, false, self.Folder
	self.Groups[group] = { Parts = 0, Until = os.clock() + math.clamp(lifetime, 0.1, 2.5), Emitters = 0 }
	return group
end
function Runtime.Part(self: any, group: Folder, name: string, size: Vector3, cf: CFrame, color: Color3, alpha: number?): Part?
	local record = self.Groups[group]
	if not record or not group.Parent or self.Parts &gt;= Runtime.Limits.Parts then return nil end
	if record.Parts &gt;= (if Comfort.reduced() then 12 else Runtime.Limits.PartsPerGroup) then return nil end
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
	p.Anchored, p.Massless, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, true, false, false, false, false
	p.Archivable, p.Material = false, Enum.Material.Neon
	p.Transparency = 1 - Comfort.flash(1 - (alpha or 0.35))
	p.Parent = group
	record.Parts += 1; self.Parts += 1
	return p
end
function Runtime.Tween(_self: any, item: Instance?, duration: number, goal: any)
	if item and item.Parent then Tween:Create(item, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play() end
end
function Runtime.Emit(self: any, group: Folder, position: Vector3, color: Color3, count: number)
	local record = self.Groups[group]
	if not record or record.Emitters &gt;= 2 then return end
	local amount = math.min(math.floor(self.Tokens), math.floor(count * (if Comfort.reduced() then 0.25 else 0.6)), 24)
	if amount &lt; 1 or Assets.Textures.Ember == "" then return end
	local anchor = self:Part(group, "SanguineBurstAnchor", Vector3.one * 0.1, CFrame.new(position), color, 1)
	if not anchor then return end
	local e = Instance.new("ParticleEmitter")
	e.Texture, e.Enabled, e.Rate = Assets.Textures.Ember, false, 0
	e.Color, e.Lifetime, e.Speed = ColorSequence.new(color), NumberRange.new(0.1, 0.35), NumberRange.new(4, 16)
	e.SpreadAngle, e.Acceleration, e.Drag = Vector2.new(150, 150), Vector3.new(0, -10, 0), 2
	e.Size, e.Transparency = NumberSequence.new(0.22, 0), NumberSequence.new(0.25, 1)
	e.LightEmission, e.LightInfluence, e.Parent = Comfort.flash(0.6), 0, anchor
	record.Emitters += 1; self.Tokens -= amount
	e:Emit(amount)
end
function Runtime.Update(self: any, dt: number)
	self.Tokens = math.min(60, self.Tokens + math.clamp(dt, 0, 0.1) * Runtime.Limits.ParticlesPerSecond)
	local now = os.clock()
	for group, record in self.Groups do
		if not group.Parent or now &gt;= record.Until then self:Drop(group) end
	end
end
function Runtime.Clear(self: any)
	for group in self.Groups do self:Drop(group) end
end
function Runtime.Stats(self: any): any
	local groups = 0
	for _ in self.Groups do groups += 1 end
	return { Groups = groups, Parts = self.Parts, Tokens = self.Tokens }
end
function Runtime.Destroy(self: any)
	if not self.Alive then return end
	self.Alive = false; self:Clear(); self.Folder:Destroy()
end
return Runtime
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="715">
            <Properties>
              <string name="Name">SkillAudio</string>
              <string name="Source">--!strict
-- Sound score for the signature spells. Every cue has its own Assets.Audio slot for its synthesized
-- master (tools/assets/build_skill_audio.py); until that is uploaded, a pitched owned sound stands
-- in. The caster hears the score flat (SoundService); everyone else hears it from the caster's root.
-- Sounds belong to the cast trove, so an interrupted cast falls silent with its visuals.
local SoundService = game:GetService("SoundService")
local Kit = require(script.Parent.SkillKit)
local Audio = require(script.Parent.SpatialAudio)
local Sfx = {}

-- cue = { stand-in key, stand-in pitch, volume }
local CUES: { [string]: { any } } = {
	NovaVoid = { "Wind", 0.7, 0.8 }, NovaRing = { "Bell", 1.6, 0.7 }, NovaSwoop = { "Glide", 1.2, 0.8 },
	NovaPlanet = { "BossDrone", 1.3, 0.8 }, NovaCharge = { "BulletJump", 0.6, 0.9 }, NovaBlast = { "ParryBass", 0.55, 1.2 },
	NovaInk = { "Clash", 1.4, 0.7 }, NovaColumn = { "Wind", 1.5, 1 }, NovaWhite = { "Bell", 0.8, 0.6 },
	SunTension = { "BossDrone", 0.8, 0.8 }, SunBoom = { "ParryBass", 0.9, 1 }, SunEmber = { "Blunt", 1.3, 0.7 },
	SunThorn = { "Clash", 0.7, 0.8 }, SunCharge = { "Glide", 0.7, 0.9 }, SunBlast = { "ParryBass", 0.5, 1.3 },
	SunEyes = { "Slide", 1.4, 0.8 }, SunGauntlet = { "Wind", 1.8, 0.8 }, SunPulse = { "Blunt", 0.8, 0.9 },
}

-- Startup beats are fractions of the windup (a negative beat is seconds before the release, so a
-- riser always lands on the hit); release beats are seconds after the release cue.
local SCORES: { [string]: { [string]: { { any } } } } = {
	Nova = {
		Startup = { { "NovaVoid", 0 }, { "NovaRing", 0.26 }, { "NovaSwoop", 0.34 }, { "NovaPlanet", 0.45 }, { "NovaCharge", -0.75 } },
		Release = { { "NovaBlast", 0 }, { "NovaColumn", 0.22 }, { "NovaInk", 0.36 }, { "NovaInk", 0.47 } },
	},
	Sun = {
		Startup = { { "SunTension", 0 }, { "SunBoom", 0.33 }, { "SunEmber", 0.42 }, { "SunThorn", 0.8 }, { "SunCharge", -0.75 } },
		Release = { { "SunBlast", 0 }, { "SunEyes", 3.55 }, { "SunGauntlet", 5.45 } },
	},
}

function Sfx.play(cast: any, cue: string, volume: number?)
	local spec = CUES[cue]
	if not spec then return end
	local owned = Audio.id(cue) ~= ""
	local root = cast.Entity.Root
	local parent: Instance = if cast.Own or not (root and root.Parent) then SoundService else root
	local s = Audio.play(if owned then cue else spec[1], parent, spec[3] * (volume or 1), false, if owned then 1 else spec[2])
	if s then Kit.add(cast.Trove, s) end
end

function Sfx.score(cast: any, spell: string, phase: string)
	for _, beat in SCORES[spell][phase] do
		local at = beat[2]
		if phase == "Startup" then at = if at &lt; 0 then cast.Windup + at else cast.Windup * at end
		if at &gt;= 0 then Kit.after(cast.Trove, at, function() Sfx.play(cast, beat[1]) end) end
	end
end

return table.freeze(Sfx)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="716">
            <Properties>
              <string name="Name">SkillCinema</string>
              <string name="Source">--!strict
-- Cinematic camera director for the showcase sorceries. It runs in its own render step after the
-- CameraController has placed the camera, blends from that frame into an authored shot and back,
-- and layers trauma shake on top. The camlock never loses its state, so handing back is seamless.
-- Boss shots and dialogue framing always win; reduced motion skips scripted shots and calms shake.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Effects = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference) :: any
local Cinema = {}

export type Frame = { CFrame: CFrame, Fov: number }
export type Shot = { Start: number, Duration: number, Blend: number, Frame: (number) -&gt; Frame? }
export type Director = {
	Controller: any, Shot: Shot?, Last: Frame?, Weight: number, Rate: number,
	Trauma: number, Decay: number, Power: number, Seed: number, Name: string,
}

local MAX_ANGLE = math.rad(4.5) -- peak shake rotation per axis at trauma 1
local FREQUENCY = 17 -- noise samples per second

function Cinema.new(controller: any): Director
	local self: Director = {
		Controller = controller, Shot = nil, Last = nil, Weight = 0, Rate = 4,
		Trauma = 0, Decay = 1, Power = 2, Seed = math.random() * 100, Name = "AsuraSkillCinema",
	}
	RunService:BindToRenderStep(self.Name, Enum.RenderPriority.Camera.Value + 5, function(dt: number)
		Cinema.step(self, math.min(dt, 0.1))
	end)
	return self
end

-- frame(t) returns the shot's camera at t seconds in; returning nil holds the previous frame.
function Cinema.play(self: Director, frame: (number) -&gt; Frame?, duration: number, blend: number?)
	if Effects.reducedMotion() then return end
	self.Shot = { Start = os.clock(), Duration = duration, Blend = blend or 0.25, Frame = frame }
	self.Rate = 1 / math.max(0.02, blend or 0.25)
end

-- Hands the camera back over `blend` seconds (0 = hard cut back).
function Cinema.release(self: Director, blend: number?)
	self.Shot = nil
	self.Rate = 1 / math.max(0.02, blend or 0.35)
end

-- Trauma 0..1 decaying by `decay` per second; shake strength is trauma ^ power.
function Cinema.shake(self: Director, trauma: number, decay: number?, power: number?)
	self.Trauma = math.clamp(math.max(self.Trauma, Effects.motion(trauma)), 0, 1)
	self.Decay = decay or 1
	self.Power = power or 2
end

local function blocked(controller: any): boolean
	return controller ~= nil and (controller.BossShotState ~= nil or controller.DialogueFrame ~= nil)
end

function Cinema.step(self: Director, dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local shot = self.Shot
	if shot and os.clock() - shot.Start &gt;= shot.Duration then
		Cinema.release(self)
		shot = nil
	end
	local active = shot ~= nil and not blocked(self.Controller)
	self.Weight = math.clamp(self.Weight + (if active then dt else -dt) * self.Rate, 0, 1)
	if shot and active then
		self.Last = shot.Frame(os.clock() - shot.Start) or self.Last
	end
	local frame = self.Last
	if frame and self.Weight &gt; 0 then
		local w = self.Weight * self.Weight * (3 - 2 * self.Weight)
		camera.CFrame = camera.CFrame:Lerp(frame.CFrame, w)
		camera.FieldOfView += (frame.Fov - camera.FieldOfView) * w
	elseif self.Weight &lt;= 0 then
		self.Last = nil
	end
	if self.Trauma &gt; 0 then
		self.Trauma = math.max(0, self.Trauma - dt * self.Decay)
		local s = self.Trauma ^ self.Power
		local t = os.clock() * FREQUENCY
		local pitch = MAX_ANGLE * s * math.noise(self.Seed, t)
		local yaw = MAX_ANGLE * s * math.noise(self.Seed + 1, t)
		local roll = MAX_ANGLE * s * math.noise(self.Seed + 2, t)
		camera.CFrame *= CFrame.Angles(pitch, yaw, roll)
	end
end

-- Pulls an authored eye in front of any wall, roof or rock between it and the subject, so wide
-- shots never end up inside a pavilion. Characters are ignored; spell effects never take queries.
local clip = true
-- Off while a cinematic void hides the world (the hidden geometry still blocks rays).
function Cinema.clipping(on: boolean)
	clip = on
end

local function clear(from: Vector3, at: Vector3): Vector3
	if not clip then return from end
	local params = RaycastParams.new()
	local ignore = {}
	for _, player in game:GetService("Players"):GetPlayers() do
		if player.Character then table.insert(ignore, player.Character) end
	end
	params.FilterDescendantsInstances = ignore
	local hit = Workspace:Raycast(at, from - at, params)
	return if hit then hit.Position + (at - from).Unit * 1.5 else from
end

-- Helpers for authored frames. Dutch tilt rolls the camera around its own look axis.
function Cinema.look(from: Vector3, at: Vector3, fov: number, dutchDegrees: number?): Frame
	return { CFrame = CFrame.lookAt(clear(from, at), at) * CFrame.Angles(0, 0, math.rad(dutchDegrees or 0)), Fov = fov }
end

function Cinema.destroy(self: Director)
	RunService:UnbindFromRenderStep(self.Name)
	self.Shot, self.Last, self.Trauma = nil, nil, 0
end

return table.freeze(Cinema)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="717">
            <Properties>
              <string name="Name">SkillFx</string>
              <string name="Source">--!strict
-- Higher-order effects shared by the showcase sorceries: ground sigils, energy beams, crackling
-- lightning, glowing ground fissures, anime light rays, flash spheres, converging motes and one-shot
-- spark bursts. Built from SkillKit parts/emitters; everything lives in the caller's trove.
local RunService = game:GetService("RunService")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Comfort = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference)
local Kit = require(script.Parent.SkillKit)
local Fx = {}

local function flat(cf: CFrame): CFrame return cf * CFrame.Angles(0, 0, math.pi / 2) end

-- Ground magic circle: outer and inner rings, an eight-point star of crossed bars and rune ticks.
-- Grows in over `grow` seconds and spins; returns the model (PivotTo it to move the circle).
function Fx.sigil(trove: Kit.Trove, parent: Instance, at: CFrame, radius: number, outer: Color3, inner: Color3, grow: number): Model
	local model = Instance.new("Model")
	model.Name = "Sigil"
	for _, r in { { radius, 0.35, outer, 40 }, { radius * 0.92, 0.12, inner, 40 }, { radius * 0.55, 0.22, inner, 28 } } do
		local ring = Kit.ring(model, "SigilRing", r[1], r[2], r[3], r[4])
		ring.Parent = model
	end
	for n = 0, 3 do -- two squares rotated 45 degrees make the eight-point star
		local yaw = n * math.pi / 4
		Kit.part(model, "SigilBar", inner, Vector3.new(radius * 1.55, 0.12, 0.16), CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, radius * 0.55))
		Kit.part(model, "SigilBar", inner, Vector3.new(radius * 1.55, 0.12, 0.16), CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -radius * 0.55))
	end
	for n = 1, 16 do
		local yaw = n / 16 * math.pi * 2
		Kit.part(model, "SigilRune", outer, Vector3.new(0.18, 0.12, if n % 2 == 0 then 1.4 else 0.7), CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -radius * 0.78))
	end
	model.WorldPivot = CFrame.identity
	model.Parent = parent
	local scale, spin = 0.05, 0
	model:ScaleTo(scale)
	Kit.add(trove, model)
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		scale = math.min(1, scale + dt / math.max(grow, 0.05))
		spin += dt * 0.6
		model:ScaleTo(math.max(0.05, 1 - (1 - scale) ^ 3))
		model:PivotTo(at * CFrame.Angles(0, spin, 0))
	end))
	return model
end

function Fx.fade(trove: Kit.Trove, model: Instance, seconds: number)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then Kit.tween(trove, p, seconds, { Transparency = 1 }) end
	end
end

-- A glowing beam between two attachments (Ribbon texture scrolls along it).
function Fx.beam(trove: Kit.Trove, a0: Attachment, a1: Attachment, color: Color3, width: number, parent: Instance): Beam
	local beam = Kit.add(trove, Instance.new("Beam"))
	beam.Attachment0, beam.Attachment1, beam.Color = a0, a1, ColorSequence.new(color)
	beam.Width0, beam.Width1, beam.LightEmission, beam.LightInfluence = width, width * 0.4, 1, 0
	beam.Texture, beam.TextureSpeed, beam.TextureLength, beam.FaceCamera = Assets.Textures.Ribbon, 2.5, 4, true
	beam.Transparency = NumberSequence.new(0.05)
	beam.Parent = parent
	return beam
end

-- Crackling bolt from `from` to `to`: jagged neon segments re-cut 20 times a second for `seconds`.
function Fx.lightning(trove: Kit.Trove, parent: Instance, from: () -&gt; Vector3, to: () -&gt; Vector3, color: Color3, seconds: number)
	local count = 9
	local parts: { BasePart } = {}
	for n = 1, count do parts[n] = Kit.part(parent, "Bolt", color, Vector3.new(0.18, 0.18, 1), CFrame.identity) end
	local stop, clock = os.clock() + seconds, 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		if clock &lt; 0.05 and os.clock() &lt; stop then return end
		clock = 0
		local a, b = from(), to()
		local last = a
		for n, p in parts do
			local t = n / count
			local jitter = if n == count then Vector3.zero else Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (b - a).Magnitude * 0.18
			local point = a:Lerp(b, t) + jitter
			local len = (point - last).Magnitude
			p.Size = Vector3.new(0.16, 0.16, len)
			p.CFrame = CFrame.lookAt((last + point) / 2, point)
			p.Transparency = if os.clock() &gt; stop then 1 else math.random() * 0.3
			last = point
		end
	end))
end

-- Radial ground fissures with a glowing seam, racing out from `center` over `seconds`.
function Fx.cracks(trove: Kit.Trove, parent: Instance, center: Vector3, count: number, length: number, glow: Color3, seconds: number)
	for n = 1, count do
		local yaw = n / count * math.pi * 2 + math.random() * 0.5
		local reach = length * (0.6 + math.random() * 0.4)
		local base = CFrame.new(center) * CFrame.Angles(0, yaw, 0)
		local rock = Kit.part(parent, "Fissure", Color3.fromRGB(28, 26, 30), Vector3.new(1.4, 0.3, 0.1), base * CFrame.new(0, 0.05, 0))
		rock.Material = Enum.Material.Slate
		local seam = Kit.part(parent, "FissureGlow", glow, Vector3.new(0.35, 0.34, 0.1), base * CFrame.new(0, 0.07, 0))
		for _, p in { rock, seam } do
			Kit.tween(trove, p, seconds, { Size = Vector3.new(p.Size.X, p.Size.Y, reach), CFrame = base * CFrame.new(0, p.Position.Y - center.Y, -reach / 2) },
				Enum.EasingStyle.Quart)
		end
	end
end

-- Anime light rays: long tapered neon blades fanning out from `at` that flare and fade.
function Fx.rays(trove: Kit.Trove, parent: Instance, at: CFrame, color: Color3, count: number, length: number, seconds: number)
	for n = 1, count do
		local dir = CFrame.Angles(math.random() * math.pi * 2, math.random() * math.pi * 2, 0)
		local ray = Kit.part(parent, "LightRay", color, Vector3.new(0.6, 0.6, 0.5), at * dir)
		ray.Transparency = 0.15
		local reach = length * (0.5 + math.random() * 0.5)
		Kit.tween(trove, ray, seconds, { Size = Vector3.new(0.05, 0.05, reach), CFrame = at * dir * CFrame.new(0, 0, -reach / 2), Transparency = 1 },
			Enum.EasingStyle.Quint)
	end
end

-- A flash sphere that blooms to `size` and fades out.
function Fx.flash(trove: Kit.Trove, parent: Instance, at: Vector3, color: Color3, size: number, seconds: number)
	local ball = Kit.part(parent, "FlashSphere", color, Vector3.one, CFrame.new(at), Enum.PartType.Ball)
	-- F09: reduced flashes keep a share of the sphere and its light (it ignored the setting).
	ball.Transparency = 1 - Comfort.flash(0.95)
	Kit.light(ball, color, math.min(60, size * 2), Comfort.flash(8))
	Kit.tween(trove, ball, seconds, { Size = Vector3.one * size, Transparency = 1 }, Enum.EasingStyle.Quart)
end

-- Motes drawn inward to `holder` from a sphere of `radius` (the gathering of power).
function Fx.converge(holder: Instance, color: Color3, radius: number, rate: number): ParticleEmitter
	local e = Kit.emitter(holder, { Texture = Assets.Textures.Ember, Color = ColorSequence.new(Color3.new(1, 1, 1), color),
		Size = NumberSequence.new(0.35, 0.1), Rate = rate, Lifetime = NumberRange.new(0.9, 1.1), Speed = NumberRange.new(radius * 0.95, radius),
		Spread = 0, Light = 1 })
	e.Shape, e.ShapeStyle, e.ShapeInOut = Enum.ParticleEmitterShape.Sphere, Enum.ParticleEmitterShapeStyle.Surface, Enum.ParticleEmitterShapeInOut.Inward
	return e
end

function Fx.burst(holder: Instance, colors: ColorSequence, count: number, speed: number, texture: string?)
	local e = Kit.emitter(holder, { Texture = texture or Assets.Textures.Ember, Color = colors, Size = NumberSequence.new(0.45, 0.05), Rate = 0,
		Lifetime = NumberRange.new(0.5, 1.2), Speed = NumberRange.new(speed * 0.5, speed), Spread = 180, Drag = 2, Light = 1 })
	e:Emit(count)
end

Fx.flat = flat
return table.freeze(Fx)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="718">
            <Properties>
              <string name="Name">SkillKit</string>
              <string name="Source">--!strict
-- Procedural building blocks for the showcase sorceries (Celestial Supernova, Blazing Sun).
-- Every instance, tween, connection and thread goes into a Trove so a cast can be torn down in one
-- call (interrupt, KO, despawn, controller destroy). Nothing here collides, queries or touches.
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Kit = {}
export type Trove = { Items: { any }, Dead: boolean }

function Kit.trove(): Trove
	return { Items = {}, Dead = false }
end

function Kit.add&lt;T&gt;(trove: Trove, item: T): T
	if trove.Dead then
		Kit.dispose(item)
	else
		table.insert(trove.Items, item)
	end
	return item
end

function Kit.dispose(item: any)
	local kind = typeof(item)
	if kind == "Instance" then
		if item:IsA("Tween") then item:Cancel() end
		item:Destroy()
	elseif kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "thread" then
		if coroutine.status(item) ~= "dead" and item ~= coroutine.running() then pcall(task.cancel, item) end
	elseif kind == "function" then
		item()
	elseif kind == "table" and item.Cancel then
		item:Cancel()
	end
end

function Kit.clean(trove: Trove)
	trove.Dead = true
	local items = trove.Items
	trove.Items = {}
	for index = #items, 1, -1 do Kit.dispose(items[index]) end
end

-- Delayed step owned by the trove: cleaning the cast cancels everything still scheduled.
function Kit.after(trove: Trove, seconds: number, callback: () -&gt; ())
	Kit.add(trove, task.delay(math.max(0, seconds), function()
		if not trove.Dead then callback() end
	end))
end

function Kit.folder(trove: Trove, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = Workspace
	return Kit.add(trove, folder)
end

function Kit.part(parent: Instance, name: string, color: Color3, size: Vector3, cframe: CFrame, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name, p.Color, p.Size, p.CFrame = name, color, size, cframe
	p.Material, p.Shape = Enum.Material.Neon, shape or Enum.PartType.Block
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
	p.Parent = parent
	return p
end

function Kit.tween(trove: Trove, instance: Instance, seconds: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	Kit.add(trove, tween)
	tween:Play()
	return tween
end

-- A ring of segmented neon slabs (a procedural torus); returns a Model to spin with PivotTo.
function Kit.ring(parent: Instance, name: string, radius: number, thickness: number, color: Color3, segments: number): Model
	local model = Instance.new("Model")
	model.Name = name
	local chord = 2 * radius * math.sin(math.pi / segments) * 1.08
	for n = 1, segments do
		local angle = (n / segments) * math.pi * 2
		local cf = CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius)
		Kit.part(model, "Segment", color, Vector3.new(chord, thickness, thickness), cf)
	end
	model.WorldPivot = CFrame.identity
	model.Parent = parent
	return model
end

-- Flat ground shockwave: a thin disc that grows and fades (Quad ease-out).
function Kit.shockwave(trove: Trove, parent: Instance, at: CFrame, color: Color3, radius: number, seconds: number, transparency: number?)
	local disc = Kit.part(parent, "Shockwave", color, Vector3.new(0.12, 1, 1), at * CFrame.Angles(0, 0, math.pi / 2), Enum.PartType.Cylinder)
	disc.Transparency = transparency or 0.2
	Kit.tween(trove, disc, seconds, { Size = Vector3.new(0.05, radius * 2, radius * 2), Transparency = 1 })
	return disc
end

export type EmitterSpec = {
	Texture: string?, Color: ColorSequence, Size: NumberSequence, Rate: number, Lifetime: NumberRange,
	Speed: NumberRange, Spread: number?, Accel: Vector3?, Drag: number?, Light: number?, Spin: NumberRange?, Transparency: NumberSequence?,
}

function Kit.emitter(parent: Instance, spec: EmitterSpec): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = spec.Texture or Assets.Textures.Flame
	e.Color, e.Size, e.Rate, e.Lifetime, e.Speed = spec.Color, spec.Size, spec.Rate, spec.Lifetime, spec.Speed
	e.SpreadAngle = Vector2.new(spec.Spread or 20, spec.Spread or 20)
	e.Acceleration = spec.Accel or Vector3.zero
	e.Drag, e.LightEmission = spec.Drag or 0, spec.Light or 1
	e.RotSpeed = spec.Spin or NumberRange.new(-90, 90)
	e.Rotation = NumberRange.new(0, 360)
	e.Transparency = spec.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = parent
	return e
end

function Kit.light(parent: Instance, color: Color3, range: number, brightness: number): PointLight
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Shadows = color, range, brightness, false
	light.Parent = parent
	return light
end

-- R15 hands fall back to R6 arms; the returned parts are the character's own (never edited).
function Kit.hands(model: Model): { BasePart }
	local found: { BasePart } = {}
	for _, pair in { { "LeftHand", "Left Arm" }, { "RightHand", "Right Arm" } } do
		local p = model:FindFirstChild(pair[1]) or model:FindFirstChild(pair[2])
		if p and p:IsA("BasePart") then table.insert(found, p) end
	end
	return found
end

function Kit.head(model: Model): BasePart?
	local head = model:FindFirstChild("Head")
	return if head and head:IsA("BasePart") then head else nil
end

-- Attachment owned by the trove, so emitters on a character limb leave with the cast.
function Kit.attach(trove: Trove, parent: BasePart, offset: Vector3, name: string): Attachment
	local a = Instance.new("Attachment")
	a.Name, a.Position, a.Parent = name, offset, parent
	return Kit.add(trove, a)
end

return table.freeze(Kit)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="719">
            <Properties>
              <string name="Name">SkillShowcase</string>
              <string name="Source">--!strict
-- Routes server spell cues to the showcase sorcery timelines. The server owns cooldowns, Qi, timing
-- and every hit; this module only renders. One live cast per source; an interrupt, KO or a newer
-- cast tears the old one down through its trove. Returns true when it handled the cue so the
-- generic SpellVfx ring/seal does not stack on top.
local Kit = require(script.Parent.SkillKit)
local Cinema = require(script.Parent.SkillCinema)
local Supernova = require(script.Parent.SupernovaShow)
local BlazingSun = require(script.Parent.BlazingSunShow)
local Showcase = {}

export type Cast = { Trove: Kit.Trove, Entity: any, Own: boolean, Cinema: Cinema.Director, Windup: number, Pulses: number, Bag: { [string]: any } }
export type Showcase = { State: any, Cinema: Cinema.Director, Casts: { [number]: Cast } }

local SHOWS: { [string]: any } = { CelestialSupernova = Supernova, BlazingSunAwakening = BlazingSun }
local RANGE = 220 -- the pillar reads from far away; past this nothing is built

function Showcase.handles(id: any): boolean
	return type(id) == "string" and SHOWS[id] ~= nil
end

function Showcase.new(state: any, camera: any): Showcase
	return { State = state, Cinema = Cinema.new(camera), Casts = {} }
end

local function stop(self: Showcase, source: number)
	local cast = self.Casts[source]
	if not cast then return end
	self.Casts[source] = nil
	if cast.Own then Cinema.release(self.Cinema, 0.3) end
	Kit.clean(cast.Trove)
end

local function begin(self: Showcase, source: number, entity: any, windup: number): Cast
	stop(self, source)
	local own = self.State:Own()
	local cast: Cast = { Trove = Kit.trove(), Entity = entity, Own = own ~= nil and own.Id == entity.Id, Cinema = self.Cinema,
		Windup = math.clamp(windup, 0.3, 8), Pulses = 0, Bag = {} }
	self.Casts[source] = cast
	-- Forget the cast once its own trove is cleaned (end of timeline), unless a newer one replaced it.
	Kit.add(cast.Trove, function() if self.Casts[source] == cast then self.Casts[source] = nil end end)
	if entity.Humanoid then
		Kit.add(cast.Trove, entity.Humanoid.Died:Connect(function() stop(self, source) end))
	end
	return cast
end

function Showcase.cue(self: Showcase, cue: any): boolean
	local d = cue.Data
	if type(d) ~= "table" then return false end
	if cue.Kind == "SpellInterrupted" then
		if not Showcase.handles(d.spell) then return false end
		stop(self, cue.Source)
		return true
	end
	if not Showcase.handles(d.spell) then return false end
	local show = SHOWS[d.spell]
	local entity = self.State:Get(cue.Source)
	local own = self.State:Own()
	local point = if typeof(d.position) == "Vector3" then d.position else nil
	if not entity or not entity.Model or not point then return true end
	if own and own.Root and (own.Root.Position - point).Magnitude &gt; RANGE then return true end
	if cue.Kind == "SpellStartup" then
		local windup = (tonumber(d.release) or cue.Time + 1) - cue.Time
		show.startup(begin(self, cue.Source, entity, windup))
	elseif cue.Kind == "SpellRelease" then
		local cast = self.Casts[cue.Source] or begin(self, cue.Source, entity, 0.3)
		local ground = if typeof(d.destination) == "Vector3" and d.spell == "CelestialSupernova" then d.destination else point
		show.release(cast, ground)
	elseif cue.Kind == "SpellPulse" then
		local cast = self.Casts[cue.Source]
		if cast then
			cast.Pulses += 1
			if show.pulse then show.pulse(cast, point) end
			if show.whiteout and cast.Pulses &gt;= (show.FinalPulse or 2) then show.whiteout(cast) end
		end
	elseif cue.Kind == "SpellHit" then
		return false -- the shared hit ring still marks who was struck
	end
	return true
end

function Showcase.destroy(self: Showcase)
	for source in self.Casts do stop(self, source) end
	Cinema.destroy(self.Cinema)
end

return table.freeze(Showcase)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="720">
            <Properties>
              <string name="Name">SolarForms</string>
              <string name="Source">--!strict
-- Procedural fire for the Blazing Sun build-up and blast: a miniature sun (plasma core, ForceField
-- corona, looping solar-flare ribbons), twin flame spirals winding up the body, and rings of fire
-- pillars that erupt from the ground. Colours are FlameForms' crimson/orange/yellow palette.
local RunService = game:GetService("RunService")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Kit = require(script.Parent.SkillKit)
local Flame = require(script.Parent.FlameForms)
local Fx = require(script.Parent.SkillFx)
local Solar = {}

export type Sun = { Core: BasePart, Corona: BasePart, Flares: { Beam }, Hub: Attachment, Glow: { BasePart } }

local function seq(a: Color3, b: Color3): ColorSequence return ColorSequence.new(a, b) end

-- A sun that grows to `size` over `grow` seconds at `at`; flares loop out of it as curved ribbons.
function Solar.sun(trove: Kit.Trove, folder: Instance, at: Vector3, size: number, grow: number): Sun
	local core = Kit.part(folder, "SunCore", Flame.Core, Vector3.one * 0.2, CFrame.new(at), Enum.PartType.Ball)
	local corona = Kit.part(folder, "SunCorona", Flame.Body, Vector3.one * 0.3, CFrame.new(at), Enum.PartType.Ball)
	corona.Material = Enum.Material.ForceField
	Kit.light(core, Flame.Body, 40, 6)
	Kit.tween(trove, core, grow, { Size = Vector3.one * size }, Enum.EasingStyle.Back)
	Kit.tween(trove, corona, grow, { Size = Vector3.one * size * 1.7 }, Enum.EasingStyle.Back)
	-- Layered bloom shells (white-hot heart, yellow and orange haze) so it reads as a star, not a disc.
	local glow: { BasePart } = {}
	for n, layer in { { Flame.Plasma, 0.55, 0 }, { Flame.Core, 1.4, 0.55 }, { Flame.Body, 2.4, 0.82 } } do
		local shell = Kit.part(folder, "SunGlow", layer[1], Vector3.one * 0.2, CFrame.new(at), Enum.PartType.Ball)
		shell.Transparency = layer[3]
		Kit.tween(trove, shell, grow, { Size = Vector3.one * size * layer[2] }, Enum.EasingStyle.Back)
		glow[n] = shell
	end
	local hub = Kit.attach(trove, core, Vector3.zero, "SunHub")
	Kit.emitter(hub, { Texture = Assets.Textures.Flame, Color = seq(Flame.Plasma, Flame.Body), Size = NumberSequence.new(size * 0.6, size * 0.15),
		Rate = 60, Lifetime = NumberRange.new(0.3, 0.6), Speed = NumberRange.new(2, 5), Spread = 180, Light = 1 })
	local flares: { Beam } = {}
	for n = 1, 5 do
		local a = Kit.attach(trove, core, Vector3.zero, "FlareA")
		local b = Kit.attach(trove, core, Vector3.zero, "FlareB")
		local beam = Fx.beam(trove, a, b, if n % 2 == 0 then Flame.Core else Flame.Body, 1.6, core)
		beam.FaceCamera, beam.Segments, beam.Texture = true, 16, ""
		flares[n] = beam
	end
	local clock = 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		local r = core.Size.X * 0.5
		for n, beam in flares do
			local phase = n * 1.3 + clock * (0.8 + n * 0.15)
			local dirA = Vector3.new(math.cos(phase), math.sin(phase * 0.7), math.sin(phase))
			local dirB = Vector3.new(math.cos(phase + 1.1), math.sin(phase * 0.7 + 0.8), math.sin(phase + 1.1))
			beam.Attachment0.Position, beam.Attachment1.Position = dirA.Unit * r, dirB.Unit * r
			local loop = r * (1.4 + 0.6 * math.sin(clock * 5 + n))
			beam.CurveSize0, beam.CurveSize1 = loop, -loop
		end
		corona.CFrame = core.CFrame * CFrame.Angles(clock * 0.7, clock, 0)
		for n, shell in glow do
			shell.Position = core.Position
			if n == 3 then shell.Transparency = 0.78 + 0.08 * math.sin(clock * 9) end
		end
	end))
	return { Core = core, Corona = corona, Flares = flares, Hub = hub, Glow = glow }
end

-- Drives the sun down into the caster's chest, crushing it to a point.
function Solar.compress(trove: Kit.Trove, sun: Sun, target: () -&gt; Vector3, seconds: number)
	local from = sun.Core.Position
	local clock = 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		clock = math.min(seconds, clock + dt)
		local k = (clock / seconds) ^ 2
		local at = from:Lerp(target(), k)
		sun.Core.Position = at
		sun.Core.Size = Vector3.one * math.max(0.3, (1 - k) * sun.Core.Size.X + k * 0.3)
		sun.Corona.Size = Vector3.one * math.max(0.4, (1 - k) * sun.Corona.Size.X)
		for _, shell in sun.Glow do shell.Size = Vector3.one * math.max(0.3, (1 - k * 0.2) * shell.Size.X) end
	end))
end

-- Two flame streams spiralling up the caster's body for `seconds`.
function Solar.swirl(trove: Kit.Trove, root: BasePart, seconds: number)
	local holders: { Attachment } = {}
	for n = 1, 2 do
		local a = Kit.attach(trove, root, Vector3.zero, "SunSwirl")
		Kit.emitter(a, { Texture = Assets.Textures.Flame, Color = seq(Flame.Core, Flame.Body), Size = NumberSequence.new(1.1, 0.2),
			Rate = 70, Lifetime = NumberRange.new(0.25, 0.45), Speed = NumberRange.new(0.5, 1.5), Spread = 30, Light = 1 })
		holders[n] = a
	end
	local clock = 0
	Kit.add(trove, RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		for n, a in holders do
			local angle = clock * 7 + n * math.pi
			local height = ((clock * 3.2 + n * 1.5) % 5) - 2.6
			a.Position = Vector3.new(math.cos(angle) * 2.4, height, math.sin(angle) * 2.4)
		end
	end))
	Kit.after(trove, seconds, function() for _, a in holders do a:Destroy() end end)
end

-- `count` fire pillars erupting in a ring of `radius` around `floor` (height ~`height`).
function Solar.pillars(trove: Kit.Trove, folder: Instance, floor: CFrame, count: number, radius: number, height: number, offset: number)
	for n = 1, count do
		local yaw = n / count * math.pi * 2 + offset
		local base = floor * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -radius)
		local up = base * CFrame.Angles(0, 0, math.pi / 2) -- cylinders run along X
		local pillar = Kit.part(folder, "FirePillar", Flame.Body, Vector3.new(0.2, 3, 3), up, Enum.PartType.Cylinder)
		pillar.Transparency = 0.2
		local core = Kit.part(folder, "FirePillarCore", Flame.Core, Vector3.new(0.2, 1.3, 1.3), up, Enum.PartType.Cylinder)
		local h = height * (0.75 + math.random() * 0.5)
		for _, p in { pillar, core } do
			Kit.tween(trove, p, 0.18, { Size = Vector3.new(h, p.Size.Y, p.Size.Z), CFrame = base * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2) }, Enum.EasingStyle.Quint)
			Kit.after(trove, 0.25, function() Kit.tween(trove, p, 0.55, { Size = Vector3.new(h * 1.2, 0.1, 0.1), Transparency = 1 }, Enum.EasingStyle.Quad) end)
		end
		local burst = Kit.emitter(pillar, { Texture = Assets.Textures.Flame, Color = seq(Flame.Core, Flame.Coal), Size = NumberSequence.new(2.2, 0.4),
			Rate = 0, Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(8, 16), Spread = 25, Accel = Vector3.new(0, 18, 0) })
		burst.EmissionDirection = Enum.NormalId.Right -- the cylinder's +X axis points up
		burst:Emit(12)
	end
end

return table.freeze(Solar)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="721">
            <Properties>
              <string name="Name">SoundscapeController</string>
              <string name="Source">--!strict
local SoundService = game:GetService("SoundService")
local Players = game:GetService("Players")
local Tween = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local World = require(Shared.Shared.WorldDefinitions)
local Profiles = require(Shared.Shared.EnvironmentProfiles)
local Audio = require(script.Parent.SpatialAudio)
local Controller = {}
Controller.__index = Controller
local function stop(s: Sound?)
	if not s or not s.Parent then return end
	local tween = Tween:Create(s, TweenInfo.new(0.7), { Volume = 0 })
	tween.Completed:Once(function() s:Destroy() end); tween:Play()
end
function Controller.new(state: any, movement: any): any
	return setmetatable({ State = state, Movement = movement, LastMovement = "", Loop = nil,
		Region = "", Ambient = nil, Water = nil, Tick = 0, BellAt = 9, Time = 0 }, Controller)
end
function Controller.Update(self: any, dt: number)
	self.Time += dt; self.Tick += dt
	if self.Tick &lt; 0.15 then return end
	self.Tick = 0
	local own = self.State:Own()
	if not own or not own.Root then
		stop(self.Loop); self.Loop = nil; self.LastMovement = ""; return
	end
	local p = own.Root.Position
	local region = World.regionAt(p.X, p.Y, p.Z) or tostring(Players.LocalPlayer:GetAttribute("AsuraRegion") or "Sanctuary")
	Audio.zone(Profiles.acoustics(region, p))
	if region ~= self.Region then
		self.Region = region; stop(self.Ambient); stop(self.Water)
		self.Ambient = Audio.play("Wind", SoundService, if region == "Sanctuary" then 0.12 else 0.22, true)
		self.Water = nil
	end
	-- Water and bells are positioned in world space, so turning the camera changes their direction.
	if region == "DesecratedMonastery" and self.Time &gt;= self.BellAt then
		self.BellAt = self.Time + 18 + math.random() * 14
		Audio.at("Bell", Vector3.new(-62, 18, -820), 0.45)
	end
	local nearWater = region == "DesecratedMonastery" and p.Z &lt; -940 and p.Z &gt; -1080
	if nearWater and not self.Water then
		-- SpatialAudio owns the source part, so stopping the loop cannot re-enter its destruction.
		self.Water = Audio.at("Water", Vector3.new(55, 1, -1015), 0.3, true)
	elseif not nearWater and self.Water then stop(self.Water); self.Water = nil end
	local active = own.Snapshot == nil or own.Snapshot.State ~= "KO"
	local move = if active then self.Movement.State else ""
	if move ~= self.LastMovement then
		stop(self.Loop); self.Loop = nil; self.LastMovement = move
		if move == "BulletJumping" then Audio.play("BulletJump", own.Root, 0.65)
		elseif move == "Gliding" or move == "Sliding" then
			self.Loop = Audio.play(if move == "Gliding" then "Glide" else "Slide", own.Root, 0.3, true)
		end
	end
end
function Controller.Destroy(self: any)
	if self.Loop then self.Loop:Destroy() end
	if self.Ambient then self.Ambient:Destroy() end
	if self.Water then self.Water:Destroy() end
	Audio.destroy()
end
return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="722">
            <Properties>
              <string name="Name">SpatialAudio</string>
              <string name="Source">--!strict
-- Bounded local voice pool. 3D sources always live on a part/attachment, never a Folder.
-- Every voice is released exactly once, whichever comes first: Ended, the lifetime bound (assets
-- that fail permission checks or never load), voice eviction, destruction of the sound or any
-- ancestor, or shutdown. A release never destroys from inside a Destroying callback: that used
-- to re-enter the source part's own destruction and throw locked-Parent errors.
local SoundService = game:GetService("SoundService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Assets = require(Shared.Shared.PresentationAssets)
local Audio = {}
local LIFETIME = 12
local voices: {Sound} = {}
local sources: {[Sound]: BasePart} = {} -- positional voice -&gt; the source part it owns
local released: {[Sound]: boolean} = setmetatable({}, {__mode = "k"}) :: any
local zone = "Open"
local rng = Random.new()
-- Keep existing combat cues usable while the new owned masters are awaiting upload.
local FALLBACK: {[string]: string} = {
	Clash="rbxasset://sounds/unsheath.wav", Flesh="rbxasset://sounds/swordslash.wav",
	Blunt="rbxasset://sounds/action_jump_land.mp3", Stone="rbxasset://sounds/action_jump_land.mp3",
}
-- Idempotent. `destroying` = called while `s` or an ancestor is already being destroyed.
local function release(s: Sound, destroying: boolean?)
	if released[s] then return end
	released[s] = true
	local index = table.find(voices, s)
	if index then table.remove(voices, index) end
	local source = sources[s]
	sources[s] = nil
	if destroying then
		-- Finish the source part after the current destruction instead of re-entering it.
		if source then task.defer(function() if source.Parent then source:Destroy() end end) end
	else
		(source or s):Destroy() -- its Destroying callback finds `s` already released
	end
end
function Audio.zone(value: string) zone = value end
function Audio.id(key: string): string
	local folder = SoundService:FindFirstChild("AsuraAudio")
	local template = folder and folder:FindFirstChild(key)
	if template and template:IsA("Sound") and template.SoundId ~= "" then return template.SoundId end
	local owned = (Assets.Audio :: {[string]: string})[key]
	return if owned and owned ~= "" then owned else FALLBACK[key] or ""
end
function Audio.play(key: string, parent: Instance, volume: number?, looped: boolean?, pitch: number?): Sound?
	local id = Audio.id(key)
	if id == "" then return nil end
	for i = #voices, 1, -1 do if voices[i].Parent == nil then release(voices[i]) end end
	if #voices &gt;= Assets.Limits.Voices then
		local victim = nil
		for _, voice in voices do if not voice.Looped then victim = voice; break end end
		if not victim then return nil end
		release(victim)
	end
	local s = Instance.new("Sound")
	s.Name, s.SoundId, s.Volume = "Asura_" .. key, id, math.clamp(volume or 0.6, 0, 1.4)
	s.RollOffMode, s.RollOffMinDistance, s.RollOffMaxDistance = Enum.RollOffMode.InverseTapered, 7, 120
	s.PlaybackSpeed = pitch or (if looped then 1 else rng:NextNumber(0.95, 1.05))
	s.Looped = looped == true
	if zone ~= "Open" and parent ~= SoundService then
		local reverb = Instance.new("ReverbSoundEffect")
		reverb.DecayTime = if zone == "Ravine" then 2.4 else 1.5
		reverb.Density, reverb.Diffusion, reverb.DryLevel, reverb.WetLevel = 0.6, 0.7, 0, -17
		reverb.Parent = s
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain, eq.MidGain, eq.HighGain, eq.Parent = 1.5, -1, -3, s
	end
	s.Parent = parent; table.insert(voices, s)
	s.Destroying:Once(function() release(s, true) end)
	if not s.Looped then
		s.Ended:Once(function() release(s) end)
		task.delay(LIFETIME, release, s)
	end
	s:Play()
	return s
end
-- World-space cue on its own invisible source part; the part lives exactly as long as the voice.
function Audio.at(key: string, position: Vector3, volume: number?, looped: boolean?): Sound?
	if Audio.id(key) == "" then return nil end
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position, p.Transparency = "AsuraAudioSource", Vector3.one * 0.1, position, 1
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Parent = workspace
	local s = Audio.play(key, p, volume, looped)
	if s then sources[s] = p else p:Destroy() end
	return s
end
-- Live counts for diagnostics and regression checks (sources never outnumber voices).
function Audio.stats(): {Voices: number, Sources: number}
	local count = 0
	for _ in sources do count += 1 end
	return { Voices = #voices, Sources = count }
end
function Audio.destroy()
	for i = #voices, 1, -1 do release(voices[i]) end
	table.clear(voices); zone = "Open"
end
return Audio
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="723">
            <Properties>
              <string name="Name">SpellController</string>
              <string name="Source">--!strict
local ContextActionService=game:GetService("ContextActionService")
local UserInputService=game:GetService("UserInputService")
local Workspace=game:GetService("Workspace")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local simFolder=Shared:WaitForChild("Simulation")
local Spells=require(simFolder:WaitForChild("SpellSchema") :: ModuleScript)
local InputMap=require(Shared:WaitForChild("Shared"):WaitForChild("InputMap") :: ModuleScript)
local Hud=require(script.Parent.SpellHud)
local Visibility=require(script.Parent.HudVisibility)
local Panel=require(script.Parent.ArsenalPanel)
local Vfx=require(script.Parent.SpellVfx)
local Showcase=require(script.Parent.SkillShowcase)
local Controller={}
Controller.__index=Controller
export type SpellController=typeof(setmetatable({} :: {State: any,Ui: any,Remote: RemoteEvent,Slots: {string},Cooldowns: {[string]: number},
 View: Hud.View,Panel: Panel.View,Showcase: Showcase.Showcase,Connections: {RBXScriptConnection},Unsubscribe: ()-&gt;()},Controller))
-- Spell and Arsenal inputs come from the shared InputMap (keyboard and gamepad alike).
local function keys(command: string): {Enum.KeyCode}
 local binding=InputMap.get(command);local list: {Enum.KeyCode}={}
 if binding then for _,field in {binding.Keys,binding.Pad} do for _,name in field do table.insert(list,(Enum.KeyCode :: any)[name]) end end end
 return list
end
function Controller.Cast(self: SpellController,slot: number)
 if self.Ui.Input.MenuOpen or UserInputService:GetFocusedTextBox() or self.Panel.Root.Visible or self.Ui.Altar.Visible or self.Ui.PrologueActive then return end
 local snapshot=self.State:OwnSnapshot();local id=self.Slots[slot];local s=if id then Spells.get(id) else nil
 if not snapshot or snapshot.State~="Idle" or not s then return end
 if (self.Cooldowns[id] or 0)&gt;Workspace:GetServerTimeNow() then return end
 if snapshot.Qi&lt;s.QiCost then self.Ui:ShowToast("Not enough Qi");return end
 self.Remote:FireServer({action="Cast",slot=slot})
end
function Controller.new(state: any,ui: any,net: Instance,camera: any?): SpellController
 local remote=net:WaitForChild("ArsenalIntent") :: RemoteEvent
 local self: any=setmetatable({State=state,Ui=ui,Remote=remote,Slots={"ThunderclapPalm","GaleStep"},Cooldowns={},Connections={}},Controller)
 local function toggle()
  if ui.Input.MenuOpen and not Panel.isOpen(self.Panel) then return end
  if Panel.isOpen(self.Panel) then Panel.close(self.Panel) else Panel.open(self.Panel);remote:FireServer({action="State"}) end
 end
 self.Panel=Panel.new(ui.Gui,function(packet: any) remote:FireServer(packet) end,function(command: string) return ui.Input:Label(command) end)
 self.View=Hud.new(ui.Gui,function(slot: number) self:Cast(slot) end,toggle)
 table.insert(self.Connections,self.Panel.Root:GetPropertyChangedSignal("Visible"):Connect(function()
  if self.Panel.Root.Visible then ui:CloseAltar() end
  ui.Input:SetMenu(self.Panel.Root.Visible, "Arsenal")
 end))
 table.insert(self.Connections,remote.OnClientEvent:Connect(function(packet: any)
  if type(packet)~="table" then return end
  if packet.action=="State" then
   self.Slots=packet.inventory.spellSlots;self.Cooldowns=packet.cooldowns or {};Panel.update(self.Panel,packet.inventory)
   if packet.open and not Panel.isOpen(self.Panel) then Panel.open(self.Panel) end
  elseif packet.action=="Cooldown" then self.Cooldowns[packet.id]=packet.untilTime
  elseif packet.action=="Result" and not packet.ok then ui:ShowToast(packet.message) end
 end))
 -- Showcase sorceries (Supernova, Blazing Sun) take their own cues; everything else keeps SpellVfx.
 self.Showcase=Showcase.new(state,camera)
 self.Unsubscribe=state:OnCue(function(cue: any) if not Showcase.cue(self.Showcase,cue) then Vfx.cue(cue,state) end end)
 local function action(name: string,inputState: Enum.UserInputState,_input: InputObject): Enum.ContextActionResult
  if UserInputService:GetFocusedTextBox() or (self.Panel.Root.Visible and name~="QiArsenal") then return Enum.ContextActionResult.Pass end
  if inputState==Enum.UserInputState.Begin then
   if name=="QiArsenal" then toggle() else self:Cast(if name=="QiSpellOne" then 1 else 2) end
  end
  return Enum.ContextActionResult.Sink
 end
 ContextActionService:BindActionAtPriority("QiSpellOne",action,false,Enum.ContextActionPriority.High.Value+1,table.unpack(keys("SpellOne")))
 ContextActionService:BindActionAtPriority("QiSpellTwo",action,false,Enum.ContextActionPriority.High.Value+1,table.unpack(keys("SpellTwo")))
 ContextActionService:BindAction("QiArsenal",action,false,table.unpack(keys("Arsenal")))
 table.insert(self.Connections,Workspace:GetAttributeChangedSignal("AsuraReady"):Connect(function()
  if Workspace:GetAttribute("AsuraReady") then remote:FireServer({action="State"}) end
 end))
 if Workspace:GetAttribute("AsuraReady") then remote:FireServer({action="State"}) end
 return self
end
function Controller.Step(self: SpellController)
 local snapshot=self.State:OwnSnapshot()
 local input=self.Ui.Input
 Hud.update(self.View,self.Slots,self.Cooldowns,Workspace:GetServerTimeNow(),if snapshot then snapshot.Qi else 0,input.Device=="Touch",
  {input:Label("SpellOne"),input:Label("SpellTwo"),input:Label("Arsenal")})
 self.View.Root.Visible=Visibility.of(self.Ui).Combat
end
function Controller.Destroy(self: SpellController)
 for _,c in self.Connections do c:Disconnect() end;self.Unsubscribe()
 for _,name in {"QiSpellOne","QiSpellTwo","QiArsenal"} do ContextActionService:UnbindAction(name) end
 self.View.Root:Destroy();self.Panel.Root:Destroy();Vfx.destroy();Showcase.destroy(self.Showcase)
end
return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="724">
            <Properties>
              <string name="Name">SpellHud</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/SpellHud
-- Bottom-right sakura skill cluster: two blossom-framed spell buttons (slot I = 1 / D-Pad Up,
-- slot II = E / D-Pad Down) and a smaller Arsenal button, each with a key badge. A ring of petal
-- ticks drains with the cooldown; the disc dims while the spell is unaffordable. Each button shows
-- a drawn picture of its spell school (MoveIcons). On touch the cluster lifts above the combat buttons.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Spells = require(Shared:WaitForChild("Simulation"):WaitForChild("SpellSchema") :: ModuleScript)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Layout = require(script.Parent:WaitForChild("HudLayout") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)
local Icons = require(script.Parent:WaitForChild("MoveIcons") :: ModuleScript)

local Hud = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local CLUSTER = Vector2.new(260, 190)
-- Badge captions are filled each frame from InputMap via Hud.update (hidden on touch).
local SLOTS = { { Pos = Vector2.new(64, 118), Size = 78 }, { Pos = Vector2.new(160, 64), Size = 78 } }
local MENU = { Pos = Vector2.new(214, 150), Size = 52 }
local TICKS = 24

export type Card = { Button: TextButton, Name: TextLabel, Timer: TextLabel, Shade: Frame, Segments: { Frame }, Icon: CanvasGroup, Kind: string, Size: number, Key: TextLabel }
export type View = { Root: Frame, Cards: { Card }, Menu: TextButton, MenuKey: TextLabel }

local function badge(holder: Instance, size: number): TextLabel
	local b = HudKit.make("Frame", holder, {
		Name = "Key", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, size * 0.36, 0.5, size * 0.36),
		Size = UDim2.fromOffset(20, 20), BackgroundColor3 = C.Ink, BorderSizePixel = 0, ZIndex = 4,
	}) :: Frame
	HudKit.make("UICorner", b, { CornerRadius = UDim.new(1, 0) })
	HudKit.make("UIStroke", b, { Color = C.Sakura, Thickness = 1 })
	return HudKit.label(b, "", 12, Enum.Font.GothamBold, C.Blossom, { Size = UDim2.fromScale(1, 1), ZIndex = 4 })
end

local function caption(key: TextLabel, text: string?)
	local badgeFrame = key.Parent :: Frame
	badgeFrame.Visible = text ~= nil and text ~= ""
	key.Text = text or ""
	badgeFrame.Size = UDim2.fromOffset(math.max(20, #key.Text * 7 + 8), 20)
end

function Hud.new(gui: ScreenGui, cast: (number) -&gt; (), menu: () -&gt; ()): View
	local root = HudKit.make("Frame", gui, {
		Name = "QiSpellSlots", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -24),
		Size = UDim2.fromOffset(CLUSTER.X, CLUSTER.Y), BackgroundTransparency = 1,
	}) :: Frame
	root.Destroying:Once(HudKit.bindScale(root, 0.85))
	local cards: { Card } = {}
	for slot, layout in SLOTS do
		local at = UDim2.fromOffset(layout.Pos.X, layout.Pos.Y)
		local button = Sakura.roundButton(root, layout.Size, at, "")
		local holder = button.Parent :: Frame
		local shade = HudKit.make("Frame", holder, {
			Name = "Shade", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = C.Ink, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4,
		}) :: Frame
		HudKit.make("UICorner", shade, { CornerRadius = UDim.new(1, 0) })
		local key = badge(holder, layout.Size)
		local timer = HudKit.label(holder, "", 20, Enum.Font.GothamBold, C.Ivory, { Size = UDim2.fromScale(1, 1), ZIndex = 5, TextStrokeTransparency = 0.2 })
		local name = HudKit.label(root, "", 12, Enum.Font.Garamond, C.Blossom, {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(layout.Pos.X, layout.Pos.Y + layout.Size * 0.62),
			Size = UDim2.fromOffset(120, 16), TextStrokeTransparency = 0.4,
		})
		local segments: { Frame } = {}
		local radius = layout.Size * 0.5 + 15
		for n = 1, TICKS do
			local angle = math.rad((n - 1) * 360 / TICKS - 90)
			segments[n] = HudKit.make("Frame", root, {
				Name = "Tick", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(3, 7), Rotation = math.deg(angle) + 90,
				Position = UDim2.fromOffset(layout.Pos.X + math.cos(angle) * radius, layout.Pos.Y + math.sin(angle) * radius),
				BackgroundColor3 = C.Sakura, BorderSizePixel = 0, Visible = false,
			}) :: Frame
		end
		button.Activated:Connect(function() cast(slot) end)
		table.insert(cards, { Button = button, Name = name, Timer = timer, Shade = shade, Segments = segments, Icon = Icons.draw(holder, "Empty", layout.Size), Kind = "Empty", Size = layout.Size, Key = key })
	end
	local menuButton = Sakura.roundButton(root, MENU.Size, UDim2.fromOffset(MENU.Pos.X, MENU.Pos.Y), "")
	Icons.draw(menuButton.Parent :: Frame, "Arsenal", MENU.Size)
	local menuKey = badge(menuButton.Parent :: Frame, MENU.Size)
	menuButton.Activated:Connect(menu)
	return { Root = root, Cards = cards, Menu = menuButton, MenuKey = menuKey }
end

-- `keys` = { spell 1, spell 2, Arsenal } captions for the active device.
function Hud.update(view: View, slots: { string }, cooldowns: { [string]: number }, now: number, qi: number, touch: boolean?, keys: { string }?)
	-- Touch: the top-right corner above the combat buttons (HudLayout.Touch, batch 25); else bottom-right.
	local screen = view.Root.Parent
	if touch and screen and screen:IsA("GuiBase2d") then
		local r = Layout.touch(screen.AbsoluteSize.X, screen.AbsoluteSize.Y).Spells
		view.Root.AnchorPoint, view.Root.Position = Vector2.zero, UDim2.fromOffset(math.floor(r.X), math.floor(r.Y))
	else
		view.Root.AnchorPoint, view.Root.Position = Vector2.new(1, 1), UDim2.new(1, -24, 1, -24)
	end
	local touchLayout = touch == true
	if view.Root:GetAttribute("TouchLayout") ~= touchLayout then
		view.Root:SetAttribute("TouchLayout", touchLayout)
		for slot, card in view.Cards do
			local at = if touchLayout then Vector2.new(if slot == 1 then 48 else 132, 42) else SLOTS[slot].Pos
			local holder = card.Button.Parent :: Frame
			holder.Position = UDim2.fromOffset(at.X, at.Y)
			card.Name.Position = UDim2.fromOffset(at.X, at.Y + card.Size * 0.62)
			for i, tick in card.Segments do
				local angle, radius = math.rad((i - 1) * 360 / TICKS - 90), card.Size * 0.5 + 15
				tick.Position = UDim2.fromOffset(at.X + math.cos(angle) * radius, at.Y + math.sin(angle) * radius)
			end
		end
		local menuHolder = view.Menu.Parent :: Frame
		menuHolder.Position = if touchLayout then UDim2.fromOffset(218, 42) else UDim2.fromOffset(MENU.Pos.X, MENU.Pos.Y)
		local scale = menuHolder:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", menuHolder)
		scale.Scale = if touchLayout then 1.45 else 1
	end
	local captions = keys or {}
	caption(view.MenuKey, captions[3])
	for slot, c in view.Cards do
		caption(c.Key, captions[slot])
		local id = slots[slot]
		local s = if id then Spells.get(id) else nil
		local remaining = if id then math.max(0, (cooldowns[id] or 0) - now) else 0
		local ready = s ~= nil and remaining == 0 and qi &gt;= s.QiCost
		local kind = if s then s.Discipline else "Empty"
		if kind ~= c.Kind then
			c.Icon:Destroy()
			c.Icon, c.Kind = Icons.draw(c.Button.Parent :: Frame, kind, c.Size), kind
		end
		c.Icon.GroupTransparency = if ready then 0 else 0.5
		c.Shade.BackgroundTransparency = if remaining &gt; 0 then 0.35 else 1
		c.Name.Text = if s then (if touch then string.format("%d Qi", s.QiCost) else string.format("%s · %d Qi", s.Name, s.QiCost)) else "Empty slot"
		c.Timer.Text = if remaining &gt; 0 then string.format("%.1f", remaining) else ""
		local lit = if s and remaining &gt; 0 then math.ceil(remaining / s.Cooldown * TICKS) else 0
		for n, f in c.Segments do
			f.Visible = n &lt;= lit
		end
	end
end

return table.freeze(Hud)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="725">
            <Properties>
              <string name="Name">SpellVfx</string>
              <string name="Source">--!strict
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local Workspace=game:GetService("Workspace")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local simFolder=Shared:WaitForChild("Simulation")
local Spells=require(simFolder:WaitForChild("SpellSchema") :: ModuleScript)
local Qi=require(script.Parent.QiVfx)
local Vfx={}
local colors: {[string]: Color3}={CelestialThunder=Color3.fromRGB(112,210,255),CrimsonFlame=Color3.fromRGB(255,91,42),AbyssalVoid=Color3.fromRGB(113,66,172),SpiritTalismans=Color3.fromRGB(91,236,194)}
local casting: {[number]: {Instance}}={}
local live: {[Instance]: boolean}={}
local function part(name: string,position: Vector3,color: Color3,lifetime: number): Part
 local p=Instance.new("Part");p.Name=name;p.Size=Vector3.one*0.2;p.Position=position;p.Color=color;p.Material=Enum.Material.Neon
 p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Parent=Workspace
 live[p]=true;p.Destroying:Once(function() live[p]=nil end);Debris:AddItem(p,lifetime);return p
end
local function ring(position: Vector3,color: Color3,radius: number,duration: number): Part
 local p=part("QiCastRing",position,color,duration+0.1);p.Shape=Enum.PartType.Cylinder
 p.Size=Vector3.new(0.08,1,1);p.CFrame=CFrame.new(position)*CFrame.Angles(0,0,math.pi/2);p.Transparency=0.35
 TweenService:Create(p,TweenInfo.new(duration),{Size=Vector3.new(0.04,radius*2,radius*2),Transparency=1}):Play()
 return p
end
local function beam(a: Vector3,b: Vector3,color: Color3,duration: number)
 local first=part("QiBeamOrigin",a,color,duration+0.3);first.Transparency=1
 local last=part("QiBeamHead",a,color,duration+0.3)
 Qi.tail(last,color)
 local aa=Instance.new("Attachment");aa.Parent=first;local ab=Instance.new("Attachment");ab.Parent=last
 local v=Instance.new("Beam");v.Attachment0=aa;v.Attachment1=ab;v.Color=ColorSequence.new(color);v.Width0=0.35;v.Width1=0.65
 v.FaceCamera=true;v.LightEmission=1;v.Parent=first
 TweenService:Create(last,TweenInfo.new(math.max(0.05,duration),Enum.EasingStyle.Linear),{Position=b}):Play()
end
function Vfx.cancel(id: number)
 local items: {Instance}=casting[id] or {}
 for _,p in items do p:Destroy() end;casting[id]=nil
end
function Vfx.cue(cue: any,state: any)
 local own=state:Own()
 local d=cue.Data
 if own and own.Root and typeof(d.position)=="Vector3" and (own.Root.Position-d.position).Magnitude&gt;100 then return end
 local s=if type(d.spell)=="string" then Spells.get(d.spell) else nil
 local color=if s then colors[s.Discipline] else colors.SpiritTalismans
 if cue.Kind=="SpellInterrupted" then Vfx.cancel(cue.Source);return end
 if typeof(d.position)~="Vector3" then return end
 if cue.Kind=="SpellStartup" then
  Vfx.cancel(cue.Source)
  local duration=math.max(0.1,(d.release or cue.Time+0.3)-cue.Time)
  local p=ring(d.position-Vector3.new(0,2.6,0),color,4,duration)
  casting[cue.Source]={p}
  local e=state:Get(cue.Source);local hand=if e then e.Model:FindFirstChild("RightHand") else nil
  if hand and hand:IsA("BasePart") then
   local seal=Qi.seal(hand,color,duration);if seal then table.insert(casting[cue.Source],seal) end
   local glow=Instance.new("Highlight");glow.Adornee=hand;glow.FillColor=color;glow.FillTransparency=0.2;glow.OutlineTransparency=1;glow.Parent=p
   local light=Instance.new("PointLight");light.Color=color;light.Range=10;light.Brightness=2;light.Parent=hand
   Debris:AddItem(light,duration);table.insert(casting[cue.Source],light)
  end
 elseif cue.Kind=="SpellRelease" then
  Vfx.cancel(cue.Source);ring(d.position,color,5,0.45)
  if s and (s.Shape=="Line" or s.Shape=="Impact") and typeof(d.destination)=="Vector3" then beam(d.position,d.destination,color,d.travel or 0.2) end
  if s and s.Status.Decoy then
   local e=state:Get(cue.Source)
   if e then
    local clone=Instance.new("Model");clone.Name="GalePhantom";clone.Parent=Workspace;live[clone]=true
    clone.Destroying:Once(function() live[clone]=nil end);Debris:AddItem(clone,2)
    local root=e.Root
    for _,limb in e.Model:GetChildren() do
     if limb:IsA("BasePart") and limb.Name~="HumanoidRootPart" and root then
      local ghost=part("Phantom",limb.Position,color,2);ghost.Size=limb.Size;ghost.CFrame=CFrame.new(d.position)*root.CFrame:ToObjectSpace(limb.CFrame)
      ghost.Transparency=0.65;ghost.Parent=clone;TweenService:Create(ghost,TweenInfo.new(2),{Transparency=1}):Play()
     end
    end
   end
  end
  if s and s.Status.Ward then
   local e=state:Get(cue.Source)
   if e then
    local ward=part("JadeAegisTalisman",d.position,color,30);ward.Size=Vector3.new(1,1.6,0.15)
    task.spawn(function()
     while ward.Parent and e.Root and e.Root.Parent and (e.Model:GetAttribute("JadeAegisUntil") or 0)&gt;Workspace:GetServerTimeNow() do
      ward.CFrame=e.Root.CFrame*CFrame.new(1.7,1.2,0)*CFrame.Angles(0,0,math.rad(15));task.wait(0.05)
     end
     ward:Destroy()
    end)
   end
  end
 elseif cue.Kind=="SpellPulse" then
  if d.spell=="FissureSlam" then
   local e=state:Get(cue.Source);local p=part("FissureAnchor",d.position,color,1.6);p.Transparency=1
   Qi.rupture(p,d.position,if e and e.Root then e.Root.CFrame.LookVector else Vector3.zAxis,color,if e then e.Model else nil)
  end
  ring(d.position-Vector3.new(0,2.4,0),color,math.min(d.range or 5,20),0.65)
  if s and s.Id=="GraveTendrils" then
   for n=1,5 do
    local angle=n*math.pi*2/5;local spike=part("GraveClaw",d.position+Vector3.new(math.cos(angle)*2,-1,math.sin(angle)*2),color,2)
    spike.Size=Vector3.new(0.35,5,0.35);spike.CFrame=CFrame.new(spike.Position)*CFrame.Angles(math.sin(angle)*0.3,0,-math.cos(angle)*0.3)
    TweenService:Create(spike,TweenInfo.new(0.25),{Position=spike.Position+Vector3.new(0,2,0)}):Play()
   end
  elseif s and s.Shape=="Pillars" then
   local column=part("SorceryPillar",d.position,color,0.6);column.Size=Vector3.new(s.Radius,12,s.Radius)
   TweenService:Create(column,TweenInfo.new(0.55),{Transparency=1}):Play()
  end
 elseif cue.Kind=="SpellHit" or cue.Kind=="ProjectileParry" then ring(d.position,color,3,0.3) end
end
function Vfx.destroy()
 for id in casting do Vfx.cancel(id) end
 for p in live do p:Destroy() end;table.clear(live)
end
return table.freeze(Vfx)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="726">
            <Properties>
              <string name="Name">SunForms</string>
              <string name="Source">--!strict
-- Blazing Sun pieces drawn to the reference: the ember that kindles on the chest, the jagged blazing
-- starbursts that replace the eyes (with sideways flame streaks and falling ember dashes), and the
-- fists' gauntlets of spinning gold crescents, lens-flare sparkles and small sunbursts.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Assets = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.PresentationAssets)
local Kit = require(script.Parent.SkillKit)
local Bb = require(script.Parent.BillboardFx)
local Flame = require(script.Parent.FlameForms)
local Sun = {}

local rgb = Color3.fromRGB
Sun.Burst = { rgb(235, 255, 110), rgb(255, 196, 40), rgb(255, 120, 20), rgb(255, 72, 12) }
Sun.Gold = rgb(255, 196, 70)
local WHITE = Color3.new(1, 1, 1)

local function seq(a: Color3, b: Color3): ColorSequence return ColorSequence.new(a, b) end

-- Where the chest sits relative to the root (front of the torso).
function Sun.chest(trove: Kit.Trove, root: BasePart): Attachment
	return Kit.attach(trove, root, Vector3.new(0, 0.15, -1.3), "SunChest")
end

-- A small ember on the chest that spits sparks; returns its burst board so it can be grown.
function Sun.ember(trove: Kit.Trove, chest: Attachment): BillboardGui
	local board = Bb.starburst(trove, chest, { Sun.Burst[1], Sun.Burst[2], Sun.Burst[3] }, 1.8, 10)
	Kit.emitter(chest, { Texture = Assets.Textures.Ember, Color = seq(Sun.Burst[1], Sun.Burst[3]), Size = NumberSequence.new(0.14, 0.02), Rate = 40,
		Lifetime = NumberRange.new(0.3, 0.7), Speed = NumberRange.new(4, 9), Spread = 70, Accel = Vector3.new(0, -12, 0) })
	Kit.light(chest, Sun.Burst[3], 12, 3)
	return board
end

export type Flare = { Scale: number }

-- A jagged starburst built from Neon spikes that turn to face the camera every frame. Real parts
-- (outside the character) occlude the black silhouette Highlight, which paints over billboards.
local function flare(trove: Kit.Trove, at: Attachment, studs: number, count: number): Flare
	local folder = Kit.folder(trove, "BlazingEyeFlare")
	local spikes: { BasePart } = {}
	for n = 1, count do spikes[n] = Kit.part(folder, "Spike", Sun.Burst[(n % 3) + 2], Vector3.new(0.04, 0.1, 1), CFrame.identity, Enum.PartType.Wedge) end
	local core = Kit.part(folder, "Core", Sun.Burst[1], Vector3.one * 0.3, CFrame.identity, Enum.PartType.Ball)
	table.insert(spikes, core)
	local handle: Flare = { Scale = studs }
	local base = math.random() * math.pi * 2
	Kit.add(trove, RunService.Heartbeat:Connect(function()
		local camera = Workspace.CurrentCamera
		if not camera or not at.Parent then return end
		local c, t = at.WorldPosition, os.clock()
		local face = CFrame.lookAt(c, camera.CFrame.Position)
		local frames: { CFrame } = {}
		for n = 1, count do
			local length = handle.Scale * 0.5 * (0.45 + 0.55 * (0.5 + 0.5 * math.noise(n * 1.7, t * 9)))
			local angle = base + n / count * math.pi * 2 + math.noise(n, t * 4) * 0.25
			local dir = face.RightVector * math.cos(angle) + face.UpVector * math.sin(angle)
			-- A wedge seen side-on is a triangle: its thin X axis faces the camera, its point aims outward.
			spikes[n].Size = Vector3.new(0.04, length * (0.16 + 0.06 * (n % 3)), length)
			frames[n] = CFrame.fromMatrix(c + dir * length / 2, face.LookVector, (-dir):Cross(face.LookVector))
		end
		core.Size = Vector3.one * handle.Scale * 0.14
		frames[count + 1] = CFrame.new(c)
		Workspace:BulkMoveTo(spikes, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end))
	return handle
end

-- Two giant jagged starbursts on the eyes with flame streaks and a rain of ember dashes.
function Sun.eyes(trove: Kit.Trove, head: BasePart, studs: number): { Flare }
	local s = head.Size
	local flares: { Flare } = {}
	for _, side in { -1, 1 } do
		-- Hung a little in front of the face so hair, masks and hat brims never bury the burst.
		local a = Kit.attach(trove, head, Vector3.new(side * s.X * 0.22, s.Y * 0.08, -s.Z * 0.55 - 0.3), "BlazingEye")
		table.insert(flares, flare(trove, a, studs, 12))
		local streak = Kit.emitter(a, { Color = seq(Sun.Burst[2], Sun.Burst[4]), Size = NumberSequence.new(0.5, 0.05), Rate = 30,
			Lifetime = NumberRange.new(0.15, 0.3), Speed = NumberRange.new(8, 14), Spread = 18 })
		streak.EmissionDirection = if side &lt; 0 then Enum.NormalId.Left else Enum.NormalId.Right
		Kit.light(a, Sun.Burst[2], 6, 3)
	end
	local rain = Kit.attach(trove, head, Vector3.new(0, s.Y * 1.5, -s.Z * 0.6), "EmberRain")
	local dashes = Kit.emitter(rain, { Texture = Assets.Textures.Ember, Color = seq(Sun.Burst[2], Sun.Burst[3]), Size = NumberSequence.new(0.12), Rate = 26,
		Lifetime = NumberRange.new(0.6, 1), Speed = NumberRange.new(1, 3), Spread = 180, Accel = Vector3.new(0, -14, 0), Spin = NumberRange.new(0, 0),
		Transparency = NumberSequence.new(0) })
	dashes.Squash = NumberSequence.new(-2.2) -- tall thin dashes, not round sparks
	dashes.Speed = NumberRange.new(4, 9)
	return flares
end

-- Gauntlet on a fist: two counter-spinning gold crescents, a sunburst, flame and recurring sparkles.
function Sun.gauntlet(trove: Kit.Trove, hand: BasePart)
	local a = Kit.attach(trove, hand, Vector3.zero, "SunFist")
	Bb.arc(trove, a, Sun.Gold, 3.4, 0.42, 320)
	Bb.arc(trove, a, Sun.Burst[2], 2.4, 0.3, -420)
	Bb.starburst(trove, a, { Sun.Burst[1], Sun.Burst[3] }, 1.6, 8)
	Flame.gauntlet(trove, hand)
	Kit.emitter(a, { Texture = Assets.Textures.Ember, Color = seq(Sun.Burst[2], Sun.Burst[4]), Size = NumberSequence.new(0.12, 0.02), Rate = 35,
		Lifetime = NumberRange.new(0.4, 0.9), Speed = NumberRange.new(5, 10), Spread = 180, Accel = Vector3.new(0, -8, 0) })
	local function twinkle()
		local holder = Kit.attach(trove, hand, Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3, "FistSparkle")
		Bb.sparkle(trove, holder, if math.random() &lt; 0.5 then WHITE else Sun.Gold, 2.2, 0.5, (math.random() - 0.5) * 30)
		Kit.after(trove, 0.5, function() holder:Destroy() end)
	end
	Kit.add(trove, task.spawn(function()
		while true do twinkle(); task.wait(0.22 + math.random() * 0.2) end
	end))
end

-- A black ring of thorns (the seal that clamps the chest ember before it bursts).
function Sun.thorns(trove: Kit.Trove, adornee: Instance, studs: number): BillboardGui
	local gui = Bb.board(trove, adornee, studs)
	local ink = Color3.fromRGB(10, 4, 2)
	Bb.circle(gui, ink, 0.62, 0.06, 0, trove)
	for n = 1, 22 do
		local yaw = n / 22 * math.pi * 2
		local f = Bb.frame(gui, ink, UDim2.fromScale(0.07, 0.07), math.deg(yaw) + 45)
		f.Position = UDim2.fromScale(0.5 + math.cos(yaw) * 0.33, 0.5 + math.sin(yaw) * 0.33)
	end
	return gui
end

return table.freeze(Sun)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="727">
            <Properties>
              <string name="Name">SunShots</string>
              <string name="Source">--!strict
-- Camera direction for Blazing Sun Awakening (caster only), cut to the reference: a low close-up on
-- the face, an extreme close-up drifting along the cheek and shoulder, a medium shot on the chest as
-- the ember builds, a push into the sunburst; after release, the blazing-eye macro on the black
-- silhouette and a medium shot of the burning fists.
local Cinema = require(script.Parent.SkillCinema)
local Kit = require(script.Parent.SkillKit)
local Shots = {}

local function head(cast: any): BasePart?
	local h = cast.Entity.Model:FindFirstChild("Head")
	return if h and h:IsA("BasePart") then h else nil
end

local function root(cast: any): CFrame?
	local r = cast.Entity.Root
	return if r and r.Parent then r.CFrame else nil
end

function Shots.startup(cast: any)
	local w = cast.Windup
	Cinema.play(cast.Cinema, function(t: number) -- low, close, looking up at the face
		local h = head(cast)
		if not h then return nil end
		local cf = h.CFrame
		return Cinema.look(cf.Position + cf.LookVector * 3.6 - cf.UpVector * 0.7 + cf.RightVector * 0.7, cf.Position + cf.UpVector * 0.1, 46, 5)
	end, w * 0.07, 0.02)
	Kit.after(cast.Trove, w * 0.07, function() -- extreme close-up drifting along cheek and shoulder
		Cinema.play(cast.Cinema, function(t: number)
			local h = head(cast)
			if not h then return nil end
			local cf, k = h.CFrame, t / (w * 0.32)
			local eye = cf.Position + cf.LookVector * 3 + cf.RightVector * (1.6 - k * 0.8) - cf.UpVector * (0.5 + k * 0.3)
			return Cinema.look(eye, cf.Position - cf.UpVector * 0.5 + cf.RightVector * 0.3, 40, -4)
		end, w * 0.32, 0.02)
	end)
	Kit.after(cast.Trove, w * 0.39, function() -- medium on the chest, then the push into the burst
		Cinema.play(cast.Cinema, function(t: number)
			local cf = root(cast)
			if not cf then return nil end
			local push = math.clamp((t - w * 0.47) / (w * 0.12), 0, 1)
			return Cinema.look(cf:PointToWorldSpace(Vector3.new(0.6, 1.3, -(8.5 - push * 4))), cf:PointToWorldSpace(Vector3.new(0, 0.9, 0)), 48 - push * 6, 0)
		end, w * 0.61 + 3, 0.02) -- holds past a late release cue
	end)
end

-- After release: hold through the 2D blast, then the eye macro, then the fists.
function Shots.release(cast: any, eyes: number, fists: number, finish: number)
	Cinema.play(cast.Cinema, function(t: number)
		local cf = root(cast)
		if not cf then return nil end
		return Cinema.look(cf:PointToWorldSpace(Vector3.new(0, 0.6, -6)), cf:PointToWorldSpace(Vector3.new(0, 1, 0)), 60, 0)
	end, eyes, 0.02)
	Kit.after(cast.Trove, eyes, function()
		Cinema.play(cast.Cinema, function(t: number)
			local h = head(cast)
			if not h then return nil end
			local cf = h.CFrame
			return Cinema.look(cf.Position + cf.LookVector * (2.9 - math.min(t, 1.5) * 0.3) + cf.UpVector * 0.1, cf.Position + cf.UpVector * 0.1, 50, 0)
		end, fists - eyes, 0.02)
	end)
	Kit.after(cast.Trove, fists, function()
		Cinema.play(cast.Cinema, function(t: number)
			local cf = root(cast)
			if not cf then return nil end
			return Cinema.look(cf:PointToWorldSpace(Vector3.new(-1.2, 0.8, -(10.5 - t * 0.4))), cf:PointToWorldSpace(Vector3.new(0, 0.6, 0)), 50, 0)
		end, finish - fists, 0.04)
	end)
	Kit.after(cast.Trove, finish, function() Cinema.release(cast.Cinema, 0.6) end)
end

return table.freeze(Shots)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="728">
            <Properties>
              <string name="Name">SupernovaShots</string>
              <string name="Source">--!strict
-- Camera direction for Celestial Supernova (caster only), cut to the reference: a tight orbit in the
-- smoke, a pull-back that frames the ring, a fast swoop, a wide tilted look at the planet, a push-in
-- as it ignites; after release a straight look at the blast, then a close shot inside the column.
local Cinema = require(script.Parent.SkillCinema)
local Kit = require(script.Parent.SkillKit)
local Shots = {}

local function dir(angle: number): Vector3 return Vector3.new(math.cos(angle), 0, math.sin(angle)) end

function Shots.startup(cast: any, center: () -&gt; Vector3?, floor: Vector3, radius: number)
	local w = cast.Windup
	local yaw = math.random() * math.pi * 2
	local function at(): Vector3 return center() or floor end
	-- A: close in the vortex, slightly above, Dutch.
	Cinema.play(cast.Cinema, function(t: number)
		local c = at()
		return Cinema.look(c + dir(yaw + t * 0.7) * 7.5 + Vector3.new(0, 2.2, 0), c + Vector3.new(0, 0.6, 0), 55, -7)
	end, w * 0.23, 0.25)
	-- B: pull back to frame the circle.
	Kit.after(cast.Trove, w * 0.23, function()
		Cinema.play(cast.Cinema, function(t: number)
			local k = 1 - (1 - math.min(1, t / (w * 0.06))) ^ 3
			local c = at()
			return Cinema.look(c + dir(yaw + 0.16 + t * 0.2) * (7.5 + k * 20) + Vector3.new(0, 2.2 + k * 3, 0), c, 55, -4)
		end, w * 0.11, 0.05)
	end)
	-- C: the swoop, a fast low arc under the forming ring.
	Kit.after(cast.Trove, w * 0.34, function()
		Cinema.play(cast.Cinema, function(t: number)
			local k = math.min(1, t / (w * 0.13))
			local c = at()
			return Cinema.look(c + dir(yaw + 0.3 + k * 2.4) * (30 + k * 10) + Vector3.new(0, 8 - k * 14, 0), c + Vector3.new(0, -2 + k * 2, 0), 72 - k * 10, 12 - k * 4)
		end, w * 0.13, 0.04)
	end)
	-- D: wide on the planet, ring tilted across frame; E: push-in as it ignites.
	Kit.after(cast.Trove, w * 0.47, function()
		local base = yaw + 2.7
		Cinema.play(cast.Cinema, function(t: number)
			local c = at()
			local push = math.clamp((t - w * 0.38) / (w * 0.15), 0, 1)
			local d = radius * (4.2 - push * 0.9)
			return Cinema.look(c + dir(base + t * 0.1) * d + Vector3.new(0, radius * 0.15, 0), c, 55 - push * 6, 9)
		end, w * 0.53 + 3, 0.06) -- holds past a late release cue
	end)
end

function Shots.release(cast: any, ground: Vector3, center: Vector3, radius: number)
	local yaw = math.random() * math.pi * 2
	Cinema.play(cast.Cinema, function(t: number)
		return Cinema.look(center + dir(yaw) * (radius * 2.1 + t * 6) + Vector3.new(0, radius * 0.2, 0), center, 62, 4)
	end, 0.59, 0.04)
	Kit.after(cast.Trove, 0.59, function()
		Cinema.play(cast.Cinema, function(t: number) -- close outside the column, looking in at the caster
			local eye = center + dir(yaw + 1.2 + t * 0.12) * 21 + Vector3.new(0, -3 + t * 0.8, 0)
			return Cinema.look(eye, center + Vector3.new(0, 2 + t * 1.2, 0), 64, -6)
		end, 6, 0.02)
	end)
end

return table.freeze(Shots)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="729">
            <Properties>
              <string name="Name">SupernovaShow</string>
              <string name="Source">--!strict
-- Celestial Supernova, cut to the reference video (phases are fractions of the server windup so a
-- quick-cast catalyst stays in sync; the release and pulses wait for the authoritative cues):
--   0.00 teal void, smoke vortex, rocks; the caster rises   0.26 the glowing ring and gold sparkles
--   0.34 camera swoop with motion streaks                   0.45 the banded planet and Saturn ring
--   0.80 the planet burns white   0.86 gold flame crescents   release: white blast, a huge ring and
--   flare line, ink dome and ink streak frames, the column   pulses: flare   final: slow whiteout
-- Void, camera, grading and 2D frames are the caster's; everyone nearby sees the world effects.
local RunService = game:GetService("RunService")
local Kit = require(script.Parent.SkillKit)
local Fx = require(script.Parent.SkillFx)
local Cinema = require(script.Parent.SkillCinema)
local Screen = require(script.Parent.ImpactFrame)
local Forms = require(script.Parent.CelestialForms)
local Pillar = require(script.Parent.CelestialPillar)
local Shots = require(script.Parent.SupernovaShots)
local Bb = require(script.Parent.BillboardFx)
local Shapes = require(script.Parent.BillboardShapes)
local Scenery = require(script.Parent.NovaScenery)
local Manga = require(script.Parent.MangaFx)
local Planet = require(script.Parent.PlanetForms)
local Stage = require(script.Parent.VoidStage)
local Ink = require(script.Parent.NovaInk)
local Sfx = require(script.Parent.SkillAudio)
local Show = {}

Show.FinalPulse = 3
local RISE, RADIUS = 20, 18 -- high enough that the planet clears the void floor
local VOID_COLOR = Color3.fromRGB(14, 64, 70)
local WHITE = Color3.new(1, 1, 1)

local function center(cast: any): Vector3?
	local root = cast.Entity.Root
	return if root and root.Parent then root.Position else nil
end

function Show.startup(cast: any)
	local w = cast.Windup
	local folder = Kit.folder(cast.Trove, "CelestialSupernova")
	cast.Bag.Folder = folder
	local floor = center(cast) or Vector3.zero
	local function at(): Vector3 return center(cast) or floor end
	Sfx.score(cast, "Nova", "Startup")
	if cast.Own then
		cast.Bag.Void = Stage.void(cast.Trove, floor, 95, 2.8, 200, VOID_COLOR, { cast.Entity.Model, folder })
		cast.Bag.Grade = Screen.grade(cast.Trove)
		cast.Bag.Bloom = Stage.bloom(cast.Trove, 1.3, 32, 0.82, 0.6)
		Screen.settle(cast.Trove, cast.Bag.Grade, Stage.Grades.TealVoid, 0.3)
		Shots.startup(cast, function() return center(cast) end, floor, RADIUS)
	end
	cast.Bag.Widen = Scenery.vortex(cast.Trove, folder, at, 10)
	Scenery.rocks(cast.Trove, folder, floor + Vector3.new(0, 6, 0), 26, 70)
	Kit.after(cast.Trove, w * 0.03, function() Forms.levitate(cast, RISE, w * 0.45) end)
	Kit.after(cast.Trove, w * 0.24, function() Scenery.sparkles(cast.Trove, folder, at(), 4, 16, 3, w * 0.14) end)
	Kit.after(cast.Trove, w * 0.26, function() -- the circle
		local hold = Bb.anchor(folder, at())
		Kit.add(cast.Trove, RunService.Heartbeat:Connect(function() hold.Position = at() end))
		Bb.ring(cast.Trove, hold, Planet.Cyan, 3, 13, w * 0.05, w * 0.06, w * 0.05)
	end)
	Kit.after(cast.Trove, w * 0.34, function()
		cast.Bag.Widen(14)
		if cast.Own then Manga.streaks(cast.Trove, Color3.fromRGB(20, 80, 95), w * 0.12) end
	end)
	Kit.after(cast.Trove, w * 0.45, function() -- the planet
		cast.Bag.Widen(RADIUS * 1.5)
		cast.Bag.Planet = Planet.body(cast.Trove, folder, at, RADIUS, w * 0.06)
		Scenery.stars(cast.Trove, folder, at(), RADIUS, w * 0.42)
	end)
	Kit.after(cast.Trove, w * 0.8, function() if cast.Bag.Planet then Planet.ignite(cast.Trove, cast.Bag.Planet, w * 0.18) end end)
	Kit.after(cast.Trove, w * 0.86, function() -- gold flame crescents tearing round the white-hot planet
		local c = at()
		cast.Bag.Arcs = Scenery.crescents(cast.Trove, folder, c, RADIUS)
		Fx.burst(Bb.anchor(folder, c), ColorSequence.new(WHITE, Planet.Gold), 40, 50)
		if cast.Own then Cinema.shake(cast.Cinema, 0.35, 0.6, 2) end
	end)
end

-- Detonation, timed to the reference: 0.00 five-lobed white blast and gold embers, 0.12 thick white
-- donut, 0.20 ring, flare line and white heart, 0.22 the column, then three ink frames (0.36 dome,
-- 0.42 inverted burst, 0.47 streaks) and at 0.59 the shot inside the column.
function Show.release(cast: any, ground: Vector3)
	local folder = cast.Bag.Folder or Kit.folder(cast.Trove, "CelestialSupernova")
	cast.Bag.Folder = folder
	Sfx.score(cast, "Nova", "Release")
	local c = center(cast) or ground + Vector3.new(0, RISE, 0)
	Planet.remove(cast.Bag.Planet)
	cast.Bag.Planet = nil
	for _, p in cast.Bag.Arcs or {} do p:Destroy() end -- the crescents burn out in the blast
	if cast.Bag.Widen then cast.Bag.Widen(10) end
	local hub = Bb.anchor(folder, c)
	if cast.Bag.Bloom then Kit.tween(cast.Trove, cast.Bag.Bloom, 0.6, { Intensity = 0.45 }) end -- keep the column cyan, not blown white
	Shapes.blob(cast.Trove, hub, Planet.Cyan, RADIUS * 3.2, 5, 0.12, 0.2)
	Fx.burst(hub, ColorSequence.new(WHITE, Planet.Gold), 60, 70)
	Kit.after(cast.Trove, 0.12, function() Bb.ring(cast.Trove, hub, Planet.Cyan, RADIUS * 2.4, RADIUS * 3.3, 0.06, 0.03, 0.08, 4.5) end)
	Kit.after(cast.Trove, 0.2, function()
		Bb.ring(cast.Trove, hub, Planet.Cyan, RADIUS * 3.6, RADIUS * 4, 0.04, 0.3, 0.3, 1.8)
		Shapes.line(cast.Trove, hub, Planet.Cyan, RADIUS * 4.5, 0.35)
		Fx.flash(cast.Trove, folder, c, WHITE, RADIUS * 1.4, 0.45)
	end)
	Kit.after(cast.Trove, 0.22, function()
		cast.Bag.Column = Pillar.erupt(cast.Trove, folder, ground, 24, c.Y - ground.Y)
		Scenery.rocks(cast.Trove, folder, ground + Vector3.new(0, 10, 0), 14, 34)
		Kit.shockwave(cast.Trove, folder, CFrame.new(ground - Vector3.new(0, 2.6, 0)), Planet.Cyan, 48, 0.9, 0.2)
	end)
	Kit.after(cast.Trove, 4.4, function() Show.whiteout(cast) end) -- if the final pulse never arrives
	if cast.Own then
		Cinema.shake(cast.Cinema, 0.8, 1.2, 2)
		Shots.release(cast, ground, c, RADIUS)
		Kit.after(cast.Trove, 0.36, function() Ink.dome(cast.Trove, 0.06) end)
		Kit.after(cast.Trove, 0.42, function() Ink.burst(cast.Trove, 0.05) end)
		Kit.after(cast.Trove, 0.47, function() Ink.streaks(cast.Trove, 0.12); Cinema.shake(cast.Cinema, 0.6, 1.4, 2) end)
	end
end

function Show.pulse(cast: any, _at: Vector3)
	local column = cast.Bag.Column
	if not column or cast.Pulses &lt;= 1 or cast.Pulses &gt;= Show.FinalPulse then return end
	Pillar.flare(cast.Trove, column, 1)
	Sfx.play(cast, "NovaRing", 0.7)
	if cast.Own then Cinema.shake(cast.Cinema, 0.4, 1.4, 2) end
end

-- Final beat: the frame fades slowly to white, holds, and cuts back to the world.
function Show.whiteout(cast: any)
	if cast.Bag.Done then return end
	cast.Bag.Done = true
	Sfx.play(cast, "NovaWhite")
	if cast.Own then
		Manga.fill(cast.Trove, WHITE, 1.1, 0.45, 0.35)
		Kit.after(cast.Trove, 1.55, function()
			Stage.remove(cast.Bag.Void)
			Screen.settle(cast.Trove, cast.Bag.Grade or Screen.grade(cast.Trove), Stage.Grades.Neutral, 0.2)
			Cinema.release(cast.Cinema, 0.03)
		end)
	end
	Kit.after(cast.Trove, if cast.Own then 1.1 else 0, function()
		if cast.Bag.Column then Pillar.dissolve(cast.Trove, cast.Bag.Column, 0.8) end
		if cast.Bag.Align then Forms.levitate(cast, 0, 0.9) end
	end)
	Kit.after(cast.Trove, 2.6, function() Kit.clean(cast.Trove) end)
end

return table.freeze(Show)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="730">
            <Properties>
              <string name="Name">TargetPlate</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/TargetPlate
-- Top-centre health readout for the foe you are fighting (lock-on target, else whoever you last
-- hit or were hit by). Shows name, a crimson health bar with exact numbers and a damage trail, and
-- posture. Sits in the boss bar's slot and stays hidden while a boss bar is showing.
local TweenService = game:GetService("TweenService")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)

local Target = {}
local C = Sakura.Colors

-- Customization ------------------------------------------------------------------------------
local MAX_WIDTH = 520
local TOP = 78
local TRAIL_SPEED = 0.5
local FADE = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

export type View = { Root: CanvasGroup, Name: TextLabel, Numbers: TextLabel, Fill: Frame, Trail: Frame, Posture: Frame, Trailing: number, Shown: boolean, Id: number }

function Target.new(gui: ScreenGui): View
	local root = HudKit.make("CanvasGroup", gui, {
		Name = "TargetPlate", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, TOP),
		Size = UDim2.new(0.4, 0, 0, 52), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false,
	}) :: CanvasGroup
	HudKit.make("UISizeConstraint", root, { MaxSize = Vector2.new(MAX_WIDTH, 52), MinSize = Vector2.new(260, 52) })
	local name = HudKit.label(root, "", 20, Enum.Font.Garamond, C.Ivory, {
		Size = UDim2.new(1, 0, 0, 22), TextStrokeTransparency = 0.2,
	})
	local track = HudKit.make("Frame", root, {
		Name = "Health", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 26), Size = UDim2.new(1, -24, 0, 14),
		BackgroundColor3 = C.Track, BorderSizePixel = 0,
	}) :: Frame
	HudKit.make("UIStroke", track, { Color = C.Gold, Thickness = 1, Transparency = 0.3 })
	local trail = HudKit.make("Frame", track, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Blossom, BorderSizePixel = 0 }) :: Frame
	local fill = HudKit.make("Frame", track, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Crimson, BorderSizePixel = 0 }) :: Frame
	HudKit.make("UIGradient", fill, { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 110, 120), Color3.fromRGB(130, 8, 24)) })
	local numbers = HudKit.label(track, "", 12, Enum.Font.GothamBold, C.Ivory, { Size = UDim2.fromScale(1, 1), ZIndex = 3, TextStrokeTransparency = 0.2 })
	for _, x in { 0, 1 } do Sakura.diamond(track, 14, UDim2.fromScale(x, 0.5), C.Gold, C.Ink) end
	local postureTrack = HudKit.make("Frame", root, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 45), Size = UDim2.new(0.6, 0, 0, 5),
		BackgroundColor3 = C.Ink, BackgroundTransparency = 0.3, BorderSizePixel = 0,
	}) :: Frame
	local posture = HudKit.make("Frame", postureTrack, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Gold, BorderSizePixel = 0,
	}) :: Frame
	return { Root = root, Name = name, Numbers = numbers, Fill = fill, Trail = trail, Posture = posture, Trailing = 1, Shown = false, Id = 0 }
end

local function show(view: View, on: boolean)
	if on == view.Shown then return end
	view.Shown = on
	if on then view.Root.Visible = true end
	local tween = TweenService:Create(view.Root, FADE, { GroupTransparency = if on then 0 else 1 })
	tween.Completed:Once(function()
		if not view.Shown then view.Root.Visible = false end
	end)
	tween:Play()
end

function Target.update(view: View, entity: any?, dt: number, blocked: boolean)
	local snapshot = entity and entity.Snapshot
	if blocked or not entity or not snapshot then
		show(view, false)
		return
	end
	if entity.Id ~= view.Id then view.Id, view.Trailing = entity.Id, 1 end
	local maxHP = math.max(snapshot.MaxHP, 1)
	local ratio = math.clamp(snapshot.ActiveHP / maxHP, 0, 1)
	view.Trailing = if view.Trailing &gt; ratio then math.max(ratio, view.Trailing - TRAIL_SPEED * dt) else ratio
	view.Fill.Size = UDim2.fromScale(ratio, 1)
	view.Trail.Size = UDim2.fromScale(view.Trailing, 1)
	view.Name.Text = entity.Name
	view.Numbers.Text = string.format("%d / %d", math.ceil(snapshot.ActiveHP), math.floor(maxHP + 0.5))
	local p = math.clamp(snapshot.Posture / math.max(snapshot.PostureCapacity, 1), 0, 1)
	local broken = snapshot.State == "StanceBroken"
	view.Posture.Size = UDim2.fromScale(if broken then 1 else p, 1)
	view.Posture.BackgroundColor3 = if broken then C.Ivory elseif p &gt; 0.8 then C.Crimson else C.Gold
	show(view, true)
end

return table.freeze(Target)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="731">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/TutorialController
-- The training card for the opening (TutorialRules). Shows the current step with the player's live
-- key captions while they are near the Sparring Phantom on the Monastery Gate landing, ticks steps
-- off when the server confirms them (TutorialStep cue), and reports the two client-only proofs
-- (camera locked on a foe; an Air Glide held for TutorialRules.GlideSeconds). "Skip training"
-- needs a confirming second press; Replay comes from the Respite menu. The recovery-stakes card is
-- shown on completion, on skip, and the first time a newcomer walks into the courtyard.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("AsurasPath")
local Rules = require(Shared.Shared.TutorialRules)
local InputMap = require(Shared.Shared.InputMap)
local World = require(Shared.Shared.WorldDefinitions)
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)
local Layout = require(script.Parent:WaitForChild("HudLayout") :: ModuleScript)

local Controller = {}
Controller.__index = Controller
Controller.ShowRadius = 70 -- the card appears near the training landing
local T = UiKit.Theme
local spawn = assert(World.spawnById("DM_Sparring_Phantom"), "Sparring Phantom spawn missing")
local HOME = Vector3.new(spawn.Placement.X, spawn.Placement.Y, spawn.Placement.Z)
local COURTYARD_Z = -750 -- past the gatehouse: the first lethal encounter

function Controller.new(state: any, camera: any, movement: any, input: any, ui: any): any
	local remote = Shared.Net:WaitForChild("TutorialIntent") :: RemoteEvent
	local slot = Layout.Regions.Training
	local card = HudKit.panel(ui.Gui, "TrainingCard", { AnchorPoint = Vector2.new(slot.Anchor[1], slot.Anchor[2]),
		Position = UDim2.new(slot.At[1], slot.Offset[1], slot.At[2], slot.Offset[2]),
		Size = UDim2.fromOffset(slot.Size[1], 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false })
	HudKit.make("UIListLayout", card, { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
	HudKit.make("UIPadding", card, { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) })
	local function text(order: number, size: number, color: Color3, font: Enum.Font): TextLabel
		return HudKit.label(card, "", size, font, color, { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left })
	end
	local self = setmetatable({ State = state, Camera = camera, Movement = movement, Input = input, Ui = ui, Remote = remote, Card = card,
		Header = text(1, 14, T.Gold, T.BodyFont), Title = text(2, 22, T.Ivory, T.TitleFont), Do = text(3, 17, T.Ivory, T.BodyFont),
		Why = text(4, 15, T.Muted, T.BodyFont), Sent = {}, Glide = 0, Armed = false, StakesShown = false, Links = {} }, Controller)
	local skip: TextButton
	skip = UiKit.button(card, "Skip training", "Ghost", function()
		if not self.Armed then
			self.Armed, skip.Text = true, "Press again to skip"
			task.delay(3, function() self.Armed = false; if skip.Parent then skip.Text = "Skip training" end end)
			return
		end
		remote:FireServer({ action = "Skip" })
		self:Stakes()
	end)
	skip.LayoutOrder, skip.Size = 5, UDim2.new(1, 0, 0, 30)
	self.Skip = skip
	ui.OnTraining = function(action: string) remote:FireServer({ action = action }); self.Sent = {} end
	table.insert(self.Links, state:OnCue(function(cue: any)
		if cue.Source ~= state.LocalId then return end
		if cue.Kind == "TutorialStep" then
			UiKit.play("Confirm")
			ui:ShowToast("✓ " .. (self:StepTitle(tostring(cue.Data.step)) or "Step") .. " learned")
			if cue.Data.complete then ui:ShowBanner("TRAINING COMPLETE", "The courtyard beyond is lethal", 3); self:Stakes() end
		end
	end))
	return self
end

function Controller.StepTitle(_self: any, id: string): string?
	for _, step in Rules.Steps do if step.Id == id then return step.Title end end
	return nil
end

function Controller.Label(self: any, command: string): string
	local key = self.Input:Label(command)
	return if key ~= "" then key else InputMap.label(command, "Touch")
end

-- The carried-currency rule, once per session, before the first lethal fight (#19): its own card,
-- so the full sentence fits, dismissed with Understood or after a long read.
function Controller.Stakes(self: any)
	if self.StakesShown then return end
	self.StakesShown = true
	local panel = HudKit.panel(self.Ui.Gui, "StakesCard", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.72, 0),
		Size = UDim2.fromOffset(520, 0), AutomaticSize = Enum.AutomaticSize.Y })
	HudKit.make("UIListLayout", panel, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center })
	HudKit.make("UIPadding", panel, { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) })
	HudKit.label(panel, "WHAT DEATH TAKES", 22, T.TitleFont, T.Gold, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 26) })
	HudKit.label(panel, Rules.Stakes, 17, T.BodyFont, T.Ivory, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true })
	local ok = UiKit.button(panel, "Understood", "Primary", function() panel:Destroy() end)
	ok.LayoutOrder, ok.Size = 3, UDim2.fromOffset(180, 36)
	task.delay(20, function() if panel.Parent then panel:Destroy() end end)
	self.StakesPanel = panel
end

function Controller.Update(self: any, dt: number)
	local player = Players.LocalPlayer
	local done = Rules.parse(player:GetAttribute("AsuraTutorial"))
	local step = Rules.current(done)
	local own = self.State:Own()
	local root = own and own.Root
	local ui = self.Ui
	-- Any open window (Arsenal, Codex, Respite) owns the screen; the card sat beside the Arsenal (F05).
	local hidden = ui.PrologueActive or ui.DialogueOpen or ui.DeathShown or (ui.Altar and ui.Altar.Visible) or (ui.Input and ui.Input.MenuOpen)
	if root and not self.StakesShown and root.Position.Z &lt; COURTYARD_Z and root.Position.Z &gt; -900 and math.abs(root.Position.X) &lt; 90
		and root.Position.Y &lt; 100 and string.find(tostring(player:GetAttribute("AsuraAltars") or ""), "Cloister", 1, true) == nil then
		self:Stakes()
	end
	-- F08: the cursor is captured in play, so the card also folds once the fight starts (any combat state).
	local snapshot = self.State:OwnSnapshot()
	if self.StakesPanel and self.StakesPanel.Parent and snapshot and snapshot.State ~= "Idle" then self.StakesPanel:Destroy() end
	self.Card.Visible = step ~= nil and root ~= nil and not hidden and (root.Position - HOME).Magnitude &lt;= Controller.ShowRadius
	if not step then return end
	local count = 0
	for _, s in Rules.Steps do if done[s.Id] then count += 1 end end
	self.Header.Text = string.format("TRAINING  ·  %d / %d", count + 1, #Rules.Steps)
	self.Title.Text = step.Title
	self.Do.Text = Rules.text(step.Do, function(c: string) return self:Label(c) end)
	self.Why.Text = step.Why
	-- F08: the cursor is captured in play, so a mouse player could not click Skip without knowing Alt.
	if not self.Armed then
		self.Skip.Text = if self.Input.Device == "Keyboard" then "Skip training  ·  hold [" .. self:Label("Cursor") .. "] to click" else "Skip training"
	end
	-- Client-only proofs, each reported once per step.
	if step.Id == "LockOn" and self.Camera.Locked and not self.Sent.LockOn then
		local target = self.State:Get(self.Camera.Locked)
		if target and self.State:IsHostile(target) then self.Sent.LockOn = true; self.Remote:FireServer({ action = "Signal", signal = "LockOn" }) end
	elseif step.Id == "Glide" and not self.Sent.Glide then
		self.Glide = if self.Movement.State == "Gliding" then self.Glide + dt else 0
		if self.Glide &gt;= Rules.GlideSeconds then self.Sent.Glide = true; self.Remote:FireServer({ action = "Signal", signal = "Glide" }) end
	end
end

function Controller.Destroy(self: any)
	for _, d in self.Links do d() end
	self.Card:Destroy()
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="732">
            <Properties>
              <string name="Name">UiKit</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/UiKit
-- Interactive layer over HudKit: the menu theme, motion timings, SFX hooks and themed buttons
-- (Primary / Secondary / Danger / Ghost) with hover-lift, press-compress and stroke-glow tweens.
-- Gamepad selection mirrors hover. A Bin collects connections so owners can clean up in one call.
local TweenService = game:GetService("TweenService")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)

local UiKit = {}
local P = HudKit.Palette

-- Customization ------------------------------------------------------------------------------
UiKit.Theme = table.freeze({
	Ink = P.Ink, Ivory = P.Ivory, Muted = P.Muted, Gold = P.Gold, Ember = P.Ember, Edge = P.Edge,
	Surface = Color3.fromRGB(30, 13, 28), Raised = Color3.fromRGB(56, 24, 50),
	Primary = Color3.fromRGB(176, 52, 112), PrimaryHot = Color3.fromRGB(222, 96, 156),
	Secondary = Color3.fromRGB(40, 17, 36), SecondaryHot = Color3.fromRGB(74, 32, 66),
	Danger = Color3.fromRGB(70, 14, 14), DangerHot = Color3.fromRGB(110, 20, 20),
	Backdrop = Color3.fromRGB(10, 2, 10), BackdropAlpha = 0.4,
	TitleFont = HudKit.TitleFont, BodyFont = HudKit.BodyFont, Radius = 6,
})
UiKit.Motion = table.freeze({
	HoverScale = 1.05, PressScale = 0.95,
	Hover = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Press = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Open = TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Close = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
	OpenFrom = 0.9, SlidePixels = 18,
})
-- SFX hooks: replace Id with an uploaded rbxassetid:// to re-skin; set Id = "" to mute a cue.
UiKit.Sfx = {
	Hover = { Id = HudKit.Sounds.Tick, Volume = 0.12, Pitch = 1.6 },
	Click = { Id = HudKit.Sounds.Tick, Volume = 0.4, Pitch = 1.1 },
	Error = { Id = HudKit.Sounds.Tick, Volume = 0.45, Pitch = 0.55 },
	Open = { Id = HudKit.Sounds.Objective, Volume = 0.25, Pitch = 1.25 },
	Close = { Id = HudKit.Sounds.Tick, Volume = 0.3, Pitch = 0.8 },
}

export type Variant = "Primary" | "Secondary" | "Danger" | "Ghost"
export type Bin = { any }

function UiKit.play(kind: string)
	local cue = UiKit.Sfx[kind]
	if cue and cue.Id ~= "" then
		HudKit.cue(cue.Id, cue.Volume, cue.Pitch)
	end
end

-- Bins hold connections, instances or cleanup functions; clean empties and releases them all.
function UiKit.clean(bin: Bin)
	for _, item in bin do
		if typeof(item) == "RBXScriptConnection" then
			item:Disconnect()
		elseif typeof(item) == "Instance" then
			item:Destroy()
		elseif type(item) == "function" then
			item()
		end
	end
	table.clear(bin)
end

local SKIN: { [Variant]: { Base: Color3, Hot: Color3, Text: Color3, Stroke: Color3, Alpha: number } } = {
	Primary = { Base = UiKit.Theme.Primary, Hot = UiKit.Theme.PrimaryHot, Text = UiKit.Theme.Ivory, Stroke = UiKit.Theme.Gold, Alpha = 0 },
	Secondary = { Base = UiKit.Theme.Secondary, Hot = UiKit.Theme.SecondaryHot, Text = UiKit.Theme.Ivory, Stroke = UiKit.Theme.Edge, Alpha = 0.1 },
	Danger = { Base = UiKit.Theme.Danger, Hot = UiKit.Theme.DangerHot, Text = UiKit.Theme.Ivory, Stroke = UiKit.Theme.Edge, Alpha = 0.05 },
	Ghost = { Base = UiKit.Theme.Ink, Hot = UiKit.Theme.Raised, Text = UiKit.Theme.Muted, Stroke = UiKit.Theme.Edge, Alpha = 0.6 },
}

-- Disabled buttons stay visible (dimmed, no lift) and answer clicks with the Error cue.
function UiKit.setEnabled(button: TextButton, enabled: boolean)
	button:SetAttribute("UiDisabled", not enabled)
	button.TextTransparency = if enabled then 0 else 0.5
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = if enabled then 0.25 else 0.7
	end
end

function UiKit.button(parent: Instance, text: string, variant: Variant, onActivate: () -&gt; ()): TextButton
	local skin = SKIN[variant]
	local primary = variant == "Primary"
	local button = HudKit.make("TextButton", parent, {
		Name = text, Text = text, Font = if primary then UiKit.Theme.TitleFont else UiKit.Theme.BodyFont,
		TextSize = if primary then 20 else 19, TextColor3 = skin.Text, AutoButtonColor = false,
		BackgroundColor3 = skin.Base, BackgroundTransparency = skin.Alpha, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 44), Selectable = true, ClipsDescendants = false,
	}) :: TextButton
	HudKit.make("UICorner", button, { CornerRadius = UDim.new(0, UiKit.Theme.Radius) })
	local stroke = HudKit.make("UIStroke", button, {
		Color = skin.Stroke, Thickness = if primary then 1.5 else 1, Transparency = 0.25,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}) :: UIStroke
	HudKit.make("UIGradient", button, { -- lacquer sheen: lit top edge, darker foot
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 155)),
	})
	local scale = HudKit.make("UIScale", button, {}) :: UIScale
	local hovered = false

	local function settle(info: TweenInfo)
		local disabled = button:GetAttribute("UiDisabled") == true
		local lift = hovered and not disabled
		TweenService:Create(scale, info, { Scale = if lift then UiKit.Motion.HoverScale else 1 }):Play()
		TweenService:Create(button, info, { BackgroundColor3 = if lift then skin.Hot else skin.Base }):Play()
		TweenService:Create(stroke, info, {
			Transparency = if disabled then 0.7 elseif lift then 0 else 0.25,
			Thickness = (if primary then 1.5 else 1) + (if lift then 1 else 0),
		}):Play()
	end
	local function enter()
		if not hovered then
			hovered = true
			if button:GetAttribute("UiDisabled") ~= true then
				UiKit.play("Hover")
			end
			settle(UiKit.Motion.Hover)
		end
	end
	local function leave()
		hovered = false
		settle(UiKit.Motion.Hover)
	end
	-- Instance-owned connections die with the button, so callers never need to track them.
	button.MouseEnter:Connect(enter)
	button.SelectionGained:Connect(enter)
	button.MouseLeave:Connect(leave)
	button.SelectionLost:Connect(leave)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, UiKit.Motion.Press, { Scale = UiKit.Motion.PressScale }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		settle(UiKit.Motion.Hover)
	end)
	button.Activated:Connect(function()
		if button:GetAttribute("UiDisabled") == true then
			UiKit.play("Error")
			return
		end
		UiKit.play("Click")
		onActivate()
	end)
	return button
end

return table.freeze(UiKit)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="733">
            <Properties>
              <string name="Name">UiWindow</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/UiWindow
-- Shared modal shell for menus: dim backdrop, centred lacquer panel (CanvasGroup) with drop shadow,
-- calligraphic title, ember subtitle, gold hairline and a ghost close button. Sized in Scale and
-- clamped by UISizeConstraint + UIAspectRatioConstraint so it never stretches on phones or
-- ultrawides. Open springs in (scale + slide + group fade); close fades out, then hides Root.
local TweenService = game:GetService("TweenService")
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local UiKit = require(script.Parent:WaitForChild("UiKit") :: ModuleScript)

local Window = {}
local T = UiKit.Theme
local M = UiKit.Motion

export type Window = {
	Root: Frame, -- full-screen holder; Visible is the open/closed truth other systems watch
	Holder: Frame,
	Group: CanvasGroup,
	Shadow: Frame,
	Edge: UIStroke,
	Backdrop: Frame,
	Body: Frame,
	Title: TextLabel,
	Subtitle: TextLabel,
	Close: TextButton,
	Scale: UIScale,
	Serial: number,
}

function Window.new(gui: Instance, name: string, title: string, subtitle: string, maxSize: Vector2, onClose: () -&gt; ()): Window
	local root = HudKit.make("Frame", gui, {
		Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 30,
	}) :: Frame
	local backdrop = HudKit.make("Frame", root, {
		Name = "Backdrop", Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Backdrop,
		BackgroundTransparency = 1, BorderSizePixel = 0, Active = true,
	}) :: Frame
	local holder = HudKit.make("Frame", root, {
		Name = "Holder", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.86), BackgroundTransparency = 1,
	}) :: Frame
	HudKit.make("UISizeConstraint", holder, { MaxSize = maxSize, MinSize = Vector2.new(280, 220) })
	HudKit.make("UIAspectRatioConstraint", holder, { AspectRatio = maxSize.X / maxSize.Y })
	local scale = HudKit.make("UIScale", holder, {}) :: UIScale
	local shadow = HudKit.make("Frame", holder, {
		Name = "Shadow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 8),
		Size = UDim2.new(1, 18, 1, 18), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
	}) :: Frame
	HudKit.make("UICorner", shadow, { CornerRadius = UDim.new(0, T.Radius + 8) })
	local canvas = HudKit.make("CanvasGroup", holder, {
		Name = "Panel", Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Surface, BorderSizePixel = 0,
	}) :: CanvasGroup
	HudKit.make("UICorner", canvas, { CornerRadius = UDim.new(0, T.Radius + 2) })
	-- The stroke lives on the holder: a CanvasGroup would clip an outside border.
	HudKit.make("UICorner", holder, { CornerRadius = UDim.new(0, T.Radius + 2) })
	local edge = HudKit.make("UIStroke", holder, { Color = T.Edge, Thickness = 2, Transparency = 1 }) :: UIStroke
	local glow = HudKit.make("Frame", canvas, { -- ember glow bleeding up from the foot of the panel
		Name = "Glow", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.55),
		BackgroundColor3 = T.Ember, BorderSizePixel = 0,
	})
	HudKit.make("UIGradient", glow, {
		Rotation = 90, Transparency = NumberSequence.new(1, 0.9),
	})
	local group = HudKit.make("Frame", canvas, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }) :: Frame
	HudKit.make("UIPadding", group, {
		PaddingLeft = UDim.new(0, 22), PaddingRight = UDim.new(0, 22), PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16),
	})
	local titleLabel = HudKit.label(group, title, 32, T.TitleFont, T.Ivory, {
		Size = UDim2.new(1, -60, 0, 36), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local subtitleLabel = HudKit.label(group, subtitle, 15, T.TitleFont, T.Ember, {
		Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, -60, 0, 20), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local rule = HudKit.make("Frame", group, {
		Name = "Rule", Position = UDim2.fromOffset(0, 64), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.Gold, BorderSizePixel = 0,
	})
	HudKit.make("UIGradient", rule, {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.6, 0.6), NumberSequenceKeypoint.new(1, 1),
		}),
	})
	local close = UiKit.button(group, "✕", "Ghost", onClose)
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.fromScale(1, 0)
	close.Size = UDim2.fromOffset(40, 40)
	close.TextSize = 20
	local body = HudKit.make("Frame", group, {
		Name = "Body", Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 1, -78), BackgroundTransparency = 1,
	}) :: Frame
	return {
		Root = root, Holder = holder, Group = canvas, Edge = edge, Shadow = shadow, Backdrop = backdrop, Body = body,
		Title = titleLabel, Subtitle = subtitleLabel, Close = close, Scale = scale, Serial = 0,
	}
end

function Window.isOpen(w: Window): boolean
	return w.Root.Visible and w.Root:GetAttribute("UiClosing") ~= true
end

function Window.open(w: Window)
	w.Serial += 1
	w.Root:SetAttribute("UiClosing", false)
	w.Scale.Scale = M.OpenFrom
	w.Group.GroupTransparency = 1
	w.Holder.Position = UDim2.new(0.5, 0, 0.5, M.SlidePixels)
	w.Root.Visible = true
	UiKit.play("Open")
	TweenService:Create(w.Scale, M.Open, { Scale = 1 }):Play()
	TweenService:Create(w.Holder, M.Open, { Position = UDim2.fromScale(0.5, 0.5) }):Play()
	TweenService:Create(w.Group, M.Hover, { GroupTransparency = 0 }):Play()
	TweenService:Create(w.Shadow, M.Hover, { BackgroundTransparency = 0.55 }):Play()
	TweenService:Create(w.Edge, M.Hover, { Transparency = 0.1 }):Play()
	TweenService:Create(w.Backdrop, M.Hover, { BackgroundTransparency = T.BackdropAlpha }):Play()
end

-- Fades out, then hides Root; a re-open during the fade wins (Serial check).
function Window.close(w: Window, done: (() -&gt; ())?)
	if not w.Root.Visible then
		return
	end
	w.Serial += 1
	local serial = w.Serial
	w.Root:SetAttribute("UiClosing", true)
	UiKit.play("Close")
	TweenService:Create(w.Scale, M.Close, { Scale = M.OpenFrom }):Play()
	TweenService:Create(w.Shadow, M.Close, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(w.Edge, M.Close, { Transparency = 1 }):Play()
	TweenService:Create(w.Backdrop, M.Close, { BackgroundTransparency = 1 }):Play()
	local fade = TweenService:Create(w.Group, M.Close, { GroupTransparency = 1 })
	fade.Completed:Connect(function()
		if w.Serial == serial then
			w.Root:SetAttribute("UiClosing", false)
			w.Root.Visible = false
			if done then
				done()
			end
		end
	end)
	fade:Play()
end

return table.freeze(Window)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="734">
            <Properties>
              <string name="Name">VitalsTags</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/VitalsTags
-- Explains the three health layers on the vitals plate with shape, motion and short words, not
-- colour alone:
--   ↺ recoverable damage: during the Blood Rally window it pulses with a countdown ("strike back");
--     afterwards the flask restores it first.
--   ▼ lowered ceiling: a notch on the bar where max health currently stops, "rest restores".
-- Also captions the stamina bar. Values come straight from the snapshot; no combat math here.
local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)
local Sakura = require(script.Parent:WaitForChild("SakuraKit") :: ModuleScript)

local Tags = {}
local C = Sakura.Colors

-- Geometry inside the 470x150 vitals plate (matches InterfaceController.buildVitals).
Tags.Health = table.freeze({ X = 128, Y = 48, W = 300, H = 18 })
Tags.StatusY = 68
Tags.Stamina = table.freeze({ X = 404, Y = 83 })

export type View = { Notch: Frame, Rally: TextLabel, RallyScale: UIScale, Ceiling: TextLabel }

function Tags.build(frame: Frame): View
	local h = Tags.Health
	local notch = HudKit.make("Frame", frame, {
		Name = "CeilingNotch", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(h.X + h.W, h.Y + h.H / 2),
		Size = UDim2.fromOffset(3, h.H + 10), BackgroundColor3 = C.Ivory, BorderSizePixel = 0, ZIndex = 6, Visible = false,
	}) :: Frame
	Sakura.diamond(notch, 7, UDim2.fromScale(0.5, 0), C.Ivory, C.Ink)
	local rally = HudKit.label(frame, "", 13, Enum.Font.GothamBold, C.Gold, {
		Name = "RallyTag", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(h.X, Tags.StatusY + 6), Size = UDim2.fromOffset(170, 14),
		TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.3, Visible = false,
	})
	local rallyScale = HudKit.make("UIScale", rally, {}) :: UIScale
	local ceiling = HudKit.label(frame, "", 12, Enum.Font.GothamMedium, C.Ivory, {
		Name = "CeilingTag", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromOffset(h.X + h.W, Tags.StatusY + 6), Size = UDim2.fromOffset(150, 14),
		TextXAlignment = Enum.TextXAlignment.Right, TextStrokeTransparency = 0.3, Visible = false,
	})
	HudKit.label(frame, "STAMINA", 10, Enum.Font.GothamBold, C.Stamina, {
		Name = "StaminaCaption", Position = UDim2.fromOffset(Tags.Stamina.X, Tags.Stamina.Y), Size = UDim2.fromOffset(60, 14), TextXAlignment = Enum.TextXAlignment.Left,
	})
	return { Notch = notch, Rally = rally, RallyScale = rallyScale, Ceiling = ceiling }
end

-- Pure text rules (tested in tools/test_hud_layout.luau).
function Tags.texts(s: { MaxHP: number, ActiveHP: number, RecoverableHP: number, PermanentDeficit: number, RallyActive: boolean, RallyRemaining: number }): (string, string)
	local recoverable = math.floor(s.RecoverableHP + 0.5)
	local rally = ""
	if recoverable &gt; 0 then
		rally = if s.RallyActive then string.format("RALLY %.1fs · strike back", math.max(s.RallyRemaining, 0))
			else string.format("+%d recoverable · flask", recoverable)
	end
	local lost = math.floor(s.PermanentDeficit + 0.5)
	local ceiling = if lost &gt; 0 then string.format("▼ max −%d · rest restores", lost) else ""
	return rally, ceiling
end

function Tags.update(view: View, s: any, clock: number)
	local rally, ceiling = Tags.texts(s)
	view.Rally.Text, view.Rally.Visible = rally, rally ~= ""
	view.Rally.TextColor3 = if s.RallyActive then C.Gold else C.Stamina
	view.RallyScale.Scale = if s.RallyActive then 1 + 0.08 * math.abs(math.sin(clock * 6)) else 1
	view.Ceiling.Text, view.Ceiling.Visible = ceiling, ceiling ~= ""
	local maxHP = math.max(s.MaxHP, 1)
	local fraction = math.clamp((maxHP - s.PermanentDeficit) / maxHP, 0, 1)
	view.Notch.Visible = ceiling ~= ""
	view.Notch.Position = UDim2.fromOffset(Tags.Health.X + Tags.Health.W * fraction, Tags.Health.Y + Tags.Health.H / 2)
end

-- Flask charges as shapes: filled ◆ per charge, hollow ◇ per spent charge.
function Tags.flask(charges: number, maximum: number): string
	local total = math.max(maximum, charges)
	if total &lt;= 0 then return "FLASK —" end
	return "FLASK " .. string.rep("◆", charges) .. string.rep("◇", total - charges)
end

return table.freeze(Tags)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="735">
            <Properties>
              <string name="Name">VoidStage</string>
              <string name="Source">--!strict
-- Caster-only staging for the showcase cinematics: a flat Neon "void" box that hides the world
-- behind the shot, a Highlight that turns the caster into a
-- solid silhouette, a key light, and the colour grades the reference cuts between. The parts are
-- created on the caster's client only, never take queries, and leave with the cast's trove.
local Comfort = require(game:GetService("ReplicatedStorage").AsurasPath.Shared.EffectsPreference)
local Kit = require(script.Parent.SkillKit)
local Cinema = require(script.Parent.SkillCinema)
local Stage = {}

local rgb = Color3.fromRGB
Stage.Grades = table.freeze({
	TealVoid = { Brightness = -0.05, Contrast = 0.25, Saturation = -0.2, TintColor = rgb(170, 235, 240) },
	Duotone = { Brightness = -0.04, Contrast = 0.6, Saturation = -1, TintColor = rgb(255, 120, 62) },
	Ember = { Brightness = -0.2, Contrast = 0.55, Saturation = -0.3, TintColor = rgb(255, 170, 120) },
	Neutral = { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = rgb(255, 255, 255) },
	White = { Brightness = 1, Contrast = -0.2, Saturation = -1, TintColor = rgb(255, 255, 255) },
})

-- Hides every enabled HUD ScreenGui on this client; returns the restore (idempotent).
function Stage.hud(): () -&gt; ()
	local hidden: { ScreenGui } = {}
	local player = game:GetService("Players").LocalPlayer
	local gui = player and player:FindFirstChildOfClass("PlayerGui")
	for _, g in if gui then gui:GetChildren() else {} do
		if g:IsA("ScreenGui") and g.Enabled then table.insert(hidden, g); g.Enabled = false end
	end
	return function()
		for _, g in hidden do if g.Parent then g.Enabled = true end end
		table.clear(hidden)
	end
end

export type Void = { Walls: { BasePart }, Center: Vector3, Restore: () -&gt; () }

-- Hides everything already in the world (except `keep`) and every HUD ScreenGui on this client,
-- remembering what it changed. Effects created afterwards are untouched. Returns the restore.
local function blackout(keep: { Instance }): () -&gt; ()
	local parts: { [Instance]: number } = {}
	local toggles: { [Instance]: boolean } = {}
	local function kept(d: Instance): boolean
		for _, k in keep do if d == k or d:IsDescendantOf(k) then return true end end
		return false
	end
	for _, d in game:GetService("Workspace"):GetDescendants() do
		if (d:IsA("BasePart") or d:IsA("Decal")) and not kept(d) and (d :: any).Transparency &lt; 1 then
			parts[d] = (d :: any).Transparency;
			(d :: any).Transparency = 1 -- a client-side write: never replicates, restored afterwards
		elseif (d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light") or d:IsA("LayerCollector")) and not kept(d) and (d :: any).Enabled then
			toggles[d] = true;
			(d :: any).Enabled = false
		end
	end
	-- Distance haze would tint the void walls with the biome's sky; terrain water cannot take a
	-- transparency write. Both are client-local property writes, restored with everything else.
	local props: { { any } } = {}
	local function set(inst: Instance, prop: string, value: any)
		table.insert(props, { inst, prop, (inst :: any)[prop] });
		(inst :: any)[prop] = value
	end
	for _, a in game:GetService("Lighting"):GetChildren() do
		if a:IsA("Atmosphere") then set(a, "Density", 0); set(a, "Haze", 0); set(a, "Glare", 0) end
	end
	local terrain = game:GetService("Workspace").Terrain
	set(terrain, "WaterTransparency", 1); set(terrain, "WaterReflectance", 0); set(terrain, "WaterWaveSize", 0)
	local hud = Stage.hud()
	return function()
		hud()
		for d, value in parts do if d.Parent then (d :: any).Transparency = value end end
		for d in toggles do if d.Parent then (d :: any).Enabled = true end end
		for _, p in props do (p[1] :: any)[p[2]] = p[3] end
		table.clear(props)
		table.clear(parts)
		table.clear(toggles)
	end
end

-- A hollow box of thin Neon walls `half` studs out around `center`, floored `down` studs below it and
-- roofed `up` above, with the world and HUD hidden on this client so only the caster (and `keep`)
-- remain. The floor also covers terrain, which cannot be hidden.
function Stage.void(trove: Kit.Trove, center: Vector3, half: number, down: number, up: number, color: Color3, keep: { Instance }): Void
	local unhide = blackout(keep)
	Cinema.clipping(false) -- the hidden world still blocks rays; shots must not dodge invisible walls
	local function restore()
		unhide()
		Cinema.clipping(true)
	end
	Kit.add(trove, restore)
	local folder = Kit.folder(trove, "SkillVoid")
	local walls: { BasePart } = {}
	local height = up + down
	local mid = center + Vector3.new(0, (up - down) / 2, 0)
	local spec = {
		{ Vector3.new(half * 2, height, 1), Vector3.new(0, 0, half) }, { Vector3.new(half * 2, height, 1), Vector3.new(0, 0, -half) },
		{ Vector3.new(1, height, half * 2), Vector3.new(half, 0, 0) }, { Vector3.new(1, height, half * 2), Vector3.new(-half, 0, 0) },
		{ Vector3.new(half * 2, 1, half * 2), Vector3.new(0, height / 2 + 0.5, 0) }, { Vector3.new(half * 2, 1, half * 2), Vector3.new(0, -height / 2 - 0.5, 0) },
	}
	for _, s in spec do
		local wall = Kit.part(folder, "VoidWall", color, s[1], CFrame.new(mid + s[2]))
		-- Neon renders one flat colour per wall, so the box never shows its corners (matte shades per face).
		-- Below about 60 in its brightest channel Neon crushes to black: pick void colours above that.
		table.insert(walls, wall)
	end
	return { Walls = walls, Center = center, Restore = restore }
end

function Stage.tint(trove: Kit.Trove, void: Void, color: Color3, seconds: number)
	for _, w in void.Walls do Kit.tween(trove, w, seconds, { Color = color }) end
end

function Stage.remove(void: Void?)
	if void then
		void.Restore()
		for _, w in void.Walls do w:Destroy() end
	end
end

-- A soft bloom pass on this client for the cast (the reference's glowing whites).
function Stage.bloom(trove: Kit.Trove, intensity: number, size: number, threshold: number, seconds: number): BloomEffect
	local b = Kit.add(trove, Instance.new("BloomEffect"))
	b.Name, b.Intensity, b.Size, b.Threshold = "AsuraSkillBloom", 0, size, threshold
	b.Parent = game:GetService("Lighting")
	Kit.tween(trove, b, seconds, { Intensity = Comfort.flash(intensity) }) -- F09: honours reduced flashes
	return b
end

-- The caster drawn as a flat silhouette (black for the blazing-eye close-up).
function Stage.silhouette(trove: Kit.Trove, model: Model, color: Color3): Highlight
	local h = Kit.add(trove, Instance.new("Highlight"))
	h.FillColor, h.FillTransparency, h.OutlineTransparency = color, 0, 1
	h.DepthMode, h.Adornee, h.Parent = Enum.HighlightDepthMode.Occluded, model, model
	return h
end

-- A coloured key light on the caster so they read against a dark void.
function Stage.key(trove: Kit.Trove, root: BasePart, color: Color3, brightness: number): PointLight
	local a = Kit.attach(trove, root, Vector3.new(0, 1, -3), "SkillKeyLight")
	return Kit.light(a, color, 16, brightness)
end

return table.freeze(Stage)
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="736">
            <Properties>
              <string name="Name">WagerController</string>
              <string name="Source">--!strict
local Players=game:GetService("Players")
local View=require(script.Parent.DialogueView)
local Definitions=require(game:GetService("ReplicatedStorage").AsurasPath.Shared.WorldDefinitions)
local Controller={};Controller.__index=Controller
function Controller.new(ui: any): any
 local self=setmetatable({Ui=ui,Open=false,View=View.new(Players.LocalPlayer:WaitForChild("PlayerGui")),Links={}},Controller) :: any
 self.Remote=game:GetService("ReplicatedStorage").AsurasPath.Net.WagerIntent
 self.View.Gui.Name="SpectatorWagers";self.View.Gui.DisplayOrder=80
 table.insert(self.Links,self.View.Close.Activated:Connect(function() self:Close() end))
 table.insert(self.Links,self.Remote.OnClientEvent:Connect(function(p: any)
  if p.action=="Settlement" then
   ui:ShowToast((if p.refund then "Wager returned · " else "Wager settled · ")..p.payout.." Qi")
   if self.Open then self.Remote:FireServer({action="Refresh"}) end
   return
  end
  if p.action~="Panel" then return end
  View.clear(self.View);self.View.Gui.Enabled=true;self.Open=true;ui:CloseAltar();ui.Input:SetMenu(true,"Wager")
  self.View.Title.Text="COLOSSEUM BALCONY · "..p.qi.." Qi"
  self.View.Subtitle.MaxVisibleGraphemes=-1
  self.View.Subtitle.Text=p.message or "Wager 50–500 Qi before the opening bell. Winners receive 1.8× their stake; a draw or cancelled duel refunds it."
  View.button(self.View,"Refresh active duels",function() self.Remote:FireServer({action="Refresh"}) end)
  if #p.matches==0 then View.button(self.View,"No active duels · challenge a fighter below",function() end) end
  for _,m in p.matches do
   for _,fighter in {{Id=m.a,Name=m.an},{Id=m.b,Name=m.bn}} do
    for _,amount in {50,100,250,500} do
     View.button(self.View,(if m.open then "Wager "..amount.." Qi · " else "Bell sounded · ")..fighter.Name,function()
      if m.open then self.Remote:FireServer({action="Wager",match=m.id,fighter=fighter.Id,amount=amount}) end
     end)
    end
   end
  end
 end))
 return self
end
function Controller.Close(self: any)
 if self.Open then self.Ui.Input:SetMenu(false,"Wager") end
 self.Open=false;self.View.Gui.Enabled=false
end
function Controller.Update(self: any)
 if not self.Open then return end
 local character=Players.LocalPlayer.Character
 local root=character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
 local c=Definitions.Sanctuary.Promenade
 if not root or math.abs(root.Position.X-c.X-30)&gt;12 or math.abs(root.Position.Z-c.Z)&gt;20 or root.Position.Y&lt;c.Y+11 then self:Close() end
end
function Controller.Destroy(self: any)
 self:Close()
 for _,c in self.Links do c:Disconnect() end;View.clear(self.View);self.View.Gui:Destroy()
end
return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="737">
            <Properties>
              <string name="Name">WaypointMarker</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/WaypointMarker
-- On-screen gold diamond + distance that floats over the current objective target. Resolves
-- objective targets (altar id, Sanctuary portal, raw point) to world positions. Presentation only.
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")

local HudKit = require(script.Parent:WaitForChild("HudKit") :: ModuleScript)

local ARRIVE_DISTANCE = 14
local ALTAR_TAG = "AsuraAltar"

local Marker = {}
Marker.__index = Marker

export type WaypointMarker = typeof(setmetatable({} :: {
	Anchor: Attachment,
	Gui: BillboardGui,
	Text: TextLabel,
	Portal: BasePart?,
}, Marker))

function Marker.new(parent: Instance): WaypointMarker
	local anchor = Instance.new("Attachment")
	anchor.Name = "AsuraObjectiveAnchor"
	anchor.Parent = Workspace.Terrain
	local gui = HudKit.make("BillboardGui", parent, { Name = "ObjectiveMarker", Adornee = anchor, AlwaysOnTop = true, LightInfluence = 0, Size = UDim2.fromOffset(240, 54), StudsOffset = Vector3.new(0, 4, 0), Enabled = false }) :: BillboardGui
	HudKit.label(gui, "◆", 26, HudKit.TitleFont, HudKit.Palette.Gold, { Size = UDim2.new(1, 0, 0, 30), TextStrokeTransparency = 0.2 })
	local text = HudKit.label(gui, "", 14, Enum.Font.GothamMedium, HudKit.Palette.Ivory, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 20), TextStrokeTransparency = 0.3 })
	return setmetatable({ Anchor = anchor, Gui = gui, Text = text, Portal = nil }, Marker)
end

function Marker.Locate(self: WaypointMarker, target: any): Vector3?
	if target == nil then
		return nil
	elseif target.Kind == "Point" then
		return target.Position
	elseif target.Kind == "Altar" then
		-- Authored altars tag a BasePart anchor; greybox altars tag their Model.
		for _, tagged in CollectionService:GetTagged(ALTAR_TAG) do
			if tagged:GetAttribute("AltarId") == target.Id then
				if tagged:IsA("BasePart") then
					return tagged.Position
				elseif tagged:IsA("Model") then
					return tagged:GetPivot().Position
				end
			end
		end
		return nil
	end
	local portal = self.Portal
	if portal == nil or not portal:IsDescendantOf(Workspace) then
		local found = Workspace:FindFirstChild("PortalTrigger", true)
		portal = if found and found:IsA("BasePart") then found else nil
		self.Portal = portal
	end
	return if portal then portal.Position else nil
end

-- Points the marker at `goal` and returns the distance in studs (nil when there is no goal). A
-- staged route step names itself ("Bridge · 64m") and reports the walked distance to the goal.
function Marker.Point(self: WaypointMarker, goal: Vector3?, from: Vector3?, suppressed: boolean, label: string?, walked: number?): number?
	if goal == nil or from == nil then
		self.Gui.Enabled = false
		return nil
	end
	local near = math.floor((goal - from).Magnitude)
	local meters = if walked then math.floor(walked) else near
	self.Anchor.WorldPosition = goal
	self.Text.Text = if label then string.format("%s · %dm", label, meters) else string.format("%dm", meters)
	self.Gui.Enabled = near &gt; ARRIVE_DISTANCE and not suppressed
	return meters
end

function Marker.Destroy(self: WaypointMarker)
	self.Gui:Destroy()
	self.Anchor:Destroy()
end

return Marker
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="738">
            <Properties>
              <string name="Name">WeaponTrails</string>
              <string name="Source">--!strict
-- Weapon arcs (post-F26 step 2). Every swing in view draws the path the server actually swept: the
-- server publishes each committed strike as the model attribute AsuraStrike (StrikeGeometry arc,
-- reach, lunge and yaw), and this ribbon is built from those numbers rather than the animated blade,
-- so an arc that misses a body really missed it. Player, enemy and boss-look swings alike. A tier-1
-- gameplay cue: shaped by the move (a narrow thrust line, a swept slash fan) so it reads in grayscale
-- and with reduced effects, and gone before the next swing can start.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")
local Shared = game:GetService("ReplicatedStorage").AsurasPath
local Assets = require(Shared.Shared.PresentationAssets)
local Strike = require(Shared.Simulation.StrikeGeometry)
local Controller = {}
Controller.__index = Controller
local COLORS = { CalamityBoneCleaver=Color3.fromRGB(215,33,27), HeavenPiercingGuandao=Color3.fromRGB(74,222,255),
	TwinShadowSai=Color3.fromRGB(139,66,221), JadeCatalyst=Color3.fromRGB(83,241,208) }
local DEFAULT_COLOR = Color3.fromRGB(237, 192, 118)
local SAMPLES = 8
local FADE = 0.15 -- shorter than any recovery, so a fading arc never reads as the next attack
local RANGE = 80
local STALE = 0.5 -- records older than this (late replication, streaming in) are not drawn

local function beam(carrier: BasePart, a: Attachment, b: Attachment, color: Color3, width: number)
	local item = Instance.new("Beam")
	item.Attachment0, item.Attachment1, item.FaceCamera, item.Segments = a, b, true, 1
	item.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	item.Transparency = NumberSequence.new(0.1, 0.35)
	item.LightEmission, item.Width0, item.Width1 = 0.6, width, width
	item.Parent = carrier
	TweenService:Create(item, TweenInfo.new(FADE), { Width0 = 0, Width1 = 0 }):Play()
end

local function node(carrier: BasePart, x: number, z: number): Attachment
	local a = Instance.new("Attachment")
	a.Position = Vector3.new(x, 0.6, z)
	a.Parent = carrier
	return a
end

-- Builds the swept shape for one strike around `root`, at the committed yaw.
local function draw(folder: Instance, root: BasePart, strike: Strike.Strike)
	local carrier = Instance.new("Part")
	carrier.Name, carrier.Anchored, carrier.Transparency, carrier.Size = "StrikeArc", true, 1, Vector3.one * 0.2
	carrier.CanCollide, carrier.CanQuery, carrier.CanTouch, carrier.CastShadow = false, false, false, false
	carrier.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, strike.Yaw, 0)
	local color = (COLORS :: any)[strike.Weapon] or DEFAULT_COLOR
	local shape = { Arc = strike.Arc, Reach = strike.Reach, Lunge = strike.Lunge }
	if strike.Arc &gt; Strike.SlashArc then
		-- Slash: the outer edge of the fan plus its two radial edges.
		local tips = Strike.sweep(shape, 0, SAMPLES)
		local hx, _, hz = Strike.segment(shape, 0, 0)
		local ex, _, ez = Strike.segment(shape, 1, 0)
		local previous = node(carrier, tips[1][1], tips[1][2])
		beam(carrier, node(carrier, hx, hz), previous, color, 0.08)
		for i = 2, #tips do
			local current = node(carrier, tips[i][1], tips[i][2])
			beam(carrier, previous, current, color, 0.32)
			previous = current
		end
		beam(carrier, node(carrier, ex, ez), previous, color, 0.08)
	else
		-- Thrust: one line from the hilt to full extension.
		local ax, _, az, bx, _, bz = Strike.segment(shape, 1, 0)
		beam(carrier, node(carrier, ax, az), node(carrier, bx, bz), color, 0.3)
	end
	carrier.Parent = folder
	Debris:AddItem(carrier, FADE + 0.05)
end

function Controller.new(state: any): any
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "AsuraStrikeArcs", Workspace
	return setmetatable({ State = state, Folder = folder, Seen = {} :: { [number]: string }, Tick = 0 }, Controller)
end

function Controller.Update(self: any, dt: number)
	self.Tick += dt
	if self.Tick &lt; 1 / 30 then
		return
	end
	self.Tick = 0
	local own = self.State:Own()
	if not own or not own.Root then
		return
	end
	local now, admitted = Workspace:GetServerTimeNow(), 0
	for id in self.Seen do
		if not self.State:Get(id) then
			self.Seen[id] = nil
		end
	end
	for id, e in self.State.Entities do
		local root = e.Root
		if not root or (own.Root.Position - root.Position).Magnitude &gt; RANGE then
			continue
		end
		admitted += 1
		if admitted &gt; Assets.Limits.TrailActors then
			break
		end
		local record = e.Model:GetAttribute("AsuraStrike")
		if type(record) == "string" and record ~= self.Seen[id] then
			self.Seen[id] = record
			local strike = Strike.decode(record)
			if strike and now - (strike.Start + strike.Active) &lt; STALE then
				draw(self.Folder, root, strike)
			end
		end
	end
end

function Controller.Destroy(self: any)
	self.Folder:Destroy()
	table.clear(self.Seen)
end

return Controller
</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="739">
            <Properties>
              <string name="Name">WorldStateController</string>
              <string name="Source">--!strict
-- ModuleScript: StarterPlayer/StarterPlayerScripts/AsurasPath/Controllers/WorldStateController
-- Client mirror of the authoritative combat world: decodes every fighter's replicated AsuraState
-- record, relays the server event/cue stream to presentation controllers, and executes the local
-- player's server-granted dash displacement (the client owns its character assembly).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath")
local Combat = require(Shared:WaitForChild("Simulation"):WaitForChild("CombatRules") :: ModuleScript)

export type Snapshot = Combat.Snapshot

export type Entity = {
	Id: number,
	Model: Model,
	Humanoid: Humanoid?,
	Root: BasePart?,
	Kind: string,
	Boss: boolean,
	Name: string,
	Snapshot: Snapshot?,
	Previous: Snapshot?,
	UpdatedAt: number,
	Connections: { RBXScriptConnection },
}

export type CombatEvent = {
	Kind: string,
	Source: number,
	Target: number,
	Value: number,
	Region: string?,
	Point: Vector3?,
	Time: number,
}

export type Cue = { Kind: string, Source: number, Data: { [string]: any }, Time: number }

type EventListener = (event: CombatEvent) -&gt; ()
type CueListener = (cue: Cue) -&gt; ()
type EntityListener = (entity: Entity) -&gt; ()

local Controller = {}
Controller.__index = Controller

type Fields = {
	Player: Player,
	LocalId: number,
	Entities: { [number]: Entity },
	ByModel: { [Model]: Entity },
	EventListeners: { EventListener },
	CueListeners: { CueListener },
	AddedListeners: { EntityListener },
	RemovedListeners: { EntityListener },
	Connections: { RBXScriptConnection },
	Pending: { [Model]: RBXScriptConnection }, -- models waiting for their AsuraId (batch 26: no unbounded list)
	DashSeq: number,
	DashEnds: number,
	DashVelocity: Vector3,
	DashDrive: LinearVelocity?,
	DashFrom: Vector3,
	DashLength: number,
}

export type WorldState = typeof(setmetatable({} :: Fields, Controller))

local PROTOCOL_TAG = "Asura1"
local ENEMY_TAG = "AsuraEnemy"

local function fire&lt;T&gt;(list: { (T) -&gt; () }, value: T)
	for _, listener in table.clone(list) do
		local ok, problem = pcall(listener, value)
		if not ok then
			warn("[WorldState] Listener failed: " .. tostring(problem))
		end
	end
end

local function subscribe&lt;T&gt;(list: { T }, listener: T): () -&gt; ()
	table.insert(list, listener)
	return function()
		local index = table.find(list, listener)
		if index then
			table.remove(list, index)
		end
	end
end

function Controller.new(net: Instance): WorldState
	local player = Players.LocalPlayer
	local fields: Fields = {
		Player = player,
		LocalId = player.UserId,
		Entities = {},
		ByModel = {},
		EventListeners = {},
		CueListeners = {},
		AddedListeners = {},
		RemovedListeners = {},
		Connections = {},
		DashSeq = -1,
		DashEnds = 0,
		DashVelocity = Vector3.zero,
		DashDrive = nil,
		DashFrom = Vector3.zero,
		DashLength = 0,
		Pending = setmetatable({}, { __mode = "k" }) :: any,
	}
	local self = setmetatable(fields, Controller)

	local remote = net:WaitForChild("StateSnapshots") :: RemoteEvent
	table.insert(self.Connections, remote.OnClientEvent:Connect(function(payload: any)
		self:Receive(payload)
	end))

	local function watchCharacter(other: Player)
		if other.Character then
			self:Track(other.Character)
		end
		table.insert(self.Connections, other.CharacterAdded:Connect(function(model: Model)
			self:Track(model)
		end))
	end
	for _, other in Players:GetPlayers() do
		watchCharacter(other)
	end
	table.insert(self.Connections, Players.PlayerAdded:Connect(watchCharacter))

	local function watchFolder(folder: Instance)
		for _, child in folder:GetChildren() do
			if child:IsA("Model") then
				self:Track(child)
			end
		end
		table.insert(self.Connections, folder.ChildAdded:Connect(function(child: Instance)
			if child:IsA("Model") then
				self:Track(child)
			end
		end))
	end
	task.spawn(function()
		local root = Workspace:WaitForChild("AsurasPath", 30)
		local entities = root and root:WaitForChild("Entities", 30)
		if entities then
			watchFolder(entities)
		end
	end)
	for _, tagged in CollectionService:GetTagged(ENEMY_TAG) do
		if tagged:IsA("Model") then
			self:Track(tagged)
		end
	end
	table.insert(self.Connections, CollectionService:GetInstanceAddedSignal(ENEMY_TAG):Connect(function(tagged: Instance)
		if tagged:IsA("Model") then
			self:Track(tagged)
		end
	end))
	return self
end

function Controller.Track(self: WorldState, model: Model)
	if self.ByModel[model] then
		return
	end
	local id = model:GetAttribute("AsuraId")
	if type(id) ~= "number" then
		if self.Pending[model] then
			return
		end
		-- One waiter per model, dropped once the id arrives (or with the model): every enemy respawn
		-- used to append a spent connection to self.Connections for the rest of the session.
		self.Pending[model] = model:GetAttributeChangedSignal("AsuraId"):Connect(function()
			local waiting = self.Pending[model]
			self.Pending[model] = nil
			if waiting then
				waiting:Disconnect()
			end
			self:Track(model)
		end)
		return
	end
	local previous = self.Entities[id]
	if previous then
		self:Untrack(previous)
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	local entity: Entity = {
		Id = id,
		Model = model,
		Humanoid = humanoid,
		Root = if root and root:IsA("BasePart") then root else nil,
		Kind = tostring(model:GetAttribute("AsuraKind") or "Enemy"),
		Boss = model:GetAttribute("AsuraBoss") == true,
		Name = if humanoid and humanoid.DisplayName ~= "" then humanoid.DisplayName else model.Name,
		Snapshot = nil,
		Previous = nil,
		UpdatedAt = 0,
		Connections = {},
	}
	self.Entities[id] = entity
	self.ByModel[model] = entity
	local function decode()
		local text = model:GetAttribute("AsuraState")
		if type(text) == "string" then
			local snapshot = Combat.unpackString(text)
			if snapshot then
				entity.Previous = entity.Snapshot
				entity.Snapshot = snapshot
				entity.UpdatedAt = os.clock()
			end
		end
	end
	decode()
	table.insert(entity.Connections, model:GetAttributeChangedSignal("AsuraState"):Connect(decode))
	table.insert(entity.Connections, model:GetAttributeChangedSignal("AsuraBoss"):Connect(function()
		entity.Boss = model:GetAttribute("AsuraBoss") == true
	end))
	table.insert(entity.Connections, model.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Humanoid") then
			entity.Humanoid = child
		elseif child.Name == "HumanoidRootPart" and child:IsA("BasePart") then
			entity.Root = child
		end
	end))
	table.insert(entity.Connections, model.AncestryChanged:Connect(function(_, parent: Instance?)
		if parent == nil then
			self:Untrack(entity)
		end
	end))
	fire(self.AddedListeners, entity)
end

function Controller.Untrack(self: WorldState, entity: Entity)
	if self.Entities[entity.Id] ~= entity then
		return
	end
	for _, connection in entity.Connections do
		connection:Disconnect()
	end
	table.clear(entity.Connections)
	self.Entities[entity.Id] = nil
	self.ByModel[entity.Model] = nil
	fire(self.RemovedListeners, entity)
end

function Controller.Receive(self: WorldState, payload: any)
	if type(payload) ~= "table" or payload.v ~= PROTOCOL_TAG then
		return
	end
	local time = if type(payload.t) == "number" then payload.t else Workspace:GetServerTimeNow()
	if type(payload.cue) == "string" then
		fire(self.CueListeners, {
			Kind = payload.cue,
			Source = if type(payload.s) == "number" then payload.s else 0,
			Data = if type(payload.d) == "table" then payload.d else {},
			Time = time,
		} :: Cue)
		return
	end
	if type(payload.e) ~= "table" then
		return
	end
	for _, item in payload.e do
		if type(item) == "table" and type(item.k) == "number" then
			local kind = Combat.EventNames[item.k]
			if kind then
				fire(self.EventListeners, {
					Kind = kind,
					Source = if type(item.s) == "number" then item.s else 0,
					Target = if type(item.t) == "number" then item.t else 0,
					Value = if type(item.v) == "number" then item.v else 0,
					Region = if type(item.r) == "string" then item.r else nil,
					Point = if typeof(item.p) == "Vector3" then item.p else nil,
					Time = time,
				} :: CombatEvent)
			end
		end
	end
end

function Controller.Get(self: WorldState, id: number): Entity?
	local entity = self.Entities[id]
	if entity and entity.Model.Parent then
		return entity
	end
	return nil
end

function Controller.Own(self: WorldState): Entity?
	return self:Get(self.LocalId)
end

function Controller.OwnSnapshot(self: WorldState): Snapshot?
	local own = self:Own()
	return if own then own.Snapshot else nil
end

function Controller.IsAlive(_self: WorldState, entity: Entity): boolean
	local snapshot = entity.Snapshot
	-- A dissolving enemy (server-pinned corpse) is dead at once, even before its KO snapshot arrives,
	-- so plates, lock-on and minimap dots drop the moment it falls. F07: so is the victim of a killing
	-- deathblow, whose KO waits out the 1.6 s execution (its plate sat at 0 HP until then).
	local executed = snapshot ~= nil and snapshot.State == "DeathblowVictim" and snapshot.ActiveHP &lt;= 0
	return entity.Model.Parent ~= nil and entity.Root ~= nil and (snapshot == nil or snapshot.State ~= "KO") and not executed
		and entity.Model:GetAttribute("AsuraDissolve") == nil
end

function Controller.IsHostile(self: WorldState, entity: Entity): boolean
	if entity.Id == self.LocalId then
		return false
	end
	local own = self:Own()
	local duel = entity.Model:GetAttribute("AsuraDuel")
	local ownDuel = if own then own.Model:GetAttribute("AsuraDuel") else nil
	if type(duel) == "string" or type(ownDuel) == "string" then
		return duel == ownDuel
	end
	if entity.Kind == "Enemy" then
		return true
	end
	return Workspace:GetAttribute("AsuraOpenPvP") == true
end

function Controller.OnEvent(self: WorldState, listener: EventListener): () -&gt; ()
	return subscribe(self.EventListeners, listener)
end

function Controller.OnCue(self: WorldState, listener: CueListener): () -&gt; ()
	return subscribe(self.CueListeners, listener)
end

function Controller.OnEntityAdded(self: WorldState, listener: EntityListener): () -&gt; ()
	return subscribe(self.AddedListeners, listener)
end

function Controller.OnEntityRemoved(self: WorldState, listener: EntityListener): () -&gt; ()
	return subscribe(self.RemovedListeners, listener)
end

-- Horizontal-plane LinearVelocity on the owned root. A per-frame velocity write lost most of the
-- dash to the humanoid's braking (WalkSpeed is 0 while Dashing): a 14-stud dash covered ~6 studs in
-- Studio (post-F26 step 2). The constraint holds the granted speed every physics step; gravity stays free.
local function dashDrive(self: WorldState, root: BasePart): LinearVelocity
	local drive = self.DashDrive
	if drive and drive.Parent == root then
		return drive
	end
	local attachment = root:FindFirstChild("RootAttachment")
	if not attachment or not attachment:IsA("Attachment") then
		attachment = Instance.new("Attachment")
		attachment.Name = "AsuraDashAttachment"
		attachment.Parent = root
	end
	local made = Instance.new("LinearVelocity")
	made.Name = "AsuraDashDrive"
	made.Attachment0 = attachment :: Attachment
	made.RelativeTo = Enum.ActuatorRelativeTo.World
	made.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	made.PrimaryTangentAxis = Vector3.xAxis
	made.SecondaryTangentAxis = Vector3.zAxis
	made.MaxForce = 1e7
	made.Enabled = false
	made.Parent = root
	self.DashDrive = made
	return made
end

-- Executes the server's dash grant on the locally owned root for the granted duration.
function Controller.Step(self: WorldState, dt: number)
	local own = self:Own()
	local snapshot = own and own.Snapshot
	local root = own and own.Root
	if not own or not snapshot or not root then
		return
	end
	if snapshot.DashSeq ~= self.DashSeq then
		local first = self.DashSeq &lt; 0
		self.DashSeq = snapshot.DashSeq
		if not first and snapshot.State == "Dashing" and snapshot.DashDuration &gt; 0 then
			local direction = Vector3.new(snapshot.DashDirX, 0, snapshot.DashDirZ)
			if direction.Magnitude &lt; 1e-3 then
				local look = root.CFrame.LookVector
				direction = -Vector3.new(look.X, 0, look.Z).Unit
			end
			local remaining = math.max(snapshot.DashDuration - snapshot.StateElapsed, 0.05)
			self.DashVelocity = direction * (snapshot.DashDistance / snapshot.DashDuration)
			self.DashEnds = os.clock() + remaining
			self.DashFrom, self.DashLength = root.Position, snapshot.DashDistance * remaining / snapshot.DashDuration
		end
	end
	local drive = self.DashDrive
	if os.clock() &lt; self.DashEnds then
		if snapshot.State ~= "Dashing" and snapshot.State ~= "Idle" then
			self.DashEnds = 0
			if drive then
				drive.Enabled = false
			end
			return
		end
		-- Stop on the granted distance, not a frame boundary: at low frame rates the last frame is slowed
		-- so the dash lands on its length instead of overshooting by a frame of full speed.
		local moved = Vector3.new(root.Position.X - self.DashFrom.X, 0, root.Position.Z - self.DashFrom.Z).Magnitude
		local left = self.DashLength - moved
		local full = self.DashVelocity.Magnitude
		if left &lt;= 0.05 or full &lt; 1e-3 then
			self.DashEnds = 0
			if drive then
				drive.Enabled = false
			end
			return
		end
		local planar = self.DashVelocity * math.min(1, left / (full * math.max(dt, 1 / 240)))
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(planar.X, velocity.Y, planar.Z)
		drive = dashDrive(self, root)
		drive.PlaneVelocity = Vector2.new(planar.X, planar.Z)
		drive.Enabled = true
	elseif drive and drive.Enabled then
		drive.Enabled = false
	end
end

function Controller.Destroy(self: WorldState)
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	table.clear(self.Connections)
	for _, waiting in self.Pending do
		waiting:Disconnect()
	end
	table.clear(self.Pending)
	for _, entity in self.Entities do
		for _, connection in entity.Connections do
			connection:Disconnect()
		end
	end
	table.clear(self.Entities)
	table.clear(self.ByModel)
end

return Controller
</string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="LocalScript" referent="740">
        <Properties>
          <string name="Name">AsurasPathClient</string>
          <string name="Source">--!strict
-- LocalScript: StarterPlayer/StarterPlayerScripts/AsurasPathClient
-- Asura's Path master client entry. Mounts the replication mirror and the presentation stack in
-- dependency order (WorldState -&gt; Camera -&gt; Input -&gt; GameFeel -&gt; Interface -&gt; Colosseum), binds a
-- single render step after the camera, connects the server replication and account receivers, and
-- owns the outgoing ActionIntent sequence.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AsurasPath", 15)
assert(Shared, "AsurasPath shared folder did not replicate")
local Config = require(Shared:WaitForChild("Config") :: ModuleScript) :: any
local timeout: number = Config.Runtime.DependencyTimeoutSeconds
local parent = script.Parent
assert(parent, "Client bootstrap has no parent")
local root = parent:WaitForChild("AsurasPath", timeout)
assert(root, "Client controller folder did not replicate")
local controllers = root:WaitForChild("Controllers", timeout)
assert(controllers, "Client controllers did not replicate")

local WorldState = require(controllers:WaitForChild("WorldStateController", timeout) :: ModuleScript)
local Camera = require(controllers:WaitForChild("CameraController", timeout) :: ModuleScript)
local Input = require(controllers:WaitForChild("InputController", timeout) :: ModuleScript)
local Movement = require(controllers:WaitForChild("MovementController", timeout) :: ModuleScript)
local Environment = require(controllers:WaitForChild("EnvironmentController", timeout) :: ModuleScript)
local Soundscape = require(controllers:WaitForChild("SoundscapeController", timeout) :: ModuleScript)
local GameFeel = require(controllers:WaitForChild("GameFeelController", timeout) :: ModuleScript)
local Sanguine = require(controllers:WaitForChild("SanguineController", timeout) :: ModuleScript)
local Interface = require(controllers:WaitForChild("InterfaceController", timeout) :: ModuleScript)
local Colosseum = require(controllers:WaitForChild("ColosseumController", timeout) :: ModuleScript)
local Objective = require(controllers:WaitForChild("ObjectiveController", timeout) :: ModuleScript)
local ControlsCard = require(controllers:WaitForChild("ControlsCard", timeout) :: ModuleScript)
local SpellController = require(controllers:WaitForChild("SpellController", timeout) :: ModuleScript)
local Dialogue = require(controllers:WaitForChild("DialogueController", timeout) :: ModuleScript)
local Wagers = require(controllers:WaitForChild("WagerController", timeout) :: ModuleScript)
local Mastery = require(controllers:WaitForChild("MasteryEffects", timeout) :: ModuleScript)
local Prologue = require(controllers:WaitForChild("PrologueController", timeout) :: ModuleScript)
local EndingScene = require(controllers:WaitForChild("EndingController", timeout) :: ModuleScript)
local PauseMenu = require(controllers:WaitForChild("PauseMenu", timeout) :: ModuleScript)
local SakuraHud = require(controllers:WaitForChild("SakuraHud", timeout) :: ModuleScript)
local CoreGuiPolicy = require(controllers:WaitForChild("CoreGuiPolicy", timeout) :: ModuleScript)
local CombatHud = require(controllers:WaitForChild("CombatHud", timeout) :: ModuleScript)
local Tutorial = require(controllers:WaitForChild("TutorialController", timeout) :: ModuleScript)
local Handoff = require(controllers:WaitForChild("EncounterHandoffController", timeout) :: ModuleScript)
local CreatureMotion = require(controllers:WaitForChild("CreatureMotion", timeout) :: ModuleScript)
local DeviceLayout = require(controllers:WaitForChild("DeviceLayout", timeout) :: ModuleScript)
local LandscapeBudget = require(controllers:WaitForChild("LandscapeBudget", timeout) :: ModuleScript)
local Effects = require(Shared:WaitForChild("Shared"):WaitForChild("EffectsPreference") :: ModuleScript) :: any

local net = Shared:WaitForChild("Net", timeout)
assert(net, "Network folder did not replicate")
local actionRemote = net:WaitForChild("ActionIntent", timeout) :: RemoteEvent
local snapshotRemote = net:WaitForChild("StateSnapshots", timeout) :: RemoteEvent
local shopRemote = net:WaitForChild("ShopIntent", timeout) :: RemoteEvent
assert(actionRemote and snapshotRemote and shopRemote, "Combat remotes did not replicate")

local RENDER_STEP = "AsuraClient"
local MAX_SEQUENCE = 2147483647

local player = Players.LocalPlayer
local sequence = 0
local alive = true
local connections: { RBXScriptConnection } = {}

-- Outgoing intents carry a strictly increasing sequence and the client's server-clock press time;
-- the server reconciles that time against its own tick inside the lag-compensation window.
local function send(action: string, variant: string?, x: number?, z: number?, held: boolean?, time: number?)
	if not alive then
		return
	end
	sequence = if sequence &gt;= MAX_SEQUENCE then 1 else sequence + 1
	local packet: { [string]: any } = {
		seq = sequence,
		action = action,
		time = time or Workspace:GetServerTimeNow(),
	}
	if variant ~= nil then
		packet.variant = string.sub(variant, 1, 32)
	end
	if x ~= nil and z ~= nil then
		packet.x = math.clamp(x, -1, 1)
		packet.z = math.clamp(z, -1, 1)
	end
	if held ~= nil then
		packet.held = held
	end
	actionRemote:FireServer(packet)
end

-- Replication mirror first: every presentation controller reads fighters through it.
local state = WorldState.new(net)
local camera = Camera.new(state)
local movement = Movement.new(state, camera)
local input = Input.new(state, camera, send, movement)
local feel = GameFeel.new(state, camera)
local environment = Environment.new(state)
local soundscape = Soundscape.new(state, movement)
local ui = Interface.new(state, camera, input)
local sanguine = Sanguine.new(state, ui) -- VFX-place visuals only; existing gameplay/camera/HUD stay authoritative.
local spells = SpellController.new(state, ui, net, camera)
local colosseum = Colosseum.new(state, input, ui, net)
local dialogue = Dialogue.new(camera,input,ui)
local ending = EndingScene.new(camera, input, ui) -- batch 22: the crossing, after the server records it
local wagers = Wagers.new(ui)
local mastery = Mastery.new(state,camera,ui)
local objective = Objective.new(state, ui)
local controls = ControlsCard.new(input, ui)
local pause = PauseMenu.new(camera, input, ui, shopRemote, controls, spells.Panel.Root)
local sakura = SakuraHud.new(state, ui, pause, controls)
local combatHud = CombatHud.new(state, camera, input, ui)
local tutorial = Tutorial.new(state, camera, movement, input, ui) -- sets ui.OnTraining (Respite: replay training)
local handoff = Handoff.new(state, camera, input, ui, function(action: string) send(action) end) -- boss cutscene lock + skip
local creatures = CreatureMotion.new(state) -- procedural gait/wings/tail for creature bosses
-- Batch 25: touch/desktop HUD placement, safe-area insets, 44-pt touch targets, controller route to Respite.
local landscape = LandscapeBudget.new()
local devices = DeviceLayout.new(ui, input, { input.TouchGui, dialogue.View.Gui },
	{ Window = spells.Panel.Window, Hint = spells.Panel.Hint }, pause)
ui.OnPrologue = function() task.spawn(Prologue.Play, ui, input, camera, true) end -- Respite: replay opening
local restoreCoreGui = CoreGuiPolicy.start(state) -- default health bar and player list off
ui.OnIntent = function(action: string, variant: string?)
	send(action, variant)
end

-- Account receiver: camera preferences arrive with the profile sync and with settings results.
local function applySettings(profile: any)
	if type(profile) ~= "table" or type(profile.settings) ~= "table" then
		return
	end
	local settings = profile.settings
	if type(settings.fov) == "number" then
		camera.Fov = math.clamp(settings.fov, Config.Camera.MinFOV, Config.Camera.MaxFOV)
	end
	if type(settings.sensitivity) == "number" then
		camera.Sensitivity = math.clamp(settings.sensitivity, Config.Camera.SensitivityMin, Config.Camera.SensitivityMax)
	end
	if type(settings.comfort) == "table" then
		Effects.set(Effects.sanitize(settings.comfort)) -- reduced effects/motion/flashes and text size (batch 25)
	end
end

table.insert(connections, shopRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) ~= "table" then
		return
	end
	applySettings(payload.profile)
end))

-- The server may finish booting after this script starts; request the profile once it is ready.
local function requestProfile()
	shopRemote:FireServer({ action = "GetProfile" })
end
if Workspace:GetAttribute("AsuraReady") == true then
	requestProfile()
else
	local pending: RBXScriptConnection? = nil
	pending = Workspace:GetAttributeChangedSignal("AsuraReady"):Connect(function()
		if Workspace:GetAttribute("AsuraReady") == true then
			if pending then
				pending:Disconnect()
			end
			requestProfile()
		end
	end)
	table.insert(connections, pending :: RBXScriptConnection)
end

local function destroy()
	if not alive then
		return
	end
	alive = false
	RunService:UnbindFromRenderStep(RENDER_STEP)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	ending:Destroy()
	devices:Destroy()
	landscape:Destroy()
	dialogue:Destroy();wagers:Destroy();mastery:Destroy()
	spells:Destroy()
	sakura:Destroy()
	combatHud:Destroy()
	tutorial:Destroy()
	handoff:Destroy(); creatures:Destroy()
	restoreCoreGui()
	pause:Destroy()
	controls:Destroy()
	objective:Destroy()
	colosseum:Destroy()
	ui:Destroy()
	soundscape:Destroy(); environment:Destroy()
	feel:Destroy()
	sanguine:Destroy()
	input:Destroy()
	movement:Destroy()
	camera:Destroy()
	state:Destroy()
	player:SetAttribute("AsuraClientReady", false)
end

table.insert(connections, script.Destroying:Connect(destroy))
table.insert(connections, RunService.PreSimulation:Connect(function(dt: number)
	if alive then movement:Step(math.min(dt, Config.Movement.MaxFrameDelta)) end
end))

-- One ordered frame after the engine camera: input -&gt; dash execution -&gt; camera -&gt; feel -&gt; HUD.
RunService:BindToRenderStep(RENDER_STEP, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	if not alive then
		return
	end
	local frame = math.min(dt, Config.Movement.MaxFrameDelta)
	input:Step(frame)
	spells:Step()
	state:Step(frame)
	camera:Update(frame)
	feel:Update(frame)
	sanguine:Update(frame)
	environment:Update(frame); soundscape:Update(frame)
	ui:Update(frame)
	colosseum:Update(frame)
 wagers:Update()
	objective:Update(frame)
	controls:Update(frame)
	sakura:Update(frame)
	combatHud:Update(frame)
	tutorial:Update(frame)
	handoff:Update()
	ending:Update(frame)
	creatures:Update(frame)
end)

player:SetAttribute("AsuraClientReady", true)
task.spawn(Prologue.Play, ui, input, camera)
print("[Asura's Path] Client ready: camlock, game feel, Souls HUD and Colosseum online.")
