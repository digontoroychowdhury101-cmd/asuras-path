		Size = UDim2.fromOffset(900, 100),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		ZIndex = 21,
	})
	local sub = label(frame, "SPIRIT SEVERED", 26, BODY_FONT, IVORY, {
