}

-- Validation assertion
local totalWeight = 0
for _, style in ShopCatalog.Styles do
	assert(style.weight > 0, "Style weight must be positive")
	totalWeight += style.weight
end
assert(totalWeight == 1000, "Style drop weights must sum exactly to 1000")

