        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ConfigValidator</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/ConfigValidator
-- Validation runs before the preview is replaced or runtime instances are allocated.
local Validator = {}
local function numberIn(value: any, minimum: number, maximum: number, name: string)
	assert(type(value)=="number" and value==value and value&gt;=minimum and value&lt;=maximum,
		name.." must be finite and between "..minimum.." and "..maximum)
end
local function vector(value: any, minimum: number, maximum: number, name: string)
	assert(type(value)=="table" and #value==3,name.." must have exactly three components")
	for index=1,3 do numberIn(value[index],minimum,maximum,name.."["..index.."]") end
end
function Validator.Validate(config: any)
	assert(type(config)=="table","Config must be a table")
	assert(config.Project.Phase&gt;=5 and config.Project.Phase&lt;=12,"This bootstrap implements Phase 5 through Phase 12")
	assert(config.Arena.Sides==8,"The current mat decomposition requires eight sides")
	local a=config.Arena
	numberIn(a.AcrossFlats,24,64,"Arena.AcrossFlats")
	numberIn(a.FloorThickness,0.1,3,"Arena.FloorThickness")
	numberIn(a.FenceHeight,6,14,"Arena.FenceHeight")
	numberIn(a.WireSpacing,0.75,3,"Arena.WireSpacing")
	numberIn(a.WireDiameter,0.025,0.1,"Arena.WireDiameter")
	numberIn(a.PostDiameter,0.2,1.5,"Arena.PostDiameter")
	numberIn(a.RailDiameter,0.1,0.8,"Arena.RailDiameter")
	numberIn(a.WallThickness,0.1,1,"Arena.WallThickness")
	numberIn(a.WireBottom,0.1,1,"Arena.WireBottom")
	numberIn(a.WireTopInset,0.1,1,"Arena.WireTopInset")
	numberIn(a.LowerRailHeight,0.1,1,"Arena.LowerRailHeight")
	numberIn(a.GateSide,1,8,"Arena.GateSide")
	assert(a.GateSide%1==0,"GateSide must be an integer")
	numberIn(a.GateWidth,2,5,"Arena.GateWidth")
	numberIn(a.GateBarDiameter,0.1,0.4,"Arena.GateBarDiameter")
	numberIn(a.GateLatchHeight,1,a.FenceHeight-1,"Arena.GateLatchHeight")
	numberIn(a.GateLatchLength,0.2,1,"Arena.GateLatchLength")
	numberIn(a.SpawnDistance,2,a.AcrossFlats/2-3,"Arena.SpawnDistance")
	vector(a.SpawnSize,0.1,4,"Arena.SpawnSize")
	numberIn(a.VoidWidth,120,240,"Arena.VoidWidth")
	numberIn(a.VoidHeight,60,120,"Arena.VoidHeight")
	numberIn(a.VoidCenterY,10,30,"Arena.VoidCenterY")
	numberIn(a.VoidWallThickness,0.5,3,"Arena.VoidWallThickness")
	numberIn(a.LightHeight,a.FenceHeight+4,24,"Arena.LightHeight")
	numberIn(a.LightOffset,4,a.AcrossFlats/3,"Arena.LightOffset")
	vector(a.FixtureSize,0.1,6,"Arena.FixtureSize")
	vector(a.DiffuserSize,0.02,6,"Arena.DiffuserSize")
	numberIn(a.DiffuserGap,0.01,0.2,"Arena.DiffuserGap")
	numberIn(a.GeometryEpsilon,1e-8,1e-4,"Arena.GeometryEpsilon")
	numberIn(a.SpotLight.Brightness,0.1,10,"SpotLight.Brightness")
	numberIn(a.SpotLight.Range,a.LightHeight+4,60,"SpotLight.Range")
	numberIn(a.SpotLight.Angle,60,120,"SpotLight.Angle")
	vector(a.SpotLight.Color,0,255,"SpotLight.Color")
	assert(type(a.SpotLight.Shadows)=="boolean","SpotLight.Shadows must be boolean")
	local materials: {[string]: boolean}={Concrete=true,Metal=true,SmoothPlastic=true,Neon=true}
	for key,material in pairs(config.Materials :: {[string]: any}) do
		assert(materials[material.Material],"Unsupported material: "..tostring(material.Material))
		vector(material.Color,0,255,"Materials."..key..".Color")
		numberIn(material.Reflectance,0,0.1,"Materials."..key..".Reflectance")
	end
	for _,key in ipairs({"Ambient","OutdoorAmbient","ColorShiftTop","ColorShiftBottom","FogColor"}) do
		vector(config.Lighting[key],0,255,"Lighting."..key)
	end
	local l=config.Lighting
	assert(l.LightingStyle=="Realistic","Phase 1 targets Realistic lighting")
	assert(type(l.PrioritizeLightingQuality)=="boolean","PrioritizeLightingQuality must be boolean")
	numberIn(l.Brightness,0,10,"Lighting.Brightness")
	numberIn(l.ClockTime,0,24,"Lighting.ClockTime")
	numberIn(l.GeographicLatitude,-90,90,"Lighting.GeographicLatitude")
	numberIn(l.EnvironmentDiffuseScale,0,1,"Lighting.EnvironmentDiffuseScale")
	numberIn(l.EnvironmentSpecularScale,0,1,"Lighting.EnvironmentSpecularScale")
	numberIn(l.ShadowSoftness,0,1,"Lighting.ShadowSoftness")
	numberIn(l.ExposureCompensation,-1,1,"Lighting.ExposureCompensation")
	numberIn(l.FogStart,0,100000,"Lighting.FogStart")
	numberIn(l.FogEnd,l.FogStart+1,100000,"Lighting.FogEnd")
	numberIn(l.Atmosphere.Density,0,1,"Atmosphere.Density")
	numberIn(l.Atmosphere.Offset,0,1,"Atmosphere.Offset")
	numberIn(l.Atmosphere.Haze,0,10,"Atmosphere.Haze")
	numberIn(l.Atmosphere.Glare,0,10,"Atmosphere.Glare")
	vector(l.Atmosphere.Color,0,255,"Atmosphere.Color")
	vector(l.Atmosphere.Decay,0,255,"Atmosphere.Decay")
	assert(type(l.SunRays.Enabled)=="boolean","SunRays.Enabled must be boolean")
	numberIn(l.SunRays.Intensity,0,1,"SunRays.Intensity")
	numberIn(l.SunRays.Spread,0,1,"SunRays.Spread")
	assert(type(l.GlobalShadows)=="boolean","Lighting.GlobalShadows must be boolean")
	assert(type(l.ColorCorrection.Enabled)=="boolean","ColorCorrection.Enabled must be boolean")
	numberIn(l.ColorCorrection.Brightness,-1,1,"ColorCorrection.Brightness")
	numberIn(l.ColorCorrection.Contrast,-1,1,"ColorCorrection.Contrast")
	numberIn(l.ColorCorrection.Saturation,-1,1,"ColorCorrection.Saturation")
	vector(l.ColorCorrection.TintColor,0,255,"ColorCorrection.TintColor")
	assert(type(l.Bloom.Enabled)=="boolean","Bloom.Enabled must be boolean")
	numberIn(l.Bloom.Intensity,0,1,"Bloom.Intensity")
	numberIn(l.Bloom.Size,0,56,"Bloom.Size")
	numberIn(l.Bloom.Threshold,0,10,"Bloom.Threshold")
	assert(type(l.DepthOfField.Enabled)=="boolean","DepthOfField.Enabled must be boolean")
	numberIn(l.DepthOfField.FarIntensity,0,1,"DepthOfField.FarIntensity")
	numberIn(l.DepthOfField.NearIntensity,0,1,"DepthOfField.NearIntensity")
	numberIn(l.DepthOfField.FocusDistance,0,1000,"DepthOfField.FocusDistance")
	numberIn(l.DepthOfField.InFocusRadius,0,1000,"DepthOfField.InFocusRadius")
	vector(config.Workspace.GlobalWind,-100,100,"Workspace.GlobalWind")
	numberIn(config.Workspace.Gravity,0,300,"Workspace.Gravity")
	numberIn(config.Workspace.FallenPartsDestroyHeight,-50000,-20,"Workspace.FallenPartsDestroyHeight")
	assert(config.Workspace.StreamingEnabled==false,"Compact Phase 1 arena expects streaming off")
	numberIn(config.Runtime.MaximumArenaParts,100,2000,"Runtime.MaximumArenaParts")
	assert(config.PresentationIntensity=="ModerateTarget" or config.PresentationIntensity=="Off","Unsupported presentation preset")
	for feature,enabled in pairs(config.Features :: {[string]: boolean}) do
		assert(enabled==(feature=="Combat" or feature=="StyleRolls" or feature=="Injuries" or feature=="Persistence"  or feature=="CustomFighter"),"Unsupported feature configuration: "..feature)
	end
	if config.Injury then
		numberIn(config.Injury.ArmDamagePenalty,0.1,1.0,"Injury.ArmDamagePenalty")
		numberIn(config.Injury.ArmStaminaPenalty,1.0,3.0,"Injury.ArmStaminaPenalty")
		numberIn(config.Injury.LegMovePenaltyPerLeg,0.01,0.5,"Injury.LegMovePenaltyPerLeg")
		numberIn(config.Injury.LegMovePenaltyCap,0.05,0.8,"Injury.LegMovePenaltyCap")
		numberIn(config.Injury.LegDamagePenalty,0.1,1.0,"Injury.LegDamagePenalty")
	end
	local combat=config.Combat
	for _,key in {"MaxHealth","MaxStamina","StaminaRegenPerSecond","GuardDrainPerSecond","MaxBodyDamage","GrappleDrainPerSecond","GrappleBreakCost","GrappleSeparation","CounterDamageScale","FeintStaminaCost","GroundDrainPerSecond","GroundSeparation","MountDamageScale","GroundTransitionCost","SweepCost","StandUpCost","TakedownStaminaCost","SubmissionDrainPerSecond","SubmissionDamagePerSecond","SubmissionEscapeCost","SubmissionStaminaCost","GroundStrikeDamage","GroundStrikeStamina"} do
		numberIn(combat[key],0.1,200,"Combat."..key)
	end
	for _,key in {"RegenDelayTicks","GuardBreakTicks","BlockStunTicks","HitStunTicks","KOResetTicks","DisplayExtrapolationTicks","GrappleMaxTicks","CounterStunTicks","GroundMaxTicks","SubmissionMaxTicks"} do
		numberIn(combat[key],1,600,"Combat."..key);assert(combat[key]%1==0,"Combat ticks must be integers")
	end
	for _,key in {"GuardDamageScale","GuardMoveScale","AttackMoveScale","HitMoveScale","AttackTurnScale","GuardTurnScale"} do
		numberIn(combat[key],0,1,"Combat."..key)
	end
	numberIn(combat.GuardArcCos,-1,1,"Combat.GuardArcCos")
	numberIn(combat.GrappleArcCos,-1,1,"Combat.GrappleArcCos")
	numberIn(combat.InputBufferTicks,1,12,"Combat.InputBufferTicks")
	numberIn(combat.PreviewTimeoutSeconds,0.1,0.5,"Combat.PreviewTimeoutSeconds")
	numberIn(combat.SweepEpsilon,1e-8,1e-4,"Combat.SweepEpsilon")
	numberIn(combat.DummyGuardResumeStamina,1,combat.MaxStamina,"Combat.DummyGuardResumeStamina")
	assert(type(combat.PracticeDummyGuard)=="boolean","Dummy guard flag")
	assert(#combat.Parts==6 and #combat.Hurtboxes==6,"Six calibrated body parts required")
	for _,h in combat.Hurtboxes do
		assert(table.find(combat.Parts,h.Part),"Unknown hurtbox part")
		numberIn(h.X,-2,2,"Hurtbox.X");numberIn(h.Y,0,6,"Hurtbox.Y")
		numberIn(h.Z,-2,2,"Hurtbox.Z");numberIn(h.Radius,0.1,1,"Hurtbox.Radius")
	end
	local m,n,c,i=config.Movement,config.Network,config.Camera,config.Input
	assert(m.TickRate==60 and n.SendRate==30 and n.SnapshotRate==30,"Timing contract is 60/30/30 Hz")
	numberIn(m.Speed,1,12,"Movement.Speed")
	numberIn(m.Acceleration,1,100,"Movement.Acceleration")
	numberIn(m.Deceleration,1,100,"Movement.Deceleration")
	numberIn(m.Radius,1,2,"Movement.Radius")
	numberIn(m.TurnRate,0.5,10,"Movement.TurnRate")
	assert(m.RootHeight==3 and m.MaxFighters==2,"Calibration contract: 3-stud root, two fighters")
	assert(m.CollisionPasses==4 and m.MaxCatchupSteps==6,"Bounded simulation contract changed")
	numberIn(m.MaxFrameDelta,1/m.TickRate,0.1,"Movement.MaxFrameDelta")
	numberIn(m.BackwardScale,0.1,1,"Movement.BackwardScale")
	numberIn(m.StrafeScale,0.1,1,"Movement.StrafeScale")
	numberIn(m.Epsilon,1e-8,1e-4,"Movement.Epsilon")
	for _,key in {"MaxBatch","MaxQueue","MaxPending","MaxSequence","MessageBurst","FrameBurst","ActionBurst","SnapshotHistory","MaxSequenceGap"} do
		numberIn(n[key],1,2147483647,"Network."..key);assert(n[key]%1==0,"Integer required: "..key)
	end
	assert(n.MaxBatch&lt;=6 and n.MaxQueue&lt;=18 and n.MaxPending&lt;=120,"Network buffers exceed tested caps")
	assert(n.MaxQueue&gt;=n.MaxBatch and n.MaxPending&gt;=n.MaxQueue,"Network buffer ordering")
	for _,key in {"MessagesPerSecond","FramesPerSecond","ActionsPerSecond","ActionCooldown","InputTimeout","DisconnectWarning","InterpolationDelay"} do
		numberIn(n[key],0.01,120,"Network."..key)
	end
	assert(n.Protocol==4 and n.SessionLength==36,"Protocol contract mismatch")
	numberIn(c.FOV,c.MinFOV,c.MaxFOV,"Camera.FOV")
	assert(c.MinFOV==70 and c.MaxFOV==90,"Supported FOV range is 70 to 90")
	numberIn(c.EyeHeight,5,5.8,"Camera.EyeHeight")
	numberIn(c.EyeForward,0,0.3,"Camera.EyeForward")
	numberIn(c.Clearance,0.1,0.5,"Camera.Clearance")
	numberIn(c.PitchLimit,0.5,1.4,"Camera.PitchLimit")
	for _,key in {"MouseSensitivity","TouchSensitivity","GamepadSensitivity","CorrectionSpeed","SnapDistance","FocusDistance","FOVStep","SensitivityStep","TraumaDecay","MaxTraumaYaw","MaxTraumaPitch","MaxTraumaRoll","MaxFovKick"} do
		numberIn(c[key],0.0001,100,"Camera."..key)
	end
	numberIn(i.StickDeadzone,0.05,0.4,"Input.StickDeadzone")
	assert(i.BufferCapacity==8 and i.BufferSeconds==0.2,"Input buffer contract")
	numberIn(i.SwipePixels,10,100,"Input.SwipePixels")
	numberIn(i.TouchStickPixels,30,100,"Input.TouchStickPixels")
	numberIn(i.SwipeMaxSeconds,0.1,1,"Input.SwipeMaxSeconds")
	numberIn(i.TapHoldSeconds,0.5,3,"Input.TapHoldSeconds")
	numberIn(i.ContextPriority,2000,5000,"Input.ContextPriority")
	numberIn(c.SensitivityMin,0.1,1,"Camera.SensitivityMin")
	numberIn(c.SensitivityMax,1,4,"Camera.SensitivityMax")
	numberIn(config.Runtime.DependencyTimeoutSeconds,1,60,"Runtime.DependencyTimeoutSeconds")
	for _,key in {"Color","GloveColor","ShortsColor"} do vector(config.Rig[key],0,255,"Rig."..key) end
	for _,key in {"HeadSize","UpperTorsoSize","LowerTorsoSize","UpperArmSize","ForearmSize","HandSize","ThighSize","ShinSize","FootSize"} do
		vector(config.Rig[key],0.1,2,"Rig."..key)
	end
	for _,key in {"StrideRate","LegSwing","GuardShoulder","GuardElbow"} do numberIn(config.Rig[key],0,10,"Rig."..key) end
end
return table.freeze(Validator)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DialogueRules</string>
            <string name="Source">--!strict
local hasScript=pcall(function() return script.Parent end)
local Catalog: any=if hasScript then require(script.Parent.NarrativeCatalog) else require("./NarrativeCatalog")
local Rules={}
function Rules.node(npc: string,node: string): any
 local n=Catalog.NPCs[npc];return if n then n.Nodes[node] else nil
end
function Rules.choose(npc: string,node: string,index: number): any
 local n=Rules.node(npc,node);if not n or index%1~=0 then return nil end
 local c=n.Choices[index];if not c then return nil end
 if c.Close then return {Close=true} end
 if not Rules.node(npc,c.Next) then return nil end
 return {Next=c.Next,Action=c.Action}
end
function Rules.valid(packet: any): boolean
 if type(packet)~="table" or type(packet.action)~="string" then return false end
 local shapes={Choose={action="string",index="number",revision="number"},Close={action="string"},
  Upgrade={action="string",revision="number"},Infuse={action="string",id="string",revision="number"},
  Level={action="string",id="string",revision="number"},Trade={action="string",id="string",revision="number"},Codex={action="string"}}
 local shape=shapes[packet.action];if not shape then return false end
 local count=0;local expected=0;for _ in shape do expected+=1 end
 for key,v in packet do
  count+=1;if type(v)~=shape[key] then return false end
  if type(v)=="string" and #v&gt;64 then return false end
  if type(v)=="number" and (v~=v or v%1~=0 or math.abs(v)&gt;2147483647) then return false end
 end
 return count==expected
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">IntentProtocol</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/IntentProtocol
-- Pure validation; all client tables have exact keys and bounded flat payloads.
export type Frame = {seq: number,x: number,z: number,yaw: number,guard: boolean,body: boolean}
export type Bucket = { tokens: number, time: number }
local Protocol = {}
local LIMBS: {[string]: boolean}={LeftHand=true,RightHand=true,LeftLeg=true,RightLeg=true,Evade=true,Tap=true,Guard=true,Style=true}
local VARIANTS: {[string]: boolean}={Primary=true,Alternate=true,Up=true,Down=true,Left=true,Right=true,Roll=true,Ironline=true,ApexStriker=true,Groundforge=true,Pass=true,TakeBack=true,Sweep=true,Armbar=true,RNC=true,Guillotine=true,StandUp=true,Takedown=true}
local function finite(v: any,low: number,high: number): boolean
	return type(v)=="number" and v==v and v&gt;=low and v&lt;=high
end
local function keys(t: any,allowed: {[string]: boolean},expected: number): boolean
	if type(t)~="table" then return false end
	local count=0
	for k in pairs(t) do
		count+=1
		if count&gt;expected or type(k)~="string" or not allowed[k] then return false end
	end
	return count==expected
end
function Protocol.Take(bucket: Bucket,now: number,cost: number,rate: number,burst: number): boolean
	bucket.tokens=math.min(burst,bucket.tokens+math.max(0,now-bucket.time)*rate)
	bucket.time=math.max(bucket.time,now)
	if bucket.tokens&lt;cost then return false end
	bucket.tokens-=cost
	return true
end
function Protocol.Movement(packet: any,session: string,lastSequence: number,c: any): ({Frame}?,string?)
	if not keys(packet,{version=true,session=true,frames=true},3) then return nil,"shape" end
	if packet.version~=c.Protocol or packet.session~=session then return nil,"session" end
	if type(packet.frames)~="table" then return nil,"frames" end
	local count=0
	for k in pairs(packet.frames) do
		count+=1
		if count&gt;c.MaxBatch or type(k)~="number" or not finite(k,1,c.MaxBatch) or k%1~=0 then return nil,"batch" end
	end
	if count==0 then return nil,"empty" end
	local result: {Frame}={}
	for i=1,count do
		local f=packet.frames[i]
		if not keys(f,{seq=true,x=true,z=true,yaw=true,guard=true,body=true},6) or type(f.guard)~="boolean" or type(f.body)~="boolean" then return nil,"frame shape" end
		if not finite(f.seq,lastSequence+1,math.min(c.MaxSequence,lastSequence+c.MaxSequenceGap)) or f.seq%1~=0 then return nil,"sequence" end
		if i&gt;1 and f.seq~=result[i-1].seq+1 then return nil,"order" end
		if not finite(f.x,-1,1) or not finite(f.z,-1,1) or f.x*f.x+f.z*f.z&gt;1.00001 then return nil,"axes" end
		if not finite(f.yaw,-math.pi,math.pi) then return nil,"yaw" end
		result[i]={seq=f.seq,x=f.x,z=f.z,yaw=f.yaw,guard=f.guard,body=f.body}
	end
	return result,nil
end
function Protocol.Action(packet: any,session: string,lastSequence: number,c: any): boolean
	if not keys(packet,{version=true,session=true,seq=true,action=true,variant=true,body=true,grapple=true,pressed=true},8) then return false end
	return packet.version==c.Protocol and packet.session==session
		and finite(packet.seq,lastSequence+1,math.min(c.MaxSequence,lastSequence+c.MaxSequenceGap)) and packet.seq%1==0
		and type(packet.action)=="string" and LIMBS[packet.action]==true
		and type(packet.variant)=="string" and VARIANTS[packet.variant]==true
		and type(packet.body)=="boolean" and type(packet.grapple)=="boolean" and type(packet.pressed)=="boolean"
end
local SHOP_FIELDS: {[string]: {[string]: boolean}}={
 SaveSettings={action=true,settings=true},GetProfile={action=true},RollStyle={action=true,useToken=true},
 RollCrate={action=true,crateId=true},BuyCosmetic={action=true,itemId=true},EquipCosmetic={action=true,itemId=true},
 EquipStyle={action=true,styleName=true},BuyBundle={action=true,bundleId=true},
}
function Protocol.Shop(packet: any): boolean
 if type(packet)~="table" or type(packet.action)~="string" then return false end
 local allowed=SHOP_FIELDS[packet.action]
 if not allowed then return false end
 local expected=if packet.action=="GetProfile" then 1 else 2
 if not keys(packet,allowed,expected) then return false end
 if packet.action=="GetProfile" then return true end
 if packet.action=="SaveSettings" then
  local s=packet.settings
  local count=if type(s)=="table" and s.keybinds~=nil then 4 else 3
  if not keys(s,{fov=true,sensitivity=true,leftHanded=true,keybinds=true},count) then return false end
  if s.keybinds~=nil then
   if type(s.keybinds)~="table" then return false end
   local n=0
   for k,v in s.keybinds do n+=1;if n&gt;11 or type(k)~="string" or #k&gt;16 or type(v)~="string" or #v&gt;32 then return false end end
  end
  return finite(s.fov,70,90)
   and finite(s.sensitivity,0.5,2) and type(s.leftHanded)=="boolean"
 end
 if packet.action=="RollStyle" then return type(packet.useToken)=="boolean" end
 local id=packet.itemId or packet.styleName or packet.bundleId or packet.crateId
 return type(id)=="string" and #id&gt;0 and #id&lt;=64 and string.match(id,"^[%w_]+$")~=nil
end
function Protocol.QueueEnabled(mode: string,feature: boolean,rankedPassed: boolean,studioQA: boolean): boolean
 return mode=="Casual1v1" or (mode=="Ranked1v1" and ((feature and rankedPassed) or studioQA))
end
function Protocol.Matchmaking(packet: any): boolean
 if type(packet)~="table" then return false end
 if packet.action=="Dequeue" then return keys(packet,{action=true},1) end
 return keys(packet,{action=true,mode=true},2) and packet.action=="Enqueue"
  and (packet.mode=="Ranked1v1" or packet.mode=="Casual1v1")
end
return table.freeze(Protocol)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">NarrativeCatalog</string>
            <string name="Source">--!strict
local Catalog={}
Catalog.Premise="Grandmaster Shen devoured his disciples and shattered the celestial pillars. You are an Asura Emissary: a wandering phantom barred from the afterlife until the six Fallen Sovereigns are laid to rest."
Catalog.NPCs={
 Gao={Name="Master Smith Gao",X=-79,Y=603,Z=900,Color={74,57,49},Start="Greeting",Nodes={
  Greeting={Text="I lost my eyes to the &lt;i&gt;Jade Cataclysm&lt;/i&gt;. Still, I can hear the blood upon your blade. What burden have you brought?",Choices={
   {Label="Reinforce or infuse my weapon",Next="Forge",Action="Forge"},{Label="What can a sovereign's soul become?",Next="Remembrance"},{Label="Farewell",Close=true}}},
  Forge={Text="Iron remembers every wound. Bring ore, starfall, and dragonite; I will teach your steel to remember you.",Choices={{Label="Return",Next="Greeting"},{Label="Farewell",Close=true}}},
  Remembrance={Text="A fallen sovereign leaves a remembrance. Discover one and its weapon or sorcery becomes yours to forge. One soul, one choice.",Choices={{Label="Show discovered remembrances",Next="Greeting",Action="Arsenal"},{Label="Return",Next="Greeting"}}},
 }},
 Lin={Name="Lady Lin · Shrine Maiden",X=8,Y=603,Z=918,Color={145,121,117},Start="Greeting",Nodes={
  Greeting={Text="Emissary, the incense knows your name. Your soul cannot cross while the six sovereigns bind the Abyss. Rest, and let stolen Qi become strength.",Choices={
   {Label="Guide my Ascension",Next="Ascend",Action="Level"},{Label="Tell me of Shen",Next="Shen"},{Label="Farewell",Close=true}}},
  Ascend={Text="Vigor shelters the soul. Endurance steadies the stance. Strength and Dexterity guide steel; Arcane Qi gives sorrow a voice.",Choices={{Label="Return",Next="Greeting"},{Label="Farewell",Close=true}}},
  Shen={Text="He called it salvation. Six disciples became sovereigns, their souls chained to the broken pillars. Lay all six to rest, and the road beyond death may open.",Choices={{Label="Return",Next="Greeting"}}},
 }},
 Hermit={Name="Wandering Hermit",X=-14,Y=3,Z=-738,Color={77,86,70},Start="Greeting",Nodes={
  Greeting={Text="The gate remembers footsteps that have yet to fall. A talisman, phantom? Or the price of knowing?",Choices={
   {Label="Trade for talismans and gems",Next="Trade",Action="Trade"},{Label="Whisper a sovereign's weakness",Next="Weakness"},{Label="Farewell",Close=true}}},
  Trade={Text="A ward may turn a fatal blow. Ore will never rust in a phantom's hand. My prices are fixed; the Abyss has had enough chance.",Choices={{Label="Return",Next="Greeting"},{Label="Farewell",Close=true}}},
  Weakness={Text="Deflect Shen's discipline, evade his hunger. Leap over the frost serpent's sweep. Strike the titan's ankles; separate the twin sentinels before their grief becomes one.",Choices={{Label="Return",Next="Greeting"}}},
 }},
}
Catalog.Lore={
 Pillars={Title="I · The Six Pillars",Region="DesecratedMonastery",X=-24,Y=3,Z=-766,Qi=100,Text="Six celestial pillars held the Abyss beneath the jade mountain. Each bore a disciple's vow. Shen alone was trusted with their names."},
 Feast={Title="II · The Last Supper",Region="DesecratedMonastery",X=48,Y=3,Z=-830,Qi=125,Text="The bowls were set for seven. At dawn, only the master's shadow remained. It cast six faces upon the wall."},
 Bell={Title="III · A Bell Without Echo",Region="DesecratedMonastery",X=-55,Y=3,Z=-918,Qi=125,Text="The monastery bell rang once when the first pillar fell. The second swallowed its echo. The sixth silenced the dead."},
 Emissary={Title="IV · The Uncrossed River",Region="DesecratedMonastery",X=72,Y=3,Z=-1070,Qi=150,Text="A phantom stood at the river of souls. The ferryman counted six chains around its heart. 'Return them to rest,' he said, 'and I shall return for you.'"},
 Bamboo={Title="V · Jade in the Roots",Region="BambooPass",X=28,Y=3,Z=-1235,Qi=150,Text="Jade splinters fell like rain. Bamboo drank the scattered Qi, and its leaves began to whisper the disciples' forgotten prayers."},
 Wraith={Title="VI · What Death Cannot Keep",Region="BambooPass",X=-48,Y=3,Z=-1490,Qi=175,Text="The Emissary left a crimson wraith where its borrowed body fell. One memory could be reclaimed. A second death erased the first."},
 Pagoda={Title="VII · The Empty Throne",Region="CelestialPagoda",X=-33,Y=3,Z=-2258,Qi=200,Text="Above the clouded stair, the throne stood empty. Sovereignty was never a crown. It was the wound left where a soul had been."},
 Dawn={Title="VIII · The Unwritten Dawn",Region="CelestialPagoda",X=35,Y=3,Z=-2470,Qi=250,Text="Gao forged no chain for the seventh soul. Lin kept no incense for its passing. The hermit alone smiled: 'Some endings must be chosen by the dead.'"},
}
Catalog.Trades={SpiritIronOre={Name="Spirit Iron Ore",Price=80},StarfallShard={Name="Starfall Shard",Price=240},DragoniteCore={Name="Dragonite Core",Price=700},
 CrimsonFireGem={Name="Crimson Fire Gem",Price=600},CelestialLightningGem={Name="Celestial Lightning Gem",Price=600},AbyssalVoidGem={Name="Abyssal Void Gem",Price=600},
 LastBreathTalisman={Name="Last Breath Talisman · prevents one fatal blow for 30s",Price=400}}
local function freeze(t: any) for _,v in t do if type(v)=="table" then freeze(v) end end;table.freeze(t) end
freeze(Catalog)
return Catalog
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Objectives</string>
            <string name="Source">--!strict
local Objectives = {}

export type Facts = {
	Region: string?,
	Bosses: { [string]: boolean }?,
	Altars: { [string]: boolean },
	Bloodstain: Vector3?,
	InBoss: boolean,
	InColosseum: boolean,
	BossFelled: boolean,
	-- True once the player has rested at any altar this session (teaches the rest loop first).
	Rested: boolean,
}

export type Target = { Kind: "Altar", Id: string } | { Kind: "Portal" } | { Kind: "Point", Position: Vector3 }

export type Objective = {
	Key: string,
	Title: string,
	Detail: string,
	Target: Target?,
}

type AltarInfo = { Id: string, Name: string, Region: string }

local ROUTE: { AltarInfo } = {
	{ Id = "Altar_SanctuaryBonfire", Name = "Primal Bonfire", Region = "Sanctuary" },
	{ Id = "Altar_MonasteryGate", Name = "Monastery Gate", Region = "DesecratedMonastery" },
	{ Id = "Altar_DesecratedCloister", Name = "Desecrated Cloister", Region = "DesecratedMonastery" },
	{ Id = "Altar_BambooShrine", Name = "Whispering Bamboo Shrine", Region = "BambooPass" },
	{ Id = "Altar_ColosseumAntechamber", Name = "Colosseum Antechamber", Region = "AshColosseum" },
}
Objectives.Route = ROUTE

local BOSS_APPROACH = Vector3.new(0, 3, -1880)

function Objectives.parseAltars(value: any): { [string]: boolean }
	local set: { [string]: boolean } = {}
	if type(value) == "string" then
		for id in string.gmatch(value, "[^,]+") do
			set[id] = true
		end
	end
	return set
end

function Objectives.regionOf(altarId: string): string?
	local expanded: { [string]: string } = { Altar_SanctuaryDepths = "SanctuaryDepths", Altar_CelestialPagoda = "CelestialPagoda", Altar_SkyCitadel = "SkyCitadel" }
	if expanded[altarId] then return expanded[altarId] end
	for _, altar in ROUTE do
		if altar.Id == altarId then
			return altar.Region
		end
	end
	return nil
end

local ENCOUNTERS = {
	{ Id = "TwinSentinels", Name = "The Twin Sentinels", Region = "DesecratedMonastery", Position = Vector3.new(300, 3, -822) },
	{ Id = "VenerableBaize", Name = "Venerable Baize", Region = "BambooPass", Position = Vector3.new(0, 3, -1362) },
	{ Id = "GrandmasterShen", Name = "Grandmaster Shen", Region = "AshColosseum", Position = BOSS_APPROACH },
	{ Id = "SlumberingTitan", Name = "The Slumbering Titan", Region = "SanctuaryDepths", Position = Vector3.new(520, 3, 988) },
	{ Id = "SovereignWu", Name = "Sovereign Wu", Region = "CelestialPagoda", Position = Vector3.new(0, 3, -2272) },
	{ Id = "AzureWyrm", Name = "Azure Wyrm", Region = "SkyCitadel", Position = Vector3.new(0, 3, -2722) },
}
Objectives.Encounters = ENCOUNTERS

function Objectives.resolve(facts: Facts): Objective?
	if facts.InColosseum or facts.InBoss then
		return nil
	end
	if facts.Bloodstain then
		return {
			Key = "Bloodstain",
			Title = "Reclaim your lost essence",
			Detail = "Return to your bloodstain before you fall again",
			Target = { Kind = "Point", Position = facts.Bloodstain },
		}
	end
	-- New profiles start with the bonfire pre-kindled; still walk a newcomer through one rest.
	local bonfire = ROUTE[1]
	if not facts.Rested and not facts.Altars[ROUTE[2].Id] and (facts.Region == "Sanctuary" or facts.Region == nil) then
		return {
			Key = "FirstRest",
			Title = "Kneel at the " .. bonfire.Name,
			Detail = "Resting sets your respawn point and refills your gourd",
			Target = { Kind = "Altar", Id = bonfire.Id },
		}
	end
	for _, altar in ROUTE do
		if not facts.Altars[altar.Id] and (not facts.Bosses or altar.Region == facts.Region or facts.Region == "Sanctuary" or facts.Region == nil) then
			if altar.Region == "Sanctuary" then
				return {
					Key = altar.Id,
					Title = "Kneel at the " .. altar.Name,
					Detail = "Resting sets your respawn point and refills your gourd",
					Target = { Kind = "Altar", Id = altar.Id },
				}
			elseif facts.Region == "Sanctuary" or facts.Region == nil then
				return {
					Key = "Ascend:" .. altar.Id,
					Title = "Climb the Ascension Stairs",
					Detail = "Pass through the northern gate to reach the " .. altar.Name,
					Target = { Kind = "Portal" },
				}
			end
			return {
				Key = altar.Id,
				Title = "Kindle the " .. altar.Name,
				Detail = "Fight your way forward — altars mark safe ground",
				Target = { Kind = "Altar", Id = altar.Id },
			}
		end
	end
	if facts.Bosses then
		local nextBoss = nil
		for _, boss in ENCOUNTERS do
			if not facts.Bosses[boss.Id] then
				nextBoss = nextBoss or boss
				if boss.Region == facts.Region then nextBoss = boss; break end
			end
		end
		if nextBoss then
			local approach = nextBoss.Position
			if nextBoss.Id == "SlumberingTitan" and facts.Region == "Sanctuary" then approach = Vector3.new(-35, 605, 900) end
			return { Key = "Boss:" .. nextBoss.Id, Title = "Challenge " .. nextBoss.Name,
				Detail = "Traverse the arena mist in " .. string.gsub(nextBoss.Region, "(%l)(%u)", "%1 %2"), Target = { Kind = "Point", Position = approach } }
		end
	elseif not facts.BossFelled then
		return {
			Key = "Boss",
			Title = "Pass the fog gate",
			Detail = "Grandmaster Shen awaits beyond the Ash Colosseum",
			Target = { Kind = "Point", Position = BOSS_APPROACH },
		}
	end
	return {
		Key = "Duel",
		Title = "Prove yourself in the Colosseum",
		Detail = "Travel to the Sanctuary and challenge a rival on the east balcony",
		Target = nil,
	}
end

return Objectives
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ProgressionRules</string>
            <string name="Source">--!strict
-- Engine-free progression math shared by persistence, combat, menus and tests.
local Rules = {}
local INFUSIONS: {[string]: string}={CrimsonFire="CrimsonFireGem", CelestialLightning="CelestialLightningGem", AbyssalVoid="AbyssalVoidGem"}
Rules.Attributes = table.freeze({"Vigor", "Endurance", "Strength", "Dexterity", "ArcaneQi"})
Rules.Infusions = table.freeze(INFUSIONS)
function Rules.level(a: {[string]: number}): number
 local n=1;for _,key in Rules.Attributes do n+=a[key]-10 end;return n
end
function Rules.levelCost(n: number): number return math.floor(150*math.max(1,n)^1.4) end
local function cap(n: number,early: number,mid: number,late: number): number
 local p=math.max(0,n-10);return math.min(p,30)*early+math.clamp(p-30,0,20)*mid+math.max(0,p-50)*late
end
function Rules.stats(a: {[string]: number},tier: number): {[string]: number}
 local forge=1+0.1*tier
 return {HPBonus=cap(a.Vigor,6,3,1), StaminaBonus=cap(a.Endurance,2.5,1.2,0.4),
  PostureBonus=cap(a.Endurance,1.5,0.8,0.3), MaxQi=100+cap(a.ArcaneQi,3,1.5,0.5),
  RallyScale=1+cap(a.Vigor,0.015,0.0075,0.0025), SpellScale=1+cap(a.ArcaneQi,0.025,0.0125,0.004),
  StrengthScale=(1+cap(a.Strength,0.018,0.009,0.003))*forge,
  DexterityScale=(1+cap(a.Dexterity,0.018,0.009,0.003))*forge}
end
function Rules.upgradeCost(tier: number): (number,string,number)
 local material=if tier&lt;4 then "SpiritIronOre" elseif tier&lt;8 then "StarfallShard" else "DragoniteCore"
 return math.floor(250*(tier+1)^1.5),material,if tier&lt;4 then tier+1 elseif tier&lt;8 then tier-3 else tier-7
end
function Rules.upgrade(p: any,weapon: string): string
 local w=assert(p.inventory.Weapons[weapon],"Weapon is locked");assert(w.Level&lt;10,"Weapon is already +10")
 local cost,ore,count=Rules.upgradeCost(w.Level)
 assert(p.qiEssence&gt;=cost,"Not enough Qi");assert((p.inventory.Materials[ore] or 0)&gt;=count,"Missing "..ore)
 p.qiEssence-=cost;p.inventory.Materials[ore]-=count;w.Level+=1
 return "Reinforced "..weapon.." +"..w.Level
end
function Rules.infuse(p: any,weapon: string,affinity: string): string
 local gem=assert(Rules.Infusions[affinity],"Unknown infusion")
 local w=assert(p.inventory.Weapons[weapon],"Weapon is locked");assert(w.Infusion~=affinity,"Already infused")
 assert((p.inventory.Materials[gem] or 0)&gt;=1,"Missing "..gem);assert(p.qiEssence&gt;=300,"Not enough Qi")
 p.inventory.Materials[gem]-=1;p.qiEssence-=300;w.Infusion=affinity;return "Infused "..weapon
end
function Rules.affinity(id: string?,a: {[string]: number}): {[string]: number}
 return {Burn=if id=="CrimsonFire" then 2*(1+(a.Strength-10)*0.025) else 0,
  Stun=if id=="CelestialLightning" then 5*(1+(a.Dexterity-10)*0.025) else 0,
  GuardPierce=if id=="AbyssalVoid" then 0.3 else 0,
  VoidScale=if id=="AbyssalVoid" then 1+(a.ArcaneQi-10)*0.01 else 1}
end
function Rules.masteryRank(xp: number): number
 local rank=1;for index,threshold in {0,100,300,700,1500} do if xp&gt;=threshold then rank=index end end;return rank
end
function Rules.discover(p: any,id: string,reward: number): boolean
 if p.inventory.LoreEntries[id] then return false end
 p.inventory.LoreEntries[id]=true;p.qiEssence+=reward;return true
end
function Rules.mastery(p: any,weapon: string,xp: number)
 if not p.inventory.Weapons[weapon] then return end
 p.weaponMastery[weapon]=math.min(9007199254740991,(p.weaponMastery[weapon] or 0)+xp)
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RPGInventory</string>
            <string name="Source">--!strict
local hasScript=pcall(function() return script.Parent end)
local Rules: any=if hasScript then require(script.Parent.ProgressionRules) else require("./ProgressionRules")
local Weapons: any=if hasScript then require(script.Parent.Parent.Simulation.WeaponSchema) else require("../simulation/WeaponSchema")
local Spells: any=if hasScript then require(script.Parent.Parent.Simulation.SpellSchema) else require("../simulation/SpellSchema")
local Inventory={}
function Inventory.integer(v: any,lo: number,hi: number): boolean
 return type(v)=="number" and v==v and v&gt;=lo and v&lt;=hi and v%1==0
end
function Inventory.id(v: any): boolean
 return type(v)=="string" and #v&gt;0 and #v&lt;=64 and string.match(v,"^[%w_]+$")~=nil
end
function Inventory.flags(raw: any): {[string]: boolean}
 local result={};if type(raw)=="table" then for k,v in raw do if Inventory.id(k) and v==true then result[k]=true end end end;return result
end
function Inventory.defaults(): any
 return {Weapons={Unarmed={Level=0},Jian={Level=0}},Spells={ThunderclapPalm=true,GaleStep=true},Materials={},LoreEntries={}}
end
function Inventory.migrate(raw: any,legacy: any): any
 local i=Inventory.defaults();raw=if type(raw)=="table" then raw else {};legacy=if type(legacy)=="table" then legacy else {}
 for id,w in (if type(raw.Weapons)=="table" then raw.Weapons else {}) do
  if Weapons.Weapons[id] and type(w)=="table" then
   i.Weapons[id]={Level=if Inventory.integer(w.Level,0,10) then w.Level else 0,
    Infusion=if type(w.Infusion)=="string" and Rules.Infusions[w.Infusion] then w.Infusion else nil}
  end
 end
 for id,owned in (if type(legacy.weapons)=="table" then legacy.weapons else {}) do
  if owned==true and Weapons.Weapons[id] and not i.Weapons[id] then
   local tier=if type(legacy.reinforcement)=="table" then legacy.reinforcement[id] else nil
   i.Weapons[id]={Level=if Inventory.integer(tier,0,10) then tier else 0}
  elseif owned==true and i.Weapons[id] and raw.Weapons==nil then
   local tier=if type(legacy.reinforcement)=="table" then legacy.reinforcement[id] else nil
   if Inventory.integer(tier,0,10) then i.Weapons[id].Level=tier end
  end
 end
 for _,set in {raw.Spells,legacy.spells} do
  if type(set)=="table" then for id,flag in set do if flag==true and Spells.ById[id] then i.Spells[id]=true end end end
 end
 if type(raw.Materials)=="table" then
  for id,count in raw.Materials do if Inventory.id(id) and Inventory.integer(count,0,9007199254740991) then i.Materials[id]=count end end
 end
 i.LoreEntries=Inventory.flags(raw.LoreEntries);return i
end
function Inventory.validate(i: any): boolean
 if type(i)~="table" then return false end
 for _,key in {"Weapons","Spells","Materials","LoreEntries"} do
  if type(i[key])~="table" then return false end
  local n=0;for _ in i[key] do n+=1 end;if n&gt;512 then return false end
 end
 for id,w in i.Weapons do
  if not Weapons.Weapons[id] or type(w)~="table" or not Inventory.integer(w.Level,0,10)
   or (w.Infusion~=nil and (type(w.Infusion)~="string" or not Rules.Infusions[w.Infusion])) then return false end
 end
 for id,v in i.Spells do if not Spells.ById[id] or v~=true then return false end end
 for id,v in i.Materials do if not Inventory.id(id) or not Inventory.integer(v,0,9007199254740991) then return false end end
 for id,v in i.LoreEntries do if not Inventory.id(id) or v~=true then return false end end
 return i.Weapons.Unarmed~=nil and i.Weapons.Jian~=nil
end
return table.freeze(Inventory)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RPGProfile</string>
            <string name="Source">--!strict
local hasScript=pcall(function() return script.Parent end)
local I: any=if hasScript then require(script.Parent.RPGInventory) else require("./RPGInventory")
local Rules: any=if hasScript then require(script.Parent.ProgressionRules) else require("./ProgressionRules")
local Arena: any=if hasScript then require(script.Parent.ArenaRules) else require("./ArenaRules")
local RPG={}
function RPG.apply(p: any,raw: any)
 raw=if type(raw)=="table" then raw else {}
 local s=if type(raw.souls)=="table" then raw.souls else {}
 local a=if type(raw.attributes)=="table" then raw.attributes else {}
 local s_attr=if type(s.attributes)=="table" then s.attributes else {}
 local world=if type(s.world)=="table" then s.world else {}
 p.qiEssence=if I.integer(raw.qiEssence,0,9007199254740991) then raw.qiEssence
  else (if I.integer(raw.fightCash,0,9007199254740991) then raw.fightCash else 0)+(if I.integer(s.essence,0,9007199254740991) then s.essence else 0)
 p.qiEssence=math.min(p.qiEssence,9007199254740991)
 p.attributes={}
 for _,name in Rules.Attributes do
  local value=a[name] or s_attr[name]
  if value==nil then value=if name=="Vigor" then (a.Vitality or s_attr.Vitality) elseif name=="Endurance" then (a.Qi or s_attr.Qi) else nil end
  p.attributes[name]=if I.integer(value,10,99) then value else 10
 end
 p.inventory=I.migrate(raw.inventory,s.inventory)
 local old=if type(s.inventory)=="table" then s.inventory else {}
 local loadout=if type(raw.equippedLoadout)=="table" then raw.equippedLoadout else {}
 local main=loadout.MainWeapon or old.mainhand;local off=loadout.OffWeapon or old.offhand
 p.equippedLoadout={MainWeapon=if type(main)=="string" and p.inventory.Weapons[main] then main else "Jian",
  OffWeapon=if type(off)=="string" and p.inventory.Weapons[off] then off else nil,ArmorSet=if I.id(loadout.ArmorSet) then loadout.ArmorSet else nil}
 for n=1,2 do
  local key="SpellSlot"..n;local id=loadout[key] or (if type(old.spellSlots)=="table" then (old.spellSlots :: any)[n] else nil)
  p.equippedLoadout[key]=if type(id)=="string" and p.inventory.Spells[id] then id else (if n==1 then "ThunderclapPalm" else "GaleStep")
 end
 p.defeatedBosses=I.flags(raw.defeatedBosses or world.bosses);p.unlockedAltars=I.flags(raw.unlockedAltars or world.altars)
 for id in I.flags(world.altars) do p.unlockedAltars[id]=true end
 for id in I.flags(world.bosses) do p.defeatedBosses[id]=true end
 p.unlockedAltars.Altar_SanctuaryBonfire=true
 local c=if type(raw.colosseum)=="table" then raw.colosseum else {}
 p.colosseum={Elo=if I.integer(c.Elo,0,5000) then c.Elo else p.elo,Wins=if I.integer(c.Wins,0,9007199254740991) then c.Wins else p.wins,
  Losses=if I.integer(c.Losses,0,9007199254740991) then c.Losses else p.losses,WinStreak=if I.integer(c.WinStreak,0,9007199254740991) then c.WinStreak else p.winStreak}
 p.colosseum.Rank=Arena.rank(p.colosseum.Elo,p.colosseum.Wins+p.colosseum.Losses+p.draws)
 p.weaponMastery={};for id,xp in (if type(raw.weaponMastery)=="table" then raw.weaponMastery else {}) do
  if p.inventory.Weapons[id] and I.integer(xp,0,9007199254740991) then p.weaponMastery[id]=xp end
 end
 p.arenaWagers={}
 for id,b in (if type(raw.arenaWagers)=="table" then raw.arenaWagers else {}) do
  assert(type(id)=="string" and #id&lt;=64 and type(b)=="table" and I.integer(b.Fighter,-9007199254740991,9007199254740991)
   and Arena.validWager(b.Amount) and (b.State=="Pending" or b.State=="Settled"),"Corrupt wager ledger")
  p.arenaWagers[id]={Fighter=b.Fighter,Amount=b.Amount,State=b.State}
 end
end
function RPG.validate(p: any): (boolean,string?)
 if not I.integer(p.qiEssence,0,9007199254740991) or type(p.attributes)~="table" then return false,"Invalid Qi or attributes" end
 for _,key in Rules.Attributes do if not I.integer(p.attributes[key],10,99) then return false,"Invalid "..key end end
 if not I.validate(p.inventory) or type(p.equippedLoadout)~="table" then return false,"Invalid RPG inventory" end
 local l=p.equippedLoadout
 if not p.inventory.Weapons[l.MainWeapon] or (l.OffWeapon~=nil and not p.inventory.Weapons[l.OffWeapon]) then return false,"Unowned loadout" end
 for _,key in {"SpellSlot1","SpellSlot2"} do if l[key]~=nil and not p.inventory.Spells[l[key]] then return false,"Unowned spell" end end
 if l.ArmorSet~=nil and not I.id(l.ArmorSet) then return false,"Invalid armor" end
 for _,key in {"defeatedBosses","unlockedAltars"} do
  if type(p[key])~="table" then return false,"Missing flags" end
  local n=0;for id,v in p[key] do n+=1;if n&gt;512 or not I.id(id) or v~=true then return false,"Invalid flags" end end
 end
 local c=p.colosseum;if type(c)~="table" or not I.integer(c.Elo,0,5000) then return false,"Invalid arena" end
 for _,key in {"Wins","Losses","WinStreak"} do if not I.integer(c[key],0,9007199254740991) then return false,"Invalid arena counter" end end
 if c.Rank~=Arena.rank(c.Elo,c.Wins+c.Losses+p.draws) then return false,"Invalid rank" end
 if type(p.weaponMastery)~="table" or type(p.arenaWagers)~="table" then return false,"Missing mastery or wagers" end
 for id,xp in p.weaponMastery do if not p.inventory.Weapons[id] or not I.integer(xp,0,9007199254740991) then return false,"Invalid mastery" end end
 local count=0;for id,b in p.arenaWagers do
  count+=1;if count&gt;512 or type(id)~="string" or #id==0 or #id&gt;64 or type(b)~="table" or not I.integer(b.Fighter,-9007199254740991,9007199254740991)
   or not Arena.validWager(b.Amount) or (b.State~="Pending" and b.State~="Settled") then return false,"Invalid wager" end
 end
 return true,nil
end
return table.freeze(RPG)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">WorldDefinitions</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/WorldDefinitions
-- Story Mode world manifest. Engine-free data (plain numbers, yaw in degrees) so the manifest is
-- validated identically by the server, the client and the local Luau runner.

local hasScript = pcall(function() return script.Parent end)
local Roster: any
if hasScript then Roster = require(script.Parent.BossRoster) else Roster = require("./BossRoster") end

type AttackKind = "PerilousSweep" | "PerilousThrust" | "PerilousGrab" | "Shockwave" | "Barrage" | "Gravity" | "Ritual" | "Leap" | "Breath" | "Tail" | "ShieldCharge"
type Motion = "Pillar" | "Aerial" | "Lunge" | "Teleport"
export type BossAttack = {
	Id: string, Kind: AttackKind, Windup: number, Radius: number, Damage: number, Posture: number,
	Height: number?, Speed: number?, Repeats: number?, Interval: number?, Duration: number?,
	Count: number?, Motion: Motion?, Element: string?, Unblockable: boolean?,
}
type GapCloser = { Range: number, Delay: number, Cooldown: number, Motion: Motion }

export type Vec3 = { X: number, Y: number, Z: number }
export type Placement = { X: number, Y: number, Z: number, Yaw: number }
export type Bounds = { Center: Vec3, Size: Vec3 }
export type RegionId = "Sanctuary" | "DesecratedMonastery" | "BambooPass" | "AshColosseum" | "SanctuaryDepths" | "CelestialPagoda" | "SkyCitadel"
export type WeaponType = "Unarmed" | "Jian" | "Dao" | "Guandao" | "Catalyst" | "PrayerOfTheDefiled" | "CalamityBoneCleaver" | "HeavenPiercingGuandao"

export type Stats = {
	MaxHP: number?,
	MaxStamina: number?,
	PostureCapacity: number?,
	StrengthScale: number?,
	DexterityScale: number?,
	PoiseArmor: number?,
	ReachBonus: number?,
}

export type AIProfile = {
	SightRange: number,
	FieldOfView: number,
	HearingRange: number,
	AlertTime: number,
	SearchTime: number,
	Aggression: number,
	DeflectChance: number,
	GuardChance: number,
	ReactionTime: number,
	TimingJitter: number,
	PatrolRadius: number,
	LeashRange: number,
	ComboContinueChance: number,
	HeavyChance: number,
	ArtChance: number,
	StrafeChance: number,
	RetreatStamina: number,
	PostureGuard: number,
	ThinkRate: number,
}

export type Region = {
	Id: RegionId,
	Name: string,
	Bounds: Bounds,
	MapFolder: string,
	Greybox: { Color: { number }, Material: string },
	Ambience: string,
	-- Region-scoped view of World.Altars keyed without the "Altar_" prefix, e.g.
	-- World.Regions.DesecratedMonastery.Altars.MonasteryGate. Filled from World.Altars at load.
	Altars: { [string]: Altar },
}

export type Altar = {
	Id: string,
	Name: string,
	Region: RegionId,
	Placement: Placement,
	Spawn: Placement,
	Radius: number,
	Starting: boolean,
}

export type MobDef = {
	Id: string,
	Name: string,
	Weapon: WeaponType,
	Stats: Stats,
	AI: AIProfile,
	Essence: number,
	BodyColor: { number },
}

export type MobSpawn = {
	Id: string,
	Mob: string,
	Region: RegionId,
	Placement: Placement,
	Patrol: { Placement },
}

export type Shockwave = {
	Windup: number,
	Radius: number,
	Damage: number,
	Posture: number,
	Unblockable: boolean,
}

export type BossPhase = {
	Attacks: { BossAttack }?,
	AttackInterval: number?,
	AnimationSet: string?,
	GapCloser: GapCloser?,
	Index: number,
	Name: string,
	Weapon: WeaponType,
	-- Enter this phase when HP falls to this fraction of max (nil for the opening phase).
	HPFraction: number?,
	-- Enter this phase on the first Deathblow received in the previous phase.
	OnDeathblow: boolean,
	Stats: Stats,
	AI: AIProfile,
	Transition: { Duration: number, Shockwave: Shockwave, BodyColor: { number } }?,
	Special: { IntervalMin: number, IntervalMax: number, Shockwave: Shockwave }?,
}

export type BossDef = {
	Archetype: string?, Scale: number?, Victory: string?, Affinity: string?,
	Partner: { Name: string, Weapon: WeaponType, Stats: Stats, Attacks: { BossAttack }, Affinity: string, Scale: number }?,
	Id: string,
	Name: string,
	Title: string,
	Region: RegionId,
	Arena: Bounds,
	Spawn: Placement,
	FogGate: string,
	Essence: number,
	Phases: { BossPhase },
	BodyColor: { number },
}

export type FogGate = {
	Id: string,
	Boss: string,
	Placement: Placement,
	Size: Vec3,
	-- Crossing into this volume (inside the arena) starts the encounter.
	Trigger: Bounds,
	-- Where trapped fighters are returned when they leave the arena, and where outsiders are ejected to.
	Inside: Placement,
	Outside: Placement,
}

-- Layout anchors for the Shrine of the Ascendant, the sky lobby above the sea of clouds. The
-- SanctuaryService builds around these points; the Colosseum ring and the bonfire altar read them.
export type SanctuaryLayout = {
	Origin: Vec3, -- Plaza centre at flagstone level
	PlazaRadius: number,
	PlinthHeight: number,
	Loggia: Vec3, -- West alcove centre (Blacksmith)
	Promenade: Vec3, -- East balcony centre (Colosseum ring)
	StairSteps: number,
	StairRise: number,
	StairRun: number,
	StairWidth: number,
	PortalDestination: string, -- Altar the Ascension Gateway delivers to
	CloudRadius: number,
}

local World = {}

local function v(x: number, y: number, z: number): Vec3
	return { X = x, Y = y, Z = z }
end

local function at(x: number, y: number, z: number, yaw: number?): Placement
	return { X = x, Y = y, Z = z, Yaw = yaw or 0 }
end

local function profile(overrides: { [string]: number }): AIProfile
	local base: AIProfile = {
		SightRange = 60,
		FieldOfView = 110,
		HearingRange = 28,
		AlertTime = 0.9,
		SearchTime = 6,
		Aggression = 0.6,
		DeflectChance = 0.3,
		GuardChance = 0.4,
		ReactionTime = 0.24,
		TimingJitter = 0.035,
		PatrolRadius = 12,
		LeashRange = 100,
		ComboContinueChance = 0.65,
		HeavyChance = 0.2,
		ArtChance = 0.06,
		StrafeChance = 0.35,
		RetreatStamina = 20,
		PostureGuard = 0.8,
		ThinkRate = 10,
	}
	local writable = base :: any
	for key, value in overrides do
		assert(writable[key] ~= nil, "Unknown AI profile field " .. key)
		writable[key] = value
	end
	return base
end

local SANCTUARY_ORIGIN = v(0, 600, 900)
local PLINTH_HEIGHT = 1.2

World.Sanctuary = {
	Origin = SANCTUARY_ORIGIN,
	PlazaRadius = 46,
	PlinthHeight = PLINTH_HEIGHT,
	Loggia = v(SANCTUARY_ORIGIN.X - 84, SANCTUARY_ORIGIN.Y, SANCTUARY_ORIGIN.Z),
	Promenade = v(SANCTUARY_ORIGIN.X + 94, SANCTUARY_ORIGIN.Y, SANCTUARY_ORIGIN.Z),
	StairSteps = 20,
	StairRise = 1,
	StairRun = 2,
	StairWidth = 14,
	PortalDestination = "Altar_MonasteryGate",
	CloudRadius = 1200,
} :: SanctuaryLayout

World.Regions = {
	Sanctuary = {
		Id = "Sanctuary",
		Name = "The Shrine of the Ascendant",
		Bounds = { Center = v(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + 20, SANCTUARY_ORIGIN.Z), Size = v(420, 260, 420) },
		-- Built at runtime by SanctuaryService as Workspace.Sanctuary; its presence suppresses greybox.
		MapFolder = "Sanctuary",
		Greybox = { Color = { 120, 112, 104 }, Material = "Slate" },
		Ambience = "SkyShrine",
		Altars = {},
	},
	DesecratedMonastery = {
		Id = "DesecratedMonastery",
		Name = "Desecrated Monastery",
		Bounds = { Center = v(0, 40, -900), Size = v(400, 200, 440) },
		MapFolder = "Map_DesecratedMonastery",
		Greybox = { Color = { 74, 66, 60 }, Material = "Slate" },
		Ambience = "TempleBells",
		Altars = {},
	},
	BambooPass = {
		Id = "BambooPass",
		Name = "Bamboo Pass",
		Bounds = { Center = v(0, 40, -1400), Size = v(240, 200, 560) },
		MapFolder = "Map_BambooPass",
		Greybox = { Color = { 68, 92, 58 }, Material = "Grass" },
		Ambience = "WindReeds",
		Altars = {},
	},
	AshColosseum = {
		Id = "AshColosseum",
		Name = "Ash Colosseum",
		Bounds = { Center = v(0, 40, -1900), Size = v(360, 200, 440) },
		MapFolder = "Map_AshColosseum",
		Greybox = { Color = { 58, 54, 52 }, Material = "Basalt" },
		Ambience = "EmberCrowd",
		Altars = {},
	},
} :: { [RegionId]: Region }

World.RegionOrder = { "Sanctuary", "DesecratedMonastery", "BambooPass", "AshColosseum" } :: { RegionId }

World.Altars = {
	-- First-time players kneel here: the spawn stands before the bonfire, facing the staircase (-Z).
	Altar_SanctuaryBonfire = {
		Id = "Altar_SanctuaryBonfire",
		Name = "Primal Bonfire",
		Region = "Sanctuary",
		Placement = at(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + PLINTH_HEIGHT, SANCTUARY_ORIGIN.Z),
		Spawn = at(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + 3, SANCTUARY_ORIGIN.Z + 20, 0),
		Radius = 9,
		Starting = true,
	},
	Altar_MonasteryGate = {
		Id = "Altar_MonasteryGate",
		Name = "Monastery Gate",
		Region = "DesecratedMonastery",
		Placement = at(0, 0, -720),
		Spawn = at(0, 3, -728, 0),
		Radius = 9,
		Starting = false,
	},
	Altar_DesecratedCloister = {
		Id = "Altar_DesecratedCloister",
		Name = "Desecrated Cloister",
		Region = "DesecratedMonastery",
		Placement = at(60, 0, -1010),
		Spawn = at(60, 3, -1018, 0),
		Radius = 9,
		Starting = false,
	},
	Altar_BambooShrine = {
		Id = "Altar_BambooShrine",
		Name = "Whispering Bamboo Shrine",
		Region = "BambooPass",
		Placement = at(-30, 0, -1380),
		Spawn = at(-30, 3, -1388, 0),
		Radius = 9,
		Starting = false,
	},
	Altar_ColosseumAntechamber = {
		Id = "Altar_ColosseumAntechamber",
		Name = "Colosseum Antechamber",
		Region = "AshColosseum",
		Placement = at(0, 0, -1730),
		Spawn = at(0, 3, -1738, 0),
		Radius = 9,
		Starting = false,
	},
} :: { [string]: Altar }

for id, altar in World.Altars do
	local short = string.gsub(id, "^Altar_", "")
	local region = World.Regions[altar.Region]
	assert(region ~= nil, "Altar region missing " .. id)
	assert(region.Altars[short] == nil, "Duplicate region altar name " .. short)
	region.Altars[short] = altar
end

World.Mobs = {
	CorruptWanderingMonk = {
		Id = "CorruptWanderingMonk",
		Name = "Corrupt Wandering Monk",
		Weapon = "Unarmed",
		Stats = { MaxHP = 85, MaxStamina = 90, PostureCapacity = 80, StrengthScale = 0.9, DexterityScale = 0.9, PoiseArmor = 0.1 },
		AI = profile({
			SightRange = 55,
			HearingRange = 26,
			Aggression = 0.55,
			DeflectChance = 0.2,
			GuardChance = 0.45,
			ReactionTime = 0.28,
			PatrolRadius = 14,
			LeashRange = 90,
			ComboContinueChance = 0.6,
			HeavyChance = 0.25,
			ArtChance = 0.05,
			StrafeChance = 0.3,
		}),
		Essence = 45,
		BodyColor = { 112, 84, 60 },
	},
	CursedSwordsman = {
		Id = "CursedSwordsman",
		Name = "Cursed Swordsman",
		Weapon = "Dao",
		Stats = { MaxHP = 120, MaxStamina = 110, PostureCapacity = 110, StrengthScale = 1.0, DexterityScale = 1.0, PoiseArmor = 0.2 },
		AI = profile({
			SightRange = 65,
			FieldOfView = 100,
			HearingRange = 30,
			Aggression = 0.7,
			DeflectChance = 0.4,
			GuardChance = 0.35,
			ReactionTime = 0.22,
			PatrolRadius = 10,
			LeashRange = 110,
			ComboContinueChance = 0.75,
			HeavyChance = 0.2,
			ArtChance = 0.08,
			StrafeChance = 0.4,
		}),
		Essence = 80,
		BodyColor = { 46, 50, 62 },
	},
} :: { [string]: MobDef }

local function patrol(x: number, z: number, radius: number): { Placement }
	return {
		at(x + radius, 3, z),
		at(x, 3, z + radius),
		at(x - radius, 3, z),
		at(x, 3, z - radius),
	}
end

local function spawn(id: string, mob: string, region: RegionId, x: number, z: number, yaw: number, radius: number): MobSpawn
	return { Id = id, Mob = mob, Region = region, Placement = at(x, 3, z, yaw), Patrol = patrol(x, z, radius) }
end

World.Spawns = {
	spawn("DM_Monk_Courtyard_A", "CorruptWanderingMonk", "DesecratedMonastery", -30, -790, 180, 10),
	spawn("DM_Monk_Courtyard_B", "CorruptWanderingMonk", "DesecratedMonastery", 34, -812, 200, 12),
	spawn("DM_Monk_Hall_A", "CorruptWanderingMonk", "DesecratedMonastery", -70, -900, 90, 8),
	spawn("DM_Monk_Hall_B", "CorruptWanderingMonk", "DesecratedMonastery", 78, -920, 270, 8),
	spawn("DM_Swordsman_Bridge", "CursedSwordsman", "DesecratedMonastery", 0, -960, 180, 6),
	spawn("DM_Monk_Cloister", "CorruptWanderingMonk", "DesecratedMonastery", 40, -1060, 180, 10),
	spawn("DM_Swordsman_Cloister", "CursedSwordsman", "DesecratedMonastery", 90, -1080, 220, 8),
	spawn("BP_Swordsman_Trail_A", "CursedSwordsman", "BambooPass", 20, -1200, 180, 10),
	spawn("BP_Monk_Trail", "CorruptWanderingMonk", "BambooPass", -40, -1270, 160, 12),
	spawn("BP_Swordsman_Grove_A", "CursedSwordsman", "BambooPass", 50, -1450, 200, 8),
	spawn("BP_Swordsman_Grove_B", "CursedSwordsman", "BambooPass", -60, -1500, 140, 8),
	spawn("BP_Monk_Ridge", "CorruptWanderingMonk", "BambooPass", 10, -1590, 180, 10),
	spawn("AC_Swordsman_Gate_A", "CursedSwordsman", "AshColosseum", -24, -1800, 180, 6),
	spawn("AC_Swordsman_Gate_B", "CursedSwordsman", "AshColosseum", 24, -1810, 180, 6),
} :: { MobSpawn }

World.Bosses = {
	GrandmasterShen = {
		Id = "GrandmasterShen",
		Name = "Grandmaster Shen",
		Title = "Grandmaster Shen, the Fallen Abbot",
		Region = "AshColosseum",
		Arena = { Center = v(0, 20, -1960), Size = v(120, 60, 130) },
		Spawn = at(0, 3, -1995, 180),
		FogGate = "Gate_AshColosseum",
		Essence = 4000,
		BodyColor = { 210, 196, 168 },
		Phases = {
			{
				Index = 1,
				Name = "Disciplined Master",
				Weapon = "Jian",
				HPFraction = nil,
				OnDeathblow = false,
				Stats = {
					MaxHP = 900,
					MaxStamina = 220,
					PostureCapacity = 240,
					StrengthScale = 1.4,
					DexterityScale = 1.6,
