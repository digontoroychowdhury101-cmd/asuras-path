        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">MonasteryZones</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/MonasteryZones
-- The walked areas of the Desecrated Monastery as rectangles joined by doorways (batch 15). Two
-- uses: wayfinding follows the doorways (gatehouse, courtyard south gap, bridgeheads, cloister
-- gateway, the west postern) instead of a straight line through walls (#28), and each Monastery
-- spawn fights only inside its zone, so a monk never chases across a wall, onto the safe landing
-- or over the bridge (#27). Pure data and maths: shared by the server AI and the client marker.
local Zones = {}

export type Zone = { Id: string, Name: string, X0: number, X1: number, Z0: number, Z1: number }
export type Door = { A: string, B: string, X: number, Z: number, Name: string }

-- Z0 is the north (higher z) edge, Z1 the south edge.
Zones.List = table.freeze({
	{ Id = "Landing", Name = "the gate landing", X0 = -26, X1 = 26, Z0 = -690, Z1 = -752 },
	{ Id = "Courtyard", Name = "the courtyard", X0 = -82, X1 = 82, Z0 = -752, Z1 = -858 },
	{ Id = "Halls", Name = "the prayer halls", X0 = -102, X1 = 118, Z0 = -858, Z1 = -936 },
	{ Id = "Bridge", Name = "the ravine bridge", X0 = -12, X1 = 12, Z0 = -930, Z1 = -990 },
	{ Id = "Road", Name = "the south road", X0 = -14, X1 = 14, Z0 = -988, Z1 = -1124 },
	{ Id = "Cloister", Name = "the cloister", X0 = 14, X1 = 128, Z0 = -990, Z1 = -1114 },
	{ Id = "Graves", Name = "the grave field", X0 = -132, X1 = -14, Z0 = -990, Z1 = -1112 },
	{ Id = "WestReach", Name = "the waterfall path", X0 = -180, X1 = -82, Z0 = -752, Z1 = -936 },
	{ Id = "EastPass", Name = "the ridge pass", X0 = 82, X1 = 404, Z0 = -786, Z1 = -1034 },
} :: { Zone })

Zones.Doors = table.freeze({
	{ A = "Landing", B = "Courtyard", X = 0, Z = -752, Name = "Gatehouse" },
	{ A = "Courtyard", B = "Halls", X = 0, Z = -858, Name = "Processional path" },
	{ A = "Halls", B = "Bridge", X = 0, Z = -932, Name = "Bridge" },
	{ A = "Bridge", B = "Road", X = 0, Z = -989, Name = "Far bridgehead" },
	{ A = "Road", B = "Cloister", X = 14, Z = -1012, Name = "Cloister gateway" },
	{ A = "Road", B = "Graves", X = -14, Z = -1040, Name = "Grave field" },
	{ A = "Courtyard", B = "EastPass", X = 82, Z = -811, Name = "Ridge pass" },
	{ A = "Courtyard", B = "WestReach", X = -82, Z = -830, Name = "West postern" },
	{ A = "WestReach", B = "Halls", X = -102, Z = -880, Name = "Hall breach" },
} :: { Door })

-- Which zone each Monastery spawn may fight in (the Sparring Phantom keeps its own short leash).
Zones.Spawns = table.freeze({
	DM_Monk_Courtyard_A = "Courtyard", DM_Monk_Courtyard_B = "Courtyard", DM_Monk_Courtyard_C = "Courtyard",
	DM_Monk_Hall_A = "Halls", DM_Monk_Hall_B = "Halls", DM_Swordsman_Bridge = "Bridge",
	DM_Monk_Cloister = "Cloister", DM_Swordsman_Cloister = "Cloister",
})
Zones.Grace = 6 -- studs a foe may follow past its zone edge (doorway fights stay fair)

-- Authored footpaths (x, z polylines) that terrain, scatter and dressing keep clear: the secret
-- waterfall path (west postern -&gt; alcove -&gt; west hall breach) and the walk to the mausoleum.
Zones.WestPath = table.freeze({ { -84, -830 }, { -100, -828 }, { -116, -831 }, { -128, -835 }, { -122, -850 }, { -114, -866 }, { -106, -878 }, { -100, -880 } })
Zones.GravePath = table.freeze({ { -14, -1046 }, { -30, -1066 }, { -74, -1068 }, { -104, -1068 }, { -110, -1067 } })
Zones.Alcove = table.freeze({ X = -140, Z = -840 })

function Zones.distanceToPath(path: { { number } }, x: number, z: number): number
	local best = math.huge
	for k = 1, #path - 1 do
		local a, b = path[k], path[k + 1]
		local dx, dz = b[1] - a[1], b[2] - a[2]
		local t = math.clamp(((x - a[1]) * dx + (z - a[2]) * dz) / (dx * dx + dz * dz), 0, 1)
		best = math.min(best, math.sqrt((x - a[1] - dx * t) ^ 2 + (z - a[2] - dz * t) ^ 2))
	end
	return best
end

function Zones.get(id: string): Zone?
	for _, zone in Zones.List do
		if zone.Id == id then return zone end
	end
	return nil
end

function Zones.contains(zone: Zone, x: number, z: number, margin: number?): boolean
	local m = margin or 0
	return x &gt;= zone.X0 - m and x &lt;= zone.X1 + m and z &lt;= zone.Z0 + m and z &gt;= zone.Z1 - m
end

-- The zone containing a point (first match; the bridge wins over the halls' south strip).
function Zones.at(x: number, z: number): Zone?
	local best: Zone? = nil
	for _, zone in Zones.List do
		if Zones.contains(zone, x, z) and (best == nil or (zone.X1 - zone.X0) * (zone.Z0 - zone.Z1) &lt; (best.X1 - best.X0) * (best.Z0 - best.Z1)) then
			best = zone
		end
	end
	return best
end

-- Doorways from zone `from` to zone `to` along the fewest crossings (breadth first).
function Zones.path(from: string, to: string): { Door }
	if from == to then return {} end
	local previous: { [string]: Door } = {}
	local seen, queue = { [from] = true }, { from }
	while #queue &gt; 0 do
		local here = table.remove(queue, 1) :: string
		for _, door in Zones.Doors do
			local other = if door.A == here then door.B elseif door.B == here then door.A else nil
			if other and not seen[other] then
				seen[other], previous[other] = true, door
				table.insert(queue, other)
			end
		end
	end
	local doors: { Door } = {}
	local cursor = to
	while cursor ~= from do
		local door = previous[cursor]
		if not door then return {} end
		table.insert(doors, 1, door)
		cursor = if door.A == cursor then door.B else door.A
	end
	return doors
end

return Zones
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">NarrativeCatalog</string>
            <string name="Source">--!strict
export type Choice={Label: string,Next: string?,Action: string?,Close: boolean?}
export type Node={Text: string,Choices: {Choice}}
export type NPC={Name: string,X: number,Y: number,Z: number,Color: {number},Start: string,Nodes: {[string]: Node}}
export type Lore={Title: string,Region: string,X: number,Y: number,Z: number,Qi: number,Text: string}
export type Trade={Name: string,Price: number}
local Catalog: {Premise: string,NPCs: {[string]: NPC},Lore: {[string]: Lore},Trades: {[string]: Trade},Sovereigns: {string},LoreOrder: {string}}={Premise="",NPCs={},Lore={},Trades={},Sovereigns={},LoreOrder={}}
Catalog.Premise="Grandmaster Shen devoured his disciples and shattered the celestial pillars. You are an Asura Emissary: a wandering phantom barred from the afterlife until the six Fallen Sovereigns are laid to rest."
Catalog.NPCs={
 Gao={Name="Master Smith Gao",X=-86,Y=603,Z=899,Color={74,57,49},Start="Greeting",Nodes={
  Greeting={Text="I lost my eyes to the &lt;i&gt;Jade Cataclysm&lt;/i&gt;. Still, I can hear the blood upon your blade. What burden have you brought?",Choices={
   {Label="Reinforce or infuse my weapon",Next="Forge",Action="Forge"},{Label="What can a sovereign's soul become?",Next="Remembrance"},{Label="Farewell",Close=true}}},
  Forge={Text="Iron remembers every wound. Bring ore, starfall, and dragonite; I will teach your steel to remember you.",Choices={{Label="Return",Next="Greeting"},{Label="Farewell",Close=true}}},
  Remembrance={Text="A fallen sovereign leaves a remembrance. Discover one and its weapon or sorcery becomes yours to forge. One soul, one choice.",Choices={{Label="Show discovered remembrances",Next="Greeting",Action="Arsenal"},{Label="Return",Next="Greeting"}}},
 }},
 Lin={Name="Lady Lin · Shrine Maiden",X=8,Y=603,Z=918,Color={145,121,117},Start="Greeting",Nodes={
  Greeting={Text="Emissary, the incense knows your name. Your soul cannot cross while the six sovereigns bind the Abyss. Rest, and let stolen Qi become strength.",Choices={
   {Label="Guide my Ascension",Next="Ascend",Action="Level"},{Label="Tell me of Shen",Next="Shen"},{Label="Farewell",Close=true}}},
  Ascend={Text="Vigor shelters the soul. Endurance steadies the stance. Strength and Dexterity guide steel; Arcane Qi gives sorrow a voice.",Choices={{Label="Return",Next="Greeting"},{Label="Farewell",Close=true}}},
  Shen={Text="He called it salvation. Six disciples became sovereigns, their souls chained to the broken pillars. Lay all six to rest, and the road beyond death may open.",Choices={{Label="Return",Next="Greeting"}}},
 }},
 Hermit={Name="Wandering Hermit",X=-14,Y=3,Z=-738,Color={77,86,70},Start="Greeting",Nodes={
  Greeting={Text="The gate remembers footsteps that have yet to fall. A talisman, phantom? Or the price of knowing?",Choices={
   {Label="Trade for talismans and gems",Next="Trade",Action="Trade"},{Label="Whisper a sovereign's weakness",Next="Weakness"},{Label="Farewell",Close=true}}},
  Trade={Text="A ward may turn a fatal blow. Ore will never rust in a phantom's hand. My prices are fixed; the Abyss has had enough chance.",Choices={{Label="Return",Next="Greeting"},{Label="Farewell",Close=true}}},
  Weakness={Text="Deflect Shen's discipline, evade his hunger. Leap over the frost serpent's sweep. Strike the titan's ankles; separate the twin sentinels before their grief becomes one.",Choices={{Label="Return",Next="Greeting"}}},
 }},
}
-- Batches 17/20: the Bamboo and Pagoda tablets stand on their regions' authored routes (layout marks;
-- Wraith had stood inside Baize's arena and Dawn on Wu's arena wall). Y is the floor + 3.
Catalog.Lore={
 Pillars={Title="I · The Six Pillars",Region="DesecratedMonastery",X=13,Y=3,Z=-740,Qi=100,Text="Six celestial pillars held the Abyss beneath the jade mountain. Each bore a disciple's vow. Shen alone was trusted with their names."},
 Feast={Title="II · The Last Supper",Region="DesecratedMonastery",X=48,Y=3,Z=-830,Qi=125,Text="The bowls were set for seven. At dawn, only the master's shadow remained. It cast six faces upon the wall."},
 Bell={Title="III · A Bell Without Echo",Region="DesecratedMonastery",X=-55,Y=3,Z=-918,Qi=125,Text="The monastery bell rang once when the first pillar fell. The second swallowed its echo. The sixth silenced the dead."},
 Emissary={Title="IV · The Uncrossed River",Region="DesecratedMonastery",X=72,Y=3,Z=-1070,Qi=150,Text="A phantom stood at the river of souls. The ferryman counted six chains around its heart. 'Return them to rest,' he said, 'and I shall return for you.'"},
 Bamboo={Title="V · Jade in the Roots",Region="BambooPass",X=-18,Y=3,Z=-1140,Qi=150,Text="Jade splinters fell like rain. Bamboo drank the scattered Qi, and its leaves began to whisper the disciples' forgotten prayers."},
 Wraith={Title="VI · What Death Cannot Keep",Region="BambooPass",X=128,Y=21.2,Z=-1428,Qi=175,Text="The Emissary left a crimson wraith where its borrowed body fell. One memory could be reclaimed. A second death erased the first."},
 Pagoda={Title="VII · The Empty Throne",Region="CelestialPagoda",X=-132,Y=17,Z=-2262,Qi=200,Text="Above the clouded stair, the throne stood empty. Sovereignty was never a crown. It was the wound left where a soul had been."},
 Dawn={Title="VIII · The Unwritten Dawn",Region="CelestialPagoda",X=-20,Y=3,Z=-2500,Qi=250,Text="Gao forged no chain for the seventh soul. Lin kept no incense for its passing. The hermit alone smiled: 'Some endings must be chosen by the dead.'"},
}
Catalog.Trades={SpiritIronOre={Name="Spirit Iron Ore",Price=80},StarfallShard={Name="Starfall Shard",Price=240},DragoniteCore={Name="Dragonite Core",Price=700},
 CrimsonFireGem={Name="Crimson Fire Gem",Price=600},CelestialLightningGem={Name="Celestial Lightning Gem",Price=600},AbyssalVoidGem={Name="Abyssal Void Gem",Price=600},
 LastBreathTalisman={Name="Last Breath Talisman · prevents one fatal blow for 30s",Price=400}}
Catalog.Sovereigns={"GrandmasterShen","VenerableBaize","SlumberingTitan","SovereignWu","TwinSentinels","AzureWyrm"}
Catalog.LoreOrder={"Pillars","Feast","Bell","Emissary","Bamboo","Wraith","Pagoda","Dawn"}
-- Batch 22: the six-sovereign ending (EndingRules picks the node). Release is spoken in person beside her
-- bonfire; Cross and Remain are server-recorded choices (story flags) that grant nothing and can be repeated.
Catalog.NPCs.Lin.Nodes.Release={Text="Six chains have fallen silent. The ferryman waits beyond the jade dawn. You may cross, Emissary—or remain a little longer, and carry their names where the living have forgotten.",Choices={{Label="Cross the river of souls",Next="Release",Action="Cross"},{Label="Remain a little longer",Next="Release",Action="Remain"},{Label="Guide my Ascension",Next="Ascend",Action="Level"},{Label="Farewell",Close=true}}}
Catalog.NPCs.Lin.Nodes.Summons={Text="Six chains have fallen silent. The crossing cannot be made through incense smoke, Emissary. Come home to the Primal Bonfire; I will be waiting beside it.",Choices={{Label="Guide my Ascension",Next="Ascend",Action="Level"},{Label="Farewell",Close=true}}}
Catalog.NPCs.Lin.Nodes.Postgame={Text="You crossed, and the river carried you back to the incense. Your path is your own now, Emissary. Walk it as long as you wish.",Choices={{Label="Walk the crossing again",Next="Postgame",Action="Cross"},{Label="Guide my Ascension",Next="Ascend",Action="Level"},{Label="Farewell",Close=true}}}
local function freeze(t: any) for _,v in t do if type(v)=="table" then freeze(v) end end;table.freeze(t) end
freeze(Catalog)
return Catalog
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Objectives</string>
            <string name="Source">--!strict
local hasScript = pcall(function() return script.Parent end)
local Ending: any = if hasScript then require(script.Parent.EndingRules) else require("./EndingRules")
local Objectives = {}

export type Facts = {
	Region: string?,
	Bosses: { [string]: boolean }?,
	Altars: { [string]: boolean },
	Bloodstain: Vector3?,
	StainRegion: string?, -- region the bloodstain lies in (portal-aware guidance, #28)
	InBoss: boolean,
	InColosseum: boolean,
	BossFelled: boolean,
	-- True once the player has rested at any altar this session (teaches the rest loop first).
	Rested: boolean,
	Story: { [string]: boolean }?, -- six-sovereign ending flags (batch 22)
}

export type Target = { Kind: "Altar", Id: string } | { Kind: "Portal" } | { Kind: "Point", Position: Vector3 }

export type Objective = {
	Key: string,
	Title: string,
	Detail: string,
	Target: Target?,
}

type AltarInfo = { Id: string, Name: string, Region: string }

local ROUTE: { AltarInfo } = {
	{ Id = "Altar_SanctuaryBonfire", Name = "Primal Bonfire", Region = "Sanctuary" },
	{ Id = "Altar_MonasteryGate", Name = "Monastery Gate", Region = "DesecratedMonastery" },
	{ Id = "Altar_DesecratedCloister", Name = "Desecrated Cloister", Region = "DesecratedMonastery" },
	{ Id = "Altar_BambooShrine", Name = "Whispering Bamboo Shrine", Region = "BambooPass" },
	{ Id = "Altar_ColosseumAntechamber", Name = "Colosseum Antechamber", Region = "AshColosseum" },
}
Objectives.Route = ROUTE

local BOSS_APPROACH = Vector3.new(0, 3, -1880)
-- The Sanctuary's northern gate always delivers to this altar (WorldDefinitions.Sanctuary.PortalDestination).
local PORTAL_ARRIVAL = ROUTE[2]

-- Sanctuary wording (batch 07, #29): name the portal's real destination first, then the next leg.
function Objectives.portalDetail(altar: AltarInfo): string
	if altar.Id == PORTAL_ARRIVAL.Id then
		return "The northern gate opens on the " .. PORTAL_ARRIVAL.Name .. " · kneel at its altar"
	end
	local leg = if altar.Region == PORTAL_ARRIVAL.Region then "press on through the monastery" else "travel on"
	return "The northern gate opens on the " .. PORTAL_ARRIVAL.Name .. " · then " .. leg .. " to the " .. altar.Name
end

function Objectives.parseAltars(value: any): { [string]: boolean }
	local set: { [string]: boolean } = {}
	if type(value) == "string" then
		for id in string.gmatch(value, "[^,]+") do
			set[id] = true
		end
	end
	return set
end

function Objectives.regionOf(altarId: string): string?
	local expanded: { [string]: string } = { Altar_SanctuaryDepths = "SanctuaryDepths", Altar_CelestialPagoda = "CelestialPagoda", Altar_SkyCitadel = "SkyCitadel" }
	if expanded[altarId] then return expanded[altarId] end
	for _, altar in ROUTE do
		if altar.Id == altarId then
			return altar.Region
		end
	end
	return nil
end

local ENCOUNTERS = {
	{ Id = "TwinSentinels", Name = "The Twin Sentinels", Region = "DesecratedMonastery", Position = Vector3.new(300, 3, -822) },
	{ Id = "VenerableBaize", Name = "Venerable Baize", Region = "BambooPass", Position = Vector3.new(0, 3, -1362) },
	{ Id = "GrandmasterShen", Name = "Grandmaster Shen", Region = "AshColosseum", Position = BOSS_APPROACH },
	{ Id = "SlumberingTitan", Name = "The Slumbering Titan", Region = "SanctuaryDepths", Position = Vector3.new(520, 3, 988) },
	{ Id = "SovereignWu", Name = "Sovereign Wu", Region = "CelestialPagoda", Position = Vector3.new(0, 3, -2272) },
	{ Id = "AzureWyrm", Name = "Azure Wyrm", Region = "SkyCitadel", Position = Vector3.new(0, 3, -2722) },
}
Objectives.Encounters = ENCOUNTERS

-- Whether the tracker must redraw: a new step, or the same step with new wording (the bloodstain
-- card names a different leg after a death moves the player to another region; follow-up 14).
function Objectives.changed(shown: Objective?, latest: Objective?): boolean
	if shown == nil or latest == nil then return shown ~= latest end
	return shown.Key ~= latest.Key or shown.Title ~= latest.Title or shown.Detail ~= latest.Detail
end

function Objectives.resolve(facts: Facts): Objective?
	if facts.InColosseum or facts.InBoss then
		return nil
	end
	if facts.Bloodstain then
		return {
			Key = "Bloodstain",
			Title = "Reclaim your lost essence",
			-- Name the leg the marker stages (RouteGuide): the Well for the crypt, the return portal home.
			Detail = if facts.Region == "Sanctuary" and facts.StainRegion == "SanctuaryDepths"
				then "Take the Well of Descent first · the marker then leads to your bloodstain"
				elseif facts.Region == "Sanctuary" and facts.StainRegion ~= nil and facts.StainRegion ~= "Sanctuary"
				then "Take the northern gate first · the marker then leads to your bloodstain"
				elseif facts.StainRegion == "Sanctuary" and (facts.Region == "SanctuaryDepths" or facts.Region == "SkyCitadel")
				then "Take the return portal first · the marker then leads to your bloodstain"
				else "Return to your bloodstain before you fall again",
			Target = { Kind = "Point", Position = facts.Bloodstain },
		}
	end
	-- Six sovereigns at rest (batch 22): home to Lin, then the choice; PvP is never the conclusion.
	if facts.Bosses then
		local home = nil
		for _, id in { ROUTE[2].Id, ROUTE[3].Id, ROUTE[4].Id, ROUTE[5].Id, "Altar_SanctuaryDepths", "Altar_CelestialPagoda", "Altar_SkyCitadel" } do
			if not home and facts.Altars[id] and Objectives.regionOf(id) == facts.Region then home = id end
		end
		local ending = Ending.objective(Ending.stage(facts.Bosses, facts.Story), facts.Region, home)
		if ending then return ending end
	end
	-- New profiles start with the bonfire pre-kindled; still walk a newcomer through one rest.
	local bonfire = ROUTE[1]
	if not facts.Rested and not facts.Altars[ROUTE[2].Id] and (facts.Region == "Sanctuary" or facts.Region == nil) then
		return {
			Key = "FirstRest",
			Title = "Kneel at the " .. bonfire.Name,
			Detail = "Resting sets your respawn point and refills your gourd",
			Target = { Kind = "Altar", Id = bonfire.Id },
		}
	end
	for _, altar in ROUTE do
		if not facts.Altars[altar.Id] and (not facts.Bosses or altar.Region == facts.Region or facts.Region == "Sanctuary" or facts.Region == nil) then
			if altar.Region == "Sanctuary" then
				return {
					Key = altar.Id,
					Title = "Kneel at the " .. altar.Name,
					Detail = "Resting sets your respawn point and refills your gourd",
					Target = { Kind = "Altar", Id = altar.Id },
				}
			elseif facts.Region == "Sanctuary" or facts.Region == nil then
				return {
					Key = "Ascend:" .. altar.Id,
					Title = "Climb the Ascension Stairs",
					Detail = Objectives.portalDetail(altar),
					Target = { Kind = "Portal" },
				}
			end
			return {
				Key = altar.Id,
				Title = "Kindle the " .. altar.Name,
				Detail = if altar.Id == PORTAL_ARRIVAL.Id then "The altar stands just ahead of the portal · rest to set your checkpoint"
					else "Fight your way forward — altars mark safe ground",
				Target = { Kind = "Altar", Id = altar.Id },
			}
		end
	end
	if facts.Bosses then
		local nextBoss = nil
		for _, boss in ENCOUNTERS do
			if not facts.Bosses[boss.Id] then
				nextBoss = nextBoss or boss
				if boss.Region == facts.Region then nextBoss = boss; break end
			end
		end
		if nextBoss then
			local approach = nextBoss.Position
			-- The Well of Descent south of the plaza (SanctuaryRoutes.Marks.CryptDescent, batch 16).
			if nextBoss.Id == "SlumberingTitan" and facts.Region == "Sanctuary" then approach = Vector3.new(0, 605, 996) end
			return { Key = "Boss:" .. nextBoss.Id, Title = "Challenge " .. nextBoss.Name,
				Detail = "Traverse the arena mist in " .. string.gsub(nextBoss.Region, "(%l)(%u)", "%1 %2"), Target = { Kind = "Point", Position = approach } }
		end
	elseif not facts.BossFelled then
		return {
			Key = "Boss",
			Title = "Pass the fog gate",
			Detail = "Grandmaster Shen awaits beyond the Ash Colosseum",
			Target = { Kind = "Point", Position = BOSS_APPROACH },
		}
	end
	return {
		Key = "Duel",
		Title = "Prove yourself in the Colosseum",
		Detail = "Travel to the Sanctuary and challenge a rival on the east balcony",
		Target = nil,
	}
end

return Objectives
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">PresentationAssets</string>
            <string name="Source">--!strict
-- Only owned, uploaded IDs belong here. Missing textures stay disabled; never fake an ID.
-- SoundService.AsuraAudio/&lt;key&gt; Sound templates can override Audio slots in Studio.
local Assets = {}
Assets.Audio = {
	Clash = "rbxassetid://112256493525265", ParryBass = "rbxassetid://132244224106707", Flesh = "rbxassetid://135539914951495", Blunt = "rbxassetid://96420173928383", Stone = "rbxassetid://99727362444008",
	BulletJump = "rbxassetid://100694818881612", Glide = "rbxassetid://120377372310702", Slide = "rbxassetid://96988662266744", Wind = "rbxassetid://122450130719273", Bell = "rbxassetid://123385330740698", Water = "rbxassetid://113213311649809", BossDrone = "rbxassetid://123393717022210",
	-- Signature-spell score (tools/assets/build_skill_audio.py, uploaded 2026-10-24); SkillAudio pitches owned stand-ins if a slot is blank.
	NovaVoid = "rbxassetid://129359188549606", NovaRing = "rbxassetid://134564910653256", NovaSwoop = "rbxassetid://110060527562569", NovaPlanet = "rbxassetid://70380265927325", NovaCharge = "rbxassetid://112033209229095", NovaBlast = "rbxassetid://133807813064998", NovaInk = "rbxassetid://131991190965773", NovaColumn = "rbxassetid://107313082560233", NovaWhite = "rbxassetid://96092388966263",
	SunTension = "rbxassetid://100202591727169", SunBoom = "rbxassetid://75096821018311", SunEmber = "rbxassetid://86447083540632", SunThorn = "rbxassetid://81636168021067", SunCharge = "rbxassetid://105215829186624", SunBlast = "rbxassetid://136996507247009", SunEyes = "rbxassetid://116302876643156", SunGauntlet = "rbxassetid://109867440300434", SunPulse = "rbxassetid://103546737552644",
}
Assets.Textures = {
	Ember = "rbxassetid://71210522377346", Smoke = "rbxassetid://118836433841190", Flame = "rbxassetid://109612319904107", Blood = "rbxassetid://130551791057565", BloodStain = "rbxassetid://127759159077031", Rune = "rbxassetid://122602029003354",
	Shockwave = "rbxassetid://83732553901476", Ribbon = "rbxassetid://103002669230055", Leaf = "rbxassetid://79417774806659", LeafScatter = "rbxassetid://85184122225102", CrimsonBranch = "rbxassetid://133941376172785", Ash = "rbxassetid://84748845356339",
}
Assets.Sky = { Back = "rbxassetid://87628549041414", Down = "rbxassetid://103952866093370", Front = "rbxassetid://77637140898450", Left = "rbxassetid://83782412023406", Right = "rbxassetid://126646523881532", Up = "rbxassetid://94728124992475" }
-- Golden-hour Shrine sky (tools/assets/make_sunset_sky.py; assignment verified in Studio, assets/LOBBY_SKY_UPLOADED.json).
Assets.SunsetSky = { Front = "rbxassetid://108067720936233", Back = "rbxassetid://91892434596631", Left = "rbxassetid://132527418910759", Right = "rbxassetid://135495662234371", Up = "rbxassetid://111642714464286", Down = "rbxassetid://118353493252474" }
Assets.Limits = { Voices = 32, Bursts = 16, Shards = 96, Stains = 20, TrailActors = 24, Scenery = 100 }
return table.freeze(Assets)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">ProgressionRules</string>
            <string name="Source">--!strict
-- Engine-free progression math shared by persistence, combat, menus and tests.
local Rules = {}
local INFUSIONS: {[string]: string}={CrimsonFire="CrimsonFireGem", CelestialLightning="CelestialLightningGem", AbyssalVoid="AbyssalVoidGem"}
Rules.Attributes = table.freeze({"Vigor", "Endurance", "Strength", "Dexterity", "ArcaneQi"})
Rules.Infusions = table.freeze(INFUSIONS)
function Rules.level(a: {[string]: number}): number
 local n=1;for _,key in Rules.Attributes do n+=a[key]-10 end;return n
end
function Rules.levelCost(n: number): number return math.floor(150*math.max(1,n)^1.4) end
local function cap(n: number,early: number,mid: number,late: number): number
 local p=math.max(0,n-10);return math.min(p,30)*early+math.clamp(p-30,0,20)*mid+math.max(0,p-50)*late
end
function Rules.stats(a: {[string]: number},tier: number): {[string]: number}
 local forge=1+0.1*tier
 return {HPBonus=cap(a.Vigor,6,3,1), StaminaBonus=cap(a.Endurance,2.5,1.2,0.4),
  PostureBonus=cap(a.Endurance,1.5,0.8,0.3), MaxQi=100+cap(a.ArcaneQi,3,1.5,0.5),
  RallyScale=1+cap(a.Vigor,0.015,0.0075,0.0025), SpellScale=1+cap(a.ArcaneQi,0.025,0.0125,0.004),
  StrengthScale=(1+cap(a.Strength,0.018,0.009,0.003))*forge,
  DexterityScale=(1+cap(a.Dexterity,0.018,0.009,0.003))*forge}
end
function Rules.upgradeCost(tier: number): (number,string,number)
 local material=if tier&lt;4 then "SpiritIronOre" elseif tier&lt;8 then "StarfallShard" else "DragoniteCore"
 return math.floor(250*(tier+1)^1.5),material,if tier&lt;4 then tier+1 elseif tier&lt;8 then tier-3 else tier-7
end
function Rules.upgrade(p: any,weapon: string): string
 local w=assert(p.inventory.Weapons[weapon],"Weapon is locked");assert(w.Level&lt;10,"Weapon is already +10")
 local cost,ore,count=Rules.upgradeCost(w.Level)
 assert(p.qiEssence&gt;=cost,"Not enough Essence");assert((p.inventory.Materials[ore] or 0)&gt;=count,"Missing "..ore)
 p.qiEssence-=cost;p.inventory.Materials[ore]-=count;w.Level+=1
 return "Reinforced "..weapon.." +"..w.Level
end
function Rules.infuse(p: any,weapon: string,affinity: string): string
 local gem=assert(Rules.Infusions[affinity],"Unknown infusion")
 local w=assert(p.inventory.Weapons[weapon],"Weapon is locked");assert(w.Infusion~=affinity,"Already infused")
 assert((p.inventory.Materials[gem] or 0)&gt;=1,"Missing "..gem);assert(p.qiEssence&gt;=300,"Not enough Essence")
 p.inventory.Materials[gem]-=1;p.qiEssence-=300;w.Infusion=affinity;return "Infused "..weapon
end
function Rules.affinity(id: string?,a: {[string]: number}): {[string]: number}
 return {Burn=if id=="CrimsonFire" then 2*(1+(a.Strength-10)*0.025) else 0,
  Stun=if id=="CelestialLightning" then 5*(1+(a.Dexterity-10)*0.025) else 0,
  GuardPierce=if id=="AbyssalVoid" then 0.3 else 0,
  VoidScale=if id=="AbyssalVoid" then 1+(a.ArcaneQi-10)*0.01 else 1}
end
function Rules.masteryRank(xp: number): number
 local rank=1;for index,threshold in {0,100,300,700,1500} do if xp&gt;=threshold then rank=index end end;return rank
end
function Rules.discover(p: any,id: string,reward: number): boolean
 if p.inventory.LoreEntries[id] then return false end
 p.inventory.LoreEntries[id]=true;p.qiEssence+=reward;return true
end
function Rules.mastery(p: any,weapon: string,xp: number)
 if not p.inventory.Weapons[weapon] then return end
 p.weaponMastery[weapon]=math.min(9007199254740991,(p.weaponMastery[weapon] or 0)+xp)
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">RPGInventory</string>
            <string name="Source">--!strict
local hasScript=pcall(function() return script.Parent end)
local Rules: any=if hasScript then require(script.Parent.ProgressionRules) else require("./ProgressionRules")
local Weapons: any=if hasScript then require(script.Parent.Parent.Simulation.WeaponSchema) else require("../simulation/WeaponSchema")
local Spells: any=if hasScript then require(script.Parent.Parent.Simulation.SpellSchema) else require("../simulation/SpellSchema")
local Inventory={}
function Inventory.integer(v: any,lo: number,hi: number): boolean
 return type(v)=="number" and v==v and v&gt;=lo and v&lt;=hi and v%1==0
end
function Inventory.id(v: any): boolean
 return type(v)=="string" and #v&gt;0 and #v&lt;=64 and string.match(v,"^[%w_]+$")~=nil
end
function Inventory.flags(raw: any): {[string]: boolean}
 local result={};if type(raw)=="table" then for k,v in raw do if Inventory.id(k) and v==true then result[k]=true end end end;return result
end
function Inventory.defaults(): any
 return {Weapons={Unarmed={Level=0},Jian={Level=0}},Spells={ThunderclapPalm=true,GaleStep=true},Materials={},LoreEntries={}}
end
function Inventory.migrate(raw: any,legacy: any): any
 local i=Inventory.defaults();raw=if type(raw)=="table" then raw else {};legacy=if type(legacy)=="table" then legacy else {}
 for id,w in (if type(raw.Weapons)=="table" then raw.Weapons else {}) do
  if Weapons.Weapons[id] and type(w)=="table" then
   i.Weapons[id]={Level=if Inventory.integer(w.Level,0,10) then w.Level else 0,
    Infusion=if type(w.Infusion)=="string" and Rules.Infusions[w.Infusion] then w.Infusion else nil}
  end
 end
 for id,owned in (if type(legacy.weapons)=="table" then legacy.weapons else {}) do
  if owned==true and Weapons.Weapons[id] and not i.Weapons[id] then
   local tier=if type(legacy.reinforcement)=="table" then legacy.reinforcement[id] else nil
   i.Weapons[id]={Level=if Inventory.integer(tier,0,10) then tier else 0}
  elseif owned==true and i.Weapons[id] and raw.Weapons==nil then
   local tier=if type(legacy.reinforcement)=="table" then legacy.reinforcement[id] else nil
   if Inventory.integer(tier,0,10) then i.Weapons[id].Level=tier end
  end
 end
 for _,set in {raw.Spells,legacy.spells} do
  if type(set)=="table" then for id,flag in set do if flag==true and Spells.ById[id] then i.Spells[id]=true end end end
 end
 if type(raw.Materials)=="table" then
  for id,count in raw.Materials do if Inventory.id(id) and Inventory.integer(count,0,9007199254740991) then i.Materials[id]=count end end
 end
 i.LoreEntries=Inventory.flags(raw.LoreEntries);return i
end
function Inventory.validate(i: any): boolean
 if type(i)~="table" then return false end
 for _,key in {"Weapons","Spells","Materials","LoreEntries"} do
  if type(i[key])~="table" then return false end
  local n=0;for _ in i[key] do n+=1 end;if n&gt;512 then return false end
 end
 for id,w in i.Weapons do
  if not Weapons.Weapons[id] or type(w)~="table" or not Inventory.integer(w.Level,0,10)
   or (w.Infusion~=nil and (type(w.Infusion)~="string" or not Rules.Infusions[w.Infusion])) then return false end
 end
 for id,v in i.Spells do if not Spells.ById[id] or v~=true then return false end end
 for id,v in i.Materials do if not Inventory.id(id) or not Inventory.integer(v,0,9007199254740991) then return false end end
 for id,v in i.LoreEntries do if not Inventory.id(id) or v~=true then return false end end
 return i.Weapons.Unarmed~=nil and i.Weapons.Jian~=nil
end
return table.freeze(Inventory)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">RPGProfile</string>
            <string name="Source">--!strict
local hasScript=pcall(function() return script.Parent end)
local I: any=if hasScript then require(script.Parent.RPGInventory) else require("./RPGInventory")
local Rules: any=if hasScript then require(script.Parent.ProgressionRules) else require("./ProgressionRules")
local Arena: any=if hasScript then require(script.Parent.ArenaRules) else require("./ArenaRules")
local RPG={}
function RPG.apply(p: any,raw: any)
 raw=if type(raw)=="table" then raw else {}
 local s=if type(raw.souls)=="table" then raw.souls else {}
 local a=if type(raw.attributes)=="table" then raw.attributes else {}
 local s_attr=if type(s.attributes)=="table" then s.attributes else {}
 local world=if type(s.world)=="table" then s.world else {}
 p.qiEssence=if I.integer(raw.qiEssence,0,9007199254740991) then raw.qiEssence
  else (if I.integer(raw.fightCash,0,9007199254740991) then raw.fightCash else (if I.integer(s.essence,0,9007199254740991) then 0 else 500))+(if I.integer(s.essence,0,9007199254740991) then s.essence else 0)
 p.qiEssence=math.min(p.qiEssence,9007199254740991)
 p.attributes={}
 for _,name in Rules.Attributes do
  local value=a[name] or s_attr[name]
  if value==nil then value=if name=="Vigor" then (a.Vitality or s_attr.Vitality) elseif name=="Endurance" then (a.Qi or s_attr.Qi) else nil end
  p.attributes[name]=if I.integer(value,10,99) then value else 10
 end
 p.inventory=I.migrate(raw.inventory,s.inventory)
 local old=if type(s.inventory)=="table" then s.inventory else {}
 local loadout=if type(raw.equippedLoadout)=="table" then raw.equippedLoadout else {}
 local main=loadout.MainWeapon or old.mainhand;local off=loadout.OffWeapon or old.offhand
 p.equippedLoadout={MainWeapon=if type(main)=="string" and p.inventory.Weapons[main] then main else "Jian",
  OffWeapon=if type(off)=="string" and p.inventory.Weapons[off] then off else nil,ArmorSet=if I.id(loadout.ArmorSet) then loadout.ArmorSet else nil}
 for n=1,2 do
  local key="SpellSlot"..n;local id=loadout[key] or (if type(old.spellSlots)=="table" then (old.spellSlots :: any)[n] else nil)
  p.equippedLoadout[key]=if type(id)=="string" and p.inventory.Spells[id] then id else (if n==1 then "ThunderclapPalm" else "GaleStep")
 end
 p.defeatedBosses=I.flags(raw.defeatedBosses or world.bosses);p.unlockedAltars=I.flags(raw.unlockedAltars or world.altars)
 for id in I.flags(world.altars) do p.unlockedAltars[id]=true end
 for id in I.flags(world.bosses) do p.defeatedBosses[id]=true end
 p.unlockedAltars.Altar_SanctuaryBonfire=true
 local c=if type(raw.colosseum)=="table" then raw.colosseum else {}
 p.colosseum={Elo=if I.integer(c.Elo,0,5000) then c.Elo else p.elo,Wins=if I.integer(c.Wins,0,9007199254740991) then c.Wins else p.wins,
  Losses=if I.integer(c.Losses,0,9007199254740991) then c.Losses else p.losses,WinStreak=if I.integer(c.WinStreak,0,9007199254740991) then c.WinStreak else p.winStreak}
 p.colosseum.Rank=Arena.rank(p.colosseum.Elo,p.colosseum.Wins+p.colosseum.Losses+p.draws)
 p.weaponMastery={};for id,xp in (if type(raw.weaponMastery)=="table" then raw.weaponMastery else {}) do
  if p.inventory.Weapons[id] and I.integer(xp,0,9007199254740991) then p.weaponMastery[id]=xp end
 end
 p.arenaWagers={}
 for id,b in (if type(raw.arenaWagers)=="table" then raw.arenaWagers else {}) do
  assert(type(id)=="string" and #id&lt;=64 and type(b)=="table" and I.integer(b.Fighter,-9007199254740991,9007199254740991)
   and Arena.validWager(b.Amount) and (b.State=="Pending" or b.State=="Settled"),"Corrupt wager ledger")
  p.arenaWagers[id]={Fighter=b.Fighter,Amount=b.Amount,State=b.State}
 end
end
function RPG.validate(p: any): (boolean,string?)
 if not I.integer(p.qiEssence,0,9007199254740991) or type(p.attributes)~="table" then return false,"Invalid Qi or attributes" end
 for _,key in Rules.Attributes do if not I.integer(p.attributes[key],10,99) then return false,"Invalid "..key end end
 if not I.validate(p.inventory) or type(p.equippedLoadout)~="table" then return false,"Invalid RPG inventory" end
 local l=p.equippedLoadout
 if not p.inventory.Weapons[l.MainWeapon] or (l.OffWeapon~=nil and not p.inventory.Weapons[l.OffWeapon]) then return false,"Unowned loadout" end
 for _,key in {"SpellSlot1","SpellSlot2"} do if l[key]~=nil and not p.inventory.Spells[l[key]] then return false,"Unowned spell" end end
 if l.ArmorSet~=nil and not I.id(l.ArmorSet) then return false,"Invalid armor" end
 for _,key in {"defeatedBosses","unlockedAltars"} do
  if type(p[key])~="table" then return false,"Missing flags" end
  local n=0;for id,v in p[key] do n+=1;if n&gt;512 or not I.id(id) or v~=true then return false,"Invalid flags" end end
 end
 local c=p.colosseum;if type(c)~="table" or not I.integer(c.Elo,0,5000) then return false,"Invalid arena" end
 for _,key in {"Wins","Losses","WinStreak"} do if not I.integer(c[key],0,9007199254740991) then return false,"Invalid arena counter" end end
 if c.Rank~=Arena.rank(c.Elo,c.Wins+c.Losses+p.draws) then return false,"Invalid rank" end
 if type(p.weaponMastery)~="table" or type(p.arenaWagers)~="table" then return false,"Missing mastery or wagers" end
 for id,xp in p.weaponMastery do if not p.inventory.Weapons[id] or not I.integer(xp,0,9007199254740991) then return false,"Invalid mastery" end end
 local count=0;for id,b in p.arenaWagers do
  count+=1
  if count&gt;512 or type(id)~="string" or #id==0 or #id&gt;64 or type(b)~="table" or not I.integer(b.Fighter,-9007199254740991,9007199254740991)
   or not Arena.validWager(b.Amount) or (b.State~="Pending" and b.State~="Settled") then return false,"Invalid wager" end
 end
 return true,nil
end
return table.freeze(RPG)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">RegionLayout</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/RegionLayout
-- Construction vocabulary for the authored campaign regions (batches 16-21). Every walkable or
-- colliding piece of a region is an engine-free box (centre, size, yaw in degrees about +Y), so the
-- server builds exactly what the offline reachability suite (tools/test_campaign_regions.luau)
-- walks. Builders here only append boxes; materials and colours are chosen per Kind by the server.
local Layout = {}

export type Box = { Name: string, Kind: string, X: number, Y: number, Z: number, SX: number, SY: number, SZ: number, Yaw: number }
export type Return = { Name: string, X0: number, X1: number, Z0: number, Z1: number, Below: number, To: { X: number, Y: number, Z: number, Yaw: number } }
export type Zone = { Id: string, Name: string, X0: number, X1: number, Z0: number, Z1: number, Y0: number?, Y1: number? } -- Y band for stacked levels
export type Door = { A: string, B: string, X: number, Y: number, Z: number, Name: string, OneWay: boolean? } -- OneWay: A -&gt; B only (a drop)
export type Mark = { Name: string, X: number, Y: number, Z: number, Yaw: number }
export type Region = {
	Region: string,
	Solids: { Box },
	Returns: { Return },
	Zones: { Zone },
	Doors: { Door },
	SpawnZones: { [string]: string },
	Marks: { [string]: Mark },
	Groves: { { number } }?, -- {x0, x1, z0, z1, floor, count}: decorative scatter strips (non-colliding)
	Lights: { { number } }, -- {x, y, z}: lantern heads the dressing lights (their posts are Solids)
}

-- Kinds the server renders; "Veil" is an invisible colliding boundary, "Decor" never collides.
Layout.Kinds = table.freeze({
	Path = true, Ground = true, Grass = true, Rock = true, Snow = true, Timber = true, Lacquer = true,
	Stone = true, Ash = true, Basalt = true, Crypt = true, Marble = true, Bone = true, Water = true, Veil = true, Tile = true,
} :: { [string]: boolean })

function Layout.region(id: string): Region
	return { Region = id, Solids = {}, Returns = {}, Zones = {}, Doors = {}, SpawnZones = {}, Marks = {}, Lights = {} }
end

function Layout.box(r: Region, name: string, kind: string, x: number, y: number, z: number, sx: number, sy: number, sz: number, yaw: number?): Box
	assert(Layout.Kinds[kind], "Unknown layout kind " .. kind)
	local b: Box = { Name = name, Kind = kind, X = x, Y = y, Z = z, SX = sx, SY = sy, SZ = sz, Yaw = yaw or 0 }
	table.insert(r.Solids, b)
	return b
end

-- Axis-aligned floor slab by extents, its top at `top`.
function Layout.slab(r: Region, name: string, kind: string, x0: number, x1: number, z0: number, z1: number, top: number, thick: number?): Box
	local t = thick or 4
	return Layout.box(r, name, kind, (x0 + x1) / 2, top - t / 2, (z0 + z1) / 2, math.abs(x1 - x0), t, math.abs(z1 - z0))
end

-- A straight run of solid steps from (ax, az) at height y0 to (bx, bz) at height y1; every step
-- reaches down to the lower floor so nothing can be walked under or fallen through.
function Layout.stairs(r: Region, name: string, kind: string, ax: number, az: number, bx: number, bz: number, y0: number, y1: number, width: number, rise: number?)
	local h = rise or 1
	local count = math.max(1, math.floor(math.abs(y1 - y0) / h + 0.5))
	local dx, dz = (bx - ax) / count, (bz - az) / count
	local yaw = math.deg(math.atan2(-dx, -dz))
	local run = math.sqrt(dx * dx + dz * dz)
	local low, step = math.min(y0, y1), (y1 - y0) / count
	for i = 1, count do
		local top = y0 + step * i
		local height = top - low + 2
		Layout.box(r, name, kind, ax + dx * (i - 0.5), top - height / 2, az + dz * (i - 0.5), width, height, run + 0.05, yaw)
	end
end

-- A wall segment from (ax, az) to (bx, bz), standing on `base`.
function Layout.wall(r: Region, name: string, kind: string, ax: number, az: number, bx: number, bz: number, base: number, height: number, thick: number?): Box
	local dx, dz = bx - ax, bz - az
	return Layout.box(r, name, kind, (ax + bx) / 2, base + height / 2, (az + bz) / 2, thick or 2, height, math.sqrt(dx * dx + dz * dz), math.deg(math.atan2(-dx, -dz)))
end

-- A closed or open polyline of walls (e.g. an invisible boundary veil around a region).
function Layout.fence(r: Region, name: string, kind: string, points: { { number } }, base: number, height: number, thick: number?)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		Layout.wall(r, name, kind, a[1], a[2], b[1], b[2], base, height, thick)
	end
end

-- A standing stone lantern on `floor`: its post is solid (walked around), its head is lit decor.
function Layout.lantern(r: Region, x: number, floor: number, z: number)
	Layout.box(r, "LanternPost", "Stone", x, floor + 1.6, z, 1.4, 3.2, 1.4)
	table.insert(r.Lights, { x, floor + 3.9, z })
end

-- A hanging lantern (beams, galleries): light only, nothing to collide with.
function Layout.light(r: Region, x: number, y: number, z: number)
	table.insert(r.Lights, { x, y, z })
end

function Layout.mark(r: Region, key: string, name: string, x: number, y: number, z: number, yaw: number?)
	r.Marks[key] = { Name = name, X = x, Y = y, Z = z, Yaw = yaw or 0 }
end

function Layout.zone(r: Region, id: string, name: string, x0: number, x1: number, z0: number, z1: number, y0: number?, y1: number?)
	table.insert(r.Zones, { Id = id, Name = name, X0 = math.min(x0, x1), X1 = math.max(x0, x1), Z0 = math.max(z0, z1), Z1 = math.min(z0, z1), Y0 = y0, Y1 = y1 })
end

-- `optional`: a mobility route (jump chains) wayfinding uses only when no ordinary route exists.
function Layout.door(r: Region, a: string, b: string, x: number, y: number, z: number, name: string, oneWay: boolean?, optional: boolean?)
	table.insert(r.Doors, { A = a, B = b, X = x, Y = y, Z = z, Name = name, OneWay = oneWay, Optional = optional })
end

-- Falling below `below` inside the rectangle returns the body to `to` (Characters.Teleport).
function Layout.catch(r: Region, name: string, x0: number, x1: number, z0: number, z1: number, below: number, to: { number })
	table.insert(r.Returns, { Name = name, X0 = math.min(x0, x1), X1 = math.max(x0, x1), Z0 = math.max(z0, z1), Z1 = math.min(z0, z1), Below = below,
		To = { X = to[1], Y = to[2], Z = to[3], Yaw = to[4] or 0 } })
end

-- Pure: the return that holds this root position, if any.
function Layout.returnFor(region: Region, x: number, y: number, z: number): Return?
	for _, r in region.Returns do
		if x &gt;= r.X0 and x &lt;= r.X1 and z &lt;= r.Z0 and z &gt;= r.Z1 and y &lt; r.Below then
			return r
		end
	end
	return nil
end

-- Pure: is a point inside a box (yaw-only rotation)?
function Layout.inside(b: Box, x: number, y: number, z: number, margin: number?): boolean
	local m = margin or 0
	local lx, lz = x - b.X, z - b.Z
	local a = math.rad(b.Yaw)
	local c, s = math.cos(a), math.sin(a)
	local ux, uz = lx * c - lz * s, lx * s + lz * c
	return math.abs(ux) &lt;= b.SX / 2 + m and math.abs(y - b.Y) &lt;= b.SY / 2 + m and math.abs(uz) &lt;= b.SZ / 2 + m
end

function Layout.freeze(r: Region): Region
	local function deep(t: any)
		if type(t) == "table" and not table.isfrozen(t) then
			for _, v in t do deep(v) end
			table.freeze(t)
		end
	end
	deep(r)
	return r
end

return table.freeze(Layout)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">RouteGuide</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/RouteGuide
-- Staged wayfinding (batch 15, #28). Instead of pointing straight at a goal across walls, the
-- ravine or a world separation, the objective marker points at the next usable step: the
-- Sanctuary's northern gate when the goal (a bloodstain, an altar) lies beyond it, the crypt
-- descent for the Sunken Crypt, and inside the Desecrated Monastery the next doorway on the
-- walked route (gatehouse, processional path, bridgeheads, cloister gateway, west postern).
-- `Remaining` is the walked length through those doorways, not the straight-line distance.
-- Batches 16-21: the authored campaign regions stage the same way through CampaignZones (doors
-- carry their height, so the Pagoda's levels and the Citadel's stairs are walked, not flown), and
-- a goal past the Monastery's south road is reached through that road's doorways first.
-- Follow-up 14: every stage carries its whole `Route` (doorways in order, then the goal when it is
-- reached on foot) so the minimap draws the same walked line the marker stages. A route that leaves
-- the world through a portal ends at that portal: the northern gate, the Well of Descent, or the
-- crypt's and bastion's return portals when the goal lies back in the Sanctuary.
local Zones = require(script.Parent.MonasteryZones)
local World = require(script.Parent.WorldDefinitions)
local Campaign = require(script.Parent.CampaignZones)
local Routes = require(script.Parent.SanctuaryRoutes)

local Guide = {}

-- `Exit` names the portal a route ends at (its Position is the last point, or nil for the northern
-- gate, which the client resolves from the placed PortalTrigger).
export type Route = { Points: { Vector3 }, Names: { string }, Exit: string? }
export type Stage = { Kind: string, Position: Vector3?, Label: string?, Remaining: number?, Route: Route }

local descent = Routes.Marks.CryptDescent
Guide.CryptDescent = Vector3.new(descent.X, descent.Y + 5, descent.Z) -- the Well of Descent portal (batch 16)
Guide.Monastery = "DesecratedMonastery"
-- Regions whose own portal walks home to the Sanctuary (SunkenCryptLayout / SkyCitadelLayout marks).
local HOME = { "SanctuaryDepths", "SkyCitadel" }

local function flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

function Guide.regionOf(point: Vector3): string?
	return World.regionAt(point.X, point.Y, point.Z)
end

type Leg = { Points: { Vector3 }, Names: { string } }

local function monasteryLeg(doors: { Zones.Door }, y: number): Leg
	local leg: Leg = { Points = {}, Names = {} }
	for _, door in doors do
		table.insert(leg.Points, Vector3.new(door.X, y, door.Z)); table.insert(leg.Names, door.Name)
	end
	return leg
end

-- Inside a zone with an authored footpath (the grave field's walk past the toppled pagoda, Studio F14),
-- the route follows that path from the vertex nearest `entry` to the vertex nearest the goal.
local TRAILS: { [string]: { { number } } } = { Graves = Zones.GravePath }
local function nearest(path: { { number } }, p: Vector3): number
	local best, index = math.huge, 1
	for k, v in path do
		local d = (v[1] - p.X) ^ 2 + (v[2] - p.Z) ^ 2
		if d &lt; best then best, index = d, k end
	end
	return index
end
local function trail(leg: Leg, zoneId: string, entry: Vector3, goal: Vector3)
	local path = TRAILS[zoneId]
	if not path then return end
	local i, j = nearest(path, entry), nearest(path, goal)
	local step = if j &gt;= i then 1 else -1
	for k = i, j, step do
		table.insert(leg.Points, Vector3.new(path[k][1], goal.Y, path[k][2])); table.insert(leg.Names, "Grave path")
	end
end

-- The first doorway of a leg, and the walked length through all of them (campaign legs add the
-- height climbed; Monastery legs keep their flat batch 15 measure).
local function direct(goal: Vector3): Stage
	return { Kind = "Point", Position = goal, Label = nil, Remaining = nil, Route = { Points = { goal }, Names = { "" } } }
end

local function staged(from: Vector3, goal: Vector3, leg: Leg, climb: boolean?): Stage
	if #leg.Points == 0 then
		return direct(goal)
	end
	local walked, cursor = 0, from
	for _, point in leg.Points do
		walked += flat(cursor, point) + (if climb then math.abs(point.Y - cursor.Y) else 0)
		cursor = point
	end
	local points, names = table.clone(leg.Points), table.clone(leg.Names)
	table.insert(points, goal); table.insert(names, "")
	return { Kind = "Point", Position = leg.Points[1], Label = leg.Names[1], Remaining = walked + flat(cursor, goal),
		Route = { Points = points, Names = names } }
end

-- Campaign doorways from `from` to the zone holding `target`, as raised route points.
local function campaignLeg(from: Vector3, target: Vector3, leg: Leg)
	local a, b = Campaign.at(from.X, from.Y, from.Z), Campaign.at(target.X, target.Y, target.Z)
	if not (a and b) then return end
	for _, door in Campaign.path(a.Id, b.Id) do
		table.insert(leg.Points, Vector3.new(door.X, door.Y + 3, door.Z)); table.insert(leg.Names, door.Name)
	end
end

-- From the crypt or the bastion, a Sanctuary goal is reached through that region's return portal.
local function homeward(from: Vector3, here: string?): Stage?
	for _, region in HOME do
		if region == here then
			local mark = Campaign.mark(region, "ReturnPortal")
			if not mark then return nil end
			local portal = Vector3.new(mark.X, mark.Y + 3, mark.Z)
			local leg: Leg = { Points = {}, Names = {} }
			campaignLeg(from, portal, leg)
			table.insert(leg.Points, portal); table.insert(leg.Names, "Return portal")
			return { Kind = "Point", Position = leg.Points[1], Label = leg.Names[1], Remaining = nil,
				Route = { Points = leg.Points, Names = leg.Names, Exit = "Return portal" } }
		end
	end
	return nil
end

-- The next step from `from` toward `goal`; Kind "Portal" means the Sanctuary's northern gate.
function Guide.next(from: Vector3, goal: Vector3): Stage
	local here, there = Guide.regionOf(from), Guide.regionOf(goal)
	if here == "Sanctuary" and there ~= nil and there ~= "Sanctuary" then
		if there == "SanctuaryDepths" then
			return { Kind = "Point", Position = Guide.CryptDescent, Label = "Crypt descent", Remaining = nil,
				Route = { Points = { Guide.CryptDescent }, Names = { "Crypt descent" }, Exit = "Crypt descent" } }
		end
		return { Kind = "Portal", Position = nil, Label = "Northern gate", Remaining = nil,
			Route = { Points = {}, Names = {}, Exit = "Northern gate" } }
	end
	if there == "Sanctuary" and here ~= nil and here ~= "Sanctuary" then
		local home = homeward(from, here)
		if home then return home end
	end
	if here == Guide.Monastery and there == Guide.Monastery then
		local a, b = Zones.at(from.X, from.Z), Zones.at(goal.X, goal.Z)
		if a and b and a.Id ~= b.Id then
			local leg = monasteryLeg(Zones.path(a.Id, b.Id), goal.Y)
			trail(leg, b.Id, leg.Points[#leg.Points] or from, goal)
			return staged(from, goal, leg)
		elseif a and b then
			local leg: Leg = { Points = {}, Names = {} }
			trail(leg, b.Id, from, goal)
			if #leg.Points &gt; 0 then return staged(from, goal, leg) end
		end
	end
	-- Campaign regions: inside them, between them, and to or from the Monastery's south road.
	local inMonastery, goalInMonastery = here == Guide.Monastery, there == Guide.Monastery
	local a = if inMonastery then Campaign.get("DM:Road") else Campaign.at(from.X, from.Y, from.Z)
	local b = if goalInMonastery then Campaign.get("DM:Road") else Campaign.at(goal.X, goal.Y, goal.Z)
	local campaignDoors = if a and b then Campaign.path(a.Id, b.Id) else {}
	if #campaignDoors &gt; 0 then
		local legs: { Vector3 } = {}
		local names: { string } = {}
		if inMonastery then
			local zone = Zones.at(from.X, from.Z)
			if zone and zone.Id ~= "Road" then
				for _, door in Zones.path(zone.Id, "Road") do
					table.insert(legs, Vector3.new(door.X, from.Y, door.Z)); table.insert(names, door.Name)
				end
			end
		end
		for _, door in campaignDoors do
			table.insert(legs, Vector3.new(door.X, door.Y + 3, door.Z)); table.insert(names, door.Name)
		end
		if goalInMonastery then
			local zone = Zones.at(goal.X, goal.Z)
			if zone and zone.Id ~= "Road" then
				for _, door in Zones.path("Road", zone.Id) do
					table.insert(legs, Vector3.new(door.X, goal.Y, door.Z)); table.insert(names, door.Name)
				end
			end
		end
		if #legs &gt; 0 then
			return staged(from, goal, { Points = legs, Names = names }, true)
		end
	end
	return direct(goal)
end

return table.freeze(Guide)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">SanctuaryRoutes</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/SanctuaryRoutes
-- Player-scale routes added around the existing shrine (batch 16, findings #27 #28 #31 #32). The plaza,
-- stairs, gate, loggia and the Veiled Ascetic stay as built; this adds, as boxes the offline suite walks:
--   * The pilgrim walk out of the plaza's south opening (behind the spawn, away from the story gate)
--     to the Well of Descent pavilion: the Sunken Crypt portal, and the arrival point of its return leg.
--   * Cloud Reliquary: three cloud shards off the pavilion's east rail (single jumps, 3-stud gaps)
--     to an isle holding the cache - optional and deliberate; a miss falls to the cloud catch.
--   * Loggia Eaves: a service ledge round the forge pavilion's south side, the ladder (LootWorld) and a
--     railed lookout deck past the roof line - the cache no longer sits inside the roof ridge.
--   * Reveal points: viewing wings beside the gate on the landing and two pilgrim daises on the
--     terrace's front flanks, where her whole figure fits a normal camera with the tree behind.
--   * A rim parapet around the colossus terrace, open only where the landing and its wings join it.
local hasScript = pcall(function() return script.Parent end)
local L: any = if hasScript then (require(script.Parent.RegionLayout) :: any) else (require("./RegionLayout") :: any)

local r = L.region("Sanctuary")
local Y = 600 -- plaza flagstones; the landing and terrace are at 620
local TERRACE = { X = 0, Z = 555, Radius = 246, Top = 620 } -- SanctuaryColossus: centre and slab
local FIGURE = { X = 0, Z = 705 } -- her seat (terrace centre + TreeSpan.Forward)

-- Pilgrim walk and the Well of Descent.
L.slab(r, "PilgrimWalk", "Path", -12, 12, 946, 972, Y, 3)
for _, side in { -1, 1 } do
	L.wall(r, "PilgrimRail", "Stone", side * 12.4, 947, side * 12.4, 972, Y, 1.4, 0.8)
end
L.slab(r, "DescentPavilion", "Marble", -16, 16, 972, 1004, Y, 6)
-- Lobby rebuild: the four columns of the pyramidal roof over the Well (SanctuaryApproach).
for _, x in { -10, 10 } do
	for _, z in { 979, 997 } do
		L.box(r, "WellColumn", "Lacquer", x, Y + 5, z, 1.3, 10, 1.3)
	end
end
L.wall(r, "PavilionRail", "Stone", -15.6, 972, -15.6, 1004, Y, 2.6, 0.8)
L.wall(r, "PavilionRail", "Stone", -16, 1003.6, 16, 1003.6, Y, 2.6, 0.8)
L.wall(r, "PavilionRail", "Stone", 15.6, 972, 15.6, 983, Y, 2.6, 0.8)
L.wall(r, "PavilionRail", "Stone", 15.6, 993, 15.6, 1004, Y, 2.6, 0.8)
L.wall(r, "PavilionRail", "Stone", -16, 972.4, -12.8, 972.4, Y, 2.6, 0.8)
L.wall(r, "PavilionRail", "Stone", 12.8, 972.4, 16, 972.4, Y, 2.6, 0.8)
-- Cloud Reliquary stones and isle (cache SanctuaryReliquary sits on it).
for i, top in { 601, 602, 603 } do
	L.slab(r, "CloudShard" .. i, "Marble", 12 + i * 7, 16 + i * 7, 985, 991, top, 3)
end
L.slab(r, "ReliquaryIsle", "Marble", 40, 52, 980, 996, 604, 5)
-- Loggia Eaves: service ledge, deck rails (the 8x8 deck and ladder are LootWorld's).
L.slab(r, "ServiceLedge", "Path", -66, -60, 907, 922, Y, 3)
L.slab(r, "ServiceLedge", "Path", -102, -66, 918, 922, Y, 3)
-- 3.8 high: at 2.4 the cache chest (top 617.9) was a step a running player used to clear the rail (Studio F15).
L.wall(r, "LookoutRail", "Timber", -80.4, 919.5, -80.4, 927, 616, 3.8, 0.6)
L.wall(r, "LookoutRail", "Timber", -71.6, 919.5, -71.6, 927, 616, 3.8, 0.6)
L.wall(r, "LookoutRail", "Timber", -80.4, 927.4, -71.6, 927.4, 616, 3.8, 0.6)
-- Reveal points: landing wings beside the gate, pilgrim daises on the terrace's front flanks.
for _, side in { -1, 1 } do
	L.slab(r, "ViewingWing", "Path", side * 21, side * 33, 794, 814, 620, 10)
	L.wall(r, "WingRail", "Stone", side * 32.6, 794, side * 32.6, 814, 620, 2.6, 0.8)
	L.wall(r, "WingRail", "Stone", side * 21, 813.6, side * 33, 813.6, 620, 2.6, 0.8)
	local a = math.rad(side * 40)
	local x, z = TERRACE.X + math.sin(a) * 205, TERRACE.Z + math.cos(a) * 205
	L.box(r, "PilgrimDais", "Stone", x, TERRACE.Top + 0.6, z, 12, 1.2, 12, math.deg(math.atan2(x - FIGURE.X, z - FIGURE.Z)))
	L.mark(r, if side &lt; 0 then "RevealWingW" else "RevealWingE", "Viewing wing", side * 27, 620, 804)
	L.mark(r, if side &lt; 0 then "RevealDaisW" else "RevealDaisE", "Pilgrim dais", x, TERRACE.Top + 1.2, z)
end
-- Rim parapet: 2.6 high, open for 9 degrees either side of the landing and its viewing wings.
for k = 0, 56 do
	local a0, a1 = math.rad(9 + k * 6), math.rad(15 + k * 6)
	local rr = TERRACE.Radius - 2
	L.wall(r, "TerraceParapet", "Stone", TERRACE.X + math.sin(a0) * rr, TERRACE.Z + math.cos(a0) * rr,
		TERRACE.X + math.sin(a1) * rr, TERRACE.Z + math.cos(a1) * rr, TERRACE.Top, 2.6, 1.2)
end

L.mark(r, "CryptDescent", "Descend to the Sunken Crypt", 0, Y, 996, 0)
L.mark(r, "CryptReturn", "Well of Descent", 0, Y, 984, 0) -- faces north, back toward the plaza
L.mark(r, "Figure", "The Veiled Ascetic", FIGURE.X, 700, FIGURE.Z)
r.Terrace = TERRACE

return L.freeze(r)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">SkyCitadelLayout</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/SkyCitadelLayout
-- Sky Citadel and the final approach (batch 21, findings #22 #27 #28 #32). From the Pagoda's dawn
-- terrace the saddle stair drops to a stone bridge across the cloud chasm (y -20; monk), where the
-- summit's towers and the dragon's perch fill the skyline. Heaven's Stair climbs two flights past the
-- first gate landing (swordsman) to the Last Bastion (y 0: final incense altar, return portal to the
-- shrine, battlements) and the Wyrm's fog gate. The summit plateau (BossArenas floor x -90..90,
-- z -2740..-2920) has no wall, roof or pillar: only a low rim at its edge, so the Wyrm's flight and
-- landings and the camera have open air. Falls into the chasm return to the bridge head; falls from
-- the summit outside a fight return to the bastion (inside a fight the arena returns you itself).
local hasScript = pcall(function() return script.Parent end)
local L: any = if hasScript then (require(script.Parent.RegionLayout) :: any) else (require("./RegionLayout") :: any)

local r = L.region("SkyCitadel")

L.slab(r, "SaddleHead", "Tile", -30, 30, -2540, -2548, 0, 30)
L.stairs(r, "SaddleStair", "Marble", 0, -2548, 0, -2588, 0, -20, 10)
L.slab(r, "SaddleBridge", "Stone", -6, 6, -2588, -2620, -20, 3)
for _, side in { -1, 1 } do
	L.wall(r, "BridgeRail", "Stone", side * 6.5, -2590, side * 6.5, -2618, -20, 1.2, 1)
	L.box(r, "BridgePier", "Rock", side * 4, -60, -2604, 6, 74, 10)
end
L.stairs(r, "HeavenStair", "Marble", 0, -2620, 0, -2640, -20, -10, 12)
L.slab(r, "FirstGateLanding", "Tile", -20, 20, -2640, -2650, -10, 40)
L.stairs(r, "HeavenStair", "Marble", 0, -2650, 0, -2670, -10, 0, 12)
L.slab(r, "LastBastion", "Tile", -72, 72, -2670, -2740, 0, 50)
L.slab(r, "SummitPlateau", "Rock", -96, 96, -2736, -2926, -0.1, 50)
-- Battlements, gate towers, the summit rim (1.2: a visible edge, stepped over), the dragon's perch.
for _, side in { -1, 1 } do
	L.wall(r, "Battlement", "Stone", side * 71.5, -2671, side * 71.5, -2736, 0, 3, 1)
	L.wall(r, "Battlement", "Stone", side * 7, -2670.5, side * 71, -2670.5, 0, 3, 1)
	L.box(r, "GateTower", "Stone", side * 22, 15, -2724, 8, 30, 8)
	L.box(r, "FirstGateTower", "Stone", side * 16, 2, -2645, 6, 24, 6)
	L.wall(r, "SummitRim", "Stone", side * 95, -2738, side * 95, -2925, -0.1, 1.3, 1.4)
	L.wall(r, "SummitRim", "Stone", side * 26, -2737.5, side * 95, -2737.5, -0.1, 1.3, 1.4)
end
L.wall(r, "SummitRim", "Stone", -95, -2925, 95, -2925, -0.1, 1.3, 1.4)
L.box(r, "DragonPerch", "Rock", 0, 20, -2952, 14, 120, 14)

for _, l in { { -24, 0, -2544 }, { 24, 0, -2544 }, { -10, -10, -2642 }, { 10, -10, -2642 }, { -60, 0, -2680 }, { 60, 0, -2680 },
	{ -60, 0, -2730 }, { 58, 0, -2702 } } do
	L.lantern(r, l[1], l[2], l[3])
end

L.fence(r, "Veil", "Veil", { { -30, -2540 }, { -30, -2548 }, { -7, -2548 }, { -7, -2640 }, { -22, -2640 }, { -22, -2670 }, { -74, -2670 }, { -74, -2738 },
	{ -98, -2738 }, { -98, -2928 }, { 98, -2928 }, { 98, -2738 }, { 74, -2738 }, { 74, -2670 }, { 22, -2670 }, { 22, -2640 }, { 7, -2640 }, { 7, -2548 },
	{ 30, -2548 }, { 30, -2540 } }, -60, 280, 2)
L.catch(r, "the cloud bridge", -60, 60, -2540, -2668, -30, { 0, -20, -2592, 0 })
L.catch(r, "the last bastion", -110, 110, -2668, -2980, -20, { 0, 0, -2712, 0 })

L.mark(r, "Altar", "Sky Citadel Incense", -40, 0, -2690)
L.mark(r, "ReturnPortal", "Return to the Shrine", 44, 0, -2690, 90)
L.mark(r, "ArenaMouth", "Wyrm's fog gate", 0, 0, -2722)
L.mark(r, "Bridge", "Cloud bridge", 0, -20, -2604)
L.mark(r, "NorthJoin", "Summit bridge", 0, 0, -2542)

L.zone(r, "SC_Bridge", "the cloud bridge", -30, 30, -2540, -2620)
L.zone(r, "SC_Stair", "heaven's stair", -22, 22, -2620, -2670)
L.zone(r, "SC_Bastion", "the last bastion", -74, 74, -2670, -2738)
L.zone(r, "SC_Arena", "the summit", -98, 98, -2738, -2928)
L.door(r, "SC_Bridge", "SC_Stair", 0, -20, -2620, "Heaven's stair")
L.door(r, "SC_Stair", "SC_Bastion", 0, 0, -2670, "Last bastion")
L.door(r, "SC_Bastion", "SC_Arena", 0, 0, -2738, "Wyrm's fog gate")
r.SpawnZones = { SC_Monk_Bridge = "SC_Bridge", SC_Swordsman_Gate = "SC_Stair" }
r.Groves = {}

return L.freeze(r)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">SunkenCryptLayout</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/SunkenCryptLayout
-- Sanctuary Depths, the Sunken Crypt promised by the Slumbering Titan (batch 19, #22 #27 #28 #32).
-- The Sanctuary's south pavilion portal delivers to the Descent Landing (y 30) with the return portal
-- right behind the arrival. From there: the descent stair west -&gt; the Incense Gallery (y 15, altar
-- pocket overlooking the nave) -&gt; the gallery stair down -&gt; the nave (sarcophagi, one swordsman) -&gt;
-- Titan's fog gate (BossArenas floor x 430..610, z 790..970) inside a 16-stud ambulatory with a low
-- bone curb as the visible edge, so the camera and Titan's reach meet no wall.
-- Optional: the west ossuary (monk) ends at a flooded pit crossed on seven sarcophagus lids; beyond it
-- the reliquary and the bone stair climb onto the west wall balcony overlooking the arena. Falling
-- into the pit returns you to its north lip. The region sits at x 340..700, far from the shrine, so
-- the Sanctuary's cloud catch never claims crypt play (tools/test_campaign_regions.luau).
local hasScript = pcall(function() return script.Parent end)
local L: any = if hasScript then (require(script.Parent.RegionLayout) :: any) else (require("./RegionLayout") :: any)

local r = L.region("SanctuaryDepths")

-- Floor (14 thick so the pit cannot be walked under) with the pit cut out of it.
L.slab(r, "CryptFloor", "Crypt", 356, 628, 900, 1082, -0.1, 14)
L.slab(r, "CryptFloor", "Crypt", 404, 628, 772, 900, -0.1, 14)
L.slab(r, "CryptFloor", "Crypt", 356, 404, 772, 850, -0.1, 14)
L.slab(r, "PitWater", "Water", 356, 404, 850, 900, -12, 4)
for k = 1, 7 do
	local north = 900 - 2.75 * k - 4 * (k - 1)
	L.box(r, "SarcophagusLid", "Crypt", 366, (if k % 2 == 0 then 0.9 else 0.4) / 2 - 6, north - 2, 5, 12 + (if k % 2 == 0 then 0.9 else 0.4), 4)
end

-- Descent: landing (arrival), stair west, Incense Gallery, gallery stair to the nave.
L.slab(r, "DescentLanding", "Marble", 500, 540, 1048, 1078, 30, 31)
L.stairs(r, "DescentStair", "Marble", 500, 1056, 470, 1056, 30, 15, 12)
L.slab(r, "StairPlinth", "Crypt", 470, 500, 1046, 1062, 13, 14)
L.slab(r, "IncenseGallery", "Marble", 440, 470, 1020, 1078, 15, 16)
L.stairs(r, "GalleryStair", "Marble", 455, 1020, 455, 990, 15, 0.2, 12)
L.wall(r, "GalleryParapet", "Crypt", 440.5, 1020.5, 448, 1020.5, 15, 2.6, 1)
L.wall(r, "GalleryParapet", "Crypt", 462, 1020.5, 469.5, 1020.5, 15, 2.6, 1)
L.wall(r, "LandingParapet", "Crypt", 540.5, 1048, 540.5, 1077, 30, 2.6, 1)
L.wall(r, "LandingParapet", "Crypt", 500.5, 1048.5, 539.5, 1048.5, 30, 2.6, 1)

-- Crypt masses and walls: north band, east and south walls, the west wall that carries the balcony.
L.slab(r, "CryptMass", "Crypt", 356, 440, 1046, 1078, 40, 41)
L.slab(r, "CryptMass", "Crypt", 470, 500, 1062, 1078, 40, 41)
L.slab(r, "CryptMass", "Crypt", 540, 628, 1046, 1078, 40, 41)
L.wall(r, "CryptWall", "Crypt", 358, 1080, 626, 1080, -0.1, 60, 4)
L.wall(r, "CryptWall", "Crypt", 628, 772, 628, 1078, -0.1, 40, 4)
L.wall(r, "CryptWall", "Crypt", 356, 772, 628, 772, -0.1, 40, 4)
L.wall(r, "CryptWall", "Crypt", 356, 772, 356, 1046, -0.1, 40, 4)
L.slab(r, "BalconyWall", "Crypt", 404, 414, 774, 968, 16, 17)
L.wall(r, "BalconyParapet", "Bone", 413.5, 834, 413.5, 966, 16, 2.6, 1)
L.slab(r, "ReliquaryLoft", "Crypt", 376, 404, 832, 850, 16, 17)
L.stairs(r, "BoneStair", "Bone", 380, 800, 380, 832, 0.2, 16, 8)

-- The arena's visible edge: a low bone curb (steps over it; the fog seal does the real work).
L.wall(r, "ArenaCurb", "Bone", 429, 789, 429, 970, -0.1, 1.3, 1)
L.wall(r, "ArenaCurb", "Bone", 611, 789, 611, 970, -0.1, 1.3, 1)
L.wall(r, "ArenaCurb", "Bone", 429, 789, 611, 789, -0.1, 1.3, 1)
L.wall(r, "ArenaCurb", "Bone", 429, 971, 503, 971, -0.1, 1.3, 1)
L.wall(r, "ArenaCurb", "Bone", 537, 971, 611, 971, -0.1, 1.3, 1)
-- Nave sarcophagi (cover, off the walked line from the gallery stair to the gate).
for _, s in { { 384, 1012 }, { 404, 1028 }, { 384, 1036 }, { 572, 1004 }, { 596, 1020 }, { 572, 1034 } } do
	L.box(r, "Sarcophagus", "Crypt", s[1], 1.5, s[2], 4, 3, 8)
end
for _, x in { 498, 542 } do
	L.box(r, "Pillar", "Crypt", x, 12, 992, 4, 24, 4) -- the gate's guardian columns
end

for _, l in { { 534, 30, 1070 }, { 444, 15, 1064 }, { 440, -0.1, 982 }, { 600, -0.1, 982 }, { 384, -0.1, 906 }, { 360, -0.1, 790 } } do
	L.lantern(r, l[1], l[2], l[3])
end
L.light(r, 520, 26, 1000) -- censer chain over the gate approach

L.fence(r, "Veil", "Veil", { { 354, 770 }, { 630, 770 }, { 630, 1084 }, { 354, 1084 }, { 354, 770 } }, -20, 220, 2)
L.catch(r, "the pit's edge", 356, 404, 850, 900, -6, { 366, 0.2, 904, 0 })

L.mark(r, "Arrival", "Descent Landing", 520, 30, 1062, 0)
L.mark(r, "ReturnPortal", "Return to the Shrine", 520, 30, 1074, 0)
L.mark(r, "Altar", "Sanctuary Depths Incense", 455, 15, 1046)
L.mark(r, "ArenaMouth", "Titan's fog gate", 520, 0, 988)
L.mark(r, "PitLip", "Flooded pit", 366, 0.2, 904)
L.mark(r, "Overlook", "Ossuary balcony", 409, 16, 900, 270)
L.mark(r, "Reliquary", "Bone reliquary", 366, 0.2, 812)

-- The descent is a U (landing -&gt; stair west -&gt; gallery -&gt; stair south): each stair is its own zone so the
-- guide's line climbs down them instead of cutting the landing parapet over the drop (Studio F18).
L.zone(r, "SD_Descent", "the descent", 500, 544, 1046, 1080, 25, 40)
L.zone(r, "SD_DescentStair", "the descent stair", 470, 500, 1050, 1062, 12, 34)
L.zone(r, "SD_Gallery", "the incense gallery", 440, 470, 1020, 1078, 8, 30)
L.zone(r, "SD_GalleryStair", "the gallery stair", 449, 461, 990, 1020, -4, 20)
L.zone(r, "SD_Nave", "the crypt nave", 356, 628, 968, 1046, -4, 14)
L.zone(r, "SD_Ossuary", "the ossuary", 356, 404, 900, 968, -14, 14)
L.zone(r, "SD_Reliquary", "the reliquary", 356, 404, 774, 900, -4, 14) -- and the lid causeway over the pit (follow-up 18)
L.zone(r, "SD_Loft", "the ossuary balcony", 376, 414, 774, 968, 14, 30)
L.zone(r, "SD_Arena", "the Titan's hall", 414, 626, 774, 968, -4, 14)
L.door(r, "SD_Descent", "SD_DescentStair", 502, 30, 1056, "Descent stair")
L.door(r, "SD_DescentStair", "SD_Gallery", 468, 15, 1056, "Incense gallery")
L.door(r, "SD_Gallery", "SD_GalleryStair", 455, 15, 1022, "Gallery stair")
L.door(r, "SD_GalleryStair", "SD_Nave", 455, 0.2, 988, "Gallery foot")
L.door(r, "SD_Nave", "SD_Arena", 520, 0.2, 970, "Titan's fog gate")
L.door(r, "SD_Nave", "SD_Ossuary", 380, 0.2, 968, "Ossuary")
L.door(r, "SD_Ossuary", "SD_Reliquary", 366, 0.2, 901, "Sarcophagus lids") -- the pit lip; the line then runs down the lids
L.door(r, "SD_Reliquary", "SD_Loft", 380, 16, 832, "Bone stair")
L.door(r, "SD_Loft", "SD_Arena", 414, 0.2, 900, "Balcony drop", true)
r.SpawnZones = { SD_Swordsman_Nave = "SD_Nave", SD_Monk_Ossuary = "SD_Ossuary" }
r.Groves = {}

return L.freeze(r)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">TutorialRules</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/TutorialRules
-- The opening training (batch 10, findings #11-#13, #15, #19). Ten steps taught in order against the
-- Sparring Phantom at the Monastery Gate landing. A step advances only on its own proof of success:
-- authoritative combat events judged on the server (a light attack that landed, a strike blocked,
-- a deflect, an i-frame evade, a Blood Rally, a drink that restored health, a perilous strike
-- deflected or evaded, a deathblow), plus two client-only actions the server cannot see (camera
-- lock-on and an Air Glide held for a moment). Pressing a button is never enough. Pure: shared by
-- TutorialService, TutorialController and the tests.
local Rules = {}

export type Step = { Id: string, Title: string, Do: string, Why: string, Keys: { string } }
-- Do/Why may contain {Command} placeholders filled with the player's live bindings.
Rules.Steps = {
	{ Id = "LockOn", Title = "Lock on", Keys = { "Lock" }, Do = "Face the Sparring Phantom and press {Lock} to lock on.",
		Why = "Locked on, your strikes and the camera follow the foe." },
	{ Id = "Light", Title = "Strike", Keys = { "Light" }, Do = "Land a light attack with {Light}.",
		Why = "Swings that fall short say OUT OF REACH: step in until the blade can touch." },
	{ Id = "Guard", Title = "Guard", Keys = { "Guard" }, Do = "Hold {Guard} and block one of its strikes.",
		Why = "Blocking costs stamina and posture; it keeps your health." },
	{ Id = "Deflect", Title = "Deflect", Keys = { "Guard" }, Do = "Tap {Guard} just as a strike lands to deflect it.",
		Why = "A deflect costs nothing and breaks the attacker's posture." },
	{ Id = "Dodge", Title = "Dodge", Keys = { "Dash" }, Do = "Press {Dash} as a strike lands to pass through it.",
		Why = "The first instant of a dash cannot be hit." },
	{ Id = "Rally", Title = "Blood Rally", Keys = { "Light" }, Do = "Take a hit, then strike back with {Light} while the pale part of your bar remains.",
		Why = "That pale part is recoverable. Heavy blows lower your ceiling (▼) until you rest." },
	{ Id = "Heal", Title = "Heal", Keys = { "Heal" }, Do = "While wounded, drink from the gourd with {Heal}.",
		Why = "Drinking at full health keeps the charge. Resting at an altar refills the gourd." },
	{ Id = "Perilous", Title = "Perilous attack", Keys = { "Guard", "Dash" }, Do = "When ▲ PERILOUS flashes, deflect with {Guard} or dodge with {Dash}.",
		Why = "Perilous attacks break through a held guard. Bosses name the counter on the warning." },
	{ Id = "Deathblow", Title = "Deathblow", Keys = { "Heavy" }, Do = "Break its posture, then finish it with {Heavy}.",
		Why = "Deflects and steady hits fill posture; a broken foe takes a deathblow." },
	{ Id = "Glide", Title = "Air Glide", Keys = { "Jump", "Aim" }, Do = "Jump, jump again in the air, then hold {Jump} or {Aim} to glide.",
		Why = "A boss cue reading \"Counter: Air Glide\" means get airborne over the sweep." },
} :: { Step }

Rules.ClientSignals = table.freeze({ LockOn = true, Glide = true }) :: { [string]: boolean }
Rules.GlideSeconds = 0.6 -- an Air Glide must be held this long to count
Rules.Skipped, Rules.Complete = "Skipped", "Complete"
Rules.Stakes = "Essence you carry is dropped where you fall. Return to your bloodstain to reclaim it; fall again first and it is lost."
	.. " Spend Essence at an altar to keep it safe. The courtyard beyond is not training."

local index: { [string]: number } = {}
for i, step in Rules.Steps do index[step.Id] = i end

-- The first step not yet done, or nil once complete / skipped.
function Rules.current(done: { [string]: boolean }): Step?
	if done[Rules.Skipped] or done[Rules.Complete] then return nil end
	for _, step in Rules.Steps do
		if not done[step.Id] then return step end
	end
	return nil
end

-- Returns the step id this signal completes, or nil (only the current step can advance).
function Rules.advance(done: { [string]: boolean }, signal: string): string?
	local step = Rules.current(done)
	return if step and step.Id == signal then step.Id else nil
end

function Rules.finished(done: { [string]: boolean }): boolean
	return Rules.current(done) == nil
end

-- What the player's fighter was doing when the event fired (TutorialService reads it).
export type Own = { State: string, Move: string? }
-- Combat event (as CombatRules emits it) -&gt; the signal it proves for `player`, or nil.
-- `perilous` says the attacker's strike was unblockable (a perilous attack). F08: CombatRules reports
-- Evade for any invulnerability (Studio logged the player "evading" while lying helpless after a
-- deathblow) and Hit for spells, arts and burn ticks, so a dodge needs a dash and Light an M1 move.
function Rules.signal(kind: string, source: number, target: number, player: number, perilous: boolean, own: Own?): string?
	if kind == "Hit" or kind == "CounterHit" then
		local m1 = own ~= nil and (own.Move == "Light" or own.Move == "RunningAttack")
		return if source == player and m1 then "Light" else nil
	elseif kind == "Block" then
		return if target == player then "Guard" else nil
	elseif kind == "DeflectSpark" or kind == "Evade" then -- Source avoided Target's strike
		if source ~= player or (kind == "Evade" and not (own and own.State == "Dashing")) then return nil end
		if perilous then return "Perilous" end
		return if kind == "DeflectSpark" then "Deflect" else "Dodge"
	elseif kind == "Rally" then
		return if source == player then "Rally" else nil
	elseif kind == "Deathblow" then
		return if source == player then "Deathblow" else nil
	end
	return nil
end

-- Progress travels as the AsuraTutorial attribute: completed ids joined by commas.
function Rules.serialize(done: { [string]: boolean }): string
	if done[Rules.Skipped] then return Rules.Skipped end
	if Rules.finished(done) then return Rules.Complete end
	local list: { string } = {}
	for _, step in Rules.Steps do if done[step.Id] then table.insert(list, step.Id) end end
	return table.concat(list, ",")
end

function Rules.parse(text: any): { [string]: boolean }
	local done: { [string]: boolean } = {}
	if type(text) ~= "string" then return done end
	for id in string.gmatch(text, "[^,]+") do
		if index[id] or id == Rules.Skipped or id == Rules.Complete then done[id] = true end
	end
	if done[Rules.Complete] then for _, step in Rules.Steps do done[step.Id] = true end end
	return done
end

-- Fills {Command} placeholders with live key captions.
function Rules.text(template: string, label: (command: string) -&gt; string): string
	return (string.gsub(template, "{(%a+)}", function(command: string) return "[" .. label(command) .. "]" end))
end

return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">WorldDefinitions</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/WorldDefinitions
-- Story Mode world manifest. Engine-free data (plain numbers, yaw in degrees) so the manifest is
-- validated identically by the server, the client and the local Luau runner.

local hasScript = pcall(function() return script.Parent end)
local Roster: any
if hasScript then Roster = require(script.Parent.BossRoster) else Roster = require("./BossRoster") end

type AttackKind = "PerilousSweep" | "PerilousThrust" | "PerilousGrab" | "Shockwave" | "Barrage" | "Gravity" | "Ritual" | "Leap" | "Breath" | "Tail" | "ShieldCharge"
type Motion = "Pillar" | "Aerial" | "Lunge" | "Teleport"
export type BossAttack = {
	Id: string, Kind: AttackKind, Windup: number, Radius: number, Damage: number, Posture: number,
	Height: number?, Speed: number?, Repeats: number?, Interval: number?, Duration: number?,
	Count: number?, Motion: Motion?, Element: string?, Unblockable: boolean?,
}
type GapCloser = { Range: number, Delay: number, Cooldown: number, Motion: Motion }

export type Vec3 = { X: number, Y: number, Z: number }
export type Placement = { X: number, Y: number, Z: number, Yaw: number }
export type Bounds = { Center: Vec3, Size: Vec3 }
export type RegionId = "Sanctuary" | "DesecratedMonastery" | "BambooPass" | "AshColosseum" | "SanctuaryDepths" | "CelestialPagoda" | "SkyCitadel"
export type WeaponType = "Unarmed" | "Jian" | "Dao" | "Guandao" | "Catalyst" | "PrayerOfTheDefiled" | "CalamityBoneCleaver" | "HeavenPiercingGuandao"

export type Stats = {
	MaxHP: number?,
	MaxStamina: number?,
	PostureCapacity: number?,
	StrengthScale: number?,
	DexterityScale: number?,
	PoiseArmor: number?,
	ReachBonus: number?,
}

export type AIProfile = {
	SightRange: number,
	FieldOfView: number,
	HearingRange: number,
	AlertTime: number,
	SearchTime: number,
	Aggression: number,
	DeflectChance: number,
	GuardChance: number,
	ReactionTime: number,
	TimingJitter: number,
	PatrolRadius: number,
	LeashRange: number,
	ComboContinueChance: number,
	HeavyChance: number,
	ArtChance: number,
	StrafeChance: number,
	RetreatStamina: number,
	PostureGuard: number,
	ThinkRate: number,
}

export type Region = {
	Id: RegionId,
	Name: string,
	Bounds: Bounds,
	MapFolder: string,
	Greybox: { Color: { number }, Material: string },
	Ambience: string,
	-- Region-scoped view of World.Altars keyed without the "Altar_" prefix, e.g.
	-- World.Regions.DesecratedMonastery.Altars.MonasteryGate. Filled from World.Altars at load.
	Altars: { [string]: Altar },
}

export type Altar = {
	Id: string,
	Name: string,
	Region: RegionId,
	Placement: Placement,
	Spawn: Placement,
	Radius: number,
	Starting: boolean,
	-- Where the rest pocket's departure path leads (batch 07); the walk from Spawn to Exit and the
	-- pocket around the altar must stay free of solid geometry (MonasterySurvey checks both).
	Exit: Placement?,
}

export type MobDef = {
	Id: string,
	Name: string,
	Weapon: WeaponType,
	Stats: Stats,
	AI: AIProfile,
	Essence: number,
	BodyColor: { number },
}

export type MobSpawn = {
	Id: string,
	Mob: string,
	Region: RegionId,
	Placement: Placement,
	Patrol: { Placement },
}

export type Shockwave = {
	Windup: number,
	Radius: number,
	Damage: number,
	Posture: number,
	Unblockable: boolean,
}

export type BossPhase = {
	Attacks: { BossAttack }?,
	AttackInterval: number?,
	AnimationSet: string?,
	GapCloser: GapCloser?,
	Index: number,
	Name: string,
	Weapon: WeaponType,
	-- Enter this phase when HP falls to this fraction of max (nil for the opening phase).
	HPFraction: number?,
	-- Enter this phase on the first Deathblow received in the previous phase.
	OnDeathblow: boolean,
	Stats: Stats,
	AI: AIProfile,
	Transition: { Duration: number, Shockwave: Shockwave, BodyColor: { number } }?,
	Special: { IntervalMin: number, IntervalMax: number, Shockwave: Shockwave }?,
}

export type BossDef = {
	Archetype: string?, Scale: number?, Victory: string?, Affinity: string?,
	Partner: { Name: string, Weapon: WeaponType, Stats: Stats, Attacks: { BossAttack }, Affinity: string, Scale: number }?,
	Id: string,
	Name: string,
	Title: string,
	Region: RegionId,
	Arena: Bounds,
	Spawn: Placement,
	FogGate: string,
	Essence: number,
	Phases: { BossPhase },
	BodyColor: { number },
}

export type FogGate = {
	Id: string,
	Boss: string,
	Placement: Placement,
	Size: Vec3,
	-- Crossing into this volume (inside the arena) starts the encounter.
	Trigger: Bounds,
	-- Where trapped fighters are returned when they leave the arena, and where outsiders are ejected to.
	Inside: Placement,
	Outside: Placement,
}

-- Layout anchors for the Shrine of the Ascendant, the sky lobby above the sea of clouds. The
-- SanctuaryService builds around these points; the Colosseum ring and the bonfire altar read them.
export type SanctuaryLayout = {
	Origin: Vec3, -- Plaza centre at flagstone level
	PlazaRadius: number,
	PlinthHeight: number,
	Loggia: Vec3, -- West alcove centre (Blacksmith)
	Promenade: Vec3, -- East balcony centre (Colosseum ring)
	StairSteps: number,
	StairRise: number,
	StairRun: number,
	StairWidth: number,
	PortalDestination: string, -- Altar the Ascension Gateway delivers to
	CloudRadius: number,
}

local World = {}

local function v(x: number, y: number, z: number): Vec3
	return { X = x, Y = y, Z = z }
end

local function at(x: number, y: number, z: number, yaw: number?): Placement
	return { X = x, Y = y, Z = z, Yaw = yaw or 0 }
end

local function profile(overrides: { [string]: number }): AIProfile
	local base: AIProfile = {
		SightRange = 60,
		FieldOfView = 110,
		HearingRange = 28,
		AlertTime = 0.9,
		SearchTime = 6,
		Aggression = 0.6,
		DeflectChance = 0.3,
		GuardChance = 0.4,
		ReactionTime = 0.24,
		TimingJitter = 0.035,
		PatrolRadius = 12,
		LeashRange = 100,
		ComboContinueChance = 0.65,
		HeavyChance = 0.2,
		ArtChance = 0.06,
		StrafeChance = 0.35,
		RetreatStamina = 20,
		PostureGuard = 0.8,
		ThinkRate = 10,
	}
	local writable = base :: any
	for key, value in overrides do
		assert(writable[key] ~= nil, "Unknown AI profile field " .. key)
		writable[key] = value
	end
	return base
end

local SANCTUARY_ORIGIN = v(0, 600, 900)
local PLINTH_HEIGHT = 1.2

World.Sanctuary = {
	Origin = SANCTUARY_ORIGIN,
	PlazaRadius = 46,
	PlinthHeight = PLINTH_HEIGHT,
	Loggia = v(SANCTUARY_ORIGIN.X - 84, SANCTUARY_ORIGIN.Y, SANCTUARY_ORIGIN.Z),
	Promenade = v(SANCTUARY_ORIGIN.X + 94, SANCTUARY_ORIGIN.Y, SANCTUARY_ORIGIN.Z),
	StairSteps = 20,
	StairRise = 1,
	StairRun = 2,
	StairWidth = 30, -- monumental sanctuary: open procession into the sacred terrace
	PortalDestination = "Altar_MonasteryGate",
	CloudRadius = 1200,
} :: SanctuaryLayout

World.Regions = {
	Sanctuary = {
		Id = "Sanctuary",
		Name = "The Shrine of the Ascendant",
		-- Extends north past the Ascension gate to take in the colossus terrace (SanctuaryColossus).
		Bounds = { Center = v(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + 200, SANCTUARY_ORIGIN.Z - 250), Size = v(600, 800, 920) },
		-- Built at runtime by SanctuaryService as Workspace.Sanctuary; its presence suppresses greybox.
		MapFolder = "Sanctuary",
		Greybox = { Color = { 120, 112, 104 }, Material = "Slate" },
		Ambience = "SkyShrine",
		Altars = {},
	},
	DesecratedMonastery = {
		Id = "DesecratedMonastery",
		Name = "Desecrated Monastery",
		Bounds = { Center = v(0, 40, -900), Size = v(400, 200, 440) },
		MapFolder = "Map_DesecratedMonastery",
		Greybox = { Color = { 74, 66, 60 }, Material = "Slate" },
		Ambience = "TempleBells",
		Altars = {},
	},
	BambooPass = {
		Id = "BambooPass",
		Name = "Bamboo Pass",
		-- 400 wide (batch 17): the frost ridge and the bamboo thicket that walls the pass.
		Bounds = { Center = v(0, 40, -1400), Size = v(400, 200, 560) },
		MapFolder = "Map_BambooPass",
		Greybox = { Color = { 68, 92, 58 }, Material = "Grass" },
		Ambience = "WindReeds",
		Altars = {},
	},
	AshColosseum = {
		Id = "AshColosseum",
		Name = "Ash Colosseum",
		Bounds = { Center = v(0, 40, -1900), Size = v(360, 200, 440) },
		MapFolder = "Map_AshColosseum",
		Greybox = { Color = { 58, 54, 52 }, Material = "Basalt" },
		Ambience = "EmberCrowd",
		Altars = {},
	},
} :: { [RegionId]: Region }

World.RegionOrder = { "Sanctuary", "DesecratedMonastery", "BambooPass", "AshColosseum" } :: { RegionId }

World.Altars = {
	-- First-time players kneel here: the spawn stands before the bonfire, facing the staircase (-Z).
	Altar_SanctuaryBonfire = {
		Id = "Altar_SanctuaryBonfire",
		Name = "Primal Bonfire",
		Region = "Sanctuary",
		Placement = at(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + PLINTH_HEIGHT, SANCTUARY_ORIGIN.Z),
		Spawn = at(SANCTUARY_ORIGIN.X, SANCTUARY_ORIGIN.Y + 3, SANCTUARY_ORIGIN.Z + 20, 0),
		Radius = 9,
		Starting = true,
	},
	Altar_MonasteryGate = {
		Id = "Altar_MonasteryGate",
		Name = "Monastery Gate",
		Region = "DesecratedMonastery",
		Placement = at(0, 0, -720),
		Spawn = at(0, 3, -728, 0),
		Radius = 9,
		Starting = false,
		Exit = at(0, 3, -764), -- through the gatehouse's open centre bay into the courtyard
	},
	Altar_DesecratedCloister = {
		Id = "Altar_DesecratedCloister",
		Name = "Desecrated Cloister",
		Region = "DesecratedMonastery",
		Placement = at(60, 0, -1010),
		Spawn = at(60, 3, -1018, 0),
		Radius = 9,
		Starting = false,
		Exit = at(6, 3, -1012), -- out of the west gateway onto the south road
	},
	-- Batches 17-18: both altars stand in authored pockets (BambooPassLayout / AshColosseumLayout
	-- marks). The shrine used to sit on Baize's arena wall with its spawn inside the arena.
	Altar_BambooShrine = {
		Id = "Altar_BambooShrine",
		Name = "Whispering Bamboo Shrine",
		Region = "BambooPass",
		Placement = at(-36, 0.2, -1328),
		Spawn = at(-29, 3.2, -1333, 306),
		Radius = 9,
		Starting = false,
		Exit = at(-6, 3.2, -1352), -- toward Baize's mouth
	},
	Altar_ColosseumAntechamber = {
		Id = "Altar_ColosseumAntechamber",
		Name = "Colosseum Antechamber",
		Region = "AshColosseum",
		Placement = at(0, 3, -1736),
		Spawn = at(0, 6, -1744, 0),
		Radius = 9,
		Starting = false,
		Exit = at(0, 6, -1766), -- out through the antechamber's south door
	},
} :: { [string]: Altar }

for id, altar in World.Altars do
	local short = string.gsub(id, "^Altar_", "")
	local region = World.Regions[altar.Region]
	assert(region ~= nil, "Altar region missing " .. id)
	assert(region.Altars[short] == nil, "Duplicate region altar name " .. short)
	region.Altars[short] = altar
end

World.Mobs = {
	CorruptWanderingMonk = {
		Id = "CorruptWanderingMonk",
		Name = "Corrupt Wandering Monk",
		Weapon = "Unarmed",
		Stats = { MaxHP = 85, MaxStamina = 90, PostureCapacity = 80, StrengthScale = 0.9, DexterityScale = 0.9, PoiseArmor = 0.1 },
		AI = profile({
			SightRange = 55,
			HearingRange = 26,
			Aggression = 0.55,
			DeflectChance = 0.2,
			GuardChance = 0.45,
			ReactionTime = 0.28,
			PatrolRadius = 14,
			LeashRange = 90,
			ComboContinueChance = 0.6,
			HeavyChance = 0.25,
			ArtChance = 0.05,
			StrafeChance = 0.3,
		}),
		Essence = 45,
		BodyColor = { 112, 84, 60 },
	},
	CursedSwordsman = {
		Id = "CursedSwordsman",
		Name = "Cursed Swordsman",
		Weapon = "Dao",
		Stats = { MaxHP = 120, MaxStamina = 110, PostureCapacity = 110, StrengthScale = 1.0, DexterityScale = 1.0, PoiseArmor = 0.2 },
		AI = profile({
			SightRange = 65,
			FieldOfView = 100,
			HearingRange = 30,
			Aggression = 0.7,
			DeflectChance = 0.4,
			GuardChance = 0.35,
			ReactionTime = 0.22,
			PatrolRadius = 10,
			LeashRange = 110,
			ComboContinueChance = 0.75,
			HeavyChance = 0.2,
			ArtChance = 0.08,
			StrafeChance = 0.4,
		}),
		Essence = 80,
		BodyColor = { 46, 50, 62 },
	},
	-- Opening training partner (batch 10, TutorialService): waits on the Monastery Gate landing,
	-- notices only someone who walks up to it, stays on the landing, strikes gently, uses its
	-- unblockable Sundering Qi Palm (the perilous lesson) and breaks posture readily. No Essence.
	SparringPhantom = {
		Id = "SparringPhantom",
		Name = "Sparring Phantom",
		Weapon = "Unarmed",
		Stats = { MaxHP = 140, MaxStamina = 90, PostureCapacity = 60, StrengthScale = 0.35, DexterityScale = 0.35, PoiseArmor = 0 },
		AI = profile({
			SightRange = 11,
			FieldOfView = 360,
			HearingRange = 6,
			Aggression = 0.45,
			DeflectChance = 0.05,
			GuardChance = 0.3,
			ReactionTime = 0.4,
			PatrolRadius = 3,
			LeashRange = 24,
			ComboContinueChance = 0.3,
			HeavyChance = 0.3,
			ArtChance = 0.35,
			StrafeChance = 0.2,
		}),
		Essence = 0,
		BodyColor = { 150, 168, 160 },
	},
} :: { [string]: MobDef }

local function patrol(x: number, z: number, radius: number): { Placement }
	return {
		at(x + radius, 3, z),
		at(x, 3, z + radius),
		at(x - radius, 3, z),
		at(x, 3, z - radius),
	}
end

-- `floor` (batches 17-21): the authored floor height the foe stands on (default the ground, 0).
local function spawn(id: string, mob: string, region: RegionId, x: number, z: number, yaw: number, radius: number, floor: number?): MobSpawn
	local y = 3 + (floor or 0)
	local points = patrol(x, z, radius)
	for _, point in points do
		point.Y = y
	end
	return { Id = id, Mob = mob, Region = region, Placement = at(x, y, z, yaw), Patrol = points }
end

