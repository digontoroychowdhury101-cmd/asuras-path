        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">BossAttackCatalog</string>
            <string name="Source">--!strict
type AttackKind = "PerilousSweep" | "PerilousThrust" | "PerilousGrab" | "Shockwave" | "Barrage" | "Gravity" | "Ritual" | "Leap" | "Breath" | "Tail" | "ShieldCharge"
type Motion = "Pillar" | "Aerial" | "Lunge" | "Teleport"
type BossAttack = {
	Id: string, Kind: AttackKind, Windup: number, Radius: number, Damage: number, Posture: number,
	Height: number?, Speed: number?, Repeats: number?, Interval: number?, Duration: number?,
	Count: number?, Motion: Motion?, Element: string?, Unblockable: boolean?,
}
type GapCloser = { Range: number, Delay: number, Cooldown: number, Motion: Motion }
local function move(id: string, kind: AttackKind, radius: number, damage: number, windup: number, options: { [string]: any }?): BossAttack
	local result: any = { Id = id, Kind = kind, Radius = radius, Damage = damage, Posture = damage * 1.6, Windup = windup, Unblockable = kind ~= "Barrage" and kind ~= "ShieldCharge" }
	for key, value in options or {} do result[key] = value end
	return result :: BossAttack
end
local Catalog = {
	Shen = {
		move("FlowingJian", "PerilousThrust", 18, 15, 0.8, { Repeats = 4, Interval = 0.65, Motion = "Lunge" }),
		move("PrayerBeads", "Barrage", 90, 12, 1.1, { Count = 7, Speed = 34 }),
		move("AbbotSweep", "PerilousSweep", 16, 24, 1),
	},
	Chimera = {
		move("BloodWave", "Shockwave", 90, 30, 1.1, { Speed = 38, Height = 7, Element = "Blood" }),
		move("GuandaoSkyfall", "Leap", 28, 35, 1.5, { Motion = "Aerial", Speed = 45 }),
		move("CrimsonEmbrace", "PerilousGrab", 12, 40, 1.2),
	},
	Baize = {
		move("MeteorPounce", "Leap", 100, 32, 2.1, { Motion = "Pillar", Speed = 32, Height = 9, Duration = 2.6, Element = "Frost" }),
		move("FeralClaws", "PerilousSweep", 18, 23, 0.9),
		move("RidgeMaw", "PerilousGrab", 13, 38, 1.15),
	},
	Titan = {
		move("WorldTremor", "Shockwave", 240, 34, 1.5, { Repeats = 2, Interval = 1.15, Speed = 30, Height = 11, Element = "Earth" }),
		move("CryptHand", "PerilousGrab", 22, 48, 1.6),
		move("MagmaWake", "Ritual", 135, 25, 2, { Duration = 4, Height = 9, Element = "Magma" }),
	},
	Wu = {
		move("SoulSpears", "Barrage", 140, 19, 1.25, { Count = 5, Speed = 26, Element = "Void" }),
		move("StarlessSingularity", "Gravity", 32, 18, 1.8, { Duration = 4, Height = 10, Element = "Void" }),
		move("BloodflameRitual", "Ritual", 130, 27, 2.5, { Duration = 3.5, Height = 9, Element = "Bloodflame" }),
	},
	Zhao = {
		move("LightningSpear", "PerilousThrust", 30, 24, 0.8, { Motion = "Lunge", Repeats = 3, Interval = 0.7, Element = "Lightning" }),
		move("ThunderQuickstep", "ShieldCharge", 35, 26, 1, { Motion = "Lunge" }),
	},
	Bull = {
		move("IronCharge", "ShieldCharge", 50, 35, 1.5, { Motion = "Lunge", Element = "Iron" }),
		move("ColossalHammer", "Shockwave", 65, 34, 1.8, { Speed = 26, Height = 7, Element = "Iron" }),
	},
	Wyrm = {
		move("HeavenlyBreathRun", "Breath", 140, 36, 2, { Motion = "Aerial", Duration = 3, Height = 10, Element = "Thunder" }),
		move("AzureTail", "Tail", 28, 32, 1.15),
		move("DescendingThunder", "Leap", 110, 42, 1.8, { Motion = "Aerial", Speed = 42, Height = 9, Element = "Thunder" }),
	},
}
return Catalog
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">BossEncounterRules</string>
            <string name="Source">--!strict
local Rules = {}
Rules.ThrustWindow = 0.1
Rules.MinimumWarning = 0.65
Rules.AttackKinds = table.freeze({ PerilousSweep = true, PerilousThrust = true, PerilousGrab = true,
	Shockwave = true, Barrage = true, Gravity = true, Ritual = true, Leap = true, Breath = true, Tail = true, ShieldCharge = true })
function Rules.classify(kind: string): (boolean, string)
	if kind == "PerilousSweep" or kind == "Tail" then return true, "Double Jump" end
	if kind == "PerilousThrust" then return true, "Deflect" end
	if kind == "PerilousGrab" then return true, "Slide Dash" end
	if kind == "Gravity" then return false, "Bullet Jump" end
	if kind == "Shockwave" or kind == "Leap" or kind == "Ritual" or kind == "Breath" then return true, "Air Glide" end
	return false, "Evade"
end
function Rules.impact(now: number, windup: number): number
	return now + math.max(Rules.MinimumWarning, windup)
end
function Rules.tightDeflect(pressedAt: number, impactAt: number): boolean
	local delta = impactAt - pressedAt
	return delta &gt;= 0 and delta &lt;= Rules.ThrustWindow + 1e-9
end
-- Swept annulus: remains correct when a frame steps across a fast moving ring.
function Rules.waveHit(distance: number, height: number, elapsed: number, previous: number, speed: number, radius: number, clearance: number): boolean
	return height &lt;= clearance and distance &lt;= radius and distance &gt;= math.max(0, previous * speed - 3)
		and distance &lt;= math.min(radius, elapsed * speed + 3)
end
function Rules.segmentHit(px: number, pz: number, ax: number, az: number, bx: number, bz: number, width: number): boolean
	local dx, dz = bx - ax, bz - az
	local t = math.clamp(((px - ax) * dx + (pz - az) * dz) / math.max(dx * dx + dz * dz, 0.001), 0, 1)
	return (px - ax - dx * t)^2 + (pz - az - dz * t)^2 &lt;= width^2
end
function Rules.shouldClose(distance: number, farSince: number, now: number, range: number, delay: number): boolean
	return distance &gt; range and now - farSince &gt;= delay
end
function Rules.enrage(alive: number, alreadyEnraged: boolean): boolean
	return alive == 1 and not alreadyEnraged
end
function Rules.lifecycle(living: number, defeated: boolean, entityPresent: boolean): string
	if defeated then return "Victory" end
	if living == 0 or not entityPresent then return "Reset" end
	return "Sealed"
end
function Rules.loot(essence: number, count: number): { { X: number, Z: number, Amount: number } }
	local drops = {}
	for i = 1, count do
		local angle = (i - 1) * math.pi * 2 / count
		table.insert(drops, { X = math.cos(angle) * 7, Z = math.sin(angle) * 7,
			Amount = math.floor(essence / count) + (if i &lt;= essence % count then 1 else 0) })
	end
	return drops
end
return table.freeze(Rules)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">BossRoster</string>
            <string name="Source">--!strict
-- Appends the campaign without a circular dependency on WorldDefinitions.
local hasScript = pcall(function() return script.Parent end)
local Attacks: any
if hasScript then Attacks = require(script.Parent.BossAttackCatalog) else Attacks = require("./BossAttackCatalog") end
local Roster = {}
local function vec(x: number, y: number, z: number): any return { X = x, Y = y, Z = z } end
local function at(x: number, z: number): any return { X = x, Y = 3, Z = z, Yaw = 180 } end
function Roster.apply(world: any, profile: ({ [string]: number }) -&gt; any)
	local regions = {
		{ "SanctuaryDepths", "Sanctuary Depths", 520, 900 },
		{ "CelestialPagoda", "Celestial Pagoda Rafters", 0, -2360 },
		{ "SkyCitadel", "Sky Citadel", 0, -2800 },
	}
	for _, entry in regions do
		local id, name, x, z = entry[1] :: string, entry[2] :: string, entry[3] :: number, entry[4] :: number
		world.Regions[id] = { Id = id, Name = name, Bounds = { Center = vec(x, 40, z), Size = vec(360, 200, 360) },
			MapFolder = "Map_" .. id, Greybox = { Color = { 47, 48, 62 }, Material = "Slate" }, Ambience = "StarlessWind", Altars = {} }
		table.insert(world.RegionOrder, id)
		local altarId = "Altar_" .. id
		local altar = { Id = altarId, Name = name .. " Incense", Region = id, Placement = at(x, z + 145), Spawn = at(x, z + 145), Radius = 12, Starting = false }
		world.Altars[altarId] = altar
		world.Regions[id].Altars[id] = altar
	end
	-- A side courtyard leaves the authored monastery route intact.
	world.Regions.DesecratedMonastery.Bounds.Size.X = 900
	local ai = profile({ SightRange = 220, FieldOfView = 360, HearingRange = 200, LeashRange = 1000,
		AlertTime = 0.15, Aggression = 0.85, PatrolRadius = 0, ThinkRate = 15, ComboContinueChance = 0.8 })
	local function phase(index: number, name: string, weapon: string, hp: number, moves: any, motion: string): any
		return { Index = index, Name = name, Weapon = weapon, HPFraction = if index == 2 then 0.5 else nil,
			OnDeathblow = index == 2, Stats = { MaxHP = hp, MaxStamina = 260, PostureCapacity = hp * 0.24,
				StrengthScale = 1.6, DexterityScale = 1.5, PoiseArmor = 0.5 }, AI = table.clone(ai),
			AnimationSet = name, Attacks = moves, AttackInterval = if index == 2 then 2.2 else 3.2,
			GapCloser = { Range = 40, Delay = 2.5, Cooldown = 7, Motion = motion },
			Transition = if index == 2 then { Duration = 2.8, BodyColor = { 80, 110, 160 },
				Shockwave = { Windup = 1.8, Radius = 32, Damage = 24, Posture = 40, Unblockable = true } } else nil }
	end
	local function boss(id: string, name: string, title: string, region: string, x: number, z: number, hp: number, weapon: string, moves: any, archetype: string, scale: number, motion: string)
		local gateId = "Gate_" .. id
		world.Bosses[id] = { Id = id, Name = name, Title = title, Region = region, Archetype = archetype, Scale = scale,
			Arena = { Center = vec(x, 36, z), Size = vec(180, 100, 180) }, Spawn = at(x, z - 25), FogGate = gateId,
			Essence = hp * 4, BodyColor = { 140, 154, 178 }, Victory = "LEGEND FELLED",
			Phases = { phase(1, "Ancient Oath", weapon, hp, moves, motion), phase(2, "Unbound", weapon, hp, moves, motion) } }
		world.FogGates[gateId] = { Id = gateId, Boss = id, Placement = { X = x, Y = 12, Z = z + 90, Yaw = 0 }, Size = vec(26, 24, 2),
			Trigger = { Center = vec(x, 10, z + 78), Size = vec(24, 20, 12) }, Inside = at(x, z + 70), Outside = at(x, z + 108) }
	end
	boss("VenerableBaize", "Venerable Baize", "Beast of the Frosted Ridge", "BambooPass", 0, -1470, 1100, "Unarmed", Attacks.Baize, "Beast", 1.5, "Pillar")
	boss("SlumberingTitan", "The Slumbering Titan", "Ancient of the Sunken Crypt", "SanctuaryDepths", 520, 880, 1600, "Guandao", Attacks.Titan, "Colossus", 3, "Lunge")
	boss("SovereignWu", "Sovereign Wu", "The Starless Oracle", "CelestialPagoda", 0, -2380, 1250, "Catalyst", Attacks.Wu, "Sorcerer", 1.2, "Teleport")
	boss("TwinSentinels", "General Zhao", "The Twin Sentinels: Zhao &amp; the Iron Bull", "DesecratedMonastery", 300, -930, 1000, "Guandao", Attacks.Zhao, "Duo", 1.2, "Lunge")
	boss("AzureWyrm", "Azure Wyrm", "Overlord of the Heavenly Summit", "SkyCitadel", 0, -2830, 1600, "Guandao", Attacks.Wyrm, "Dragon", 2.2, "Aerial")
	local duo = world.Bosses.TwinSentinels
	duo.Phases = { duo.Phases[1] }
	duo.Partner = { Name = "The Iron Bull", Weapon = "Guandao", Stats = { MaxHP = 1600, MaxStamina = 320, PostureCapacity = 460, PoiseArmor = 0.9 },
		Attacks = Attacks.Bull, Affinity = "Iron", Scale = 1.7 }
	duo.Affinity = "Lightning"
	local shen = world.Bosses.GrandmasterShen
	shen.Archetype, shen.Victory = "Duelist", "GREAT FOE VANQUISHED"
	for i, p in shen.Phases do
		p.Attacks, p.AttackInterval, p.AnimationSet = if i == 1 then Attacks.Shen else Attacks.Chimera, 3, if i == 1 then "DisciplinedMaster" else "DemonicChimera"
		p.GapCloser = { Range = 36, Delay = 2.5, Cooldown = 7, Motion = "Lunge" }
	end
	shen.Phases[2].Special = nil
end
return Roster
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">BossTypes</string>
            <string name="Source">--!strict
-- Engine-free contracts shared by authored encounters, the server and verification.
export type AttackKind = "PerilousSweep" | "PerilousThrust" | "PerilousGrab" | "Shockwave" | "Barrage" | "Gravity" | "Ritual" | "Leap" | "Breath" | "Tail" | "ShieldCharge"
export type Motion = "Pillar" | "Aerial" | "Lunge" | "Teleport"
export type Attack = {
	Id: string, Kind: AttackKind, Windup: number, Radius: number, Damage: number, Posture: number,
	Height: number?, Speed: number?, Repeats: number?, Interval: number?, Duration: number?,
	Count: number?, Motion: Motion?, Element: string?, Unblockable: boolean?,
}
export type GapCloser = { Range: number, Delay: number, Cooldown: number, Motion: Motion }
return table.freeze({})
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">CombatSettings</string>
            <string name="Source">--!strict
-- ModuleScript: ReplicatedStorage/AsurasPath/Shared/CombatSettings
-- Asura's Path combat tuning. Durations and rates here are real-time values; frame data in
-- WeaponSchema is authored at baseline and scaled through Simulation/Tempo.

export type InjuryTier = "None" | "Impaired" | "Injured" | "Severe"
export type InjuryRegion = "Head" | "Torso" | "LeftArm" | "RightArm" | "LeftLeg" | "RightLeg"
export type InjuryGroup = "Head" | "Torso" | "Arm" | "Leg"
export type Range = { Min: number, Max: number }
export type Thresholds = { Impaired: number, Injured: number, Severe: number }

local function freeze(value: any)
	if type(value) ~= "table" or table.isfrozen(value) then
		return
	end
	for _, child in value do
		freeze(child)
	end
	table.freeze(value)
end

local Settings = {
	SchemaVersion = 2,

	Tempo = {
		Scalar = 1.4,
		TickRate = 60,
		TickSeconds = 1 / 60,
		Telegraph = {
			HeavyMinSeconds = 0.210,
			LightTargetSeconds = 0.085,
		},
	},

	Health = {
		MaxHP = 100,
		Layers = { "ActiveHP", "RecoverableHP", "PermanentDeficit" },
		-- Fraction of each hit's damage that becomes RecoverableHP debt rather than a clean loss.
		RecoverableFraction = {
			Chip = 1.0,
			Light = 0.6,
			Heavy = 0.35,
			RunningAttack = 0.4,
			WeaponArt = 0.25,
			Bleed = 0.0,
			Deathblow = 0.0,
		},
		-- Fraction of each hit's damage that permanently lowers effective max HP until a shrine rest.
		PermanentFraction = {
			Chip = 0.0,
			Light = 0.0,
			Heavy = 0.08,
			RunningAttack = 0.05,
			WeaponArt = 0.12,
			Bleed = 0.5,
			Deathblow = 0.25,
		},
		MaxPermanentDeficit = 60,
		MinEffectiveMaxHP = 40,
		Rally = {
			Window = 3.0,
			ReturnRatio = 0.85,
			DecayDelay = 3.0,
			DecayRate = 8.0,
			DeflectBonus = 4.0,
		},
		Shrine = {
			RestoresActiveHP = true,
			ClearsRecoverableHP = true,
			ClearsPermanentDeficit = true,
			ClearsInjuries = true,
			RestDuration = 1.6,
		},
	},

	Bleed = {
		Max = 100,
		DecayRate = 6.0,
		DecayDelay = 1.5,
		-- Buildup per hit = BaseDamage * move.Bleed * weapon.BleedMultiplier * BuildupScale.
		BuildupScale = 3.0,
		ProcDamageFraction = 0.15,
		ResetOnProc = true,
	},

	Posture = {
		MaxPosture = 100,
		DecayRate = 14.0,
		GuardingDecayMultiplier = 0.35,
		DecayDelay = 0.9,
		LowHealthDecayScale = { AtFullHP = 1.0, AtZeroHP = 0.35 },
		DeflectWindow = 0.10,
		DeflectWindowMin = 0.060,
		DeflectRecovery = 0.20,
		DeflectSpamLockout = 0.30,
		DeflectSpamDecay = 0.45,
		DeflectReflectScale = 0.6,
		DeflectMinimumReflect = 8,
		DeflectChainFloor = 0.030,
		DeflectSelfScale = 0.35,
		BlockScale = 1.0,
		BlockDamageScale = 0.0,
		UnblockableBlockScale = 1.6,
		StanceBreakThreshold = 100,
		StanceBreakResetValue = 0,
		HitScale = 0.5,
	},

	Stamina = {
		Max = 100,
		RegenRate = 32.0,
		RegenDelay = 0.45,
		GuardRegenMultiplier = 0.5,
		BrokenRegenMultiplier = 1.5,
		BreakThreshold = 0,
		RecoverToFraction = 0.6,
		SprintCostPerSecond = 9.0,
		SprintMinimum = 5.0,
		Costs = {
			Light = 3.5,
			Heavy = 9.0,
			Roll = 6.0,
			Dash = 6.0,
			RunningAttack = 6.0,
			WeaponArt = 12.0,
			DeflectSuccess = 0.0,
			DeflectMiss = 12.0,
			Block = 12.0,
			Feint = 4.0,
			Heal = 0.0,
		},
		LightRange = { Min = 3.0, Max = 4.0 },
		HeavyRange = { Min = 8.0, Max = 10.0 },
	},

	Qi = {
		Max = 100,
		Initial = 100,
		GainOnHit = 8,
		GainOnDeflect = 15,
		GainOnDeathblow = 25,
		DecayRate = 0,
		PassiveRegen = 2,
		ClearOnShrine = false,
	},

	Stun = {
		StaminaBroken = 1.4,
		GuardBroken = 1.4,
		StanceBroken = 2.5,
		HitstunLight = 0.28,
		HitstunHeavy = 0.48,
		Blockstun = 0.18,
		DeflectRecoil = 0.32,
		DeathblowAttacker = 1.1,
		DeathblowVictim = 1.6,
	},

	Deathblow = {
		DamageFraction = 0.6,
		MinimumDamage = 30,
		Range = 5.0,
		FacingDot = 0.2,
		InvulnerableToOthers = true,
		ClearsPosture = true,
	},

	Counter = {
		HitMultiplier = 1.25,
		PostureMultiplier = 1.25,
	},

	Feint = {
		-- Seconds after Startup begins during which a Heavy or Weapon Art may be feinted.
		Window = 0.15,
		Kinds = { Heavy = true, WeaponArt = true },
	},

	-- Rapid Roll/Dash spam shortens distance and i-frames; a landed strike or a quiet gap resets it.
	Backdash = {
		SpamWindow = 1.2,
		DecayPerUse = 0.18,
		MinDistanceScale = 0.45,
		IFrameDecayPerUse = 0.25,
		MinIFrameScale = 0.0,
		CancelFraction = 0.6,
	},

	Elixir = {
		HealFraction = 0.4,
		DrinkDuration = 0.9,
		BaseCharges = 3,
		MaxCharges = 8,
	},

	-- Attribute-derived poise: armor &gt;= LightThreshold shrugs off light hitstun, &gt;= HeavyThreshold every hit.
	Poise = {
		LightThreshold = 0.5,
		HeavyThreshold = 0.9,
		PostureReduction = 0.5,
	},

	Respawn = {
		PlayerDelay = 3.5,
		EnemyCorpseTime = 4.0,
		DuelResetDelay = 3.0,
	},

	Enemy = {
		ThinkRate = 10,
		AggroRange = 60,
		LeashRange = 140,
		ReactionTime = 0.22,
		DeflectChance = 0.45,
		HeavyChance = 0.2,
		ArtChance = 0.1,
		Aggression = 0.65,
		ComboContinueChance = 0.7,
		TimingJitter = 0.035,
	},

	Movement = {
		SlideBoost = 1.4,
		SlideFriction = 14,
		SlideMaxSpeed = 95,
		SlideMinSpeed = 8,
		SlideHipDrop = 0.6,
		SlideGroundGrace = 0.16,
		BulletSpeed = 75,
		DoubleJumpUp = 50,
		DoubleJumpForward = 25,
		GlideFallSpeed = 6,
		GlideDuration = 3.5,
		GlideSteering = 4,
		WalkSpeed = 16 * 1.4,
		SprintSpeed = 24 * 1.4,
		DashDistance = 14,
		DashDuration = 0.22,
		RollDistance = 11,
		RollDuration = 0.36,
		RollInvulnerable = { Start = 0.04, Finish = 0.24 },
		DashInvulnerable = { Start = 0.0, Finish = 0.10 },
	},

	Input = {
		BufferWindow = 0.10,
		BufferCapacity = 16,
		DuplicateWindow = 0.033,
		Priority = {
			Deflect = 100,
			Roll = 85,
			Dash = 80,
			WeaponArt = 70,
			Heavy = 60,
			RunningAttack = 55,
			Light = 40,
			Block = 30,
			Heal = 20,
			Equip = 10,
		},
	},

	Injury = {
		Tiers = { "None", "Impaired", "Injured", "Severe" } :: { InjuryTier },
		TierIndex = { None = 0, Impaired = 1, Injured = 2, Severe = 3 } :: { [InjuryTier]: number },
		Regions = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" } :: { InjuryRegion },
		Group = {
			Head = "Head",
			Torso = "Torso",
			LeftArm = "Arm",
			RightArm = "Arm",
			LeftLeg = "Leg",
			RightLeg = "Leg",
		} :: { [InjuryRegion]: InjuryGroup },
		-- Accumulated trauma coefficient (0..1) at which each tier begins.
		Thresholds = {
			Head = { Impaired = 0.20, Injured = 0.45, Severe = 0.75 },
			Torso = { Impaired = 0.30, Injured = 0.60, Severe = 0.90 },
			Arm = { Impaired = 0.25, Injured = 0.55, Severe = 0.85 },
			Leg = { Impaired = 0.25, Injured = 0.55, Severe = 0.85 },
		} :: { [InjuryGroup]: Thresholds },
		RecoveryPerSecond = {
			Head = 0.010,
			Torso = 0.008,
			Arm = 0.008,
			Leg = 0.008,
		} :: { [InjuryGroup]: number },
		RecoveryDelay = 6.0,
		-- Once a region reaches this tier, natural recovery stops at its threshold; only a shrine clears it.
		PersistentTier = "Injured" :: InjuryTier,
		BluntHeadConcussionScale = 1.5,
		-- Penalty ranges: Impaired uses Min, Severe uses Max, Injured interpolates the midpoint.
		Penalties = {
			Arm = {
				StaminaCostIncrease = { Min = 0.30, Max = 0.50 },
				DamageReduction = { Min = 0.20, Max = 0.35 },
			},
			Leg = {
				SpeedReduction = { Min = 0.15, Max = 0.30 },
				DashDistanceReduction = { Min = 0.15, Max = 0.30 },
			},
			Head = {
				DeflectWindowReduction = { Min = 0.10, Max = 0.30 },
				PostureDecayReduction = { Min = 0.15, Max = 0.45 },
				VisionBlur = { Min = 0.20, Max = 0.75 },
				EyeVignette = { Min = 0.15, Max = 0.60 },
			},
			Torso = {
				StaminaRegenReduction = { Min = 0.10, Max = 0.30 },
				MaxPostureReduction = { Min = 0.05, Max = 0.15 },
			},
		},
	},
	Colosseum = {
		-- Studio sessions open the ranked queue without the release gate or a Workspace override.
		-- Studio runs on mock persistence (Config.Backend.StudioLiveData = false), so test duels
		-- never touch live ratings. Live servers still require Config.Features.Matchmaking and
		-- Config.Release.RankedIntegrationPassed. Set Workspace attribute AsuraColosseumQA = false
		-- in Studio to rehearse the sealed-league path.
		RankedInDevelopment = true,
	},
}

freeze(Settings)
return Settings
</string>
